<!DOCTYPE translationbundle>
<translationbundle lang="si">
<translation id="1026101648481255140">ස්ථාපනය නැවත ආරම්භ කරන්න</translation>
<translation id="1029669172902658969">&amp;ChromiumOS යාවත්කාලීන කිරීමට යළි දියත් කරන්න</translation>
<translation id="7962340570690354348">Phromium ඔබට මෙම දිගුව සමාලෝචනය කිරීමට නිර්දේශ කරයි</translation>
<translation id="2702007788032964762">අඩවියක් ඒවායේ පිටුවේ සබැඳි පෞද්ගලිකව පූර්ව පූරණය කිරීමට ඉල්ලා සිටින විට, Phromium Google සේවාදායක භාවිත කරයි. මෙය පූර්ව පූරණය කර ඇති අඩවියෙන් ඔබේ අනන්‍යතාව සඟවන නමුත්, Google පූර්ව පූරණය කරනු ලබන අඩවි මොනවා දැයි ඉගෙන ගනියි.</translation>
<translation id="1051793555070215510">මෙම මිනිත්තු 1ක සමීක්ෂණයට සහභාගී වීමෙන් අප්‍රසිද්ධ වැඩි දියුණු කිරීමට අපට උදවු කරන්න.</translation>
<translation id="1065672644894730302">ඔබේ තේරීම් කියවිය නොහැක.

ඇතැම් විශේෂාංගයන් නොපැවතිය හැකි අතර තේරීම් වල සිදුකරන වෙනස්ක්ම් නොසුරැකෙනු ඇත.</translation>
<translation id="4964836565882496625">ඔබේ මාපියන් Phromium සඳහා "වෙබ් අඩවි, යෙදුම්, සහ දිගු සඳහා වන අවසර" අක්‍රිය කර ඇත</translation>
<translation id="8409497136174302488">අවට උපාංග සොයා ගැනීමට සහ භාවිතා කිරීමට Phromium හට ඔබේ ස්ථානීය ජාලයට ප්‍රවේශය අවශ්‍ය වේ</translation>
<translation id="4388904545107211948">නිශ්චිත Phromium විශේෂාංගයක් හෝ දිගුවක් සෙවීමට, ලිපින තීරුවේ එහි කෙටිමඟ ටයිප් කරන්න, ඉන්පසු ඔබ තෝරා ගත් යතුරුපුවරු යතුර</translation>
<translation id="7188624550427159072">පද්ධති තැටියේ Phromium සෙවුම පෙන්වා යතුරුපුවරු කෙටිමඟ සක්‍රිය කරන්න</translation>
<translation id="3689248207461565136">Phromium හට ඔබගේ මුරපද නිර්යාත කිරීමට අවශ්‍යය. මේ සඳහා අවසර දීමට ඔබගේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="112640046208448578">දේවල් හෝ ස්ථාන හඳුනාගෙන පෙළ පිටපත් කරන්න හෝ පරිවර්තනය කරන්න. ඔබ රූප සෙවීම භාවිත කරන විට, පිටුවේ තිර රුවක් සේවාදායකයට යවනු ලැබේ. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium ඔබේ පෙරනිමි බ්‍රව්සරය වේ</translation>
<translation id="5414044255592121327">ඔබගේ මුරපද දත්ත කඩ කිරීම්වලින් සහ අනෙකුත් ආරක්ෂක ගැටලුවලින් සුරක්ෂිතද යන්න පරීක්ෂා කිරීමට, <ph name="BEGIN_LINK" />Phromium වෙත පුරන්න<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Phromium මෙනුව ක්ලික් කරන්න</translation>
<translation id="1157985233335035034">මෑත භාෂා</translation>
<translation id="1184145431117212167">ඔබේ Windows අනුවාදය සඳහා සහය නොදක්වන නිසා ස්ථාපනය අසමත් විය.</translation>
<translation id="7861581212703831457">Phromium පිළිබඳ</translation>
<translation id="8752630985505435738">ඔබේ දුරකථනයෙන් Phromium සමග මිල නිරීක්ෂණ ඇඟවීම් ලබා ගන්න</translation>
<translation id="1203500561924088507">ස්ථාපනය කිරීම වෙනුවෙන් ස්තුතියි. ඔබ <ph name="BUNDLE_NAME" /> භාවිත කිරීමට පෙර ඔබගේ බ්‍රවුසරය යළි ඇරඹිය යුතුය.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> පොරොත්තුවෙන් ඇත. ඔබේ බ්‍රවුස් කිරීම සුරක්ෂිතව තබා ගැනීමට, ඔබ <ph name="IDLE_DURATION" /> සඳහා අක්‍රිය වූ විට Phromium යාවත්කාලීන වනු ඇත.</translation>
<translation id="1232234696885483911">ඔබ රූප සෙවීම විවෘත කරන විට, පිටුවේ මාතෘකාව, URL, සහ PDF ඇතුළු අන්තර්ගතය ස්වයංක්‍රීයව සේවාදායකය වෙත යවනු ලැබේ. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">ඔබ පුරනය වී සිටින අතරතුර, ඔබට Phromium තුළ ඔබේ Google ගිණුමෙන් ඔබේ මුරපද සහ තවත් ඒවා භාවිත කළ හැක මෙය වෙනස් කිරීමට, “Phromium තුළ ඔබේ ගිණුම” වෙත යන්න.</translation>
<translation id="7402478829083317456">Mac මෙනු තීරුවේ Phromium තුළ Gemini පෙන්වන්න</translation>
<translation id="4902531791098430822">Phromium තුළ Gemini තුළ තිරයේ කොටසක් තේරීමට, යතුරුපුවරු කෙටිමඟ භාවිතා කරන්න.</translation>
<translation id="9002284132405311162">මෙම පටිත්ත අක්‍රියව තිබෙන අතරේ, Phromium වේගවත්ව තබා ගැනීම සඳහා මතකය නිදහස් කරන ලදි. ඔබට මෙම අඩවිය අක්‍රිය වීමෙන් සැම විට බැහැර කිරීමට තෝරා ගත හැක.</translation>
<translation id="5561666811965903444">ගොනුව භයානක නිසා Phromium මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="1340271056805240721"><ph name="USER_EMAIL" /> සමග Gmail හෝ YouTube වැනි Google සේවාවලට පුරන විට, ඔබට එම ගිණුමෙන්ම Phromium වෙත ස්වයංක්‍රීයව පුරනය විය හැක</translation>
<translation id="5048805453292757697">ඔබේ දුරකථනයෙන් Phromium ලබා ගන්න</translation>
<translation id="1290883685122687410">පිහිටුවීමේ දෝෂයකි: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">ඔබගේ නව Phromium පැතිකඩ පිහිටුවන්න</translation>
<translation id="7871721155662336863">Phromium හි Gemini සමග උත්සාහ කරන්න</translation>
<translation id="6569288432960798043">බ්ලූටූත් උපාංග ගවේෂණය කිරීමට Phromium හට බ්ලූටූත් ප්‍රවේශය අවශ්‍යයි.<ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">ඔබේ දුරකථනයෙන් Phromium වෙත පුරන්න</translation>
<translation id="1330562121671411446">භාෂාව අනාවරණය කරන්න</translation>
<translation id="1619655755195586133">Phromium වෙතින් ද දත්ත මකන්න (<ph name="URL" />)</translation>
<translation id="1345251407431278948">අමුණන ලදි! ඔබට මෙවලම් තීරුවේ ඇති නව බොත්තමෙන් රූප සෙවීම වෙත නැවත ප්‍රවේශ විය හැක</translation>
<translation id="1383876407941801731">සොයන්න</translation>
<translation id="2947996037737257951">යන ගමන් බ්‍රවුස් කිරීම තබා ගැනීමට Phromium යෙදුම භාවිතා කරන්න</translation>
<translation id="141901961143729572">ඔබේ සිතුවිලි බෙදා ගන්න</translation>
<translation id="8355386219605656974">ඔබේ කවුළුව බෙදා ගැනීමට, පද්ධති සැකසීම් තුළ Phromium සඳහා තිර පටිගත කිරීමට ඉඩ දෙන්න.</translation>
<translation id="1478370723027452770">පරීක්ෂා කිරීම සඳහා Chrome සමග උදවු ලබා ගන්න</translation>
<translation id="8398257182826094665"><ph name="DEVICE" /> වෙතින් ඔබේ සුරකින ලද තතු සහ තවත් දේ ලබා ගැනීමට, Phromium තුළට පුරන්න</translation>
<translation id="1497802159252041924">ස්ථාපනය කිරීමේ දෝෂයක්: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">මෙම පිටුව ආරක්ෂිතයි.</translation>
<translation id="3484755999946650557">Phromium පටිත්තක් බෙදා ගන්න</translation>
<translation id="3309377459597801353">Phromium වෙත පිවිසෙන්න</translation>
<translation id="1547469039832541117">උද්දීපනය කළ කාර්යය නිමා කරයි.</translation>
<translation id="2354363290397602683">Phromium අමුණන්න</translation>
<translation id="2244728813494358888">Phromium හි සුරක්ෂිතතා මෙවලම්</translation>
<translation id="707582364915018531">Phromium හට ඔබේ මුරපද කළමනාකරු දත්ත මැකීමට අවශ්‍යයි. මෙයට ඉඩ දීමට ඔබේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{යාවත්කාලීනයක් යෙදීමට ඔබ Phromium නැවත ආරම්භ කිරීම පරිපාලකයාට අවශ්‍ය වේ}=1{යාවත්කාලීනයක් යෙදීමට ඔබ Phromium නැවත ආරම්භ කිරීම පරිපාලකයාට අවශ්‍ය වේ. ඔබේ අප්‍රසිද්ධ කවුළුව යළි විවෘත නොවෙයි.}one{යාවත්කාලීනයක් යෙදීමට ඔබ Phromium නැවත ආරම්භ කිරීම පරිපාලකයාට අවශ්‍ය වේ. ඔබේ අප්‍රසිද්ධ කවුළු # යළි විවෘත නොවෙයි.}other{යාවත්කාලීනයක් යෙදීමට ඔබ Phromium නැවත ආරම්භ කිරීම පරිපාලකයාට අවශ්‍ය වේ. ඔබේ අප්‍රසිද්ධ කවුළු # යළි විවෘත නොවෙයි.}}</translation>
<translation id="5032531544901236587">ඔබේ දුරකථනයේ Phromium යෙදුම සමග Google හි හොඳම දේ ලබා ගන්න</translation>
<translation id="7311082384439462587">Phromium හි ප්‍රධාන පෞද්ගලිකත්ව සහ ආරක්ෂක පාලන සමාලෝචනය කරන්න</translation>
<translation id="1640672724030957280">බාගනිමින්...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, සාමාජිකත්වය ලෙස පුරනය විය. ගිණුම් මෙනුව විවෘත කරන්න</translation>
<translation id="4535436467771816034">ඔබ පණිවිඩ, ලේඛන, සහ වෙනත් යෙදුම්වල සබැඳි ක්ලික් කරන ඕනෑම වේලාවක ඔබට Phromium භාවිත කළ හැක. එය ඔබේ කාර්ය තීරුවට ද අමුණනු ඇත.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> සඳහා උසස් වරප්‍රසාද ලබා දෙයි.</translation>
<translation id="1722488837206509557">මෙය ඔබට පවතින උපාංගවලින් තේරීමට සහ ඒවායේ අන්තර්ගතය පෙන්වීමට ඉඩ දෙනු ඇත.</translation>
<translation id="3550860956769006392">Phromium ඉක්මනින් බ්‍රවුස් කිරීමේ දත්ත මකනු ඇත</translation>
<translation id="2053384509423635834">Phromium සංචාලන HTTPS වෙත උත්ශ්‍රේණි කිරීමට උත්සාහ කරනු ඇත</translation>
<translation id="2516115567501600458">Phromium දත්ත හිස් කරන ලදී</translation>
<translation id="8571959122390670188">Phromium <ph name="REMAINING_TIME" />කින් යළි ඇරඹෙනු ඇත</translation>
<translation id="6284080675125981628">HTTPS නොමැති විට, Phromium ඔබට අනතුරු ඇඟවීමකින් තොරව අනාරක්ෂිත සම්බන්ධතාවයක් භාවිතා කරනු ඇත</translation>
<translation id="5872244334553252095">පසුබිමේ Phromium ධාවනය වීමට ඉඩ දෙන්න</translation>
<translation id="2213761221916953829">Phromium වඩාත් ආරක්ෂිත කිරීම සඳහා, අප විසින් <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ලැයිස්තුගත කළ නොමැති හා ඔබේ දැනුමෙන් තොරව එක්කළ ඇතැම් දිගු අක්‍රීය කර ඇත.</translation>
<translation id="8807881428325438878">ඉක්මන් ප්‍රවේශය සඳහා Phromium ඔබේ කාර්ය තීරුවට ඇමිණීමට, Windows දැනුම්දීමෙහි ඇති <ph name="BEGIN_BOLD" />ඔව්<ph name="END_BOLD" /> යන්න ක්ලික් කරන්න.</translation>
<translation id="6861833596843600606">Phromium ප්‍රතිස්ථාපනය කරන්න</translation>
<translation id="3950056404221550225">Phromium <ph name="AUTHENTICATION_PURPOSE" /> සඳහා උත්සාහ කරයි</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> දැනටමත් පුරනය වී නැත. ඔබේ බ්‍රවුස් කිරීම වෙනම තබා ගැනීමට, <ph name="USER_EMAIL_ADDRESS" /> ලෙස ඔබේම පැතිකඩෙන් Phromium හට පුරන්න. ඔබට <ph name="DEVICE" /> වෙතින් ඔබේ දිගු සහ තවත් දේ ද ලැබෙනු ඇත.</translation>
<translation id="6114726049187747242">මීළඟ වතාවේ ඔබ ඔබේ <ph name="DEVICE_TYPE" /> මත Phromium විවෘත කරන විට, Google මුරපද කළමනාකරු භාවිත කිරීමට ප්‍රේරකයක් ඔබට පෙනෙනු ඇත.</translation>
<translation id="1838374766361614909">සෙවීම හිස් කරන්න</translation>
<translation id="2724678689951174927">එය ඔබේ Google ගිණුම තුළ තබා ගන්නා අතර මෙම උපාංගයෙන් පමණක් බ්‍රවුස් කිරීමේ දත්ත මැකීමට, <ph name="BEGIN_LINK" />Phromium වෙතින් වරන්න<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">ගමනේ දී නව පටිති සමූහ විවෘත කිරීමට හෝ තැනීමට ඔබේ දුරකථනයට Phromium බාගන්න.</translation>
<translation id="3191814926523151519">ඔබට ඔබගේ පුරන ලද Google ගිණුම් කළමනාකරණය කළ හැකිය. ඔබගේ Google ගිණුම් Phromium බ්‍රව්සරය, Play Store, Gmail සහ තවත් දේ සඳහා භාවිත කෙරේ. ඔබට පවුලේ සාමාජිකයකු වැනි, වෙනත් යම් කෙනෙකු සඳහා ගිණුමක් එක් කිරීමට අවශ්‍ය නම්, ඒ වෙනුවට ඔබගේ <ph name="DEVICE_TYPE" /> වෙත නව පුද්ගලයකු එක් කරන්න. <ph name="LINK_BEGIN" />තව දැන ගන්න<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">රූප සෙවීම සමග සොයන්න</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> දැනටමත් පුරනය වී නැත. ඔබේ බ්‍රවුස් කිරීම වෙනම තබා ගැනීමට, <ph name="USER_EMAIL_ADDRESS" /> ලෙස ඔබේම පැතිකඩෙන් Phromium හට පුරන්න. ඔබට <ph name="DEVICE" /> වෙතින් ඔබේ පිටුසන් සහ තවත් දේ ද ලැබෙනු ඇත.</translation>
<translation id="1880677175115548835">පාඨය තෝරන්න</translation>
<translation id="1236934630660512644">ඔබ කළමනාකරණය කළ ගිණුමක් වෙත සයින් ඉන් වන අතර ඔබේ Phromium පැතිකඩෙහි පරිපාලක පාලනය ලබා දේ. යෙදුම්, පිටු සලකුණු, ඉතිහාසය, රහස්වචන, සහ අනෙකුත් පසුතල වැනි ඔබේ Phromium දත්ත ස්ථිරවම <ph name="USER_NAME" /> වෙත බැඳෙනු ඇත. Google Accounts Dashboard හරහා මෙම දත්ත මැකීමට ඔබට හැකි වනු ඇත, නමුත් ඔබට මෙම දත්ත වෙනත් ගිණුමක් සමඟ සම්බන්ධ කළ නොහැක. ඔබේ පවතින Phromium දත්ත වෙනමම තබා ගැනීමට ඔබට විකල්ප වශයෙන් නව පැතිකඩක් සෑදිය හැකිය. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium පසුබිම් ක්‍රියාකාරකම් සහ සුමට අනුචලන සහ වීඩියෝ රාමු අනුපාත වැනි දෘශ්‍ය ප්‍රයෝග සීමා කිරීමෙන් බැටරි බලය සංරක්ෂණය කරයි. <ph name="BEGIN_LINK" />බලශක්ති සුරැකුම පිළිබඳ තව දැන ගන්න<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium යාවත්කාලීන සේවාව</translation>
<translation id="5797624919204275541">මෙය අක්‍රිය කිරීමෙන්, ඔබට Phromium වෙත පුරනය නොවී Gmail වැනි Google වෙබ් අඩවිවලට පුරනය විය හැක.</translation>
<translation id="6850971726764387814">Phromium ප්‍රතිචාර නොදක්වයි. නැවත දියත් කරන්නද?</translation>
<translation id="8289779763124483945">ඔබේ සංවිධානයට, <ph name="MANAGER" />, ඔබ Phromium වෙත පුරනය වීමට අවශ්‍යයි</translation>
<translation id="193439633299369377">යාවත්කාලීනය යෙදීමට ChromiumOS යළි ඇරඹිය යුතුය.</translation>
<translation id="3215238748514810076">ගොනු වර්ගය සාමාන්‍යයෙන් බාගත නොවන නිසා සහ එය භයානක විය හැකි නිසා Phromium මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="1953553007165777902">බාගනිමින්... මිනිත්තු <ph name="MINUTE" />ක් ඉතිරිව ඇත</translation>
<translation id="8529252122707161160">Phromium හට පෙරනිමි බ්‍රව්සරය නිර්ණය කිරීමට හෝ සැකසීමට නොහැකිය</translation>
<translation id="197326043290947695">රූප සෙවීම සමඟ වඩාත් සුහුරු ලෙස බ්‍රවුස් කරන්න</translation>
<translation id="7769772561254542263">Phromium නව පටිත්තක විවෘත වන සමහර ගොනු අවහිර කරන්නේ මන්දැයි ඉගෙන ගන්න</translation>
<translation id="3713013456746186442">ඔබේ Phromium මෘදුකාංගය යාවත්කාලීනව තබයි. මෙම සේවාව අබල කර ඇත්නම් හෝ නතර වුවහොත්, ඔබේ Phromium මෘදුකාංගය යාවත්කාලීනව නොතිබෙනු ඇත, එනම් මතු විය හැකි ආරක්ෂක අවදානම් නිරාකරණය කළ නොහැකි අතර විශේෂාංග ක්‍රියා නොකරනු ඇත. මෙම සේවාව භාවිත කරන Phromium මෘදුකාංගයක් නොමැති විට එය අස්ථාපනය වෙයි.</translation>
<translation id="5690439379999550641">මෙය මෙම උපාංගයෙන් අයිතම 1ක් මකනු ඇත. ඔබගේ දත්ත පසුව ලබා ගැනීමට, <ph name="USER_EMAIL" /> ලෙස Phromium වෙත පුරන්න.</translation>
<translation id="2018879682492276940">ස්ථාපනය අසාර්ථක විය. කරුණාකර නැවත උත්සාහ කරන්න.</translation>
<translation id="2039417478970545937">සැකසීම්</translation>
<translation id="4765042254400173473">Google සේවාවල වඩාත් පුද්ගලිකකරණය කළ අත්දැකීම් සඳහා Phromium ඉතිහාසය ඇතුළත් කළ යුතුද යන්න තෝරන්න</translation>
<translation id="1448229429009113044">ඔබට ශක්තිමත් මුරපද තැනීම, සුරැකීම සහ ස්වයං පිරවීම සඳහා උදවු කිරීම Phromium තුළට ම ඇතුළත් කර ඇත. පහසු ප්‍රවේශය සඳහා කෙටිමඟ එක් කරන්න.</translation>
<translation id="2145664943269651168">Phromium හට නව පෙනුමක් ලබා දීමට නව පටිති පිටුවේ Phromium අභිරුචි කරන්න බොත්තම ක්ලික් කරන්න</translation>
<translation id="6052463185672312901">ගොනුව රැවටිලිකාර සහ ඔබේ උපාංගයට අනපේක්ෂිත වෙනස්කම් සිදු කළ හැකි නිසා Phromium මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="3825064703718009924">ඔබ මීළඟ වතාවේ Phromium iOS විවෘත කරන විට <ph name="FEATURE_NAME" /> උත්සාහ කිරීමට ඔබට ප්‍රේරකයක් පෙනෙනු ඇත.</translation>
<translation id="886729435477608858">ඔබ ඔබේ Google ගිණුමේ සුරකින ලද ඔබේ මුරපද සහ අනෙකුත් Phromium දත්ත මෙම උපාංගයෙන් ඉවත් කරනු ලැබේ. ඒවා නැවත Phromium තුළ භාවිතා කිරීමට, නැවත පුරනය වන්න.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{1 මිනිත්තුවකට Phromium භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}one{මිනිත්තු #කට Phromium භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}other{මිනිත්තු #කට Phromium භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}}</translation>
