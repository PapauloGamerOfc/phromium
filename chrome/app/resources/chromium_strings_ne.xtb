<translation id="7245201002247176127">लगभग अद्यावधिक भयो! अद्यावधिक गर्ने कार्य सम्पन्न गर्न Phromium लाई पुनः सुरु गर्नुहोस्।</translation>
<translation id="8846891938874485868">Phromium को V8 इन्जिनले साइटहरूको गति बढाउँछ तर यसले Phromium मा सुरक्षासम्बन्धी आक्रमणहरू हुने सम्भावना भने बढाउँछ</translation>
<translation id="7525500996671436081">Phromium प्रयोग गरी Search खोल्नुहोस्</translation>
<translation id="1224842000407297331">Phromium प्रोफाइल</translation>
<translation id="4956303519269880412">चेतावनी: Phromium ले एक्स्टेन्सनहरूलाई तपाईंको ब्राउजिङ इतिहास रेकर्ड गर्नबाट रोक्न सक्दैन। यो एक्स्टेन्सन इन्कोग्निटो मोडमा अफ गर्न यो विकल्पको चयन रद्द गर्नुहोस्।</translation>
<translation id="2708255035805733225">तपाईंले Phromium को प्रयोगसम्बन्धी रिपोर्टहरू पनि सेयर गर्नुभयो भने ती रिपोर्टमा तपाईंले खोलेका URL हरू समावेश हुन्छन्</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" /> का रूपमा साइन इन गरिएको छ, सदस्यता। खाताको मेनु खोल्नुहोस्</translation>
<translation id="1883292567514549610">यो प्रोफाइल अर्को Phromium प्रक्रिया (<ph name="PROCESS_ID" />) द्वारा अर्को कम्प्युटर (<ph name="HOST_NAME" />) मा प्रयोग गरिएको देखिएको छ। Phromium ले प्रोफाइल लक गरेको छ जसले गर्दा त्यो दूषित हुँदैन। यदि तपाइँ यस प्रोफाइललाई अन्य कुनै प्रक्रियाहरूले प्रयोग गरिरहेको छैन भनेर निश्चय हुनुहुन्छ भमे, तपाइँले प्रोफाइल अनलक गर्न र Phromium फेरि सुरु गर्न सक्नुहुन्छ।</translation>
<translation id="4680828127924988555">इन्स्टल गर्ने प्रक्रिया रद्द गर्नुहोस्</translation>
<translation id="1889305042180577023">तपाईंको Phromium का केही डेटा अहिलेसम्म तपाईंको Google खातामा सेभ गरिएका छैनन्। साइन आउट गर्नुअघि केही मिनेट पर्खी हेर्नुहोस्। तपाईंले अहिले नै साइन आउट गर्नुभयो भने यो डेटा मेटाइने छ।</translation>
<translation id="8079525505870459051">तपाईं साइन इन अवस्थामा भएका बेला आफ्नो Google खातामा सेभ गरिएका पासवर्ड तथा अन्य कुराहरू Phromium मा प्रयोग गर्न सक्नुहुन्छ। <ph name="SHORTCUT" /> प्रयोग गरी Google का सेवाहरूसम्बन्धी तपाईंले तय गरेका सेटिङ बदल्न सकिन्छ।</translation>
<translation id="2171507067211697961">कुनै व्यक्तिले अघिल्लो पटक यस कम्प्युटरमा <ph name="ACCOUNT_EMAIL_LAST" /> को रूपमा Phromium मा साइन इन गरेको थियो। कृपया आफ्नो जानकारी छुट्टै राख्न Phromium मा एउटा नयाँ प्रयोगकर्ता सिर्जना गर्नुहोस्।</translation>
<translation id="4724676981607797757">प्रयोग गर्न नमिल्ने प्रोटोकलसम्बन्धी त्रुटि भएकाले इन्स्टल गर्न सकिएन।</translation>
<translation id="6925701206088903005">जे भए पनि Phromium छाडेर बाहिरिने हो?</translation>
<translation id="4514755609496543621">Phromium को एक विशेष सुरक्षा अद्यावधिक भर्खरै लागू गरियो। पुनः सुरु गर्नुहोस् र हामी तपाईंका ट्याबहरू रिस्टोर गर्ने छाैँ।</translation>
<translation id="8673673368917636496">तपाईंले हालसालै कुनै पनि साइट खोल्नुभएको छैन। Phromium ले <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> र थप <ph name="COUNT" /> वटा अनुमति रद्द गरेको छ।</translation>
<translation id="3638319732826965647">Phromium मा उपलब्ध Gemini खुला छ भने नयाँ ट्याबहरू बनाउँदा साइड प्यानल खुला रहन्छ</translation>
<translation id="479167709087336770">यसले Google खोजमा प्रयोग गरिएकै स्पेल चेकर प्रयोग गर्दछ। तपाईंले ब्राउजरमा टाइप गर्ने पाठ Google मा पठाइन्छ। तपाईं सेटिङमा गई जुनसुकै बेला उक्त व्यवहार परिवर्तन गर्न सक्नुहुन्छ।</translation>
