<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="1026101648481255140">इन्स्टल गर्ने प्रक्रिया सुचारु गर्नुहोस्</translation>
<translation id="1029669172902658969">&amp;ChromiumOS अपडेट गर्न यसलाई रिलन्च गर्नुहोस्</translation>
<translation id="7962340570690354348">Phromium तपाईंलाई यो एक्स्टेन्सनको समीक्षा गर्न सिफारिस गर्छ</translation>
<translation id="2702007788032964762">कुनै साइटले आफ्नो पेजमा भएका लिंकहरू गोप्य तरिकाले प्रिलोड गर्न लगाएका खण्डमा Phromium ले Google का सर्भरहरू प्रयोग गर्छ। यसो गर्दा प्रिलोड गरिएको साइटमा भएको तपाईंको पहिचान खुलाउने जानकारी लुकाइन्छ तर Google ले कुन कुन साइट प्रिलोड गरिन्छन् भन्ने कुरा सिक्छ।</translation>
<translation id="1051793555070215510">१ मिनेटको यो सर्वेक्षण पूरा गरेर हामीलाई इन्कोग्निटो मोडको गुणस्तर सुधार्न मद्दत गर्नुहोस्।</translation>
<translation id="1065672644894730302">तपाइँका प्राथमिकातहरू पढ्न सकिदैन।

केही सुविधाहरू अनुपलब्ध हुन सक्छन् र प्राथमिकताहरूमा परिवर्तनहरू बचत हुने छैनन्।</translation>
<translation id="4964836565882496625">तपाईंका अभिभावकले Phromium का हकमा "साइट, एप तथा एक्सटेन्सनसम्बन्धी अनुमति" अफ गर्नुभएको छ</translation>
<translation id="8409497136174302488">नजिकैका डिभाइसहरू पत्ता लगाउन र प्रयोग गर्न Phromium लाई तपाईंको लोकल नेटवर्कको एक्सेस दिनु पर्ने हुन्छ</translation>
<translation id="4388904545107211948">Phromium को कुनै निश्चित सुविधा वा एक्स्टेन्सन खोज्न एड्रेस बारमा त्यसको सर्टकट टाइप गर्नुहोस् अनि आफूले चयन गरेको किबोर्ड की थिच्नुहोस्</translation>
<translation id="7188624550427159072">सिस्टम ट्रेमा Phromium प्रयोग गरी खोज्ने सुविधा देखाउनुहोस् र किबोर्ड सर्टकट अन गर्नुहोस्</translation>
<translation id="3689248207461565136">Phromium तपाईंका पासवर्डहरू निर्यात गर्न चाहन्छ। यसो गर्ने अनुमति दिन Windows को आफ्नो पासवर्ड टाइप गर्नुहोस्‌।</translation>
<translation id="112640046208448578">वस्तु वा ठाउँहरू पहिचान गर्नुहोस् र टेक्स्ट कपी वा अनुवाद गर्नुहोस्। तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा प्रयोग गर्दा यो पेजको एउटा स्क्रिनसट सर्भरमा पठाइन्छ। <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium तपाईंको डिफल्ट ब्राउजर हो</translation>
<translation id="5414044255592121327">तपाईंका पासवर्डहरू कतै खुलासा भएका छन् कि छैनन् तथा सुरक्षासम्बन्धी अन्य समस्याबाट सुरक्षित छन् कि छैनन् भन्ने कुरा जाँच्न <ph name="BEGIN_LINK" />Phromium मा साइन इन गर्नुहोस्<ph name="END_LINK" />।</translation>
<translation id="1753507755668601921">Phromium मेनुमा क्लिक गर्नुहोस्</translation>
<translation id="1157985233335035034">हालसालै चयन गरिएका भाषाहरू</translation>
<translation id="1184145431117212167">तपाईंको डिभाइसमा भएको Windows को संस्करणमा नचल्ने भएकाले इन्स्टल गर्न सकिएन।</translation>
<translation id="7861581212703831457">Phromium का बारेमा</translation>
<translation id="8752630985505435738">आफ्नो फोनमा Phromium प्रयोग गरी मूल्य ट्र्याकिङसम्बन्धी अलर्टहरू प्राप्त गर्नुहोस्</translation>
<translation id="1203500561924088507">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME" /> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्नो ब्राउजर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> हुन बाँकी छ। तपाईंको ब्राउजिङ सुरक्षित राख्न तपाईं अर्को पटक <ph name="IDLE_DURATION" /> सम्म निष्क्रिय भएका बेला Phromium अपडेट हुने छ।</translation>
<translation id="1232234696885483911">तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा खोल्दा PDF सहित पेजको शीर्षक, URL र कन्टेन्ट स्वतः सर्भरमा पठाइने छन्। <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">तपाईं साइन इन अवस्थामा भएका बेला आफ्नो Google खातामा सेभ गरिएका पासवर्ड तथा अन्य कुराहरू Phromium मा प्रयोग गर्न सक्नुहुन्छ। यो कुरा परिवर्तन गर्न “Phromium मा भएको तपाईंको खाता” मा जानुहोस्।</translation>
<translation id="7402478829083317456">Mac को मेनु बारमा Phromium मा उपलब्ध Gemini देखाउनुहोस्</translation>
<translation id="4902531791098430822">Phromium मा उपलब्ध Gemini मा स्क्रिनको कुनै भाग चयन गर्न किबोर्ड सर्टकट प्रयोग गर्नुहोस्।</translation>
<translation id="9002284132405311162">यो ट्याब निष्क्रिय हुँदा Phromium छिटो चल्ने बनाइराख्न मेमोरी खाली गरिएको थियो। तपाईं यो साइटलाई जुनसुकै बेला सक्रिय राखिराख्ने विकल्प छनौट गर्न सक्नुहुन्छ।</translation>
<translation id="5561666811965903444">यो फाइल खतरनाक भएकाले Phromium ले यो फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="1340271056805240721"><ph name="USER_EMAIL" /> मार्फत Google का Gmail वा YouTube लगायतका सेवाहरूमा साइन इन गर्दा तपाईं उही खातामार्फत Phromium मा स्वतः साइन इन गर्न सक्नुहुन्छ</translation>
