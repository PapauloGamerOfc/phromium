<translation id="8370517070665726704">प्रतिलिपि अधिकार <ph name="YEAR" /> Google LLC। सर्वाधिकार सुरक्षित।</translation>
<translation id="7349410893766975486">आफ्ना सबै डिभाइसमा आफ्ना पासवर्डलगायतका थप कुराहरू प्राप्त गर्न Phromium मा साइन इन गर्नुहोस्। तपाईंले साइन इन गरेपछि यो पासवर्ड तपाईंको Google खातामा सेभ गरिने छ।</translation>
<translation id="394196307309768356">तपाईंले त्यसपछि Phromium रिस्टार्ट गर्नु पर्ने हुन्छ।</translation>
<translation id="7466825726005300631">Phromium ले तपाईंलाई यो एक्स्टेन्सन हटाउन सिफारिस गर्छ। <ph name="BEGIN_LINK" />प्रयोग गर्न सकिने एक्स्टेन्सनहरूका बारेमा थप जान्नुहोस्<ph name="END_LINK" /></translation>
<translation id="264088846642173954">यो एक्स्टेन्सनको विकासकर्ताले नै यसको प्रकाशन रद्द गरेको थियो र उक्त एक्स्टेन्सन असुरक्षित हुन सक्छ। यो एक्स्टेन्सनले अबदेखि तपाईंले खोल्ने साइटहरूमा रहेका तपाईंको व्यक्तिगत जानकारीलगायतका तपाईंको डेटा हेर्न र प्रयोग गर्न नसकोस् भन्नाका लागि यसलाई Phromium बाट हटाउनुहोस्।</translation>
<translation id="1867604241588004166">Phromium ले तपाईंको पहिचान पुष्टि गरेपछि मात्र तपाईं आफ्नो Google खातामा केही डेटा सेभ गर्न र आफ्ना सबै डिभाइसमा ती डेटा प्रयोग गर्न सक्नुहुन्छ। तपाईंले अहिले नै साइन आउट गर्नुभयो भने ती डेटा मेटाइने छन्।</translation>
<translation id="926481158288852551">{0,plural, =1{एक दिनभित्र Phromium पुनः सुरु गर्नुहोस्}other{# दिनभित्र Phromium पुनः सुरु गर्नुहोस्}}</translation>
<translation id="8438543370129609977">तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा प्रयोग गर्दा PDF सहित पेजको शीर्षक, URL र सामग्री सर्भरमा पठाइन्छन्। <ph name="LEARN_MORE" /></translation>
