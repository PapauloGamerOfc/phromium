<translation id="5940989267583033306">लिंकलाई Phromium को इन्कोग्निटो विन्डोमा खोल्नुहोस्</translation>
<translation id="2045477525210426976">आफ्नो नयाँ Phromium प्रोफाइल आफूले चाहे जस्तो बनाउनुहोस्</translation>
<translation id="3540518135502114323">तपाईं ट्याबहरू अदलबदल नगरिकनै AI मोड प्रयोग गरी च्याट गरिराख्न सक्नुहुन्छ। सुरु गर्न Phromium मा साइन इन गर्नुहोस्। तपाईं सबै डिभाइसमा रहेका आफ्ना पासवर्डलगायतका थप कुराहरू पनि प्राप्त गर्नु हुने छ।</translation>
<translation id="1496180326063744749">Phromium बाट आफ्नो Google खाता हटाउन "सेटिङ" पेजमा गई Phromium बाट साइन आउट गर्नुहोस्</translation>
<translation id="7792783034323745412">Phromium ले तपाईंलाई पछि फारामहरू स्वतः भर्नका निम्ति सेभ गरिएको जानकारी प्रयोग गर्ने कि नगर्ने भन्ने कुरा सोध्न सक्छ</translation>
<translation id="5240091371721695404">क्रोमियमले यसको डाटा निर्देशिकामा पढ्न र लेख्न सक्दैन: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">iOS मा Phromium प्रयोग गरी आफूलाई मन पर्ने Google AI टुलहरू जुनसुकै बेला जहाँसुकै पनि प्रयोग गर्नुहोस्।</translation>
<translation id="4848363951707149242"><ph name="DEVICE" /> मा भएका आफ्ना एक्स्टेन्सनलगायतका कुराहरू प्राप्त गर्न Phromium मा साइन इन गर्नुहोस्</translation>
<translation id="3286538390144397061">अहिले फेरी सुरु गर्नुहोस्</translation>
<translation id="8613877111531019527">Google API कुञ्जीहरू हराइरहेका छन्। Phromium को केही कार्यक्षमतालाई अक्षम बनाइनेछ।</translation>
<translation id="2784090498377460662">क्रोमियम बन्द हुँदा पृष्ठभूमि एप्लिकेसनहरूको चालूलाई जारी राख्नुहोस्</translation>
<translation id="3905054486991167751">तपाईं निष्क्रिय भएका बेला Phromium अपडेट हुने छ</translation>
<translation id="4502950976754616266">तपाईंले कुनै असुरक्षित कनेक्सन प्रयोग गरी कुनै साइट लोड गर्नुअघि Phromium ले तपाईंलाई चेतावनी दिने छ</translation>
<translation id="6107453188231652861">तपाईंले Phromium का सबै विन्डो बन्द गर्नुभयो भने तपाईं अधिकांश साइटहरूबाट साइन आउट हुनु हुने छ तर तपाईं Phromium मा साइन इन अवस्थामा हुनुहुन्छ भने तपाईं आफ्नो Google खाताबाट भने साइन आउट हुनु हुने छैन। साइटहरूले तपाईंका विवरण याद राख्न सकून् भन्नाका लागि <ph name="SETTINGS_LINK" />।</translation>
<translation id="3352986031709923790">खोज क्षेत्रको सिरानको दायाँ कुना: दायाँ भागको <ph name="RIGHT" />%, सिरानको <ph name="TOP" />%</translation>
<translation id="5896635343289575401">तपाईंको खातामा भएको Phromium को डेटा</translation>
<translation id="5662253013097242821">आफ्नो फोनमा Phromium प्रयोग गरी आफ्ना पासवर्डहरू प्रयोग गर्नुहोस्</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">विद्यमान Phromium प्रोफाइल प्रयोग गर्ने हो?</translation>
<translation id="3412460710772753638">यो डिभाइसको पासवर्ड म्यानेजरमा</translation>
<translation id="657700335789940813">Phromium अपडेटका लागि तयार छ</translation>
<translation id="3487742274367151379"><ph name="DEVICE" /> मा भएका आफ्ना बुकमार्कलगायतका कुराहरू प्राप्त गर्न Phromium मा साइन इन गर्नुहोस्</translation>
<translation id="3438772217992559640">फोटो प्रयोग गरी खोज्ने सुविधामार्फत यो ट्याबमा भएको कन्टेन्ट खोज्नुहोस्</translation>
<translation id="8062355070850891600">आफ्नो फोनमा Phromium प्रयोग गरी परिष्कृत सुरक्षित ब्राउजिङ सुविधा पाउनुहोस्</translation>
<translation id="5419337472918920970">Phromium तपाईंले चाहेअनुसार पर्सनलाइज गरिँदै छ…</translation>
<translation id="6573105037542661278">यसले यो डिभाइसका <ph name="ITEMS_COUNT" /> वस्तुहरू मेट्नेछ। पछि आफ्नो डेटा प्राप्त गर्न Phromium मा <ph name="USER_EMAIL" /> को रूपमा साइन इन गर्नुहोस्।</translation>
<translation id="4600986251755456192">तपाईं <ph name="SHORTCUT" /> थिचेर Phromium मा एक प्रोफाइलबाट अर्को प्रोफाइलमा जान सक्नुहुन्छ</translation>
<translation id="8118189978246431067">कृपया सबै Phromium सन्झ्यालहरू बन्द गर्नुहोस् र पुन: प्रयास गर्नुहोस्।</translation>
<translation id="7430418346833889620">आफ्नो विन्डो सेयर गर्न सिस्टम सेटिङमा गई Phromium लाई स्क्रिन रेकर्ड गर्ने अनुमति दिनुहोस्</translation>
<translation id="2943929290955142701"><ph name="EXISTING_USER" /> ले पहिलेदेखि नै साइन इन गर्नुभएको छ।  छुट्टै ब्राउजर प्रयोग गर्न <ph name="USER_EMAIL_ADDRESS" /> मार्फत आफ्नै प्रोफाइल प्रयोग गरी Phromium मा साइन इन गर्नुहोस्।</translation>
<translation id="5896697187441340113">मोबाइल डिभाइसमा Phromium ब्राउजर डाउनलोड गर्न प्रयोग गरिने QR कोड</translation>
<translation id="354621070532799440">रिमाइन्डर: Google का उत्कृष्ट सुरक्षा सुविधाहरू तपाईंको खल्तीमै उपलब्ध छन्</translation>
<translation id="6718500626359284607">आफ्नो स्क्रिन सेयर गर्न सिस्टम सेटिङमा गई Phromium लाई स्क्रिन रेकर्ड गर्ने अनुमति दिनुहोस्।</translation>
<translation id="6511372913460632136">उन्नत सुरक्षाले Phromium ले नचिन्ने साइटहरूमा JavaScript अप्टिमाइजेसन अफ गर्छ</translation>
<translation id="3597003331831379823">खास विशेषाधिकारहरू प्रयोग गरी सेटअप रन गर्न सकिएन। <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Phromium मा साइन इन गर्नुहोस्</translation>
<translation id="8702816719621016911">यस डिभाइसबाट यो व्यक्तिको ब्राउजिङ डेटा मेटाइने छ। उक्त डेटा पुनः प्राप्त गर्न <ph name="USER_EMAIL" /> का रूपमा Phromium मा साइन इन गर्नुहोस्।</translation>
<translation id="64780623876080332">{COUNT,plural, =0{Phromium को नयाँ अपडेट उपलब्ध छ र तपाईंले Phromium पुनः सुरु गर्ने बित्तिकै यो अपडेट लागू हुने छ।}=1{Phromium को नयाँ अपडेट उपलब्ध छ र तपाईंले Phromium पुनः सुरु गर्ने बित्तिकै यो अपडेट लागू हुने छ। तपाईंको इन्कोग्निटो विन्डो पुनः खुल्ने छैन।}other{Phromium को नयाँ अपडेट उपलब्ध छ र तपाईंले Phromium पुनः सुरु गर्ने बित्तिकै यो अपडेट लागू हुने छ। तपाईंका # वटा इन्कोग्निटो विन्डो पुनः खुल्ने छैनन्।}}</translation>
<translation id="3667616615096815454">इन्स्टल गर्न सकिएन, सर्भरका लागि यो एप अज्ञात छ।</translation>
<translation id="678730369472836428">आफ्नो Google खातामा भएका Phromium का सबै डेटा इन्क्रिप्ट गर्न <ph name="BEGIN_LINK" />आफ्नै पासफ्रेज<ph name="END_LINK" /> प्रयोग गर्नुहोस्। Google Pay मा भएका भुक्तानी विधि र ठेगानाहरू इन्क्रिप्ट गरिने छैनन्। Phromium को ब्राउजिङ हिस्ट्री सिंक गरिने छैन।</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{तपाईंका व्यवस्थापकले तपाईंलाई यो अद्यावधिक लागू गर्न Phromium पुनः सुरु गर्न आग्रह गर्नुभएको छ}=1{तपाईंका व्यवस्थापकले तपाईंलाई यो अद्यावधिक लागू गर्न Phromium पुनः सुरु गर्न आग्रह गर्नुभएको छ। तपाईंको इन्कोग्निटो विन्डो पुनः खुल्ने छैन।}other{तपाईंका व्यवस्थापकले तपाईंलाई यो अद्यावधिक लागू गर्न Phromium पुनः सुरु गर्न आग्रह गर्नुभएको छ। तपाईंका # वटा इन्कोग्निटो विन्डो पुनः खुल्ने छैनन्।}}</translation>
<translation id="2203303261468330007">लिंकलाई Phromium को नयाँ ट्याबमा खोल्नुहोस्</translation>
<translation id="686463893976008238">पर्सनलाइजेसन र अन्य प्रयोजनका लागि Phromium तथा Google का अन्य सेवाहरू लिंक गर्नुहोस्</translation>
<translation id="3729187154190517324">"ट्याब र थप कुरा हाल्नुहोस्" बटन प्रयोग गरी एकभन्दा बढी ट्याब, फाइल र टुलहरू हालेर आफूले खोजेको कुराका बारेमा विस्तृत जानकारी प्राप्त गर्नुहोस्।</translation>
<translation id="5596264049590907430">Phromium प्रोफाइलहरू व्यवस्थापन गर्नुहोस्</translation>
<translation id="5594723037153142396">Phromium ले केही फाइलहरू डाउनलोड गर्न किन रोक्छ भन्ने बारेमा जान्नुहोस्</translation>
<translation id="3425307214497790458">तपाईंले कुनै कुराको समीक्षा गर्नु पर्ने भएमा Phromium ले तपाईंलाई त्यसका बारेमा जानकारी गराउने छ</translation>
<translation id="4247980944121268675">Phromium ले तपाईंले खोल्न सक्ने पेजहरू प्रिलोड गर्छ। तपाईंले ती पेज खोल्दा ती पेजहरू अझ छिटो लोड होऊन् भन्नाका लागि Phromium ले यसो गर्छ</translation>
<translation id="3810973564298564668">व्यवस्थित गर्नुहोस्</translation>
<translation id="1058395779823101457">आफूले सेभ गरेका पासवर्डहरू प्रयोग गर्न QR कोड स्क्यान गर्नुहोस्, Phromium को iOS संस्करण डाउनलोड गर्नुहोस् र आफ्नो Google खातामा साइन इन गर्नुहोस्</translation>
<translation id="3846683726093018685">**सारांश बनाउनुहोस्:** ३० भन्दा कम्ती शब्दको एउटै वाक्य बनाउनुहोस् र स्क्रिनसटमा रहेको सामग्रीको मुख्य विषय तथा उद्देश्यका बारेमा वर्णन गर्नुहोस्।

          **प्रश्नहरू सिफारिस गर्नुहोस्:** प्रयोगकर्ताले स्क्रिनसट राम्ररी बुझेर प्रश्न सोध्न सकून् भन्नाका लागि गहन रूपमा सोच्न बाध्य पार्ने खालका ३ देखि ५ वटा प्रश्नहरू भएको बुलेटसहितको एउटा सूची जेनेरेट गर्नुहोस्। यी प्रश्नहरूमा कम्तीमा एउटा भिजुअल अब्जेक्ट, यसको डिजाइन वा यो कहाँ देखाइएको छ भन्ने कुरा विशेष रूपमा समावेश गर्नु पर्दछ।</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - क्रोमियम</translation>
<translation id="430953676539987275">आफ्ना सबै डिभाइसमा आफ्ना बुकमार्कलगायतका कुराहरू प्राप्त गर्न Phromium मा साइन इन गर्नुहोस्</translation>
<translation id="3885770153807205175">ल्याङ्वेज पिकर</translation>
<translation id="5947409614720749543">Phromium लाई  कस्टम पार्नुका साथै यसमाथि नियन्त्रण गर्नुहोस्। केही कुराका सम्बन्धमा तपाईंको कारबाही आवश्यक छ - विवरण हेर्न क्लिक गर्नुहोस्।</translation>
<translation id="2176348074240183776">Phromium खोल्न र ब्राउज गर्न सुरु गर्नको लागि तपाइँको नाम क्लिक गर्नुहोस्।</translation>
<translation id="3892148308691398805">पाठ कपी गर्नुहोस्</translation>
<translation id="3679766722656346339"><ph name="EXISTING_USER" /> अहिले यो Phromium प्रोफाइलमा साइन इन हुनुहुन्छ। तपाईंले ब्राउज गर्ने डेटा गोप्य राख्न Phromium ले तपाईंका निम्ति छुट्टै प्रोफाइल बनाइदिन सक्छ।</translation>
<translation id="6085953975934135790">यो एक्स्टेन्सनले Chrome वेब स्टोरसम्बन्धी नीति उल्लङ्घन गर्छ र उक्त एक्स्टेन्सन असुरक्षित हुन सक्छ। यो एक्स्टेन्सनले अबदेखि तपाईंले खोल्ने साइटहरूमा रहेका तपाईंको व्यक्तिगत जानकारीलगायतका तपाईंको डेटा हेर्न र प्रयोग गर्न नसकोस् भन्नाका लागि यसलाई Phromium बाट हटाउनुहोस्।</translation>
<translation id="3941890832296813527">इन्स्टल गर्ने क्रममा त्रुटि भयो: इन्स्टलर फाइलनेम अवैध वा प्रयोग गर्न नमिल्ने खालको छ।</translation>
<translation id="608187946760434925">Phromium ले पासवर्ड कपी गर्ने प्रयास गरिरहेको छ। यसो गर्ने अनुमति दिन Windows को आफ्नो पासवर्ड टाइप गर्नुहोस्।</translation>
<translation id="3054592240125889472">आफ्ना सबै डिभाइसमा आफूले सेभ गरेको जानकारीलगायतका कुराहरू प्राप्त गर्न Phromium मा साइन इन गर्नुहोस्</translation>
<translation id="3140795250676341027">तपाईंले आफ्नो Google खातामा सेभ गरेका पासवर्ड, भुक्तानी विधि र ठेगाना यो डिभाइसबाट हटाइने छन्। ती पासवर्ड, भुक्तानी विधि र ठेगाना Phromium मा फेरि प्रयोग गर्न पुनः साइन इन गर्नुहोस्।</translation>
<translation id="395904275706073188">सुरक्षित गरिएका पेजहरू पढ्न सकिँदैन। अर्को पेज प्रयोग गरी हेर्नुहोस्।</translation>
<translation id="4227910144250222665">Phromium ले तपाईंलाई कसरी सुरक्षित राख्छ भन्ने कुरा जान्नुहोस्</translation>
<translation id="3967822245660637423">डाउनलोड पूर्ण भयो</translation>
<translation id="4150430234581811723">तपाईंले एड्रेस बार वा खोज बाकसमा टाइप गर्दा तपाईंलाई सुझावहरू देखाउन सकियोस् भन्नाका लागि Phromium ले तपाईंले टाइप गर्ने कुरा तपाईंको सङ्गठनको खोज, AI र एजेन्टसम्बन्धी टुलहरूमा पठाउँछ।</translation>
<translation id="3975724895399328945">Google Chrome for Testing का बारेमा</translation>
<translation id="3997429360543082038">ChromiumOS का बारेमा</translation>
