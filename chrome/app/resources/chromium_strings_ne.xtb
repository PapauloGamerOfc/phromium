<translation id="4182143801062869250">आफ्नो फोनमा भएको Phromium एप प्रयोग गरी आफूले रुचाएका वस्तुहरूको मूल्य घटेका खण्डमा अलर्ट प्राप्त गर्नुहोस्</translation>
<translation id="8118331347066725040">लेन्समार्फत खोज्ने सुविधासम्बन्धी प्रतिक्रिया पठाउनुहोस्</translation>
<translation id="849080025203861031">Phromium पर्सनलाइज गर्नुहोस्</translation>
<translation id="8133124826068723441">तपाईंको डोमेनका हकमा सिंक गर्ने सुविधा उपलब्ध नभएको हुनाले ChromiumOS ले तपाईंको डेटा सिंक गर्न सकेन।</translation>
<translation id="813913629614996137">सुरुवात गर्दै...</translation>
<translation id="139377652856781272">किबोर्ड सर्टकट प्रयोग गरी Phromium मा उपलब्ध Gemini खोल्नुहोस्।</translation>
<translation id="8577594891153686998">Phromium का सेवाका अतिरिक्त सर्तहरू</translation>
<translation id="6418547610462348357">यो फाइल खतरनाक छ, त्यसैले Phromium ले यसमाथि रोक लगाएको छ।</translation>
<translation id="8177472873527554730">यो पेजमा सामग्री भेटिएन</translation>
<translation id="6257816439683677727">आफ्नो खाता (<ph name="USER_EMAIL" />) मा Phromium को डेटा सेभ तथा प्रयोग गर्न आफ्नो पासफ्रेज हाल्नुहोस्</translation>
<translation id="820759916613250543">फोटो प्रयोग गरी खोज्ने सुविधामार्फत यो फोटो खोज्नुहोस्</translation>
<translation id="8221491193165283816">तपाईं सामान्यतया नोटिफिकेसनहरूमाथि रोक लगाउनुहुन्छ। यो साइटलाई तपाईंलाई नोटिफिकेसन पठाउन अनुमति दिन यहाँ क्लिक गर्नुहोस्।</translation>
<translation id="8672013454464753607">क्यामेरा प्रयोग गर्न <ph name="BEGIN_LINK" />सिस्टम सेटिङ<ph name="END_LINK" />मा गई Phromium लाई क्यामेराको एक्सेस दिनुहोस्</translation>
<translation id="8006746139865532235">Phromium ले यो एक्स्टेन्सनको स्रोत पुष्टि गर्न सक्दैन र यो असुरक्षित हुन सक्छ। यो एक्स्टेन्सनले अबदेखि तपाईंले खोल्ने साइटहरूमा रहेका व्यक्तिगत जानकारीलगायतका तपाईंको डेटा हेर्न र परिवर्तन गर्न नसकोस् भन्नाका लागि यसलाई Phromium बाट हटाउनुहोस्।</translation>
<translation id="5474258904581730105">कुनै छविमा उपयोगी विवरण नभएका खण्डमा Phromium ले तपाईंलाई एउटा विवरण उपलब्ध गराउने प्रयास गर्ने छ। विवरणहरू सिर्जना गर्न फोटो Google मा पठाइन्छ। तपाईं सेटिङहरूमा गई जुनसुकै बेला यसलाई निष्क्रिय पार्न सक्नुहुन्छ।</translation>
<translation id="5375524124600974413">नयाँ प्रोफाइल बनाएर Phromium मा साइन इन गर्ने हो?</translation>
<translation id="5242991719841602450"><ph name="EXISTING_USER" /> ले पहिलेदेखि नै साइन इन गर्नुभएको छ। छुट्टै ब्राउजर प्रयोग गर्न <ph name="USER_EMAIL_ADDRESS" /> मार्फत आफ्नै प्रोफाइल प्रयोग गरी Phromium मा साइन इन गर्नुहोस्। तपाईं <ph name="DEVICE" /> मा भएका आफ्ना पासवर्ड र अन्य विवरणहरू पनि प्राप्त गर्नु हुने छ।</translation>
<translation id="6524280192518819368">सिस्टम ट्रेमा Phromium मा उपलब्ध Gemini देखाउनुहोस् र किबोर्ड सर्टकट अन गर्नुहोस्</translation>
<translation id="2082268001133511745"><ph name="BEGIN_LINK" />Phromium ले तपाईंलाई<ph name="END_LINK" /> असुरक्षित साइट तथा डाउनलोडका बारेमा चेतावनी दिन्छ</translation>
<translation id="4030955203048827163">तपाईंले हालसालै कुनै पनि साइट खोल्नुभएको छैन। Phromium ले <ph name="PERMISSION" /> सम्बन्धी अनुमति सम्बन्धी अनुमति रद्द गरेको छ।</translation>
<translation id="8358344509940735943">Phromium iOS एपमार्फत क्यामेरामा देखिएका कुराहरू किनमेल, अनुवाद तथा पहिचान गर्नुहोस्</translation>
<translation id="7062802333437169650"><ph name="USER_NAME" /> का रूपमा Phromium मा साइन इन गर्न QR कोड</translation>
<translation id="8313851650939857356">स्टार्टअप गर्ने क्रममा निम्न त्रुटि भयो: <ph name="STARTUP_ERROR" />।</translation>
<translation id="751774429778958062">तपाईंको सङ्गठनले तोकेको नियमअनुसार तपाईंले <ph name="TIMEOUT_DURATION" /> सम्म Phromium प्रयोग गर्नुभएन भने त्यो स्वतः बन्द हुन्छ।</translation>
<translation id="8321888067342493336">फोटोका रूपमा सेभ गर्नुहोस्</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" /> ले पहिला Phromium प्रयोग गरिरहेको थियो</translation>
<translation id="5445795756751365814">Phromium मा स्किलहरू अन गर्नुहोस्</translation>
<translation id="7329745364783464770">आफ्नो Google खाता (<ph name="ACCOUNT_EMAIL" />) मा Phromium को डेटा प्रयोग गरिरहन Phromium अपडेट गर्नुहोस्</translation>
<translation id="5255856786869089460">तपाईंको कम्प्युटरमा Windows १० वा सोभन्दा नयाँ संस्करण छ भने मात्र तपाईं भविष्यमा Phromium का अपडेट प्राप्त गर्नुहुन्छ। यो कम्प्युटरमा Windows ८ प्रयोग भइरहेको छ।</translation>
