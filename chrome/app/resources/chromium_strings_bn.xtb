<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="bn">
<translation id="1026101648481255140">ইনস্টলেশন আবার চালু করুন</translation>
<translation id="1029669172902658969">&amp;ChromiumOS আপডেট করতে আবার লঞ্চ করুন</translation>
<translation id="7962340570690354348">এই এক্সটেনশন পর্যালোচনা করার জন্য Phromium সাজেশন দেয়</translation>
<translation id="2702007788032964762">কোনও সাইট তার পৃষ্ঠায় লিঙ্ক ব্যক্তিগতভাবে প্রিলোড করতে বললে, Phromium, Google সার্ভার ব্যবহার করে। এর ফলে প্রিলোড করা সাইটের থেকে আপনার পরিচয় লুকানো থাকে, কিন্তু Google জানতে পারে কোন সাইটগুলি প্রিলোড করা হয়েছে।</translation>
<translation id="1051793555070215510">এই ১-মিনিটের সমীক্ষায় অংশ নিয়ে ছদ্মবেশী মোড উন্নত করতে আমাদের সাহায্য করুন।</translation>
<translation id="1065672644894730302">আপনার অভিরুচিগুলি পড়া যাবে না৷ কিছু বৈশিষ্ট্য অনুপলব্ধ থাকতে পারে ও অভিরুচিগুলিতে করা পরিবর্তনগুলি সংরক্ষিত হবে না৷</translation>
<translation id="4964836565882496625">তোমার অভিভাবক Phromium-এর জন্য "সাইট, অ্যাপ ও এক্সটেনশনের অনুমতি" বন্ধ করে দিয়েছেন</translation>
<translation id="8409497136174302488">আশেপাশের ডিভাইস খুঁজে পেতে ও ব্যবহার করতে Phromium-কে আপনার লোকাল নেটওয়ার্ক অ্যাক্সেস করার অনুমতি দিতে হবে</translation>
<translation id="4388904545107211948">কোনও নির্দিষ্ট Phromium ফিচার বা এক্সটেনশন সার্চ করতে, অ্যাড্রেস বারে এটির শর্টকাট টাইপ করুন, তারপর আপনার বেছে নেওয়া কীবোর্ড 'কী' প্রেস করুন</translation>
<translation id="7188624550427159072">সিস্টেম ট্রেতে Phromium-এর মাধ্যমে সার্চ করুন ফিচার দেখান এবং কীবোর্ড শর্টকাট চালু করুন</translation>
<translation id="3689248207461565136">Phromium আপনার পাসওয়ার্ড এক্সপোর্ট করতে চাইছে। অনুমতি দিতে Windows এর পাসওয়ার্ড টাইপ করুন।</translation>
<translation id="112640046208448578">বস্তু বা জায়গা শনাক্ত করুন ও টেক্সট কপি বা অনুবাদ করুন। 'ছবি সার্চ করা' ফিচার ব্যবহার করতে সার্ভারে পৃষ্ঠার স্ক্রিনশট পাঠানো হয়। <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium আপনার ডিফল্ট ব্রাউজার</translation>
<translation id="5414044255592121327">আপনার পাসওয়ার্ড ডেটার নিরাপত্তা লঙ্ঘন এবং অন্যান্য নিরাপত্তা সংক্রান্ত সমস্যা থেকে সুরক্ষিত কিনা তা চেক করতে <ph name="BEGIN_LINK" />Phromium-এ সাইন-ইন করুন<ph name="END_LINK" />।</translation>
<translation id="1753507755668601921">Phromium মেনুতে ক্লিক করুন</translation>
<translation id="1157985233335035034">সাম্প্রতিক ভাষা</translation>
<translation id="1184145431117212167">আপনার Windows-এর ভার্সনে কাজ করছে না তাই ইনস্টল করা যায়নি।</translation>
<translation id="7861581212703831457">Phromium সম্পর্কে</translation>
<translation id="8752630985505435738">আপনার ফোনে Phromium-এর মাধ্যমে দাম ট্র্যাক করা সংক্রান্ত সতর্কতা পান</translation>
<translation id="1203500561924088507">ইনস্টল করার জন্য ধন্যবাদ। <ph name="BUNDLE_NAME" /> ব্যবহার করার আগে আপনাকে অবশ্যই ব্রাউজার রিস্টার্ট করতে হবে।</translation>
<translation id="4933432676089063712">একটি <ph name="IMPORTANT_UPDATE" /> বাকি আছে। আপনার ব্রাউজিং সুরক্ষিত রাখতে, পরের বার আপনি <ph name="IDLE_DURATION" /> ইনঅ্যাক্টিভ থাকলে Phromium আপডেট হবে।</translation>
<translation id="1232234696885483911">আপনি 'ছবি সার্চ করা' ফিচার খুললে, পৃষ্ঠার টাইটেল, URL এবং পিডিএফ সহ কন্টেন্ট অটোমেটিক সার্ভারে পাঠানো হবে। <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">আপনি সাইন-ইন করার সময়, Phromium-এ আপনার Google অ্যাকাউন্ট থেকে পাসওয়ার্ড এবং আরও অনেক কিছু ব্যবহার করতে পারবেন। এটি পরিবর্তন করতে, “Phromium-এ আপনার অ্যাকাউন্ট” বিকল্পে যান।</translation>
<translation id="7402478829083317456">Mac মেনু বারে Phromium-এ Gemini দেখুন</translation>
<translation id="4902531791098430822">Phromium-এ Gemini-তে স্ক্রিনের অংশ বেছে নিতে, কীবোর্ড শর্টকাট ব্যবহার করুন।</translation>
<translation id="9002284132405311162">Phromium যাতে দ্রুত কাজ করে সেই জন্য এই ট্যাব বন্ধ থাকাকালীন মেমরি খালি করা হয়েছে। এই সাইটটি অ্যাক্টিভ রাখার বিকল্প সব সময় বেছে নিতে পারবেন।</translation>
<translation id="5561666811965903444">এই ফাইলটি বিপজ্জনক, তাই Phromium এই ডাউনলোডটি ব্লক করে দিয়েছে</translation>
<translation id="1340271056805240721">Gmail বা YouTube-এর মতো Google পরিষেবায় <ph name="USER_EMAIL" /> দিয়ে সাইন-ইন করার সময় আপনি একই অ্যাকাউন্ট দিয়ে Phromium-এ অটোমেটিক সাইন-ইন করতে পারবেন</translation>
<translation id="5048805453292757697">আপনার ফোনে Phromium ডাউনলোড করুন</translation>
<translation id="1290883685122687410">সেট-আপ সংক্রান্ত সমস্যা: <ph name="METAINSTALLER_EXIT_CODE" />। <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">আপনার নতুন Phromium প্রোফাইল সেট আপ করুন</translation>
<translation id="7871721155662336863">Phromium-এ Gemini ব্যবহার করে দেখুন</translation>
<translation id="6569288432960798043">ব্লুটুথ ডিভাইসগুলি এক্সপ্লোর করতে
 Phromium-কে ব্লুটুথের অ্যাক্সেস দিতে হবে। <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">আপনার ফোনে Phromium-এ সাইন-ইন করুন</translation>
<translation id="1330562121671411446">ভাষা শনাক্ত করুন</translation>
<translation id="1619655755195586133">এছাড়া, Phromium থেকেও ডেটা মুছে দিন (<ph name="URL" />)</translation>
<translation id="1345251407431278948">পিন করা আছে! টুলবারে থাকা নতুন বোতাম থেকে আবার আপনি 'ছবি সার্চ করা' ফিচার অ্যাক্সেস করতে পারবেন</translation>
<translation id="1383876407941801731">খুঁজুন</translation>
<translation id="2947996037737257951">যেকোনও সময় ও জায়গায়, ব্রাউজ করা চালিয়ে যেতে Phromium অ্যাপ ব্যবহার করুন</translation>
<translation id="141901961143729572">আপনার মতামত শেয়ার করুন</translation>
<translation id="8355386219605656974">আপনার উইন্ডো শেয়ার করতে, সিস্টেম সেটিংস থেকে Phromium-এর জন্য স্ক্রিন রেকর্ডিংয়ের অনুমতি দিন।</translation>
<translation id="1478370723027452770">Chrome for Testing ব্যবহার করে সহায়তা পান</translation>
<translation id="8398257182826094665"><ph name="DEVICE" /> থেকে আপনার সেভ করা তথ্য ও আরও অনেক কিছু পেতে, Phromium-এ সাইন-ইন করুন</translation>
<translation id="1497802159252041924">ইনস্টলেশন সংক্রান্ত সমস্যা: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">এই পৃষ্ঠাটি সুরক্ষিত</translation>
<translation id="3484755999946650557">একটি Phromium ট্যাব শেয়ার করুন</translation>
<translation id="3309377459597801353">Phromium-এ সাইন-ইন করুন</translation>
<translation id="1547469039832541117">হাইলাইট করা টাস্ক শেষ করে।</translation>
<translation id="2354363290397602683">Phromium পিন করুন</translation>
<translation id="2244728813494358888">Phromium-এর নিরাপত্তা টুল</translation>
<translation id="707582364915018531">Phromium আপনার Password Manager সম্পর্কিত ডেটা মুছতে চায়। এটি করার অনুমতি দিতে, আপনার Windows-এর পাসওয়ার্ড টাইপ করুন।</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{একটি আপডেট প্রয়োগ করতে আপনার অ্যাডমিনিস্ট্রেটর আপনাকে Phromium আবার চালু করতে বলছেন}=1{একটি আপডেট প্রয়োগ করতে আপনার অ্যাডমিনিস্ট্রেটর আপনাকে Phromium আবার চালু করতে বলছেন। আপনার ছদ্মবেশী উইন্ডো আবার খুলবে না।}one{একটি আপডেট প্রয়োগ করতে আপনার অ্যাডমিনিস্ট্রেটর আপনাকে Phromium আবার চালু করতে বলছেন। আপনার #টি ছদ্মবেশী উইন্ডো আবার খুলবে না।}other{একটি আপডেট প্রয়োগ করতে আপনার অ্যাডমিনিস্ট্রেটর আপনাকে Phromium আবার চালু করতে বলছেন। আপনার #টি ছদ্মবেশী উইন্ডো আবার খুলবে না।}}</translation>
<translation id="5032531544901236587">ফোনে Phromium অ্যাপের মাধ্যমে Google-এর সেরা সব সুবিধা পান</translation>
<translation id="7311082384439462587">Phromium-এ মূল গোপনীয়তা এবং নিরাপত্তা নিয়ন্ত্রণ পর্যালোচনা করুন</translation>
<translation id="1640672724030957280">ডাউনলোড হচ্ছে...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, মেম্বারশিপ হিসেবে সাইন-ইন করেছেন। অ্যাকাউন্ট মেনু খুলুন</translation>
<translation id="4535436467771816034">মেসেজ, ডকুমেন্ট এবং অন্যান্য অ্যাপে থাকা লিঙ্কে ক্লিক করে যেকোনও সময় Phromium ব্যবহার করতে পারবেন। এছাড়াও এটি আপনার টাস্কবারেও পিন করা হবে।</translation>
<translation id="1709772298389099340">এটি <ph name="BROWSER_NAME" />-এর জন্য বিশেষ সুবিধার অ্যাক্সেস দেয়।</translation>
<translation id="1722488837206509557">এর ফলে আপনি উপলভ্য ডিভাইসগুলি থেকে বেছে নিতে পারবেন এবং সেগুলিতে কন্টেন্ট দেখাতে পারবেন।</translation>
<translation id="3550860956769006392">Phromium শীঘ্রই ব্রাউজ করা ডেটা মুছে ফেলবে</translation>
<translation id="2053384509423635834">Phromium নেভিগেশনকে HTTPS-তে আপগ্রেড করার চেষ্টা করবে</translation>
<translation id="2516115567501600458">Phromium ডেটা সাফ করা হয়েছে</translation>
<translation id="8571959122390670188">Phromium <ph name="REMAINING_TIME" />-এর মধ্যে রিস্টার্ট হবে</translation>
<translation id="6284080675125981628">HTTPS উপলভ্য না থাকলে, Phromium আপনাকে সতর্ক না করেই অসুরক্ষিত কানেকশন ব্যবহার করবে</translation>
<translation id="5872244334553252095">Phromium-কে ব্যাকগ্রাউন্ডে চলতে দিন</translation>
<translation id="2213761221916953829">Phromium কে আরও নিরাপদ করতে, আমরা কিছু এক্সটেনশান অক্ষম করেছি যা <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> এ তালিকাবদ্ধ করা হয়নি এবং হয়ত আপনাকে না জানিয়ে যোগ করা হয়েছে৷</translation>
<translation id="8807881428325438878">দ্রুত অ্যাক্সেসের জন্য আপনার টাস্কবারে Phromium পিন করতে, Windows বিজ্ঞপ্তিতে <ph name="BEGIN_BOLD" />হ্যাঁ<ph name="END_BOLD" /> বিকল্পে ক্লিক করুন</translation>
<translation id="6861833596843600606">Phromium আবার ইন্সটল করুন</translation>
<translation id="3950056404221550225">Phromium <ph name="AUTHENTICATION_PURPOSE" />-এর চেষ্টা করছে</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> আগেই সাইন-ইন করেছেন। আপনার ব্রাউজিংয়ের ডেটা আলাদা রাখতে, নিজের Phromium প্রোফাইলে <ph name="USER_EMAIL_ADDRESS" /> হিসেবে সাইন-ইন করুন। এছাড়াও আপনি <ph name="DEVICE" /> থেকে নিজের এক্সটেনশন ও আরও অনেক কিছু পাবেন।</translation>
<translation id="6114726049187747242">পরেরবার আপনার <ph name="DEVICE_TYPE" />-এ Phromium খোলার সময়, Google Password Manager ব্যবহার করার জন্য আপনাকে প্রম্পট দেখানো হবে।</translation>
<translation id="1838374766361614909">সার্চ সাফ করুন</translation>
<translation id="2724678689951174927">শুধুমাত্র এই ডিভাইস থেকে ব্রাউজ করা ডেটা মুছে দিতে, তা নিজের Google অ্যাকাউন্টে রেখে দেওয়ার সময়, <ph name="BEGIN_LINK" />Phromium থেকে সাইন-আউট করুন<ph name="END_LINK" />।</translation>
<translation id="402854649782215414">যেকোনও জায়গা থেকে নতুন ট্যাব গ্রুপ খুলতে বা তৈরি করতে আপনার ফোনে Phromium ডাউনলোড করুন।</translation>
<translation id="3191814926523151519">আপনার সাইন-ইন করা Google অ্যাকাউন্ট ম্যানেজ করতে পারবেন। Phromium ব্রাউজার, Play Store, Gmail সহ আরও অনেক কিছুর জন্য আপনার Google অ্যাকাউন্ট ব্যবহার করা হয়। পরিবারের সদস্যের মতো অন্য কারও অ্যাকাউন্ট যোগ করতে চাইলে, তার পরিবর্তে আপনার <ph name="DEVICE_TYPE" />-এ নতুন ব্যক্তিকে যোগ করুন। <ph name="LINK_BEGIN" />আরও জানুন<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">'ছবি সার্চ করা' ফিচারের মাধ্যমে সার্চ করুন</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> আগেই সাইন-ইন করেছেন। আপনি আলাদাভাবে ব্রাউজ করতে চাইলে, নিজের Phromium প্রোফাইলে <ph name="USER_EMAIL_ADDRESS" /> হিসেবে সাইন-ইন করুন। এছাড়াও আপনি <ph name="DEVICE" /> থেকে নিজের বুকমার্ক ও আরও অনেক কিছু পাবেন।</translation>
<translation id="1880677175115548835">টেক্সট বেছে নিন</translation>
<translation id="1236934630660512644">আপনি একটি পরিচালিত অ্যাকাউন্টের মাধ্যমে সাইন-ইন করুন করছেন এবং এর অ্যাডমিনিস্ট্রেটরকে আপনার Phromium প্রোফাইলের উপরে নিয়ন্ত্রণ দিচ্ছেন৷ আপনার Phromium ডেটা, যেমন অ্যাপ, বুকমার্ক, ইতিহাস, পাসওয়ার্ড এবং অন্যান্য সেটিংস <ph name="USER_NAME" /> এতে স্থায়ীভাবে সম্পৃক্ত হবে৷ আপনি Google অ্যাকাউন্টগুলির ড্যাশবোর্ডের মাধ্যমে এই ডেটাগুলি মুছতে চালু হবেন, কিন্তু অন্য অ্যাকাউন্টের সাথে এই ডেটা সংশ্লিষ্ট করতে পারবেন না৷ বিকল্প হিসেবে আপনি আপনার বিদ্যমান Phromium তথ্য আলাদা রাখার জন্য একটি নতুন প্রোফাইল তৈরি করতে পারেন৷ <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">স্মুথ স্ক্রলিং ও ভিডিও ফ্রেম রেটের মতো ব্যাকগ্রাউন্ড অ্যাক্টিভিটি ও ভিজ্যুয়াল এফেক্টকে সীমিত করার মাধ্যমে Phromium ব্যাটারির চার্জ সাশ্রয় করে। <ph name="BEGIN_LINK" />পাওয়ার সেভার সম্পর্কে আরও জানুন<ph name="END_LINK" /></translation>
