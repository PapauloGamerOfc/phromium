<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="1026101648481255140">Орнатуды жалғастыру</translation>
<translation id="1029669172902658969">&amp;ChromiumOS жүйесін жаңарту үшін қайта іске қосу</translation>
<translation id="7962340570690354348">Phromium осы кеңейтімді қарап шығуды ұсынады</translation>
<translation id="2702007788032964762">Сайт беттегі сілтемелерді құпия түрде алдын ала жүктеуді сұрағанда, Phromium браузері Google серверлерін пайдаланады. Осылайша жеке деректеріңіз алдын ала жүктелетін сайттан жасырылады, бірақ Google алдын ала жүктелетін сайттарды біледі.</translation>
<translation id="1051793555070215510">Осы 1 минуттық сауалнамаға жауап беру арқылы инкогнито режимін жақсартуымызға көмектесіңіз.</translation>
<translation id="1065672644894730302">Реттеулерді оқу мүмкін емес.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін және параметрлерге жасалған өзгертулер сақталмайды.</translation>
<translation id="4964836565882496625">Ата-анаңыз Phromium браузері үшін "Сайттарға, қолданбаларға және кеңейтімдерге арналған рұқсаттар" параметрін өшірді</translation>
<translation id="8409497136174302488">Маңайдағы құрылғыларды табу және пайдалану үшін Phromium-ге жергілікті желіні пайдалану рұқсаты қажет</translation>
<translation id="4388904545107211948">Белгілі бір Phromium функциясын немесе кеңейтімін іздеу үшін мекенжай жолағына оның жылдам пәрменін енгізіп, содан кейін таңдалған пернені басыңыз.</translation>
<translation id="7188624550427159072">Phromium-мен іздеу функциясын жүйелік науада көрсету және пернелер тіркесімін қосу</translation>
<translation id="3689248207461565136">Phromium құпия сөздерді экспорттағысы келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="112640046208448578">Заттарды не орындарды анықтауға және мәтінді көшіруге не аударуға болады. "Сурет іздеу" функциясын пайдаланғанда, беттің скриншоты серверге жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium әдепкі браузеріңіз болып табылады</translation>
<translation id="5414044255592121327">Құпия сөздеріңіздің ұрланудан және басқа да қауіпсіздік мәселелерінен қаншалықты қорғалғанын тексеру үшін <ph name="BEGIN_LINK" />Phromium браузеріне кіріңіз<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Phromium мәзірін басыңыз.</translation>
<translation id="1157985233335035034">Жақында таңдалған тілдер</translation>
<translation id="1184145431117212167">Орнатылмады, себебі сіздегі Windows нұсқасына қолдау көрсетілмейді.</translation>
<translation id="7861581212703831457">Phromium туралы ақпарат</translation>
<translation id="8752630985505435738">Телефондағы Phromium арқылы бағаны бақылау туралы хабарландырулар алыңыз</translation>
<translation id="1203500561924088507">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> өңделіп жатыр. Браузерді қауіпсіз пайдалану үшін Phromium келесі жолы <ph name="IDLE_DURATION" /> бойы әрекетсіз болғаныңызда жаңартылады.</translation>
<translation id="1232234696885483911">"Сурет іздеу" функциясын ашқан кезде, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге автоматты түрде жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">Аккаунтқа кірсеңіз, Phromium-нен Google аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. Мұны өзгерту үшін "Phromium-дегі аккаунтыңыз" бөліміне өтіңіз.</translation>
<translation id="7402478829083317456">Phromium-дегі Gemini-ды Mac мәзір жолағында көрсету</translation>
<translation id="4902531791098430822">Phromium-дегі Gemini-да экранның бір бөлігін таңдау үшін пернелер тіркесімін пайдаланыңыз.</translation>
<translation id="9002284132405311162">Бұл қойынды әрекетсіз тұрған кезде, Phromium жылдам жұмыс істеуі үшін, жад босатылды. Сіз бұл сайтты әрекетсіз тұру тізімінен әрдайым шығарып отыру опциясын таңдай аласыз.</translation>
<translation id="5561666811965903444">Phromium жүктеп алуды блоктады, себебі бұл файл қауіпті.</translation>
<translation id="1340271056805240721">Gmail не YouTube сияқты Google қызметтеріне <ph name="USER_EMAIL" /> көмегімен кірген кезде, Phromium-ге сол аккаунтпен автоматты түрде кіруге болады.</translation>
<translation id="5048805453292757697">Phromium-ді телефоныңызға орнатыңыз</translation>
<translation id="1290883685122687410">Реттеу қатесі: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">Жаңа Phromium профилінің параметрлерін реттеу</translation>
<translation id="7871721155662336863">Phromium-дегі Gemini-мен байқап көру</translation>
<translation id="6569288432960798043">Bluetooth құрылғыларын табу үшін Phromium-ге Bluetooth пайдалану рұқсаты қажет. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">Телефоныңыздағы Phromium-ге кіріңіз</translation>
<translation id="1330562121671411446">Тілді анықтау</translation>
<translation id="1619655755195586133">Деректерді Phromium-нен (<ph name="URL" />) де жою</translation>
<translation id="1345251407431278948">Бекітілді! "Сурет іздеу" функциясына құралдар тақтасындағы жаңа түймені басу арқылы қайта кіруге болады.</translation>
<translation id="1383876407941801731">Іздеу</translation>
<translation id="2947996037737257951">Жол-жөнекей шолу үшін Phromium пайдаланыңыз.</translation>
<translation id="141901961143729572">Ойыңызды бөлісіңіз.</translation>
<translation id="8355386219605656974">Терезені бөлісу үшін жүйе параметрлерінде Phromium-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="1478370723027452770">Chrome for Testing бойынша анықтама алу</translation>
<translation id="8398257182826094665"><ph name="DEVICE" /> құрылғысынан сақталған ақпарат пен басқа деректерді алу үшін Phromium-ге кіріңіз.</translation>
<translation id="1497802159252041924">Орнату қатесі: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Бұл бет қорғалған</translation>
<translation id="3484755999946650557">Phromium қойындысын бөлісу</translation>
<translation id="3309377459597801353">Phromium аккаунтына кіру</translation>
<translation id="1547469039832541117">Ерекшеленген тапсырманы аяқтайды.</translation>
<translation id="2354363290397602683">Phromium-ді бекіту</translation>
<translation id="2244728813494358888">Phromium-нің қауіпсіздік құралдары</translation>
<translation id="707582364915018531">Phromium браузері Password Manager-дегі деректеріңізді жоюға рұқсат сұрайды. Рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{Жаңартылған нұсқаны қолдану үшін әкімшіңіз Phromium браузерін қайта іске қосуыңызды талап етеді.}=1{Жаңартылған нұсқаны қолдану үшін әкімшіңіз Phromium браузерін қайта іске қосуыңызды талап етеді. Инкогнито терезесі қайта ашылмайды.}other{Жаңартылған нұсқаны қолдану үшін әкімшіңіз Phromium браузерін қайта іске қосуыңызды талап етеді. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="5032531544901236587">Телефондағы Phromium-мен Google-дың барлық мүмкіндігін пайдаланыңыз</translation>
<translation id="7311082384439462587">Phromium-дегі құпиялық пен қауіпсіздікті басқарудың маңызды құралдарын қарап шығыңыз.</translation>
<translation id="1640672724030957280">Жүктеп алынып жатыр…</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" /> (мүше) ретінде кірдіңіз. Аккаунт мәзірін ашу</translation>
<translation id="4535436467771816034">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, Phromium браузерін кез келген уақытта пайдалана аласыз. Сондай-ақ ол тапсырмалар жолағына бекітіледі.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> браузеріне кеңейтілген құқықтар береді.</translation>
<translation id="1722488837206509557">Бұл жағдайда қолжетімді құрылғылардың арасынан таңдап, оларда контент көрсетуге болады.</translation>
<translation id="3550860956769006392">Phromium жақын арада браузерді пайдалану деректерін жояды</translation>
<translation id="2053384509423635834">Phromium браузері навигацияларды HTTPS кеңейтіміне жаңартып көреді.</translation>
<translation id="2516115567501600458">Phromium деректері жойылды</translation>
<translation id="8571959122390670188">Phromium <ph name="REMAINING_TIME" /> кейін қайта қосылады</translation>
<translation id="6284080675125981628">HTTPS қолжетімді болмаған кезде, Phromium сізге ескертпестен, қауіпті байланысты пайдаланады.</translation>
<translation id="5872244334553252095">Phromium жүйесін фонда іске қосуға рұқсат беру</translation>
<translation id="2213761221916953829">Phromium қауіпсіз ету үшін <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ішінде көрсетілмеген және сізге білдірмей қосылған болуы мүмкін кейбір кеңейтімдерді өшірдік.</translation>
<translation id="8807881428325438878">Phromium-ге жылдам кіру үшін оны тапсырмалар жолағына бекітіңіз. Ол үшін Windows хабарландыруындағы <ph name="BEGIN_BOLD" />Иә<ph name="END_BOLD" /> түймесін басыңыз.</translation>
<translation id="6861833596843600606">Phromium қайта орнату</translation>
<translation id="3950056404221550225">Phromium <ph name="AUTHENTICATION_PURPOSE" /> қолданып көрейін деп жатыр</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Кеңейтімдер мен басқа деректер <ph name="DEVICE" /> құрылғысында қолжетімді болады.</translation>
<translation id="6114726049187747242">Келесі жолы Phromium-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, Google Password Manager-ді пайдалану туралы нұсқауды көресіз.</translation>
<translation id="1838374766361614909">Іздеуді тазарту</translation>
<translation id="2724678689951174927">Браузерді пайдалану деректерін Google аккаунтында сақтай отырып, тек осы құрылғыдан жою үшін <ph name="BEGIN_LINK" />Phromium-де аккаунттан шығыңыз<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">Жолда жаңа қойындылар тобын ашу немесе жасау үшін телефоныңызға Phromium-ді жүктеп алыңыз.</translation>
<translation id="3191814926523151519">Кірген Google аккаунттарыңызды басқара аласыз. Google аккаунттарыңыз Phromium браузері, Play Store, Gmail және тағы басқа қызметтерде пайдаланылады. Егер отбасы мүшесі сияқты әлдебіреудің аккаунтын қосқыңыз келсе, жаңа пайдаланушыны <ph name="DEVICE_TYPE" /> құрылғыңызға қосыңыз. <ph name="LINK_BEGIN" />Толығырақ<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">"Сурет іздеу" функциясымен іздеу</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Бетбелгілер мен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="1880677175115548835">Мәтінді таңдаңыз</translation>
<translation id="1236934630660512644">Бақыланатын аккаунт арқылы кіріп, оның әкімшісіне Phromium профиліңізді басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты Phromium деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME" /> пайдаланушысына байланыстырылады. Бұл деректерді Google аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. Бар Phromium деректерін бөлек ұстау үшін қосымша жаңа профиль жасай аласыз. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium браузері біркелкі айналдыру және бейнекадр жиілігі сияқты фондық әрекеттерді және визуалдық әсерлерді шектеу арқылы батарея қуатын үнемдейді. <ph name="BEGIN_LINK" />Қуат үнемдеу туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">"Phromium-ді жаңарту құралы" қызметі</translation>
<translation id="5797624919204275541">Бұл функцияны өшіріп, Phromium браузеріне кірместен Gmail сияқты Google сайттарын пайдалана беруіңізге болады</translation>
<translation id="6850971726764387814">Phromium жауап бермейді. Қазір қайта іске қосасыз ба?</translation>
<translation id="8289779763124483945">Ұйымыңыз (<ph name="MANAGER" />) Phromium-ге кіруді талап етеді</translation>
<translation id="193439633299369377">Жаңарту күшіне енуі үшін ChromiumOS жүйесін өшіріп қосу керек.</translation>
<translation id="3215238748514810076">Phromium жүктеп алуды блоктады, себебі бұл файл түрі әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="1953553007165777902">Жүктеп алынып жатыр… <ph name="MINUTE" /> минут қалды.</translation>
<translation id="8529252122707161160">Phromium әдепкі браузерді анықтай не орната алмайды</translation>
<translation id="197326043290947695">Сурет іздеу функциясымен тиімдірек шолыңыз</translation>
<translation id="7769772561254542263">Неліктен Phromium кейбір файлдарды блоктайтыны туралы ақпарат жаңа қойындыдан ашылады.</translation>
<translation id="3713013456746186442">Phromium бағдарламалық құралын жаңартып отырады. Егер бұл қызмет өшірілген немесе тоқтатылған болса, Phromium бағдарламалық құралыңыз жаңартылмайды. Нәтижесінде қауіпсіздік ақауларын жою мүмкін болмай, функциялар жұмыс істемеуі мүмкін. Бұл қызмет пайдаланылатын Phromium бағдарламалық құралы болмаса, өздігінен жойылады.</translation>
<translation id="5690439379999550641">Құрылғыдан 1 элемент жойылады. Деректерді кейінірек алу үшін Phromium браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="2018879682492276940">Орнатылмады. Қайталап көріңіз.</translation>
<translation id="2039417478970545937">Параметрлер.</translation>
<translation id="4765042254400173473">Google қызметтерінде жекелендірілген мүмкіндіктерді пайдалану үшін Phromium тарихын қосу-қоспау нұсқасын таңдаңыз.</translation>
<translation id="1448229429009113044">Күрделі құпия сөздерді жасауға, сақтауға және автоматты түрде толтыруға көмектесу үшін Phromium-ге ендірілген. Оңай кіру үшін пернелер тіркесімін қосыңыз.</translation>
<translation id="2145664943269651168">Phromium-ге жаңа көрініс беру үшін жаңа қойынды бетіндегі "Phromium-ді бейімдеу" түймесін басыңыз.</translation>
<translation id="6052463185672312901">Phromium жүктеп алуды блоктады, себебі бұл – алдамшы файл және ол құрылғыңызға күтпеген өзгерістер енгізуі мүмкін.</translation>
<translation id="3825064703718009924">Phromium iOS браузерін келесіде ашқанда, <ph name="FEATURE_NAME" /> функциясын пайдаланып көру туралы нұсқауды көресіз.</translation>
<translation id="886729435477608858">Google аккаунтыңызда сақталған құпия сөздеріңіз бен Phromium-дегі басқа деректеріңіз осы құрылғыдан өшіріледі. Оларды Phromium-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Phromium 1 минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}other{Phromium # минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}}</translation>
<translation id="2125838419757773031">Іздеу үшін экран аймағын таңдаңыз.</translation>
<translation id="2126108037660393668">Жүктеп алынған файл растаудан өтпеді.</translation>
<translation id="2135919691573380097">Осы сайт туралы шағымдану</translation>
<translation id="2137162749895930932">Аударма экранын жабу</translation>
<translation id="2147218225094845757">Бүйірлік панельді жасыру</translation>
<translation id="1628700182434635922">Phromium жүктеп алуды блоктады, себебі сайтта қауіпсіз байланыс пайдаланылып жатқан жоқ және файл өзгертілген болуы мүмкін.</translation>
<translation id="2170098639895543546">Беттен кез келген нәрсені таңдау</translation>
<translation id="1807571394075492085">Phromium-ді реттеу</translation>
<translation id="2174917724755363426">Орнату аяқталмады. Шынымен бас тартқыңыз келе ме?</translation>
<translation id="8332848361915479268">Phromium – Желіге кіру - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Жаңа нұсқаны тексеру қатесі: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Аккаунтты Phromium-нен өшіру</translation>
<translation id="6063124961634921864">Үздік сатып алу құралдарын жол-жөнекей алып жүру үшін Phromium пайдаланыңыз.</translation>
<translation id="8646569091716523420">iOS жүйесіне арналған Phromium-дегі Күшейтілген Safe Browsing деректеріңізді фондық режимде қорғауға көмектеседі.</translation>
<translation id="3084983792533696835">Сайт қауіпті. Phromium хабарландыруларды өшірді.</translation>
<translation id="2236949375853147973">Әрекеттерім</translation>
<translation id="6387327671844988108">Мекенжайлар мен басқа ақпаратты барлық құрылғыдан алу үшін Phromium аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл мекенжай Google аккаунтыңызға сақталады.</translation>
<translation id="722050260205928409">Компьютерді бөлісетін болсаңыз, достарыңыз интернетке бөлек кіріп, Phromium жүйесін қалауынша орната алады.</translation>
<translation id="703211526866942526">Phromium-дегі дағдылар</translation>
<translation id="2283803047247799269">Бұл қойындыны сурет іздеу функциясымен іздеу</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Phromium браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{Phromium браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="2307973900865360088">Бекітілген күйде қалдыру</translation>
<translation id="6083276764640161328">URL мекенжайларын Phromium браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді. Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, Phromium браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="2356070529366658676">Сұрау</translation>
<translation id="2359808026110333948">Жалғастыру</translation>
<translation id="741972887620936671">"<ph name="EXTENSION_NAME" />" кеңейтімін қолдану үшін Phromium-ге кіруіңіз керек</translation>
<translation id="4709464915929597251">Phromium-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="6804933363437420201">Бұл кеңейтімді <ph name="USER_EMAIL_ADDRESS" /> ретінде пайдалану үшін Phromium-ге кіріңіз.</translation>
<translation id="2384373936468275798">ChromiumOS деректеріңізді синхрондай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{1 HID құрылғысын бір немесе бірнеше Phromium кеңейтімі пайдаланды}=1{1 HID құрылғысын бір немесе бірнеше Phromium кеңейтімі пайдаланып жатыр}other{# HID құрылғысын бір немесе бірнеше Phromium кеңейтімі пайдаланып жатыр}}</translation>
<translation id="1394893265611797679">Phromium бұл сайт үшін камера мен микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="2403703063067034158">Іске қосу қатесі: қазір басқа орнату процесі жүріп жатыр, әрекетті кейінірек қайталаңыз.</translation>
<translation id="8457868297375575309">Кез келген қолданбадағы сілтемелерді Phromium-нен ашып, браузерді тапсырмалар жолағында қолжетімді етіп қойыңыз.</translation>
<translation id="5354209517289935579">Қысқаша мазмұнын біліп, қосымша сұрақтар қою мақсатында бұл құжатты Phromium-дегі Gemini-мен бөлісу үшін "Қысқаша мазмұндау" түймесін басыңыз.</translation>
<translation id="6628402244681586711"><ph name="BEGIN_LINK" />Phromium-дегі құралдар<ph name="END_LINK" /> көмегімен браузерді қауіпсіз қолданып, барлығын басқаруға болады.</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Құпия сөздер мен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="2451727308784734061">Password Manager қызметіне жылдам өту үшін таңбашаны пайдаланыңыз. Таңбашаны компьютердің негізгі экранына немесе қолданбаларды іске қосу тақтасына жылжытуға болады.</translation>
<translation id="1593547119543498467">Phromium жақын арада жабылады</translation>
<translation id="6814323389195469782">Phromium аясында</translation>
<translation id="2485422356828889247">Жою</translation>
<translation id="2513154137948333830">Өшіріп қосу қажет: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">"Сурет іздеу" функциясымен мәтінді таңдаңыз.</translation>
<translation id="2643581100433412871">Phromium бұрыннан бар құпия сөздерді ауыстырғысы келеді. Бұған рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="4103676945224728292">Файлдарды жүктеп алу үшін Phromium браузеріне сақтау орнын пайдалану құқығы қажет</translation>
<translation id="8743720024689622265">Phromium Helper</translation>
<translation id="2575822587468774919">"Сурет іздеу" функциясымен іздеу керек кез келген нәрсені таңдаңыз.</translation>
<translation id="8692134707551176334">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін Phromium аккаунтына кіріңіз.</translation>
<translation id="6035715610127790081">Phromium браузерін жүктеп алу және Google аккаунтына кіру үшін телефонмен QR кодын сканерлеңіз.</translation>
<translation id="1579158377846894470">Phromium-мен іздеу үшін.</translation>
<translation id="3626651250874375470">Phromium-ді пайдалана беру</translation>
<translation id="259935314519650377">Жүктеп алынған орнату құралы кэштелмеді. Қате: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Жүйе</translation>
<translation id="7634640424937626608">Ұйымыңыз сіздегі бетбелгілер, тарих және құпия сөздер сияқты браузерді пайдалану деректерін көріп, басқара алады. Ол басқа Phromium профильдеріндегі браузерді пайдалану деректерін көре алмайды.</translation>
<translation id="2669565213445601962">Phromium деректерін <ph name="ACCOUNT_EMAIL" /> аккаунтында қолдану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін Phromium-ді қайта іске қосуыңызды талап етеді.}=1{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін Phromium-ді қайта іске қосуыңызды талап етеді. Инкогнито терезесі қайта ашылмайды.}other{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін Phromium-ді қайта іске қосуыңызды талап етеді. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="4393202019354077587">Phromium-ді іске қосу</translation>
<translation id="3192212313802409327">Орнату барысында операциялық жүйе қатесі орын алды. Phromium қайта жүктеңіз.</translation>
<translation id="6648732950668475680">Құрылғыңызды басқа адамдар да пайдаланатын болса, достарыңыз және отбасыңыздың мүшелері интернетке бөлек кіріп, Phromium параметрлерін өздері қалағандай орната алады.</translation>
<translation id="3501804488281766385">Phromium кішірейтілсе де, Phromium-дегі Gemini-ға құрылғыңызда оңай кіріп, пайдаланыңыз.</translation>
<translation id="5655763731487334489">Phromium қойындысы</translation>
<translation id="582020748041490207">Қосымша қауіпсіздік үшін Phromium деректеріңізді шифрлайды.</translation>
<translation id="2693283019505702310">Phromium-нен Google аккаунтын өшіру үшін аккаунттан шығыңыз.</translation>
<translation id="2989508583692830513">Құпия сөздерді, бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін Phromium аккаунтына кіріңіз.</translation>
<translation id="2738871930057338499">Интернетке қосылу мүмкін емес. HTTP 403 бойынша тыйым салынған. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="2753623023919742414">Іздеу үшін басыңыз.</translation>
<translation id="3391021955306442819">Phromium-ді әдепкі PDF көру құралы ретінде орнату</translation>
<translation id="293156805028931571">Бұл кеңейтімде зиянды бағдарлама бар болғандықтан, ол қауіпті. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Phromium-нан жойыңыз.</translation>
<translation id="2799223571221894425">Қайта іске қосу</translation>
<translation id="4742633141454352374">Сіздің Phromium браузеріңіз</translation>
<translation id="2816462166102338036">Бұл бейнені сурет іздеу функциясымен іздеу</translation>
<translation id="2191308357458164968">Жол-жөнекей iOS-тегі Phromium арқылы камерамен тауарларды тауып, бағаның төмендеуін бақылап, басқа да әрекеттерді орындаңыз.</translation>
<translation id="2841525013647267359">Бастапқы тіл</translation>
<translation id="2846251086934905009">Орнату қатесі: орнату аяқталмады, оның орнына доғарылды.</translation>
<translation id="4498037716339180906">Phromium жүйесінен алып тастау…</translation>
<translation id="4049188396834160957">Аккаунтқа кірген кезде, Phromium браузерінде қауіпсіздігіңізді қамтамасыз етеді және басқа Google қолданбаларында қауіпсіздік деңгейін арттыру үшін пайдаланылуы мүмкін.</translation>
<translation id="2885378588091291677">Тапсырмалар реттегіші</translation>
<translation id="4119302609687132178">&amp;Phromium туралы</translation>
<translation id="2915996080311180594">Кейін қайта қосу</translation>
<translation id="8232968781653330429">Деректер құпия фразаңызбен шифрланды. Google аккаунтыңызда Phromium деректерін пайдалану және сақтау үшін оны енгізіңіз.</translation>
<translation id="2945997411976714835">Орнату қатесі: орнату процесі басталмады.</translation>
<translation id="5624652745932625503">iOS жүйесіне арналған Phromium-де сақталған құпия сөздер арқылы сайттарға жылдам кіріңіз.</translation>
<translation id="8821179372057577828">Phromium-ді ұйымыңыз басқарады</translation>
<translation id="741172935898285572">Phromium жаңартылған</translation>
<translation id="8798708493876822519">Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, Phromium браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="6896740867011823632">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін Phromium-ге кіріңіз.</translation>
<translation id="3003694935412297923">Барлық тапсырма</translation>
<translation id="3580865868015023718">{count,plural, =1{Phromium браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{Phromium браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="1211179250505223767"><ph name="URL" /> сілтемесі Phromium-дегі жаңа қойындыдан ашылады.</translation>
<translation id="4742400838355945730">Дағдылар сияқты ЖИ инновациялары Google аккаунтыңызға сақталады және Phromium Sync-тен бөлек басқарылады.</translation>
<translation id="8070050512429584052">Барлық құрылғыдан кеңейтімдер мен басқа ақпаратты алу үшін Phromium-ге кіріңіз.</translation>
<translation id="666691655897541311">Phromium жүйесіне қосылуда…</translation>
<translation id="3038232873781883849">Сәлден соң орнатыла бастайды…</translation>
<translation id="3045032126857188731">Аударма тілі: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">"Пікір" диалогтік терезесін жабу</translation>
<translation id="919456815618829047"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Оқу тізімі мен басқа деректерді <ph name="DEVICE" /> құрылғысынан да аласыз.</translation>
<translation id="6141754610526066487">Басқа Phromium профильдері</translation>
<translation id="2380720899384114679">Кеңейтімдер – Phromium браузерін бейімдеуге мүмкіндік беретін қосымшалар. Олар Phromium-ді өзіңізге ыңғайлы етіп реттеуге, күнделікті тапсырмаларды жеңілдетуге көмектеседі.</translation>
<translation id="2507281899032275020">Google компаниясына жаңылыс туралы есептер және <ph name="UMA_LINK" /> жіберу арқылы Phromium жақсартуға көмектесіңіз</translation>
<translation id="1514966729948178660">Жол-жөнекей Google қауіпсіздігін қамтамасыз ету үшін Phromium пайдаланыңыз.</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{1 USB құрылғысын бір немесе бірнеше Phromium кеңейтімі пайдаланды}=1{1 USB құрылғысын бір немесе бірнеше Phromium кеңейтімі пайдаланып жатыр}other{# USB құрылғысын бір немесе бірнеше Phromium кеңейтімі пайдаланып жатыр}}</translation>
<translation id="78720743239019396"><ph name="DEVICE" /> құрылғысынан оқу тізімі мен басқа ақпаратты алу үшін Phromium-ге кіріңіз.</translation>
<translation id="7000206277447032115">Phromium тарихы</translation>
<translation id="4555002192651219296">Орнату құралы мұрағаттан шығара алмады. Phromium қолданбасын қайта жүктеңіз.</translation>
<translation id="310459126943037700">Тапсырмалар аяқталмады.</translation>
<translation id="3104828284009500087">Беттегі кез келген нәрсені іздеңіз.</translation>
<translation id="4867557516756736957">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді Phromium-ге жаңартып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз.</translation>
<translation id="8632308594821621017">Phromium микрофоныңызды пайдалануда.</translation>
<translation id="3130333203120345554">Жаңадан іздеу</translation>
<translation id="3137969841538672700">Іздеу үшін курсорды жүргізіңіз.</translation>
<translation id="9173792796158381383">Бұл қойынды ресурстарды көп қолданып жатыр. Өнімділікті жақсарту үшін Phromium-ге оны әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="8874679893080632357">Экранды бөлісу үшін жүйе параметрлерінде Phromium-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="101045618220347251">Phromium қолданбасын қайта іске қосу</translation>
<translation id="3161522574479303604">Барлық тіл</translation>
<translation id="5940989267583033306">Сілтемені Phromium инкогнито терезесінде ашу</translation>
<translation id="2045477525210426976">Жаңа Phromium профилін реттеңіз.</translation>
<translation id="3540518135502114323">Қойындыларды ауыстырмай-ақ ЖИ режимінде сөйлесе беруге болады. Бастау үшін Phromium-ге кіріңіз. Құпия сөздер мен басқа деректеріңіз барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="1496180326063744749">Phromium-нен Google аккаунтын өшіру үшін Phromium-нен "Параметрлер" бетінде шығыңыз.</translation>
<translation id="7792783034323745412">Кейінірек Phromium сізден үлгілерді автоматты түрде толтыру үшін сақталған ақпаратты пайдалану-пайдаланбау қажеттігін сұрауы мүмкін.</translation>
<translation id="5240091371721695404">Phromium өзінің деректер каталогін оқи және оған жаза алмайды:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">Таңдаулы Google AI құралдарын iOS-тегі Phromium-де жол-жөнекей алып жүріңіз.</translation>
<translation id="4848363951707149242"><ph name="DEVICE" /> құрылғысынан кеңейтімдер мен басқа ақпаратты алу үшін Phromium-ге кіріңіз.</translation>
<translation id="3286538390144397061">Қазір қайта іске қосу</translation>
<translation id="8613877111531019527">Google API пернелері жоқ. Кейбір Phromium функциялары өшіріледі.</translation>
<translation id="2784090498377460662">Phromium жабылғанда, фондық қолданбаларды пайдалануды жалғастыру</translation>
<translation id="3905054486991167751">Phromium сіз жоқ кезде жаңартылады.</translation>
<translation id="4502950976754616266">Phromium кез келген сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="6107453188231652861">Phromium-де аккаунтқа кірген болсаңыз, барлық Phromium терезесін жапқан кезде, Google аккаунтын қоспағанда, сайттардың көпшілігінен шығарыласыз. Сайттар сізді есте сақтасын десеңіз, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">іздеу аймағының жоғарғы оң жақ бұрышы: оң жақ <ph name="RIGHT" />%, жоғарғы жақ <ph name="TOP" />%</translation>
<translation id="5896635343289575401">Аккаунтыңыздағы Phromium деректері</translation>
<translation id="5662253013097242821">Құпия сөздерді телефондағы Phromium-мен пайдаланыңыз</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">Бұрыннан бар Phromium профиліне ауыстырылсын ба?</translation>
<translation id="3412460710772753638">Осы құрылғыдағы Құпия сөз менеджерінде</translation>
<translation id="657700335789940813">Phromium жаңартқысы келеді</translation>
<translation id="3487742274367151379"><ph name="DEVICE" /> құрылғысынан бетбелгілер мен басқа ақпаратты алу үшін Phromium-ге кіріңіз.</translation>
<translation id="3438772217992559640">Бұл қойындыны сурет іздеу функциясымен іздеу</translation>
<translation id="8062355070850891600">Телефоныңыздағы Phromium браузерімен күшейтілген Safe Browsing мүмкіндіктерін кеңейтіңіз</translation>
<translation id="5419337472918920970">Phromium-ді сізге бейімдеп жатырмыз...</translation>
<translation id="6573105037542661278">Құрылғыдан <ph name="ITEMS_COUNT" /> элемент жойылады. Деректерді кейінірек алу үшін Phromium браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="4600986251755456192"><ph name="SHORTCUT" /> арқылы Phromium профильдерін ауыстыруға болады.</translation>
<translation id="8118189978246431067">Барлық Phromium терезелерін жауып, әрекетті қайталап көріңіз.</translation>
<translation id="7430418346833889620">Терезені бөлісу үшін жүйе параметрлерінде Phromium-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="2943929290955142701"><ph name="EXISTING_USER" /> әлдеқашан кірді.  Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз.</translation>
<translation id="5896697187441340113">Phromium браузерін мобильдік құрылғыларға жүктеп алуға арналған QR коды</translation>
<translation id="354621070532799440">Еске салғыш: Google-дың ең үздік қауіпсіздік функциялары қалтаңызда болады</translation>
<translation id="6718500626359284607">Экранды бөлісу үшін жүйе параметрлерінде Phromium-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="6511372913460632136">Күшейтілген қорғаныс Phromium танымайтын сайттар үшін JavaScript оңтайландыру мүмкіндігін өшіреді.</translation>
<translation id="3597003331831379823">Реттеуді кеңейтілген құқықтармен бастау мүмкін болмады. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Phromium аккаунтына кіріңіз</translation>
<translation id="8702816719621016911">Бұл пайдаланушының браузерді пайдалану деректері құрылғыдан жойылады. Деректерді қалпына келтіру үшін Phromium браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{Phromium браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады.}=1{Phromium браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады. Инкогнито терезесі қайта ашылмайды.}other{Phromium браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="3667616615096815454">Орнату мүмкін болмады, себебі сервер қолданбаны анықтай алмады.</translation>
<translation id="678730369472836428">Google аккаунтындағы барлық Phromium дерегін шифрлау үшін <ph name="BEGIN_LINK" />жеке құпия фразаны<ph name="END_LINK" /> пайдаланыңыз. Google Pay қызметіндегі төлеу әдістері мен мекенжайлары шифрланбайды. Phromium-нің браузерді қолдану тарихы синхрондалмайды.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{Жаңартылған нұсқасын қолдану үшін әкімші Phromium-ді қайта іске қосуыңызды сұрайды.}=1{Жаңартылған нұсқасын қолдану үшін әкімші Phromium-ді қайта іске қосуыңызды сұрайды. Инкогнито терезесі қайта ашылмайды.}other{Жаңартылған нұсқасын қолдану үшін әкімші Phromium-ді қайта іске қосуыңызды сұрайды. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="2203303261468330007">Сілтемені жаңа Phromium қойындысында ашу</translation>
<translation id="686463893976008238">Жекелендіру және басқа мақсаттарды орындау үшін Phromium мен басқа Google қызметтерін байланыстырыңыз.</translation>
<translation id="3729187154190517324">"Қойынды және т.б. қосу" түймесін басып, бірнеше қойынды, файл және құрал қосып, жан-жақты іздеңіз.</translation>
<translation id="5596264049590907430">Phromium профильдерін басқару</translation>
<translation id="5594723037153142396">Неліктен Phromium кейбір жүктеп алынғандарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="3425307214497790458">Тексеруге қажетті нәрсе болса, Phromium сізге хабар береді</translation>
<translation id="4247980944121268675">Phromium сіз кіруіңіз мүмкін беттерді алдын ала жүктейді, сонда оларға кірген кезіңізде, тезірек жүктеледі.</translation>
<translation id="3810973564298564668">Басқару</translation>
<translation id="1058395779823101457">Сақталған құпия сөздерді пайдалану үшін QR кодын қолданып, iOS-ке арналған Phromium браузерін жүктеп алып, Google аккаунтына кіріңіз.</translation>
<translation id="3846683726093018685">**Қысқаша мазмұндау:** скриншоттағы контенттің негізгі тақырыбы мен мақсатын 30 сөзден аспайтын бір сөйлеммен сипатта.

          **Сұрақтар ұсыну:** пайдаланушының скриншотты жете түсінуіне көмектесетін, ой тудыратын 3–5 сұрақтан тұратын таңбаланған тізім жаса. Бұл сұрақтардың кемінде біреуі нақты визуалдық нысан, оның дизайны немесе орналасуы туралы болуы керек.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> – Phromium</translation>
<translation id="430953676539987275">Барлық құрылғыдан бетбелгілер мен басқа ақпаратты алу үшін Phromium-ге кіріңіз.</translation>
<translation id="3885770153807205175">Тіл таңдағыш</translation>
<translation id="5947409614720749543">Phromium-ді реттеу және басқару. Назар аударуыңыз қажет. Толығырақ ақпарат алу үшін басыңыз.</translation>
<translation id="2176348074240183776">Phromium ашу үшін атыңызды басып, шарлауды бастаңыз.</translation>
<translation id="3892148308691398805">Мәтінді көшіру</translation>
<translation id="3679766722656346339"><ph name="EXISTING_USER" /> бұл Phromium профиліне кіріп қойған. Браузерді пайдалану деректерін бөлек сақтау үшін Phromium сізге жеке профиль жасай алады.</translation>
<translation id="6085953975934135790">Бұл кеңейтім Chrome Web Store саясатына қайшы, сондықтан қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Phromium-нан жойыңыз.</translation>
<translation id="3941890832296813527">Орнату қатесі: орнату файлының атауы жарамсыз немесе оған қолдау көрсетілмейді.</translation>
<translation id="608187946760434925">Phromium құпия сөздерді көшіргісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="3054592240125889472">Барлық құрылғыдан сақталған ақпарат пен басқа деректерді алу үшін Phromium-ге кіріңіз.</translation>
<translation id="3140795250676341027">Google аккаунтыңызға сақтаған құпия сөздер, төлеу әдістері және мекенжайлар осы құрылғыдан өшіріледі. Оларды Phromium-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="395904275706073188">Қорғалған беттерді оқу мүмкін емес. Басқа бетті байқап көріңіз.</translation>
<translation id="4227910144250222665">Phromium сізді қалай қорғайтыны туралы ақпарат алыңыз</translation>
<translation id="3967822245660637423">Жүктеп алынды</translation>
<translation id="4150430234581811723">Мекенжай жолағына немесе іздеу өрісіне терген кезіңізде, Phromium ұсыныстар алу үшін терген нәрсеңізді ұйымның іздеу жүйесіне, жасанды интеллектіге және агент құралдарына жібереді.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing туралы</translation>
<translation id="3997429360543082038">ChromiumOS туралы</translation>
<translation id="4847805566397342820">Сайтқа кірген кезіңізде, Phromium браузері URL мекенжайының обфускация жасалған бөлігін IP мекенжайыңызды жасыратын құпиялық сервері арқылы <ph name="BEGIN_LINK" />Google Safe Browsing-ге<ph name="END_LINK" /> жібереді. Сайтта күдікті әрекеттер орындалса, толық URL мекенжайлары және беттегі контент бөліктері де жіберіледі.</translation>
<translation id="4016217212818346953">Password Manager-мен қауіпсіздікті сақтаңыз</translation>
<translation id="4019629340646866719">ChromiumOS жүйесі де <ph name="BEGIN_LINK_LINUX_OSS" />Linux әзірлеу ортасы<ph name="END_LINK_LINUX_OSS" /> сияқты <ph name="BEGIN_LINK_CROS_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="4022972681110646219">Экран мазмұнын аудару</translation>
<translation id="4023601594785368013">Түпнұсқа тілі: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">Кез келген қолданба сілтемесін Phromium-нен ашыңыз. Оңай қол жеткізу үшін ол тапсырмалар жолағына бекітіледі.</translation>
<translation id="6916567874038032700"><ph name="BEGIN_LINK" />Ағымдағы параметрлерді<ph name="END_LINK" /> хабарлау арқылы Phromium браузерін жақсартуға көмектесіңіз</translation>
<translation id="4050175100176540509">Соңғы нұсқасында қауіпсіздік жақсартылып, жаңа мүмкіндіктер берілген.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{Phromium 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}other{Phromium # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}}</translation>
<translation id="2498876341137940584">Phromium-нің инкогнито режимі</translation>
<translation id="1371775705240141332">"Phromium туралы ақпарат" бетіне өту</translation>
<translation id="1983555117242858621">Браузеріңізге жаңа көрініс беру үшін Phromium-ді бейімдеңіз</translation>
<translation id="3730928612696305544">Phromium браузеріңізді бейімдеңіз</translation>
<translation id="4148957013307229264">Орнатылуда…</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> –Желіге кіру – Phromium</translation>
<translation id="8940475598678719246"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Оқу тізімі мен басқа деректер барлық құрылғыда қолжетімді болады.</translation>
<translation id="3361801572720154185">Phromium үшін тамаша қолданбалар, ойындар мен тақырыптарды таба аласыз.</translation>
<translation id="5104340040322658377">Осы кеңейтімді және тағы басқасын компьютерлеріңізге орнату үшін Phromium аккаунтына кіріңіз.</translation>
<translation id="6533832886058295845">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін <ph name="USER_EMAIL_ADDRESS" /> ретінде кірген Phromium профиліңізге ауысыңыз.</translation>
<translation id="4222932583846282852">Бас тартылуда…</translation>
<translation id="4224210481850767180">Орнату тоқтатылды.</translation>
<translation id="6904238369362879351">Phromium дерегіңізді осы аккаунтпен байланыстырасыз ба?</translation>
<translation id="357744319784654404">Стандартты қорғанысқа қарағанда сайттардағы көбірек деректерді талдау арқылы қауіпті сайттар, тіпті Google-ға бұрын белгісіз болған сайттар туралы ескертеді. Phromium ескертулерін өткізіп жіберуді таңдауға болады.</translation>
<translation id="7228779501660520489">Phromium-нен шығу</translation>
<translation id="2782053121162821">Phromium жөнінде анықтама алу</translation>
<translation id="4281844954008187215">Қызмет көрсету шарттары</translation>
<translation id="5084022108026911204">Орнату анықталмаған қате себебінен сәтсіз аяқталды. Ағымда Phromium жұмыс істеп тұрса, оны жауып, әрекетті қайталаңыз.</translation>
<translation id="5139026954638666406">Құпия сөздерді Phromium-нен экспорттау</translation>
<translation id="4304713468139749426">Құпия сөздер реттегіші</translation>
<translation id="4334241893986177674">Осы скриншотты іздеу</translation>
<translation id="8324735155671556570">Windows жұмысын бастағанда, Phromium-ді іске қосады</translation>
<translation id="4400772909124543403">Ешқандай жаңарту жоқ.</translation>
<translation id="2185735215611818026">Phromium браузерінен бәрібір шығасыз ба?</translation>
<translation id="4413205837991854510">"Сурет іздеу" жылдам пәрменін үнемі көрсету</translation>
<translation id="1338297030721125711">Phromium браузеріне фондық режимде жұмыс істеуге рұқсат беру</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{Phromium оны өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" />}other{Phromium оларды өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" />}}</translation>
<translation id="1011403527148313450">Phromium реттеу және басқару</translation>
<translation id="4427306783828095590">Жақсартылған қорғаныс фишинг пен зиянды бағдарламаларды бөгеуде көбірек істейді.</translation>
<translation id="4434353761996769206">Орнату құралының қатесі: <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415">Phromium-ді <ph name="MANAGER" /> басқарады</translation>
<translation id="2477616462388290618">Phromium профилін қосу</translation>
<translation id="4447409407328223819">Chrome for Testing туралы</translation>
<translation id="972523218852576493">Google аккаунтыңызда Phromium деректерін пайдалану және сақтау үшін құпия фразаңызды енгізіңіз.</translation>
<translation id="4493028449971051158">Іске қосу қатесі: орнату құралын әкімші ретінде іске қосыңыз.</translation>
<translation id="4501471624619070934">Орнату мүмкін болмады, себебі бұл елде кіруге шектеу қойылған.</translation>
<translation id="8839763675940122379">Бұл кеңейтім пайдаланушы деректерін қалай жинап, қолданатыны сияқты құпиялық шараларын жарияламаған. Phromium оны өшіруге кеңес береді.</translation>
<translation id="2339640488105852505">Phromium браузеріне қош келдіңіз! Жаңа браузер терезесі ашылды.</translation>
<translation id="8536959233160434213">Phromium-ге айналаңызды картаға түсіруге және қолыңызды бақылауға рұқсат қажет.</translation>
<translation id="1077734277628859167">Басқа Phromium профилінде әлдеқашан <ph name="USER_EMAIL_ADDRESS" /> ретінде кіргенсіз.</translation>
<translation id="5512897665247593318">Phromium беттерді алдын ала жүктейді, осылайша браузерді пайдалану және іздеу әрекеті тез жүреді. <ph name="BEGIN_LINK" />Беттерді алдын ала жүктеу туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Зиянды деп ойлаған сайт туралы шағымданғанда, онлайн қауіпсіздікті барлық пайдаланушы үшін жақсартыңыз.</translation>
<translation id="6624033199018630177">Phromium жүктеп алуды блоктады, себебі Safe Browsing функциясы өшірілді және файлды растау мүмкін емес.</translation>
<translation id="3039804643080655517">Телефоныңыздағы Phromium-мен Google Lens-ді пайдаланып көріңіз</translation>
<translation id="4594305310729380060">Осы құрылғыдағы Құпия сөз менеджеріне</translation>
<translation id="8064263528617889755">Phromium қолданбалары</translation>
<translation id="4598116752460667024">Тізімнен кез келген процесті іздейді.</translation>
<translation id="4613863813562375431">ChromiumOS нұсқасы</translation>
<translation id="7245201002247176127">Сәл қалды! Жаңартуды аяқтау үшін Phromium жүйесін қайта іске қосыңыз.</translation>
<translation id="8846891938874485868">Phromium-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Phromium-нің шабуылдарға төзімділігі сәл азаяды.</translation>
<translation id="7525500996671436081">Phromium-мен іздеу функциясын ашу</translation>
<translation id="1224842000407297331">Phromium профилі</translation>
<translation id="4956303519269880412">Ескерту: Phromium кеңейтімдердің браузерді қолдану тарихын жазуына кедергі бола алмайды. Бұл кеңейтімді Инкогнито режимінде өшіру үшін бұл опцияның белгісін алып тастаңыз.</translation>
<translation id="2708255035805733225">Phromium пайдалану есептерін де бөліссеңіз, бұл есептерде сіз кірген URL мекенжайлары қамтылады.</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" /> (мүше) ретінде кірдіңіз. Аккаунт мәзірін ашу</translation>
<translation id="1883292567514549610">Профиль басқа Phromium процесімен (<ph name="PROCESS_ID" />) басқа компьютерде (<ph name="HOST_NAME" />) пайдаланылып жатыр. Бүлінбеуі үшін Phromium профильді құлыптап қойды. Басқа процестер бұл профильді пайдаланып жатпаса, профильді құлыптан ашып, Phromium қайта іске қосуыңызға болады.</translation>
<translation id="4680828127924988555">Орнатудан бас тарту</translation>
<translation id="1889305042180577023">Phromium деректерінің кейбірі Google аккаунтыңызға әлі сақталмаған. Шығу алдында бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="8079525505870459051">Аккаунтқа кірсеңіз, Phromium-нен Google аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. <ph name="SHORTCUT" /> тіркесімі арқылы Google қызметтерінің параметрлерін өзгертуге болады.</translation>
<translation id="2171507067211697961">Бұрын әлдекім осы компьютерден Phromium браузеріне <ph name="ACCOUNT_EMAIL_LAST" /> болып кірген. Ақпаратты бөлек ұстау үшін жаңа Phromium пайдаланушысын жасаңыз.</translation>
<translation id="4724676981607797757">Орнатылмады, себебі қолдау көрсетілмейтін протокол қатесі пайда болды.</translation>
<translation id="6925701206088903005">Phromium браузерінен бәрібір шығасыз ба?</translation>
<translation id="4514755609496543621">Phromium браузеріне қазір ғана қауіпсіздік бойынша арнайы жаңартылған нұсқа қолданылды. Оны қазір қайта ашсаңыз, қойындылар қалпына келтіріледі.</translation>
<translation id="8673673368917636496">Жақында кірмедіңіз. Phromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> рұқсаттарын және тағы <ph name="COUNT" /> рұқсатты өшірді.</translation>
<translation id="3638319732826965647">Phromium-дегі Gemini ашық болса, жаңа қойындылар жасаған кезде, бүйірлік панель ашық қалады.</translation>
<translation id="479167709087336770">Google Search қызметіндегі емле тексеру құралы пайдаланылады. Браузерде терілген мәтін Google-ға жіберіледі. Мұны параметрлерде өзгертуіңізге болады.</translation>
<translation id="2659245507243672392">Phromium-ді аккаунтсыз қолдану</translation>
<translation id="166411027652942990">mDNS трафигіне рұқсат беретін Phromium кіріс ережесі.</translation>
<translation id="6031862420354068813">&amp;Phromium-ді жаңарту үшін қайта іске қосу</translation>
<translation id="4918086044614829423">Қабылдау</translation>
<translation id="4918844574251943176">Сурет көшірілді.</translation>
<translation id="1531905832227009774">Барлық құрылғыдан оқу тізімі мен басқа ақпаратты алу үшін Phromium-ға кіріңіз.</translation>
<translation id="4319892378006430019">Phromium фондық режимде.</translation>
<translation id="8972359100025490790">Phromium-ге кірудің диалогтік терезесін жабу үшін басыңыз.</translation>
<translation id="3639078149590125530">Phromium профильдері арқылы Phromium-дегі барлық материалыңызды бөле аласыз. Достар мен отбасыңызға арналған немесе жұмысқа не көңіл көтеруге бөлек профильдер жасаңыз.</translation>
<translation id="7141327976224964788">Қонақтар Phromium қолданбасын ешқандай дерек қалдырмай пайдалана алады.</translation>
<translation id="7007327521155149139">Phromium-дегі аккаунтыңыз</translation>
<translation id="5973804420920585431">Phromium жүйесіне өзіңізді қосу</translation>
<translation id="504699503110800016">Қосымша мәзірді ашу</translation>
<translation id="2497925691306722252"><ph name="DEVICE_TYPE" /> құрылғысындағы Phromium-мен Google-дың барлық таңдаулы қызметін пайдаланыңыз.</translation>
<translation id="8678196879882043620">Phromium қолыңызды бақылауға рұқсат сұрайды.</translation>
<translation id="3397880081430454820">Жақында кірмедіңіз. Phromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> рұқсаттарын өшірді.</translation>
<translation id="9114243566897924763">Phromium-ге кіріңіз</translation>
<translation id="5174969993834422967">Әдетте хабарландыруларға тыйым саласыз. Бұл сайт сізге хабарландыру жіберсін десеңіз, локация жолағының оң жақ бұрышындағы хабарландыру белгішесін басыңыз.</translation>
<translation id="5174983315706567306">Диск жады жеткіліксіз.</translation>
<translation id="7698884672439844280">Phromium аккаунтын қайта аутентификациялау қажет.</translation>
<translation id="5629965056131882780">iOS-тегі Phromium-де тоқтаған жеріңізден жалғастырыңыз.</translation>
<translation id="874294566462998787">Phromium жүйесінен шығу</translation>
<translation id="5234764350956374838">Жабу</translation>
<translation id="8605581794204249702">Сілтемені Phromium инкогнито терезесінде ашу</translation>
<translation id="8722804301463582643">Құпия сөздерді кез келген жерде сақтау үшін Phromium қолданбасын жүктеп алыңыз</translation>
<translation id="6253936671561887082">Өзгерістер енуі үшін, Phromium браузерін қайта қосыңыз</translation>
<translation id="7405713141437293142">Бұл қойындыны басқа құрылғыға жіберу үшін екі құрылғыда да Phromium-ге кіріңіз.</translation>
<translation id="5286907366254680517">Анықталды</translation>
<translation id="2224284460884535818">Phromium қолданбасын жүктеп алу</translation>
<translation id="1426207087952749578">Инкогнито режимін пайдаланған кезде, Phromium сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="8108751453879231987">Phromium-мен іздеу</translation>
<translation id="7780358745459835678">"Phromium-ді жаңарту құралы" ішкі қызметі</translation>
<translation id="6956753580765202069">Оларды Phromium-дегі басқа Gemini функцияларымен бірге пайдаланыңыз.</translation>
<translation id="5346389065299425353">Бірнеше қойынды, файл және құрал қосып, жан-жақты іздеңіз.</translation>
<translation id="8684266995248242891">Phromium-дегі Gemini көмегімен осы құжаттың қысқаша мазмұнын біліп, сұрақтар қойыңыз.</translation>
<translation id="586104673506947714">Phromium тексеруге қажетті қауіпсіздікке қатысты кейбір ұсыныстарды тапты</translation>
<translation id="4657908558997566735">Басқа Phromium профильдері</translation>
<translation id="6097378010983112326">ChromiumOS жүйесі Phromium деректерін Google аккаунтыңызға сақтай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="385020720581757591">Бақыланатын аккаунт арқылы кірдіңіз және оның әкімшілік бөлігін Phromium профилі арқылы басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты Phromium деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME" /> пайдаланушысына байланыстырылады. Бұл деректерді Google аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Қосымша код: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">Жекелендіру үшін Phromium-ді интернет пен қолданбаларды пайдалану тарихына қосыңыз.</translation>
<translation id="2756028035855809142">Phromium-мен іздеу функциясын ашу</translation>
<translation id="4375021373215585423">Неліктен Phromium кейбір файлдарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="4688227912949761884">Phromium жаңартылуда (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Кеңейтімдер мен басқа деректер барлық құрылғыда қолжетімді болады.</translation>
<translation id="4945147853702701048">Phromium браузеріне кіруге рұқсат ету</translation>
<translation id="7813879193794658604">Phromium-нен жою</translation>
<translation id="2908302339618007937">Өнімділік азаяды, бірақ Phromium шабуылдарға төзімді болады.</translation>
<translation id="8760365573983490520">Әдепкі браузер ретінде Phromium қолданбасын орнату</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> - Phromium бета нұсқасы</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{Phromium браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{Phromium браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="975923236500175446">Phromium дұрыс жұмыс істемеуі мүмкін, себебі оған Linux жүйесінде қолдау көрсетілмейді.</translation>
<translation id="7595270580374414215">Phromium бұл файлды жүктеп алуға тыйым салды, себебі ол жеке және әлеуметтік желі аккаунттарыңызға қауіп төндіруі мүмкін</translation>
<translation id="5644162187312430027">Phromium ең соңғы жүйе жаңартуларын орнатуда, күте тұрыңыз.</translation>
<translation id="2476033563817685908">Phromium құпия сөздерді өзгерткісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="1626952238284562558">Phromium-мен жол-жөнекей Google Drive және YouTube сияқты сүйікті қолданбаларыңызды кедергісіз пайдаланыңыз.</translation>
<translation id="5524890928877629608">іздеу аймағының жоғарғы сол жақ бұрышы: сол жақ <ph name="LEFT" />%, жоғарғы жақ <ph name="TOP" />%</translation>
<translation id="2860766395826060492">PDF-терді Phromium-де ашу</translation>
<translation id="5536164441519929134">Осы қойынды туралы<ph name="LINE_BREAK" />сұраңыз</translation>
<translation id="3915500272078806319">Сайтқа бірінші рет кірген кезіңізде, Phromium браузері қауіпсіздік үшін JavaScript оңтайландыру әдісін өшіреді.

Бұл бет ойдағыдай істемесе, оңтайландыруға рұқсат беріп көріңіз.</translation>
<translation id="6778733300408894918">Phromium-дегі Gemini-ды Mac мәзір жолағында көрсету және пернелер тіркесімін қосу</translation>
<translation id="8411908790152555435"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Сақталған ақпарат пен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="5579324208890605088">Іске қосу қатесі: орнату құралын әкімші емес, кәдімгі пайдаланушы ретінде іске қосыңыз.</translation>
<translation id="6578510724610627339">Phromium-ді әдепкісінше пайдалану және бекіту</translation>
<translation id="5596627076506792578">Қосымша опциялар</translation>
<translation id="5605834417512968703">"Сурет іздеу" функциясы арқылы іздеу керек кез келген нәрсені таңдаңыз немесе бұл функциядан шығу үшін Escape пернесін басыңыз.</translation>
<translation id="5618818588972826921">"Сурет іздеу" функциясымен іздеу керек кез келген мәтінді не суретті таңдаңыз немесе "Сурет іздеу" функциясынан шығу үшін Escape пернесін басыңыз.</translation>
<translation id="4431270188253419020">{0,plural, =0{Phromium браузерінің жаңартылған нұсқасы қолжетімді}=1{Phromium браузерінің жаңартылған нұсқасы қолжетімді}other{Phromium браузерінің жаңартылған нұсқасы # күннен бері қолжетімді}}</translation>
<translation id="6903143702905157196">Phromium браузерін жапқан кезде құрылғыңыздан сайт деректерін үнемі жою</translation>
<translation id="5354366475527026551">Phromium браузерін қайта іске қосыңыз</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">Phromium жүйесін осы тілде көрсету</translation>
<translation id="569897634095159764">Интернетке қосылу мүмкін емес. Прокси-сервер үшін аутентификация қажет.</translation>
<translation id="5724138350057003647">Phromium әрекетсіз қойындылардағы жадты босатады. Мұның нәтижесінде белсенді қойындылар мен басқа қолданбаларға қосымша компьютер ресурстары үлестіріліп, Phromium жылдам жұмыс істейді. Әрекетсіз қойындыларды ашқанда, олар автоматты түрде қайтадан белсенді болады. <ph name="BEGIN_LINK" />Жад үнемдегіш туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="3730992449058237228">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, аккаунтыңыздағы Phromium деректерін <ph name="SETTINGS_LINK" />.</translation>
<translation id="1983042639279920602">Phromium-ді бейімдеңіз және басқарыңыз. Phromium-ді әдепкі браузер етіп орнатыңыз.</translation>
<translation id="7136978005010973283">Phromium-ді әдепкі браузер етіп орнату арқылы құпия сөздеріңізді, бетбелгілеріңізді және тарихыңызды құрылғыларда синхрондаңыз.</translation>
<translation id="5809516625706423866">Интернетке қосылу мүмкін емес. HTTP 401 бойынша рұқсат берілмейді. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="3059302031765226748">Phromium-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Phromium-нің шабуылдарға төзімділігі сәл азаяды. Бұл параметр өшірулі.</translation>
<translation id="4904710047654714935">Google аккаунтындағы Phromium деректерін пайдалану және сақтау үшін Phromium-ді жаңартыңыз.</translation>
<translation id="5824893331272123205">Бұл панельді жүктеу мүмкін болмады. Әрекетті қайталаңыз</translation>
<translation id="2582896742857095190">Phromium жүйесіне қош келдіңіз</translation>
<translation id="5004643502851105876">Phromium-де ең күшті қорғау мүмкіндігін қамтамасыз ету үшін қосымша функцияларды қосады.</translation>
<translation id="5871205389137001634">"Сурет іздеу" функциясынан шығу үшін басыңыз.</translation>
<translation id="7409018434452575206">Phromium бұл элементтерде зиянды бағдарлама бар екенін анықтады:</translation>
<translation id="3191822983646594827">Браузеріңізде ең қауіпсіз параметрлер бар екеніне көз жеткізу үшін Phromium жүйелі түрде тексереді. Пікіріңіз керек болса, сізге хабар жібереміз.</translation>
<translation id="5895138241574237353">Қайта іске қосу</translation>
<translation id="625373791981566594">Phromium-дегі Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Желіге кіру</translation>
<translation id="5924017743176219022">Интернетке қосылып жатыр…</translation>
<translation id="5941711191222866238">Жию</translation>
<translation id="8650638130234822147">Осы бетбелгі және басқа да көптеген нәрселер барлық құрылғыңызда болуы үшін, Phromium-ға кіріңіз.</translation>
<translation id="5010592102321399468">Phromium-ді өзіңізге сай бейімдеңіз</translation>
<translation id="5960071705175224773">Параметрлеріңізді белгісіз қолданба өзгертті</translation>
<translation id="5977420883993828287">Бекітілді! Контекстік тапсырмаларды құралдар тақтасынан қайта пайдаланыңыз.</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{Phromium 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}other{Phromium # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}}</translation>
<translation id="3160371268592376569">Phromium браузерін жаңартып, синхрондауды бастаңыз</translation>
<translation id="5990360079535151574">Шолу кезінде сұрақ қою үшін құралдар тақтасындағы "Контекстік тапсырмалар" түймесін басып, контекстік тапсырмаларды қайта ашуға болады.</translation>
<translation id="6003112304606738118">Жүктеп алынып жатыр… <ph name="HOURS" /> сағат қалды.</translation>
<translation id="6009821354356307391">Қосымша сұрақ қойыңыз</translation>
<translation id="6040143037577758943">Жабу</translation>
<translation id="5783572280281297164"><ph name="DEVICE_TYPE" /> құрылғысында Phromium пайдаланып, онлайн сатып алудан барынша пайда көріңіз</translation>
<translation id="2712461133060419287">Деректеріңізді қорғау үшін Phromium-ге сіз соңғы уақытта кірмеген сайттар рұқсаттарын өшіруге рұқсат беріңіз. Хабарландырулар көрсетіле береді.</translation>
<translation id="7845842385196710435">&amp;Phromium жүйесінде ашу</translation>
<translation id="6069027071882229820">Сурет түрінде көшіру</translation>
<translation id="3752072756936611600"><ph name="EXTENSION_NAME" /> кеңейтімі Phromium браузеріне енгізілді</translation>
<translation id="2775066550187002528">Phromium браузерін реттеңіз және басқарыңыз. Жаңартылған нұсқа қолжетімді.</translation>
<translation id="6531352038528110565">Қосулы • Phromium бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="2876078296400914679">Phromium-дегі аккаунтыңыз</translation>
<translation id="3881538460441135554">Кеңейтімге Phromium құралдар тақтасында сайтқа кіру сұрауларын көрсетуге рұқсат беру</translation>
<translation id="7479187736743594081"><ph name="FILE_NAME" /> қауіпті болғандықтан, Phromium оны бөгеді.</translation>
<translation id="6646104775883837119">Phromium жақын арада жабылып, деректерді жояды</translation>
<translation id="6138634751748297112">Осы жерде Phromium профильдерін ауыстыра аласыз.</translation>
<translation id="8660563290103481109">Егер cookie файлдарына рұқсат берсеңіз, Phromium оларды алдын ала жүктеу кезінде пайдалануы мүмкін.</translation>
<translation id="6165508094623778733">Толық ақпарат</translation>
<translation id="969667123257916656">Аккаунттағы Phromium деректерін тазалау</translation>
<translation id="5528040738212560214">Бұл файл қауіпті болуы мүмкін.<ph name="LINE_BREAK" />Құпия сөзді көрсетсеңіз, Phromium бұл жүктеп алу әрекетін тексере алады. Файл туралы ақпарат Google Safe Browsing қызметіне жіберіледі, бірақ файл контенті мен құпия сөз құрылғыңызда қалады.</translation>
<translation id="6182736845697986886">Орнатылмады, себебі жаңарту серверінде ішкі қате пайда болды.</translation>
<translation id="6041381825442292659"><ph name="TARGET_DEVICE_NAME" /> құрылғысындағы Phromium браузеріне кіргеніңізді тексеріп, қайта жіберіп көріңіз.</translation>
<translation id="2474943719592372017">Phromium кішірейтілсе де, кез келген жерден іздеңіз және сұрақ қойыңыз. Phromium-нің фондық режимде істеуіне мүмкіндік береді.</translation>
<translation id="2518372260387069450">Бұл компьютерде жаңа Phromium нұсқасы бұрыннан бар. Бағдарламалық жасақтама жұмыс істемесе, Phromium жойып, әрекетті қайталап көріңіз.</translation>
<translation id="3832895416321159809">{0,plural, =0{Phromium браузері қазір қайта іске қосылады}=1{Phromium браузері 1 секундтан кейін қайта іске қосылады}other{Phromium браузері # секундтан кейін қайта іске қосылады}}</translation>
<translation id="2775110773501098464">Phromium файлдарды жүктеп алу үшін жадты пайдалануға рұқсат сұрайды.</translation>
<translation id="3505491405575013121">URL мекенжайларын Phromium браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді.</translation>
<translation id="2276249127856880228">Әдепкі браузер ретінде Phromium орнату</translation>
<translation id="6248988683584659830">Іздеу параметрлері</translation>
<translation id="554637698797403739">Телефондағы Phromium-мен Google-дың үздік қауіпсіздік функцияларын жол-жөнекей пайдаланыңыз</translation>
<translation id="7016155178198587734">Phromium жүйесінен шығасыз ба?</translation>
<translation id="5660287988409470276">Бұл қойындылар тым көп ресурстар қолданып жатыр. Өнімділікті жақсарту үшін Phromium-ге оларды әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="8429776045186716992">Phromium профилін реттеу</translation>
<translation id="3310436202618971091">Phromium профиліне ат қойыңыз</translation>
<translation id="1478750151648434251">Кеңейтімді қолдану үшін Phromium-ге кіруіңіз керек</translation>
<translation id="9139712828910812615"><ph name="FILE_NAME" /> қауіпті болуы мүмкін болғандықтан, Phromium оны бөгеді.</translation>
<translation id="5191618263102115907">Phromium камераңызды пайдалануда.</translation>
<translation id="8247508943089477519">Phromium браузерінде басқа операция орындалуда. Әрекетті кейінірек қайталаңыз.</translation>
<translation id="8271488218611798813">Енді Phromium қолданбасын Google аккаунтымен және ортақ компьютерлерде пайдалану жеңілірек.</translation>
<translation id="446228390478495078">Phromium-ді әдепкі браузер етіп орнату арқылы өзіңіз білетін, ұнататын және сенетін функцияларды оңай пайдаланыңыз.</translation>
<translation id="2203435422524224690">Phromium пернелер тіркесімі</translation>
<translation id="3977517784144885449">Phromium жүктеп алуды блоктады, себебі бұл файл әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="8088471547690853921">Phromium жою қажет пе?</translation>
<translation id="6375219077595103062">Password Manager таңбашасын қосу</translation>
<translation id="6388799252195623474">осы бетке қатысты көмек қажет</translation>
<translation id="1774421040071124552">Жалғастыру үшін Phromium-ге <ph name="EMAIL" /> аккаунтымен кіріңіз. Осылайша ұйым саясаттары сақталады.</translation>
<translation id="2343430845154053061">Компьютер экранындағы Phromium логотипі.</translation>
<translation id="2724924185145648602">Phromium — веб-беттер мен қолданбаларды өте жылдам ашатын веб-браузер. Ол жылдам, тұрақты және пайдалануға оңай. Phromium жүйесіне ендірілген зиянды бағдарлама және фишинг қорғанысымен интернетті уайымсыз пайдалана беруіңізге болады.</translation>
<translation id="7417453886359805803">Google аккаунтыңызда Phromium деректерін үнемі пайдалану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="3304683228794166031">Phromium жылдам істейді. JavaScript қолданатын функциялар тиісті түрде істеуі керек.</translation>
<translation id="6436260184216827876">"Сурет іздеу" функциясы істемейді. Кейінірек қайталап көріңіз.</translation>
<translation id="6442900851116057561">ChromiumOS жүйесін өшіріп қосу</translation>
<translation id="9164801375934097818">Phromium сіз кіруіңіз мүмкін көбірек бетті алдын ала жүктейді, сонда оларға кірген кезіңізде, тезірек жүктеледі.</translation>
<translation id="2577121659922309103">Бағаларды бақылау және кез келген сайтта баға түскен кезде, хабарландырулар алу үшін телефоныңызға Phromium-ді жүктеп алыңыз.</translation>
<translation id="2052328618318278030">Өшірулі • Phromium бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="3122296739697671126">Phromium профильдеріне қош келдіңіз!</translation>
<translation id="3472445024540245926">Келесі жолы Phromium-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, қойындылар топтарын пайдалану туралы нұсқауды көресіз.</translation>
<translation id="2144084801479939969">Аккаунтты Phromium-нен өшіру</translation>
<translation id="2473490714352939152">Сонымен қатар Phromium іске қосылғанда қайсы бет көрсетілуін бақылайды.</translation>
<translation id="648319183876919572">Күшейтілген Safe Browsing-нің қауіпті веб-сайттар мен файлдардан қорғау қабілеті жоғарырақ.</translation>
<translation id="359777544552173333">Phromium жою</translation>
<translation id="3890462049854841354">Пернелер тіркесімдері Phromium-нен ашылады.</translation>
<translation id="6616579671682178785">Ұйымыңыз Phromium-ді <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жабады. Браузерді пайдалану деректері жойылды. Оларға тарих, автотолтыру мәліметтері және жүктеп алынғандар кіруі мүмкін.</translation>
<translation id="8662645370371079862">Әр профильде бетбелгілер, тарих, құпия сөздер және тағы басқа Phromium ақпараты бар.</translation>
<translation id="6556755379298048869">Пернелер тіркесімімен іздеңіз.</translation>
<translation id="7133640529688742768"><ph name="BEGIN_LINK" />Phromium-нің деректеріңізді құпия сақтау жолы<ph name="END_LINK" /> туралы толық ақпарат</translation>
<translation id="8316065704185291024">Бұл параметрге енгізілген өзгерістер Phromium өшіп қосылғаннан кейін күшіне енеді.</translation>
<translation id="2816396636285296289">Кеңейтімдерді реттеу үшін Phromium негізгі мәзіріндегі "Кеңейтімдер" түймесін басыңыз.</translation>
<translation id="8831144879019828189">Басқа Phromium профиліндегі құпия сөздерді көру үшін ауысуға болады</translation>
<translation id="7017911482442558099">Үздік ЖИ құралдарын жол-жөнекей алып жүру үшін Phromium пайдаланыңыз.</translation>
<translation id="5784574554904759369">Емле қателерін түзету үшін Phromium браузері мәтін жолына терілген сөздерді Google-ға жібереді</translation>
<translation id="8485501471305987872">Phromium хабарландыру параметрлері бөліміне өту</translation>
<translation id="6600016381025017075">Бұл беттен кез келген нәрсені іздеңіз.</translation>
<translation id="1462793186918694806">Өзгертулеріңіз Phromium келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="7501991510212476553">Windows жұмысын бастаған кезде, Phromium іске қосылады, сондықтан браузерді бірден пайдалануға болады. Оны параметрлерден өшіруге болады.</translation>
<translation id="7686308613268368175">Тоқтаған жерден жалғастырыңыз: Phromium соңғы сеанстағы қойындыларды қалпына келтірді. Мұны келесі бөлімде өшіруге болады:</translation>
<translation id="5266723901802366313">Phromium айналаңыздың 3D картасын жасау үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="7085315067428293799">Бетбелгілерді Google аккаунтыңызда да сақтасаңыз, Phromium-дe өнім бағаларын бақылап, баға төмендеген кезде, хабарландыру аласыз.</translation>
<translation id="6676384891291319759">Интернетке кіру</translation>
<translation id="668175097507315160">Кіру кезіндегі қате себебінен ChromiumOS деректеріңізді синхрондай алмады.</translation>
<translation id="5279767706090517695">Phromium-нен бұл қолданба деректерін өшіру</translation>
<translation id="6562226321659107531">Phromium бұл сайт үшін микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="6712881677154121168">Жүктеп алу қатесі: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">Профиліңізді пайдалану мүмкін емес, себебі ол жаңарақ Phromium нұсқасынан.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін. Басқа профиль каталогін көрсетіңіз немесе жаңарақ Phromium нұсқасын пайдаланыңыз.</translation>
<translation id="4914871493602315663">Жекелендіру мен басқа функцияларды алу үшін Phromium-ді интернет пен қолданбаларды пайдалану тарихы мен байланысқан Google қызметтеріне қосыңыз.</translation>
<translation id="5919390816124912606">Phromium компьютердегі барлық пайдаланушылар үшін әлдеқашан орнатылған.</translation>
<translation id="5867815953973052697">Бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін Phromium аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл бетбелгі Google аккаунтыңызға сақталады.</translation>
<translation id="7381168634819530324">Phromium-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Phromium-нің шабуылдарға төзімділігі сәл азаяды. Бұл параметр қосулы.</translation>
<translation id="1509688792864707851">{count,plural, =1{Phromium деректерінің кейбірі Google аккаунтыңызда әлі сақталмаған. Шықпай тұрып, бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{Phromium деректерінің кейбірі Google аккаунтыңызда әлі сақталмаған. Шықпай тұрып, бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="4702638565169602649">Phromium бұл файлды сканерлеуді ұсынады, себебі ол қауіпті болуы мүмкін.</translation>
<translation id="6779406956731413166">ChromiumOS қосымша <ph name="BEGIN_LINK_CROS_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="6831043979455480757">Аудару</translation>
<translation id="1564864902402454287">Құпия сөздеріңіз ұрланған жағдайда, Phromium бұл туралы хабарлайды.</translation>
<translation id="684888714667046800">Интернетке қосылу мүмкін емес. Брандмауэр пайдалансаңыз, <ph name="PRODUCT_EXE_NAME" /> өнімінің рұқсат тізімінде екеніне көз жеткізіңіз.</translation>
<translation id="6200419390448865091">Phromium – <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Жалғастыру үшін Tab пернесін басыңыз.</translation>
<translation id="6862030660799253820">Бұл суретті сурет іздеу функциясымен іздеу</translation>
<translation id="6869568587896659271">Мекенжай жолағының астындағы веб-сайттарға оңай кіріңіз.</translation>
<translation id="4011399428346318467">Phromium "<ph name="EXTENSION_NAME" />" кеңейтімінде зиянды бағдарлама бар екенін анықтады.</translation>
<translation id="6877155553248388166">іздеу аймағының төменгі оң жақ бұрышы: оң жақ <ph name="RIGHT" />%, төменгі жақ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Көшіру</translation>
<translation id="6898028264630240901">Шолған кезде сұрақ қою үшін контекстік тапсырмаларды бекітуге болады.</translation>
<translation id="1012681980425424211">Phromium-ді әдепкі браузер ретінде орнатып, тапсырмалар жолағына бекітіңіз.</translation>
<translation id="1744625657438211994">&amp;Phromium профильдерін басқару</translation>
<translation id="7264818828956697552">Бұл әрекет:
          <ph name="LINE_BREAKS" />
            • бастапқы бетті, жаңа қойынды бетін, іздеу жүйесін және бекітілген қойындыларды бастапқы күйге қайтарады;
            <ph name="LINE_BREAK" />
            • кеңейтімдерді өшіреді;
            <ph name="LINE_BREAK" />
            • cookie файлдарын және басқа уақытша сайт деректерін жояды;
            <ph name="LINE_BREAK" />
            • Phromium таңбашаларын бастапқы күйге қайтарады.
            <ph name="LINE_BREAKS" />
            Бетбелгілерге, тарихқа және сақталған құпия сөздерге ештеңе болмайды.</translation>
<translation id="6489000842445481390">Phromium-нің <ph name="BOOKMARK_LIMIT" /> бетбелгі шегіне жеттіңіз, сондықтан кейбір бетбелгілер Google аккаунтыңызға әлі сақталмады.

Кейбір бетбелгілерді жоймайынша, аккаунтыңызға жаңа бетбелгілерді сақтау мүмкін емес. Аккаунттан қазір шықсаңыз, сақталмаған бетбелгілер жойылады.</translation>
<translation id="2645108248038996858">Сілтемені Phromium инкогнито терезесінде ашу</translation>
<translation id="6965382102122355670">Жарайды</translation>
<translation id="6985329841647292029">ChromiumOS шарттары</translation>
<translation id="2947519843530032104">Phromium деректерін <ph name="ACCOUNT_EMAIL" /> аккаунтында қолдану және сақтау үшін құпия фразаны енгізіңіз.</translation>
<translation id="7011190694940573312">Орнатылмады, себебі операциялық жүйенің бұл нұсқасына қолдау көрсетілмейді.</translation>
<translation id="7024536598735240744">Пакеттен шығару қатесі: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">Phromium браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="7047386856539490735">Бұл нәтижелер пайдалы ма?</translation>
<translation id="2448910402556368916">Phromium жаңарту</translation>
<translation id="7834049737623892628">Егер суреттің пайдалы сипаттамасы болмаса, Phromium оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Google-ға жіберіледі.</translation>
<translation id="1803168627715642217">Phromium-ді <ph name="DEVICE_TYPE" /> құрылғысында пайдаланған кезде, ЖИ мүмкіндіктерін қолданыңыз</translation>
<translation id="3321731353906178474">Телефондағы Phromium-мен құпия сөздерді, қойындылар мен басқа деректерді жол-жөнекей пайдаланыңыз</translation>
<translation id="7141270731789036260">Chrome for Testing қызметін бейімдеу</translation>
<translation id="8077731669779275332">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, Phromium браузерін кез келген уақытта пайдалана аласыз.</translation>
<translation id="611798798247797100">Phromium-нен <ph name="EXTENSION_NAME" /> кеңейтімін жою</translation>
<translation id="7962394294883785044">Ұйымыңыз Phromium деректерін <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жояды. Оларға тарих, автотолтыру мәліметтері және жүктеп алынғандар кіруі мүмкін.</translation>
<translation id="2611686760870033712">Phromium бұл сайт үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="71050417052775020">Phromium браузері қосылмады. Қайталап көріңіз.</translation>
<translation id="4817060241763895497">Қай жерде болсаңыз да, Phromium-дегі Gemini-ға кез келген сұрақ қойыңыз</translation>
<translation id="869358700049263961">Phromium-ді кез келген уақытта жылдам ашу үшін бекітілген күйде қалдырыңыз</translation>
<translation id="7094488679340739251">Хабарларда, құжаттарда және басқа қолданбаларда сілтемелерді басып, Phromium браузерін кез келген уақытта пайдаланыңыз.</translation>
<translation id="7216228761061470870">Компьютерде сурет іздеу функциясын пайдалансаңыз, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге жіберіледі.</translation>
<translation id="7802634650401946711">Тапсырмалар реттегіші – Phromium</translation>
<translation id="5182547787327636348">Phromium-нен тыс контент, мысалы, басқа қолданбалар немесе файлдар туралы сұраңыз.</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Сақталған ақпарат пен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="5761733252154904648">Браузерден шолуды жылдам бастау: Windows жұмысын бастағанда, Phromium іске қосылады.</translation>
<translation id="7274695763216404502">Бекітілді! "Сурет іздеу" функциясын құралдар тақтасынан қайтадан пайдаланыңыз.</translation>
<translation id="7288567540154601580">Қойындылар мен кеңейтімдер</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{Phromium мұны өшіруге кеңес береді.}other{Phromium бұларды өшіруге кеңес береді.}}</translation>
<translation id="1408728332407453335">Жүйе дыбысын бөлісу үшін жүйе параметрлерін ашып, Phromium үшін "Тек жүйе дыбысын жазу" опциясына рұқсат беріңіз. Содан кейін Phromium-ді қайта іске қосуыңыз қажет.</translation>
<translation id="7299899569525778554">Компьютерден іздеу</translation>
<translation id="6194310460545162015">Phromium браузерін жаңарту</translation>
<translation id="1098154893096691883">Реттеулер файлы бұзылған немесе жарамсыз.

Phromium параметрлеріңізді қалпына келтіре алмайды.</translation>
<translation id="7324051657739063017">Шолу кезінде сұрақ қою үшін контекстік тапсырмаларды қайта ашуға болады.</translation>
<translation id="7024097830259741656">Мұнда веб-беттер, бетбелгілер және басқа Phromium материалдары тұрады.</translation>
<translation id="852511575759652041">Құпия фразасы бар адам ғана шифрланған деректеріңізді оқи алады. Құпия фраза Google компаниясына жіберілмейді немесе ол құпия фразаңызды сақтамайды. Құпия фразаны ұмытып қалсаңыз немесе осы параметрді өзгерту керек болса, <ph name="BEGIN_LINK" />аккаунттағы Phromium деректерін жою<ph name="END_LINK" /> қажет.</translation>
<translation id="2846900085504364505">Жүйе әкімшісі Phromium браузерін <ph name="TARGET_URL_HOSTNAME" /> бетіне кіргенде <ph name="ALTERNATIVE_BROWSER_NAME" /> браузері ашылатын етіп конфигурациялады.</translation>
<translation id="7352651011704765696">Бірнәрсе дұрыс емес</translation>
<translation id="7198690862684855451">Phromium-нің жаңа нұсқаларын алып тұру үшін macOS 13 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде macOS 12 нұсқасы орнатылған.</translation>
<translation id="3224607549103501149">Жақында кірмедіңіз. Phromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> рұқсаттарын өшірді.</translation>
<translation id="73786666777299047">Chrome Web Store қызметін ашу</translation>
<translation id="8446269872172461565">Phromium-дегі Gemini-ды жүйелік науада көрсету</translation>
<translation id="7401687852903179959">Бұл бейнені сурет іздеу функциясымен іздеу</translation>
<translation id="3403529853122418035">Phromium – енді сіздің әдепкі браузеріңіз.</translation>
<translation id="5649377421626481711">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, Phromium қойындыларды қалпына келтіреді. Мұны өшіру үшін келесі бөлімге өтіңіз:</translation>
<translation id="2467776530444676191">Құпия сөздерді Phromium-ге экспорттау</translation>
<translation id="8814480293815136510">1. Төмендегі <ph name="BUTTON_LABEL" /> түймесін басыңыз.
2. Windows параметрлерінде <ph name="BUTTON_2" /> түймесін басыңыз.
3. Phromium-ге жылдам кіру үшін, оны тапсырмалар жолағына бекітіңіз. Ол үшін Windows хабарландыруындағы <ph name="BUTTON_3" /> түймесін басыңыз.</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - Phromium әзірлеуші нұсқасы</translation>
<translation id="7450541714075000668">Мәтін көшірмесі жасалды</translation>
<translation id="6826407056979820031">Микрофонды пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Phromium-ге рұқсат беріңіз.</translation>
<translation id="1392131731909663319">Phromium-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 7 нұсқасы орнатылған.</translation>
<translation id="4512427777724578739">Phromium қайта іске қосылсын ба?</translation>
<translation id="4510527847350985067">Ашылып тұрғанмен бірдей Phromium нұсқасын орнату мүмкін емес. Phromium қолданбасын жауып, әрекетті қайталаңыз.</translation>
<translation id="7510190804000607802">Еске салғыш: Google-дың үздік мүмкіндіктері қалтаңызда болады</translation>
<translation id="4735608937705010375">Сайттар ойдағыдай жұмыс істеуі керек. Phromium-де аккаунтқа кірген болсаңыз, барлық Phromium терезесін жапқан кезде, Google аккаунтын қоспағанда, сайттардың көпшілігінен шығарыласыз.</translation>
<translation id="7987051132742764178">{0,plural, =1{Phromium браузері 1 минуттан кейін қайта іске қосылады}other{Phromium браузері # минуттан кейін қайта іске қосылады}}</translation>
<translation id="1904271152425995672">Деректеріңізді қорғау үшін Phromium-ге сіз соңғы уақытта кірмеген сайттардың рұқсаттарын өшіруге рұқсат беріңіз.</translation>
<translation id="7909976731673595773">Браузерді жылдам пайдалану үшін Phromium-ді автоматты түрде іске қосады.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> орнату құралы</translation>
<translation id="3301232962183130807">Phromium камераңыз бен микрофоныңызды пайдалануда.</translation>
<translation id="3230129417775002227">Phromium жақсара түсті</translation>
<translation id="1322165820810533683">Енді Phromium-дегі функциялар көбейді.</translation>
<translation id="7624307931717240213">Біз бұл қызметті жақсарту үшін ақпаратты пайдаланамыз. Құпиялық саясаты мен Қызмет көрсету шарттарын қараңыз.</translation>
<translation id="7649070708921625228">Анықтама</translation>
<translation id="3795437289339745990">Phromium қолданбасын жүктеп алу</translation>
<translation id="7658239707568436148">Бас тарту</translation>
<translation id="6671257169702988694">Phromium әдепкі браузеріңіз емес</translation>
<translation id="7270402397025248165">Phromium браузерін барлық құрылғыларда синхрондап, параметрлерін жекелендіріңіз</translation>
<translation id="6267574654655324634">Phromium жаңарту</translation>
<translation id="4868190765388740513">Жұмысыңыз Phromium-де қорғалады</translation>
<translation id="7716950018788545737">Тапсырмалар аяқталды.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" /> браузеріне арналған жүйені трассалау қызметтерін ұсынады. Қызмет өшірілсе, браузер жасаған өнімділік трассалары контекст ауыстыру және дайын ағын оқиғалары сияқты жалпы жүйелік оқиғаларды қамтымайды.</translation>
<translation id="2680098142787722612">Шолу деректері бұл құрылғыдан жойылады. Деректерді кейінірек алу үшін Phromium жүйесіне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="7747138024166251722">Орнату құралы уақытша каталогті жасай алмады. Дисктегі бос орынды және бағдарламалық жасақтама рұқсатын тексеріңіз.</translation>
<translation id="6830826880333833598">Phromium-ді әдепкі күйге қайтару</translation>
<translation id="448710321315554838">Phromium-ге кірген кезіңізде, Phromium-дегі жұмысыңызды қорғау үшін ұйымыңыз белгілі бір ақпаратты көре алады немесе басқара алады.</translation>
<translation id="7045209483723342691">Phromium-ді әдепкі браузер етіп орнатып, тапсырмалар жолағына бекітіңіз</translation>
<translation id="6452735947982563207">Phromium жылдамдығын арттырыңыз</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - Phromium Canary</translation>
<translation id="6929858452581400763">Интернет трафигіңізді пайдалана алатын адамдар қандай сайттарға кіретініңізді көрмейтіндей етіңіз. Phromium браузері DNS жүйесіндегі сайттың IP мекенжайын іздеу үшін қауіпсіз байланысты пайдаланады.</translation>
<translation id="7810005234485217901">"Сурет іздеу" функциясына оңай кіру үшін оны бекітуге болады.</translation>
<translation id="4343392731007327660">Phromium-мен бөлісетін контентті таңдау</translation>
<translation id="3052274192923256457">Осы құрылғыда бұл аккаунтқа Phromium профилі тіркеліп қойған.</translation>
<translation id="7845233973568007926">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын компьютерді өшіріп қосуыңыз керек.</translation>
<translation id="5674414381037997114">Іздеу жүйесі Phromium-нен тыс өзгертілді. Сізді қорғау үшін Phromium оны бастапқы әдепкі күйіне қайтарды. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Phromium-ге жаңа көрініс беру үшін оны бейімдеңіз.</translation>
<translation id="3966946337517395351">Мекенжай жолағында немесе іздеу өрісінде терген кезде, Phromium браузері жақсырақ ұсыныстар алу үшін тергеніңізді әдепкі іздеу жүйесіне жібереді. Бұл Инкогнито режимінде өшірілген.</translation>
<translation id="3928367799779122681">Phromium браузерінің ең соңғы нұсқасы орнатылмады, сондықтан жаңа мүмкіндіктер мен қауіпсіздікке қатысты түзетілген функцияларды пайдалана алмайсыз.</translation>
<translation id="7872446069773932638">Жүктеп алынып жатыр… <ph name="SECONDS" /> секунд қалды.</translation>
<translation id="8492102592995742850">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, <ph name="BEGIN_LINK" />аккаунтыңыздағы Phromium деректерін жойыңыз<ph name="END_LINK" />.</translation>
<translation id="959404544431817539">Phromium-дегі Gemini-ды қажет кезде лезде ашыңыз.</translation>
<translation id="8889749279816358185">Phromium-ді әдепкі браузер етіп орнату</translation>
<translation id="3173775358556080672">Мүмкін болса, Phromium қауіпті байланыстарды HTTPS кеңейтіміне автоматты түрде жаңартады.</translation>
<translation id="2210801904933897209">Phromium жүйесіне <ph name="USER_EMAIL_ADDRESS" /> ретінде кірдіңіз. Қайта кіру үшін бірдей аккаунтты пайдаланыңыз.</translation>
<translation id="7291855477503010638"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Бетбелгілер мен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="5706099517903615644">Бұл – Phromium браузерінің қайта орнатылған нұсқасы және әдепкі браузер бола алмайды.</translation>
<translation id="2388440031754359882">Белгісіз дереккөздерден алынған кеңейтім, қолданба, тақырыптар құрылғыңызға зиянын тигізуі мүмкін. Phromium оларды тек <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> дүкенінен орнатуды ұсынады.</translation>
<translation id="8205108509545565485"><ph name="DEVICE_TYPE" /> құрылғысындағы Phromium-мен Google-дың барлық мүмкіндігін пайдаланыңыз</translation>
<translation id="8004582292198964060">Браузер</translation>
<translation id="8010081455002666927">Автоанықтау</translation>
<translation id="6421861275173778152">Phromium браузерінің кіру рұқсаты болса, веб-сайттар сізден кіру рұқсатын сұрайды.</translation>
<translation id="942087293138739513">Phromium-ді кез келген уақытта жылдам ашу үшін тапсырмалар жолағына бекітіңіз</translation>
<translation id="80471789339884597">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын барлық браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="8054112667659782652">"Сурет іздеу" жылдам пәрменін үнемі көрсету</translation>
<translation id="8069447462453318634">"Құралдар тақтасына бекіту" опциясын таңдаңыз.</translation>
<translation id="8519423983825025511">Phromium-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="80790299200510644">Сурет іздеу</translation>
<translation id="8086881907087796310">Орнатылмады, себебі компьютер минималды жабдық талаптарына жауап бермейді.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="7988414336652558428">Phromium бұл сайт үшін локацияны пайдалануға рұқсат сұрайды.</translation>
<translation id="1778610353097215460">Келесі жолы Phromium-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, баға бақылау хабарландыруларын қосу туралы нұсқауды көресіз.</translation>
<translation id="4182143801062869250">Өзіңізге қызықты тауарлардың бағасы төмендеген кезде, телефондағы Phromium арқылы хабарландыру алыңыз</translation>
<translation id="8118331347066725040">Lens-бен іздеуге қатысты пікіріңізді жазыңыз.</translation>
<translation id="849080025203861031">Phromium-ді өзіңізге бейімдеңіз</translation>
<translation id="8133124826068723441">ChromiumOS деректеріңізді синхрондай алмады, себебі синхрондау функциясы доменіңіз үшін қолжетімді емес.</translation>
<translation id="813913629614996137">Дайындауда…</translation>
<translation id="139377652856781272">Phromium-дегі Gemini-ды пернелер тіркесімімен ашыңыз.</translation>
<translation id="8577594891153686998">Phromium Қосымша қызмет көрсету шарттары</translation>
<translation id="6418547610462348357">Бұл файл қауіпті болғандықтан, Phromium оны бөгеді.</translation>
<translation id="8177472873527554730">Беттен ештеңе табылмады.</translation>
<translation id="6257816439683677727">Phromium деректерін <ph name="USER_EMAIL" /> аккаунтында қолдану және сақтау үшін құпия фразаны енгізіңіз.</translation>
<translation id="820759916613250543">Бұл суретті сурет іздеу функциясымен іздеу</translation>
<translation id="8221491193165283816">Әдетте хабарландыруларға тыйым саласыз. Осы сайттың сізге хабарландыру жіберуіне рұқсат ету үшін осы жерді басыңыз.</translation>
<translation id="8672013454464753607">Камераны пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Phromium-ге рұқсат беріңіз.</translation>
<translation id="8006746139865532235">Phromium бұл кеңейтімнің қайдан келгенін анықтай алмайды. Ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Phromium-нан жойыңыз.</translation>
<translation id="5474258904581730105">Егер суреттің пайдалы сипаттамасы болмаса, Phromium оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Google-ға жіберіледі. Бұл функцияны кез келген уақытта параметрлерден өшіріп қоюға болады.</translation>
<translation id="5375524124600974413">Phromium-ге жаңа профильмен кіру қажет пе?</translation>
<translation id="5242991719841602450"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Phromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Құпия сөздер мен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="6524280192518819368">Phromium-дегі Gemini-ды жүйелік науада көрсету және пернелер тіркесімін қосу</translation>
<translation id="2082268001133511745"><ph name="BEGIN_LINK" />Phromium сізге<ph name="END_LINK" /> қауіпті сайттар мен жүктеп алу әрекеттері туралы ескертеді</translation>
<translation id="4030955203048827163">Жақында кірмедіңіз. Phromium <ph name="PERMISSION" /> рұқсатын өшірді.</translation>
<translation id="8358344509940735943">Phromium iOS қолданбасында камера көмегімен нәрселерді сатып алуға, аударуға және анықтауға болады.</translation>
<translation id="7062802333437169650">Phromium-ге <ph name="USER_NAME" /> ретінде кіруге арналған QR коды</translation>
<translation id="8313851650939857356">Іске қосу қатесі: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062">Ұйымыңыз Phromium-ді <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жабады.</translation>
<translation id="8321888067342493336">Сурет түрінде сақтау</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" /> бұрын Phromium браузерін пайдаланған</translation>
<translation id="5445795756751365814">Phromium-дегі дағдыларды қосу</translation>
<translation id="7329745364783464770">Phromium деректерін Google аккаунтында (<ph name="ACCOUNT_EMAIL" />) әрі қарай пайдалану үшін Phromium-ді жаңартыңыз.</translation>
<translation id="5255856786869089460">Phromium-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8 нұсқасы орнатылған.</translation>
<translation id="8362914115861174987">Аударма тілі:</translation>
<translation id="8367705492654390392">Кез келген нәрсе сұраңыз</translation>
<translation id="8370517070665726704">Copyright <ph name="YEAR" /> Google LLC. Барлық құқықтары қорғалған.</translation>
<translation id="7349410893766975486">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін Phromium аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл құпия сөз Google аккаунтыңызға сақталады.</translation>
<translation id="394196307309768356">Содан кейін Phromium-ді өшіріп қосуыңыз қажет.</translation>
<translation id="7466825726005300631">Phromium оны өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" /></translation>
<translation id="264088846642173954">Бұл кеңейтімді әзірлеушісі жариялаудан бас тартқан, сондықтан ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Phromium-нан жойыңыз.</translation>
<translation id="1867604241588004166">Phromium браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="926481158288852551">{0,plural, =1{Phromium браузерін бір күннің ішінде қайта іске қосыңыз}other{Phromium браузерін # күннің ішінде қайта іске қосыңыз}}</translation>
<translation id="8438543370129609977">Сурет іздеу функциясын пайдалансаңыз, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">Phromium-де сурет іздеу функциясымен іздеу туралы толық ақпарат</translation>
<translation id="1069576136282928177">Орнатқыш мұрағаты бүлінген немесе жарамсыз. Phromium қайтадан жүктеңіз.</translation>
<translation id="7082388216101480391">Phromium браузері Windows 10 жүйесін не одан кейінгі нұсқасын қажет етеді.</translation>
<translation id="8463672209299734063">Міндетті емес: диагностика және пайдалану туралы деректі Google-ға автоматты түрде жіберу арқылы ChromiumOS функциялары мен жұмыс өнімділігін жақсартуға көмектесіңіз.</translation>
<translation id="4343027289807602417">Google аккаунтында Phromium деректерін пайдалану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="6746404578800969443">Phromium-ге кіру нұсқауларын көрсетеді</translation>
<translation id="5072642661707587697">Phromium ескірген</translation>
<translation id="759684005114911774">Phromium-ді әдепкі браузер етіп таңдағаныңызға рақмет!</translation>
<translation id="5209258538041302334">Құпия сөздер сақталған кезде, Phromium оларды тексере алады.</translation>
<translation id="8525579356836940628">Орнату тоқтап қалды.</translation>
<translation id="6348113608284833604"><ph name="DEVICE_TYPE" /> құрылғысындағы Phromium-мен құпия сөздерді, қойындылар мен басқа деректерді жол-жөнекей пайдаланыңыз</translation>
<translation id="5083347044281842800">Phromium құпия сөздеріңіздің бірін баршаға ашық қолды болған деректерден тапса, ескерту алыңыз.</translation>
<translation id="8555465886620020932">Қызмет қатесі: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">Кейбір Phromium функциялары мен кеңейтімдерінің жылдам пәрмендері бар. Оларды қайта қосуға болады.</translation>
<translation id="8556420416730706394">"Сурет іздеу" функциясына оңай кіру үшін оны бекітуге болады. Ол үшін бүйірлік панельдің жоғарғы жағындағы "Бекіту" түймесін басыңыз.</translation>
<translation id="856656450041460113">Тілдер тізімін іздеу</translation>
<translation id="9159785833243360958">Phromium-ді бірнеше ұйым басқарады</translation>
<translation id="8586442755830160949">Copyright <ph name="YEAR" /> The Chromium Authors. Барлық құқықтар қорғалған.</translation>
<translation id="3489957831482527036">Phromium іске қосылуда…</translation>
<translation id="8624541899164515475">Параметрлер, жаңа қойындыда ашылады.</translation>
<translation id="8648201657708811153">Google Chrome for Testing браузерін әдепкі браузер қылу мүмкін емес.</translation>
<translation id="7150069986792019616">Phromium-мен кез келген жерден іздеңіз</translation>
<translation id="1623850835554120265">Сонымен қатар ол Phromium іске қосқаныңызда немесе Omnibox ішінен іздегеніңізде қайсы бет көрсетілетінін бақылайды.</translation>
<translation id="8828478112210313529">Бұл қойындыны басқа құрылғыға жіберу үшін сол жерде Phromium-ге кіріңіз.</translation>
<translation id="3592747099485557650">Сізге арналған Phromium.</translation>
<translation id="8712637175834984815">Түсінікті</translation>
<translation id="3388228047978619624">Phromium-ге кіру қажет пе?</translation>
<translation id="8747073452963259673">іздеу аймағының төменгі сол жақ бұрышы: сол жақ <ph name="LEFT" />%, төменгі жақ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Орнату қатесі: желі әкімшісі орнатуға рұқсат бермейтін топтық саясатты қолданды: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Кейінірек еске салу</translation>
<translation id="614494151403742465">Қысқаша мазмұнын біліп, қосымша сұрақтар қою үшін бұл құжатты Phromium-дегі Gemini-мен бөлісіңіз.</translation>
<translation id="6346068443590018348">Phromium-ге кіру қажет пе?</translation>
<translation id="1468806565762231794">Phromium-ді әдепкі браузер қылу және тапсырмалар жолағына бекіту</translation>
<translation id="8826492472752484139">"Password Manager" түймесін басыңыз.</translation>
<translation id="8833697763442816810">ChromiumOS жүйесі</translation>
<translation id="4854784568701005121">Бұл тіл Phromium-де мәзірлерді, параметрлерді, ескертулерді және басқа мәтінді көрсету үшін пайдаланылады.</translation>
<translation id="8862326446509486874">Жүйе деңгейінде орнату үшін тиісті құқықтарыңыз жоқ. Әкімші ретінде орнату құралын қайта іске қосып көріңіз.</translation>
<translation id="7804139416589625033">Phromium профилін қосу</translation>
<translation id="6333867241557949259">Кіру кезіндегі қатеге байланысты ChromiumOS жүйесі Phromium деректерін Google аккаунтыңызға сақтай алмады.</translation>
<translation id="2888440364511152939">Ұйымыңыз Phromium-ге кіруді талап етеді</translation>
<translation id="7111325571010992010">Phromium құпия сөздерді көрсетуге әрекет етуде. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="4406716425954955281">Phromium енді әдепкі браузеріңіз емес. Оны әдепкі браузер ретінде орнату қажет пе?</translation>
<translation id="2999847959360823770">Phromium браузерін жаңарту мүмкін емес</translation>
<translation id="8944232836376404813">Бұл әрекет:
          <ph name="LINE_BREAKS" />
            • бастапқы бетті, жаңа қойынды бетін, іздеу жүйесін және бекітілген қойындыларды бастапқы күйге қайтарады;
            <ph name="LINE_BREAK" />
            • кеңейтімдерді өшіреді;
            <ph name="LINE_BREAK" />
            • cookie файлдарын және басқа уақытша сайт деректерін жояды.
            <ph name="LINE_BREAKS" />
            Бетбелгілерге, тарихқа және сақталған құпия сөздерге ештеңе болмайды.</translation>
<translation id="7461167469691640632">Phromium сайтының пернелер тіркесімдерін көрсету</translation>
<translation id="7394133813796947510">Phromium Enterprise логотипі</translation>
<translation id="2476839923452631964"><ph name="DEVICE_TYPE" /> құрылғысындағы Phromium-мен жол-жөнекей Google қауіпсіздігін қамтамасыз етіңіз</translation>
<translation id="2041306781031361744">Профиліңізді ашу кезінде бірдеңе дұрыс болмағандықтан, Phromium-ді іске қосу мүмкін емес. Phromium-ді қайта іске қосып көріңіз.</translation>
<translation id="8355079108092011401">Phromium-мен іздеу немесе <ph name="BEGIN_LINK" />Параметрлер<ph name="END_LINK" /> бөлімінде бейімдеу үшін</translation>
<translation id="820370893610994443">Phromium профильдерін басқару</translation>
<translation id="1885039203623228439">Phromium-дегі Gemini мен ашық қойынды арасында ауысу үшін пернетақтаны пайдаланыңыз.</translation>
<translation id="9018218886431812662">Орнату аяқталды</translation>
<translation id="8213523024005590363">Phromium браузерін қауіпсіз ету үшін, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> тізімінде жоқ келесі кеңейтім өшірілді, ол сізге ескертілмей қосылған болуы мүмкін.</translation>
<translation id="1376667286722804744">Phromium жүйесіне кіру</translation>
<translation id="5142314855184111999">Phromium-мен іздеу функциясын Mac мәзір жолағында көрсету және пернелер тіркесімін қосу</translation>
<translation id="5166485487967090892">Phromium бұл мұрағаттау файлын жүктеп алуға тыйым салды, себебі онда зиянды бағдарламаны жасыруы мүмкін басқа файлдар бар</translation>
<translation id="1902493242619542969">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді Phromium-ге ауыстырып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз. Жылдам кіру үшін, Phromium тапсырмалар жолағына бекітіледі.</translation>
<translation id="7092992855996941035">Телефондағы Phromium-мен Google-дың үздік жасанды интеллект құралдарын пайдаланыңыз</translation>
<translation id="4203475068093609811"><ph name="DEVICE" /> құрылғысынан құпия сөздер мен басқа ақпаратты алу үшін Phromium-ге кіріңіз.</translation>
<translation id="7699507532215026981">Басқа Google қызметтеріне кірген кезде, Phromium-ге де кіресіз</translation>
<translation id="5571207595456818809">Phromium автоматты түрде жабылған</translation>
<translation id="3670200098293484473">Phromium ескірген</translation>
<translation id="5636382052119887392">{0,plural, =1{Phromium браузері бір сағаттан кейін қайта іске қосылады}other{Phromium браузері # сағаттан кейін қайта іске қосылады}}</translation>
<translation id="9106236359747881194">Іздеу үшін мәтін таңдаңыз.</translation>
<translation id="9197093250229894135">Phromium-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8.1 нұсқасы орнатылған.</translation>
<translation id="7195134700293253698">Сілтемені жаңа Phromium қойындысында ашу</translation>
<translation id="911206726377975832">Сонымен қатар шолу деректеріңізді жоясыз ба?</translation>
<translation id="9134482777260927479">Үй тапсырмасын орындауға көмектесу</translation>
<translation id="9148058034647219655">Шығу</translation>
<translation id="8888942844777295083">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, Phromium қойындыларды қалпына келтіре алады. Мұны қосу үшін келесі бөлімге өтіңіз:</translation>
<translation id="1485079858205975514">Жүйе әкімшісі Phromium браузерін <ph name="TARGET_URL_HOSTNAME" /> сілтемесіне қосымша браузер арқылы кіре алатындай етіп конфигурациялады.</translation>
<translation id="1096075777207775410">&amp;Phromium-ді жаңарту үшін қайта іске қосу</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">Phromium браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="6554170182570636227">Phromium дұрыс жұмыс істемеуі мүмкін, себебі оған Windows XP не Windows Vista жүйелерінде қолдау көрсетілмейді</translation>
<translation id="8145475184469284022">Phromium арқылы Google-дың ең үздік қауіпсіздік функцияларын жол-жөнекей пайдаланыңыз.</translation>
<translation id="945522503751344254">Пікір жіберу</translation>
<translation id="1258071069834143371">Phromium-ді кім пайдаланып жатыр?</translation>
<translation id="8272911737374467274">Phromium браузерінің ең күшті қорғанысын қолданыңыз</translation>
<translation id="983803489796659991">Орнатылмады, себебі жаңарту серверінде қолданбаға арналған хештеу деректері жоқ.</translation>
<translation id="4087190600867587768">Phromium-ді аккаунтсыз қолдану</translation>
<translation id="985602178874221306">The Chromium Authors</translation>
<translation id="989970834842471429">"Сурет іздеу" функциясымен іздеу керек кез келген мәтінді не суретті таңдаңыз.</translation>
<translation id="6649431194696226496">Локацияны пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Phromium-ге рұқсат беріңіз.</translation>
</translationbundle>