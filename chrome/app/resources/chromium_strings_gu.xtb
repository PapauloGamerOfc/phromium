<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="1026101648481255140">ઇન્સ્ટૉલેશનની પ્રક્રિયા ફરી શરૂ કરો</translation>
<translation id="1029669172902658969">&amp;ChromiumOSને અપડેટ કરવા માટે, તેને ફરીથી લૉન્ચ કરો</translation>
<translation id="7962340570690354348">Phromium તમને આ એક્સ્ટેન્શનનો રિવ્યૂ કરવાનો સુઝાવ આપે છે</translation>
<translation id="2702007788032964762">જ્યારે કોઈ સાઇટ તેના પેજ પર લિંક ખાનગી રીતે પહેલેથી લોડ કરવાનું પૂછે, ત્યારે Phromium Google સર્વરનો ઉપયોગ કરે છે. આ તમારી ઓળખ પહેલેથી લોડ કરેલી સાઇટથી છુપાવે છે, પણ Googleને એ જાણવા મળે છે કે કઈ સાઇટ પહેલેથી લોડ કરવામાં આવે છે.</translation>
<translation id="1051793555070215510">આ 1 મિનિટનું સર્વેક્ષણ લઈને અમને છૂપા મોડને બહેતર બનાવવામાં અમારી મદદ કરો.</translation>
<translation id="1065672644894730302">તમારી પસંદગીઓને વાંચી શકાતી નથી.

કેટલીક સુવિધાઓ ઉપલબ્ધ હોઈ શકે છે અને પસંદગીઓ પરના ફેરફારોને સાચવવામાં આવશે નહીં.</translation>
<translation id="4964836565882496625">તમારા માતાપિતાએ Phromium માટે "સાઇટ, ઍપ અને એક્સ્ટેન્શન માટેની પરવાનગીઓ" બંધ કરી છે.\</translation>
<translation id="8409497136174302488">નજીકના ડિવાઇસ શોધવા અને તેનો ઉપયોગ કરવા માટે, Chromiumને તમારા સ્થાનિક નેટવર્કના ઍક્સેસની જરૂર છે</translation>
<translation id="4388904545107211948">Chromiumની કોઈ ચોક્કસ સુવિધા કે એક્સ્ટેન્શન શોધવા માટે, ઍડ્રેસ બારમાં તેનો શૉર્ટકટ અને તે પછી પસંદ કરેલા તમારા કીબોર્ડની કી ટાઇપ કરો</translation>
<translation id="7188624550427159072">સિસ્ટમ ટ્રેમાં Chromiumમાં શોધવાની સુવિધા બતાવો અને કીબોર્ડ શૉર્ટકટ ચાલુ કરો</translation>
<translation id="3689248207461565136">Phromium તમારા પાસવર્ડની નિકાસ કરવા માગે છે. આને મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="112640046208448578">વસ્તુઓ અથવા સ્થાનોને ઓળખો અને ટેક્સ્ટને કૉપિ કરો અથવા તેનો અનુવાદ કરો. જ્યારે તમે 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો, ત્યારે આ પેજનો કોઈ સ્ક્રીનશૉટ સર્વરને મોકલવામાં આવે છે. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="5414044255592121327">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK" />Chromeiumમાં સાઇન ઇન કરો<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Phromium મેનૂ પર ક્લિક કરો</translation>
<translation id="1157985233335035034">તાજેતરની ભાષાઓ</translation>
<translation id="1184145431117212167">Windowsનું તમારું વર્ઝન સપોર્ટેડ ન હોવાને કારણે આ ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="7861581212703831457">Phromium વિશે</translation>
<translation id="8752630985505435738">તમારા ફોન પર Phromium વડે કિંમત ટ્રૅક કરવા સંબંધિત અલર્ટ મેળવો</translation>
<translation id="1203500561924088507">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારે તમારું બ્રાઉઝર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> બાકી છે. તમારા બ્રાઉઝિંગને સુરક્ષિત રાખવા માટે, તમે આગલી વખતે <ph name="IDLE_DURATION" /> માટે નિષ્ક્રિય હો ત્યારે Phromium અપડેટ થશે.</translation>
<translation id="1232234696885483911">જ્યારે તમે 'છબી વડે શોધ' સુવિધા ખોલો, ત્યારે PDFs સહિત પેજનું શીર્ષક, URL અને કન્ટેન્ટ સર્વરને ઑટોમૅટિક રીતે મોકલવામાં આવશે. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">જ્યારે તમે સાઇન ઇન કર્યું હોય, ત્યારે તમે Chromiumમાં તમારા Google એકાઉન્ટમાંથી તમારા પાસવર્ડ અને બીજી ઘણી બાબતોનો ઉપયોગ કરી શકો છો. આને બદલવા માટે, “Chromiumમાં તમારા એકાઉન્ટ” પર જાઓ.</translation>
<translation id="7402478829083317456">Macના મેનૂ બારમાં Chromiumમાં Gemini બતાવો</translation>
<translation id="4902531791098430822">Chromiumમાં Geminiમાં સ્ક્રીનનો ભાગ પસંદ કરવા માટે, કીબોર્ડ શૉર્ટકટનો ઉપયોગ કરો.</translation>
<translation id="9002284132405311162">જ્યારે આ ટૅબ નિષ્ક્રિય હતું, ત્યારે Chromiumને ઝડપી રાખવા માટે મેમરી ખાલી કરવામાં આવી હતી. તમે આ સાઇટને નિષ્ક્રિય રહેવામાંથી બાકાત રાખવાનું હંમેશા પસંદ કરી શકો છો.</translation>
<translation id="5561666811965903444">Phromium દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે ફાઇલ જોખમી છે</translation>
<translation id="1340271056805240721">Gmail કે YouTube જેવી Googleની સેવાઓમાં <ph name="USER_EMAIL" /> વડે સાઇન ઇન કરતી વખતે, તમે એ જ એકાઉન્ટ વડે Chromiumમાં ઑટોમૅટિક રીતે સાઇન ઇન કરી શકો છો</translation>
<translation id="5048805453292757697">તમારા ફોન પર Phromium મેળવો</translation>
<translation id="1290883685122687410">સેટઅપ કરવામાં ભૂલ: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">તમારી નવી Phromium પ્રોફાઇલ સેટઅપ કરો</translation>
<translation id="7871721155662336863">Gemini in Phromium વડે અજમાવી જુઓ</translation>
<translation id="6569288432960798043">બ્લૂટૂથ ડિવાઇસ વિશે શોધખોળ કરવા Chromiumને બ્લૂટૂથના
 ઍક્સેસની જરૂર છે. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">તમારા ફોન પર Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="1330562121671411446">ભાષા શોધો</translation>
<translation id="1619655755195586133">Phromium (<ph name="URL" />)માંથી પણ ડેટા ડિલીટ કરો</translation>
<translation id="1345251407431278948">પિન કરેલી છે! તમે ટૂલબાર પરના નવા બટનમાંથી 'છબી વડે શોધ' સુવિધાને ફરીથી ઍક્સેસ કરી શકો છો</translation>
<translation id="1383876407941801731">શોધો</translation>
<translation id="2947996037737257951">મુસાફરીમાં બ્રાઉઝ કરવાનું ચાલુ રાખવા માટે Phromium ઍપનો ઉપયોગ કરો</translation>
<translation id="141901961143729572">તમારા વિચારો શેર કરો</translation>
<translation id="8355386219605656974">તમારી વિન્ડો શેર કરવા માટે, સિસ્ટમના સેટિંગમાં Phromium માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો.</translation>
<translation id="1478370723027452770">Chrome for Testing માટે સહાય મેળવો</translation>
<translation id="8398257182826094665"><ph name="DEVICE" />માંથી તમારી સાચવેલી માહિતી અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="1497802159252041924">ઇન્સ્ટૉલ કરવામાં ભૂલ: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">આ પેજ સંરક્ષિત છે</translation>
<translation id="3484755999946650557">Phromium ટૅબ શેર કરો</translation>
<translation id="3309377459597801353">Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="1547469039832541117">હાઇલાઇટ કરેલું કાર્ય સમાપ્ત કરે છે.</translation>
<translation id="2354363290397602683">Chromiumને પિન કરો</translation>
<translation id="2244728813494358888">Chromiumના સલામતી માટેના ટૂલ</translation>
<translation id="707582364915018531">Phromium તમારો Password Manager ડેટા ડિલીટ કરવા માગે છે. આને મંજૂરી આપવા માટે Windowsનો પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{અપડેટ લાગુ કરવા માટે તમે Chromiumને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે}=1{અપડેટ લાગુ કરવા માટે તમે Chromiumને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{અપડેટ લાગુ કરવા માટે તમે Chromiumને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{અપડેટ લાગુ કરવા માટે તમે Chromiumને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="5032531544901236587">તમારા ફોન પર Phromium ઍપ વડે Googleનો વધુમાં વધુ લાભ મેળવો</translation>
<translation id="7311082384439462587">Chromiumમાં પ્રાઇવસી અને સુરક્ષા સંબંધિત મુખ્ય નિયંત્રણોનો રિવ્યૂ કરો</translation>
<translation id="1640672724030957280">ડાઉનલોડ કરી રહ્યું છે...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, મેમ્બરશિપ તરીકે સાઇન ઇન કર્યું. એકાઉન્ટ મેનૂ ખોલો</translation>
<translation id="4535436467771816034">જ્યારે પણ તમે મેસેજ, દસ્તાવેજો અને અન્ય ઍપમાંની લિંક પર ક્લિક કરો, ત્યારે તમે Chromiumનો ઉપયોગ કરી શકો છો. તેને તમારા ટાસ્કબાર પર પણ પિન કરવામાં આવશે.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> માટે વધારેલા વિશેષાધિકારો પ્રદાન કરે છે.</translation>
<translation id="1722488837206509557">આ તમને ઉપલબ્ધ ડિવાઇસમાંથી પસંદ કરવાની અને તેમના પર કન્ટેન્ટ બતાવવાની મંજૂરી આપશે.</translation>
<translation id="3550860956769006392">Phromium ટૂંક સમયમાં જ બ્રાઉઝિંગ ડેટા ડિલીટ કરશે</translation>
<translation id="2053384509423635834">Phromium નૅવિગેશનને HTTPS પર અપગ્રેડ કરવાનો પ્રયાસ કરશે</translation>
<translation id="2516115567501600458">Phromium ડેટા સાફ કર્યો</translation>
<translation id="8571959122390670188">Phromium <ph name="REMAINING_TIME" />માં ફરી શરૂ થશે</translation>
<translation id="6284080675125981628">જ્યારે HTTPS ઉપલબ્ધ ન હોય, ત્યારે Phromium તમને ચેતવણી આપ્યા વિના અસુરક્ષિત કનેક્શનનો ઉપયોગ કરશે</translation>
<translation id="5872244334553252095">Chromiumને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="2213761221916953829">Phromium ને સુરક્ષિત બનાવવા માટે, અમે <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યાં હોઈ શકે છે તેવા કેટલાક એક્સ્ટેન્શન્સને અક્ષમ કર્યા છે.</translation>
<translation id="8807881428325438878">ઝડપી ઍક્સેસ માટે Chromiumને તમારા ટાસ્કબાર પર પિન કરવા માટે Windows નોટિફિકેશનમાં <ph name="BEGIN_BOLD" />હા<ph name="END_BOLD" /> પર ક્લિક કરો</translation>
<translation id="6861833596843600606">Phromium ફરીથી ઇન્સ્ટોલ કરો</translation>
<translation id="3950056404221550225">Phromium <ph name="AUTHENTICATION_PURPOSE" />નો પ્રયાસ કરી રહ્યું છે</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને <ph name="DEVICE" />માંથી તમારા એક્સ્ટેન્શન અને બીજું પણ ઘણું મળશે.</translation>
<translation id="6114726049187747242">આગલી વખતે જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર Phromium ખોલો, ત્યારે તમને Google Password Managerનો ઉપયોગ કરવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="1838374766361614909">શોધ સાફ કરો</translation>
<translation id="2724678689951174927">તમારા Google એકાઉન્ટમાં બ્રાઉઝિંગ ડેટા રાખીને તેને માત્ર આ ડિવાઇસમાંથી ડિલીટ કરવા માટે, <ph name="BEGIN_LINK" />Chromiumમાંથી સાઇન આઉટ કરો<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">મુસાફરીમાં હો ત્યારે ટૅબના નવા ગ્રૂપ ખોલવા અથવા બનાવવા માટે તમારા ફોન પર Phromium ડાઉનલોડ કરો.</translation>
<translation id="3191814926523151519">તમે તમારા સાઇન ઇન કરેલા હોય એવા Google એકાઉન્ટ મેનેજ કરી શકો છો. તમારા Google એકાઉન્ટનો ઉપયોગ Phromium બ્રાઉઝર, Play Store, Gmail અને વધુ માટે થાય છે. જો તમે કોઈ બીજા, જેમકે તમારા કુટુંબના સભ્ય માટે એકાઉન્ટ ઉમેરવા માંગતા હો, તો તેના બદલે નવી વ્યક્તિને તમારા <ph name="DEVICE_TYPE" />માં ઉમેરો. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">'છબી વડે શોધ' સુવિધા વડે શોધો</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને <ph name="DEVICE" />માંથી તમારા બુકમાર્ક અને બીજું ઘણું પણ મળશે.</translation>
<translation id="1880677175115548835">ટેક્સ્ટ પસંદ કરો</translation>
<translation id="1236934630660512644">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી Phromium પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો Phromium ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME" />થી જોડાયેલા રહેશે. તમે Google એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. તમે હાલના Phromium ડેટાને અલગ રાખવા માટે વૈકલ્પિક રીતે એક નવી પ્રોફાઇલ બનાવી શકો છો. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium દ્વારા સ્મૂધ સ્ક્રોલિંગ અને વીડિયોના ફ્રેમ રેટ જેવી બૅકગ્રાઉન્ડ ઍક્ટિવિટી અને વિઝ્યુઅલ ઇફેક્ટને મર્યાદિત કરીને બૅટરીના પાવરની બચત કરવામાં આવે છે. <ph name="BEGIN_LINK" />એનર્જી સેવર વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium અપડેટર સેવા</translation>
<translation id="5797624919204275541">આને બંધ કરવાથી, તમે Chromiumમાં સાઇન ઇન કર્યા સિવાય Gmail જેવી Googleની સાઇટમાં સાઇન ઇન કરી શકશો</translation>
<translation id="6850971726764387814">Phromium પ્રતિસાદ આપતું નથી. હવે ફરીથી લોંચ કરીએ?</translation>
<translation id="8289779763124483945">તમારી સંસ્થાના <ph name="MANAGER" /> માટે જરૂરી છે કે તમે Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="193439633299369377">અપડેટ લાગુ કરવા માટે ChromiumOSને ફરી શરૂ કરવાની જરૂર છે.</translation>
<translation id="3215238748514810076">Phromium દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે સામાન્ય રીતે આ પ્રકારની ફાઇલ ડાઉનલોડ કરવામાં આવતી નથી અને તે જોખમી હોઈ શકે છે</translation>
<translation id="1953553007165777902">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="MINUTE" /> મિનિટ બાકી છે</translation>
<translation id="8529252122707161160">Phromium ડિફૉલ્ટ બ્રાઉઝરને નિર્ધારિત અથવા સેટ કરી શકતું નથી</translation>
<translation id="197326043290947695">'છબી વડે શોધ' સુવિધા વડે વધુ સ્માર્ટ રીતે બ્રાઉઝ કરો</translation>
<translation id="7769772561254542263">Phromium શા માટે અમુક ફાઇલો બ્લૉક કરે છે તે જાણો, નવા ટૅબમાં ખૂલે છે</translation>
<translation id="3713013456746186442">તમારો Phromium સૉફ્ટવેર અપ ટૂ ડેટ રાખે છે. જો આ સેવા બંધ કરવા કે રોકવામાં આવે, તો તમારો Phromium સૉફ્ટવેર અપ ટૂ ડેટ રહેશે નહીં, એટલે કે ઉદ્ભવી શકે તેવા સુરક્ષા સંબંધિત જોખમોનું નિરાકરણ કરી શકાય નહીં એમ બની શકે છે અને સુવિધાઓ કાર્ય કરે નહીં એમ બની શકે છે. જ્યારે આ સેવાનો ઉપયોગ કરતો કોઈ Phromium સૉફ્ટવેર ન હોય, ત્યારે તે આપમેળે જ અનઇન્સ્ટૉલ થઈ જાય છે.</translation>
<translation id="5690439379999550641">આ, 1 આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Phromium માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="2018879682492276940">ઇન્સ્ટૉલ કરવામાં નિષ્ફળ રહ્યાં. કૃપા કરીને ફરી પ્રયાસ કરો.</translation>
<translation id="2039417478970545937">સેટિંગ.</translation>
<translation id="4765042254400173473">Googleની સેવાઓમાં વધુ મનગમતા બનાવેલા અનુભવો આપવા માટે, Phromium ઇતિહાસ શામેલ કરવો કે નહીં, તે પસંદ કરો</translation>
<translation id="1448229429009113044">તમને સશક્ત પાસવર્ડ બનાવવામાં, સાચવવામાં અને તેને ઑટોમૅટિક રીતે ભરવામાં મદદ કરવા માટે Chromiumમાં પહેલેથી જ આ સુવિધા આપવામાં આવી છે. સરળ ઍક્સેસ માટે શૉર્ટકટ ઉમેરો.</translation>
<translation id="2145664943269651168">Chromiumને નવો દેખાવ આપવા માટે નવા ટૅબ પેજ પર જઈને Chromiumને કસ્ટમાઇઝ કરો બટન પર ક્લિક કરો</translation>
<translation id="6052463185672312901">Phromium દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે આ ફાઇલ છેતરામણી છે અને તે તમારા ડિવાઇસમાં અનપેક્ષિત ફેરફારો કરે તેમ બની શકે છે</translation>
<translation id="3825064703718009924">તમે આગલી વખતે Phromium iOS ખોલો ત્યારે તમને <ph name="FEATURE_NAME" /> અજમાવવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="886729435477608858">તમારા Google એકાઉન્ટમાં તમે સાચવેલા તમારા પાસવર્ડ અને Chromiumનો અન્ય ડેટા આ ડિવાઇસમાંથી કાઢી નાખવામાં આવશે. Chromiumમાં તેનો ફરીથી ઉપયોગ કરવા માટે, પાછું સાઇન ઇન કરો.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}one{જ્યારે # મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}other{જ્યારે # મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}}</translation>
<translation id="2125838419757773031">શોધવા માટે સ્ક્રીનનો વિસ્તાર પસંદ કરો</translation>
<translation id="2126108037660393668">ડાઉનલોડ કરેલી ફાઇલની ચકાસણી નિષ્ફળ થઈ.</translation>
<translation id="2135919691573380097">આ સાઇટની જાણ કરો</translation>
<translation id="2137162749895930932">અનુવાદ સ્ક્રીન બંધ કરો</translation>
<translation id="2147218225094845757">બાજુની પૅનલ છુપાવો</translation>
<translation id="1628700182434635922">Phromium દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે આ સાઇટ કોઈ સુરક્ષિત કનેક્શનનો ઉપયોગ કરી રહી નથી તેમજ ફાઇલ સાથે ચેડાં કરવામાં આવ્યા હોઈ શકે છે</translation>
<translation id="2170098639895543546">પેજ પર કંઈપણ પસંદ કરો</translation>
<translation id="1807571394075492085">Phromium કસ્ટમાઇઝ કરો</translation>
<translation id="2174917724755363426">ઇન્સ્ટૉલેશનની પ્રક્રિયા પૂર્ણ થઈ નથી. શું તમે ખરેખર રદ કરવા માગો છો?</translation>
<translation id="8332848361915479268">Phromium - નેટવર્ક સાઇન ઇન - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">અપડેટ ચેક કરવામાં ભૂલ: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Chromiumમાંથી એકાઉન્ટ કાઢી નાખો</translation>
<translation id="6063124961634921864">મુસાફરીમાં શૉપિંગના શ્રેષ્ઠ ટૂલ સાથે રાખવા માટે Phromium ઍપનો ઉપયોગ કરો</translation>
<translation id="8646569091716523420">iOS માટે Phromium પર Safe Browsingમાં વધારેલી સુરક્ષા વડે મુસાફરીમાં વધુ સલામત રહો</translation>
<translation id="3084983792533696835">જોખમી સાઇટ. Phromium દ્વારા નોટિફિકેશન કાઢી નાખવામાં આવ્યા.</translation>
<translation id="2236949375853147973">મારી ઍક્ટિવિટી</translation>
<translation id="6387327671844988108">તમારા બધા ડિવાઇસ પર તમારા ઍડ્રેસ અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો. તમે સાઇન ઇન કરો તે પછી આ ઍડ્રેસ તમારા Google એકાઉન્ટમાં સાચવવામાં આવશે.</translation>
<translation id="722050260205928409">જો તમે કમ્પ્યુટરને શેર કરો છો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી અને તેમને જોઇએ તેમ Phromium ને સેટ કરી શકે છે.</translation>
<translation id="703211526866942526">Chromiumમાં કૌશલ્યો</translation>
<translation id="2283803047247799269">'છબી વડે શોધ' સુવિધા વડે આ ટૅબ શોધો</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Chromiumનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}one{Chromiumનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}other{Chromiumનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યાં હોય એવા ટૅબને થોભાવી દો}}</translation>
<translation id="2307973900865360088">ડૉકમાં રાખો</translation>
<translation id="6083276764640161328">URLsને Chromiumમાં સંગ્રહિત અસુરક્ષિત સાઇટની સૂચિ સાથે ચેક કરે છે. જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે Phromium પેજ કન્ટેન્ટના બિટની સાથોસાથ URLs પણ Safe Browsingને મોકલી શકે છે.</translation>
<translation id="2356070529366658676">કહો</translation>
<translation id="2359808026110333948">આગળ વધો</translation>
<translation id="741972887620936671">\"<ph name="EXTENSION_NAME" />\" એક્સ્ટેન્શન ઇચ્છે છે કે તમે Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="4709464915929597251">ઍપ માટે બૅકગ્રાઉન્ડમાં Phromium ચલાવવાનું બંધ કરો</translation>
<translation id="6804933363437420201"><ph name="USER_EMAIL_ADDRESS" /> તરીકે આ એક્સ્ટેન્શનનો ઉપયોગ કરવા માટે, Chromiumમાં સાઇન ઇન કરો.</translation>
<translation id="2384373936468275798">તમારા એકાઉન્ટની સાઇન ઇન વિગતો જૂની હોવાને કારણે ChromiumOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{1 HID ડિવાઇસને એક કે વધુ Phromium એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું હતું}=1{1 HID ડિવાઇસને એક કે વધુ Phromium એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}one{# HID ડિવાઇસને એક કે વધુ Phromium એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}other{# HID ડિવાઇસને એક કે વધુ Phromium એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યાં છે}}</translation>
<translation id="1394893265611797679">આ સાઇટ માટે Chromiumને કૅમેરા અને માઇક્રોફોનની પરવાનગીઓની જરૂર છે</translation>
<translation id="2403703063067034158">સ્ટાર્ટઅપ દરમિયાન ભૂલ: અન્ય સેટઅપ હાલમાં ચાલી રહ્યું છે, કૃપા કરીને પછીથી પ્રયાસ કરો.</translation>
<translation id="8457868297375575309">કોઈપણ ઍપમાંથી Chromiumમાં લિંક ખોલો અને તમારા ટાસ્કબાર પર બ્રાઉઝરને ઍક્સેસિબલ રાખો</translation>
<translation id="5354209517289935579">ઝડપી ઓવરવ્યૂ મેળવવા અને ફૉલોઅપ પ્રશ્નો પૂછવા માટે, આ દસ્તાવેજને Gemini in Chrome સાથે શેર કરવા માટે સારાંશ આપો બટન પર ક્લિક કરો</translation>
<translation id="6628402244681586711"><ph name="BEGIN_LINK" />Chromiumના ટૂલ<ph name="END_LINK" /> વડે, તમે સલામત રીતે બ્રાઉઝ કરી શકો છો તેમજ નિયંત્રણ જાળવી શકો છો</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ તેમજ બીજું ઘણું મળશે.</translation>
<translation id="2451727308784734061">Password Manager પર ઝડપથી જવા માટે તમારા શૉર્ટકટનો ઉપયોગ કરો. તમે તમારા શૉર્ટકટને તમારા કમ્પ્યુટરની હોમ સ્ક્રીન અથવા ઍપ લૉન્ચર પર ખસેડી શકો છો.</translation>
<translation id="1593547119543498467">Phromium ટૂંક સમયમાં જ બંધ થશે</translation>
<translation id="6814323389195469782">Phromium માં</translation>
<translation id="2485422356828889247">અનઇન્સ્ટૉલ કરો</translation>
<translation id="2513154137948333830">રીબૂટ કરવું આવશ્યક છે: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">'છબી વડે શોધ' સુવિધા વડે ટેક્સ્ટ પસંદ કરો</translation>
<translation id="2643581100433412871">Phromium વર્તમાન પાસવર્ડ બદલવાનો પ્રયાસ કરી રહ્યું છે. આને મંજૂરી આપવા માટે Windowsનો પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="4103676945224728292">ફાઇલો ડાઉનલોડ કરવા માટે Chromiumને સ્ટોરેજના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="8743720024689622265">Phromium હેલ્પર</translation>
<translation id="2575822587468774919">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કંઈપણ પસંદ કરો</translation>
<translation id="8692134707551176334">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="6035715610127790081">Phromium ડાઉનલોડ કરવા અને તમારા Google એકાઉન્ટમાં સાઇન ઇન કરવા માટે તમારા ફોન વડે QR કોડને સ્કૅન કરો.</translation>
<translation id="1579158377846894470">Phromium વડે શોધવા માટે.</translation>
<translation id="3626651250874375470">Chromiumનો ઉપયોગ કરવાનું ચાલુ રાખો</translation>
<translation id="259935314519650377">ડાઉનલોડ કરેલા ઇન્સ્ટૉલરને કૅશ મેમરીમાં સાચવવામાં નિષ્ફળ રહ્યાં. ભૂલ: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">સિસ્ટમ</translation>
<translation id="7634640424937626608">તમારી સંસ્થા બ્રાઉઝિંગ ડેટા જોઈ અને મેનેજ કરી શકે છે, જેમ કે તમારા બુકમાર્ક, ઇતિહાસ અને પાસવર્ડ. તે અન્ય Phromium પ્રોફાઇલમાં બ્રાઉઝિંગ ડેટા જોઈ શકશે નહીં</translation>
<translation id="2669565213445601962">તમારા <ph name="ACCOUNT_EMAIL" /> એકાઉન્ટમાં Phromium ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, આ તમે જ છો તેની ચકાસણી કરો</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{અપડેટ લાગુ કરવા માટે, અદ્યતન સુરક્ષા માટે જરૂરી છે કે તમે Phromium ફરીથી લૉન્ચ કરો}=1{અપડેટ લાગુ કરવા માટે, અદ્યતન સુરક્ષા માટે જરૂરી છે કે તમે Phromium ફરીથી લૉન્ચ કરો. તમારી છૂપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{અપડેટ લાગુ કરવા માટે, અદ્યતન સુરક્ષા માટે જરૂરી છે કે તમે Phromium ફરીથી લૉન્ચ કરો. તમારી # છૂપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{અપડેટ લાગુ કરવા માટે, અદ્યતન સુરક્ષા માટે જરૂરી છે કે તમે Phromium ફરીથી લૉન્ચ કરો. તમારી # છૂપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="4393202019354077587">Phromium પ્રારંભ કરો</translation>
<translation id="3192212313802409327">ઇન્સ્ટૉલેશન દરમિયાન ઓપરેટિંગ સિસ્ટમ ભૂલ આવી. કૃપા કરીને ફરીથી Phromium ડાઉનલોડ કરો.</translation>
<translation id="6648732950668475680">જો તમે ડિવાઇસ શેર કરતા હો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી શકે છે અને તેઓ તેમને જોઈએ તે પ્રમાણે Chromiumનું સેટઅપ કરી શકે છે</translation>
<translation id="3501804488281766385">તમારા સમગ્ર ડિવાઇસ પર Chromiumમાં Geminiનો ઉપયોગ કરવા માટે સરળ ઍક્સેસ, પછી ભલેને Phromium નાનું કર્યું હોય.</translation>
<translation id="5655763731487334489">Phromium ટૅબ</translation>
<translation id="582020748041490207">ઉમેરેલી સુરક્ષા માટે, Phromium તમારા ડેટાને એન્ક્રિપ્ટ કરશે.</translation>
<translation id="2693283019505702310">Chromiumમાંથી તમારા Google એકાઉન્ટને કાઢી નાખવા માટે, સાઇન આઉટ કરો</translation>
<translation id="2989508583692830513">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ, બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="2738871930057338499">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. HTTP 403 પ્રતિબંધિત. કૃપા કરીને તમારું પ્રૉક્સી કન્ફિગ્યુરેશન ચેક કરો.</translation>
<translation id="2753623023919742414">શોધવા માટે ક્લિક કરો</translation>
<translation id="3391021955306442819">Phromium ને તમારા ડિફૉલ્ટ PDF વ્યૂઅર તરીકે સેટ કરો</translation>
<translation id="293156805028931571">આ એક્સ્ટેન્શન માલવેર ધરાવે છે અને તે અસુરક્ષિત છે. તેને Chromiumમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="2799223571221894425">ફરીથી લોંચ કરો</translation>
<translation id="4742633141454352374">તમારું Phromium</translation>
<translation id="2816462166102338036">'છબી વડે શોધ' સુવિધા વડે આ વીડિયો શોધો</translation>
<translation id="2191308357458164968">iOS પર Phromium વડે તમારા કૅમેરા વડે પ્રોડક્ટ શોધો, કિંમતમાં ઘટાડાને ટ્રૅક કરો અને મુસાફરીમાં બીજું ઘણું કરો.</translation>
<translation id="2841525013647267359">આમાંથી અનુવાદ કરો</translation>
<translation id="2846251086934905009">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલર પૂર્ણ થયું નહીં. ઇન્સ્ટોલેશન રદ કરવામાં આવ્યું છે.</translation>
<translation id="4498037716339180906">Phromium માંથી દૂર કરો...</translation>
<translation id="4049188396834160957">તમને Phromium પર સલામત રાખે છે અને જ્યારે તમે સાઇન ઇન થયા હો, ત્યારે Googleની અન્ય ઍપમાં તમારી સુરક્ષા બહેતર બનાવવામાં કદાચ ઉપયોગમાં લેવાઈ શકે છે</translation>
<translation id="2885378588091291677">કાર્ય વ્યવસ્થાપક</translation>
<translation id="4119302609687132178">&amp;Phromium વિશે</translation>
<translation id="2915996080311180594">પછીથી ફરી શરૂ કરો</translation>
<translation id="8232968781653330429">તમારો ડેટા તમારા પાસફ્રેઝ વડે એન્ક્રિપ્ટ કરવામાં આવ્યો છે. તમારા Google એકાઉન્ટમાં Phromium ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, તમારો પાસફ્રેઝ દાખલ કરો.</translation>
<translation id="2945997411976714835">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલરની પ્રક્રિયા શરૂ થવામાં નિષ્ફળ રહી.</translation>
<translation id="5624652745932625503">iOS પર Phromium માટે સાચવેલા પાસવર્ડનો ઉપયોગ કરીને સાઇટ પર વધુ ઝડપથી સાઇન ઇન કરો</translation>
<translation id="8821179372057577828">તમારી સંસ્થા Chromiumને મેનેજ કરે છે</translation>
<translation id="741172935898285572">Phromium અપ ટૂ ડેટ છે</translation>
<translation id="8798708493876822519">જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે Phromium પેજ કન્ટેન્ટના બિટ સહિત URLs પણ Safe Browsingને મોકલી શકે છે</translation>
<translation id="6896740867011823632">તમારા માતાપિતાની પસંદગીઓ સાથે ઑનલાઇન વધુ સલામત રહેવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="3003694935412297923">બધા કામ</translation>
<translation id="3580865868015023718">{count,plural, =1{તમારા Google એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, Phromium માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા (1 આઇટમ) ડિલીટ કરવામાં આવશે.}one{તમારા Google એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, Phromium માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}other{તમારા Google એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, Phromium માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}}</translation>
<translation id="1211179250505223767">Chromiumમાં નવા ટૅબમાં <ph name="URL" /> ખોલો.</translation>
<translation id="4742400838355945730">કૌશલ્યો જેવી AI ઇનોવેશન તમારા Google એકાઉન્ટમાં સાચવવામાં આવે છે અને Phromium સિંકથી અલગથી મેનેજ કરવામાં આવે છે</translation>
<translation id="8070050512429584052">તમારા બધા ડિવાઇસ પર તમારા એક્સ્ટેન્શન અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="666691655897541311">Phromium માં ઉમેરી રહ્યું છે...</translation>
<translation id="3038232873781883849">ઇન્સ્ટૉલ થવાની રાહ જોઈ રહ્યાં છીએ...</translation>
<translation id="3045032126857188731">અનુવાદિત ભાષા: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">પ્રતિસાદનો સંવાદ બંધ કરો</translation>
<translation id="919456815618829047"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને <ph name="DEVICE" />માંથી તમારી વાંચન સૂચિ અને બીજું પણ ઘણું મળશે.</translation>
<translation id="6141754610526066487">અન્ય Phromium પ્રોફાઇલ</translation>
<translation id="2380720899384114679">એક્સ્ટેન્શન એવા ઍડ-ઑન હોય છે જે તમને Chromiumને કસ્ટમાઇઝ કરવાની મંજૂરી આપે છે. સુવ્યવસ્થિત રહેવાથી લઈને રોજિંદા કાર્યોને સરળ બનાવવા સુધી, એક્સ્ટેન્શન તમને Chromiumને તમારું પોતાનું બનાવવામાં મદદ કરે છે.</translation>
<translation id="2507281899032275020">ક્રૅશ રિપોર્ટ અને <ph name="UMA_LINK" /> Googleને મોકલીને Phromium ને વધુ સારું બનાવવામાં મદદ કરો.</translation>
<translation id="1514966729948178660">મુસાફરીમાં Googleની સલામતી મેળવવા માટે Phromium ઍપનો ઉપયોગ કરો</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{1 USB ડિવાઇસને એક કે વધુ Phromium એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું હતું}=1{1 USB ડિવાઇસને એક કે વધુ Phromium એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}one{# USB ડિવાઇસને એક કે વધુ Phromium એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}other{# USB ડિવાઇસને એક કે વધુ Phromium એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યાં છે}}</translation>
<translation id="78720743239019396"><ph name="DEVICE" />માંથી તમારી વાંચન સૂચિ અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="7000206277447032115">Chromiumનો ઇતિહાસ</translation>
<translation id="4555002192651219296">ઇન્સ્ટૉલર આર્કાઇવને અનકોમ્પ્રેસ કરવામાં નિષ્ફળ. કૃપા કરીને Phromium ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="310459126943037700">કામ સમાપ્ત કરવામાં નિષ્ફળ.</translation>
<translation id="3104828284009500087">પેજ પર કંઈપણ શોધો</translation>
<translation id="4867557516756736957">તમારા પાસવર્ડ, બુકમાર્ક અને ઇતિહાસને બધા ડિવાઇસ પર સંપૂર્ણ રીતે સિંક કરેલા રાખો. તમારા ડિફૉલ્ટ બ્રાઉઝરને Phromium પર અપડેટ કરીને તમે જાણતા હો એવી અને તમને ગમતી હોય એવી સુવિધાઓને સરળતાથી ઍક્સેસ કરો.</translation>
<translation id="8632308594821621017">Phromium તમારા માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="3130333203120345554">નવી શોધ</translation>
<translation id="3137969841538672700">શોધવા માટે ખેંચો</translation>
<translation id="9173792796158381383">આ ટૅબ વધારાના સંસાધનોનો ઉપયોગ કરી રહ્યું છે. તમારા પર્ફોર્મન્સને બહેતર બનાવવા માટે, Chromiumને તેને નિષ્ક્રિય કરવા દો.</translation>
<translation id="8874679893080632357">તમારી સ્ક્રીન શેર કરવા માટે, સિસ્ટમના સેટિંગમાં Phromium માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો</translation>
<translation id="101045618220347251">Phromium ને ફરીથી લોંચ કરો</translation>
<translation id="3161522574479303604">બધી ભાષાઓ</translation>
<translation id="5940989267583033306">Phromium છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="2045477525210426976">તમારી નવી Phromium પ્રોફાઇલ કસ્ટમાઇઝ કરો</translation>
<translation id="3540518135502114323">તમે ટૅબ સ્વિચ કર્યા વિના AI મોડ સાથે ચૅટ કરવાનું ચાલુ રાખી શકો છો. શરૂ કરવા માટે, Chromiumમાં સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ તેમજ બીજું પણ ઘણું મળશે.</translation>
<translation id="1496180326063744749">Chromiumમાંથી તમારા Google એકાઉન્ટને કાઢી નાખવા માટે, સેટિંગ પેજમાં જઈને Chromiumમાંથી સાઇન આઉટ કરો</translation>
<translation id="7792783034323745412">પછીથી, તમે તમારા માટે ફોર્મ ઑટોમૅટિક રીતે ભરવાની સુવિધા માટે સચવાયેલી માહિતીનો ઉપયોગ કરવા માગો છો કે કેમ તે વિશે Phromium તમને પૂછી શકે છે</translation>
<translation id="5240091371721695404">Phromium એની ડેટા ડિરેક્ટરી વાંચી અથવા લખી શકતુંં નથી:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">iOS પર Phromium વડે તમારા મનપસંદ Google AI ટૂલને મુસાફરીમાં તમારી સાથે રાખો.</translation>
<translation id="4848363951707149242"><ph name="DEVICE" />માંથી તમારા એક્સ્ટેન્શન અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="3286538390144397061">હવે ફરીથી પ્રારંભ કરો</translation>
<translation id="8613877111531019527">Google API કીઝ ખૂટે છે. Phromium ની કેટલીક કાર્યક્ષમતા અક્ષમ થશે.</translation>
<translation id="2784090498377460662">જ્યારે Phromium બંધ થાય ત્યારે બૅકગ્રાઉન્ડ ઍપ ચલાવવાનું ચાલુ રાખો</translation>
<translation id="3905054486991167751">જ્યારે તમે દૂર હો, ત્યારે Phromium અપડેટ થશે</translation>
<translation id="4502950976754616266">અસુરક્ષિત કનેક્શનનો ઉપયોગ કરીને કોઈપણ સાઇટ લોડ કરતા પહેલાં Phromium તમને ચેતવણી આપશે</translation>
<translation id="6107453188231652861">જ્યારે તમે બધી Phromium વિન્ડો બંધ કરશો, ત્યારે તમને મોટાભાગની સાઇટમાંથી સાઇન આઉટ કરવામાં આવશે, સિવાય કે જો તમે Chromiumમાં સાઇન ઇન કરેલું હોય, તો તમારા Google એકાઉન્ટમાંથી સાઇન આઉટ કરવામાં આવશે નહીં. સાઇટને તમને યાદ રાખવાની મંજૂરી આપવા માટે, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">શોધ વિસ્તારના સૌથી ઉપર જમણા ખૂણે: જમણી બાજુ <ph name="RIGHT" />%, સૌથી ઉપર <ph name="TOP" />%</translation>
<translation id="5896635343289575401">તમારા એકાઉન્ટમાંનો Phromium ડેટા</translation>
<translation id="5662253013097242821">તમારા ફોન પર Phromium વડે તમારા પાસવર્ડનો ઉપયોગ કરો</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">વર્તમાન Phromium પ્રોફાઇલ પર સ્વિચ કરીએ?</translation>
<translation id="3412460710772753638">આ ડિવાઇસ પર Password Managerમાં</translation>
<translation id="657700335789940813">Phromium અપડેટ કરવા માગે છે</translation>
<translation id="3487742274367151379"><ph name="DEVICE" />માંથી તમારા બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="3438772217992559640">'છબી વડે શોધ'ની સુવિધાનો ઉપયોગ કરીને આ ટૅબ શોધો</translation>
<translation id="8062355070850891600">તમારા ફોન પર Phromium વડે Safe Browsingમાં વધારેલી સુરક્ષા વિસ્તૃત કરો</translation>
<translation id="5419337472918920970">Chromiumને તમારું બનાવી રહ્યા છીએ...</translation>
<translation id="6573105037542661278">આ, <ph name="ITEMS_COUNT" /> આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Phromium માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="4600986251755456192"><ph name="SHORTCUT" /> વડે એક Phromium પ્રોફાઇલથી બીજી Phromium પ્રોફાઇલ પર સ્વિચ કરી શકાય છે</translation>
<translation id="8118189978246431067">કૃપા કરીને બધી Phromium વિંડોઝ બંધ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="7430418346833889620">તમારી વિન્ડો શેર કરવા માટે, સિસ્ટમના સેટિંગમાં Phromium માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો</translation>
<translation id="2943929290955142701"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે.  તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="5896697187441340113">મોબાઇલ ડિવાઇસ પર Phromium બ્રાઉઝર ડાઉનલોડ કરવા માટેનો QR કોડ</translation>
<translation id="354621070532799440">રિમાઇન્ડર: Googleની શ્રેષ્ઠ સલામતી સુવિધાઓ તમારા ખિસ્સામાં</translation>
<translation id="6718500626359284607">તમારી સ્ક્રીન શેર કરવા માટે, સિસ્ટમના સેટિંગમાં Phromium માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો.</translation>
<translation id="6511372913460632136">Phromium દ્વારા ઓળખી ન શકાતી સાઇટ માટે વધારેલું સંરક્ષણ JavaScript ઑપ્ટિમાઇઝેશન બંધ કરે છે</translation>
<translation id="3597003331831379823">વધારેલા વિશેષાધિકારો સાથે સેટઅપ ચલાવવામાં નિષ્ફળ રહ્યાં. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="8702816719621016911">આ વ્યક્તિનો બ્રાઉઝિંગ ડેટા આ ડિવાઇસમાંથી ડિલીટ કરવામાં આવશે. આ ડેટા પાછો મેળવવા માટે, Chromiumમાં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{Phromium માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે.}=1{Phromium માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{Phromium માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{Phromium માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="3667616615096815454">ઇન્સ્ટૉલ કરી શકતા નથી, સર્વર માટે આ ઍપ્લિકેશન અજાણી છે.</translation>
<translation id="678730369472836428">તમારા Google એકાઉન્ટમાંનો Chromiumનો બધો ડેટા એન્ક્રિપ્ટ કરવા માટે તમારા <ph name="BEGIN_LINK" />પોતાના પાસફ્રેઝ<ph name="END_LINK" />નો ઉપયોગ કરો. Google Payમાંથી ચુકવણી પદ્ધતિઓ અને સરનામા એન્ક્રિપ્ટ કરવામાં આવશે નહીં. Chromiumમાંથી બ્રાઉઝિંગ ઇતિહાસ સિંક થશે નહીં.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{આ અપડેટ લાગુ કરવા માટે Phromium ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે}=1{આ અપડેટ લાગુ કરવા માટે Phromium ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{આ અપડેટ લાગુ કરવા માટે Phromium ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{આ અપડેટ લાગુ કરવા માટે Phromium ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="2203303261468330007">નવા Phromium &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="686463893976008238">મનગમતું બનાવવા અને અન્ય હેતુઓ માટે, Phromium અને Googleની અન્ય સેવાઓ લિંક કરો</translation>
<translation id="3729187154190517324">"ટૅબ અને વધુ ઉમેરો" બટનનો ઉપયોગ કરીને એકથી વધુ ટૅબ, ફાઇલો અને ટૂલ ઉમેરીને તમારી શોધને વધુ ઊંડી બનાવો.</translation>
<translation id="5596264049590907430">Phromium પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="5594723037153142396">શા માટે Phromium અમુક ડાઉનલોડ કરેલી ફાઇલને બ્લૉક કરે છે તે જાણો</translation>
<translation id="3425307214497790458">જો કંઈપણ માટે તમારા રિવ્યૂની જરૂર હોય, તો Phromium તમને જણાવશે</translation>
<translation id="4247980944121268675">તમે જે પેજની મુલાકાત લેવાની શક્યતા વધુ હોય, Phromium તેને પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થઈ શકે</translation>
<translation id="3810973564298564668">મેનેજ કરો</translation>
<translation id="1058395779823101457">તમારા સાચવેલા પાસવર્ડનો ઉપયોગ કરવા માટે, QR કોડને ફૉલો કરો, iOS માટે Phromium ડાઉનલોડ કરો અને તમારા Google એકાઉન્ટમાં સાઇન ઇન કરો</translation>
<translation id="3846683726093018685">**સારાંશ આપો:** 30થી ઓછા શબ્દોવાળા એક વાક્યમાં, સ્ક્રીનશૉટમાં આપેલા કન્ટેન્ટના મુખ્ય વિષય અને તેના હેતુનું વર્ણન કરો.

          **પ્રશ્નો સૂચવો:** સ્ક્રીનશૉટને બહેતર રીતે સમજવા માટે વપરાશકર્તા પૂછી શકે તેવા 3-5 વિચારપ્રેરક પ્રશ્નોની બુલેટવાળી સૂચિ જનરેટ કરો. આ પ્રશ્નોમાં ઓછામાં ઓછો એક પ્રશ્ન એવો હોવો જોઈએ કે જે ખાસ કરીને કોઈ વિઝ્યુઅલ ઑબ્જેક્ટ, તેની ડિઝાઇન કે તેના પ્લેસમેન્ટ વિશે હોય.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">તમારા બધા ડિવાઇસ પર તમારા બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="3885770153807205175">ભાષા પિકર</translation>
<translation id="5947409614720749543">Chromiumને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. તમારે ક્યાંક ધ્યાન આપવાની જરૂર છે - વિગતો માટે ક્લિક કરો.</translation>
<translation id="2176348074240183776">Phromium ને ખોલવા માટે તમારા નામને ક્લિક કરો અને બ્રાઉઝ કરવાનું પ્રારંભ કરો.</translation>
<translation id="3892148308691398805">ટેક્સ્ટ કૉપિ કરો</translation>
<translation id="3679766722656346339"><ph name="EXISTING_USER" /> આ Phromium પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. તમારું બ્રાઉઝિંગ અલગ રાખવા, Phromium તમારા માટે તમારી અલગ પ્રોફાઇલ બનાવી શકે છે.</translation>
<translation id="6085953975934135790">આ એક્સ્ટેન્શન Chrome વેબ સ્ટોર પૉલિસીનું ઉલ્લંઘન કરે છે અને તે અસુરક્ષિત હોઈ શકે છે. તેને Chromiumમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="3941890832296813527">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલરની ફાઇલનું નામ અમાન્ય અથવા અનસપોર્ટેડ છે.</translation>
<translation id="608187946760434925">Phromium પાસવર્ડની કૉપિ કરવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="3054592240125889472">તમારા બધા ડિવાઇસ પર તમારી સાચવેલી માહિતી અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="3140795250676341027">તમે તમારા Google એકાઉન્ટમાં સાચવેલા તમારા પાસવર્ડ, ચુકવણી પદ્ધતિઓ અને સરનામા આ ડિવાઇસમાંથી કાઢી નાખવામાં આવશે. Chromiumમાં તેનો ફરીથી ઉપયોગ કરવા માટે, પાછું સાઇન ઇન કરો.</translation>
<translation id="395904275706073188">સંરક્ષિત પેજ વાંચી શકાતા નથી. કોઈ અલગ પેજ અજમાવી જુઓ.</translation>
<translation id="4227910144250222665">Chromiumની તમને સલામત રાખવાની રીત વિશે જાણો</translation>
<translation id="3967822245660637423">ડાઉનલોડ પૂર્ણ</translation>
<translation id="4150430234581811723">તમે જ્યારે ઍડ્રેસ બાર અથવા શોધ બૉક્સમાં ટાઇપ કરો છો, ત્યારે સૂચનો મેળવવા માટે Phromium તમે જે ટાઇપ કરો છો તેને તમારી સંસ્થાના શોધ, AI અને એજન્ટ ટૂલ પર મોકલે છે.</translation>
<translation id="3975724895399328945">Google Chrome for Testing વિશે</translation>
<translation id="3997429360543082038">ChromiumOS વિશે</translation>
<translation id="4847805566397342820">જ્યારે તમે કોઈ સાઇટની મુલાકાત લો, ત્યારે પ્રાઇવસી સર્વર મારફતે Phromium <ph name="BEGIN_LINK" />Google Safe Browsing<ph name="END_LINK" />ને તે સાઇટના URLનો વાંચવામાં મુશ્કેલ બનાવેલો ભાગ મોકલે છે, જે તમારા IP ઍડ્રેસને છુપાવે છે. જો સાઇટ પર કોઈ શંકાસ્પદ ઍક્ટિવિટી દેખાય, તો સંપૂર્ણ URLs અને પેજ કન્ટેન્ટના બિટ પણ મોકલવામાં આવે છે.</translation>
<translation id="4016217212818346953">Password Manager સાથે સુરક્ષિત રહો</translation>
<translation id="4019629340646866719"><ph name="BEGIN_LINK_LINUX_OSS" />Linux ડેવલપમેન્ટ એન્વાયરમેન્ટ<ph name="END_LINK_LINUX_OSS" />ની જેમ, ChromiumOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="4022972681110646219">સ્ક્રીનનો અનુવાદ કરો</translation>
<translation id="4023601594785368013">મૂળ ભાષા: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">કોઈપણ ઍપમાંથી લિંકને Chromiumમાં ખોલો. વધુમાં, સરળ ઍક્સેસ માટે તે તમારા ટાસ્કબારમાં પિન કરવામાં આવે છે.</translation>
<translation id="6916567874038032700"><ph name="BEGIN_LINK" />વર્તમાન સેટિંગ<ph name="END_LINK" />ની જાણ કરીને Chromiumને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="4050175100176540509">નવીનતમ વર્ઝનમાં મહત્ત્વપૂર્ણ સુરક્ષા સુધારણાઓ અને નવી સુવિધાઓ ઉપલબ્ધ છે.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}one{જ્યારે # મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}other{જ્યારે # મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}}</translation>
<translation id="2498876341137940584">Phromium છૂપો મોડ</translation>
<translation id="1371775705240141332">Phromium વિશે પેજ પર જાઓ</translation>
<translation id="1983555117242858621">તમારા બ્રાઉઝરને કોઈ નવો દેખાવ આપવા માટે Chromiumને કસ્ટમાઇઝ કરો</translation>
<translation id="3730928612696305544">તમારા Chromiumને કસ્ટમાઇઝ કરો</translation>
<translation id="4148957013307229264">ઇન્સ્ટોલ કરી રહ્યું છે...</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> - નેટવર્ક સાઇન ઇન - Phromium</translation>
<translation id="8940475598678719246"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારી વાંચન સૂચિ અને બીજું પણ ઘણું મળશે.</translation>
<translation id="3361801572720154185">Phromium માટે શ્રેષ્ઠ એપ્લીકેશન્સ, રમતો, એક્સટેન્શન્સ અને થીમ્સ શોધો.</translation>
<translation id="5104340040322658377">તમારા બધા કમ્પ્યૂટર પર આ એક્સ્ટેન્શન અને અન્ય ઘણું બધું મેળવવા માટે Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="6533832886058295845">તમારા માતાપિતાની પસંદગીઓ સાથે ઑનલાઇન વધુ સલામત રહેવા માટે, તમારી Phromium પ્રોફાઇલ પર સ્વિચ કરો, જેમાં તમે પહેલેથી <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન થયા છો</translation>
<translation id="4222932583846282852">રદ કરી રહ્યાં છીએ…</translation>
<translation id="4224210481850767180">ઇન્સ્ટૉલેશન રદ કરવામાં આવ્યું છે.</translation>
<translation id="6904238369362879351">તમારા Phromium ડેટાને આ એકાઉન્ટ સાથે લિંક કરીએ?</translation>
<translation id="357744319784654404">સાઇટ પરથી માનક સંરક્ષણ કરતા વધુ ડેટા વિશ્લેષિત કરીને, Googleને પણ પહેલાંથી જાણ ન હોય તેવી ખતરનાક સાઇટ વિશે તમને ચેતવણી આપે છે. તમે Phromium ચેતવણીઓને છોડી દેવાનું પસંદ કરી શકો છો.</translation>
<translation id="7228779501660520489">Chromiumમાંથી સાઇન આઉટ કરો</translation>
<translation id="2782053121162821">Phromium સાથે સહાય મેળવો</translation>
<translation id="4281844954008187215">સેવાની શરતો</translation>
<translation id="5084022108026911204">અમઉલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ થયું. જો Phromium હાલમાં ચાલી રહ્યું હોય, તો તેને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="5139026954638666406">Chromiumમાંથી પાસવર્ડની નિકાસ કરો</translation>
<translation id="4304713468139749426">પાસવર્ડ મેનેજર</translation>
<translation id="4334241893986177674">આ સ્ક્રીનશૉટ શોધો</translation>
<translation id="8324735155671556570">જ્યારે Windows શરૂ થાય, ત્યારે Phromium લૉન્ચ કરો</translation>
<translation id="4400772909124543403">કોઈ અપડેટ ઉપલબ્ધ નથી</translation>
<translation id="2185735215611818026">છતાં પણ Chromiumમાંથી બહાર નિકળવું છે?</translation>
<translation id="4413205837991854510">'છબી વડે શોધ' સુવિધા માટેનો શૉર્ટકટ હંમેશાં બતાવો</translation>
<translation id="1338297030721125711">Chromiumને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{Phromium તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે. <ph name="BEGIN_LINK" />સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK" />}one{Phromium તમને તેમને કાઢી નાખવાનો સુઝાવ આપે છે. <ph name="BEGIN_LINK" />સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK" />}other{Phromium તમને તેમને કાઢી નાખવાનો સુઝાવ આપે છે. <ph name="BEGIN_LINK" />સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK" />}}</translation>
<translation id="1011403527148313450">Phromium ને કસ્ટમાઇઝ અને નિયંત્રિત કરો</translation>
<translation id="4427306783828095590">વધારેલી સુરક્ષા ફિશિંગ અને માલવેરને બ્લૉક કરવામાં વધુ સહાયરૂપ થાય છે</translation>
<translation id="4434353761996769206">ઇન્સ્ટૉલરની ભૂલ <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415"><ph name="MANAGER" /> Chromiumને મેનેજ કરે છે</translation>
<translation id="2477616462388290618">Phromium પ્રોફાઇલ ઉમેરો</translation>
<translation id="4447409407328223819">Chrome for Testing વિશે</translation>
<translation id="972523218852576493">તમારા Google એકાઉન્ટમાં Chromiumના ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, તમારો પાસફ્રેઝ દાખલ કરો</translation>
<translation id="4493028449971051158">સ્ટાર્ટઅપ દરમિયાન ભૂલ: કૃપા કરીને ઇન્સ્ટૉલરને ઍડમિનિસ્ટ્રેટર તરીકે ચલાવો.</translation>
<translation id="4501471624619070934">ઇન્સ્ટૉલેશન નિષ્ફળ ગયું કારણ કે આ દેશમાં ઍક્સેસ પ્રતિબંધિત છે.</translation>
<translation id="8839763675940122379">આ એક્સ્ટેન્શન દ્વારા તેની ડેટા એકત્રિત કરવાની અને તેનો ઉપયોગ કરવાની રીત જેવી પ્રાઇવસી પ્રૅક્ટિસ પબ્લિશ કરવામાં આવી નથી. Phromium તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે.</translation>
<translation id="2339640488105852505">Phromium પર આપનું સ્વાગત છે; નવી બ્રાઉઝર વિન્ડો ખોલી છે</translation>
<translation id="8536959233160434213">તમારી આસપાસના વિસ્તારો અને તમારા હાથને ટ્રૅક કરવા માટે, Chromiumને પરવાનગીની જરૂર છે</translation>
<translation id="1077734277628859167">તમે પહેલેથી Chromiumની અન્ય પ્રોફાઇલમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન થયા છો</translation>
<translation id="5512897665247593318">Phromium દ્વારા પેજ પહેલેથી લોડ કરવામાં આવે છે, જેને કારણે બ્રાઉઝ કરવાની અને શોધવાની ક્રિયા વધુ ઝડપી બને છે. <ph name="BEGIN_LINK" />પહેલેથી લોડ કરેલા પેજ વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">જ્યારે તમે તમને હાનિકારક લાગતી સાઇટની જાણ કરો, ત્યારે દરેક જણ માટે ઑનલાઇન સલામતી બહેતર બનાવો.</translation>
<translation id="6624033199018630177">Phromium દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે તમે Safe Browsingની સુવિધા બંધ કરેલી છે અને ફાઇલની ચકાસણી કરી શકાતી નથી</translation>
<translation id="3039804643080655517">તમારા ફોન પર Phromium વડે Google Lens અજમાવી જુઓ</translation>
<translation id="4594305310729380060">આ ડિવાઇસ પર Password Managerમાં</translation>
<translation id="8064263528617889755">Phromium ઍપ્લિકેશનો</translation>
<translation id="4598116752460667024">સૂચિમાંથી કોઈપણ પ્રક્રિયા શોધો.</translation>
<translation id="4613863813562375431">ChromiumOSનું વર્ઝન</translation>
<translation id="7245201002247176127">અપ ટૂ ડેટ થવામાં છે! અપડેટ સમાપ્ત કરવા માટે Phromium ને ફરીથી લોંચ કરો.</translation>
<translation id="8846891938874485868">Chromiumના V8 એન્જિન વડે સાઇટની ગતિ વધારે છે પરંતુ Chromiumને અટૅક સામે થોડું ઓછું પ્રતિરોધક બનાવે છે</translation>
<translation id="7525500996671436081">Phromium વડે શોધ ખોલો</translation>
<translation id="1224842000407297331">Phromium પ્રોફાઇલ</translation>
<translation id="4956303519269880412">ચેતવણી: એક્સ્ટેન્શનને તમારો બ્રાઉઝિંગ ઇતિહાસ રેકોર્ડ કરવાથી Phromium અટકાવી શકતું નથી. છૂપા મોડમાં આ એક્સ્ટેન્શનને બંધ કરવા માટે, આ વિકલ્પની પસંદગી નાપસંદ કરો.</translation>
<translation id="2708255035805733225">જો તમે Chromiumના વપરાશના રિપોર્ટ પણ શેર કરતા હો, તો તે રિપોર્ટમાં તમે મુલાકાત લો છો તે URLs શામેલ હોય છે</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" />, મેમ્બરશિપ તરીકે સાઇન ઇન કર્યું. એકાઉન્ટ મેનૂ ખોલો</translation>
<translation id="1883292567514549610">બીજા કમ્પ્યુટર (<ph name="HOST_NAME" />) પર પ્રોફાઇલ બીજી Phromium પ્રક્રિયા (<ph name="PROCESS_ID" />) દ્વારા ઉપયોગમાં હોય એવું લાગે છે. Phromium એ પ્રોફાઇલને લૉક કરી છે જેથી તે દૂષિત ન થઈ જાય. જો તમને ખાતરી છે કે કોઈ અન્ય પ્રક્રિયાઓ આ પ્રોફાઇલનો ઉપયોગ કરી રહી નથી, તો તમે પ્રોફાઇલને અનલૉક કરી અને Phromium ને ફરીથી લોંચ કરી શકો છો.</translation>
<translation id="4680828127924988555">ઇન્સ્ટૉલેશનની પ્રક્રિયા રદ કરો</translation>
<translation id="1889305042180577023">Chromiumનો તમારો અમુક ડેટા હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ડિલીટ કરવામાં આવશે.</translation>
<translation id="8079525505870459051">જ્યારે તમે સાઇન ઇન કર્યું હોય, ત્યારે તમે Chromiumમાં તમારા Google એકાઉન્ટમાંથી તમારા પાસવર્ડ અને વધુનો ઉપયોગ કરી શકો છો. <ph name="SHORTCUT" /> તમારા Googleની સેવાઓના સેટિંગ બદલી શકે છે.</translation>
<translation id="2171507067211697961">કોઈએ આ કોમ્પ્યુટર પર પહેલા <ph name="ACCOUNT_EMAIL_LAST" /> તરીકે Chromiumમાં સાઇન ઇન કર્યું છે. તમારી માહિતી અલગ રાખવા માટે કૃપા કરીને નવો Phromium વપરાશકર્તા બનાવો.</translation>
<translation id="4724676981607797757">અનસપોર્ટેડ પ્રોટોકૉલ ભૂલને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="6925701206088903005">છતાં પણ Phromium બંધ કરવું છે?</translation>
<translation id="4514755609496543621">Phromium માટેનું એક વિશિષ્ટ સુરક્ષા અપડેટ હમણાં જ લાગુ કરવામાં આવ્યું. હવે ફરી શરૂ કરો અને અમે તમારાં ટૅબની પુનઃસ્થાપના કરીશું.</translation>
<translation id="8673673368917636496">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Phromium દ્વારા <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />ની અને વધુ <ph name="COUNT" /> પરવાનગી કાઢી નાખવામાં આવી.</translation>
<translation id="3638319732826965647">જો Chromiumમાં Gemini ખુલ્લું હોય, તો નવા ટૅબ બનાવતી વખતે બાજુની પૅનલ ખુલ્લી રહે છે</translation>
<translation id="479167709087336770">આ પણ Google Searchમાં જે જોડણી તપાસનારનો ઉપયોગ થાય છે તેનો જ ઉપયોગ કરે છે. તમે બ્રાઉઝરમાં ટાઇપ કરો છો તે ટેક્સ્ટ Googleને મોકલવામાં આવે છે. તમે સેટિંગમાં આ વર્તણૂકને હંમેશાં બદલી શકો છો.</translation>
<translation id="2659245507243672392">એકાઉન્ટ વગર Chromiumનો ઉપયોગ કરો</translation>
<translation id="166411027652942990">mDNS ટ્રાફિકને મંજૂરી આપવા Phromium માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="6031862420354068813">&amp;Phromium અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="4918086044614829423">સ્વીકારો</translation>
<translation id="4918844574251943176">છબી કૉપિ કરી</translation>
<translation id="1531905832227009774">તમારા બધા ડિવાઇસ પર તમારી વાંચન સૂચિ અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="4319892378006430019">Phromium બૅકગ્રાઉન્ડ મોડમાં છે.</translation>
<translation id="8972359100025490790">Chromiumમાં સાઇન ઇન કરવાનો સંવાદ બંધ કરવા માટે ક્લિક કરો</translation>
<translation id="3639078149590125530">Phromium પ્રોફાઇલ વડે, તમે તમારી બધી વસ્તુઓ Phromium પર અલગ-અલગ રાખી શકો છો. મિત્રો અને કુટુંબ માટે પ્રોફાઇલ બનાવો અથવા તેને ઑફિસ અને મનોરંજન વચ્ચે વિભાજિત કરો.</translation>
<translation id="7141327976224964788">અતિથિઓ કંઈપણ પાછળ છોડ્યાં વિના Phromium નો ઉપયોગ કરી શકે છે.</translation>
<translation id="7007327521155149139">Chromiumમાં તમારું એકાઉન્ટ</translation>
<translation id="5973804420920585431">સ્વયંને Phromium માં ઉમેરો</translation>
<translation id="504699503110800016">ઓવરફ્લો મેનૂ ખોલો</translation>
<translation id="2497925691306722252">તમારા <ph name="DEVICE_TYPE" /> પર Phromium વડે Googleની તમારી બધી મનપસંદ સેવાઓને ઍક્સેસ કરો</translation>
<translation id="8678196879882043620">Chromiumને તમારા હાથ ટ્રૅક કરવા માટે પરવાનગીની જરૂર છે</translation>
<translation id="3397880081430454820">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Phromium દ્વારા <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />ની પરવાનગીઓ કાઢી નાખવામાં આવી.</translation>
<translation id="9114243566897924763">Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="5174969993834422967">તમે સામાન્ય રીતે નોટિફિકેશનને બ્લૉક કરો છો. આ સાઇટ તમને સૂચિત કરી શકે તે માટે, તમારા લોકેશન બારના જમણા ખૂણે દેખાતા નોટિફિકેશનના આઇકન પર ક્લિક કરો.</translation>
<translation id="5174983315706567306">પર્યાપ્ત ડિસ્ક સ્પેસ નથી.</translation>
<translation id="7698884672439844280">Phromium એકાઉન્ટને પુન:પ્રમાણીકરણની જરૂર છે</translation>
<translation id="5629965056131882780">iOS પર Phromium વડે તમે જ્યાંથી છોડ્યું હતું, ત્યાંથી શરૂ કરો.</translation>
<translation id="874294566462998787">Chromiumમાંથી સાઇન આઉટ કરો</translation>
<translation id="5234764350956374838">કાઢી નાખો</translation>
<translation id="8605581794204249702">Phromium Inco&amp;gnito વિન્ડોમાં લિંક ખોલો</translation>
<translation id="8722804301463582643">મુસાફરીમાં પાસવર્ડ સાચવવા માટે Phromium ઍપ મેળવો</translation>
<translation id="6253936671561887082">તમારા ફેરફારો લાગુ કરવા માટે, Chromiumને ફરી લૉન્ચ કરો</translation>
<translation id="7405713141437293142">આ ટૅબને અન્ય ડિવાઇસ પર મોકલવા માટે, બન્ને ડિવાઇસ પર Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="5286907366254680517">ભાળ મળી</translation>
<translation id="2224284460884535818">Phromium ઍપ મેળવો</translation>
<translation id="1426207087952749578">છૂપા મોડમાં બ્રાઉઝ કરતી વખતે, અસુરક્ષિત કનેક્શનનો ઉપયોગ કરીને સાઇટ લોડ કરતા પહેલાં Phromium તમને ચેતવણી આપશે</translation>
<translation id="8108751453879231987">Phromium વડે શોધો</translation>
<translation id="7780358745459835678">Phromium અપડેટર આંતરિક સેવા</translation>
<translation id="6956753580765202069">Chromiumમાં Geminiની અન્ય સુવિધાઓની સાથે તેનો ઉપયોગ કરો</translation>
<translation id="5346389065299425353">એકથી વધુ ટૅબ, ફાઇલો અને ટૂલ ઉમેરીને તમારી શોધને વધુ ઊંડી બનાવો</translation>
<translation id="8684266995248242891">આ દસ્તાવેજનો ઝડપી ઓવરવ્યૂ મેળવો અને Chromiumમાં Gemini વડે પ્રશ્નો પૂછો</translation>
<translation id="586104673506947714">Chromiumને તમારા રિવ્યૂ માટે કેટલાક સલામતી સંબંધિત સુઝાવો મળ્યા છે</translation>
<translation id="4657908558997566735">અન્ય Phromium પ્રોફાઇલ</translation>
<translation id="6097378010983112326">તમારા એકાઉન્ટની સાઇન ઇન વિગતો જૂની હોવાને કારણે ChromiumOS તમારા Google એકાઉન્ટમાં Phromium ડેટા સાચવી શક્યું નથી</translation>
<translation id="385020720581757591">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી Phromium પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો Phromium ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME" />થી જોડાયેલા રહેશે. તમે Google એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">વધારાનો કોડ: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">મનગમતું બનાવવાની સુવિધા મેળવવા માટે, Chromiumમાં વેબ અને ઍપ ઍક્ટિવિટી ઉમેરો</translation>
<translation id="2756028035855809142">Phromium વડે શોધ ખોલો</translation>
<translation id="4375021373215585423">Phromium શા માટે અમુક ફાઇલો બ્લૉક કરે છે, તે જાણો</translation>
<translation id="4688227912949761884">Phromium અપડેટ થઈ રહ્યું છે (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારા એક્સ્ટેન્શન અને બીજું ઘણું મળશે.</translation>
<translation id="4945147853702701048">Chromiumમાં સાઇન-ઇનની મંજૂરી આપો</translation>
<translation id="7813879193794658604">Phromium માંથી દૂર કરો</translation>
<translation id="2908302339618007937">પર્ફોર્મન્સ ઘટાડે છે પરંતુ Chromiumને અટૅક સામે વધુ પ્રતિરોધક બનાવે છે</translation>
<translation id="8760365573983490520">Chromiumને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> - Phromium બીટા</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{Chromiumનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}one{Chromiumનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}other{Chromiumનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યાં હોય એવા ટૅબને થોભાવી દો}}</translation>
<translation id="975923236500175446">આ Linux વિતરણ સિસ્ટમ પર Phromium હવે સપોર્ટ કરતું ન હોવાથી કદાચ તે યોગ્ય રીતે કાર્ય ન કરે</translation>
<translation id="7595270580374414215">Phromium દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું છે, કારણ કે આ ફાઇલ તમારા વ્યક્તિગત અને સોશિયલ નેટવર્ક એકાઉન્ટને નુકસાન પહોંચાડી શકે છે</translation>
<translation id="5644162187312430027">કૃપા કરીને Phromium, નવીનતમ સિસ્ટમ અપડેટ્સ ઇન્સ્ટોલ કરે ત્યાં સુધી રાહ જુઓ.</translation>
<translation id="2476033563817685908">Phromium પાસવર્ડમાં ફેરફાર કરવાનો પ્રયાસ કરે છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="1626952238284562558">Phromium વડે મુસાફરીમાં Google Drive અને YouTube જેવી તમારી મનપસંદ ઍપ સાથે વિક્ષેપરહિત કામ કરો.</translation>
<translation id="5524890928877629608">શોધ વિસ્તારના સૌથી ઉપર ડાબા ખૂણે: ડાબી બાજુ <ph name="LEFT" />%, સૌથી ઉપર <ph name="TOP" />%</translation>
<translation id="2860766395826060492">Chromiumમાં PDFs ખોલો</translation>
<translation id="5536164441519929134">આ ટૅબ વિશે<ph name="LINE_BREAK" />પૂછો</translation>
<translation id="3915500272078806319">સુરક્ષા માટે, જ્યારે તમે પહેલી વાર કોઈ સાઇટની મુલાકાત લો, ત્યારે Phromium JavaScript ઑપ્ટિમાઇઝેશન બંધ કરે છે.

જો આ પેજ અપેક્ષા મુજબ કામ ન કરતું હોય, તો ઑપ્ટિમાઇઝેશનને મંજૂરી આપવાનો પ્રયાસ કરો.</translation>
<translation id="6778733300408894918">Macના મેનૂ બારમાં Chromiumમાં Gemini બતાવો અને કીબોર્ડ શૉર્ટકટ ચાલુ કરો</translation>
<translation id="8411908790152555435"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને <ph name="DEVICE" />માંથી તમારી સાચવેલી માહિતી અને બીજું ઘણું મળશે.</translation>
<translation id="5579324208890605088">સ્ટાર્ટઅપ દરમિયાન ભૂલ: કૃપા કરીને ઇન્સ્ટૉલરને નિયમિત વપરાશકર્તા તરીકે ચલાવો, ઍડમિનિસ્ટ્રેટર તરીકે નહીં.</translation>
<translation id="6578510724610627339">ડિફૉલ્ટ તરીકે Chromiumનો ઉપયોગ કરો અને તેને પિન કરો</translation>
<translation id="5596627076506792578">વધુ વિકલ્પો</translation>
<translation id="5605834417512968703">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કંઈપણ પસંદ કરો અથવા 'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે Escape કી દબાવો</translation>
<translation id="5618818588972826921">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કોઈપણ ટેક્સ્ટ અથવા છબી પસંદ કરો અથવા 'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે Escape દબાવો</translation>
<translation id="4431270188253419020">{0,plural, =0{Phromium અપડેટ ઉપલબ્ધ છે}=1{Phromium અપડેટ ઉપલબ્ધ છે}one{Phromium અપડેટ # દિવસ માટે ઉપલબ્ધ છે}other{Phromium અપડેટ # દિવસ માટે ઉપલબ્ધ છે}}</translation>
<translation id="6903143702905157196">જ્યારે તમે Phromium બંધ કરો, ત્યારે હંમેશાં તમારા ડિવાઇસમાંથી સાઇટનો ડેટા ડિલીટ કરો</translation>
<translation id="5354366475527026551">કૃપા કરીને હવે Phromium ફરી શરૂ કરો</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">આ ભાષામાં Phromium બતાવો</translation>
<translation id="569897634095159764">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. પ્રૉક્સી સર્વરને પ્રમાણીકરણની જરૂર છે.</translation>
<translation id="5724138350057003647">નિષ્ક્રિય ટૅબમાંની મેમરી Phromium દ્વારા ઉપયોગમાં લેવામાં આવે છે. આને કારણે Phromium ટૅબ અને અન્ય ઍપને કમ્પ્યૂટરના વધુ સંસાધનો ફાળવીને પોતાને ઝડપી રાખી શકે છે. જ્યારે તમે તમારા નિષ્ક્રિય ટૅબ પર પાછા ફરો, ત્યારે તે ફરીથી ઑટોમૅટિક રીતે સક્રિય થાય છે. <ph name="BEGIN_LINK" />મેમરી સેવર વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="3730992449058237228">જો તમે તમારો પાસફ્રેઝ ભૂલી ગયા હો અથવા આ સેટિંગ બદલવા માગતા હો, તો તમારા એકાઉન્ટમાંનો Chromiumનો ડેટા <ph name="SETTINGS_LINK" /></translation>
<translation id="1983042639279920602">Chromiumને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. Chromiumને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો.</translation>
<translation id="7136978005010973283">Chromiumને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરીને તમારા પાસવર્ડ, બુકમાર્ક અને ઇતિહાસને બધા ડિવાઇસ પર સંપૂર્ણ રીતે સિંક કરેલા રાખો.</translation>
<translation id="5809516625706423866">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. HTTP 401 અનધિકૃત. કૃપા કરીને તમારું પ્રૉક્સી કન્ફિગ્યુરેશન ચેક કરો.</translation>
<translation id="3059302031765226748">Chromiumના V8 એન્જિન વડે સાઇટની ગતિ વધારે છે પરંતુ Chromiumને અટૅક સામે થોડું ઓછું પ્રતિરોધક બનાવે છે. આ સેટિંગ બંધ છે.</translation>
<translation id="4904710047654714935">તમારા Google એકાઉન્ટમાં Chromiumના ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, Phromium અપડેટ કરો</translation>
<translation id="5824893331272123205">આ પૅનલ લોડ કરી શકાઇ નથી, ફરી પ્રયાસ કરો</translation>
<translation id="2582896742857095190">Phromium માં સ્વાગત છે</translation>
<translation id="5004643502851105876">Chromiumની સૌથી સશક્ત સુરક્ષા પ્રદાન કરવા માટે વધારાની સુવિધાઓ ચાલુ કરે છે</translation>
<translation id="5871205389137001634">'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે ક્લિક કરો</translation>
<translation id="7409018434452575206">Chromiumને આ આઇટમમાં માલવેર હોવાનું જાણવા મળ્યું છે:</translation>
<translation id="3191822983646594827">Phromium નિયમિત રીતે ચેક કરીને એ વાતની ખાતરી કરતું રહે છે કે તમારા બ્રાઉઝરના સેટિંગ સૌથી સલામત છે. જો કોઈ બાબતનો રિવ્યૂ કરવો જરૂરી હશે તો અમે તમને તેની જાણ કરીશું.</translation>
<translation id="5895138241574237353">પુનઃપ્રારંભ કરો</translation>
<translation id="625373791981566594">Chromiumમાં Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - નેટવર્ક સાઇન ઇન</translation>
<translation id="5924017743176219022">ઇન્ટરનેટ સાથે કનેક્ટ કરી રહ્યાં છીએ...</translation>
<translation id="5941711191222866238">નાનું કરો</translation>
<translation id="8650638130234822147">તમારા બધા ડિવાઇસ પર આ બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="5010592102321399468">Chromiumને તમારા માટે અનુકૂળ બનાવો</translation>
<translation id="5960071705175224773">કોઈ અજાણી ઍપ દ્વારા તમારા સેટિંગ બદલવામાં આવ્યા હતા</translation>
<translation id="5977420883993828287">પિન કરેલી છે! ટૂલબારમાંથી સંદર્ભિત ટાસ્કનો ફરીથી ઉપયોગ કરો</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}one{જ્યારે # મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}other{જ્યારે # મિનિટ સુધી Chromiumનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}}</translation>
<translation id="3160371268592376569">સમન્વયનને પ્રારંભ કરવા માટે Phromium ને અપડેટ કરો</translation>
<translation id="5990360079535151574">ટૂલબાર પરના "સંદર્ભિત ટાસ્ક" બટન પરથી, તમે બ્રાઉઝ કરતી વખતે પ્રશ્નો પૂછવા માટે સંદર્ભિત ટાસ્ક ફરીથી ખોલી શકો છો</translation>
<translation id="6003112304606738118">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="HOURS" /> કલાક બાકી છે</translation>
<translation id="6009821354356307391">ફૉલોઅપ પ્રશ્ન પૂછો</translation>
<translation id="6040143037577758943">બંધ કરો</translation>
<translation id="5783572280281297164">જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર Phromium ઍપનો ઉપયોગ કરો, ત્યારે ઑનલાઇન શૉપિંગનો વધુ લાભ મેળવો</translation>
<translation id="2712461133060419287">તમારા ડેટાને સુરક્ષિત કરવા માટે, Chromiumને તમે તાજેતરમાં મુલાકાત લીધી ન હોય તેવી સાઇટમાંથી પરવાનગીઓ દૂર કરવા દો. નોટિફિકેશન બંધ કરવામાં આવશે નહીં.</translation>
<translation id="7845842385196710435">અને Chromiumમાં ખોલો</translation>
<translation id="6069027071882229820">છબી તરીકે કૉપિ કરો</translation>
<translation id="3752072756936611600"><ph name="EXTENSION_NAME" />ને Chromiumમાં ઉમેરવામાં આવ્યું છે</translation>
<translation id="2775066550187002528">Chromiumને કસ્ટમાઇઝ અને નિયંત્રિત કરો. અપડેટ ઉપલબ્ધ છે.</translation>
<translation id="6531352038528110565">ચાલુ • આ એક્સ્ટેન્શન ક્યાંથી આવે છે તેની ચકાસણી Phromium કરી શકતું નથી</translation>
<translation id="2876078296400914679">Chromiumમાં તમારું એકાઉન્ટ</translation>
<translation id="3881538460441135554">Chromiumના ટૂલબારમાં ઍક્સેસની વિનંતીઓ બતાવવા માટે એક્સ્ટેન્શનને મંજૂરી આપો</translation>
<translation id="7479187736743594081"><ph name="FILE_NAME" /> જોખમી છે, તેથી Phromium એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="6646104775883837119">Phromium ટૂંક સમયમાં જ બંધ થશે અને ડેટા ડિલીટ કરશે</translation>
<translation id="6138634751748297112">તમે અહીં એક Phromium પ્રોફાઇલથી બીજી Phromium પ્રોફાઇલ પર સ્વિચ કરી શકો છો</translation>
<translation id="8660563290103481109">જો તમે કુકીને મંજૂરી આપો, તો Phromium પહેલેથી લોડ કરતી વખતે તેનો ઉપયોગ કરી શકે છે</translation>
<translation id="6165508094623778733">વધુ જાણો</translation>
<translation id="969667123257916656">તમારા એકાઉન્ટમાંનો Phromium ડેટા સાફ કરો</translation>
<translation id="5528040738212560214">આ ફાઇલ જોખમી હોઈ શકે છે<ph name="LINE_BREAK" />જો તમે પાસવર્ડ પ્રદાન કરો છો, તો Phromium તમારા માટે આ ડાઉનલોડને તપાસી શકે છે. ફાઇલ વિશેની માહિતી Google Safe Browsingને મોકલવામાં આવે છે, પરંતુ ફાઇલનું કન્ટેન્ટ અને પાસવર્ડ તમારા ડિવાઇસમાં જ રહે છે.</translation>
<translation id="6182736845697986886">કોઈ અપડેટ સર્વરની આંતરિક ભૂલને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="6041381825442292659">ખાતરી કરો કે તમે તમારા <ph name="TARGET_DEVICE_NAME" /> પર Chromiumમાં સાઇન ઇન કર્યું છે અને પછી ફરીથી મોકલવાનો પ્રયાસ કરો.</translation>
<translation id="2474943719592372017">ગમે ત્યાંથી શોધો અને પ્રશ્નો પૂછો, પછી ભલેને Phromium નાનું કર્યું હોય. Chromiumને બૅકગ્રાઉન્ડમાં ચાલવાની મંજૂરી આપે છે.</translation>
<translation id="2518372260387069450">આ કમ્પ્યુટર પર પહેલાંથી જ Chromiumનું સૌથી તાજેતરનું વર્ઝન છે. જો સૉફ્ટવેર કાર્ય કરી રહ્યું નથી, તો કૃપા કરીને Chromiumને અનઇન્સ્ટૉલ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="3832895416321159809">{0,plural, =0{Phromium હમણાં ફરીથી લૉન્ચ થશે}=1{Phromium 1 સેકન્ડમાં ફરીથી લૉન્ચ થશે}one{Phromium # સેકન્ડમાં ફરીથી લૉન્ચ થશે}other{Phromium # સેકન્ડમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="2775110773501098464">ફાઇલો ડાઉનલોડ કરવા માટે, Chromiumને સ્ટોરેજના ઍક્સેસની પરવાનગીની જરૂર છે</translation>
<translation id="3505491405575013121">URLsને Chromiumમાં સ્ટોર કરેલી અસુરક્ષિત સાઇટની સૂચિ સાથે સરખાવીને ચેક કરે છે</translation>
<translation id="2276249127856880228">Chromiumને ડિફૉલ્ટ બ્રાઉઝર બનાવો</translation>
<translation id="6248988683584659830">શોધ સેટિંગ</translation>
<translation id="554637698797403739">તમારા ફોન પર Phromium ઍપ વડે મુસાફરીમાં Googleની શ્રેષ્ઠ સલામતી સંબંધિત સુવિધાઓ મેળવો</translation>
<translation id="7016155178198587734">Chromiumમાંથી સાઇન આઉટ કરીએ?</translation>
<translation id="5660287988409470276">આ ટૅબ વધારાના સંસાધનોનો ઉપયોગ કરી રહ્યાં છે. તમારા પર્ફોર્મન્સને બહેતર બનાવવા માટે, Chromiumને તેમને નિષ્ક્રિય કરવા દો.</translation>
<translation id="8429776045186716992">તમારી Phromium પ્રોફાઇલને કસ્ટમાઇઝ કરો</translation>
<translation id="3310436202618971091">તમારી Phromium પ્રોફાઇલને નામ આપો</translation>
<translation id="1478750151648434251">કોઈ એક્સ્ટેન્શન ઇચ્છે છે કે તમે Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="9139712828910812615"><ph name="FILE_NAME" /> જોખમી હોઈ શકે છે, તેથી Phromium એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="5191618263102115907">Phromium તમારા કૅમેરાનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="8247508943089477519">Phromium પર બીજી ક્રિયા ચાલુ છે. કૃપા કરીને પછીથી ફરી પ્રયાસ કરો.</translation>
<translation id="8271488218611798813">હવે તમારા Google એકાઉન્ટ સાથે અને શેર કરેલ કમ્પ્યુટર પર Phromium નો ઉપયોગ કરવો વધુ સરળ છે.</translation>
<translation id="446228390478495078">Chromiumને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરીને તમે જાણતા હો, તમને ગમતી હોય અને તમને વિશ્વાસપાત્ર હોય એવી સુવિધાઓનો સરળતાથી ઍક્સેસ મેળવો.</translation>
<translation id="2203435422524224690">Phromium શૉર્ટકટ</translation>
<translation id="3977517784144885449">Phromium દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે સામાન્ય રીતે આ ફાઇલ ડાઉનલોડ કરવામાં આવતી નથી અને તે જોખમી હોઈ શકે છે</translation>
<translation id="8088471547690853921">શું તમે ખરેખર તમે Phromium ને અનઇન્સ્ટૉલ કરવા માંગો છો?</translation>
<translation id="6375219077595103062">Password Managerમાં શૉર્ટકટ ઉમેરો</translation>
<translation id="6388799252195623474">મને આમાં મદદ કરો</translation>
<translation id="1774421040071124552">ચાલુ રાખવા માટે, Chromiumમાં <ph name="EMAIL" /> તરીકે સાઇન ઇન કરો. આનાથી ખાતરી થાય છે કે તમને તમારી સંસ્થાની પૉલિસીઓ મળી ગઈ છે.</translation>
<translation id="2343430845154053061">કમ્પ્યૂટરની સ્ક્રીનમાં Chromiumનો લોગો.</translation>
<translation id="2724924185145648602">Phromium એ એક એવું વેબ બ્રાઉઝર છે જે પ્રકાશની ગતિએ વેબપૃષ્ઠો અને એપ્લિકેશંસને ચલાવે છે. તે ઝડપી, સ્થિર અને ઉપયોગમાં સરળ છે. Google Phromium માં નિર્મિત મૉલવેર અને ફિશીંગ સુરક્ષા સાથે વેબને વધુ સુરક્ષિત રૂપે બ્રાઉઝ કરો.</translation>
<translation id="7417453886359805803">તમે હંમેશાં તમારા Google એકાઉન્ટમાં Chromiumના ડેટાનો ઉપયોગ કરી શકો અને તેને સાચવી શકો તેની ખાતરી કરવા માટે, આ તમે જ છો તેની ચકાસણી કરો</translation>
<translation id="3304683228794166031">Phromium વધુ ઝડપથી કામ કરે છે અને JavaScriptનો ઉપયોગ કરતી સુવિધાઓ ડિઝાઇન પ્રમાણે કામ કરવી જોઈએ</translation>
<translation id="6436260184216827876">'છબી વડે શોધ' સુવિધા ઉપલબ્ધ નથી. થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="6442900851116057561">ChromiumOS ફરી શરૂ કરો</translation>
<translation id="9164801375934097818">તમે જે પેજની મુલાકાત લેશો તેવી શક્યતા હોય, Phromium તેવા વધુ પેજને પણ પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થાય</translation>
<translation id="2577121659922309103">કિંમતો ટ્રૅક કરવા અને કોઈપણ સાઇટ પર કિંમતમાં ઘટાડો થાય ત્યારે અલર્ટ મેળવવા માટે તમારા ફોન પર Phromium ડાઉનલોડ કરો</translation>
<translation id="2052328618318278030">બંધ • આ એક્સ્ટેન્શન ક્યાંથી આવે છે તેની ચકાસણી Phromium કરી શકતું નથી</translation>
<translation id="3122296739697671126">Phromium પ્રોફાઇલમાં આપનું સ્વાગત છે</translation>
<translation id="3472445024540245926">આગલી વખતે જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર Phromium ખોલો, ત્યારે તમને ટૅબના ગ્રૂપનો ઉપયોગ કરવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="2144084801479939969">Chromiumમાંથી એકાઉન્ટ કાઢી નાખો</translation>
<translation id="2473490714352939152">જ્યારે તમે Phromium શરૂ કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="648319183876919572">Safe Browsingમાં વધારેલી સુરક્ષા તમને જોખમી વેબસાઇટ અને ડાઉનલોડ સામે વધુ સુરક્ષા આપે છે</translation>
<translation id="359777544552173333">Phromium ને અનઇન્સ્ટૉલ કરો</translation>
<translation id="3890462049854841354">શૉર્ટકટ Chromiumમાં ખુલે છે</translation>
<translation id="6616579671682178785">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION" /> માટે Chromiumનો ઉપયોગ ન કરે ત્યારે તેને બંધ કરે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવ્યો હતો. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.</translation>
<translation id="8662645370371079862">દરેક પ્રોફાઇલ બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજી ઘણી બાબતો જેવી તેની પોતાની Phromium માહિતી ધરાવે છે</translation>
<translation id="6556755379298048869">કીબોર્ડ શૉર્ટકટ વડે શોધો.</translation>
<translation id="7133640529688742768"><ph name="BEGIN_LINK" />Phromium તમારા ડેટાને કેવી રીતે ખાનગી રાખે છે<ph name="END_LINK" /> તે વિશે વધુ જાણો</translation>
<translation id="8316065704185291024">આ સેટિંગના ફેરફારો એકવાર Phromium ફરી શરૂ થાય પછી લાગુ થશે.</translation>
<translation id="2816396636285296289">Chromiumના મુખ્ય મેનૂમાં એક્સ્ટેન્શન પર ક્લિક કરીને તમારા એક્સ્ટેન્શન મેનેજ કરો.</translation>
<translation id="8831144879019828189">તમે બીજી Phromium પ્રોફાઇલમાંથી પાસવર્ડ જુઓ પર સ્વિચ કરી શકો છો</translation>
<translation id="7017911482442558099">મુસાફરીમાં શ્રેષ્ઠ AI ટૂલ સાથે રાખવા માટે Phromium ઍપનો ઉપયોગ કરો</translation>
<translation id="5784574554904759369">જોડણીની ભૂલો સુધારવા માટે, Phromium તમે ટેક્સ્ટ ફીલ્ડમાં ટાઇપ કરો તે ટેક્સ્ટ Googleને મોકલે છે</translation>
<translation id="8485501471305987872">Chromiumની નોટિફિકેશનની સેટિંગ પર જાઓ</translation>
<translation id="6600016381025017075">આ પેજ પર કંઈપણ શોધો</translation>
<translation id="1462793186918694806">તમારા ફેરફારો તમે આગલી વખતે Phromium ફરીથી લોંચ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="7501991510212476553">હવે જ્યારે Windows શરૂ થાય ત્યારે Phromium લૉન્ચ થાય છે, જેથી તમે તરત જ બ્રાઉઝ કરવાનું શરૂ કરી શકો. તમે સેટિંગમાં જઈને આને બંધ કરી શકો છો.</translation>
<translation id="7686308613268368175">તમે જ્યાંથી છોડ્યું હતું ત્યાંથી ચાલુ કરો: Chromiumએ તમારા છેલ્લા સત્રના ટૅબ રિસ્ટોર કર્યા છે. તમે આને આમાં બંધ કરી શકો છો</translation>
<translation id="5266723901802366313">તમારા આસપાસનો 3D નકશો બનાવવા માટે, Chromiumને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="7085315067428293799">જો તમે બુકમાર્કને તમારા Google એકાઉન્ટમાં પણ સાચવશો, તો તમે પ્રોડક્ટની કિંમતો Chromiumમાં ટ્રૅક કરી શકશો તેમજ જ્યારે પણ કિંમતમાં ઘટાડો થાય ત્યારે નોટિફિકેશન મેળવશો</translation>
<translation id="6676384891291319759">ઇંટરનેટ ઍક્સેસ કરો</translation>
<translation id="668175097507315160">સાઇન ઇનમાં થયેલી ભૂલને કારણે ChromiumOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="5279767706090517695">Chromiumમાંથી આ ઍપનો ડેટા કાઢી નાખો</translation>
<translation id="6562226321659107531">આ સાઇટ માટે Chromiumને માઇક્રોફોનની પરવાનગીની જરૂર છે</translation>
<translation id="6712881677154121168">ડાઉનલોડ કરવામાં ભૂલ: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">તમારી પ્રોફાઇલનો ઉપયોગ કરી શકાતો નથી કારણ કે તે Chromiumના નવા વર્ઝન તરફથી છે.

કેટલીક સુવિધાઓ ઉપલબ્ધ થઈ શકે છે. કૃપા કરીને અલગ પ્રોફાઇલ ડિરેક્ટરીનો ઉલ્લેખ કરો અથવા Chromiumના નવા વર્ઝનનો ઉપયોગ કરો.</translation>
<translation id="4914871493602315663">મનગમતું બનાવવાની અને અન્ય સુવિધાઓ મેળવવા માટે, Chromiumનો વેબ અને ઍપ ઍક્ટિવિટી અને લિંક કરેલી Google સેવાઓમાં સમાવેશ કરો</translation>
<translation id="5919390816124912606">Phromium, તમારા કમ્પ્યુટર પર તમામ વપરાશકર્તાઓ માટે પહેલાંથી ઇન્સ્ટૉલ કરેલ છે.</translation>
<translation id="5867815953973052697">તમારા બધા ડિવાઇસ પર તમારા બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો. તમે સાઇન ઇન કરો તે પછી આ બુકમાર્ક તમારા Google એકાઉન્ટમાં સાચવવામાં આવશે.</translation>
<translation id="7381168634819530324">Chromiumના V8 એન્જિન વડે સાઇટની ગતિ વધારે છે પરંતુ Chromiumને અટૅક સામે થોડું ઓછું પ્રતિરોધક બનાવે છે. આ સેટિંગ ચાલુ છે.</translation>
<translation id="1509688792864707851">{count,plural, =1{Chromiumનો તમારો કેટલોક ડેટા હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા (1 આઇટમ) ડિલીટ કરવામાં આવશે.}one{Chromiumનો તમારો કેટલોક ડેટા હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}other{Chromiumનો તમારો કેટલોક ડેટા હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}}</translation>
<translation id="4702638565169602649">Phromium આ ફાઇલને સ્કૅન કરવાનો સુઝાવ આપે છે, કારણ કે તે જોખમકારક હોઈ શકે છે.</translation>
<translation id="6779406956731413166">ChromiumOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="6831043979455480757">અનુવાદ કરો</translation>
<translation id="1564864902402454287">Phromium વડે તમે તમારા પાસવર્ડમાં ક્યારેક ચેડાં થાય તો તેના વિશે જાણકારી મેળવી શકો છો</translation>
<translation id="684888714667046800">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. જો તમે કોઈ ફાયરવૉલનો ઉપયોગ કરતા હો, તો કૃપા કરીને ખાતરી કરો કે <ph name="PRODUCT_EXE_NAME" /> વ્હાઇટલિસ્ટમાં છે.</translation>
<translation id="6200419390448865091">Phromium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">ચાલુ રાખવા માટે Tab કી દબાવો</translation>
<translation id="6862030660799253820">'છબી વડે શોધ' સુવિધા વડે આ છબી શોધો</translation>
<translation id="6869568587896659271">ઍડ્રેસ બારની નીચે આપેલી વેબસાઇટનો સરળ ઍક્સેસ</translation>
<translation id="4011399428346318467">Chromiumને "<ph name="EXTENSION_NAME" />"માં માલવેર હોવાનું જાણવા મળ્યું છે</translation>
<translation id="6877155553248388166">શોધ વિસ્તારના સૌથી નીચે જમણા ખૂણે: જમણી બાજુ <ph name="RIGHT" />%, સૌથી નીચે <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">કૉપિ કરો</translation>
<translation id="6898028264630240901">તમે બ્રાઉઝ કરો ત્યારે પ્રશ્નો પૂછવા માટે, સંદર્ભિત ટાસ્કને પિન કરી શકો છો</translation>
<translation id="1012681980425424211">Chromiumને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો અને તેને તમારા ટાસ્કબાર પર પિન કરો</translation>
<translation id="1744625657438211994">Phromium પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="7264818828956697552">આ ઍક્શન કરવાથી:
          <ph name="LINE_BREAKS" />
            • તમારું સ્ટાર્ટઅપ પેજ, નવું ટૅબ પેજ, શોધ એન્જિન અને પિન કરેલા ટૅબ રીસેટ થઈ જશે
            <ph name="LINE_BREAK" />
            • એક્સ્ટેન્શન બંધ થઈ જશે
            <ph name="LINE_BREAK" />
            • કુકી અને સાઇટનો અન્ય હંગામી ડેટા ડિલીટ થઈ જશે
            <ph name="LINE_BREAK" />
            • Phromium શૉર્ટકટ રીસેટ થઈ જશે
            <ph name="LINE_BREAKS" />
            બુકમાર્ક, ઇતિહાસ અને સાચવેલા પાસવર્ડને કોઈ અસર થશે નહીં.</translation>
<translation id="6489000842445481390">તમે Chromiumની <ph name="BOOKMARK_LIMIT" /> બુકમાર્કની મર્યાદાએ પહોંચી ગયા છો, તેથી તમારા અમુક બુકમાર્ક હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યા નથી.

જ્યાં સુધી તમે અમુક બુકમાર્ક ડિલીટ ન કરો, ત્યાં સુધી નવા બુકમાર્ક તમારા એકાઉન્ટમાં સાચવી શકાશે નહીં. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો ન સચવાયેલા બુકમાર્ક ડિલીટ કરવામાં આવશે.</translation>
<translation id="2645108248038996858">Phromium છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="6965382102122355670">બરાબર, સમજાઇ ગયું</translation>
<translation id="6985329841647292029">ChromiumOSની શરતો</translation>
<translation id="2947519843530032104">તમારા <ph name="ACCOUNT_EMAIL" /> એકાઉન્ટમાં Phromium ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે તમારો પાસફ્રેઝ દાખલ કરો</translation>
<translation id="7011190694940573312">ઑપરેટિંગ સિસ્ટમનું આ વર્ઝન સપોર્ટેડ ન હોવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="7024536598735240744">અનપૅક કરવામાં ભૂલ: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">Phromium કસ્ટમાઇઝ કરો</translation>
<translation id="7047386856539490735">શું આ પરિણામો ઉપયોગી છે?</translation>
<translation id="2448910402556368916">Phromium ને અપડેટ કરો</translation>
<translation id="7834049737623892628">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો Phromium તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Googleને છબીઓ મોકલવામાં આવે છે.</translation>
<translation id="1803168627715642217">જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર Phromium ઍપનો ઉપયોગ કરો, ત્યારે AIનું સામર્થ્ય મેળવો</translation>
<translation id="3321731353906178474">તમારા ફોન પર Phromium ઍપ વડે તમારા પાસવર્ડ, ટૅબ અને બીજું ઘણું મુસાફરીમાં સાથે રાખો</translation>
<translation id="7141270731789036260">Chrome for Testing કસ્ટમાઇઝ કરો</translation>
<translation id="8077731669779275332">જ્યારે પણ તમે મેસેજ, દસ્તાવેજો અને અન્ય ઍપમાંની લિંક પર ક્લિક કરો, ત્યારે તમે Chromiumનો ઉપયોગ કરી શકો છો</translation>
<translation id="611798798247797100">Chromiumમાંથી <ph name="EXTENSION_NAME" /> કાઢી નાખો</translation>
<translation id="7962394294883785044">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION" /> માટે Phromium ડેટાનો ઉપયોગ ન કરે ત્યારે તેને ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.</translation>
<translation id="2611686760870033712">આ સાઇટ માટે Chromiumને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="71050417052775020">Phromium લૉન્ચ કરી શકાયું નથી. ફરી પ્રયાસ કરો.</translation>
<translation id="4817060241763895497">Gemini in Phromium વડે તમે જ્યાં પણ હો, ત્યાંથી કંઈપણ પૂછો</translation>
<translation id="869358700049263961">Chromiumને કોઈપણ સમયે ઝડપથી ઍક્સેસ કરવા માટે, તેને તમારા ડૉકમાં રાખો</translation>
<translation id="7094488679340739251">જ્યારે પણ તમે મેસેજ, દસ્તાવેજો અને અન્ય ઍપમાંની લિંક પર ક્લિક કરો, ત્યારે Chromiumનો ઉપયોગ કરો</translation>
<translation id="7216228761061470870">જ્યારે તમે ડેસ્કટૉપ પર 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો છો, ત્યારે PDFs સહિત પેજનું શીર્ષક, URL અને કન્ટેન્ટ સર્વરને મોકલવામાં આવે છે.</translation>
<translation id="7802634650401946711">કાર્ય વ્યવસ્થાપક - Phromium</translation>
<translation id="5182547787327636348">Chromiumની બહારના કન્ટેન્ટ વિશે પૂછો, જેમ કે અન્ય ઍપ અથવા ફાઇલો</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારી સાચવેલી માહિતી તેમજ બીજું પણ ઘણું મળશે.</translation>
<translation id="5761733252154904648">ઝટપટ બ્રાઉઝિંગ શરૂ કરો: હવે Windows શરૂ થાય ત્યારે Phromium લૉન્ચ થઈ શકે છે.</translation>
<translation id="7274695763216404502">પિન કરેલી છે! ટૂલબારમાંથી ફરીથી 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો</translation>
<translation id="7288567540154601580">ટૅબ અને એક્સ્ટેન્શન</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{Phromium તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે}one{Phromium તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે}other{Phromium તેમને કાઢી નાખવાનો સુઝાવ તમને આપે છે}}</translation>
<translation id="1408728332407453335">Chromiumમાં સિસ્ટમ ઑડિયો શેર કરવા માટે, સિસ્ટમના સેટિંગ ખોલો અને 'માત્ર સિસ્ટમ ઑડિયો રેકોર્ડિંગ'ને મંજૂરી આપો. ત્યાર પછી તમારે Phromium ફરી શરૂ કરવું જરૂરી રહેશે.</translation>
<translation id="7299899569525778554">ડેસ્કટૉપ પરથી શોધો</translation>
<translation id="6194310460545162015">Phromium ને અપડેટ કરી રહ્યું છે</translation>
<translation id="1098154893096691883">તમારી પસંદગીઓ ફાઇલ દૂષિત અથવા અમાન્ય છે.

Phromium તમારા સેટિંગને રિકવર શકતું નથી.</translation>
<translation id="7324051657739063017">તમે બ્રાઉઝ કરો ત્યારે પ્રશ્નો પૂછવા માટે, તમે સંદર્ભિત ટાસ્કને ફરીથી ખોલી શકો છો</translation>
<translation id="7024097830259741656">તમારું વેબ, બુકમાર્ક અને અન્ય Phromium સામગ્રી અહીં હોય છે.</translation>
<translation id="852511575759652041">તમારો પાસફ્રેઝ ધરાવતી કોઈ વ્યક્તિ જ તમારો એન્ક્રિપ્ટેડ ડેટા વાંચી શકે છે. Googleને પાસફ્રેઝ મોકલવામાં આવતો નથી કે તેમાં સ્ટોર કરવામાં આવતો નથી. જો તમે તમારો પાસફ્રેઝ ભૂલી ગયા હો અથવા આ સેટિંગ બદલવા માગતા હો, તો તમારે <ph name="BEGIN_LINK" />તમારા એકાઉન્ટમાંનો Phromium ડેટા ડિલીટ કરવો<ph name="END_LINK" /> જરૂરી રહેશે.</translation>
<translation id="2846900085504364505">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME" />ને ઍક્સેસ કરવા Chromiumને <ph name="ALTERNATIVE_BROWSER_NAME" /> ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="7352651011704765696">કંઈક ખોટું થયું હતું</translation>
<translation id="7198690862684855451">Chromiumની ભાવિ અપડેટ મેળવવા માટે, તમને macOS 13 કે તે પછીનું વર્ઝન જોઈશે. આ કમ્પ્યૂટર macOS 12નો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="3224607549103501149">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Phromium દ્વારા <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />ની પરવાનગીઓ કાઢી નાખવામાં આવી.</translation>
<translation id="73786666777299047">Chrome વેબ દુકાન ખોલો</translation>
<translation id="8446269872172461565">સિસ્ટમ ટ્રેમાં Chromiumમાં Gemini બતાવો</translation>
<translation id="7401687852903179959">'છબી વડે શોધ'ની સુવિધાનો ઉપયોગ કરીને આ વીડિયો શોધો</translation>
<translation id="3403529853122418035">Phromium હવે તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="5649377421626481711">તમે જ્યાંથી છોડ્યું હતું ત્યાંથી ચાલુ કરો: Phromium તમે જ્યારે ફરી શરૂ કરો છો ત્યારે દરેક વખતે તમારા ટૅબ રિસ્ટોર કરે છે. આને બંધ કરવા માટે, આના પર જાઓ</translation>
<translation id="2467776530444676191">Chromiumમાં પાસવર્ડની આયાત કરો</translation>
<translation id="8814480293815136510">1. નીચે <ph name="BUTTON_LABEL" /> ક્લિક કરો
2. તમારા Windows સેટિંગમાં <ph name="BUTTON_2" /> પર ક્લિક કરો
3. ઝડપી ઍક્સેસ માટે Chromiumને તમારા ટાસ્કબાર પર પિન કરવા માટે Windows નોટિફિકેશનમાં <ph name="BUTTON_3" /> પર ક્લિક કરો</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - Phromium Dev</translation>
<translation id="7450541714075000668">ટેક્સ્ટ કૉપિ કરી</translation>
<translation id="6826407056979820031">તમારા માઇક્રોફોનનો ઉપયોગ કરવા માટે, <ph name="BEGIN_LINK" />સિસ્ટમના સેટિંગ<ph name="END_LINK" />માં જઈને Chromiumને ઍક્સેસ આપો</translation>
<translation id="1392131731909663319">Chromiumની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 7નો ઉપયોગ કરે છે.</translation>
<translation id="4512427777724578739">Phromium ફરીથી લૉન્ચ કરીએ?</translation>
<translation id="4510527847350985067">હાલમાં ચાલી રહ્યું છે તેના જેવું સમાન Phromium વર્ઝન ઇન્સ્ટૉલ કરી શકાતું નથી. કૃપા કરીને Chromiumને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="7510190804000607802">રિમાઇન્ડર: Googleની શ્રેષ્ઠ સુવિધાઓ હવે તમારા ખિસ્સામાં</translation>
<translation id="4735608937705010375">સાઇટ અપેક્ષા મુજબ કામ કરે તેમ બની શકે છે. જો તમે Chromiumમાં સાઇન ઇન કર્યું હોય, તો જ્યારે તમે તમારા Google એકાઉન્ટ સિવાયની બધી Phromium વિન્ડો બંધ કરશો, ત્યારે તમે મોટાભાગની સાઇટમાંથી સાઇન આઉટ થઈ જશો.</translation>
<translation id="7987051132742764178">{0,plural, =1{Phromium 1 મિનિટમાં ફરીથી લૉન્ચ થશે}one{Phromium # મિનિટમાં ફરીથી લૉન્ચ થશે}other{Phromium # મિનિટમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="1904271152425995672">તમારા ડેટાને સુરક્ષિત કરવા માટે, Chromiumને તમે તાજેતરમાં મુલાકાત લીધી ન હોય તેવી સાઇટમાંથી પરવાનગીઓ દૂર કરવા દો.</translation>
<translation id="7909976731673595773">ઝટપટ બ્રાઉઝિંગ શરૂ કરવા માટે Phromium ઑટોમૅટિક રીતે લૉન્ચ કરો.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ઇન્સ્ટૉલર</translation>
<translation id="3301232962183130807">Phromium તમારા કૅમેરા અને માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="3230129417775002227">Phromium હવે પહેલાંથી બહેતર બન્યું છે</translation>
<translation id="1322165820810533683">Chromiumમાં હવે તમારા માટે વધુ સુવિધાઓ ઉપલબ્ધ છે</translation>
<translation id="7624307931717240213">અમે આ સેવામાં સુધારણા કરવા માટે માહિતીનો ઉપયોગ કરીએ છીએ. પ્રાઇવસી પૉલિસી અને સેવાની શરતો જુઓ.</translation>
<translation id="7649070708921625228">સહાય</translation>
<translation id="3795437289339745990">Phromium ઍપ મેળવો</translation>
<translation id="7658239707568436148">રદ કરો</translation>
<translation id="6671257169702988694">Phromium તમારું ડિફૉલ્ટ બ્રાઉઝર નથી</translation>
<translation id="7270402397025248165">તમારા બધા ડિવાઇસ પર Chromiumને સિંક કરો અને મનગમતું બનાવો</translation>
<translation id="6267574654655324634">Phromium અપડેટ</translation>
<translation id="4868190765388740513">Phromium પર તમારું કાર્ય સુરક્ષિત છે</translation>
<translation id="7716950018788545737">કામ સમાપ્ત થયું/થયા.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" /> માટે સિસ્ટમ ટ્રેસ કરવાની સેવાઓ પ્રદાન કરે છે. જો આ સેવા બંધ હોય, તો બ્રાઉઝર દ્વારા બનાવવામાં આવેલા પર્ફોર્મન્સ ટ્રેસમાં સમગ્ર સિસ્ટમ પરની ઇવેન્ટ જેમ કે સંદર્ભ સ્વિચ અને તૈયાર થ્રેડની ઇવેન્ટ શામેલ કરવામાં આવશે નહીં.</translation>
<translation id="2680098142787722612">આ તમારા બ્રાઉઝિંગ ડેટાને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Phromium માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="7747138024166251722">ઇન્સ્ટૉલર અસ્થાયી ડિરેક્ટરી બનાવી શક્યું નથી. કૃપા કરીને ખાલી ડિસ્ક સ્પેસ માટે અને સૉફ્ટવેર ઇન્સ્ટૉલ કરવાની પરવાનગી માટે તપાસો.</translation>
<translation id="6830826880333833598">Chromiumના ડિફૉલ્ટ સેટિંગ પર રીસેટ કરો</translation>
<translation id="448710321315554838">Phromium પર તમારા કાર્યને સુરક્ષિત રાખવા માટે, જ્યારે તમે Chromiumમાં સાઇન ઇન કરેલું હોય, ત્યારે તમારી સંસ્થા અમુક માહિતી જોઈ અથવા મેનેજ કરી શકશે.</translation>
<translation id="7045209483723342691">Chromiumને ડિફૉલ્ટ તરીકે સેટ કરો અને તેને ટાસ્કબાર પર પિન કરો</translation>
<translation id="6452735947982563207">Chromiumને વધુ ઝડપી બનાવો</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - Phromium Canary</translation>
<translation id="6929858452581400763">તમારા ઇન્ટરનેટ ટ્રાફિકનો ઍક્સેસ ધરાવતા લોકો માટે, તમે કઈ સાઇટની મુલાકાત લો છો તે જોવાનું વધુ મુશ્કેલ બનાવો. Phromium દ્વારા DNS (ડોમેન નેમ સિસ્ટમ)માં સાઇટનું IP ઍડ્રેસ જોવા માટે સુરક્ષિત કનેક્શનનો ઉપયોગ કરવામાં આવે છે.</translation>
<translation id="7810005234485217901">તમે સરળ ઍક્સેસ માટે 'છબી વડે શોધ' સુવિધાને પિન કરી શકો છો</translation>
<translation id="4343392731007327660">Phromium સાથે શું શેર કરવું તે પસંદ કરો</translation>
<translation id="3052274192923256457">આ એકાઉન્ટ સાથેની Phromium પ્રોફાઇલ પહેલેથી જ આ ડિવાઇસ પર અસ્તિત્વમાં છે</translation>
<translation id="7845233973568007926">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારે તમારું કમ્પ્યુટર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="5674414381037997114">Chromiumની બહારથી તમારું શોધ એન્જિન બદલવામાં આવ્યું હતું. તમારી સુરક્ષા માટે, Phromium તેને ફરી તેના ઑરિજિનલ ડિફૉલ્ટ સેટિંગ પર રીસેટ કરે છે. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Chromiumને નવો દેખાવ આપવા માટે તેને કસ્ટમાઇઝ કરો</translation>
<translation id="3966946337517395351">જ્યારે તમે ઍડ્રેસ બાર અથવા શોધ બૉક્સમાં ટાઇપ કરો છો, ત્યારે બહેતર સૂચનો મેળવવા માટે Phromium તમે જે ટાઇપ કરો છો તેને તમારા ડિફૉલ્ટ શોધ એન્જિનને મોકલે છે. આ સુવિધા છૂપા મોડમાં કામ કરતી નથી.</translation>
<translation id="3928367799779122681">Phromium નવીનતમ વર્ઝન પર અપડેટ ન થઈ શક્યું, તેથી તમે નવી સુવિધાઓ અને સુરક્ષાના સુધારા ચૂકી રહ્યા છો.</translation>
<translation id="7872446069773932638">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="SECONDS" /> સેકન્ડ બાકી છે</translation>
<translation id="8492102592995742850">જો તમે તમારો પાસફ્રેઝ ભૂલી ગયા હો અથવા આ સેટિંગ બદલવા માગતા હો, તો <ph name="BEGIN_LINK" />તમારા એકાઉન્ટમાંનો Phromium ડેટા ડિલીટ કરો<ph name="END_LINK" /></translation>
<translation id="959404544431817539">જ્યારે પણ તમને Geminiની જરૂર પડે, ત્યારે તેને Chromiumમાં ઝડપથી ખોલો</translation>
<translation id="8889749279816358185">Chromiumને તમારા ડિફૉલ્ટ તરીકે સેટ કરો</translation>
<translation id="3173775358556080672">જ્યારે શક્ય હોય ત્યારે Phromium અસુરક્ષિત કનેક્શનને ઑટોમૅટિક રીતે HTTPS પર અપગ્રેડ કરે છે</translation>
<translation id="2210801904933897209">તમે Phromium માં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કર્યું હતું. ફરીથી સાઇન ઇન કરવા માટે કૃપા કરીને એ જ એકાઉન્ટનો ઉપયોગ કરો.</translation>
<translation id="7291855477503010638"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારા બુકમાર્ક તેમજ બીજું ઘણું મળશે.</translation>
<translation id="5706099517903615644">આ Google Chrome નું દ્વિતીય ઇન્સ્ટૉલેશન છે અને આને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવી શકાતું નથી.</translation>
<translation id="2388440031754359882">અજાણ્યા સ્રોતો પરના એક્સ્ટેન્શન, ઍપ અને થીમ તમારા ડિવાઇસને નુકસાન પહોંચાડી શકે છે. Phromium તેમને <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> પરથી જ ઇન્સ્ટૉલ કરવાનો સુઝાવ આપે છે</translation>
<translation id="8205108509545565485">તમારા <ph name="DEVICE_TYPE" /> પર Phromium ઍપ વડે Googleનો વધુમાં વધુ લાભ મેળવો</translation>
<translation id="8004582292198964060">બ્રાઉઝર</translation>
<translation id="8010081455002666927">ઑટોમેટિક રીતે ભાષા ઓળખો</translation>
<translation id="6421861275173778152">એકવાર Chromiumને ઍક્સેસ મળે, તે પછી વેબસાઇટ તમારી પાસે ઍક્સેસ માગી શકશે.</translation>
<translation id="942087293138739513">Chromiumને કોઈપણ સમયે ઝડપથી ઍક્સેસ કરવા માટે, તેને તમારા ટાસ્કબારમાં પિન કરો</translation>
<translation id="80471789339884597">ઇન્સ્ટૉલ કરવા બદલ આભાર. તમારે <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારા બધા બ્રાઉઝર ફરી શરૂ કરવા આવશ્યક છે.</translation>
<translation id="8054112667659782652">'છબી વડે શોધ' સુવિધા માટેનો શૉર્ટકટ હંમેશાં બતાવો</translation>
<translation id="8069447462453318634">"ટૂલબાર પર પિન કરો" પસંદ કરો</translation>
<translation id="8519423983825025511">ઍપ માટે બૅકગ્રાઉન્ડમાં Phromium ચલાવવાનું બંધ કરો</translation>
<translation id="80790299200510644">છબી વડે શોધ</translation>
<translation id="8086881907087796310">તમારું કમ્પ્યૂટર, હાર્ડવેરની ઓછામાં ઓછી આવશ્યકતાઓ પૂર્ણ ન કરી શકવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="7988414336652558428">આ સાઇટ માટે Chromiumને સ્થાનની પરવાનગીની જરૂર છે</translation>
<translation id="1778610353097215460">આગલી વખતે જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર Phromium ખોલો, ત્યારે તમને કિંમત ટ્રૅક કરવાના અલર્ટ ચાલુ કરવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="4182143801062869250">તમારા ફોન પર Phromium ઍપ વડે તમને રુચિ હોય તેવી આઇટમ પર કિંમતમાં ઘટાડાના અલર્ટ મેળવો</translation>
<translation id="8118331347066725040">'Lens વડે શોધો' માટે પ્રતિસાદ મોકલો</translation>
<translation id="849080025203861031">Chromiumને કસ્ટમાઇઝ કરો</translation>
<translation id="8133124826068723441">તમારા ડોમેન પર સિંકની સુવિધા ઉપલબ્ધ ન હોવાને કારણે ChromiumOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="813913629614996137">પ્રારંભ કરી રહ્યું છે...</translation>
<translation id="139377652856781272">કીબોર્ડ શૉર્ટકટ વડે Chromiumમાં Gemini ખોલો.</translation>
<translation id="8577594891153686998">Chromiumની વધારાની સેવાની શરતો</translation>
<translation id="6418547610462348357">આ ફાઇલ જોખમી છે, તેથી Phromium એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="8177472873527554730">પેજમાં કન્ટેન્ટ શોધી શકાતું નથી</translation>
<translation id="6257816439683677727">તમારા <ph name="USER_EMAIL" /> એકાઉન્ટમાં Phromium ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે તમારો પાસફ્રેઝ દાખલ કરો</translation>
<translation id="820759916613250543">'છબી વડે શોધ'ની સુવિધાનો ઉપયોગ કરીને આ છબી શોધો</translation>
<translation id="8221491193165283816">તમે સામાન્ય રીતે નોટિફિકેશનને બ્લૉક કરો છો. આ સાઇટને તમને નોટિફિકેશન આપવાની મંજૂરી આપવા માટે, અહીં ક્લિક કરો.</translation>
<translation id="8672013454464753607">તમારા કૅમેરાનો ઉપયોગ કરવા માટે, <ph name="BEGIN_LINK" />સિસ્ટમના સેટિંગ<ph name="END_LINK" />માં જઈને Chromiumને ઍક્સેસ આપો</translation>
<translation id="8006746139865532235">Phromium એ ચકાસણી કરી શકતું નથી કે આ એક્સ્ટેન્શન ક્યાંથી આવ્યું છે અને તે કદાચ અસલામત હોઈ શકે છે. તેને Chromiumમાંથી કાઢી નાખો, જેથી તે હવેથી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો છો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="5474258904581730105">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો Phromium તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Googleને છબીઓ મોકલવામાં આવે છે. તમે આને કોઈપણ સમયે સેટિંગમાં જઈને બંધ કરી શકો છો.</translation>
<translation id="5375524124600974413">નવી પ્રોફાઇલમાં Chromiumમાં સાઇન ઇન કરીએ?</translation>
<translation id="5242991719841602450"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Chromiumમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને <ph name="DEVICE" />માંથી પણ તમારા પાસવર્ડ અને બીજું ઘણું મળશે.</translation>
<translation id="6524280192518819368">સિસ્ટમ ટ્રેમાં Chromiumમાં Gemini બતાવો અને કીબોર્ડ શૉર્ટકટ ચાલુ કરો</translation>
<translation id="2082268001133511745">અસુરક્ષિત સાઇટ અને ડાઉનલોડ વિશે <ph name="BEGIN_LINK" />Phromium તમને ચેતવણી આપે છે<ph name="END_LINK" /></translation>
<translation id="4030955203048827163">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Phromium દ્વારા <ph name="PERMISSION" />ની પરવાનગી કાઢી નાખવામાં આવી.</translation>
<translation id="8358344509940735943">Phromium iOS ઍપ પર તમારા કૅમેરા વડે જે જુઓ, તેને ખરીદો, અનુવાદ કરો અને તેની ઓળખ કરો</translation>
<translation id="7062802333437169650"><ph name="USER_NAME" /> તરીકે Chromiumમાં સાઇન ઇન કરવા માટેનો QR કોડ</translation>
<translation id="8313851650939857356">સ્ટાર્ટઅપ દરમિયાન ભૂલ: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION" /> માટે Chromiumનો ઉપયોગ ન કરે ત્યારે તેને બંધ કરે છે.</translation>
<translation id="8321888067342493336">છબી તરીકે સાચવો</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" />, પહેલાં Phromium નો ઉપયોગ કરી રહ્યાં હતાં</translation>
<translation id="5445795756751365814">Chromiumમાં કૌશલ્યો ચાલુ કરો</translation>
<translation id="7329745364783464770">તમારા Google એકાઉન્ટ <ph name="ACCOUNT_EMAIL" />માં Phromium ડેટાનો ઉપયોગ કરવાનું ચાલુ રાખવા માટે Phromium અપડેટ કરો</translation>
<translation id="5255856786869089460">Chromiumની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 8નો ઉપયોગ કરે છે.</translation>
<translation id="8362914115861174987">આ ભાષામાં અનુવાદ કરો</translation>
<translation id="8367705492654390392">કંઈપણ પૂછો</translation>
<translation id="8370517070665726704">કૉપિરાઇટ <ph name="YEAR" /> Google LLC. સર્વાધિકાર સુરક્ષિત.</translation>
<translation id="7349410893766975486">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો. તમે સાઇન ઇન કરો તે પછી આ પાસવર્ડ તમારા Google એકાઉન્ટમાં સાચવવામાં આવશે.</translation>
<translation id="394196307309768356">ત્યાર પછી તમારે Phromium ફરી શરૂ કરવું જરૂરી છે.</translation>
<translation id="7466825726005300631">Phromium તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે. <ph name="BEGIN_LINK" />સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="264088846642173954">આ એક્સ્ટેન્શનને તેના ડેવલપર દ્વારા અનપબ્લિશ કરવામાં આવ્યું હતું અને તે અસુરક્ષિત હોઈ શકે છે. તેને Chromiumમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="1867604241588004166">તમારા Google એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, Phromium માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ડિલીટ કરવામાં આવશે.</translation>
<translation id="926481158288852551">{0,plural, =1{એક દિવસની અંદર Chromiumને ફરીથી લૉન્ચ કરો}one{# દિવસની અંદર Chromiumને ફરીથી લૉન્ચ કરો}other{# દિવસની અંદર Chromiumને ફરીથી લૉન્ચ કરો}}</translation>
<translation id="8438543370129609977">જ્યારે તમે 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો, ત્યારે PDFs સહિત પેજનું શીર્ષક, URL અને કન્ટેન્ટ સર્વરને મોકલવામાં આવે છે. <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">Chromiumમાં 'છબી વડે શોધ' સુવિધા વડે શોધવા વિશે વધુ જાણો</translation>
<translation id="1069576136282928177">ઇન્સ્ટૉલર આર્કાઇવ ખરાબ અથવા અમાન્ય છે. કૃપા કરીને Phromium ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="7082388216101480391">Phromium માટે Windows 10 અથવા તે પછીનું વર્ઝન આવશ્યક છે.</translation>
<translation id="8463672209299734063">વૈકલ્પિક: Googleને ડાયગ્નોસ્ટિક અને વપરાશનો ડેટા ઑટોમૅટિક રીતે મોકલીને ChromiumOSની સુવિધાઓ અને કાર્યપ્રદર્શનને બહેતર બનાવવામાં સહાય કરો.</translation>
<translation id="4343027289807602417">તમારા Google એકાઉન્ટમાં Chromiumના ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, આ તમે જ છો તેની ચકાસણી કરો</translation>
<translation id="6746404578800969443">Chromiumમાં સાઇન ઇન કરવા માટેના પ્રૉમ્પ્ટ બતાવો</translation>
<translation id="5072642661707587697">Phromium જૂનું થઈ ગયું છે</translation>
<translation id="759684005114911774">Chromiumને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે પસંદ કરવા બદલ આભાર!</translation>
<translation id="5209258538041302334">જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે Phromium તેને ચેક કરી શકે છે</translation>
<translation id="8525579356836940628">ઇન્સ્ટૉલેશનની પ્રક્રિયા રોકી</translation>
<translation id="6348113608284833604">તમારા <ph name="DEVICE_TYPE" /> પર Phromium ઍપ વડે તમારા પાસવર્ડ, ટૅબ અને બીજું ઘણું મુસાફરીમાં સાથે રાખો</translation>
<translation id="5083347044281842800">જો Chromiumને સાર્વજનિક ડેટા ઉલ્લંઘનમાં તમારો કોઈ પાસવર્ડ મળે, તો ચેતવણી મેળવો</translation>
<translation id="8555465886620020932">સેવામાં ભૂલ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">Chromiumની કેટલીક સુવિધાઓ અને એક્સ્ટેન્શન શૉર્ટકટ સાથે આવે છે. તમે તેને ફરીથી ચાલુ કરવાનું પસંદ કરી શકો છો.</translation>
<translation id="8556420416730706394">તમે સરળ ઍક્સેસ માટે 'છબી વડે શોધ' સુવિધાને પિન કરી શકો છો; બાજુની પૅનલમાં સૌથી ઉપર પિન કરો બટન પર ક્લિક કરો</translation>
<translation id="856656450041460113">ભાષાની સૂચિ શોધો</translation>
<translation id="9159785833243360958">એકથી વધુ સંસ્થાઓ Chromiumને મેનેજ કરે છે</translation>
<translation id="8586442755830160949">કોપિરાઇટ <ph name="YEAR" /> The Chromium Authors. સર્વાધિકાર સુરક્ષિત.</translation>
<translation id="3489957831482527036">Phromium લૉન્ચ કરી રહ્યાં છીએ…</translation>
<translation id="8624541899164515475">સેટિંગ, નવા ટૅબમાં ખૂલે છે.</translation>
<translation id="8648201657708811153">Chrome for Testingને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવી શકાતું નથી.</translation>
<translation id="7150069986792019616">ગમે ત્યાંથી Phromium વડે શોધો</translation>
<translation id="1623850835554120265">જ્યારે તમે Phromium શરૂ કરો અથવા ઑમ્નિબૉક્સ પરથી શોધ કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="8828478112210313529">આ ટૅબને અન્ય ડિવાઇસ પર મોકલવા માટે, ત્યાં Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="3592747099485557650">આ તમારું Phromium છે</translation>
<translation id="8712637175834984815">સમજાઈ ગયું</translation>
<translation id="3388228047978619624">Chromiumમાં સાઇન ઇન કરીએ?</translation>
<translation id="8747073452963259673">શોધ વિસ્તારના સૌથી નીચે ડાબા ખૂણે: ડાબી બાજુ <ph name="LEFT" />%, સૌથી નીચે <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ઇન્સ્ટૉલ કરવામાં ભૂલ: તમારા નેટવર્ક ઍડમિન દ્વારા કોઈ ગ્રૂપ પૉલિસી લાગુ કરવામાં આવી છે, જે ઇન્સ્ટૉલેશનની પ્રક્રિયાને અટકાવે છે: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">મને પછીથી યાદ કરાવો</translation>
<translation id="614494151403742465">ઝડપી ઓવરવ્યૂ મેળવવા અને ફૉલોઅપ પ્રશ્નો પૂછવા માટે, આ દસ્તાવેજને Chromiumમાં Gemini સાથે શેર કરો</translation>
<translation id="6346068443590018348">શું Chromiumમાં સાઇન ઇન કરીએ?</translation>
<translation id="1468806565762231794">Chromiumને ડિફૉલ્ટ બ્રાઉઝર બનાવો અને ટાસ્કબાર પર પિન કરો</translation>
<translation id="8826492472752484139">“Password Manager” પર ક્લિક કરો</translation>
<translation id="8833697763442816810">ChromiumOS સિસ્ટમ</translation>
<translation id="4854784568701005121">આ ભાષાનો ઉપયોગ Chromiumમાંના મેનૂ, સેટિંગ, અલર્ટ અને અન્ય ટેક્સ્ટ બતાવવા માટે થાય છે</translation>
<translation id="8862326446509486874">તમારી પાસે સિસ્ટમ-સ્તરનાં ઇન્સ્ટોલ માટે ઉચિત અધિકારો નથી. એડમિન તરીકે ઇન્સ્ટૉલરને ફરીથી ચલાવવનો પ્રયાસ કરો.</translation>
<translation id="7804139416589625033">Phromium પ્રોફાઇલ ઉમેરો</translation>
<translation id="6333867241557949259">સાઇન ઇન કરવામાં ભૂલ આવવાને કારણે, ChromiumOS તમારા Google એકાઉન્ટમાં Phromium ડેટા સાચવી શક્યું નથી</translation>
<translation id="2888440364511152939">તમારી સંસ્થા માટે જરૂરી છે કે તમે Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="7111325571010992010">Phromium પાસવર્ડ્સ બતાવવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="4406716425954955281">Phromium હવેથી તમારું ડિફૉલ્ટ બ્રાઉઝર નથી. Chromiumને ડિફૉલ્ટ બ્રાઉઝર બનાવીએ?</translation>
<translation id="2999847959360823770">Phromium અપડેટ કરી શકતાં નથી</translation>
<translation id="8944232836376404813">આ ઍક્શન કરવાથી:
          <ph name="LINE_BREAKS" />
            • તમારું સ્ટાર્ટઅપ પેજ, નવું ટૅબ પેજ, શોધ એન્જિન અને પિન કરેલા ટૅબ રીસેટ થઈ જશે
            <ph name="LINE_BREAK" />
            • એક્સ્ટેન્શન બંધ થઈ જશે
            <ph name="LINE_BREAK" />
            • કુકી અને સાઇટનો અન્ય હંગામી ડેટા ડિલીટ થઈ જશે
            <ph name="LINE_BREAKS" />
            બુકમાર્ક, ઇતિહાસ અને સાચવેલા પાસવર્ડને કોઈ અસર થશે નહીં.</translation>
<translation id="7461167469691640632">Phromium સાઇટના શૉર્ટકટ બતાવો</translation>
<translation id="7394133813796947510">Phromium Enterpriseનો લોગો</translation>
<translation id="2476839923452631964">તમારા <ph name="DEVICE_TYPE" /> પર Phromium ઍપ વડે મુસાફરીમાં Googleની સલામતી મેળવો</translation>
<translation id="2041306781031361744">તમારી પ્રોફાઇલ ખોલતી વખતે કંઈક ખોટું થયું હોવાને કારણે Phromium શરૂ કરી શકાતું નથી. Phromium ફરી શરૂ કરવાનો પ્રયાસ કરો.</translation>
<translation id="8355079108092011401">Phromium વડે શોધવા અથવા <ph name="BEGIN_LINK" />સેટિંગ<ph name="END_LINK" />માં કસ્ટમાઇઝ કરવા માટે</translation>
<translation id="820370893610994443">Phromium પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="1885039203623228439">Gemini in Phromium અને તમારા ખુલ્લા ટૅબ વચ્ચે નૅવિગેટ કરવા માટે તમારા કીબોર્ડનો ઉપયોગ કરો.</translation>
<translation id="9018218886431812662">ઇન્સ્ટૉલેશન પૂર્ણ</translation>
<translation id="8213523024005590363">Phromium ને સુરક્ષિત બનાવવા માટે, અમે નીચેના એક્સ્ટેન્શનને અક્ષમ કર્યું છે કે જે <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યું હોઈ શકે છે.</translation>
<translation id="1376667286722804744">Phromium માં સાઇન ઇન કરો</translation>
<translation id="5142314855184111999">Macના મેનૂ બારમાં Chromiumમાં શોધવાની સુવિધા બતાવો અને કીબોર્ડ શૉર્ટકટ ચાલુ કરો</translation>
<translation id="5166485487967090892">Phromium દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું છે, કારણ કે આર્કાઇવ ફાઇલમાં શામેલ અન્ય ફાઇલોમાં માલવેર છુપાવેલા હોઈ શકે છે</translation>
<translation id="1902493242619542969">તમારા પાસવર્ડ, બુકમાર્ક અને ઇતિહાસને બધા ડિવાઇસ પર સંપૂર્ણ રીતે સિંક કરેલા રાખો. તમારા ડિફૉલ્ટ બ્રાઉઝરને Phromium પર અપડેટ કરીને તમે જાણતા હો એવી અને તમને ગમતી હોય એવી સુવિધાઓને સરળતાથી ઍક્સેસ કરો. ઝડપી ઍક્સેસ માટે Chromiumને તમારા ટાસ્કબાર પર પિન કરવામાં આવશે.</translation>
<translation id="7092992855996941035">તમારા ફોન પર Phromium ઍપ વડે Googleના શ્રેષ્ઠ AI ટૂલનો ઉપયોગ કરો</translation>
<translation id="4203475068093609811"><ph name="DEVICE" />માંથી તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="7699507532215026981">જ્યારે તમે Googleની અન્ય સેવાઓમાં સાઇન ઇન કરશો, ત્યારે Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="5571207595456818809">Phromium ઑટોમૅટિક રીતે બંધ થઈ ગયું હતું</translation>
<translation id="3670200098293484473">Phromium જૂનું થઈ ગયું છે</translation>
<translation id="5636382052119887392">{0,plural, =1{Phromium એક કલાકમાં ફરીથી લૉન્ચ થશે}one{Phromium # કલાકમાં ફરીથી લૉન્ચ થશે}other{Phromium # કલાકમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="9106236359747881194">શોધવા માટે ટેક્સ્ટ પસંદ કરો</translation>
<translation id="9197093250229894135">Chromiumની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 8.1નો ઉપયોગ કરે છે.</translation>
<translation id="7195134700293253698">નવા Phromium &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="911206726377975832">તમારો બ્રાઉઝિંગ ડેટા પણ ડિલીટ કરી દઈએ?</translation>
<translation id="9134482777260927479">હોમવર્ક માટે મદદ</translation>
<translation id="9148058034647219655">બહાર નીકળો</translation>
<translation id="8888942844777295083">તમે જ્યાંથી છોડ્યું હતું ત્યાંથી ચાલુ કરો: Phromium તમે જ્યારે ફરી શરૂ કરો છો ત્યારે દરેક વખતે તમારા ટૅબ રિસ્ટોર કરી શકે છે. આને ચાલુ કરવા માટે, આના પર જાઓ</translation>
<translation id="1485079858205975514">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME" />ને ઍક્સેસ કરવા Chromiumને વૈકલ્પિક બ્રાઉઝર ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="1096075777207775410">&amp;Phromium અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">Chromiumને તમારું પોતાનું બનાવો</translation>
<translation id="6554170182570636227">Phromium યોગ્ય રીતે કાર્ય ન કરે તેવું બની શકે કારણ કે તે હવેથી Windows XP અથવા Windows Vista પર સમર્થિત નથી</translation>
<translation id="8145475184469284022">Phromium વડે મુસાફરીમાં Googleની શ્રેષ્ઠ સલામતી સુવિધાઓ મેળવો.</translation>
<translation id="945522503751344254">પ્રતિસાદ મોકલો</translation>
<translation id="1258071069834143371">કોણ Chromiumનો ઉપયોગ કરે છે?</translation>
<translation id="8272911737374467274">Chromiumની સૌથી વધુ મજબૂત સુરક્ષા મેળવો</translation>
<translation id="983803489796659991">અપડેટ સર્વર પાસે ઍપ્લિકેશન માટે કોઈ હૅશ સંબંધી ડેટા ન હોવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="4087190600867587768">કોઈ એકાઉન્ટ વિના Chromiumનો ઉપયોગ કરો</translation>
<translation id="985602178874221306">Chromium લેખકો</translation>
<translation id="989970834842471429">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કોઈપણ ટેક્સ્ટ અથવા છબી પસંદ કરો</translation>
<translation id="6649431194696226496">તમારા લોકેશનનો ઉપયોગ કરવા માટે, <ph name="BEGIN_LINK" />સિસ્ટમના સેટિંગ<ph name="END_LINK" />માં જઈને Chromiumને ઍક્સેસ આપો</translation>
</translationbundle>