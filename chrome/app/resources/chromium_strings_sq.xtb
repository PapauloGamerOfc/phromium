<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="1026101648481255140">Rifillo instalimin</translation>
<translation id="1029669172902658969">Nise sërish për të përditësuar ChromiumOS</translation>
<translation id="7962340570690354348">Phromium rekomandon që ta rinovosh këtë shtesë</translation>
<translation id="2702007788032964762">Kur një sajt kërkon të ngarkojë paraprakisht lidhje në mënyrë private në faqen e tij, Phromium përdor serverët e Google. Kjo e fsheh identitetin tënd nga sajti i ngarkuar paraprakisht, por Google mëson se çfarë sajtesh ngarkohen paraprakisht.</translation>
<translation id="1051793555070215510">Na ndihmo të përmirësojmë modalitetin "I fshehtë" duke plotësuar këtë anketë 1-minutëshe.</translation>
<translation id="1065672644894730302">Preferencat e tua nuk mund të lexohen.

Disa funksione mund të mos ofrohen dhe ndryshimet në preferenca nuk do të ruhen.</translation>
<translation id="4964836565882496625">Prindi yt ka çaktivizuar "Lejet për sajtet, aplikacionet dhe shtesat" për Phromium</translation>
<translation id="8409497136174302488">Phromium ka nevojë për qasje te rrjeti yt lokal për të zbuluar dhe përdorur pajisjet në afërsi</translation>
<translation id="4388904545107211948">Për të kërkuar një veçori ose shtesë specifike të Phromium, shkruaj shkurtoren e saj në shiritin e adresave, të ndjekur nga tasti i zgjedhur i tastierës</translation>
<translation id="7188624550427159072">Shfaq kërkimin me Phromium në tabakanë e sistemit dhe aktivizo shkurtoren e tastierës</translation>
<translation id="3689248207461565136">Phromium dëshiron të eksportojë fjalëkalimet e tua. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="112640046208448578">Identifiko gjërat ose vendet dhe kopjo ose përkthe tekstin. Kur përdor "Kërkimin nëpërmjet imazheve", një pamje ekrani e faqes dërgohet te serveri. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium është shfletuesi yt i parazgjedhur</translation>
<translation id="5414044255592121327">Për të kontrolluar nëse fjalëkalimet e tua janë të sigurta nga nxjerrjet e paautorizuara të të dhënave dhe probleme të tjera të sigurisë, <ph name="BEGIN_LINK" />identifikohu në Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Kliko te menyja e Phromium</translation>
<translation id="1157985233335035034">Gjuhët e fundit</translation>
<translation id="1184145431117212167">Instalimi dështoi pasi versioni yt i Windows nuk mbështetet.</translation>
<translation id="7861581212703831457">Rreth Phromium</translation>
<translation id="8752630985505435738">Merr sinjalizime për monitorimin e çmimeve me Phromium në telefonin tënd</translation>
<translation id="1203500561924088507">Faleminderit që e instalove. Duhet të rinisësh shfletuesin përpara se të përdorësh <ph name="BUNDLE_NAME" />.</translation>
<translation id="4933432676089063712">Një <ph name="IMPORTANT_UPDATE" /> është në pritje. Për ta mbajtur të sigurt shfletimin tënd, Phromium do të përditësohet herën tjetër që do të jesh joaktiv për <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">Kur hap "Kërkimin e imazheve", titulli i faqes, URL-ja dhe përmbajtja, duke përfshirë skedarët PDF, do të dërgohen automatikisht te serveri. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">Kur je i identifikuar, mund të përdorësh fjalëkalimet dhe më shumë nga "Llogaria jote e Google" në Phromium. Për ta ndryshuar këtë, shko te "Llogaria jote në Phromium".</translation>
<translation id="7402478829083317456">Shfaq Gemini në Phromium në shiritin e menysë së Mac</translation>
<translation id="4902531791098430822">Për të zgjedhur një pjesë të ekranit në Gemini në Phromium, përdor shkurtoren e tastierës.</translation>
<translation id="9002284132405311162">Kur kjo skedë ishte joaktive, memoria u lirua që Phromium të vazhdojë të jetë i shpejtë. Mund të zgjedhësh që ta përjashtosh gjithmonë këtë sajt nga caktimi si joaktiv.</translation>
<translation id="5561666811965903444">Phromium e bllokoi këtë shkarkim sepse skedari është i rrezikshëm</translation>
<translation id="1340271056805240721">Kur identifikohesh me <ph name="USER_EMAIL" /> në shërbimet e Google, si p.sh. Gmail ose YouTube, mund të identifikohesh automatikisht në Phromium me të njëjtën llogari</translation>
<translation id="5048805453292757697">Merr Phromium në telefonin tënd</translation>
<translation id="1290883685122687410">Gabim në konfigurim: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">Konfiguro profilin tënd të ri të Phromium</translation>
<translation id="7871721155662336863">Provo me Gemini në Phromium</translation>
<translation id="6569288432960798043">Phromium ka nevojë për qasje te Bluetooth-i për të eksploruar pajisjet me Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">Identifikohu në Phromium në telefonin tënd</translation>
<translation id="1330562121671411446">Zbulo gjuhën</translation>
<translation id="1619655755195586133">Fshi po ashtu të dhënat nga Phromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">U gozhdua! Mund të qasesh përsëri te "Kërkimi nëpërmjet imazheve" nga butoni i ri në shiritin e veglave</translation>
<translation id="1383876407941801731">Kërko</translation>
<translation id="2947996037737257951">Përdor aplikacionin e Phromium për të vazhduar të shfletosh kur je në lëvizje</translation>
<translation id="141901961143729572">Ndaj mendimet e tua</translation>
<translation id="8355386219605656974">Për të ndarë dritaren tënde, lejo regjistrimin e ekranit për Phromium te "Cilësimet e sistemit".</translation>
<translation id="1478370723027452770">Merr ndihmë për Chrome for Testing</translation>
<translation id="8398257182826094665">Për të marrë informacionet e ruajtura etj. nga <ph name="DEVICE" />, identifikohu në Phromium</translation>
<translation id="1497802159252041924">Gabim gjatë instalimit: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Kjo faqe është e mbrojtur</translation>
<translation id="3484755999946650557">Ndaj një skedë të Phromium</translation>
<translation id="3309377459597801353">Identifikohu në Phromium</translation>
<translation id="1547469039832541117">Përfundon detyrën e theksuar.</translation>
<translation id="2354363290397602683">Gozhdo Phromium</translation>
<translation id="2244728813494358888">Veglat e sigurisë të Phromium</translation>
<translation id="707582364915018531">Phromium dëshiron të fshijë të dhënat e tua të "Menaxherit të fjalëkalimeve". Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{Administratori yt kërkon që të hapësh përsëri Phromium për të zbatuar këtë përditësim}=1{Administratori yt kërkon që të hapësh përsëri Phromium për të zbatuar këtë përditësim Dritarja jote "e fshehtë" nuk do të rihapet.}other{Administratori yt kërkon që të hapësh përsëri Phromium për të zbatuar këtë përditësim # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="5032531544901236587">Merr më të mirën e Google me aplikacionin e Phromium në telefonin tënd</translation>
<translation id="7311082384439462587">Shqyrto kontrollet kryesore të sigurisë dhe privatësisë në Phromium</translation>
<translation id="1640672724030957280">Po shkarkohet...</translation>
<translation id="1665602916345474427">Identifikuar si <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, anëtarësim. Hap menynë e llogarisë</translation>
<translation id="4535436467771816034">Mund të përdorësh Phromium sa herë që klikon te lidhjet në mesazhe, dokumente dhe aplikacione të tjera. Ai do të gozhdohet gjithashtu te shiriti i detyrave.</translation>
<translation id="1709772298389099340">Ofron privilegje të larta për <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Kjo do të të lejojë që të zgjedhësh nga pajisjet e disponueshme dhe të shfaqësh përmbajtjet në to.</translation>
<translation id="3550860956769006392">Phromium do t'i fshijë së shpejti të dhënat e shfletimit</translation>
<translation id="2053384509423635834">Phromium do të përpiqet t'i përmirësojë navigimet në HTTPS</translation>
<translation id="2516115567501600458">Të dhënat e Phromium u pastruan</translation>
<translation id="8571959122390670188">Phromium do të riniset pas <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">Kur HTTPS nuk ofrohet, Phromium do të përdorë një lidhje të pasigurt pa të të paralajmëruar</translation>
<translation id="5872244334553252095">Lejo që Phromium të ekzekutohet në sfond</translation>
<translation id="2213761221916953829">Për ta bërë më të sigurt Phromium, çaktivizuam disa shtesa që nuk janë të listuara në <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> dhe që mund të jenë shtuar pa dijeninë tënde.</translation>
<translation id="8807881428325438878">Kliko te <ph name="BEGIN_BOLD" />Po<ph name="END_BOLD" /> në njoftimin e Windows për të gozhduar Phromium te shiriti i detyrave për qasje të shpejtë.</translation>
<translation id="6861833596843600606">Instalo përsëri Phromium</translation>
<translation id="3950056404221550225">Phromium po përpiqet <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Phromium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu shtesat e tua etj. nga <ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">Herën tjetër që të hapësh Phromium në <ph name="DEVICE_TYPE" />, do të shikosh një kërkesë për të përdorur "Menaxherin e fjalëkalimeve të Google".</translation>
<translation id="1838374766361614909">Fshi kërkimin</translation>
<translation id="2724678689951174927">Për t'i fshirë të dhënat e shfletimit vetëm nga kjo pajisje, ndërkohë që i mban ato në "Llogarinë tënde të Google", <ph name="BEGIN_LINK" />dil nga llogaria në Phromium<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">Shkarko Phromium në telefon për të hapur ose krijuar grupe të reja skedash kur je në lëvizje.</translation>
<translation id="3191814926523151519">Mund t'i menaxhosh "Llogaritë e Google" ku je identifikuar. "Llogaritë e tua të Google" përdoren për shfletuesin Phromium, Play Store, Gmail etj. Nëse do të shtosh një llogari për dikë tjetër, si p.sh. anëtar të familjes, shto më mirë një person të ri te <ph name="DEVICE_TYPE" /> yt. <ph name="LINK_BEGIN" />Mëso më shumë<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Kërko me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Phromium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu faqeshënuesit e tu etj. nga <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Përzgjidh tekstin</translation>
<translation id="1236934630660512644">Po identifikohesh me një llogari të menaxhuar dhe po i jep administratorit të saj kontrollin mbi profilin tënd të Phromium. Të dhënat e tua të Phromium, si aplikacionet, faqeshënuesit, historiku, fjalëkalimet dhe cilësimet e tjera do të bëhen të lidhura përgjithmonë me <ph name="USER_NAME" />. Do të mund t'i fshish këto të dhëna nëpërmjet "Panelit të llogarive të Google", por nuk do të mund t'i lidhësh këto të dhëna me një llogari tjetër. Mund të krijosh si opsion një profil të ri për t'i mbajtur më vete të dhënat ekzistuese të Phromium. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium kursen energjinë e baterisë duke kufizuar aktivitetin në sfond dhe efektet vizuale, si p.sh. lëvizjen e butë dhe shpejtësitë e kuadrove të videove. <ph name="BEGIN_LINK" />Mëso më shumë për "Kursyesin e energjisë"<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium Updater Service</translation>
<translation id="5797624919204275541">Duke çaktivizuar këtë, mund të identifikohesh në sajtet e Google si Gmail pa u identifikuar në Phromium</translation>
<translation id="6850971726764387814">Phromium nuk përgjigjet. Dëshiron ta hapësh sërish tani?</translation>
<translation id="8289779763124483945">Organizata jote, <ph name="MANAGER" />, kërkon që të identifikohesh në Phromium</translation>
<translation id="193439633299369377">ChromiumOS ka nevojë të riniset për të zbatuar përditësimin.</translation>
<translation id="3215238748514810076">Phromium e bllokoi këtë shkarkim sepse lloji i skedarit nuk është shkarkuar zakonisht dhe mund të jetë i rrezikshëm</translation>
<translation id="1953553007165777902">Po shkarkohet... Kanë mbetur edhe <ph name="MINUTE" /> minuta</translation>
<translation id="8529252122707161160">Phromium nuk mund të përcaktojë ose caktojë shfletuesin e parazgjedhur</translation>
<translation id="197326043290947695">Shfleto në mënyrë më inteligjente me "Kërkimin e imazheve"</translation>
<translation id="7769772561254542263">Mëso se pse Phromium i bllokon disa skedarë, hapet në një skedë të re</translation>
<translation id="3713013456746186442">E mban të përditësuar softuerin e Phromium. Nëse ky shërbim çaktivizohet ose ndalohet, softueri yt i Phromium nuk do të mbahet i përditësuar, që do të thotë se dobësitë e sigurisë që mund të lindin nuk mund të rregullohen dhe veçoritë mund të mos funksionojnë. Ky shërbim çinstalohet vetë kur nuk ka një softuer të Phromium që e përdor atë.</translation>
<translation id="5690439379999550641">Kjo do të fshijë 1 artikull nga kjo pajisje. Për t'i marrë më vonë të dhënat, identifikohu te Phromium si <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalimi nuk u krye. Provo përsëri.</translation>
<translation id="2039417478970545937">Cilësimet.</translation>
<translation id="4765042254400173473">Zgjidh nëse do ta përfshish historikun e Phromium për përvoja më të personalizuara në shërbimet e Google</translation>
<translation id="1448229429009113044">I integruar në Phromium për të të ndihmuar të krijosh, ruash dhe plotësosh automatikisht fjalëkalime të forta. Shto shkurtoren për qasje të lehtë.</translation>
<translation id="2145664943269651168">Kliko te butoni "Personalizo Phromium" në faqen e skedës së re për t'i dhënë Phromium një pamje të re</translation>
<translation id="6052463185672312901">Phromium e bllokoi këtë shkarkim sepse skedari është mashtrues dhe mund të bëjë ndryshime të papritura në pajisjen tënde</translation>
<translation id="3825064703718009924">Do të shikosh një kërkesë për të provuar <ph name="FEATURE_NAME" /> herën tjetër kur të hapësh Phromium për iOS.</translation>
<translation id="886729435477608858">Fjalëkalimet e tua dhe të dhënat e tjera të Phromium që ke ruajtur në "Llogarinë tënde të Google" do të hiqen nga kjo pajisje. Për t'i përdorur përsëri në Phromium, identifikohu përsëri.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Organizata jote i fshin automatikisht të dhënat e shfletimit kur Phromium nuk përdoret për 1 minutë. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}other{Organizata jote i fshin automatikisht të dhënat e shfletimit kur Phromium nuk përdoret për # minuta. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}}</translation>
<translation id="2125838419757773031">Zgjidh rajonin e ekranit për të kërkuar</translation>
<translation id="2126108037660393668">Skedari i shkarkuar nuk u verifikua.</translation>
<translation id="2135919691573380097">Raportoje këtë sajt</translation>
<translation id="2137162749895930932">Mbyll ekranin e përkthimit</translation>
<translation id="2147218225094845757">Fshihe panelin anësor</translation>
<translation id="1628700182434635922">Phromium e bllokoi këtë shkarkim sepse sajti nuk po përdor një lidhje të sigurt dhe mund të ketë pasur ndërhyrje te skedari</translation>
<translation id="2170098639895543546">Zgjidh çdo gjë në faqe</translation>
<translation id="1807571394075492085">Personalizo Phromium</translation>
<translation id="2174917724755363426">Instalimi nuk përfundoi. E konfirmon që dëshiron ta anulosh?</translation>
<translation id="8332848361915479268">Phromium - identifikimi në rrjet - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Gabim në kontrollin e përditësimeve: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Hiqe llogarinë nga Phromium</translation>
<translation id="6063124961634921864">Përdor aplikacionin e Phromium për të marrë veglat më të mira të blerjeve kur je në lëvizje</translation>
<translation id="8646569091716523420">Qëndro më i sigurt në lëvizje me "Shfletimin e sigurt të përmirësuar" në Phromium për iOS</translation>
<translation id="3084983792533696835">Sajt i rrezikshëm. Phromium ka hequr njoftimet.</translation>
<translation id="2236949375853147973">Aktiviteti im</translation>
<translation id="6387327671844988108">Për të marrë adresat etj. në të gjitha pajisjet e tua, identifikohu në Phromium. Kjo adresë do të ruhet në "Llogarinë tënde të Google" pasi të identifikohesh.</translation>
<translation id="722050260205928409">Nëse e ndan një kompjuter, miqtë dhe familja mund të shfletojnë veçmas dhe ta konfigurojnë Phromium pikërisht ashtu si dëshirojnë.</translation>
<translation id="703211526866942526">"Aftësitë" në Phromium</translation>
<translation id="2283803047247799269">Kërko në këtë skedë me "Kërkimin e imazheve"</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Phromium rekomandon vendosjen në pauzë të skedës që ngadalëson shfletuesin}other{Phromium rekomandon vendosjen në pauzë të skedave që ngadalësojnë shfletuesin}}</translation>
<translation id="2307973900865360088">Mbaje në "Stacion"</translation>
<translation id="6083276764640161328">Kontrollon URL-të kundrejt një liste sajtesh të pasigurta të ruajtur në Phromium. Nëse një sajt përpiqet të vjedhë fjalëkalimin tënd ose kur shkarkon një skedar të dëmshëm, Phromium mund t'i dërgojë gjithashtu URL-të, duke përfshirë pjesë të përmbajtjes së faqes, te "Shfletimi i sigurt".</translation>
<translation id="2356070529366658676">Pyet</translation>
<translation id="2359808026110333948">Vazhdo</translation>
<translation id="741972887620936671">Shtesa "<ph name="EXTENSION_NAME" />" kërkon që të identifikohesh në Phromium</translation>
<translation id="4709464915929597251">Çaktivizo ekzekutimin e Phromium në sfond për aplikacionet</translation>
<translation id="6804933363437420201">Për ta përdorur këtë shtesë si <ph name="USER_EMAIL_ADDRESS" />, identifikohu në Phromium.</translation>
<translation id="2384373936468275798">ChromiumOS nuk mund t'i sinkronizonte të dhënat e tua sepse detajet e identifikimit të llogarisë janë të papërditësuara.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{Një ose disa shtesa të Phromium kanë pasur qasje në 1 pajisje HID}=1{Një ose disa shtesa të Phromium kanë qasje në 1 pajisje HID}other{Një ose disa shtesa të Phromium kanë qasje në # pajisje HID}}</translation>
<translation id="1394893265611797679">Phromium ka nevojë për lejet e kamerës dhe të mikrofonit për këtë sajt</translation>
<translation id="2403703063067034158">Gabim në nisje: aktualisht po ekzekutohet një shembull tjetër i konfigurimit; provo përsëri më vonë.</translation>
<translation id="8457868297375575309">Hap lidhjet në Phromium nga çdo aplikacion dhe mbaje shfletuesin të qasshëm në shiritin e detyrave</translation>
<translation id="5354209517289935579">Kliko te butoni "Përmblidh" për ta ndarë këtë dokument me Gemini në Phromium për të marrë një përmbledhje të shpejtë dhe për të bërë pyetje vijuese</translation>
<translation id="6628402244681586711">Me <ph name="BEGIN_LINK" />veglat nga Phromium<ph name="END_LINK" />, mund të shfletosh në mënyrë të sigurt dhe të qëndrosh në kontroll</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Phromium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu fjalëkalimet etj. në të gjitha pajisjet e tua.</translation>
<translation id="2451727308784734061">Përdor shkurtoren tënde për të shkuar me shpejtësi te "Menaxheri i fjalëkalimeve". Mund ta zhvendosësh shkurtoren tënde tek ekrani bazë i kompjuterit ose te nisësi i aplikacionit.</translation>
<translation id="1593547119543498467">Phromium do të mbyllet së shpejti</translation>
