<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="as">
<translation id="1026101648481255140">ইনষ্টল কৰাটো পুনৰ আৰম্ভ কৰক</translation>
<translation id="1029669172902658969">&amp;ChromiumOS আপডে’ট কৰিবলৈ পুনৰ লঞ্চ কৰক</translation>
<translation id="7962340570690354348">Chromiumএ আপোনাক এই এক্সটেনশ্বনটো পৰ্যালোচনা কৰিবলৈ চুপাৰিছ কৰে</translation>
<translation id="2702007788032964762">কোনো ছাইটে নিজৰ পৃষ্ঠাত থকা লিংকসমূহ ব্যক্তিগতভাৱে আগতীয়াকৈ ল’ড কৰিবলৈ বিচাৰিলে, Chromiumএ Googleৰ ছাৰ্ভাৰসমূহ ব্যৱহাৰ কৰে। এইটোৱে আগতীয়াকৈ ল’ড কৰা ছাইটৰ পৰা আপোনাৰ পৰিচয় লুকুৱায়, কিন্তু কোনবোৰ ছাইট আগতীয়াকৈ ল’ড হয় সেয়া Googleএ জানি লয়।</translation>
<translation id="1051793555070215510">এই ১ মিনিটৰ সমীক্ষাটোত ভাগ লৈ ইনক’গনিট’ উন্নত কৰাত আমাক সহায় কৰক।</translation>
<translation id="1065672644894730302">আপোনাৰ অগ্ৰাধিকাৰসমূহ পঢ়িব নোৱাৰি।

কিছুমান সুবিধা উপলব্ধ নহ'ব পাৰে আৰু অগ্ৰাধিকাৰসমূহত কৰা সলনি কার্য ছেভ নহ'ব পাৰে।</translation>
<translation id="4964836565882496625">আপোনাৰ অভিভাৱকে Chromiumত "ছাইট, এপ্ আৰু এক্সটেনশ্বনসমূহৰ বাবে অনুমতি" অফ কৰিছে</translation>
<translation id="8409497136174302488">নিকটৱৰ্তী ডিভাইচসমূহ বিচাৰি পাবলৈ আৰু ব্যৱহাৰ কৰিবলৈ Chromiumক আপোনাৰ স্থানীয় নেটৱৰ্কৰ এক্সেছৰ প্ৰয়োজন</translation>
<translation id="4388904545107211948">Chromiumৰ কোনো নিৰ্দিষ্ট সুবিধা বা এক্সটেনশ্বন সন্ধান কৰিবলৈ, ঠিকনাৰ বাৰত ইয়াৰ শ্বৰ্টকাটটো টাইপ কৰি তাৰ পাছত আপুনি বাছনি কৰা কীব’ৰ্ডৰ কীটো টিপক</translation>
<translation id="7188624550427159072">ছিষ্টেমৰ ট্ৰে’ত Chromiumৰ জৰিয়তে সন্ধান কৰাৰ বিকল্পটো দেখুৱাওক আৰু কীব’ৰ্ডৰ শ্বৰ্টকাট অন কৰক</translation>
<translation id="3689248207461565136">Chromiumএ আপোনাৰ পাছৱর্ডসমূহ ৰপ্তানি কৰিব খোজে। ইয়াৰ অনুমতি আপোনাৰ দিবলৈ Windows পাছৱৰ্ড টাইপ কৰক।</translation>
<translation id="112640046208448578">বস্তু বা স্থান চিনাক্ত কৰক আৰু পাঠ প্ৰতিলিপি বা অনুবাদ কৰক। আপুনি প্ৰতিচ্ছবিৰ সন্ধান সুবিধাটো ব্যৱহাৰ কৰিলে, পৃষ্ঠাখনৰ এটা স্ক্ৰীনশ্বট ছাৰ্ভাৰলৈ প্ৰেৰণ কৰা হয়। <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium হৈছে আপোনাৰ ডিফ’ল্ট ব্ৰাউজাৰ</translation>
<translation id="5414044255592121327">আপোনাৰ পাছৱৰ্ডসমূহ ডেটা উলংঘন আৰু আন সুৰক্ষা সম্পৰ্কীয় সমস্যাৰ পৰা নিৰাপদে আছেনে নাই পৰীক্ষা কৰিবলৈ <ph name="BEGIN_LINK" />Chromiumত ছাইন ইন কৰক<ph name="END_LINK" />।</translation>
<translation id="1753507755668601921">Chromiumৰ মেনুত ক্লিক কৰক</translation>
<translation id="1157985233335035034">শেহতীয়া ভাষা</translation>
<translation id="1184145431117212167">ইনষ্টল কৰিব পৰা নগ’ল কাৰণ আপোনাৰ Windowsৰ সংস্কৰণটো সমৰ্থিত নহয়।</translation>
<translation id="7861581212703831457">Chromiumৰ বিষয়ে</translation>
<translation id="8752630985505435738">আপোনাৰ ফ’নত Chromiumৰ জৰিয়তে মূল্য ট্ৰেকিঙৰ সতৰ্কবাৰ্তা পাওক</translation>
<translation id="1203500561924088507">ইনষ্টল কৰাৰ বাবে ধন্যবাদ। আপুনি <ph name="BUNDLE_NAME" /> ব্যৱহাৰ কৰাৰ পূৰ্বে আপোনাৰ ব্ৰাউজাৰটো ৰিষ্টাৰ্ট কৰিবই লাগিব।</translation>
<translation id="4933432676089063712">এটা <ph name="IMPORTANT_UPDATE" /> বাকী আছে। আপোনাৰ ব্ৰাউজিং সুৰক্ষিত কৰি ৰাখিবলৈ, আপুনি <ph name="IDLE_DURATION" />ৰ বাবে নিষ্ক্ৰিয় হৈ থাকিলে Phromium আপডে’ট হ’ব।</translation>
<translation id="1232234696885483911">আপুনি প্ৰতিচ্ছবিৰ সন্ধান খুলিলে, PDFসমূহকে ধৰি পৃষ্ঠাখনৰ শিৰোনাম, URL আৰু সমল স্বয়ংক্ৰিয়ভাৱে ছাৰ্ভাৰলৈ পঠিওৱা হ’ব। <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">আপুনি ছাইন ইন হৈ থকাৰ সময়ত, আপুনি Chromiumত আপোনাৰ Google একাউণ্টৰ পৰা আপোনাৰ পাছৱৰ্ড আৰু অধিক ব্যৱহাৰ কৰিব পাৰে। এইটো সলনি কৰিবলৈ, “Chromiumত আপোনাৰ একাউণ্ট”লৈ যাওক।</translation>
<translation id="7402478829083317456">Macৰ মেনু বাৰত Chromiumত Gemini দেখুৱাওক</translation>
<translation id="4902531791098430822">Chromiumত Geminiত স্ক্ৰীনৰ অংশ বাছনি কৰিবলৈ, কীব’ৰ্ডৰ শ্বৰ্টকাট ব্যৱহাৰ কৰক।</translation>
<translation id="9002284132405311162">এই টেবটো নিষ্ক্ৰিয় হৈ থকাৰ সময়ত, Phromium দ্ৰুত কৰি ৰাখিবলৈ মেম’ৰী খালী কৰা হৈছে। আপুনি এই ছাইটটো নিষ্ক্ৰিয় হোৱাৰ পৰা সদায় বাদ দিয়াটো বাছনি কৰিব পাৰে।</translation>
<translation id="5561666811965903444">ফাইলটো বিপজ্জনক হোৱাৰ বাবে Chromiumএ এই ডাউনল’ডটো অৱৰোধ কৰিছে</translation>
<translation id="1340271056805240721"><ph name="USER_EMAIL" />ৰ জৰিয়তে Gmail বা Youtubeৰ দৰে Google সেৱাসমূহত ছাইন ইন কৰাৰ সময়ত, আপুনি একেটা একাউণ্ট ব্যৱহাৰ কৰি স্বয়ংক্ৰিয়ভাৱে Chromiumত ছাইন ইন কৰিব পাৰে</translation>
