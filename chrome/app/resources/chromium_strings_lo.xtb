<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="1026101648481255140">ສືບຕໍ່ການຕິດຕັ້ງ</translation>
<translation id="1029669172902658969">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;ChromiumOS</translation>
<translation id="7962340570690354348">Phromium ຂໍແນະນຳໃຫ້ທ່ານກວດສອບສ່ວນຂະຫຍາຍນີ້</translation>
<translation id="2702007788032964762">ເມື່ອເວັບໄຊຂໍໂຫຼດລິ້ງຢູ່ໜ້າເວັບຂອງເຂົາເຈົ້າໄວ້ກ່ອນລ່ວງໜ້າແບບສ່ວນຕົວ, Phromium ຈະໃຊ້ເຊີບເວີຂອງ Google. ການດຳເນີນການນີ້ຈະເຊື່ອງຕົວຕົນຂອງທ່ານຈາກເວັບໄຊທີ່ໂຫຼດກ່ອນລ່ວງໜ້າ, ແຕ່ Google ຈະສຶກສາວ່າເວັບໄຊໃດໄດ້ຮັບການໂຫຼດກ່ອນລ່ວງໜ້າ.</translation>
<translation id="1051793555070215510">ຊ່ວຍພວກເຮົາປັບປຸງໂໝດບໍ່ເປີດເຜີຍຕົວຕົນໂດຍເຮັດແບບສຳຫຼວດ 1 ນາທີນີ້.</translation>
<translation id="1065672644894730302">ບໍ່ສາມາດອ່ານຄວາມມັກຂອງທ່ານໄດ້.

ບາງຄຸນສົມບັດ​ອາດຈະບໍ່ມີໃຫ້ ແລະການປ່ຽນແປງຕໍ່ຄວາມມັກຈະບໍ່ຖືກບັນທຶກ.</translation>
<translation id="4964836565882496625">ພໍ່ແມ່ຂອງທ່ານໄດ້ປິດ "ການອະນຸຍາດສຳລັບເວັບໄຊ, ແອັບ ແລະ ສ່ວນຂະຫຍາຍ" ສຳລັບ Phromium ແລ້ວ</translation>
<translation id="8409497136174302488">Phromium ຕ້ອງການສິດເຂົ້າເຖິງເຄືອຂ່າຍທ້ອງຖິ່ນຂອງທ່ານເພື່ອຄົ້ນພົບ ແລະ ໃຊ້ອຸປະກອນທີ່ຢູ່ໃກ້ຄຽງ</translation>
<translation id="4388904545107211948">ເພື່ອຊອກຫາຄຸນສົມບັດ ຫຼື ສ່ວນຂະຫຍາຍທີ່ສະເພາະຂອງ Phromium, ໃຫ້ພິມທາງລັດຂອງຄຸນສົມບັດ ຫຼື ສ່ວນຂະຫຍາຍໃສ່ໃນແຖບທີ່ຢູ່, ຕາມດ້ວຍປຸ່ມແປ້ນພິມທີ່ທ່ານເລືອກໄວ້</translation>
<translation id="7188624550427159072">ສະແດງການຊອກຫາດ້ວຍ Phromium ໃນຖາດລະບົບ ແລະ ເປີດຄີລັດ</translation>
<translation id="3689248207461565136">Phromium ຕ້ອງການສົ່ງອອກລະຫັດຜ່ານຂອງທ່ານ. ກະລຸນາພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="112640046208448578">ລະບຸສິ່ງຂອງ ຫຼື ສະຖານທີ່ ແລ້ວສຳເນົາ ຫຼື ແປຂໍ້ຄວາມ. ເມື່ອທ່ານໃຊ້ການຊອກຫາຮູບ, ລະບົບຈະສົ່ງຮູບໜ້າຈໍຂອງໜ້າເວັບໄປໃຫ້ເຊີບເວີ. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="5414044255592121327">ເພື່ອກວດເບິ່ງວ່າລະຫັດຜ່ານຂອງທ່ານປອດໄພຈາກການລະເມີດຂໍ້ມູນ ແລະ ບັນຫາຄວາມປອດໄພອື່ນຫຼືບໍ່, ກະລຸນາ <ph name="BEGIN_LINK" />ເຂົ້າສູ່ລະບົບ Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">ຄລິກເມນູ Phromium</translation>
<translation id="1157985233335035034">ພາສາຫຼ້າສຸດ</translation>
<translation id="1184145431117212167">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກລະບົບບໍ່ຮອງຮັບ Windows ເວີຊັນທີ່ທ່ານໃຊ້.</translation>
<translation id="7861581212703831457">ກ່ຽວ​ກັບ Phromium</translation>
<translation id="8752630985505435738">ຮັບການແຈ້ງເຕືອນການຕິດຕາມລາຄາດ້ວຍ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1203500561924088507">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດໂປຣແກຣມທ່ອງເວັບຂອງທ່ານກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="4933432676089063712">ມີ <ph name="IMPORTANT_UPDATE" /> ລໍຖ້າດຳເນີນການຢູ່. ເພື່ອໃຫ້ການທ່ອງເວັບຂອງທ່ານປອດໄພ, Phromium ຈະອັບເດດໃນເທື່ອຕໍ່ໄປທີ່ທ່ານບໍ່ໄດ້ນຳໃຊ້ເປັນເວລາ <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">ເມື່ອທ່ານເປີດການຊອກຫາຮູບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີໂດຍອັດຕະໂນມັດ. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">ໃນລະຫວ່າງທີ່ທ່ານເຂົ້າສູ່ລະບົບ, ທ່ານສາມາດໃຊ້ລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກບັນຊີ Google ຂອງທ່ານໃນ Phromium ໄດ້. ເພື່ອປ່ຽນສິ່ງນີ້, ໃຫ້ເຂົ້າໄປ “ບັນຊີຂອງທ່ານໃນ Phromium”.</translation>
<translation id="7402478829083317456">ສະແດງ Gemini ໃນ Phromium ໃນແຖບເມນູຂອງ Mac</translation>
<translation id="4902531791098430822">ເພື່ອເລືອກພາກສ່ວນໜຶ່ງຂອງໜ້າຈໍໃນ Gemini ໃນ Phromium, ໃຫ້ໃຊ້ຄີລັດ.</translation>
<translation id="9002284132405311162">ໃນຂະນະທີ່ແຖບນີ້ບໍ່ມີການນຳໃຊ້, ລະບົບຈະເພີ່ມພື້ນທີ່ຫວ່າງໃນໜ່ວຍຄວາມຈຳເພື່ອໃຫ້ໃຊ້ Phromium ໄດ້ຢ່າງວ່ອງໄວຢູ່ຕະຫຼອດ. ທ່ານສາມາດເລືອກຍົກເວັ້ນໃຫ້ເວັບໄຊນີ້ເຮັດວຽກຕະຫຼອດເວລາໄດ້.</translation>
<translation id="5561666811965903444">Phromium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ເປັນອັນຕະລາຍ</translation>
<translation id="1340271056805240721">ເມື່ອເຂົ້າສູ່ລະບົບບໍລິການຕ່າງໆຂອງ Google ເຊັ່ນ: Gmail ຫຼື YouTube ດ້ວຍ <ph name="USER_EMAIL" />, ທ່ານສາມາດເຂົ້າສູ່ລະບົບ Phromium ດ້ວຍບັນຊີດຽວກັນໄດ້ໂດຍອັດຕະໂນມັດ</translation>
<translation id="5048805453292757697">ດາວໂຫຼດ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1290883685122687410">ຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">ຕັ້ງຄ່າໂປຣໄຟລ໌ Phromium ໃໝ່ຂອງທ່ານ</translation>
<translation id="7871721155662336863">ລອງໃຊ້ Gemini ໃນ Phromium</translation>
<translation id="6569288432960798043">Phromium ຕ້ອງການສິດເຂົ້າເຖິງ Bluetooth ເພື່ອສຳຫຼວດ
 ອຸປະກອນ Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">ເຂົ້າສູ່ລະບົບ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1330562121671411446">ກວດຫາພາສາ</translation>
<translation id="1619655755195586133">ລຶບຂໍ້ມູນອອກຈາກ Phromium (<ph name="URL" />) ນຳ</translation>
<translation id="1345251407431278948">ປັກໝຸດແລ້ວ! ທ່ານສາມາດເຂົ້າເຖິງການຊອກຫາຮູບໄດ້ອີກຄັ້ງຈາກປຸ່ມໃໝ່ໃນແຖບເຄື່ອງມື</translation>
<translation id="1383876407941801731">ຊອກຫາ</translation>
<translation id="2947996037737257951">ໃຊ້ແອັບ Phromium ເພື່ອທ່ອງເວັບໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="141901961143729572">ແບ່ງປັນຄວາມຄິດຂອງທ່ານ</translation>
<translation id="8355386219605656974">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ Phromium ໃນການຕັ້ງຄ່າລະບົບ.</translation>
<translation id="1478370723027452770">ຮັບຄວາມຊ່ວຍເຫຼືອກ່ຽວກັບ Chrome ສຳລັບການທົດສອບ</translation>
<translation id="8398257182826094665">ເພື່ອເຂົ້າເຖິງຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="1497802159252041924">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">ໜ້ານີ້ໄດ້ຮັບການປ້ອງກັນ</translation>
<translation id="3484755999946650557">ແບ່ງປັນແຖບ Phromium</translation>
<translation id="3309377459597801353">ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="1547469039832541117">ສິ້ນສຸດໜ້າວຽກທີ່ໄຮໄລ້.</translation>
<translation id="2354363290397602683">ປັກໝຸດ Phromium</translation>
<translation id="2244728813494358888">ເຄື່ອງມືຄວາມປອດໄພຂອງ Phromium</translation>
<translation id="707582364915018531">Phromium ຕ້ອງການລຶບຂໍ້ມູນຕົວຈັດການລະຫັດຜ່ານຂອງທ່ານ. ກະລຸນາພິມລະຫັດຜ່ານ Windows ຂອງທ່ານເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Phromium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ}=1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Phromium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Phromium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="5032531544901236587">ຮັບປະໂຫຍດສູງສຸດຈາກ Google ດ້ວຍແອັບ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="7311082384439462587">ກວດສອບການຄວບຄຸມຄວາມເປັນສ່ວນຕົວ ແລະ ຄວາມປອດໄພຫຼັກໃນ Phromium</translation>
<translation id="1640672724030957280">ກຳລັງດາວໂຫຼດ...</translation>
<translation id="1665602916345474427">ເຂົ້າສູ່ລະບົບໃນຊື່ <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, ສະມາຊິກ. ເປີດເມນູບັນຊີ</translation>
<translation id="4535436467771816034">ທ່ານສາມາດໃຊ້ Phromium ໄດ້ທຸກເທື່ອທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ. ນອກຈາກນີ້, ລະບົບຍັງຈະປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານນຳ.</translation>
<translation id="1709772298389099340">ໃຫ້ສິດທິພິເສດລະດັບສູງສຳລັບ <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">ວິທີນີ້ຈະຊ່ວຍໃຫ້ທ່ານສາມາດເລືອກຈາກອຸປະກອນທີ່ພ້ອມນຳໃຊ້ ແລະ ສະແດງເນື້ອຫາຢູ່ອຸປະກອນເຫຼົ່ານັ້ນ.</translation>
<translation id="3550860956769006392">Phromium ຈະລຶບຂໍ້ມູນການທ່ອງເວັບໃນໄວໆນີ້</translation>
<translation id="2053384509423635834">Phromium ຈະພະຍາຍາມອັບເກຣດການນຳທາງເປັນ HTTPS</translation>
<translation id="2516115567501600458">ລຶບລ້າງຂໍ້ມູນ Phromium ແລ້ວ</translation>
<translation id="8571959122390670188">Phromium ຈະຣີສະຕາດໃນ <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">ເມື່ອບໍ່ສາມາດໃຊ້ HTTPS ໄດ້, Phromium ຈະໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພໂດຍບໍ່ເຕືອນທ່ານ</translation>
<translation id="5872244334553252095">ປ່ອຍໃຫ້ Phromium ແລ່ນຢູ່ໃນພື້ນຫຼັງ</translation>
<translation id="2213761221916953829">ເພື່ອເຮັດໃຫ້ Phromium ປອດໄພຂຶ້ນ, ພວກເຮົາປິດໃຊ້ງານບາງສ່ວນຂະຫຍາຍທີ່ບໍ່ໄດ້ມີລາຍຊື່ຢູ່ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ແລະອາດຈະຖືກເພີ່ມເຂົ້າໂດຍທີ່ທ່ານບໍ່ຮູ້ຈັກ.</translation>
<translation id="8807881428325438878">ຄລິກ <ph name="BEGIN_BOLD" />ແມ່ນ<ph name="END_BOLD" /> ໃນການແຈ້ງເຕືອນ Windows ເພື່ອປັກໝຸດ Phromium ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອການເຂົ້າເຖິງດ່ວນ.</translation>
<translation id="6861833596843600606">ຕິດຕັ້ງ Phromium ຄືນໃໝ່</translation>
<translation id="3950056404221550225">Phromium ກຳລັງພະຍາຍາມໃຊ້ <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບສ່ວນຂະຫຍາຍ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="6114726049187747242">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ໃຊ້ຕົວຈັດການລະຫັດຜ່ານ Google.</translation>
<translation id="1838374766361614909">ລຶບ​ການ​ຊອກ​ຫາ</translation>
<translation id="2724678689951174927">ເພື່ອລຶບຂໍ້ມູນການທ່ອງເວັບໃນອຸປະກອນນີ້ເທົ່ານັ້ນ, ແຕ່ຍັງຮັກສາຂໍ້ມູນດັ່ງກ່າວໄວ້ໃນບັນຊີ Google ຂອງທ່ານ, ໃຫ້ <ph name="BEGIN_LINK" />ອອກຈາກລະບົບ Phromium<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">ດາວໂຫຼດ Phromium ຢູ່ໂທລະສັບຂອງທ່ານເພື່ອເປີດ ຫຼື ສ້າງກຸ່ມແຖບໃໝ່ໄດ້ທຸກບ່ອນທຸກເວລາ.</translation>
<translation id="3191814926523151519">ທ່ານສາມາດຈັດການບັນຊີ Google ທີ່ເຂົ້າສູ່ລະບົບແລ້ວຂອງທ່ານໄດ້. ບັນຊີ Google ຂອງທ່ານແມ່ນໃຊ້ສຳລັບໂປຣແກຣມທ່ອງເວັບ Phromium, Play Store, Gmail ແລະ ອື່ນໆ. ຫາກທ່ານຕ້ອງການເພີ່ມບັນຊີໃຫ້ຄົນອື່ນ ເຊັ່ນ: ສະມາຊິກຄອບຄົວ, ໃຫ້ເພີ່ມຄົນໃໝ່ໃສ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານແທນ. <ph name="LINK_BEGIN" />ສຶກສາເພີ່ມເຕີມ<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="1880677175115548835">ເລືອກຂໍ້ຄວາມ</translation>
<translation id="1236934630660512644">ທ່ານກໍາລັງລົງຊື່ເຂົ້າ​ໃຊ້ດ້ວຍບັນຊີຄຸ້ມຄອງ ແລະໃຫ້ຜູ້ຄວບຄຸມຂອງມັນຄວບຄຸມໂປຣໄຟລ໌ Phromium ຂອງທ່ານ. ຂໍ້ມູນ Phromium ຂອງທ່ານ, ເຊັ່ນ: ແອັບ, ບຸກມາກສ໌, ປະຫວັດ, ລະຫັດຜ່ານ, ແລະການຕັ້ງຄ່າອື່ນໆຂອງທ່ານຈະຜູກ​ມັດ​ກັບ <ph name="USER_NAME" /> ຢ່າງຖາວອນ. ທ່ານຈະສາມາດລຶບຂໍ້ມູນນີ້ໄດ້ຜ່ານ Google Accounts Dashboard, ແຕ່ທ່ານຈະບໍ່ສາມາດເອົາຂໍ້ມູນນີ້ເຂົ້າຮ່ວມກັບບັນຊີອື່ນໄດ້. ​ໂດຍ​ເລືອກ​ໄດ້ ທ່ານ​ສາມາດ​ສ້າງໂປຣໄຟລ໌​ໃໝ່​ເພື່ອ​ຮັກສາ​ຂໍ້ມູນ Phromium ທີ່​ມີ​ຢູ່​ຂອງ​ທ່ານ​ແຍກ​ຕ່າງຫາກ. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium ຈະຊ່ວຍປະຢັດພະລັງງານແບັດເຕີຣີໂດຍການຈຳກັດກິດຈະກຳຢູ່ພື້ນຫຼັງ ແລະ ເອັບເຟັກພາບ ເຊັ່ນ: ການເລື່ອນທີ່ນຸ້ມນວນ ແລະ ອັດຕາເຟຣມວິດີໂອ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບຕົວປະຢັດພະລັງງານ<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">ບໍລິການ Phromium Updater</translation>
<translation id="5797624919204275541">ໂດຍການປິດສິ່ງນີ້, ທ່ານສາມາດເຂົ້າສູ່ລະບົບເວັບໄຊຂອງ Google ເຊັ່ນ: Gmail ໄດ້ໂດຍບໍ່ຕ້ອງເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="6850971726764387814">Phromium ບໍ່ຕອບຮັບ. ເລີ່ມເປີດໃຊ້ໃໝ່ດຽວນີ້ບໍ?</translation>
<translation id="8289779763124483945">ອົງກອນຂອງທ່ານ, <ph name="MANAGER" />, ກຳນົດໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="193439633299369377">ຈຳເປັນຕ້ອງຣີສະຕາດ ChromiumOS ເພື່ອນຳໃຊ້ການອັບເດດ.</translation>
<translation id="3215238748514810076">Phromium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ປະເພດນີ້ບໍ່ໄດ້ມີການດາວໂຫຼດໂດຍທົ່ວໄປ ແລະ ອາດເປັນອັນຕະລາຍ</translation>
<translation id="1953553007165777902">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="MINUTE" /> ນາທີ</translation>
<translation id="8529252122707161160">Phromium ບໍ່ສາມາດກຳນົດ ຫຼື ຕັ້ງໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້</translation>
<translation id="197326043290947695">ທ່ອງເວັບຢ່າງອັດສະລິຍະຂຶ້ນດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="7769772561254542263">ສຶກສາວ່າເປັນຫຍັງ Phromium ຈຶ່ງບລັອກບາງໄຟລ໌, ເປີດໃນແຖບໃໝ່</translation>
<translation id="3713013456746186442">ກະລຸນາອັບເດດຊອບແວ Phromium ໃຫ້ເປັນເວີຊັນຫຼ້າສຸດຢູ່ສະເໝີ. ຫາກປິດການນຳໃຊ້ ຫຼື ຢຸດບໍລິການນີ້, ຊອບແວ Phromium ຂອງທ່ານຈະບໍ່ໄດ້ຮັບການອັບເດດ, ເຊິ່ງໝາຍຄວາມວ່າຊ່ອງຫວ່າງດ້ານຄວາມປອດໄພທີ່ອາດເກີດຂຶ້ນຈະບໍ່ສາມາດແກ້ໄຂໄດ້ ແລະ ຄຸນສົມບັດອາດບໍ່ເຮັດວຽກ. ບໍລິການນີ້ຈະຖອນການຕິດຕັ້ງຕົວເອງເມື່ອບໍ່ມີຊອບແວ Phromium ນຳໃຊ້ຢູ່.</translation>
<translation id="5690439379999550641">ນີ້ຈະລຶບ 1 ລາຍການອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Phromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ການຕິດຕັ້ງບໍ່ສຳເລັດ. ກະລຸນາລອງໃໝ່.</translation>
<translation id="2039417478970545937">ການຕັ້ງຄ່າ.</translation>
<translation id="4765042254400173473">ເລືອກວ່າຈະໃຫ້ຮວມປະຫວັດ Phromium ສຳລັບປະສົບການທີ່ປັບແຕ່ງສ່ວນຕົວໃນບໍລິການ Google ຫຼືບໍ່</translation>
<translation id="1448229429009113044">ຕິດຕັ້ງມາໃນ Phromium ເພື່ອຊ່ວຍທ່ານສ້າງ, ບັນທຶກ ແລະ ຕື່ມຂໍ້ມູນລະຫັດຜ່ານຍາກໂດຍອັດຕະໂນມັດ. ເພີ່ມທາງລັດເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ.</translation>
<translation id="2145664943269651168">ຄລິກປຸ່ມປັບແຕ່ງ Phromium ຢູ່ໜ້າແຖບໃໝ່ເພື່ອໃຫ້ Phromium ມີຮູບລັກໃໝ່</translation>
<translation id="6052463185672312901">Phromium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ມີການຫຼອກລວງ ແລະ ອາດເຮັດການປ່ຽນແປງທີ່ບໍ່ຄາດຄິດກັບອຸປະກອນຂອງທ່ານ</translation>
<translation id="3825064703718009924">ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ລອງໃຊ້ <ph name="FEATURE_NAME" /> ໃນເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ Phromium ຢູ່ iOS.</translation>
<translation id="886729435477608858">ລະບົບຈະລຶບລະຫັດຜ່ານຂອງທ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງ Phromium ທີ່ທ່ານບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອໃຊ້ຂໍ້ມູນເຫຼົ່ານີ້ໃນ Phromium, ໃຫ້ເຂົ້າສູ່ລະບົບອີກຄັ້ງ.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະລຶບຂໍ້ມູນການທ່ອງເວັບອອກໂດຍອັດຕະໂນມັດເມື່ອບໍ່ໄດ້ໃຊ້ Phromium ເປັນເວລາ 1 ນາທີ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ. ແຖບຂອງທ່ານຈະຍັງເປີດຢູ່.}other{ອົງກອນຂອງທ່ານຈະລຶບຂໍ້ມູນການທ່ອງເວັບອອກໂດຍອັດຕະໂນມັດເມື່ອບໍ່ໄດ້ໃຊ້ Phromium ເປັນເວລາ # ນາທີ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ. ແຖບຂອງທ່ານຈະຍັງເປີດຢູ່.}}</translation>
<translation id="2125838419757773031">ເລືອກພື້ນທີ່ໜ້າຈໍເພື່ອຊອກຫາ</translation>
<translation id="2126108037660393668">ໄຟລ໌ທີ່ດາວໂຫຼດໄວ້ບໍ່ຜ່ານການຢັ້ງຢືນ.</translation>
<translation id="2135919691573380097">ລາຍງານເວັບໄຊນີ້</translation>
<translation id="2137162749895930932">ປິດໜ້າຈໍແປພາສາ</translation>
<translation id="2147218225094845757">ເຊື່ອງແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="1628700182434635922">Phromium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກເວັບໄຊບໍ່ໄດ້ໃຊ້ການເຊື່ອມຕໍ່ທີ່ປອດໄພ ແລະ ໄຟລ໌ອາດມີການດັດແປງ</translation>
<translation id="2170098639895543546">ເລືອກສິ່ງໃດກໍໄດ້ໃນໜ້າ</translation>
<translation id="1807571394075492085">ປັບແຕ່ງ Phromium</translation>
<translation id="2174917724755363426">ການຕິດຕັ້ງບໍ່ສຳເລັດ. ທ່ານແນ່ໃຈບໍ່ວ່າທ່ານຕ້ອງການຍົກເລີກ?</translation>
<translation id="8332848361915479268">Phromium - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">ກວດສອບການອັບເດດຜິດພາດ: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">ລຶບບັນຊີອອກຈາກ Phromium</translation>
<translation id="6063124961634921864">ໃຊ້ແອັບ Phromium ເພື່ອນຳເຄື່ອງມືການຊື້ເຄື່ອງທີ່ດີທີ່ສຸດໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="8646569091716523420">ປອດໄພຍິ່ງຂຶ້ນໃນໂໝດເວລາເດີນທາງດ້ວຍ Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນຢູ່ Phromium ສໍາລັບ iOS</translation>
<translation id="3084983792533696835">ເວັບໄຊທີ່ເປັນອັນຕະລາຍ. Phromium ໄດ້ລຶບສິດເຂົ້າເຖິງການແຈ້ງເຕືອນອອກແລ້ວ.</translation>
<translation id="2236949375853147973">ການເຄື່ອນໄຫວຂອງຂ້ອຍ</translation>
<translation id="6387327671844988108">ເພື່ອຮັບທີ່ຢູ່ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium. ລະບົບຈະບັນທຶກທີ່ຢູ່ນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="722050260205928409">ຖ້າທ່ານແຊຣ໌ຄອມພິວເຕີ, ໝູ່​ເພື່ອນ ແລະຄອບຄົວຂອງທ່ານ ສາມາດທ່ອງເນັດໄດ້ແຍກຕ່າງຫາກ ແລະຕັ້ງ Phromium ໄດ້ຕາມ​ແບບທີ່ພວກເຂົາຕ້ອງການ.</translation>
<translation id="703211526866942526">ທັກສະໃນ Phromium</translation>
<translation id="2283803047247799269">ຊອກຫາແຖບນີ້ດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Phromium ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}other{Phromium ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}}</translation>
<translation id="2307973900865360088">ເກັບໄວ້ໃນດັອກ</translation>
<translation id="6083276764640161328">ກວດສອບ URL ກັບລາຍຊື່ເວັບໄຊທີ່ບໍ່ປອດໄພທີ່ຈັດເກັບໄວ້ໃນ Phromium. ຖ້າມີເວັບໄຊໃດໜຶ່ງພະຍາຍາມລັກເອົາລະຫັດຜ່ານຂອງທ່ານ ຫຼື ເມື່ອທ່ານດາວໂຫຼດໄຟລ໌ອັນຕະລາຍ, Phromium ອາດສົ່ງ URL, ຮວມທັງເນື້ອຫາບາງສ່ວນຂອງໜ້າໄປໃຫ້ Safe Browsing.</translation>
<translation id="2356070529366658676">ຖາມ</translation>
<translation id="2359808026110333948">ສືບຕໍ່</translation>
<translation id="741972887620936671">ສ່ວນຂະຫຍາຍ "<ph name="EXTENSION_NAME" />" ຕ້ອງການໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="4709464915929597251">ປິດການນຳໃຊ້ Phromium ທີ່ເຮັດວຽກໃນພື້ນຫຼັງສຳລັບແອັບ</translation>
<translation id="6804933363437420201">ເພື່ອໃຊ້ສ່ວນຂະຫຍາຍນີ້ດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium.</translation>
<translation id="2384373936468275798">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກລາຍລະອຽດການເຂົ້າສູ່ລະບົບຂອງທ່ານເກົ່າແລ້ວ.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{ມີສ່ວນຂະຫຍາຍ Phromium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID 1 ເຄື່ອງ}=1{ມີສ່ວນຂະຫຍາຍ Phromium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID 1 ເຄື່ອງ}other{ມີສ່ວນຂະຫຍາຍ Phromium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID # ເຄື່ອງ}}</translation>
<translation id="1394893265611797679">Phromium ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບ ແລະ ໄມໂຄຣໂຟນສຳລັບເວັບໄຊນີ້</translation>
<translation id="2403703063067034158">ສະຕາດອັບຜິດພາດ: ຂະນະນີ້ມີການຕັ້ງຄ່າອື່ນກຳລັງເຮັດວຽກຢູ່, ກະລຸນາລອງໃໝ່ພາຍຫຼັງ.</translation>
<translation id="8457868297375575309">ເປີດລິ້ງໃນ Phromium ຈາກແອັບໃດກໍໄດ້ ແລະ ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບເຂົ້າເຖິງໄດ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານ</translation>
<translation id="5354209517289935579">ຄລິກປຸ່ມສະຫຼຸບເພື່ອແບ່ງປັນເອກະສານນີ້ກັບ Gemini ໃນ Phromium ເພື່ອເບິ່ງພາບຮວມໂດຍຫຍໍ້ ແລະ ຖາມຄຳຖາມຕິດຕາມຜົນ</translation>
<translation id="6628402244681586711">ດ້ວຍ <ph name="BEGIN_LINK" />ເຄື່ອງມືຈາກ Phromium<ph name="END_LINK" />, ທ່ານຈະສາມາດທ່ອງເວັບໄດ້ຢ່າງປອດໄພ ແລະ ຄວບຄຸມສິ່ງຕ່າງໆໄດ້</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານໄດ້ນຳ.</translation>
<translation id="2451727308784734061">ໃຊ້ທາງລັດຂອງທ່ານເພື່ອເຂົ້າຫາຕົວຈັດການລະຫັດຜ່ານຢ່າງວ່ອງໄວ. ທ່ານສາມາດຍ້າຍທາງລັດຂອງທ່ານໄປຫາໜ້າຈໍຫຼັກຂອງຄອມພິວເຕີ ຫຼື ຕົວເປີດແອັບຂອງທ່ານໄດ້.</translation>
<translation id="1593547119543498467">Phromium ຈະປິດໃນໄວໆນີ້</translation>
<translation id="6814323389195469782">ໃນ Phromium</translation>
<translation id="2485422356828889247">ຖອນ​ຕິດ​ຕັ້ງ</translation>
<translation id="2513154137948333830">ຕ້ອງປິດເປີດໃໝ່: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">ເລືອກຂໍ້ຄວາມດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="2643581100433412871">Phromium ກຳລັງພະຍາຍາມປ່ຽນແທນລະຫັດຜ່ານທີ່ມີຢູ່. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານໃສ່ເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="4103676945224728292">Phromium ຕ້ອງການເຂົ້າເຖິງບ່ອນເກັບຂໍ້ມູນເພື່ອດາວໂຫຼດໄຟລ໌</translation>
<translation id="8743720024689622265">ຜູ້​ຊ່ວຍ Phromium</translation>
<translation id="2575822587468774919">ເລືອກຫຍັງກໍໄດ້ເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="8692134707551176334">ເພື່ອຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="6035715610127790081">ສະແກນລະຫັດ QR ດ້ວຍໂທລະສັບຂອງທ່ານເພື່ອດາວໂຫຼດ Phromium ແລະ ເຂົ້າສູ່ລະບົບບັນຊີ Google ຂອງທ່ານ.</translation>
<translation id="1579158377846894470">ເພື່ອຊອກຫາດ້ວຍ Phromium.</translation>
<translation id="3626651250874375470">ສືບຕໍ່ນຳໃຊ້ Phromium</translation>
<translation id="259935314519650377">ການແຄສຕົວຕິດຕັ້ງທີ່ດາວໂຫຼດໄວ້ບໍ່ສຳເລັດ. ຂໍ້ຜິດພາດ: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">ລະ​ບົບ</translation>
<translation id="7634640424937626608">ອົງກອນຂອງທ່ານສາມາດເບິ່ງ ແລະ ຈັດການຂໍ້ມູນການທ່ອງເວັບ ເຊັ່ນ: ບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານຂອງທ່ານໄດ້. ແຕ່ຈະບໍ່ເຫັນຂໍ້ມູນການທ່ອງເວັບໃນໂປຣໄຟລ໌ Phromium ອື່ນໆ</translation>
<translation id="2669565213445601962">ຢັ້ງຢືນວ່າມັນແມ່ນທ່ານທີ່ຈະໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="3048500373778933960">{COUNT,plural, =0{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Phromium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ}=1{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Phromium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Phromium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="4393202019354077587">ເລີ່ມ Phromium</translation>
<translation id="3192212313802409327">ເກີດຄວາມຜິດພາດດ້ານລະບົບປະຕິບັດການໃນລະຫວ່າງການຕິດຕັ້ງ. ກະລຸນາດາວໂຫຼດ Phromium ອີກ.</translation>
<translation id="6648732950668475680">ຖ້າທ່ານໃຊ້ອຸປະກອນຮ່ວມກັນ, ໝູ່ ແລະ ຄອບຄົວສາມາດທ່ອງເວັບແຍກຕ່າງຫາກ ແລະ ຕັ້ງຄ່າ Phromium ໃນແບບທີ່ເຂົາເຈົ້າຕ້ອງການໄດ້</translation>
<translation id="3501804488281766385">ເຂົ້າເຖິງເພື່ອໃຊ້ Gemini ໃນ Phromium ໃນອຸປະກອນຕ່າງໆຂອງທ່ານໄດ້ຢ່າງງ່າຍດາຍ, ເຖິງແມ່ນວ່າຈະຫຍໍ້ Phromium ຢູ່.</translation>
<translation id="5655763731487334489">ແຖບ Phromium</translation>
<translation id="582020748041490207">ເພື່ອຄວາມປອດໄພເພີ່ມເຕີມ, Phromium ຈະເຂົ້າລະຫັດຂໍ້ມູນຂອງທ່ານ.</translation>
<translation id="2693283019505702310">ເພື່ອລຶບບັນຊີ Google ຂອງທ່ານອອກຈາກ Phromium, ໃຫ້ອອກຈາກລະບົບ</translation>
<translation id="2989508583692830513">ເພື່ອເຂົ້າເຖິງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="2738871930057338499">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. HTTP 403 ຖືກຫ້າມ. ກະລຸນາກວດສອບການຕັ້ງຄ່າພຣັອກຊີຂອງທ່ານ.</translation>
<translation id="2753623023919742414">ຄລິກເພື່ອຊອກຫາ</translation>
<translation id="3391021955306442819">ຕັ້ງຄ່າ Phromium ເປັນໂປຣແກຣມອ່ານ PDF ເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="293156805028931571">ສ່ວນຂະຫຍາຍນີ້ມີເມົາແວ ແລະ ບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ Phromium ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="2799223571221894425">ເລີ່ມເປີດໃຊ້ໃໝ່</translation>
<translation id="4742633141454352374">Phromium ຂອງທ່ານ</translation>
<translation id="2816462166102338036">ຊອກຫາວິດີໂອນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="2191308357458164968">ຄົ້ນພົບຜະລິດຕະພັນດ້ວຍກ້ອງຂອງທ່ານ, ຕິດຕາມລາຄາທີ່ຫຼຸດລົງ ແລະ ອື່ນໆໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ Phromium ຢູ່ iOS.</translation>
<translation id="2841525013647267359">ແປຈາກພາສາ</translation>
<translation id="2846251086934905009">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຕົວຕິດຕັ້ງເຮັດວຽກໄດ້ບໍ່ສົມບູນ. ຍົກເລີກການຕິດຕັ້ງແລ້ວ.</translation>
<translation id="4498037716339180906">ເອົາ​ອອກ​ຈາກ Phromium...</translation>
<translation id="4049188396834160957">ຮັກສາຄວາມປອດໄພຂອງທ່ານໃນ Phromium ແລະ ອາດຖືກໃຊ້ເພື່ອປັບປຸງຄວາມປອດໄພຂອງທ່ານໃນແອັບ Google ອື່ນໆເມື່ອທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="2885378588091291677">ຕົວຈັດການໜ້າວຽກ</translation>
<translation id="4119302609687132178">ກ່ຽວ​ກັບ​ Phromium</translation>
<translation id="2915996080311180594">ຣິສະຕາດໃນພາຍຫຼັງ</translation>
<translation id="8232968781653330429">ຂໍ້ມູນຂອງທ່ານໄດ້ຖືກເຂົ້າລະຫັດໄວ້ດ້ວຍລະຫັດຜ່ານຂອງທ່ານ. ລະບຸລະຫັດຜ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີ Google ຂອງທ່ານ.</translation>
<translation id="2945997411976714835">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ເລີ່ມຂັ້ນຕອນຂອງຕົວຕິດຕັ້ງບໍ່ສຳເລັດ.</translation>
<translation id="5624652745932625503">ເຂົ້າສູ່ລະບົບເວັບໄຊໄວຂຶ້ນໂດຍໃຊ້ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້ສຳລັບ Phromium ຢູ່ iOS</translation>
<translation id="8821179372057577828">ອົງການຂອງທ່ານຈັດການ Phromium</translation>
<translation id="741172935898285572">Phromium ແມ່ນເວີຊັນໃໝ່ຫຼ້າສຸດແລ້ວ</translation>
<translation id="8798708493876822519">ຖ້າມີເວັບໄຊໃດໜຶ່ງພະຍາຍາມລັກເອົາລະຫັດຜ່ານຂອງທ່ານ ຫຼື ເມື່ອທ່ານດາວໂຫຼດໄຟລ໌ອັນຕະລາຍ, Phromium ອາດສົ່ງ URL, ຮວມທັງເນື້ອຫາບາງສ່ວນຂອງໜ້າໄປໃຫ້ Safe Browsing</translation>
<translation id="6896740867011823632">ເພື່ອທ່ອງໂລກອອນລາຍຢ່າງປອດໄພຍິ່ງຂຶ້ນດ້ວຍຕົວເລືອກຂອງຜູ້ປົກຄອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບໃນ Phromium</translation>
<translation id="3003694935412297923">ໜ້າວຽກທັງໝົດ</translation>
<translation id="3580865868015023718">{count,plural, =1{Phromium ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານແທ້ກ່ອນຈະສາມາດບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດໄດ້. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ (1 ລາຍການ) ຈະຖືກລຶບ.}other{Phromium ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານແທ້ກ່ອນຈະສາມາດບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດໄດ້. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ ({count} ລາຍການ) ຈະຖືກລຶບ.}}</translation>
<translation id="1211179250505223767">ເປີດ <ph name="URL" /> ໃນແຖບໃໝ່ໃນ Phromium.</translation>
<translation id="4742400838355945730">ລະບົບຈະບັນທຶກນະວັດຕະກຳ AI ເຊັ່ນ: ທັກສະ ໄວ້ໃນບັນຊີ Google ຂອງທ່ານ ແລະ ຈັດການແຍກຕ່າງຫາກຈາກ Phromium Sync</translation>
<translation id="8070050512429584052">ເພື່ອເຂົ້າເຖິງສ່ວນຂະຫຍາຍ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="666691655897541311">ກໍາລັງເພີ່ມ Phromium...</translation>
<translation id="3038232873781883849">ກຳ​ລັງ​ລໍ​ຖ້າ​ຕິດ​ຕັ້ງ...</translation>
<translation id="3045032126857188731">ພາສາທີ່ແປ: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">ປິດກ່ອງໂຕ້ຕອບຄຳຕິຊົມ</translation>
<translation id="919456815618829047"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບລາຍຊື່ການອ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="6141754610526066487">ໂປຣໄຟລ໌ Phromium ອື່ນ</translation>
<translation id="2380720899384114679">ສ່ວນຂະຫຍາຍແມ່ນສ່ວນເສີມທີ່ຊ່ວຍໃຫ້ທ່ານປັບແຕ່ງ Phromium ໄດ້. ຕັ້ງແຕ່ການຈັດລະບຽບໄປຈົນຮອດການເຮັດໃຫ້ໜ້າວຽກປະຈຳວັນງ່າຍຂຶ້ນ, ສ່ວນຂະຫຍາຍຊ່ວຍໃຫ້ທ່ານປັບແຕ່ງ Phromium ໃຫ້ເປັນຂອງທ່ານເອງໄດ້.</translation>
<translation id="2507281899032275020">ຊ່ວຍເຮັດໃຫ້ Phromium ດີຂຶ້ນໂດຍການສົ່ງລາຍງານການ​ຂັດຂ້ອງ ແລະ  <ph name="UMA_LINK" />  ຫາ Google.</translation>
<translation id="1514966729948178660">ໃຊ້ແອັບ Phromium ເພື່ອນຳຄວາມປອດໄພຂອງ Google ໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{ມີສ່ວນຂະຫຍາຍ Phromium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB 1 ເຄື່ອງ}=1{ມີສ່ວນຂະຫຍາຍ Phromium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB 1 ເຄື່ອງ}other{ມີສ່ວນຂະຫຍາຍ Phromium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB # ເຄື່ອງ}}</translation>
<translation id="78720743239019396">ເພື່ອເຂົ້າເຖິງລາຍຊື່ການອ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="7000206277447032115">ປະຫວັດ Phromium</translation>
<translation id="4555002192651219296">ຕົວຕິດຕັ້ງບໍ່ສາມາດ​ຄາຍ​ການບີບອັດຄັງເກັບມ້ຽນ. ກະລຸນາດາວໂຫຼດ Phromium ອີກ.</translation>
<translation id="310459126943037700">ເຮັດໃຫ້ໜ້າວຽກສິ້ນສຸດບໍ່ສຳເລັດ.</translation>
<translation id="3104828284009500087">ຊອກຫາສິ່ງຕ່າງໆຢູ່ໜ້າເວັບ</translation>
<translation id="4867557516756736957">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບ. ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ ແລະ ມັກໄດ້ຢ່າງງ່າຍດາຍໂດຍອັບເດດໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານເປັນ Phromium.</translation>
<translation id="8632308594821621017">Phromium ກໍາລັງໃຊ້​ໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="3130333203120345554">ຊອກຫາໃໝ່</translation>
<translation id="3137969841538672700">ລາກເພື່ອຊອກຫາ</translation>
<translation id="9173792796158381383">ແຖບນີ້ກຳລັງໃຊ້ຊັບພະຍາກອນເພີ່ມເຕີມ. ເພື່ອປັບປຸງປະສິດທິພາບຂອງທ່ານ, ໃຫ້ Phromium ຊ່ວຍເຮັດໃຫ້ມັນບໍ່ເຮັດວຽກ.</translation>
<translation id="8874679893080632357">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ Phromium ໃນການຕັ້ງຄ່າລະບົບ</translation>
<translation id="101045618220347251">ປິດແລ້ວເປີດ Phromium ຄືນໃໝ່</translation>
<translation id="3161522574479303604">ທຸກ​ພາ​ສາ</translation>
<translation id="5940989267583033306">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ Phromium</translation>
<translation id="2045477525210426976">ປັບແຕ່ງໂປຣໄຟລ໌ Phromium ໃໝ່ຂອງທ່ານ</translation>
<translation id="3540518135502114323">ທ່ານສາມາດສົນທະນາກັບໂໝດ AI ຕໍ່ໄປໄດ້ໂດຍບໍ່ຕ້ອງສະຫຼັບແຖບ. ເພື່ອເລີ່ມຕົ້ນ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium. ນອກຈາກນີ້, ທ່ານຍັງຈະຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານໄດ້ນຳ.</translation>
<translation id="1496180326063744749">ເພື່ອລຶບບັນຊີ Google ຂອງທ່ານອອກຈາກ Phromium, ໃຫ້ອອກຈາກລະບົບ Phromium ໃນໜ້າການຕັ້ງຄ່າ</translation>
<translation id="7792783034323745412">ຕໍ່ມາ, Phromium ຈະສາມາດຖາມວ່າທ່ານຕ້ອງການໃຊ້ຂໍ້ມູນທີ່ບັນທຶກໄວ້ເພື່ອຕື່ມແບບຟອມໃຫ້ທ່ານຫຼືບໍ່</translation>
<translation id="5240091371721695404">Phromium ບໍ່ສາມາດອ່ານ ແລະຂຽນໄປໃສ່ໄດເຣັກຕໍຣີຂໍ້ມູນຂອງມັນໄດ້:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">ນຳເຄື່ອງມື Google AI ທີ່ທ່ານມັກໄປໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ Phromium ຢູ່ iOS.</translation>
<translation id="4848363951707149242">ເພື່ອເຂົ້າເຖິງສ່ວນຂະຫຍາຍ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="3286538390144397061">ປິດເປີດໃໝ່ດຽວນີ້</translation>
<translation id="8613877111531019527">ລະຫັດ Google API ຫາຍໄປ. ການເຮັດໜ້າທີ່ບາງອັນຂອງ Phromium ຈະປິດໃຊ້ງານ.</translation>
<translation id="2784090498377460662">ສືບຕໍ່ແລ່ນແອັບພື້ນຫຼັງ ເມື່ອ Phromium ປິດ</translation>
<translation id="3905054486991167751">Phromium ຈະອັບເດດເມື່ອບໍ່ມີການນຳໃຊ້</translation>
<translation id="4502950976754616266">Phromium ຈະເຕືອນທ່ານກ່ອນການໂຫຼດເວັບໄຊໃດກໍຕາມທີ່ກຳລັງໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພ</translation>
<translation id="6107453188231652861">ທ່ານຈະອອກຈາກລະບົບຂອງເວັບໄຊສ່ວນໃຫຍ່ເມື່ອທ່ານປິດໜ້າຈໍ Phromium ທັງໝົດຍົກເວັ້ນບັນຊີ Google ຂອງທ່ານຫາກທ່ານເຂົ້າສູ່ລະບົບ Phromium. ເພື່ອໃຫ້ເວັບໄຊຈື່ທ່ານໄດ້, ກະລຸນາ <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">ມຸມຂວາເທິງຂອງພື້ນທີ່ຊອກຫາ: ຂວາ <ph name="RIGHT" />%, ເທິງ <ph name="TOP" />%</translation>
<translation id="5896635343289575401">ຂໍ້ມູນ Phromium ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="5662253013097242821">ໃຊ້ລະຫັດຜ່ານຂອງທ່ານກັບ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">ສະຫຼັບເປັນໂປຣໄຟລ໌ Phromium ທີ່ມີຢູ່ກ່ອນແລ້ວບໍ?</translation>
<translation id="3412460710772753638">ໃນຕົວຈັດການລະຫັດຜ່ານຢູ່ອຸປະກອນນີ້</translation>
<translation id="657700335789940813">Phromium ຕ້ອງການອັບເດດ</translation>
<translation id="3487742274367151379">ເພື່ອເຂົ້າເຖິງບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="3438772217992559640">ຊອກຫາແຖບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="8062355070850891600">ຂະຫຍາຍ Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນດ້ວຍ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="5419337472918920970">ກຳລັງປັບແຕ່ງ Phromium ໃນແບບຂອງທ່ານ...</translation>
<translation id="6573105037542661278">ນີ້ຈະລຶບ <ph name="ITEMS_COUNT" /> ລາຍການອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Phromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="4600986251755456192"><ph name="SHORTCUT" /> ສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ Phromium ໄດ້</translation>
<translation id="8118189978246431067">ກະລຸນາປິດທຸກໜ້າຕ່າງ Phromium ແລະລອງໃໝ່ອີກ.</translation>
<translation id="7430418346833889620">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ Phromium ໃນການຕັ້ງຄ່າລະບົບ</translation>
<translation id="2943929290955142701"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ.  ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງໃນຖານະ <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5896697187441340113">ລະຫັດ QR ເພື່ອດາວໂຫຼດໂປຣແກຣມທ່ອງເວັບ Phromium ຢູ່ອຸປະກອນມືຖື</translation>
<translation id="354621070532799440">ການແຈ້ງເຕືອນ: ຄຸນສົມບັດດ້ານຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໃນກະເປົາຂອງທ່ານ</translation>
<translation id="6718500626359284607">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ Phromium ໃນການຕັ້ງຄ່າລະບົບ.</translation>
<translation id="6511372913460632136">ການປົກປ້ອງທີ່ປັບປຸງດີຂຶ້ນຈະປິດການເພີ່ມປະສິດທິພາບ JavaScript ສຳລັບເວັບໄຊທີ່ Phromium ບໍ່ຮູ້ຈັກ</translation>
<translation id="3597003331831379823">ເອີ້ນໃຊ້ການຕັ້ງຄ່າດ້ວຍສິດທິພິເສດລະດັບສູງບໍ່ສຳເລັດ. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="8702816719621016911">ຂໍ້ມູນການທ່ອງເວັບຂອງບຸກຄົນນີ້ຈະຖືກລຶບອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຄືນມາ, ກະລຸນາເຂົ້າສູ່ລະບົບ Phromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{ມີການອັບເດດໃໝ່ສຳລັບ Phromium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່.}=1{ມີການອັບເດດໃໝ່ສຳລັບ Phromium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ມີການອັບເດດໃໝ່ສຳລັບ Phromium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="3667616615096815454">ບໍ່ສາມາດຕິດຕັ້ງໄດ້, ເຊີບເວີບໍ່ຮູ້ຈັກແອັບພລິເຄຊັນ.</translation>
<translation id="678730369472836428">ໃຊ້ <ph name="BEGIN_LINK" />ລະຫັດຜ່ານຂອງທ່ານເອງ<ph name="END_LINK" /> ໃນການເຂົ້າລະຫັດຂໍ້ມູນ Phromium ທັງໝົດໃນບັນຊີ Google ຂອງທ່ານ. ວິທີການຈ່າຍເງິນ ແລະ ທີ່ຢູ່ຈາກ Google Pay ຈະບໍ່ໄດ້ຖືກເຂົ້າລະຫັດໄວ້. ປະຫວັດການທ່ອງເວັບຈາກ Phromium ຈະບໍ່ຊິ້ງ.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Phromium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້}=1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Phromium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Phromium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="2203303261468330007">ເປີດລິ້ງໃນແຖບ Phromium ໃໝ່</translation>
<translation id="686463893976008238">ລິ້ງ Phromium ແລະ ບໍລິການອື່ນໆຂອງ Google ເພື່ອການປັບແຕ່ງເປັນແບບສ່ວນຕົວ ແລະ ຈຸດປະສົງອື່ນໆ</translation>
<translation id="3729187154190517324">ເຈາະເລິກການຊອກຫາຂອງທ່ານໂດຍການເພີ່ມແຖບ, ໄຟລ໌ ແລະ ເຄື່ອງມືຫຼາຍລາຍການໂດຍໃຊ້ປຸ່ມ "ເພີ່ມແຖບ ແລະ ອື່ນໆ".</translation>
<translation id="5596264049590907430">ຈັດການໂປຣໄຟລ໌ Phromium</translation>
<translation id="5594723037153142396">ສຶກສາວ່າເປັນຫຍັງ Phromium ຈຶ່ງບລັອກການດາວໂຫຼດບາງລາຍການ</translation>
<translation id="3425307214497790458">Phromium ຈະແຈ້ງໃຫ້ທ່ານຮູ້ຫາກມີສິ່ງໃດທີ່ທ່ານຕ້ອງກວດສອບ</translation>
<translation id="4247980944121268675">Phromium ໂຫຼດໜ້າເວັບທີ່ທ່ານອາດຈະເຂົ້າເບິ່ງໄວ້ກ່ອນລ່ວງໜ້າ, ເພື່ອໃຫ້ພວກມັນໂຫຼດໄວຂຶ້ນເມື່ອທ່ານເຂົ້າເບິ່ງ</translation>
<translation id="3810973564298564668">ຈັດການ</translation>
<translation id="1058395779823101457">ເພື່ອໃຊ້ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້ຂອງທ່ານ, ໃຫ້ເຂົ້າໄປຕາມລະຫັດ QR, ດາວໂຫຼດ Phromium ສຳລັບ iOS ແລ້ວເຂົ້າສູ່ລະບົບບັນຊີ Google ຂອງທ່ານ</translation>
<translation id="3846683726093018685">**ສະຫຼຸບ:** ໃນປະໂຫຍກດຽວທີ່ມີບໍ່ເກີນ 30 ຄຳ, ໃຫ້ອະທິບາຍເລື່ອງຫຼັກ ແລະ ຈຸດປະສົງຂອງເນື້ອຫາໃນຮູບໜ້າຈໍ.

          **ແນະນຳຄຳຖາມ:** ສ້າງລາຍຊື່ສັນຍາລັກຂອງຄຳຖາມກະຕຸ້ນຄວາມຄິດ 3-5 ຂໍ້ທີ່ຜູ້ໃຊ້ອາດຖາມເພື່ອສ້າງຄວາມເຂົ້າໃຈຮູບໜ້າຈໍໄດ້ດີຍິ່ງຂຶ້ນ. ຄຳຖາມເຫຼົ່ານີ້ຄວນມີຢ່າງໜ້ອຍ 1 ຂໍ້ທີ່ກ່ຽວກັບວັດຖຸພາບ, ການອອກແບບ ຫຼື ຕຳແໜ່ງຂອງວັດຖຸນັ້ນໂດຍສະເພາະ.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">ເພື່ອເຂົ້າເຖິງບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="3885770153807205175">ຕົວເລືອກພາສາ</translation>
<translation id="5947409614720749543">ປັບແຕ່ງ ແລະ ຄວບຄຸມ Phromium. ມີບາງຢ່າງທີ່ທ່ານຕ້ອງດຳເນີນການ - ຄລິກສຳລັບລາຍລະອຽດ.</translation>
<translation id="2176348074240183776">ຄລິກ​ທີ່​ຊື່​ຂອງ​ທ່ານ​ເພື່ອ​ເປີດ Phromium ແລະ​ເລີ່ມ​ຕົ້ນທ່ອງເນັດ.</translation>
<translation id="3892148308691398805">ສຳເນົາຂໍ້ຄວາມ</translation>
<translation id="3679766722656346339"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບໂປຣໄຟລ໌ Phromium ນີ້ຢູ່ກ່ອນແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, Phromium ສາມາດສ້າງໂປຣໄຟລ໌ຂອງທ່ານເອງໃຫ້ທ່ານໄດ້.</translation>
<translation id="6085953975934135790">ສ່ວນຂະຫຍາຍນີ້ລະເມີດນະໂຍບາຍ Chrome Web Store ແລະ ອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ Phromium ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="3941890832296813527">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຊື່ໄຟລ໌ຂອງຕົວຕິດຕັ້ງບໍ່ຖືກຕ້ອງ ຫຼື ລະບົບບໍ່ຮອງຮັບ.</translation>
<translation id="608187946760434925">Phromium ກໍາລັງພະຍາຍາມສຳເນົາລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດໃຫ້ສຳເນົາໄດ້.</translation>
<translation id="3054592240125889472">ເພື່ອເຂົ້າເຖິງຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="3140795250676341027">ລະບົບຈະລຶບລະຫັດຜ່ານ, ວິທີການຈ່າຍເງິນ ແລະ ທີ່ຢູ່ທີ່ທ່ານບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອໃຊ້ຂໍ້ມູນເຫຼົ່ານີ້ໃນ Phromium, ໃຫ້ເຂົ້າສູ່ລະບົບອີກຄັ້ງ.</translation>
<translation id="395904275706073188">ບໍ່ສາມາດອ່ານໜ້າທີ່ມີການປ້ອງກັນໄດ້. ລອງໃຊ້ໜ້າອື່ນ.</translation>
<translation id="4227910144250222665">ສຶກສາວິທີການທີ່ Phromium ຮັກສາຄວາມປອດໄພໃຫ້ທ່ານ</translation>
<translation id="3967822245660637423">ດາວ​ໂຫຼດ​ສຳ​ເລັດ</translation>
<translation id="4150430234581811723">ເມື່ອທ່ານພິມໃນແຖບທີ່ຢູ່ ຫຼື ກ່ອງຊອກຫາ, Phromium ຈະສົ່ງສິ່ງທີ່ທ່ານພິມໄປຫາເຄື່ອງມືຊອກຫາ, AI ແລະ ເຄື່ອງມືຕົວແທນຂອງອົງກອນຂອງທ່ານເພື່ອຮັບຄຳແນະນຳ.</translation>
<translation id="3975724895399328945">ກ່ຽວກັບ Google Chrome ສຳລັບການທົດສອບ</translation>
<translation id="3997429360543082038">ກ່ຽວກັບ ChromiumOS</translation>
<translation id="4847805566397342820">ເມື່ອທ່ານເຂົ້າເບິ່ງເວັບໄຊ, Phromium ຈະເອົາສະເພາະບາງສ່ວນຂອງ URL ມາສ້າງຄວາມສັບສົນແລ້ວສົ່ງໄປໃຫ້ <ph name="BEGIN_LINK" />Google Safe Browsing<ph name="END_LINK" /> ຜ່ານເຊີບເວີຄວາມເປັນສ່ວນຕົວທີ່ເຊື່ອງທີ່ຢູ່ IP ຂອງທ່ານ. ຫາກເວັບໄຊເຮັດສິ່ງທີ່ໜ້າສົງໄສ, ລະບົບຈະສົ່ງ URL ແບບເຕັມ ແລະ ເນື້ອຫາຂອງໜ້າເວັບບາງສ່ວນນຳ.</translation>
<translation id="4016217212818346953">ປອດໄພຢູ່ສະເໝີດ້ວຍຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="4019629340646866719">ChromiumOS ເກີດຂຶ້ນໄດ້ດ້ວຍ <ph name="BEGIN_LINK_CROS_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_CROS_OSS" /> ເພີ່ມເຕີມ, ຮວມທັງ <ph name="BEGIN_LINK_LINUX_OSS" />ສະພາບແວດລ້ອມການພັດທະນາ Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">ແປໜ້າຈໍ</translation>
<translation id="4023601594785368013">ພາສາຕົ້ນສະບັບ: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">ເປີດລິ້ງໃນ Phromium ຈາກແອັບໃດກໍໄດ້. ພ້ອມທັງເພື່ອເຂົ້າເຖິງໄດ້ງ່າຍ, ມັນຈະຖືກປັກໝຸດໃສ່ແຖບໜ້າວຽກຂອງທ່ານ.</translation>
<translation id="6916567874038032700">ຊ່ວຍເຮັດໃຫ້ Phromium ດີຂຶ້ນໂດຍການລາຍງານ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າປັດຈຸບັນ<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">ການ​ປັບ​ປຸງ​ຄວາມ​ປອດ​ໄພ​ທີ່​ສຳ​ຄັນ ແລະ​ຄຸນ​ສົມ​ບັດ​ໃໝ່​ມີ​ໃຫ້​ຢູ່​ໃນ​ເວີ​ຊັນ​ຫຼ້າ​ສຸດ.</translation>
<translation id="4055805654398742145">ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະປິດ Phromium ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ 1 ນາທີ. ລຶບຂໍ້ມູນການທ່ອງເວັບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.}other{ອົງກອນຂອງທ່ານຈະປິດ Phromium ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ # ນາທີ. ລຶບຂໍ້ມູນການທ່ອງເວັບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.}}</translation>
<translation id="2498876341137940584">ໂໝດບໍ່ເປີດເຜີຍຕົວຕົນໃນ Phromium</translation>
<translation id="1371775705240141332">ເຂົ້າໄປໜ້າກ່ຽວກັບ Phromium</translation>
<translation id="1983555117242858621">ປັບແຕ່ງ Phromium ເພື່ອສ້າງຮູບລັກໃໝ່ໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານ</translation>
<translation id="3730928612696305544">ປັບແຕ່ງ Phromium ຂອງທ່ານ</translation>
<translation id="4148957013307229264">ກໍາລັງ​ຕິດ​ຕັ້ງ...</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ - Phromium</translation>
<translation id="8940475598678719246"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບລາຍຊື່ການອ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="3361801572720154185">ຄົ້ນພົບແອັບ, ເກມ, ສ່ວນຂະຫຍາຍ ແລະ ຮູບແບບສີສັນສຳລັບ Phromium.</translation>
<translation id="5104340040322658377">ເພື່ອຮັບສ່ວນຂະຫຍາຍນີ້ ແລະ ອື່ນໆຢູ່ຄອມພິວເຕີທັງໝົດຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="6533832886058295845">ເພື່ອທ່ອງໂລກອອນລາຍຢ່າງປອດໄພຍິ່ງຂຶ້ນດ້ວຍຕົວເລືອກຂອງຜູ້ປົກຄອງຂອງທ່ານ, ໃຫ້ປ່ຽນໄປໃຊ້ໂປຣໄຟລ໌ Phromium ຂອງທ່ານທີ່ເຂົ້າສູ່ລະບົບໃນຖານະ <ph name="USER_EMAIL_ADDRESS" /> ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="4222932583846282852">ກຳລັງຍົກເລີກ...</translation>
<translation id="4224210481850767180">ການຕິດຕັ້ງຖືກຍົກເລີກ.</translation>
<translation id="6904238369362879351">ລິ້ງ Phromium ຂອງ​ທ່ານກັບບັນຊີນີ້ບໍ?</translation>
<translation id="357744319784654404">ເຕືອນທ່ານກ່ຽວກັບເວັບໄຊທີ່ເປັນອັນຕະລາຍ, ແມ່ນແຕ່ເວັບໄຊທີ່ Google ບໍ່ຮູ້ຈັກມາກ່ອນ, ໂດຍການວິເຄາະຂໍ້ມູນຈາກເວັບໄຊຫຼາຍກວ່າການປົກປ້ອງມາດຕະຖານ. ທ່ານສາມາດເລືອກທີ່ຈະຂ້າມຄຳເຕືອນຂອງ Phromium ໄດ້.</translation>
<translation id="7228779501660520489">ອອກຈາກລະບົບ Phromium</translation>
<translation id="2782053121162821">ຂໍຄວາມຊ່ວຍເຫຼືອເລື່ອງ Phromium</translation>
<translation id="4281844954008187215">ຂໍ້ກໍານົດການບໍລິການ</translation>
<translation id="5084022108026911204">ການ​ຕິດ​ຕັ້ງ​ບໍ່​ສໍາ​ເລັດ​ອັນ ​ເນື່ອງ​ມາ​ຈາກ​ຄວາມ​ຜິດພາດທີ່ບໍ່ລະບຸໄວ້​. ຖ້າ Phromium ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​, ກະ​ລຸ​ນາ​ປິດ​ມັນ ​ແລະ​ລອງໃໝ່​ອີກ​.</translation>
<translation id="5139026954638666406">ສົ່ງອອກລະຫັດຜ່ານຈາກ Phromium</translation>
<translation id="4304713468139749426">ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="4334241893986177674">ຊອກຫາຮູບໜ້າຈໍນີ້</translation>
<translation id="8324735155671556570">ເປີດໃຊ້ Phromium ເມື່ອ Windows ເລີ່ມເຮັດວຽກ</translation>
<translation id="4400772909124543403">ບໍ່ມີອັບເດດພ້ອມນຳໃຊ້</translation>
<translation id="2185735215611818026">ຢືນຢັນການອອກຈາກ Phromium ບໍ?</translation>
<translation id="4413205837991854510">ສະແດງທາງລັດການຊອກຫາຮູບສະເໝີ</translation>
<translation id="1338297030721125711">ໃຫ້ Phromium ເປີດໃຊ້ຢູ່ໃນພື້ນຫຼັງ</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{Phromium ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" />}other{Phromium ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" />}}</translation>
<translation id="1011403527148313450">ກໍານົດໃຊ້ ແລະ​ຄວບ​ຄຸມ Phromium</translation>
<translation id="4427306783828095590">ການປົກປ້ອງທີ່ປັບປຸງດີຂຶ້ນເຮັດໄດ້ຫຼາຍກວ່າໃນການບລັອກການຫຼອກເອົາຂໍ້ມູນ ແລະ ເມົາແວ</translation>
<translation id="4434353761996769206">ຕົວຕິດຕັ້ງຜິດພາດ: <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415"><ph name="MANAGER" /> ຈັດການ Phromium</translation>
<translation id="2477616462388290618">ເພີ່ມໂປຣໄຟລ໌ Phromium</translation>
<translation id="4447409407328223819">ກ່ຽວກັບ Chrome ສຳລັບການທົດສອບ</translation>
<translation id="972523218852576493">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາລະບຸລະຫັດຜ່ານຂອງທ່ານ</translation>
<translation id="4493028449971051158">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: ກະລຸນາເອີ້ນໃຊ້ຕົວຕິດຕັ້ງໃນຖານະຜູ້ເບິ່ງແຍງລະບົບ.</translation>
<translation id="4501471624619070934">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກສິດເຂົ້າເຖິງຖືກຈຳກັດໃນປະເທດນີ້.</translation>
<translation id="8839763675940122379">ສ່ວນຂະຫຍາຍນີ້ບໍ່ໄດ້ເຜີຍແຜ່ຂໍ້ປະຕິບັດຄວາມເປັນສ່ວນຕົວ, ເຊັ່ນ: ວິທີທີ່ມັນຮວບຮວມ ແລະ ໃຊ້ຂໍ້ມູນ. Phromium ແນະນຳໃຫ້ທ່ານລຶບອອກ.</translation>
<translation id="2339640488105852505">ຍິນດີຕ້ອນຮັບສູ່ Phromium; ເປີດໜ້າຈໍໂປຣແກຣມທ່ອງເວັບໃໝ່ແລ້ວ</translation>
<translation id="8536959233160434213">Phromium ຕ້ອງໄດ້ຮັບການອະນຸຍາດເພື່ອສ້າງແຜນທີ່ພື້ນທີ່ອ້ອມຂ້າງຂອງທ່ານ ແລະ ຕິດຕາມການເຄື່ອນໄຫວຂອງມືທ່ານ</translation>
<translation id="1077734277628859167">ທ່ານເຂົ້າສູ່ລະບົບດ້ວຍ <ph name="USER_EMAIL_ADDRESS" /> ໃນໂປຣໄຟລ໌ Phromium ອື່ນຢູ່ກ່ອນແລ້ວ</translation>
<translation id="5512897665247593318">Phromium ຈະໂຫຼດໜ້າເວັບກ່ອນລ່ວງໜ້າເຊິ່ງເຮັດໃຫ້ເລືອກເບິ່ງ ແລະ ຊອກຫາໄດ້ໄວຂຶ້ນ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບໜ້າໂຫຼດກ່ອນລ່ວງໜ້າ<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">ປັບປຸງຄວາມປອດໄພຢູ່ໂລກອອນລາຍໃຫ້ດີຍິ່ງຂຶ້ນສຳລັບທຸກຄົນເມື່ອທ່ານລາຍງານເວັບໄຊທີ່ທ່ານຄິດວ່າເປັນອັນຕະລາຍ.</translation>
<translation id="6624033199018630177">Phromium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກທ່ານປິດ Safe Browsing ແລະ ເຮັດໃຫ້ບໍ່ສາມາດຢັ້ງຢືນໄຟລ໌ໄດ້</translation>
<translation id="3039804643080655517">ລອງໃຊ້ Google Lens ກັບ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="4594305310729380060">ຫາຕົວຈັດການລະຫັດຜ່ານຢູ່ອຸປະກອນນີ້</translation>
<translation id="8064263528617889755">ແອັບ Phromium</translation>
<translation id="4598116752460667024">ຊອກຫາຂະບວນການໃດໆຈາກລາຍຊື່.</translation>
<translation id="4613863813562375431">ເວີຊັນ ChromiumOS</translation>
<translation id="7245201002247176127">ອັບເດດໃກ້ແລ້ວໆ! ກະລຸນາປິດແລ້ວເປີດ Phromium ຄືນໃໝ່ເພື່ອສິ້ນສຸດຂັ້ນຕອນການອັບເດດ.</translation>
<translation id="8846891938874485868">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ Phromium ແຕ່ເຮັດໃຫ້ Phromium ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ</translation>
<translation id="7525500996671436081">ເປີດການຊອກຫາດ້ວຍ Phromium</translation>
<translation id="1224842000407297331">ໂປຣໄຟລ໌ Phromium</translation>
<translation id="4956303519269880412">ຄຳເຕືອນ: Phromium ບໍ່ສາມາດປ້ອງກັນສ່ວນຂະຫຍາຍບໍ່ໃຫ້ບັນທຶກປະຫວັດການທ່ອງເວັບຂອງທ່ານໄດ້. ເພື່ອປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍນີ້ໃນໂໝດທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ, ກະລຸນາບໍ່ເລືອກຕົວເລືອກນີ້.</translation>
<translation id="2708255035805733225">ຫາກທ່ານແບ່ງປັນລາຍງານການນຳໃຊ້ Phromium ນຳ, ລາຍງານເຫຼົ່ານັ້ນຈະຮວມເອົາ URL ທີ່ທ່ານເຂົ້າເບິ່ງໄວ້ພ້ອມ</translation>
<translation id="4673710618874938871">ເຂົ້າສູ່ລະບົບໃນຊື່ <ph name="USER_NAME" />, ສະມາຊິກ. ເປີດເມນູບັນຊີ</translation>
<translation id="1883292567514549610">ປະກົດວ່າໂປຣໄຟລ໌ໃຊ້ງານຢູ່ໂດຍຂະບວນການ Phromium ອື່ນ (<ph name="PROCESS_ID" />) ຢູ່ໃນຄອມພິວເຕີອື່ນ (<ph name="HOST_NAME" />). Phromium ໄດ້ລັອກໂປຣໄຟລ໌ໄວ້ ເພື່ອບໍ່ໃຫ້ມັນໄດ້ຮັບການ​ຂັດຂ້ອງ. ຖ້າທ່ານແນ່ໃຈວ່າ ບໍ່ມີຂະບວນການອື່ນໃຊ້ໂປຣໄຟລ໌ນີ້ຢູ່, ທ່ານສາມາດປົດລັອກໂປຣໄຟລ໌ ແລະເລີ່ມເປີດໃຊ້ Phromium ໃໝ່ໄດ້.</translation>
<translation id="4680828127924988555">ຍົກເລີກການຕິດຕັ້ງ</translation>
<translation id="1889305042180577023">ຂໍ້ມູນ Phromium ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄປໃສ່ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ຈະຖືກລຶບ.</translation>
<translation id="8079525505870459051">ໃນລະຫວ່າງທີ່ທ່ານເຂົ້າສູ່ລະບົບ, ທ່ານສາມາດໃຊ້ລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກບັນຊີ Google ຂອງທ່ານໃນ Phromium ໄດ້. ໂດຍສາມາດໃຊ້ <ph name="SHORTCUT" /> ເພື່ອປ່ຽນການຕັ້ງຄ່າບໍລິການ Google ຂອງທ່ານໄດ້.</translation>
<translation id="2171507067211697961">ຄົນອື່ນເຄີຍເຂົ້າສູ່ລະບົບ Phromium ໃນຄອມພິວເຕີນີ້ເປັນ <ph name="ACCOUNT_EMAIL_LAST" /> ມາກ່ອນແລ້ວ. ກະລຸນາສ້າງຜູ້ໃຊ້ Phromium ໃໝ່ເພື່ອເກັບຂໍ້ມູນຂອງທ່ານໃຫ້ແຍກກັນຕ່າງຫາກ.</translation>
<translation id="4724676981607797757">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກຂໍ້ຜິດພາດໂປຣຕໍຄໍທີ່ບໍ່ຮອງຮັບ.</translation>
<translation id="6925701206088903005">ຢືນຢັນການອອກຈາກ Phromium ບໍ?</translation>
<translation id="4514755609496543621">ຫາກໍນຳໃຊ້ການອັບເດດຄວາມປອດໄພພິເສດສຳລັບ Phromium ແລ້ວ. ກະລຸນາປິດເປີດໃໝ່ຕອນນີ້ເລີຍ ແລ້ວພວກເຮົາຈະກູ້ຄືນແຖບຂອງທ່ານ.</translation>
<translation id="8673673368917636496">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Phromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ແລະ ອີກ <ph name="COUNT" /> ລາຍການອອກແລ້ວ.</translation>
<translation id="3638319732826965647">ຫາກ Gemini ໃນ Phromium ເປີດຢູ່, ແຜງຄວບຄຸມດ້ານຂ້າງຈະເປີດຢູ່ເມື່ອສ້າງແຖບໃໝ່</translation>
<translation id="479167709087336770">ນີ້ໃຊ້ຕົວກວດການສະກົດຄໍາດຽວກັນກັບທີ່ໃຊ້ໃນ Google ຊອກຫາ. ຂໍ້ຄວາມທີ່ທ່ານພິມໃນໂປຣແກຣມທ່ອງເວັບຖືກສົ່ງໃຫ້ Google. ທ່ານສາມາດປ່ຽນລັກສະນະການນໍາໃຊ້ນີ້ໄດ້ສະເໝີໃນການຕັ້ງຄ່າ.</translation>
<translation id="2659245507243672392">ໃຊ້ Phromium ໂດຍບໍ່ມີບັນຊີ</translation>
<translation id="166411027652942990">ກົດລະບຽບຂາເຂົ້າສໍາລັບ Phromium ເພື່ອອະນຸຍາດການຈາລະຈອນ mDNS.</translation>
<translation id="6031862420354068813">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;Phromium</translation>
<translation id="4918086044614829423">ຍອມ​ຮັບ</translation>
<translation id="4918844574251943176">ສຳເນົາຮູບແລ້ວ</translation>
<translation id="1531905832227009774">ເພື່ອເຂົ້າເຖິງລາຍຊື່ການອ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="4319892378006430019">Phromium ຢູ່ໃນໂໝດພື້ນຫຼັງ.</translation>
<translation id="8972359100025490790">ຄລິກເພື່ອປິດກ່ອງໂຕ້ຕອບການເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="3639078149590125530">ໂປຣໄຟລ໌ Phromium ຊ່ວຍໃຫ້ທ່ານສາມາດແຍກຂໍ້ມູນທັງໝົດໃນ Phromium ຂອງທ່ານອອກຈາກກັນໄດ້. ສ້າງໂປຣໄຟລ໌ສຳລັບໝູ່ ແລະ ຄອບຄົວ, ຫຼື ແຍກການເຮັດວຽກອອກຈາກຄວາມບັນເທີງ.</translation>
<translation id="7141327976224964788">ແຂກສາມາດໃຊ້ Phromium ໂດຍ​ບໍ່​ມີ​ການປະອັນໃດໄວ້ເບື້ອງຫຼັງ.</translation>
<translation id="7007327521155149139">ບັນຊີຂອງທ່ານໃນ Phromium</translation>
<translation id="5973804420920585431">ເພີ່ມທ່ານເອງໃສ່ Phromium</translation>
<translation id="504699503110800016">ເປີດເມນູລົ້ນ</translation>
<translation id="2497925691306722252">ເຂົ້າເຖິງ Google ທີ່ທ່ານມັກທັງໝົດດ້ວຍ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="8678196879882043620">Phromium ຕ້ອງໄດ້ຮັບການອະນຸຍາດເພື່ອຕິດຕາມການເຄື່ອນໄຫວຂອງມືທ່ານ</translation>
<translation id="3397880081430454820">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Phromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> ອອກແລ້ວ.</translation>
<translation id="9114243566897924763">ເຂົ້າສູ່ລະບົບຫາ Phromium</translation>
<translation id="5174969993834422967">ໂດຍປົກກະຕິແລ້ວທ່ານບລັອກການແຈ້ງເຕືອນ. ເພື່ອໃຫ້ເວັບໄຊນີ້ແຈ້ງເຕືອນທ່ານ, ໃຫ້ຄລິກທີ່ໄອຄອນການແຈ້ງເຕືອນຢູ່ມຸມຂວາຂອງແຖບສະຖານທີ່ຂອງທ່ານ.</translation>
<translation id="5174983315706567306">ພື້ນທີ່ດິສກ໌ບໍ່ພຽງພໍ.</translation>
<translation id="7698884672439844280">ບັນຊີ Phromium ຕ້ອງມີການພິສູດຢືນຢັນຄືນໃໝ່</translation>
<translation id="5629965056131882780">ດຳເນີນການຕໍ່ຈາກຈຸດທີ່ທ່ານຄ້າງໄວ້ດ້ວຍ Phromium ຢູ່ iOS.</translation>
<translation id="874294566462998787">ອອກຈາກລະບົບ Phromium</translation>
<translation id="5234764350956374838">ປ່ອຍໄປ</translation>
<translation id="8605581794204249702">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ Phromium</translation>
<translation id="8722804301463582643">ດາວໂຫຼດແອັບ Phromium ເພື່ອບັນທຶກລະຫັດຜ່ານໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="6253936671561887082">ເພື່ອນຳໃຊ້ການປ່ຽນແປງຂອງທ່ານ, ກະລຸນາເປີດ Phromium ຄືນໃໝ່</translation>
<translation id="7405713141437293142">ເພື່ອສົ່ງແຖບນີ້ໄປຫາອຸປະກອນອື່ນ, ໃຫ້ເຂົ້າສູ່ລະບົບຫາ Phromium ຢູ່ທັງສອງອຸປະກອນ</translation>
<translation id="5286907366254680517">ກວດພົບ</translation>
<translation id="2224284460884535818">ດາວໂຫຼດແອັບ Phromium</translation>
<translation id="1426207087952749578">ເມື່ອທ່ອງເວັບໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ, Phromium ຈະເຕືອນທ່ານກ່ອນການໂຫຼດເວັບໄຊທີ່ກຳລັງໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພ</translation>
<translation id="8108751453879231987">ຊອກຫາດ້ວຍ Phromium</translation>
<translation id="7780358745459835678">ບໍລິການພາຍໃນຂອງ Phromium Updater</translation>
<translation id="6956753580765202069">ໃຊ້ພ້ອມກັບຄຸນສົມບັດອື່ນໆຂອງ Gemini ໃນ Phromium</translation>
<translation id="5346389065299425353">ເຈາະເລິກການຊອກຫາຂອງທ່ານໂດຍການເພີ່ມແຖບ, ໄຟລ໌ ແລະ ເຄື່ອງມືຫຼາຍລາຍການ</translation>
<translation id="8684266995248242891">ຮັບພາບຮວມໂດຍຫຍໍ້ຂອງເອກະສານນີ້ ແລະ ຖາມຄຳຖາມດ້ວຍ Gemini ໃນ Phromium</translation>
<translation id="586104673506947714">Phromium ພົບຄຳແນະນຳດ້ານຄວາມປອດໄພບາງຢ່າງທີ່ທ່ານຕ້ອງກວດສອບ</translation>
<translation id="4657908558997566735">ໂປຣໄຟລ໌ Phromium ອື່ນ</translation>
<translation id="6097378010983112326">ChromiumOS ບໍ່ສາມາດບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີ Google ຂອງທ່ານໄດ້ເນື່ອງຈາກລາຍລະອຽດການເຂົ້າສູ່ລະບົບບັນຊີຂອງທ່ານເກົ່າແລ້ວ</translation>
<translation id="385020720581757591">ທ່ານກໍາລັງລົງຊື່ເຂົ້າ​ໃຊ້ດ້ວຍບັນຊີຄຸ້ມຄອງ ແລະໃຫ້ຜູ້ຄວບຄຸມຂອງມັນຄວບຄຸມໂປຣໄຟລ໌ Phromium ຂອງທ່ານ. ຂໍ້ມູນ Phromium ຂອງທ່ານ, ເຊັ່ນ: ແອັບ, ບຸກມາກສ໌, ປະຫວັດ, ລະຫັດຜ່ານ, ແລະການຕັ້ງຄ່າອື່ນໆຂອງທ່ານຈະຖືກຜູກ​ມັດ​ກັບ <ph name="USER_NAME" /> ຢ່າງຖາວອນ. ທ່ານຈະສາມາດລຶບຂໍ້ມູນນີ້ໄດ້ຜ່ານ Google Accounts Dashboard, ແຕ່ທ່ານຈະບໍ່ສາມາດເອົາຂໍ້ມູນນີ້ເຂົ້າຮ່ວມກັບບັນຊີອື່ນໄດ້. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">ລະຫັດເພີ່ມເຕີມ: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">ເພື່ອຮັບການປັບແຕ່ງເປັນແບບສ່ວນຕົວ, ໃຫ້ຮວມ Phromium ໄວ້ໃນການເຄື່ອນໄຫວເວັບ ແລະ ແອັບ</translation>
<translation id="2756028035855809142">ເປີດການຊອກຫາດ້ວຍ Phromium</translation>
<translation id="4375021373215585423">ສຶກສາວ່າເປັນຫຍັງ Phromium ຈຶ່ງບລັອກໄຟລ໌ບາງລາຍການ</translation>
<translation id="4688227912949761884">ກຳລັງອັບເດດ Phromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບສ່ວນຂະຫຍາຍ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="4945147853702701048">ອະນຸຍາດການເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="7813879193794658604">ເອົາ​ອອກ​ຈາກ Phromium</translation>
<translation id="2908302339618007937">ຫຼຸດປະສິດທິພາບ ແຕ່ເຮັດໃຫ້ Phromium ທົນທານຕໍ່ການໂຈມຕີໄດ້ຫຼາຍຂຶ້ນ</translation>
<translation id="8760365573983490520">ຕັ້ງ Phromium ເປັນບຣາວ​ເຊີມາດຕະຖານຂອງທ່ານ</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> - Phromium Beta</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{Phromium ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}other{Phromium ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}}</translation>
<translation id="975923236500175446">Phromium ອາດເຮັດວຽກໄດ້ບໍ່ຖືກຕ້ອງເນື່ອງຈາກ Linux distribution ນີ້ບໍ່ຮອງຮັບມັນອີກຕໍ່ໄປແລ້ວ.</translation>
<translation id="7595270580374414215">Phromium ບລັອກການດາວໂຫຼດນີ້ເພາະວ່າໄຟລ໌ສາມາດເປັນອັນຕະລາຍຕໍ່ບັນຊີສ່ວນຕົວ ແລະ ບັນຊີເຄືອຂ່າຍສັງຄົມຂອງທ່ານໄດ້</translation>
<translation id="5644162187312430027">ກະ​ລຸ​ນາ​ລໍ​ຖ້າ​ໃນ​ຂະ​ນະ​ທີ່ Phromium ​ຕິດ​ຕັ້ງ​ການອັບເດດລະບົບຫລ້າ​ສຸດ.</translation>
<translation id="2476033563817685908">Phromium ກໍາລັງພະຍາຍາມແກ້ໄຂລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດໃຫ້ສຳເນົາໄດ້.</translation>
<translation id="1626952238284562558">ເຮັດວຽກຮ່ວມກັບແອັບທີ່ທ່ານມັກ ເຊັ່ນ: Google Drive ແລະ YouTube ໄດ້ຢ່າງລ່ຽນໄຫຼທຸກບ່ອນທຸກເວລາດ້ວຍ Phromium.</translation>
<translation id="5524890928877629608">ມຸມຊ້າຍເທິງຂອງພື້ນທີ່ຊອກຫາ: ຊ້າຍ <ph name="LEFT" />%, ເທິງ <ph name="TOP" />%</translation>
<translation id="2860766395826060492">ເປີດ PDF ໃນ Phromium</translation>
<translation id="5536164441519929134">ຖາມ<ph name="LINE_BREAK" />ກ່ຽວກັບແຖບນີ້</translation>
<translation id="3915500272078806319">ເພື່ອຄວາມປອດໄພ, Phromium ຈະປິດການເພີ່ມປະສິດທິພາບ JavaScript ເມື່ອທ່ານເຂົ້າເບິ່ງເວັບໄຊເປັນເທື່ອທຳອິດ.

ຫາກໜ້ານີ້ບໍ່ເຮັດວຽກຕາມທີ່ຄາດໄວ້, ໃຫ້ລອງອະນຸຍາດການເພີ່ມປະສິດທິພາບ.</translation>
<translation id="6778733300408894918">ສະແດງ Gemini ໃນ Phromium ໃນແຖບເມນູຂອງ Mac ແລະ ເປີດຄີລັດ</translation>
<translation id="8411908790152555435"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="5579324208890605088">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: ກະລຸນາເອີ້ນໃຊ້ຕົວຕິດຕັ້ງໃນຖານະຜູ້ໃຊ້ທົ່ວໄປ, ບໍ່ແມ່ນໃນຖານະຜູ້ເບິ່ງແຍງລະບົບ.</translation>
<translation id="6578510724610627339">ໃຊ້ Phromium ເປັນຄ່າເລີ່ມຕົ້ນ ແລະ ປັກໝຸດມັນໄວ້</translation>
<translation id="5596627076506792578">ໂຕ​ເລືອກ​ເພີ່ມ​ເຕີມ</translation>
<translation id="5605834417512968703">ເລືອກຫຍັງກໍໄດ້ເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ ຫຼື ກົດ Escape ເພື່ອອອກຈາກຄຸນສົມບັດນີ້</translation>
<translation id="5618818588972826921">ເລືອກຂໍ້ຄວາມ ຫຼື ຮູບເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ ຫຼື ກົດ Escape ເພື່ອອອກຈາກການຊອກຫາຮູບ</translation>
<translation id="4431270188253419020">{0,plural, =0{ມີການອັບເດດ Phromium}=1{ມີການອັບເດດ Phromium}other{ມີການອັບເດດ Phromium ເປັນເວລາ # ມື້ແລ້ວ}}</translation>
<translation id="6903143702905157196">ລຶບຂໍ້ມູນເວັບໄຊຈາກອຸປະກອນຂອງທ່ານທຸກເທື່ອທີ່ທ່ານປິດ Phromium</translation>
<translation id="5354366475527026551">ກະລຸນາປິດເປີດ Phromium ຄືນໃໝ່ຕອນນີ້</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">ສະ​ແດງ Phromium ເປັນພາສານີ້</translation>
<translation id="569897634095159764">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. ພຣັອກຊີເຊີບເວີຕ້ອງມີການພິສູດຢືນຢັນ.</translation>
<translation id="5724138350057003647">Phromium ຈະເພີ່ມໜ່ວຍຄວາມຈຳຈາກແຖບທີ່ບໍ່ໄດ້ນຳໃຊ້. ເຊິ່ງນີ້ເຮັດໃຫ້ແຖບທີ່ນຳໃຊ້ຢູ່ ແລະ ແອັບອື່ນໆມີຊັບພະຍາກອນສຳລັບຄອມພິວເຕີເພີ່ມຂຶ້ນ ແລະ ຊ່ວຍໃຫ້ Phromium ເຮັດວຽກໄດ້ໄວ. ແຖບທີ່ບໍ່ມີການນຳໃຊ້ຂອງທ່ານຈະກັບມາເຮັດວຽກໂດຍອັດຕະໂນມັດອີກຄັ້ງເມື່ອທ່ານກັບຄືນໄປຫາແຖບເຫຼົ່ານັ້ນ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບຕົວປະຢັດໜ່ວຍຄວາມຈຳ<ph name="END_LINK" /></translation>
<translation id="3730992449058237228">ຫາກທ່ານລືມລະຫັດຜ່ານຂອງທ່ານ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, <ph name="SETTINGS_LINK" /> ຂໍ້ມູນ Phromium ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="1983042639279920602">ປັບແຕ່ງ ແລະ ຄວບຄຸມ Phromium. ຕັ້ງ Phromium ເປັນຄ່າເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="7136978005010973283">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບໂດຍຕັ້ງ Phromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="5809516625706423866">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. HTTP 401 ບໍ່ໄດ້ຮັບອະນຸຍາດ. ກະລຸນາກວດສອບການຕັ້ງຄ່າພຣັອກຊີຂອງທ່ານ.</translation>
<translation id="3059302031765226748">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ Phromium ແຕ່ເຮັດໃຫ້ Phromium ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ. ການຕັ້ງຄ່ານີ້ປິດຢູ່.</translation>
<translation id="4904710047654714935">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາອັບເດດ Phromium</translation>
<translation id="5824893331272123205">ບໍ່ສາມາດໂຫຼດແຜງນີ້ໄດ້, ກະລຸນາລອງໃໝ່</translation>
<translation id="2582896742857095190">ຍິນ​ດີ​ຕ້ອນ​ຮັບສູ່ Phromium</translation>
<translation id="5004643502851105876">ເປີດຄຸນສົມບັດເພີ່ມເຕີມເພື່ອໃຫ້ການປົກປ້ອງທີ່ເຂັ້ມງວດທີ່ສຸດຂອງ Phromium</translation>
<translation id="5871205389137001634">ຄລິກເພື່ອອອກຈາກການຊອກຫາຮູບ</translation>
<translation id="7409018434452575206">Phromium ພົບວ່າລາຍການເຫຼົ່ານີ້ມີເມົາແວ:</translation>
<translation id="3191822983646594827">Phromium ຈະກວດສອບເປັນປະຈຳເພື່ອໃຫ້ແນ່ໃຈວ່າໂປຣແກຣມທ່ອງເວັບຂອງທ່ານມີການຕັ້ງຄ່າທີ່ປອດໄພທີ່ສຸດ. ພວກເຮົາຈະແຈ້ງໃຫ້ທ່ານຮູ້ຫາກມີຫຍັງທີ່ຕ້ອງໃຫ້ທ່ານກວດສອບ.</translation>
<translation id="5895138241574237353">ເລີ່ມຕົ້ນໃໝ່</translation>
<translation id="625373791981566594">Gemini Enterprise ໃນ Phromium</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ</translation>
<translation id="5924017743176219022">ກຳ​ລັງ​ເຊື່ອມ​ຕໍ່​ອິນ​ເຕີ​ເນັດ...</translation>
<translation id="5941711191222866238">ຫຍໍ້ລົງ</translation>
<translation id="8650638130234822147">ເພື່ອຮັບເອົາບຸກມາກນີ້ ແລະ ອື່ນໆອີກໃນທຸກອຸປະກອນຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="5010592102321399468">ເຮັດໃຫ້ Phromium ເປັນຂອງທ່ານ</translation>
<translation id="5960071705175224773">ແອັບທີ່ບໍ່ຮູ້ຈັກປ່ຽນການຕັ້ງຄ່າຂອງທ່ານ</translation>
<translation id="5977420883993828287">ປັກໝຸດແລ້ວ! ໃຊ້ໜ້າວຽກຕາມບໍລິບົດອີກຄັ້ງຈາກແຖບເຄື່ອງມື</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະປິດ Phromium ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ 1 ນາທີ.}other{ອົງກອນຂອງທ່ານຈະປິດ Phromium ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ # ນາທີ.}}</translation>
<translation id="3160371268592376569">ອັບເດດ Phromium ເພື່ອເລີ່ມຊິ້ງຂໍ້ມູນ</translation>
<translation id="5990360079535151574">ຈາກປຸ່ມ "ໜ້າວຽກຕາມບໍລິບົດ" ຢູ່ແຖບເຄື່ອງມື, ທ່ານສາມາດເປີດໜ້າວຽກຕາມບໍລິບົດອີກຄັ້ງເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="6003112304606738118">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="HOURS" /> ຊົ່ວໂມງ</translation>
<translation id="6009821354356307391">ຂໍການຕິດຕາມຜົນ</translation>
<translation id="6040143037577758943">ປິດ</translation>
<translation id="5783572280281297164">ໃຊ້ປະໂຫຍດເພີ່ມເຕີມຈາກການຊື້ເຄື່ອງອອນລາຍເມື່ອທ່ານໃຊ້ແອັບ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="2712461133060419287">ເພື່ອປົກປ້ອງຂໍ້ມູນຂອງທ່ານ, ອະນຸຍາດໃຫ້ Phromium ລຶບການອະນຸຍາດອອກຈາກເວັບໄຊທີ່ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. ແຕ່ບໍ່ຢຸດການແຈ້ງເຕືອນ.</translation>
<translation id="7845842385196710435">&amp;ເປີດໃນ Phromium</translation>
<translation id="6069027071882229820">ສຳເນົາເປັນຮູບ</translation>
<translation id="3752072756936611600">ເພີ່ມ <ph name="EXTENSION_NAME" /> ໃສ່ Phromium ແລ້ວ</translation>
<translation id="2775066550187002528">ປັບແຕ່ງ ແລະ ຄວບຄຸມ Phromium. ມີການອັບເດດແລ້ວ</translation>
<translation id="6531352038528110565">ເປີດ • Phromium ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ</translation>
<translation id="2876078296400914679">ບັນຊີຂອງທ່ານໃນ Phromium</translation>
<translation id="3881538460441135554">ອະນຸຍາດໃຫ້ສ່ວນຂະຫຍາຍສະແດງຄຳຮ້ອງຂໍສິດເຂົ້າເຖິງໃນແຖບເຄື່ອງມື Phromium</translation>
<translation id="7479187736743594081"><ph name="FILE_NAME" /> ອັນຕະລາຍ, ສະນັ້ນ Phromium ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="6646104775883837119">Phromium ຈະປິດ ແລະ ລຶບຂໍ້ມູນໃນໄວໆນີ້</translation>
<translation id="6138634751748297112">ທ່ານສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ Phromium ໄດ້ຢູ່ບ່ອນນີ້</translation>
<translation id="8660563290103481109">ຫາກທ່ານອະນຸຍາດໃຫ້ໃຊ້ຄຸກກີ້ໄດ້, Phromium ອາດໃຊ້ພວກມັນເມື່ອໂຫຼດກ່ອນລ່ວງໜ້າ</translation>
<translation id="6165508094623778733">ສຶກສາ​ເພີ່ມ​ເຕີມ</translation>
<translation id="969667123257916656">ລຶບລ້າງຂໍ້ມູນ Phromium ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="5528040738212560214">ໄຟລ໌ນີ້ອາດເປັນອັນຕະລາຍ<ph name="LINE_BREAK" />Phromium ສາມາດກວດສອບການດາວໂຫຼດນີ້ໃຫ້ທ່ານໄດ້ຫາກທ່ານລະບຸລະຫັດຜ່ານ. ຂໍ້ມູນກ່ຽວກັບໄຟລ໌ຈະຖືກສົ່ງໄປຫາ Google Safe Browsing, ແຕ່ເນື້ອຫາໄຟລ໌ ແລະ ລະຫັດຜ່ານຈະຍັງຢູ່ໃນອຸປະກອນຂອງທ່ານ.</translation>
<translation id="6182736845697986886">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກເຊີບເວີອັບເດດເກີດຂໍ້ຜິດພາດພາຍໃນ.</translation>
<translation id="6041381825442292659">ກວດໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ເຂົ້າສູ່ລະບົບ Chrome ໃນ <ph name="TARGET_DEVICE_NAME" /> ຂອງທ່ານ ແລ້ວລອງສົ່ງໃໝ່.</translation>
<translation id="2474943719592372017">ຊອກຫາ ແລະ ຖາມຄຳຖາມໄດ້ຈາກທຸກບ່ອນ, ເຖິງແມ່ນວ່າຈະຫຍໍ້ Phromium ຢູ່. ອະນຸຍາດໃຫ້ Phromium ເຮັດວຽກໃນພື້ນຫຼັງ.</translation>
<translation id="2518372260387069450">ຄອມພິວເຕີນີ້ມີ Phromium ລຸ້ນໃໝ່ກ່ວາຢູ່ຮຽບຮ້ອຍແລ້ວ. ຖ້າຊອບແວບໍ່ເຮັດວຽກ, ກະລຸນາຖອນຕິດຕັ້ງ Phromium ແລະລອງໃໝ່ອີກ.</translation>
<translation id="3832895416321159809">{0,plural, =0{Phromium ຈະເປີດຄືນໃໝ່ດຽວນີ້}=1{Phromium ຈະເປີດຄືນໃໝ່ໃນ 1 ວິນາທີ}other{Phromium ຈະເປີດຄືນໃໝ່ໃນ # ວິນາທີ}}</translation>
<translation id="2775110773501098464">Phromium ຕ້ອງການການອະນຸຍາດເຂົ້າເຖິງບ່ອນຈັດເກັບຂໍ້ມູນເພື່ອດາວໂຫຼດໄຟລ໌</translation>
<translation id="3505491405575013121">ກວດສອບ URL ກັບລາຍຊື່ເວັບໄຊທີ່ບໍ່ປອດໄພທີ່ຈັດເກັບໄວ້ໃນ Phromium</translation>
<translation id="2276249127856880228">ເຮັດ Phromium ເປັນບຣາວ​ເຊີມາດຕະຖານ</translation>
<translation id="6248988683584659830">ການຕັ້ງຄ່າຄົ້ນຫາ</translation>
<translation id="554637698797403739">ໃຊ້ຄຸນສົມບັດຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="7016155178198587734">ອອກຈາກລະບົບ Phromium ບໍ?</translation>
<translation id="5660287988409470276">ແຖບເຫຼົ່ານີ້ໃຊ້ຊັບພະຍາກອນຫຼາຍເປັນພິເສດ. ເພື່ອປັບປຸງປະສິດທິພາບຂອງທ່ານ, ກະລຸນາໃຫ້ Phromium ຊ່ວຍປິດນຳໃຊ້ແຖບເຫຼົ່ານີ້.</translation>
<translation id="8429776045186716992">ປັບແຕ່ງໂປຣໄຟລ໌ Phromium ຂອງທ່ານ</translation>
<translation id="3310436202618971091">ຕັ້ງຊື່ໂປຣໄຟລ໌ Phromium ຂອງທ່ານ</translation>
<translation id="1478750151648434251">ສ່ວນຂະຫຍາຍຕ້ອງການໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="9139712828910812615"><ph name="FILE_NAME" /> ອາດຈະອັນຕະລາຍ, ສະນັ້ນ Phromium ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="5191618263102115907">Phromium ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບຂອງ​ທ່ານ​.</translation>
<translation id="8247508943089477519">ການດຳເນີນການອື່ນໃນ Phromium ພວມດຳເນີນຢູ່. ກະລຸນາລອງອີກຄັ້ງໃນພາຍຫຼັງ.</translation>
<translation id="8271488218611798813">ດຽວນີ້ມັນງ່າຍທີ່ຈະໃຊ້ Phromium ກັບບັນຊີ Google ຂອງທ່ານ ແລະຢູ່ໃນຄອມພິວເຕີທີ່ແຊຣ໌ແລ້ວ.</translation>
<translation id="446228390478495078">ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ, ມັກ ແລະ ໄວ້ວາງໃຈໄດ້ຢ່າງງ່າຍດາຍໂດຍການຕັ້ງຄ່າ Phromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="2203435422524224690">ທາງລັດ Phromium</translation>
<translation id="3977517784144885449">Phromium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ບໍ່ໄດ້ມີການດາວໂຫຼດໂດຍທົ່ວໄປ ແລະ ອາດເປັນອັນຕະລາຍ</translation>
<translation id="8088471547690853921">ທ່ານແນ່ໃຈບໍວ່າ ທ່ານຕ້ອງການຖອນຕິດຕັ້ງ Phromium?</translation>
<translation id="6375219077595103062">ເພີ່ມທາງລັດໃສ່ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="6388799252195623474">ຊ່ວຍຂ້ອຍໃນເລື່ອງນີ້</translation>
<translation id="1774421040071124552">ເພື່ອສືບຕໍ່, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ດ້ວຍ <ph name="EMAIL" />. ການດຳເນີນການນີ້ຈະກວດສອບວ່າທ່ານມີນະໂຍບາຍຂອງອົງກອນຂອງທ່ານແລ້ວ.</translation>
<translation id="2343430845154053061">ໂລໂກ້ Phromium ພາຍໃນໜ້າຈໍຄອມພິວເຕີ.</translation>
<translation id="2724924185145648602">Phromium ແມ່ນບຣາວເຊີເວັບທີ່ແລ່ນໜ້າເວັບ ແລະແອັບພລິເຄຊັນດ້ວຍຄວາມໄວແບບສາຍຟ້າແມັບ. ມັນໄວ, ໝັ້ນຄົງ, ແລະໃຊ້ງ່າຍ. ທ່ອງເວັບໄດ້ປອດໄພກ່ວາດ້ວຍການປົກປ້ອງມາລແວ ແລະພິຊຊິງທີ່ສ້າງຢູ່ໃນຕົວ Phromium.</translation>
<translation id="7417453886359805803">ເພື່ອກວດສອບໃຫ້ແນ່ໃຈວ່າທ່ານສາມາດໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີ Google ຂອງທ່ານໄດ້ຕະລອດເວລາ, ກະລຸນາຢັ້ງຢືນວ່າແມ່ນທ່ານ</translation>
<translation id="3304683228794166031">Phromium ເຮັດວຽກໄດ້ໄວຂຶ້ນ ແລະ ຄຸນສົມບັດທີ່ໃຊ້ JavaScript ຄວນເຮັດວຽກຕາມທີ່ອອກແບບໄວ້</translation>
<translation id="6436260184216827876">ການຊອກຫາຮູບບໍ່ພ້ອມນຳໃຊ້. ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ.</translation>
<translation id="6442900851116057561">ຣີສະຕາດ ChromiumOS</translation>
<translation id="9164801375934097818">Phromium ໂຫຼດໜ້າເວັບໄວ້ກ່ອນລ່ວງໜ້າເພີ່ມຫຼາຍຂຶ້ນສຳລັບໜ້າທີ່ທ່ານອາດຈະເຂົ້າເບິ່ງ, ເພື່ອໃຫ້ພວກມັນໂຫຼດໄວຂຶ້ນເມື່ອທ່ານເຂົ້າເບິ່ງ</translation>
<translation id="2577121659922309103">ດາວໂຫຼດ Phromium ຢູ່ໂທລະສັບຂອງທ່ານເພື່ອຕິດຕາມລາຄາ ແລະ ຮັບການແຈ້ງເຕືອນເມື່ອລາຄາຫຼຸດລົງໃນເວັບໄຊໃດກໍຕາມ</translation>
<translation id="2052328618318278030">ປິດ • Phromium ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ</translation>
<translation id="3122296739697671126">ຍິນດີຕ້ອນຮັບສູ່ໂປຣໄຟລ໌ Phromium</translation>
<translation id="3472445024540245926">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ໃຊ້ກຸ່ມແຖບ.</translation>
<translation id="2144084801479939969">ລຶບບັນຊີອອກຈາກ Phromium</translation>
<translation id="2473490714352939152">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ Phromium.</translation>
<translation id="648319183876919572">Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນຊ່ວຍປົກປ້ອງທ່ານຈາກເວັບໄຊ ແລະ ການດາວໂຫຼດທີ່ອັນຕະລາຍ</translation>
<translation id="359777544552173333">ຖອນ​ຕິດ​ຕັ້ງ Phromium</translation>
<translation id="3890462049854841354">ເປີດທາງລັດໃນ Phromium</translation>
<translation id="6616579671682178785">ອົງກອນຂອງທ່ານປິດ Phromium ໄວ້ເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />. ຂໍ້ມູນການທ່ອງເວັບຖືກລຶບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.</translation>
<translation id="8662645370371079862">ແຕ່ລະໂປຣໄຟລ໌ມີຂໍ້ມູນ Phromium ຂອງມັນເອງ ເຊັ່ນ: ບຸກມາກ, ປະຫວັດ, ລະຫັດຜ່ານ ແລະ ອື່ນໆອີກ</translation>
<translation id="6556755379298048869">ຊອກຫາດ້ວຍຄີລັດ.</translation>
<translation id="7133640529688742768">ສຶກສາເພີ່ມເຕີມກ່ຽວກັບ <ph name="BEGIN_LINK" />ວິທີທີ່ Phromium ຮັກສາຂໍ້ມູນຂອງທ່ານໃຫ້ເປັນສ່ວນຕົວ<ph name="END_LINK" /></translation>
<translation id="8316065704185291024">ການປ່ຽນແປງການຕັ້ງຄ່ານີ້ຈະມີຜົນນຳໃຊ້ເມື່ອ Phromium ຣີສະຕາດ.</translation>
<translation id="2816396636285296289">ຈັດການສ່ວນຂະຫຍາຍຂອງທ່ານໂດຍການຄລິກສ່ວນຂະຫຍາຍໃນເມນູຫຼັກຂອງ Phromium.</translation>
<translation id="8831144879019828189">ທ່ານສາມາດສະຫຼັບເພື່ອເບິ່ງລະຫັດຜ່ານຈາກໂປຣໄຟລ໌ Phromium ອື່ນໄດ້</translation>
<translation id="7017911482442558099">ໃຊ້ແອັບ Phromium ເພື່ອນຳເຄື່ອງມື AI ທີ່ດີທີ່ສຸດໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="5784574554904759369">ເພື່ອແກ້ໄຂການສະກົດຄຳຜິດ, Phromium ສົ່ງຂໍ້ຄວາມທີ່ທ່ານພິມໃນຊ່ອງຂໍ້ຄວາມໃຫ້ Google</translation>
<translation id="8485501471305987872">ໄປຫາການຕັ້ງຄ່າການແຈ້ງເຕືອນຂອງ Phromium</translation>
<translation id="6600016381025017075">ຊອກຫາຫຍັງກໍໄດ້ໃນໜ້ານີ້</translation>
<translation id="1462793186918694806">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ Phromium ໃໝ່.</translation>
<translation id="7501991510212476553">ຕອນນີ້ລະບົບຈະເປີດໃຊ້ Phromium ເມື່ອ Windows ເລີ່ມເຮັດວຽກເພື່ອໃຫ້ທ່ານສາມາດເລີ່ມທ່ອງເວັບໄດ້ທັນທີ. ທ່ານສາມາດປິດການດຳເນີນການນີ້ໄດ້ໃນການຕັ້ງຄ່າ.</translation>
<translation id="7686308613268368175">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: Phromium ໄດ້ກູ້ຄືນແທັບຂອງທ່ານຈາກເຊດຊັນຫຼ້າສຸດຂອງທ່ານ. ທ່ານສາມາດປິດໃຊ້ສິ່ງນີ້ໄດ້ໃນ</translation>
<translation id="5266723901802366313">Phromium ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບເພື່ອສ້າງແຜນທີ່ 3 ມິຕິຂອງສິ່ງອ້ອມຕົວທ່ານ</translation>
<translation id="7085315067428293799">ນອກຈາກນັ້ນ, ຫາກທ່ານບັນທຶກບຸກມາກຂອງທ່ານໃນບັນຊີ Google ຂອງທ່ານ, ທ່ານສາມາດຕິດຕາມລາຄາຜະລິດຕະພັນໃນ Phromium ແລະ ຮັບການແຈ້ງເຕືອນເມື່ອລາຄາຫຼຸດລົງໄດ້</translation>
<translation id="6676384891291319759">ການເຂົ້າຫາອິນເຕີເນັດ</translation>
<translation id="668175097507315160">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກການເຂົ້າສູ່ລະບົບຜິດພາດ.</translation>
<translation id="5279767706090517695">ລຶບຂໍ້ມູນຂອງແອັບນີ້ອອກຈາກ Phromium</translation>
<translation id="6562226321659107531">Phromium ຕ້ອງການການອະນຸຍາດໄມໂຄຣໂຟນສຳລັບເວັບໄຊນີ້</translation>
<translation id="6712881677154121168">ດາວໂຫຼດຜິດພາດ: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">ບໍ່ສາມາດໃຊ້ໂປຣໄຟລ໌ຂອງທ່ານໄດ້ ເພາະວ່າມັນມາຈາກ Phromium ລຸ້ນໃໝ່ກ່ວາ.

ບາງ​ຄຸນສົມບັດອາດຈະບໍ່ມີ​ໃຫ້. ກະລຸນາລະບຸລາຍຊື່ບັນຊີໂປຣໄຟລ໌ຕ່າງ ຫຼືໃຊ້ Phromium ລຸ້ນໃໝ່ກ່ວາ.</translation>
<translation id="4914871493602315663">ເພື່ອຮັບການປັບແຕ່ງເປັນແບບສ່ວນຕົວ ແລະ ຄຸນສົມບັດອື່ນໆ, ໃຫ້ຮວມ Phromium ໄວ້ໃນການເຄື່ອນໄຫວເວັບ ແລະ ແອັບ ພ້ອມທັງບໍລິການ Google ທີ່ລິ້ງໄວ້</translation>
<translation id="5919390816124912606">ຕິດຕັ້ງ Phromium ສຳລັບຜູ້ໃຊ້ທຸກຄົນໃນຄອມພິວເຕີຂອງທ່ານແລ້ວ.</translation>
<translation id="5867815953973052697">ເພື່ອເຂົ້າເຖິງບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium. ລະບົບຈະບັນທຶກບຸກມາກນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="7381168634819530324">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ Phromium ແຕ່ເຮັດໃຫ້ Phromium ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ. ການຕັ້ງຄ່ານີ້ເປີດຢູ່.</translation>
<translation id="1509688792864707851">{count,plural, =1{ຂໍ້ມູນ Phromium ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ (1 ລາຍການ) ຈະຖືກລຶບ.}other{ຂໍ້ມູນ Phromium ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ ({count} ລາຍການ) ຈະຖືກລຶບ.}}</translation>
<translation id="4702638565169602649">Phromium ແນະນຳໃຫ້ສະແກນໄຟລ໌ນີ້ເນື່ອງຈາກມັນອາດເປັນອັນຕະລາຍໄດ້.</translation>
<translation id="6779406956731413166">ChromiumOS ເກີດຂຶ້ນໄດ້ດ້ວຍ <ph name="BEGIN_LINK_CROS_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_CROS_OSS" /> ເພີ່ມເຕີມ.</translation>
<translation id="6831043979455480757">ແປພາສາ</translation>
<translation id="1564864902402454287">Phromium ແຈ້ງໃຫ້ທ່ານຮູ້ຖ້າມີຄົນຮູ້ລະຫັດຜ່ານຂອງທ່ານ</translation>
<translation id="684888714667046800">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. ຫາກທ່ານໃຊ້ firewall, ກະລຸນາກວດສອບໃຫ້ໝັ້ນໃຈວ່າ <ph name="PRODUCT_EXE_NAME" /> ຢູ່ໃນລາຍຊື່ອະນຸຍາດ.</translation>
<translation id="6200419390448865091">Phromium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">ແຕະເພື່ອສືບຕໍ່</translation>
<translation id="6862030660799253820">ຊອກຫາຮູບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="6869568587896659271">ເຂົ້າເຖິງເວັບໄຊຢູ່ລຸ່ມແຖບທີ່ຢູ່ໄດ້ຢ່າງງ່າຍດາຍ</translation>
<translation id="4011399428346318467">Phromium ພົບວ່າ "<ph name="EXTENSION_NAME" />" ມີເມົາແວ</translation>
<translation id="6877155553248388166">ມຸມຂວາລຸ່ມຂອງພື້ນທີ່ຊອກຫາ: ຂວາ <ph name="RIGHT" />%, ລຸ່ມ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">ສຳເນົາ</translation>
<translation id="6898028264630240901">ທ່ານສາມາດປັກໝຸດໜ້າວຽກຕາມບໍລິບົດເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="1012681980425424211">ຕັ້ງ Phromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ ແລະ ປັກໝຸດມັນໃສ່ແຖບໜ້າວຽກຂອງທ່ານ</translation>
<translation id="1744625657438211994">&amp;ຈັດການໂປຣໄຟລ໌ Phromium</translation>
<translation id="7264818828956697552">ການດຳເນີນການນີ້ຈະເຮັດສິ່ງຕໍ່ໄປນີ້:
          <ph name="LINE_BREAKS" />
            • ຣີເຊັດໜ້າເລີ່ມຕົ້ນ, ໜ້າແຖບໃໝ່, ໂປຣແກຣມຊອກຫາ ແລະ ແຖບທີ່ປັກໝຸດແລ້ວຂອງທ່ານ
            <ph name="LINE_BREAK" />
            • ປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍ
            <ph name="LINE_BREAK" />
            • ລຶບຄຸກກີ້ ແລະ ຂໍ້ມູນເວັບໄຊຊົ່ວຄາວອື່ນໆ
            <ph name="LINE_BREAK" />
            • ຣີເຊັດທາງລັດຂອງ Phromium
            <ph name="LINE_BREAKS" />
            ການດຳເນີນການນີ້ຈະບໍ່ມີຜົນກັບບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້.</translation>
<translation id="6489000842445481390">ທ່ານບັນທຶກບຸກມາກຂອງ Phromium ຮອດຂີດຈຳກັດ <ph name="BOOKMARK_LIMIT" /> ລາຍການແລ້ວ, ດັ່ງນັ້ນລະບົບຈຶ່ງຍັງບໍ່ໄດ້ບັນທຶກບຸກມາກບາງລາຍການຂອງທ່ານໃສ່ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ.

ທ່ານຈະບໍ່ສາມາດບັນທຶກບຸກມາກໃໝ່ໃສ່ໃນບັນຊີຂອງທ່ານໄດ້ຈົນກວ່າທ່ານຈະລຶບບຸກມາກບາງລາຍການອອກ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ລະບົບຈະລຶບບຸກມາກທີ່ຍັງບໍ່ໄດ້ບັນທຶກໄວ້ອອກ.</translation>
<translation id="2645108248038996858">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ Phromium</translation>
<translation id="6965382102122355670">ຕົກລົງ</translation>
<translation id="6985329841647292029">ຂໍ້ກຳນົດ ChromiumOS</translation>
<translation id="2947519843530032104">ໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກລະບົບບໍ່ຮອງຮັບລະບົບປະຕິບັດການເວີຊັນນີ້.</translation>
<translation id="7024536598735240744">ແຕກໄຟລ໌ຜິດພາດ: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">ຕັ້ງຄ່າ Phromium ແບບກຳນົດເອງ</translation>
<translation id="7047386856539490735">ຜົນການຊອກຫາເຫຼົ່ານີ້ມີປະໂຫຍດຫຼືບໍ່?</translation>
<translation id="2448910402556368916">ອັບເດດ Phromium</translation>
<translation id="7834049737623892628">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, Phromium ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ Google.</translation>
<translation id="1803168627715642217">ສຳຜັດປະສິດທິພາບຂອງ AI ເມື່ອທ່ານໃຊ້ແອັບ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="3321731353906178474">ເຂົ້າເຖິງລະຫັດຜ່ານ, ແຖບ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="7141270731789036260">ປັບແຕ່ງ Chrome for Testing</translation>
<translation id="8077731669779275332">ທ່ານສາມາດໃຊ້ Phromium ໄດ້ທຸກເທື່ອທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ</translation>
<translation id="611798798247797100">ລຶບ <ph name="EXTENSION_NAME" /> ອອກຈາກ Phromium</translation>
<translation id="7962394294883785044">ອົງກອນຂອງທ່ານລຶບຂໍ້ມູນຂອງ Phromium ອອກເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.</translation>
<translation id="2611686760870033712">Phromium ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບສຳລັບເວັບໄຊນີ້</translation>
<translation id="71050417052775020">ບໍ່ສາມາດເປີດໃຊ້ Phromium ໄດ້. ກະລຸນາລອງອີກຄັ້ງ.</translation>
<translation id="4817060241763895497">ຖາມຫຍັງກໍໄດ້, ຈາກບ່ອນທີ່ທ່ານຢູ່, ດ້ວຍ Gemini ໃນ Phromium</translation>
<translation id="869358700049263961">ເກັບ Phromium ໃນດັອກຂອງທ່ານເພື່ອໄປໃຊ້ມັນຢ່າງວ່ອງໄວໄດ້ທຸກເວລາ</translation>
<translation id="7094488679340739251">ໃຊ້ Phromium ຕອນໃດກໍໄດ້ທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ</translation>
<translation id="7216228761061470870">ເມື່ອທ່ານໃຊ້ຄຸນສົມບັດຊອກຫາຮູບຢູ່ເດັສທັອບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີ</translation>
<translation id="7802634650401946711">ຕົວຈັດການໜ້າວຽກ - Phromium</translation>
<translation id="5182547787327636348">ຖາມກ່ຽວກັບເນື້ອຫາພາຍນອກ Phromium ເຊັ່ນ: ແອັບ ຫຼື ໄຟລ໌ອື່ນໆ</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="5761733252154904648">ເລີ່ມທ່ອງເວັບໄດ້ທັນທີ: ຕອນນີ້ລະບົບສາມາດເປີດໃຊ້ Phromium ເມື່ອ Windows ເລີ່ມເຮັດວຽກໄດ້ແລ້ວ.</translation>
<translation id="7274695763216404502">ປັກໝຸດແລ້ວ! ໃຊ້ການຊອກຫາຮູບອີກຄັ້ງຈາກແຖບເຄື່ອງມື</translation>
<translation id="7288567540154601580">ແຖບ ແລະ ສ່ວນຂະຫຍາຍ</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{Phromium ແນະນຳໃຫ້ທ່ານລຶບອອກ}other{Phromium ແນະນຳໃຫ້ທ່ານລຶບອອກ}}</translation>
<translation id="1408728332407453335">ເພື່ອແບ່ງປັນສຽງຂອງລະບົບ, ໃຫ້ເປີດການຕັ້ງຄ່າລະບົບ ແລະ ອະນຸຍາດ 'ການບັນທຶກສຽງຂອງລະບົບເທົ່ານັ້ນ' ສຳລັບ Phromium. ຈາກນັ້ນທ່ານຈະຕ້ອງຣີສະຕາດ Phromium.</translation>
<translation id="7299899569525778554">ຊອກຫາຈາກເດັສທັອບ</translation>
<translation id="6194310460545162015">ກໍາລັງອັບເດດ Phromium</translation>
<translation id="1098154893096691883">ໄຟລ໌ທີ່ມັກຂອງທ່ານເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້.

Phromium ບໍ່ສາມາດກູ້ການຕັ້ງຄ່າຂອງທ່ານຄືນໄດ້.</translation>
<translation id="7324051657739063017">ທ່ານສາມາດເປີດໜ້າວຽກຕາມບໍລິບົດຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="7024097830259741656">ເວັບຂອງທ່ານ, ບຸກມາກສ໌, ແລະ Phromium ອື່ນສົດຢູ່ທີ່ນີ້.</translation>
<translation id="852511575759652041">ມີພຽງບຸກຄົນທີ່ມີລະຫັດຜ່ານຂອງທ່ານເທົ່ານັ້ນທີ່ສາມາດອ່ານຂໍ້ມູນທີ່ໄດ້ຖືກເຂົ້າລະຫັດໄວ້ຂອງທ່ານໄດ້. Google ຈະບໍ່ໄດ້ຮັບ ຫຼື ຈັດເກັບລະຫັດຜ່ານດັ່ງກ່າວ. ຫາກທ່ານລືມລະຫັດຜ່ານຂອງຕົນເອງ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, ທ່ານຈະຕ້ອງ <ph name="BEGIN_LINK" />ລຶບຂໍ້ມູນ Phromium ໃນບັນຊີຂອງທ່ານ<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505">ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານໄດ້ກຳນົດຄ່າໃຫ້ Phromium ເປີດ <ph name="ALTERNATIVE_BROWSER_NAME" /> ເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">ມີ​ບາງ​ອັນ​ຜິດ​ພາດ</translation>
<translation id="7198690862684855451">ເພື່ອຮັບການອັບເດດ Phromium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ macOS 13 ຂຶ້ນໄປ. ຄອມພິວເຕີເຄື່ອງນີ້ກຳລັງໃຊ້ macOS 12.</translation>
<translation id="3224607549103501149">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Phromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ອອກແລ້ວ.</translation>
<translation id="73786666777299047">ເປີດ Chrome Web Store</translation>
<translation id="8446269872172461565">ສະແດງ Gemini ໃນ Phromium ໃນຖາດລະບົບ</translation>
<translation id="7401687852903179959">ຊອກຫາວິດີໂອນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="3403529853122418035">ຕອນນີ້ Phromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານແລ້ວ</translation>
<translation id="5649377421626481711">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: Phromium ຈະກູ້ຄືນແຖບຂອງທ່ານໄດ້ທຸກຄັ້ງທີ່ທ່ານປິດເປີດໃໝ່. ເພື່ອປິດໃຊ້ສິ່ງນີ້, ໃຫ້ໄປຫາ</translation>
<translation id="2467776530444676191">ນຳເຂົ້າລະຫັດຜ່ານໃສ່ Phromium</translation>
<translation id="8814480293815136510">1. ຄລິກ <ph name="BUTTON_LABEL" /> ທາງລຸ່ມ
2. ຄລິກ <ph name="BUTTON_2" /> ໃນການຕັ້ງຄ່າ Windows ຂອງທ່ານ
3. ຄລິກ <ph name="BUTTON_3" /> ໃນການແຈ້ງເຕືອນ Windows ເພື່ອປັກໝຸດ Phromium ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວ</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - Phromium Dev</translation>
<translation id="7450541714075000668">ສຳເນົາຂໍ້ຄວາມແລ້ວ</translation>
<translation id="6826407056979820031">ເພື່ອໃຊ້ໄມໂຄຣໂຟນຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Phromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
<translation id="1392131731909663319">ເພື່ອໄດ້ຮັບການອັບເດດ Phromium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 7.</translation>
<translation id="4512427777724578739">ເລີ່ມເປີດໃຊ້ Phromium ໃໝ່ບໍ?</translation>
<translation id="4510527847350985067">ບໍ່ສາມາດຕິດຕັ້ງ Phromium ລຸ້ນດຽວກັບທີ່ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​ໄດ້. ກະລຸນາປິດ Phromium ແລະລອງໃໝ່ອີກ.</translation>
<translation id="7510190804000607802">ການແຈ້ງເຕືອນ: ປະໂຫຍດສູງສຸດຈາກ Google ໃນກະເປົາຂອງທ່ານ</translation>
<translation id="4735608937705010375">ເວັບໄຊອາດເຮັດວຽກຕາມທີ່ຄາດໄວ້. ທ່ານຈະອອກຈາກລະບົບຂອງເວັບໄຊສ່ວນໃຫຍ່ເມື່ອທ່ານປິດໜ້າຈໍ Phromium ທັງໝົດຍົກເວັ້ນບັນຊີ Google ຂອງທ່ານຫາກທ່ານເຂົ້າສູ່ລະບົບ Phromium.</translation>
<translation id="7987051132742764178">{0,plural, =1{Phromium ຈະເປີດຄືນໃໝ່ໃນ 1 ນາທີ}other{Phromium ຈະເປີດຄືນໃໝ່ໃນ # ນາທີ}}</translation>
<translation id="1904271152425995672">ເພື່ອປົກປ້ອງຂໍ້ມູນຂອງທ່ານ, ກະລຸນາອະນຸຍາດໃຫ້ Phromium ລຶບການອະນຸຍາດອອກຈາກເວັບໄຊທີ່ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້.</translation>
<translation id="7909976731673595773">ເປີດໃຊ້ Phromium ໂດຍອັດຕະໂນມັດເພື່ອເລີ່ມທ່ອງເວັບໄດ້ທັນທີ.</translation>
<translation id="7583399374488819119">ຕົວຕິດຕັ້ງ <ph name="COMPANY_NAME" /></translation>
<translation id="3301232962183130807">Phromium ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບ​ ແລະໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="3230129417775002227">Phromium ​ດີກ​ວ່າແລ້ວ</translation>
<translation id="1322165820810533683">ຕອນນີ້ທ່ານມີຄຸນສົມບັດເພີ່ມເຕີມໃນ Phromium</translation>
<translation id="7624307931717240213">ພວກເຮົາໃຊ້ຂໍ້ມູນເພື່ອປັບປຸງບໍລິການນີ້. ເບິ່ງນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ ແລະ ຂໍ້ກຳນົດບໍລິການ.</translation>
<translation id="7649070708921625228">ຊ່ວຍ​ເຫຼືອ</translation>
<translation id="3795437289339745990">ດາວໂຫຼດແອັບ Phromium</translation>
<translation id="7658239707568436148">ຍົກ​ເລີກ​</translation>
<translation id="6671257169702988694">Phromium ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="7270402397025248165">ຊິ້ງຂໍ້ມູນ ແລະ ປັບແຕ່ງ Phromium ໃຫ້ເປັນແບບສ່ວນຕົວໃນທົ່ວອຸປະກອນຂອງທ່ານ</translation>
<translation id="6267574654655324634">ການອັບເດດ Phromium</translation>
<translation id="4868190765388740513">ວຽກຂອງທ່ານປອດໄພໃນ Phromium</translation>
<translation id="7716950018788545737">ໜ້າວຽກສິ້ນສຸດແລ້ວ.</translation>
<translation id="77283119132245232">ໃຫ້ບໍລິການຕິດຕາມລະບົບສຳລັບ <ph name="BROWSER_NAME" />. ຫາກປິດການນຳໃຊ້ບໍລິການນີ້, ການຕິດຕາມປະສິດທິພາບທີ່ສ້າງຂຶ້ນໂດຍໂປຣແກຣມທ່ອງເວັບຈະບໍ່ຮວມກິດຈະກຳທົ່ວລະບົບ ເຊັ່ນ: ກິດຈະກຳປ່ຽນບໍລິບົດ ແລະ ກິດຈະກຳຫົວຂໍ້ທີ່ພ້ອມນຳໃຊ້.</translation>
<translation id="2680098142787722612">ນີ້ຈະລຶບຂໍ້ມູນການທ່ອງເວັບຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Phromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ຕົວຕິດຕັ້ງບໍ່ສາມາດສ້າງໄດເຣັກຕໍຣີຊົ່ວຄາວໄດ້. ກະລຸນາກວດເບິ່ງບ່ອນ​ວ່າງດິສກ໌ ແລະການອະນຸຍາດ ເພື່ອຕິດຕັ້ງຊອບແວ.</translation>
<translation id="6830826880333833598">ຣີເຊັດເປັນ Phromium ແບບຄ່າເລີ່ມຕົ້ນ</translation>
<translation id="448710321315554838">ເພື່ອຮັກສາຄວາມປອດໄພໃຫ້ກັບວຽກຂອງທ່ານໃນ Phromium, ອົງກອນຂອງທ່ານຈະສາມາດເບິ່ງ ຫຼື ຈັດການຂໍ້ມູນບາງຢ່າງໄດ້ເມື່ອທ່ານເຂົ້າສູ່ລະບົບ Phromium.</translation>
<translation id="7045209483723342691">ຕັ້ງ Phromium ເປັນຄ່າເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="6452735947982563207">ເຮັດໃຫ້ Phromium ໄວຂຶ້ນ</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - Phromium Canary</translation>
<translation id="6929858452581400763">ເຮັດໃຫ້ຜູ້ທີ່ມີສິດເຂົ້າເຖິງທຣາບຟິກອິນເຕີເນັດຂອງທ່ານເບິ່ງວ່າທ່ານເຂົ້າເບິ່ງເວັບໄຊໃດແດ່ໄດ້ຍາກຂຶ້ນ. Phromium ໃຊ້ການເຊື່ອມຕໍ່ທີ່ປອດໄພເພື່ອຊອກຫາທີ່ຢູ່ IP ຂອງເວັບໄຊໃນ DNS (ລະບົບຊື່ໂດເມນ).</translation>
<translation id="7810005234485217901">ທ່ານສາມາດປັກໝຸດການຊອກຫາຮູບເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ</translation>
<translation id="4343392731007327660">ເລືອກສິ່ງທີ່ຈະແບ່ງປັນກັບ Phromium</translation>
<translation id="3052274192923256457">ມີໂປຣໄຟລ໌ Phromium ກັບບັນຊີນີ້ຢູ່ອຸປະກອນນີ້ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="7845233973568007926">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດຄອມພິວເຕີຂອງທ່ານກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="5674414381037997114">ມີການປ່ຽນໂປຣແກຣມຊອກຫາຂອງທ່ານຈາກພາຍນອກ Phromium. ເພື່ອປົກປ້ອງທ່ານ, Phromium ໄດ້ຣີເຊັດໂປຣແກຣມດັ່ງກ່າວເປັນຄ່າເລີ່ມຕົ້ນເກົ່າ. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">ປັບແຕ່ງ Phromium ເພື່ອໃຫ້ມີຮູບລັກໃໝ່</translation>
<translation id="3966946337517395351">ເມື່ອທ່ານພິມໃນແຖບທີ່ຢູ່ ຫຼື ກ່ອງຊອກຫາ, Phromium ຈະສົ່ງສິ່ງທີ່ທ່ານພິມໄປຫາໂປຣແກຣມຊອກຫາຄ່າເລີ່ມຕົ້ນຂອງທ່ານເພື່ອຮັບການແນະນຳທີ່ດີຍິ່ງຂຶ້ນ. ສິ່ງນີ້ຖືກປິດໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ.</translation>
<translation id="3928367799779122681">Phromium ບໍ່ສາມາດອັບເດດເປັນເວີຊັນຫຼ້າສຸດໄດ້, ສະນັ້ນທ່ານກຳລັງພາດຄຸນສົມບັດ ແລະ ການແກ້ໄຂດ້ານຄວາມປອດໄພໃໝ່ໆຢູ່.</translation>
<translation id="7872446069773932638">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="SECONDS" /> ວິນາທີ</translation>
<translation id="8492102592995742850">ຫາກທ່ານລືມລະຫັດຜ່ານຂອງຕົນເອງ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, ໃຫ້ <ph name="BEGIN_LINK" />ລຶບຂໍ້ມູນ Phromium ໃນບັນຊີຂອງທ່ານ<ph name="END_LINK" /></translation>
<translation id="959404544431817539">ເປີດ Gemini ໃນ Phromium ໄດ້ຢ່າງວ່ອງໄວທຸກເທື່ອທີ່ທ່ານຕ້ອງການ</translation>
<translation id="8889749279816358185">ຕັ້ງ Phromium ເປັນຄ່າເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="3173775358556080672">Phromium ອັບເກຣດການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພເປັນ HTTPS ໂດຍອັດຕະໂນມັດຫາກເປັນໄປໄດ້</translation>
<translation id="2210801904933897209">ທ່ານ​ໄດ້ລົງຊື່ເຂົ້າໃຊ້ Phromium ເປັນ <ph name="USER_EMAIL_ADDRESS" />. ກະ​ລຸ​ນາ​​ໃຊ້​ບັນ​ຊີ​ດຽວ​ກັນ​ ເພື່ອລົງຊື່ເຂົ້າໃຊ້ອີກ.</translation>
<translation id="7291855477503010638"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຢູ່ອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="5706099517903615644">ນີ້ແມ່ນການຕິດຕັ້ງສຳຮອງຂອງ Phromium ແລະ ບໍ່ສາມາດຖືກຕັ້ງເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້.</translation>
<translation id="2388440031754359882">ສ່ວນຂະຫຍາຍ, ແອັບ ແລະ ຮູບແບບສີສັນຈາກແຫຼ່ງຂໍ້ມູນທີ່ບໍ່ຮູ້ຈັກອາດເປັນອັນຕະລາຍກັບອຸປະກອນຂອງທ່ານໄດ້. Phromium ແນະນຳໃຫ້ຕິດຕັ້ງພວກມັນຈາກ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ເທົ່ານັ້ນ</translation>
<translation id="8205108509545565485">ຮັບປະໂຫຍດສູງສຸດຈາກ Google ດ້ວຍແອັບ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="8004582292198964060">ບຣາວ​ເຊີ</translation>
<translation id="8010081455002666927">ກວດຫາອັດຕະໂນມັດ</translation>
<translation id="6421861275173778152">ເມື່ອ Phromium ມີການເຂົ້າເຖິງ, ເວັບໄຊຈະສາມາດຮ້ອງຂໍການເຂົ້າເຖິງນຳທ່ານ.</translation>
<translation id="942087293138739513">ປັກໝຸດ Phromium ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວທຸກເວລາ</translation>
<translation id="80471789339884597">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດໂປຣແກຣມທ່ອງເວັບຂອງທ່ານທັງໝົດກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">ສະແດງທາງລັດການຊອກຫາຮູບສະເໝີ</translation>
<translation id="8069447462453318634">ເລືອກ "ປັກໝຸດໄວ້ຢູ່ແຖບເຄື່ອງມື"</translation>
<translation id="8519423983825025511">ປິດການນຳໃຊ້ Phromium ທີ່ເຮັດວຽກໃນພື້ນຫຼັງສຳລັບແອັບ</translation>
<translation id="80790299200510644">ຊອກຫາຮູບ</translation>
<translation id="8086881907087796310">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກຄອມພິວເຕີຂອງທ່ານບໍ່ເປັນໄປຕາມຂໍ້ກຳນົດຂັ້ນຕ່ຳສຳລັບຮາດແວ.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="7988414336652558428">Phromium ຕ້ອງການການອະນຸຍາດສະຖານທີ່ສຳລັບເວັບໄຊນີ້</translation>
<translation id="1778610353097215460">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ເປີດການນຳໃຊ້ການແຈ້ງເຕືອນການຕິດຕາມລາຄາ.</translation>
<translation id="4182143801062869250">ຮັບການແຈ້ງເຕືອນລາຄາຫຼຸດລົງສຳລັບສິນຄ້າທີ່ທ່ານສົນໃຈດ້ວຍແອັບ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="8118331347066725040">ສົ່ງຄຳຕິຊົມສຳລັບການຊອກຫາດ້ວຍ Lens</translation>
<translation id="849080025203861031">ປັບປ່ຽນ Phromium ໃນແບບຂອງທ່ານ</translation>
<translation id="8133124826068723441">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກການຊິ້ງຂໍ້ມູນບໍ່ສາມາດໃຊ້ໄດ້ສຳລັບໂດເມນຂອງທ່ານ.</translation>
<translation id="813913629614996137">ກຳລັງລິເລີ່ມ...</translation>
<translation id="139377652856781272">ເປີດ Gemini ໃນ Phromium ດ້ວຍຄີລັດ.</translation>
<translation id="8577594891153686998">ຂໍ້ກຳນົດບໍລິການເພີ່ມເຕີມຂອງ Phromium</translation>
<translation id="6418547610462348357">ໄຟລ໌ນີ້ເປັນອັນຕະລາຍ, ສະນັ້ນ Phromium ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="8177472873527554730">ບໍ່ພົບເນື້ອຫາໃນໜ້າ</translation>
<translation id="6257816439683677727">ໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີຂອງທ່ານ, <ph name="USER_EMAIL" /></translation>
<translation id="820759916613250543">ຊອກຫາຮູບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="8221491193165283816">ໂດຍປົກກະຕິແລ້ວທ່ານບລັອກການແຈ້ງເຕືອນ. ເພື່ອອະນຸຍາດໃຫ້ເວັບໄຊນີ້ແຈ້ງເຕືອນທ່ານ, ກະລຸນາຄລິກບ່ອນນີ້.</translation>
<translation id="8672013454464753607">ເພື່ອໃຊ້ກ້ອງຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Phromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
<translation id="8006746139865532235">Phromium ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ ແລະ ມັນອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ Phromium ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວ.</translation>
<translation id="5474258904581730105">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, Phromium ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ Google. ທ່ານສາມາດປິດສິ່ງນີ້ໃນການຕັ້ງຄ່າໄດ້ທຸກເວລາ.</translation>
<translation id="5375524124600974413">ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ໃໝ່ບໍ?</translation>
<translation id="5242991719841602450"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="6524280192518819368">ສະແດງ Gemini ໃນ Phromium ໃນຖາດລະບົບ ແລະ ເປີດຄີລັດ</translation>
<translation id="2082268001133511745"><ph name="BEGIN_LINK" />Phromium ຈະເຕືອນທ່ານ<ph name="END_LINK" /> ກ່ຽວກັບເວັບໄຊ ແລະ ການດາວໂຫຼດທີ່ບໍ່ປອດໄພ</translation>
<translation id="4030955203048827163">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Phromium ໄດ້ລຶບສິດເຂົ້າເຖິງ <ph name="PERMISSION" /> ອອກແລ້ວ.</translation>
<translation id="8358344509940735943">ເລືອກຊື້, ແປພາສາ ແລະ ລະບຸສິ່ງທີ່ທ່ານເຫັນດ້ວຍກ້ອງຂອງທ່ານຢູ່ແອັບ Phromium iOS</translation>
<translation id="7062802333437169650">ລະຫັດ QR ເພື່ອເຂົ້າສູ່ລະບົບ Phromium ໃນຊື່ <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062">ອົງກອນຂອງທ່ານປິດ Phromium ໄວ້ເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">ບັນທຶກເປັນຮູບ</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" /> ເຄີຍໃຊ້ Phromium ໃນເມື່ອກ່ອນ</translation>
<translation id="5445795756751365814">ເປີດການນຳໃຊ້ທັກສະໃນ Phromium</translation>
<translation id="7329745364783464770">ອັບເດດ Phromium ເພື່ອສືບຕໍ່ນຳໃຊ້ຂໍ້ມູນ Phromium ໃນບັນຊີ Google ຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="5255856786869089460">ເພື່ອໄດ້ຮັບການອັບເດດ Phromium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 8.</translation>
<translation id="8362914115861174987">ແປພາສາເປັນ</translation>
<translation id="8367705492654390392">ຖາມຫຍັງກໍໄດ້</translation>
<translation id="8370517070665726704">ລິຂະສິດ <ph name="YEAR" /> Google LLC. ສະຫງວນສິດທັງໝົດ.</translation>
<translation id="7349410893766975486">ເພື່ອຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium. ລະບົບຈະບັນທຶກລະຫັດຜ່ານນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="394196307309768356">ຈາກນັ້ນທ່ານຈະຕ້ອງຣີສະຕາດ Phromium.</translation>
<translation id="7466825726005300631">Phromium ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" /></translation>
<translation id="264088846642173954">ນັກພັດທະນາຍົກເລີກການເຜີຍແຜ່ສ່ວນຂະຫຍາຍນີ້ແລ້ວ ແລະ ອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ Phromium ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="1867604241588004166">Phromium ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານກ່ອນຈະບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ຈະຖືກລຶບ.</translation>
<translation id="926481158288852551">{0,plural, =1{ເປີດໃຊ້ Phromium ຄືນໃໝ່ພາຍໃນໜຶ່ງມື້}other{ເປີດໃຊ້ Phromium ຄືນໃໝ່ພາຍໃນ # ມື້}}</translation>
<translation id="8438543370129609977">ເມື່ອທ່ານໃຊ້ຄຸນສົມບັດຊອກຫາຮູບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີ. <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">ສຶກສາເພີ່ມເຕີມກ່ຽວກັບການຊອກຫາດ້ວຍການຊອກຫາຮູບໃນ Phromium</translation>
<translation id="1069576136282928177">ຄັງຕົວຕິດຕັ້ງຖືກເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້. ກະລຸນາດາວໂຫຼດ Phromium ອີກ.</translation>
<translation id="7082388216101480391">Phromium ຕ້ອງໃຊ້ Windows 10 ຂຶ້ນໄປ.</translation>
<translation id="8463672209299734063">ຕົວເລືອກເສີມ: ຊ່ວຍປັບປຸງຄຸນສົມບັດ ແລະ ປະສິດທິພາບຂອງ ChromiumOS ໂດຍການສົ່ງຂໍ້ມູນການວິນິໄສ ແລະ ການນຳໃຊ້ໄປໃຫ້ Google ໂດຍອັດຕະໂນມັດ.</translation>
<translation id="4343027289807602417">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາຢັ້ງຢືນວ່າແມ່ນທ່ານ</translation>
<translation id="6746404578800969443">ສະແດງຂໍ້ຄວາມເພື່ອເຂົ້າສູ່ລະບົບຫາ Phromium</translation>
<translation id="5072642661707587697">Phromium ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="759684005114911774">ຂໍຂອບໃຈທີ່ເລືອກ Phromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ!</translation>
<translation id="5209258538041302334">Phromium ສາມາດກວດເບິ່ງລະຫັດຜ່ານຂອງທ່ານເມື່ອທ່ານບັນທຶກພວກມັນໄວ້</translation>
<translation id="8525579356836940628">ຢຸດການຕິດຕັ້ງແລ້ວ</translation>
<translation id="6348113608284833604">ເຂົ້າເຖິງລະຫັດຜ່ານ, ແຖບ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="5083347044281842800">ຮັບຄຳເຕືອນຫາກ Phromium ພົບໜຶ່ງໃນລະຫັດຜ່ານຂອງທ່ານໃນການລະເມີດຂໍ້ມູນສາທາລະນະ</translation>
<translation id="8555465886620020932">ບໍລິການຜິດພາດ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">ຄຸນສົມບັດ ແລະ ສ່ວນຂະຫຍາຍບາງຢ່າງຂອງ Phromium ມາພ້ອມກັບທາງລັດ. ທ່ານສາມາດເລືອກທີ່ຈະເປີດໃຊ້ອີກຄັ້ງໄດ້.</translation>
<translation id="8556420416730706394">ທ່ານສາມາດປັກໝຸດການຊອກຫາຮູບເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ; ໂດຍການຄລິກປຸ່ມປັກໝຸດຢູ່ເທິງສຸດຂອງແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="856656450041460113">ຊອກຫາລາຍການພາສາ</translation>
<translation id="9159785833243360958">ຫຼາຍອົງການຈັດການ Phromium</translation>
<translation id="8586442755830160949">ລິຂະສິດ <ph name="YEAR" /> ຜູ້ຂຽນ Chromium. ສະຫງວນສິດທັງໝົດ.</translation>
<translation id="3489957831482527036">ກຳລັງເປີດໃຊ້ Phromium...</translation>
<translation id="8624541899164515475">ການຕັ້ງຄ່າ, ເປີດໃນແຖບໃໝ່.</translation>
<translation id="8648201657708811153">ບໍ່ສາມາດຕັ້ງ Google Chrome ສຳລັບການທົດສອບເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານໄດ້.</translation>
<translation id="7150069986792019616">ຊອກຫາດ້ວຍ Phromium ໄດ້ຈາກທຸກບ່ອນ</translation>
<translation id="1623850835554120265">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ Phromium ຫຼືຄົ້ນຫາຈາກ Omnibox.</translation>
<translation id="8828478112210313529">ເພື່ອສົ່ງແຖບນີ້ໄປຫາອຸປະກອນອື່ນ, ໃຫ້ເຂົ້າສູ່ລະບົບຫາ Phromium ຢູ່ບ່ອນນັ້ນ</translation>
<translation id="3592747099485557650">ນີ້​ແມ່ນ Phromium ຂອງ​ທ່ານ</translation>
<translation id="8712637175834984815">ເຂົ້າໃຈແລ້ວ</translation>
<translation id="3388228047978619624">ເຂົ້າສູ່ລະບົບ Phromium ບໍ?</translation>
<translation id="8747073452963259673">ມຸມຊ້າຍລຸ່ມຂອງພື້ນທີ່ຊອກຫາ: ຊ້າຍ <ph name="LEFT" />%, ລຸ່ມ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຜູ້ເບິ່ງແຍງລະບົບເຄືອຂ່າຍຂອງທ່ານໃຊ້ນະໂຍບາຍລະດັບກຸ່ມເຊິ່ງປ້ອງກັນການຕິດຕັ້ງ: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">ແຈ້ງເຕືອນຂ້ອຍໃນພາຍຫຼັງ</translation>
<translation id="614494151403742465">ແບ່ງປັນເອກະສານນີ້ກັບ Gemini ໃນ Phromium ເພື່ອຮັບພາບຮວມໂດຍຫຍໍ້ ແລະ ຖາມຄຳຖາມຕິດຕາມຜົນ</translation>
<translation id="6346068443590018348">ເຂົ້າສູ່ລະບົບ Phromium ບໍ?</translation>
<translation id="1468806565762231794">ຕັ້ງ Phromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="8826492472752484139">ຄລິກ “ຕົວຈັດການລະຫັດຜ່ານ”</translation>
<translation id="8833697763442816810">ລະບົບ ChromiumOS</translation>
<translation id="4854784568701005121">ລະບົບຈະໃຊ້ພາສານີ້ເພື່ອສະແດງເມນູ, ການຕັ້ງຄ່າ, ແຈ້ງເຕືອນ ແລະ ຂໍ້ຄວາມອື່ນໆໃນ Phromium</translation>
<translation id="8862326446509486874">ທ່ານບໍ່ມີສິດທິທີ່ເໝາະສົມສໍາລັບຕິດຕັ້ງ​ໃນລະດັບລະບົບ. ລອງແລ່ນຕົວຕິດຕັ້ງນີ້ອີກ​ໃນ​ຖານະ​ເປັນ​ຜູ້ຄວບຄຸມ.</translation>
<translation id="7804139416589625033">ເພີ່ມໂປຣໄຟລ໌ Phromium</translation>
<translation id="6333867241557949259">ChromiumOS ບໍ່ສາມາດບັນທຶກຂໍ້ມູນ Phromium ໃນບັນຊີ Google ຂອງທ່ານໄດ້ເນື່ອງຈາກເກີດຂໍ້ຜິດພາດໃນການເຂົ້າສູ່ລະບົບ</translation>
<translation id="2888440364511152939">ອົງກອນຂອງທ່ານກຳນົດໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="7111325571010992010">Phromium ກໍາລັງພະຍາຍາມສະແດງລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດອັນນີ້.</translation>
<translation id="4406716425954955281">Phromium ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານອີກຕໍ່ໄປ. ຕັ້ງຄ່າ Phromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນບໍ?</translation>
<translation id="2999847959360823770">ບໍ່ສາມາດອັບເດດ Phromium ໄດ້</translation>
<translation id="8944232836376404813">ການດຳເນີນການນີ້ຈະເຮັດສິ່ງຕໍ່ໄປນີ້
          <ph name="LINE_BREAKS" />
            • ຣີເຊັດໜ້າເລີ່ມຕົ້ນ, ໜ້າແຖບໃໝ່, ໂປຣແກຣມຊອກຫາ ແລະ ແຖບທີ່ປັກໝຸດແລ້ວຂອງທ່ານ
            <ph name="LINE_BREAK" />
            • ປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍ
            <ph name="LINE_BREAK" />
            • ລຶບຄຸກກີ້ ແລະ ຂໍ້ມູນເວັບໄຊຊົ່ວຄາວອື່ນໆ
            <ph name="LINE_BREAKS" />
            ການດຳເນີນການນີ້ຈະບໍ່ມີຜົນກັບບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້.</translation>
<translation id="7461167469691640632">ສະແດງທາງລັດເວັບໄຊ Phromium</translation>
<translation id="7394133813796947510">ໂລໂກ້ Phromium Enterprise</translation>
<translation id="2476839923452631964">ນຳຄວາມປອດໄພຂອງ Google ໄປໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ Phromium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="2041306781031361744">ບໍ່ສາມາດເລີ່ມ Phromium ໄດ້ເນື່ອງຈາກມີບາງຢ່າງຜິດພາດເກີດຂຶ້ນເມື່ອເປີດໂປຣໄຟລ໌ຂອງທ່ານ. ລອງຣີສະຕາດ Phromium.</translation>
<translation id="8355079108092011401">ເພື່ອຊອກຫາດ້ວຍ Phromium ຫຼື ປັບແຕ່ງໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າ<ph name="END_LINK" /></translation>
<translation id="820370893610994443">ຈັດການໂປຣໄຟລ໌ Phromium</translation>
<translation id="1885039203623228439">ໃຊ້ແປ້ນພິມຂອງທ່ານເພື່ອນຳທາງລະຫວ່າງ Gemini ໃນ Phromium ແລະ ແຖບທີ່ເປີດຢູ່ຂອງທ່ານ.</translation>
<translation id="9018218886431812662">ສຳເລັດການຕິດຕັ້ງແລ້ວ</translation>
<translation id="8213523024005590363">ເພື່ອເຮັດໃຫ້ Phromium ປອດໄພຂຶ້ນ, ພວກເຮົາປິດໃຊ້ງານບາງສ່ວນການ​ຕໍ່​ເຂົ້າ​ຫາ ທີ່​ບໍ່​ໄດ້​ເຮັດ​ເປັນ​ລາຍ​ການ​ໄວ້​ຢູ່​ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ແລະ​ອາດ​ຈະ​ຖືກ​ເອົາ​ເພີ່ມ​ເຂົ້າ​ໂດຍ​ທີ່​ທ່ານ​ບໍ່​ຮູ້​ຈັກ.</translation>
<translation id="1376667286722804744">ລົງຊື່ເຂົ້າ​ໃຊ້ Phromium</translation>
<translation id="5142314855184111999">ສະແດງການຊອກຫາດ້ວຍ Phromium ໃນແຖບເມນູຂອງ Mac ແລະ ເປີດຄີລັດ</translation>
<translation id="5166485487967090892">Phromium ບລັອກການດາວໂຫຼດນີ້ເພາະວ່າໄຟລ໌ທີ່ເກັບໄວ້ໃນແຟ້ມມີໄຟລ໌ອື່ນໆທີ່ອາດຈະເຊື່ອງເມົາແວໄວ້</translation>
<translation id="1902493242619542969">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບ. ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ ແລະ ມັກໄດ້ຢ່າງງ່າຍດາຍໂດຍອັບເດດໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານເປັນ Phromium. ລະບົບຈະປັກໝຸດ Phromium ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວ.</translation>
<translation id="7092992855996941035">ໃຊ້ເຄື່ອງມື AI ທີ່ດີທີ່ສຸດຂອງ Google ດ້ວຍແອັບ Phromium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="4203475068093609811">ເພື່ອເຂົ້າເຖິງລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Phromium</translation>
<translation id="7699507532215026981">ເຂົ້າສູ່ລະບົບ Phromium ເມື່ອທ່ານເຂົ້າສູ່ລະບົບບໍລິການອື່ນໆຂອງ Google</translation>
<translation id="5571207595456818809">Phromium ຖືກປິດໂດຍອັດຕະໂນມັດ</translation>
<translation id="3670200098293484473">Phromium ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="5636382052119887392">{0,plural, =1{Phromium ຈະເປີດຄືນໃໝ່ໃນໜຶ່ງຊົ່ວໂມງ}other{Phromium ຈະເປີດຄືນໃໝ່ໃນ # ຊົ່ວໂມງ}}</translation>
<translation id="9106236359747881194">ເລືອກຂໍ້ຄວາມທີ່ຈະຊອກຫາ</translation>
<translation id="9197093250229894135">ເພື່ອໄດ້ຮັບການອັບເດດ Phromium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 8.1.</translation>
<translation id="7195134700293253698">ເປີດລິ້ງໃນແຖບ Phromium ໃໝ່</translation>
<translation id="911206726377975832">ລຶບຂໍ້ມູນການທ່ອງເນັດຂອງທ່ານນໍາບໍ?</translation>
<translation id="9134482777260927479">ຄວາມຊ່ວຍເຫຼືອໃນການເຮັດວຽກບ້ານ</translation>
<translation id="9148058034647219655">ອອກ</translation>
<translation id="8888942844777295083">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: Phromium ສາມາດກູ້ຄືນແຖບຂອງທ່ານໄດ້ທຸກຄັ້ງທີ່ທ່ານປິດເປີດໃໝ່. ເພື່ອເປີດໃຊ້ສິ່ງນີ້, ໃຫ້ໄປຫາ</translation>
<translation id="1485079858205975514">ຜູ້ເບິ່ງແຍງລະບົບໄດ້ກຳນົດຄ່າ Phromium ໃຫ້ເປີດໂປຣແກຣມທ່ອງເວັບສຳຮອງເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="1096075777207775410">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;Phromium</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">ຕັ້ງຄ່າ Phromium ໃນແບບຂອງທ່ານເອງ</translation>
<translation id="6554170182570636227">Phromium ອາດຈະບໍ່ເຮັດວຽກຢ່າງຖືກຕ້ອງ ເພາະວ່າມັນບໍ່ຖືກຮອງຮັບໃນ Windows XP ຫຼື Windows Vista ອີກຕໍ່ໄປ</translation>
<translation id="8145475184469284022">ໃຊ້ຄຸນສົມບັດຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ Phromium.</translation>
<translation id="945522503751344254">ສົ່ງ​ຄໍາ​ຄິດ​​ເຫັນ</translation>
<translation id="1258071069834143371">ໃຜກຳລັງໃຊ້ Phromium)</translation>
<translation id="8272911737374467274">ໃຊ້ຄວາມປອດໄພຂັ້ນສູງສຸດຂອງ Phromium</translation>
<translation id="983803489796659991">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກເຊີບເວີອັບເດດບໍ່ມີຂໍ້ມູນ hash ໃດໆສຳລັບແອັບພລິເຄຊັນ.</translation>
<translation id="4087190600867587768">ໃຊ້ Phromium ໂດຍບໍ່ມີບັນຊີ</translation>
<translation id="985602178874221306">ຜູ້ຂຽນ Chromium</translation>
<translation id="989970834842471429">ເລືອກຂໍ້ຄວາມ ຫຼື ຮູບເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="6649431194696226496">ເພື່ອໃຊ້ສະຖານທີ່ຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Phromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
</translationbundle>