<!DOCTYPE translationbundle>
<translationbundle lang="sr-Latn">
<translation id="1026101648481255140">Nastavi instalaciju</translation>
<translation id="1029669172902658969">Ponovo pokreni da bi se &amp;Chromium OS ažurirao</translation>
<translation id="7962340570690354348">Phromium preporučuje da pregledate ovaj dodatak</translation>
<translation id="2702007788032964762">Kada sajt zatraži da privatno predučitava linkove na stranici, Phromium koristi Google servere. Na taj način se vaš identitet krije od predučitanog sajta, ali Google saznaje koji sajtovi su unapred učitani.</translation>
<translation id="1051793555070215510">Pomozite nam da poboljšamo režim bez arhiviranja tako što ćete popuniti ovu jednominutnu anketu.</translation>
<translation id="1065672644894730302">Podešavanja ne mogu da se pročitaju.

Neke funkcije su možda nedostupne i promene podešavanja neće biti sačuvane.</translation>
<translation id="4964836565882496625">Roditelj je isključio Dozvole za sajtove, aplikacije i dodatke za Phromium</translation>
<translation id="8409497136174302488">Phromium traži pristup vašoj lokalnoj mreži da bi mogao da pronađe i koristi uređaje u blizini</translation>
<translation id="4388904545107211948">Da biste pretražili određenu Phromium funkciju ili dodatak, unesite njihovu prečicu u traku za adresu, a zatim pritisnite izabrani taster na tastaturi</translation>
<translation id="7188624550427159072">Prikaži pretragu pomoću Phromium-a na sistemskoj paleti i uključi tastersku prečicu</translation>
<translation id="3689248207461565136">Phromium želi da izveze lozinke. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="112640046208448578">Identifikujte stvari ili mesta i kopirajte ili prevodite tekst. Kada koristite pretragu slika, snimak ekrana stranice se šalje na server. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium je podrazumevani pregledač</translation>
<translation id="5414044255592121327">Da biste proverili da li su lozinke bezbedne od upada u podatke i drugih bezbednosnih problema, <ph name="BEGIN_LINK" />prijavite se u Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Kliknite na Phromium meni</translation>
<translation id="1157985233335035034">Nedavni jezici</translation>
<translation id="1184145431117212167">Instalacija nije uspela jer vaša verzija Windows-a nije podržana.</translation>
<translation id="7861581212703831457">O Phromium-u</translation>
<translation id="8752630985505435738">Dobijajte obaveštenja o praćenju cena uz Phromium na telefonu</translation>
<translation id="1203500561924088507">Hvala vam na instalaciji. Potrebno je da restartujete pregledač pre nego što počnete da koristite <ph name="BUNDLE_NAME" />.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> je na čekanju. Da bi pregledanje bilo bezbedno, Phromium će se ažurirati sledeći put kad budete neaktivni <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">Kada otvorite pretragu slika, naslov, URL i sadržaj stranice, uključujući PDF-ove, automatski se šalju na server. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">Dok ste prijavljeni, možete da koristite lozinke i drugo sa Google naloga u Phromium-u. Da biste to promenili, idite na Nalog u Phromium-u.</translation>
<translation id="7402478829083317456">Prikaži Gemini u Phromium-u na traci menija Mac-a</translation>
<translation id="4902531791098430822">Da biste izabrali deo ekrana u Gemini-ju u Phromium-u, koristite tastersku prečicu.</translation>
<translation id="9002284132405311162">Dok je ova kartica bila neaktivna, memorija je oslobođena da bi Phromium bio brz. Možete da odaberete da uvek izuzmete ovaj sajt iz neaktivnosti.</translation>
<translation id="5561666811965903444">Phromium je blokirao ovo preuzimanje jer je ovaj fajl opasan</translation>
<translation id="1340271056805240721">Kada se prijavljujete u Google usluge kao što su Gmail ili YouTube pomoću naloga <ph name="USER_EMAIL" />, možete automatski da se prijavite u Phromium pomoću istog naloga</translation>
<translation id="5048805453292757697">Preuzmite Phromium na telefon</translation>
<translation id="1290883685122687410">Greška pri podešavanju: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">Podesite nov Phromium profil</translation>
<translation id="7871721155662336863">Isprobajte sa Gemini-jem u Phromium-u</translation>
<translation id="6569288432960798043">Phromium zahteva pristup Bluetooth-u da bi istraživao
 Bluetooth uređaje. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">Prijavite se u Phromium na telefonu</translation>
<translation id="1330562121671411446">Otkriveni jezik</translation>
<translation id="1619655755195586133">Izbriši i podatke iz Phromium-a (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Zakačeno je. Možete ponovo da pristupite pretrazi slika pomoću novog dugmeta na traci s alatkama</translation>
<translation id="1383876407941801731">Pretraži</translation>
<translation id="2947996037737257951">Nastavite sa pregledanjem u pokretu uz aplikaciju Phromium</translation>
<translation id="141901961143729572">Delite razmišljanja</translation>
<translation id="8355386219605656974">Da biste delili prozor, dozvolite snimanje ekrana za Phromium u podešavanjima sistema.</translation>
<translation id="1478370723027452770">Potražite pomoć za verziju Chrome for Testing</translation>
<translation id="8398257182826094665">Prijavite se u Phromium da biste pristupali sačuvanim informacijama i drugom sa uređaja <ph name="DEVICE" /></translation>
<translation id="1497802159252041924">Greška pri instalaciji: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Ova stranica je zaštićena</translation>
<translation id="3484755999946650557">Delite Phromium karticu</translation>
<translation id="3309377459597801353">Prijavi me u Phromium</translation>
<translation id="1547469039832541117">Završava istaknuti zadatak.</translation>
<translation id="2354363290397602683">Zakači Phromium</translation>
<translation id="2244728813494358888">Phromium alatke za bezbednost</translation>
<translation id="707582364915018531">Phromium želi da izbriše podatke Menadžera lozinki. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{Administrator zahteva da ponovo pokrenete Phromium da biste primenili ažuriranje}=1{Administrator zahteva da ponovo pokrenete Phromium da biste primenili ažuriranje. Prozor bez arhiviranja se neće ponovo otvoriti.}one{Administrator zahteva da ponovo pokrenete Phromium da biste primenili ažuriranje. # prozor bez arhiviranja se neće ponovo otvoriti.}few{Administrator zahteva da ponovo pokrenete Phromium da biste primenili ažuriranje. # prozora bez arhiviranja se neće ponovo otvoriti.}other{Administrator zahteva da ponovo pokrenete Phromium da biste primenili ažuriranje. # prozora bez arhiviranja se neće ponovo otvoriti.}}</translation>
<translation id="5032531544901236587">Koristite Google na najbolji način uz aplikaciju Phromium na telefonu</translation>
<translation id="7311082384439462587">Pregledajte ključne kontrole privatnosti i bezbednosti u Phromium-u</translation>
<translation id="1640672724030957280">Preuzimanje...</translation>
<translation id="1665602916345474427">Prijavljeni ste kao <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, sa pretplatom. Otvori meni naloga</translation>
<translation id="4535436467771816034">Možete da koristite Phromium svaki put kada kliknete na linkove u porukama, dokumentima i drugim aplikacijama. Biće zakačen i na traku zadataka.</translation>
<translation id="1709772298389099340">Pruža pune privilegije za <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">To će vam omogućiti da birate sa dostupnih uređaja i da prikazujete sadržaj na njima.</translation>
<translation id="3550860956769006392">Phromium će uskoro izbrisati podatke pregledanja</translation>
<translation id="2053384509423635834">Phromium će probati da nadogradi navigacije na HTTPS</translation>
<translation id="2516115567501600458">Phromium podaci su obrisani</translation>
<translation id="8571959122390670188">Phromium će se restartovati za <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">Kada HTTPS nije dostupan, Phromium će koristiti nebezbednu vezu bez upozorenja</translation>
<translation id="5872244334553252095">Neka Phromium radi u pozadini</translation>
<translation id="2213761221916953829">Da bismo učinili Phromium bezbednijim, onemogućili smo neke dodatke koje ne navodi <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> i koji su možda dodati bez vašeg znanja.</translation>
<translation id="8807881428325438878">Kliknite na <ph name="BEGIN_BOLD" />Da<ph name="END_BOLD" /> u Windows obaveštenju da biste zakačili Phromium na traku zadataka radi brzog pristupa.</translation>
<translation id="6861833596843600606">Ponovo instaliraj Phromium</translation>
<translation id="3950056404221550225">Phromium pokušava da <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950">Korisnik <ph name="EXISTING_USER" /> je već prijavljen. Da bi vam pregledanje bilo razdvojeno, prijavite se u Phromium preko svog profila kao <ph name="USER_EMAIL_ADDRESS" />. Moći ćete da preuzmete i dodatke i drugo sa uređaja <ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">Sledeći put kada otvorite Phromium na uređaju <ph name="DEVICE_TYPE" />, videćete upit da koristite Google menadžer lozinki.</translation>
<translation id="1838374766361614909">Obrišite pretragu</translation>
<translation id="2724678689951174927">Da biste izbrisali podatke pregledanja samo sa ovog uređaja, ali ne i sa Google naloga, <ph name="BEGIN_LINK" />odjavite se iz Phromium-a<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">Preuzmite Phromium na telefon da biste u pokretu otvarali ili pravili nove grupe kartica.</translation>
<translation id="3191814926523151519">Možete da upravljate Google nalozima na koje ste prijavljeni. Google nalozi se koriste za Phromium pregledač, Play prodavnicu, Gmail i drugo. Ako želite da dodate nalog za nekog drugog, npr. člana porodice, umesto toga dodajte novu osobu na svoj uređaj <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Saznajte više<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Pretražuj pomoću pretrage slika</translation>
<translation id="5453573140402957471">Korisnik <ph name="EXISTING_USER" /> je već prijavljen. Da bi vam pregledanje bilo razdvojeno, prijavite se u Phromium preko svog profila kao <ph name="USER_EMAIL_ADDRESS" />. Dobićete i obeleživače i drugo sa <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Izaberite tekst</translation>
<translation id="1236934630660512644">Prijavljujete se pomoću naloga kojim se upravlja i dajete njegovom administratoru kontrolu nad Phromium profilom. Phromium podaci, kao što su aplikacije, obeleživači, istorija, lozinke i druga podešavanja, biće trajno povezani sa nalogom <ph name="USER_NAME" />. Moći ćete da izbrišete te podatke preko Kontrolne table Google naloga, ali nećete moći da ih povežete sa nekim drugim nalogom. Možete opcionalno da napravite novi profil da bi postojeći Phromium podaci ostali odvojeni. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium štedi bateriju tako što ograničava aktivnosti u pozadini i vizuelne efekte, kao što je glatko skrolovanje i brzine kadrova videa. <ph name="BEGIN_LINK" />Saznajte više o Uštedi energije<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Usluga ažuriranja Phromium-a</translation>
<translation id="5797624919204275541">Kada to uključite, možete da se prijavljujete na Google sajtove, kao što je Gmail, ali se ne prijavljujete u Phromium</translation>
<translation id="6850971726764387814">Phromium ne reaguje. Želite li da ga odmah ponovo pokrenete?</translation>
<translation id="8289779763124483945">Vaša organizacija, <ph name="MANAGER" />, zahteva da se prijavite u Phromium</translation>
<translation id="193439633299369377">Treba da restartujete Chromium OS da biste primenili ažuriranje.</translation>
<translation id="3215238748514810076">Phromium je blokirao ovo preuzimanje jer se ovaj tip fajl ne preuzima često i može da bude opasan</translation>
<translation id="1953553007165777902">Preuzima se... Još <ph name="MINUTE" /> min</translation>
<translation id="8529252122707161160">Phromium ne može da odredi ni da podesi podrazumevani pregledač</translation>
<translation id="197326043290947695">Pregledajte pametnije uz pretragu slika</translation>
<translation id="7769772561254542263">Saznajte zašto Phromium blokira neke fajlove, otvara se na novoj kartici</translation>
<translation id="3713013456746186442">Ažurira Phromium softver. Ako je ova usluga onemogućena ili zaustavljena, Phromium softver neće biti ažuriran, što znači da neće biti moguće otkloniti bezbednosne propuste koji mogu da nastanu i da funkcije možda neće raditi. Ova usluga se deinstalira kada je ne koristi nijedan Phromium softver.</translation>
<translation id="5690439379999550641">Ovim ćete izbrisati 1 stavku sa ovog uređaja. Da biste kasnije vratili podatke, prijavite se u Phromium kao <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalacija nije uspela. Probajte ponovo.</translation>
<translation id="2039417478970545937">Podešavanja.</translation>
<translation id="4765042254400173473">Odaberite da li ćete uvrstiti istoriju Phromium-a radi personalizovanijih doživljaja u Google uslugama</translation>
<translation id="1448229429009113044">Ugrađen je u Phromium da bi vam pomogao da pravite, čuvate i automatski popunjavate jake lozinke. Dodajte prečicu radi lakšeg pristupa.</translation>
<translation id="2145664943269651168">Kliknite na dugme Prilagodi Phromium na stranici nove kartice da biste Phromium-u dali nov izgled</translation>
<translation id="6052463185672312901">Phromium je blokirao ovo preuzimanje jer je ovaj fajl obmanjujući i može da izvrši neočekivane promene na uređaj</translation>
<translation id="3825064703718009924">Sledeći put kada otvorite Phromium iOS, videćete upit da isprobate <ph name="FEATURE_NAME" />.</translation>
<translation id="886729435477608858">Lozinke i drugi Phromium podaci koje ste sačuvali na Google nalogu biće uklonjeni sa ovog uređaja. Da biste ih ponovo koristili u Phromium-u, ponovo se prijavite.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Organizacija automatski briše podatke pregledanja kada se Phromium ne koristi 1 minut. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}one{Organizacija automatski briše podatke pregledanja kada se Phromium ne koristi # minut. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}few{Organizacija automatski briše podatke pregledanja kada se Phromium ne koristi # minuta. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}other{Organizacija automatski briše podatke pregledanja kada se Phromium ne koristi # minuta. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}}</translation>
<translation id="2125838419757773031">Izaberite deo ekrana za pretragu</translation>
<translation id="2126108037660393668">Verifikacija preuzetog fajla nije uspela.</translation>
<translation id="2135919691573380097">Prijavite ovaj sajt</translation>
<translation id="2137162749895930932">Zatvorite ekran za prevođenje</translation>
<translation id="2147218225094845757">Sakrij bočnu tablu</translation>
<translation id="1628700182434635922">Phromium je blokirao ovo preuzimanje jer ovaj sajt ne koristi bezbednu vezu, pa je fajl možda neovlašćeno menjan</translation>
<translation id="2170098639895543546">Izaberite bilo šta na stranici</translation>
<translation id="1807571394075492085">Prilagodite Phromium</translation>
<translation id="2174917724755363426">Instalacija nije dovršena. Želite stvarno da je otkažete?</translation>
<translation id="8332848361915479268">Phromium – prijavljivanje na mrežu – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Greška sa proverom ažuriranja: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Ukloni nalog iz Phromium-a</translation>
<translation id="6063124961634921864">Koristite aplikaciju Phromium i ponesite sa sobom najbolje alatke za kupovinu</translation>
<translation id="8646569091716523420">Budite bezbedniji u pokretu uz poboljšano bezbedno pregledanje u Phromium-u za iOS</translation>
<translation id="3084983792533696835">Opasan sajt. Phromium je uklonio obaveštenja.</translation>
<translation id="2236949375853147973">Moje aktivnosti</translation>
<translation id="6387327671844988108">Da bi vam adrese i drugi sadržaj bili dostupni na svim uređajima, prijavite se u Phromium. Ova adresa će biti sačuvana na Google nalogu kada se prijavite.</translation>
<translation id="722050260205928409">Ako delite računar, prijatelji i porodica mogu zasebno da pregledaju i da podese Phromium baš onako kako žele.</translation>
<translation id="703211526866942526">Veštine u Phromium-u</translation>
<translation id="2283803047247799269">Pretraži ovu karticu pomoću pretrage slika</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Phromium preporučuje da pauzirate karticu koja usporava pregledač}one{Phromium preporučuje da pauzirate kartice koje usporavaju pregledač}few{Phromium preporučuje da pauzirate kartice koje usporavaju pregledač}other{Phromium preporučuje da pauzirate kartice koje usporavaju pregledač}}</translation>
<translation id="2307973900865360088">Zadrži na traci</translation>
<translation id="6083276764640161328">Proverava URL-ove sa listom nebezbednih sajtova koji se čuvaju u Phromium-u. Ako neki sajt pokuša da ukrade vašu lozinku ili probate da preuzmete štetnu datoteku, Phromium može da pošalje URL-ove, uključujući delove sadržaja stranice, u Bezbedno pregledanje.</translation>
<translation id="2356070529366658676">Pitaj</translation>
<translation id="2359808026110333948">Nastavi</translation>
<translation id="741972887620936671">Dodatak <ph name="EXTENSION_NAME" /> želi da se prijavite u Phromium</translation>
<translation id="4709464915929597251">Onemogući Phromium koji radi u pozadini za aplikacije</translation>
<translation id="6804933363437420201">Da biste koristili ovaj dodatak kao <ph name="USER_EMAIL_ADDRESS" />, prijavite se u Phromium.</translation>
<translation id="2384373936468275798">Chromium OS ne može da sinhronizuje podatke zato što su podaci za prijavljivanje na nalog zastareli.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{Jedan ili više dodataka za Phromium su pristupali 1 HID uređaju}=1{Jedan ili više dodataka za Phromium pristupaju 1 HID uređaju}one{Jedan ili više dodataka za Phromium pristupaju # HID uređaju}few{Jedan ili više dodataka za Phromium pristupaju HID uređajima (#)}other{Jedan ili više dodataka za Phromium pristupaju HID uređajima (#)}}</translation>
<translation id="1394893265611797679">Phromium-u su potrebne dozvole za kameru i mikrofon za ovaj sajt</translation>
<translation id="2403703063067034158">Greška pri pokretanju: Trenutno je pokrenuta druga instanca podešavanja. Probajte ponovo kasnije.</translation>
<translation id="8457868297375575309">Otvarajte linkove u Phromium-u iz bilo koje aplikacije i omogućite pristup pregledaču na traci zadataka</translation>
<translation id="5354209517289935579">Kliknite na dugme Rezimiraj da biste podelili ovaj dokument sa Gemini-jem u Phromium-u radi brzog pregleda i postavljanja dodatnih pitanja</translation>
<translation id="6628402244681586711">Pomoću <ph name="BEGIN_LINK" />Phromium alatki<ph name="END_LINK" /> možete bezbedno da pregledate i zadržite kontrolu</translation>
<translation id="6454834963905669297">Korisnik <ph name="EXISTING_USER" /> je već prijavljen. Da bi vam pregledanje bilo razdvojeno, prijavite se u Phromium preko svog profila kao <ph name="USER_EMAIL_ADDRESS" />. Moći ćete da pristupate i svojim lozinkama i drugom sadržaju na svim uređajima.</translation>
<translation id="2451727308784734061">Koristite prečicu da biste brzo pristupali Menadžeru lozinki. Prečicu možete da premestite na početni ekran računara ili u pokretač aplikacija.</translation>
<translation id="1593547119543498467">Phromium će se uskoro zatvoriti</translation>
<translation id="6814323389195469782">U Phromium-u</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2513154137948333830">Potrebno je restartovanje: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Izaberite tekst pomoću pretrage slika</translation>
<translation id="2643581100433412871">Phromium pokušava da zameni postojeće lozinke. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="4103676945224728292">Phromium traži pristup memorijskom prostoru da bi preuzimao datoteke</translation>
<translation id="8743720024689622265">Phromium pomagač</translation>
<translation id="2575822587468774919">Izaberite bilo šta za pretragu pomoću pretrage slika</translation>
<translation id="8692134707551176334">Da bi vam lozinke i drugi sadržaj bili dostupni na svim uređajima, prijavite se u Phromium</translation>
