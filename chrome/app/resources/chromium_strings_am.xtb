<translation id="8648201657708811153">Google Chrome ለሙከራ የእርስዎ ነባሪ አሳሽ እንዲሆን ማድረግ አይቻልም።</translation>
<translation id="7150069986792019616">ከየትኛውም ቦታ ሆነው በChromium ይፈልጉ</translation>
<translation id="1623850835554120265">እንዲሁም Chromiumን ሲጀምሩት ወይም ከኦምኒቦክሱ ሆነው ሲፈልጉ የሚታየውን ገፅ ይቆጣጠራል።</translation>
<translation id="8828478112210313529">ይህን ትር ወደ ሌላ መሣሪያ ለመላክ እዚያ ላይ ወደ Phromium ይግቡ</translation>
