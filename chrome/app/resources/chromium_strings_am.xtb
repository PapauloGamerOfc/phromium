<translation id="6869568587896659271">ከአድራሻ አሞሌው በታች ላሉ ድር ጣቢያዎች ቀላል መዳረሻ</translation>
<translation id="4011399428346318467">Phromium «<ph name="EXTENSION_NAME" />» ተንኮል አዘል ዌር እንደያዘ አግኝቷል</translation>
<translation id="6877155553248388166">የፍለጋው አካባቢ ከታች በስተቀኝ ጥግ፦ ቀኝ <ph name="RIGHT" />%፣ ከታች <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">ቅዳ</translation>
<translation id="6898028264630240901">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ዓውዳዊ ተግባራትን ፒን ማድረግ ይችላሉ</translation>
<translation id="1012681980425424211">Chromiumን እንደ ነባሪ አሳሽዎ ያቀናብሩ እና የተግባር አሞሌዎ ላይ ፒን ያድርጉት</translation>
<translation id="1744625657438211994">እና የChromium መገለጫዎችን ያስተዳድሩ</translation>
<translation id="7264818828956697552">ይህ እርምጃ የሚከተሉትን ያደርጋል፦
          <ph name="LINE_BREAKS" />
            • የእርስዎን የመነሻ ገጽ፣ አዲስ የትር ገጽ፣ የፍለጋ ፕሮግራም እና ፒን የተደረጉ ትሮችን ዳግም ያስጀምራል
            <ph name="LINE_BREAK" />
            • ቅጥያዎችን ያሰናክላል
            <ph name="LINE_BREAK" />
            • ኩኪዎችን እና ሌላ ጊዜያዊ የጣቢያ ውሂብን ይሰርዛል
            <ph name="LINE_BREAK" />
            • የChromium አቋራጮችን ዳግም ያስጀምራል
            <ph name="LINE_BREAKS" />
            ዕልባቶች፣ ታሪክ እና የተቀመጡ የይለፍ ቃላት አይነኩም።</translation>
<translation id="6489000842445481390">የChromiumን የ<ph name="BOOKMARK_LIMIT" /> እልባቶች ገደብ ላይ ደርሰዋል፣ ስለዚህ አንዳንድ እልባቶችዎ እስካሁን በGoogle መለያዎ ውስጥ አልተቀመጡም።

አንዳንድ እስኪሰርዙ ድረስ አዲስ እልባቶች በመለያዎ ውስጥ መቀመጥ አይችሉም። አሁን ዘግተው ከወጡ ያልተቀመጡ እልባቶች ይሰረዛሉ።</translation>
<translation id="2645108248038996858">አገናኙን በChromium ማን&amp;ነትን በማያሳውቅ መስኮት ውስጥ ክፈት</translation>
<translation id="6965382102122355670">እሺ</translation>
<translation id="6985329841647292029">የChromiumOS ውል</translation>
<translation id="2947519843530032104">Phromium ውሂብን በእርስዎ መለያ <ph name="ACCOUNT_EMAIL" /> ውስጥ ለመጠቀም እና ለማስቀመጥ የይለፍ ሐረግዎን ያስገቡ</translation>
<translation id="7011190694940573312">ይህ የስርዓተ ክወናው ስሪት ስለማይደገፍ መጫኑ አልተሳካም።</translation>
<translation id="7024536598735240744">ተጠናቆ ያለማቅረብ ስህተት፦ <ph name="UNPACK_ERROR" />።</translation>
<translation id="2267652056049724321">Chromiumን የራስዎ ያድርጉት</translation>
<translation id="7047386856539490735">እነዚህ ውጤቶች ጠቃሚ ናቸው?</translation>
<translation id="2448910402556368916">Chromiumን አዘምን</translation>
<translation id="7834049737623892628">አንድ ምስል ጠቃሚ መግለጫ ከሌለው Phromium ለእርስዎ አንድ ለማቅረብ ይሞክራል። ዝርዝር መግለጫዎችን ለመፍጠር፣ ምስሎች ወደ Google ይላካሉ።</translation>
<translation id="1803168627715642217">የChromium መተግበሪያን በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሲጠቀሙ የሰው ሠራሽ አስተውሎት ኃይልን ያግኙ</translation>
<translation id="3321731353906178474">በስልክዎ ላይ ባለው የChromium መተግበሪያ የይለፍ ቃላትዎን፣ ትሮችን እና ሌሎችንም በመሄድ ላይ ይውሰዱ</translation>
<translation id="7141270731789036260">Chromeን ለሙከራ አብጅ</translation>
<translation id="8077731669779275332">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በሚያደርጉበት ማንኛውም ጊዜ Phromium መጠቀም ይችላሉ</translation>
<translation id="611798798247797100"><ph name="EXTENSION_NAME" /> ከChromium አስወግድ</translation>
<translation id="7962394294883785044">ድርጅትዎ የChromium ውሂብን ለ<ph name="TIMEOUT_DURATION" /> ያህል ሥራ ላይ ሳይውል ይሰርዘዋል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።</translation>
<translation id="2611686760870033712">Phromium ለዚህ ጣቢያ የካሜራ ፈቃድ ያስፈልገዋል</translation>
<translation id="71050417052775020">Chromiumን ማስጀመር አልተቻለም። እንደገና ይሞክሩ።</translation>
<translation id="4817060241763895497">በGemini በChromium ውስጥ፣ ባሉበት ሆነው ማንኛውንም ነገር ይጠይቁ</translation>
<translation id="869358700049263961">በማንኛውም ጊዜ Chromiumን በቀላሉ ማግኘት እንዲችሉ በእርስዎ መትከያ ውስጥ ያቆዩት</translation>
<translation id="7094488679340739251">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በሚያደርጉበት ማንኛውም ጊዜ Phromium ይጠቀሙ</translation>
<translation id="7216228761061470870">በዴስክቶፕ ላይ የምስል ፍለጋን ሲጠቀሙ የገጹ ርዕስ፣ ዩአርኤል እና PDFዎችን ጨምሮ ይዘት ወደ አገልጋዩ ይላካሉ</translation>
<translation id="7802634650401946711">ተግባር መሪ - Phromium</translation>
<translation id="5182547787327636348">እንደ ሌሎች መተግበሪያዎች ወይም ፋይሎች ያለ ከChromium ውጭ ስላለ ይዘት ይጠይቁ</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ Phromium ይግቡ። እንዲሁም በሁሉም መሣሪያዎችዎ ላይ የተቀመጠ የእርስዎን መረጃ እና ሌሎችንም ያገኛሉ።</translation>
<translation id="5761733252154904648">በቅጽበት ማሰስ ይጀምሩ፦ አሁን Windows ሲጀምር Phromium መጀመር ይችላል።</translation>
<translation id="7274695763216404502">ፒን ተደርጓል! ከመሣሪያ አሞሌው እንደገና የምስል ፍለጋ ይጠቀሙ</translation>
<translation id="7288567540154601580">ትሮች እና ቅጥያዎች</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{Phromium እንዲያስወግዱት ይመክራል}one{Phromium እንዲያስወግዱት ይመክራል}other{Phromium እንዲያስወግዷቸው ይመክራል}}</translation>
<translation id="1408728332407453335">የሥርዓት ኦዲዮን ለማጋራት የሥርዓት ቅንብሮችን ይክፈቱ እና ለChromium «የሥርዓት የኦዲዮ ቀረጻ ብቻ» ይፍቀዱ። ከዚያ Chromiumን እንደገና ማስጀመር ይኖርብዎታል።</translation>
<translation id="7299899569525778554">ከዴስክቶፕ ይፈልጉ</translation>
<translation id="6194310460545162015">Chromiumን በማዘመን ላይ...</translation>
<translation id="1098154893096691883">የምርጫዎች ፋይልዎ የተበላሸ ወይም ልክ ያልሆነ ነው።

Phromium ቅንብሮችዎን ማስመለስ አልቻለም።</translation>
<translation id="7324051657739063017">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ዓውዳዊ ተግባራትን እንደገና መክፈት ይችላሉ</translation>
<translation id="7024097830259741656">የእርስዎ ድር፣ ዕልባቶች እና ሌሎች የChromium ነገሮች እዚህ ይኖራሉ።</translation>
<translation id="852511575759652041">የእርስዎን የተመሰጠረ ውሂብ ማንበብ የሚችለው የይለፍ ሐረግዎ ያለው ሰው ብቻ ነው። የይለፍ ሐረጉ ወደ Google አይላክም ወይም በGoogle አይከማችም። የእርስዎን የይለፍ ሐረግ ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን Phromium ውሂብ መሰረዝ<ph name="END_LINK" /> ይኖርብዎታል።</translation>
<translation id="2846900085504364505">የእርስዎ ስርዓት አስተዳዳሪ Phromium <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ <ph name="ALTERNATIVE_BROWSER_NAME" />ን እንዲከፍት አዋቅሮታል።</translation>
<translation id="7352651011704765696">የሆነ ችግር ተፈጥሯል</translation>
<translation id="7198690862684855451">የወደፊት የChromium ዝማኔዎችን ለማግኘት macOS 13 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር macOS 12 እየተጠቀመ ነው።</translation>
<translation id="3224607549103501149">በቅርብ ጊዜ አልጎበኙም። Phromium <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" />ን አስወግዷል።</translation>
<translation id="73786666777299047">Chrome የድር መደብርን ይክፈቱ</translation>
<translation id="8446269872172461565">Geminiን በሥርዓት ትሪ ውስጥ በChromium ውስጥ አሳይ</translation>
<translation id="7401687852903179959">ይህን ቪድዮ በምስል ፍለጋ ፈልግ</translation>
<translation id="3403529853122418035">Phromium አሁን የእርስዎ ነባሪ አሳሽ ነው</translation>
<translation id="5649377421626481711">ካቆሙበት ይቀጥሉ፦ Phromium እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት ይመልሳል። ይህን ለማጥፋት ወደሚከተለው ይሂዱ</translation>
<translation id="2467776530444676191">የይለፍ ቃላትን ወደ Phromium ያምጡ</translation>
<translation id="8814480293815136510">1. ከታች <ph name="BUTTON_LABEL" /> ላይ ጠቅ ያድርጉ
2. በWindows ቅንብሮችዎ ውስጥ <ph name="BUTTON_2" /> ላይ ጠቅ ያድርጉ
3. ለፈጣን መዳረሻ Chromiumን በተግባር አሞሌዎ ላይ ለመሰካት በWindows ማሳወቂያ ውስጥ <ph name="BUTTON_3" /> ላይ ጠቅ ያድርጉ</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - Phromium ግንባታ</translation>
<translation id="7450541714075000668">ጽሁፍ ገልብጧል</translation>
<translation id="6826407056979820031">ማይክሮፎንዎን ለመጠቀም <ph name="BEGIN_LINK" />የሥርዓት ቅንብሮች<ph name="END_LINK" /> ውስጥ ለChromium መዳረሻ ይስጡ</translation>
<translation id="1392131731909663319">የወደፊት የChromium ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 7ን እየተጠቀመ ነው።</translation>
<translation id="4512427777724578739">Phromium ዳግም ይጀመር?</translation>
<translation id="4510527847350985067">እየሄደ ያለውን ተመሳሳዩን የChromium ስሪት መጫን አይቻልም። እባክዎ Chromiumን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="7510190804000607802">አስታዋሽ፦ የGoogle ምርጡ በኪስዎ ውስጥ</translation>
<translation id="4735608937705010375">ጣቢያዎች እንደተጠበቀው መስራታቸው አይቀርም። ከGoogle መለያዎ በስተቀር በ Phromium ውስጥ ገብተው ከሆነ፣ ሁሉንም የChromium መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ።</translation>
<translation id="7987051132742764178">{0,plural, =1{Phromium በ1 ደቂቃ ውስጥ ዳግም ይጀመራል}one{Phromium በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}other{Phromium በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="1904271152425995672">ውሂብዎን ለመጠበቅ Phromium እርስዎ በቅርቡ ካልጎበኟቸው ጣቢያዎች ላይ ፈቃዶችን እንዲያስወግድ ይፍቀዱ።</translation>
<translation id="7909976731673595773">በቅጽበት ማሰስ ለመጀመር Chromiumን በራስ-ሰር አስጀምር።</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ጫኝ</translation>
<translation id="3301232962183130807">Phromium ካሜራዎን እና ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="3230129417775002227">Phromium አሁን ይበልጥ ተሻሽሏል</translation>
<translation id="1322165820810533683">አሁን Phromium ውስጥ የሚገኙ ተጨማሪ ባህሪያት አሉዎት</translation>
<translation id="7624307931717240213">ይህን አገልግሎት ለማሻሻል መረጃ እንጠቀማለን። የግላዊነት መመሪያን እና የአገልግሎት ውልን ይመልከቱ።</translation>
<translation id="7649070708921625228">እገዛ</translation>
<translation id="3795437289339745990">የChromium መተግበሪያን ያግኙ</translation>
<translation id="7658239707568436148">ይቅር</translation>
<translation id="6671257169702988694">Phromium ነባሪ አሳሽዎ አይደለም</translation>
<translation id="7270402397025248165">በመላ መሣሪያዎችዎ ላይ Chromiumን ያሳምሩ እና ግላዊነት ያላብሱ</translation>
<translation id="6267574654655324634">Phromium ዝማኔ</translation>
<translation id="4868190765388740513">ሥራዎ Phromium ላይ ደኅንነቱ ተጠብቋል</translation>
<translation id="7716950018788545737">ተግባር(ራት) አልቋል(አልቀዋል)።</translation>
<translation id="77283119132245232">ለ<ph name="BROWSER_NAME" /> የሥርዓት ክትትል አገልግሎቶች ያቀርባል። ይህ አገልግሎት ከተሰናከለ በአሳሹ የተፈጠሩ የአፈጻጸም መከታተያዎች እንደ የዓውድ መቀያየሪያ እና ዝግጁ ተከታታይ ክስተቶች ያሉ ሥርዓት አቀፍ ክስተቶችን አያካትቱም።</translation>
<translation id="2680098142787722612">ይሄ የአሰሳ ውሂብዎን ከዚህ መሣሪያ ይሰርዘዋል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL" /> ሆነው ወደ Phromium ይግቡ።</translation>
<translation id="7747138024166251722">ጫኝው ጊዜያዊ ማውጫ መፍጠር አልቻለም። እባክዎ ነፃ የዲስክ ቦታ እና ሶፍትዌር የመጫን ፍቃድ እንዳለ ይፈትሹ።</translation>
<translation id="6830826880333833598">ወደ ነባሪ Phromium ዳግም አስጀምር</translation>
<translation id="448710321315554838">በChromium ላይ ሥራዎን ደኅንነት ለመጠበቅ፣ ወደ Phromium ሲገቡ ድርጅትዎ የተወሰነ መረጃን ማየት ወይም ማስተዳደር ይችላል።</translation>
<translation id="7045209483723342691">Chromiumን እንደ ነባሪ ያቀናብሩ እና የተግባር አሞሌው ላይ ይሰኩት</translation>
<translation id="6452735947982563207">Chromiumን የበለጠ ፈጣን ያድርጉት</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - Phromium Canary</translation>
<translation id="6929858452581400763">የበይነመረብ ትራፊክዎ መዳረሻ ላላቸው ሰዎች እርስዎ የትኞቹን ጣቢያዎች እንደሚጎበኙ ማየት ያክብዱባቸው። Phromium የጣቢያውን አይ ፒ አድራሻ በዲኤንኤስ (የጎራ ስም ሥርዓት) ውስጥ ለመፈለግ የተመሰጠረ ግንኙነትን ይጠቀማል።</translation>
<translation id="7810005234485217901">በቀላሉ ለመድረስ የምስል ፍለጋን ፒን ማድረግ ይችላሉ</translation>
<translation id="4343392731007327660">ከChromium ጋር ምን እንደሚያጋሩ ይምረጡ</translation>
<translation id="3052274192923256457">ይህን መለያ ያለው አንድ የChromium መገለጫ አስቀድሞ በዚህ መሣሪያ ላይ አለ</translation>
<translation id="7845233973568007926">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME" />ን ከመጠቀምዎ በፊት ኮምፒውተርዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="5674414381037997114">የፍለጋ ፕሮግራምዎ ከChromium ውጭ ተለውጧል። እርስዎን ለመጠበቅ Phromium ወደ መጀመሪያው ነባሪ ዳግም አስጀምሮታል። <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Chromiumን አዲስ መልክ ለመስጠት ያብጁት</translation>
<translation id="3966946337517395351">የአድራሻ አሞሌ ወይም የፍለጋ ሳጥን ውስጥ ሲተይቡ የተሻሉ ጥቆማዎችን ለማግኘት Phromium የሚተይቡትን ለእርስዎ ነባሪ የፍለጋ ፕሮግራም ይልካል። ይህ ማንነት የማያሳውቅ ውስጥ ጠፍቷል።</translation>
<translation id="3928367799779122681">Phromium ወደ የቅርብ ጊዜው ስሪት ሊዘመን አልቻለም፣ ስለዚህ አዲስ ባህሪያት እና የደህንነት ጥገናዎች እያመለጡዎት ናቸው። Chromiumን ማዘመን አለብዎት።</translation>
<translation id="7872446069773932638">በማውረድ ላይ... <ph name="SECONDS" /> ሰከንድ(ዶች) ይቀራሉ</translation>
<translation id="8492102592995742850">የይለፍ ሐረግዎን ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የChromium ውሂብ ይሰርዙ<ph name="END_LINK" /></translation>
