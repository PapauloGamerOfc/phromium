<translation id="5209258538041302334">እርስዎ የይለፍ ቃላትዎን ሲያስቀምጧቸው Phromium መፈተሽ ይችላል</translation>
<translation id="8525579356836940628">ጭነት ቆሟል</translation>
<translation id="6348113608284833604">በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ባለው የChromium መተግበሪያ የይለፍ ቃላትዎን፣ ትሮችዎን እና ሌሎችንም በመሄድ ላይ ይውሰዱ</translation>
