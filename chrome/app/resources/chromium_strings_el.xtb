<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="1029669172902658969">Επανεκκίνηση για ενημέρωση του &amp;Chromium OS</translation>
<translation id="7962340570690354348">Το Phromium συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="2702007788032964762">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το Phromium χρησιμοποιεί τους διακομιστές της Google. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η Google μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="1051793555070215510">Βοηθήστε μας να βελτιώσουμε την ανώνυμη περιήγηση, συμμετέχοντας σε αυτή την έρευνα διάρκειας 1 λεπτού.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="4964836565882496625">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το Phromium</translation>
<translation id="8409497136174302488">Το Phromium χρειάζεται πρόσβαση στο τοπικό δίκτυό σας για την ανακάλυψη και τη χρήση συσκευών σε κοντινή απόσταση</translation>
<translation id="4388904545107211948">Για να αναζητήσετε μια συγκεκριμένη λειτουργία ή επέκταση του Phromium, πληκτρολογήστε τη συντόμευσή της στη γραμμή διευθύνσεων και, στη συνέχεια, το επιλεγμένο πλήκτρο πληκτρολογίου</translation>
<translation id="7188624550427159072">Εμφάνιση της αναζήτησης με το Phromium στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="3689248207461565136">Το Phromium θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="112640046208448578">Αναγνωρίστε αντικείμενα ή μέρη και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Το Phromium είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="5414044255592121327">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK" />συνδεθείτε στο Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Κάντε κλικ στο μενού του Phromium</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="7861581212703831457">Σχετικά με το Phromium</translation>
<translation id="8752630985505435738">Λήψη ειδοποιήσεων παρακολούθησης τιμής με το Phromium στο τηλέφωνό σας</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="4933432676089063712">Μια <ph name="IMPORTANT_UPDATE" /> βρίσκεται σε εκκρεμότητα. Για να παραμείνετε ασφαλείς κατά την περιήγησή σας, το Phromium θα ενημερωθεί την επόμενη φορά που θα είστε ανενεργοί για <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">Όταν ανοίγετε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, θα αποστέλλονται αυτόματα στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο Phromium. Για να αλλάξετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα Ο λογαριασμός σας στο Phromium.</translation>
<translation id="7402478829083317456">Εμφάνιση του Gemini στο Phromium στη γραμμή μενού του Mac</translation>
<translation id="4902531791098430822">Για να επιλέξετε ένα μέρος της οθόνης στο Gemini στο Phromium, χρησιμοποιήστε μια συντόμευση πληκτρολογίου.</translation>
<translation id="9002284132405311162">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το Phromium. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="5561666811965903444">Το Phromium απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="1340271056805240721">Όταν συνδέεστε σε υπηρεσίες Google, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL" />, μπορείτε να συνδέεστε αυτόματα στο Phromium με τον ίδιο λογαριασμό</translation>
<translation id="5048805453292757697">Λήψη του Phromium στο τηλέφωνό σας</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">Ρυθμίστε το νέο σας προφίλ στο Phromium</translation>
<translation id="7871721155662336863">Δοκιμάστε τη με το Gemini στο Phromium</translation>
<translation id="6569288432960798043">Το Phromium χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">Συνδεθείτε στο Phromium από το τηλέφωνό σας</translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="1619655755195586133">Να διαγραφούν επίσης δεδομένα από το Phromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στην Αναζήτηση με εικόνες από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="2947996037737257951">Χρησιμοποιήστε την εφαρμογή Phromium για να συνεχίσετε την περιήγηση εν κινήσει</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="8355386219605656974">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Phromium στις Ρυθμίσεις συστήματος.</translation>
<translation id="1478370723027452770">Λήψη βοήθειας για το Chrome for Testing</translation>
<translation id="8398257182826094665">Για να έχετε πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Phromium</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="3484755999946650557">Μοιραστείτε μια καρτέλα του Phromium</translation>
<translation id="3309377459597801353">Σύνδεση στο Phromium</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="2354363290397602683">Καρφίτσωμα Phromium</translation>
<translation id="2244728813494358888">Εργαλεία ασφάλειας του Phromium</translation>
<translation id="707582364915018531">Το Phromium θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί μια ενημέρωση.}=1{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="5032531544901236587">Αξιοποιήστε τις καλύτερες λειτουργίες της Google με την εφαρμογή Phromium στο τηλέφωνό σας</translation>
<translation id="7311082384439462587">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο Phromium</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1665602916345474427">Συνδεθήκατε ως <ph name="USER_NAME" />, <ph name="USER_EMAIL" />: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="4535436467771816034">Μπορείτε να χρησιμοποιείτε το Phromium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές. Επίσης, θα καρφιτσωθεί στη γραμμή εργαλείων.</translation>
<translation id="1709772298389099340">Παρέχει αναβαθμισμένα προνόμια για το <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Αυτό θα σας επιτρέψει να επιλέγετε μία από τις διαθέσιμες συσκευές και να προβάλλετε περιεχόμενο σε αυτήν.</translation>
<translation id="3550860956769006392">Το Phromium θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="2053384509423635834">Το Phromium θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="2516115567501600458">Διαγρ. δεδ. Phromium</translation>
<translation id="8571959122390670188">Θα γίνει επανεκκίνηση του Phromium σε <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">Όταν δεν είναι διαθέσιμο το HTTPS, το Phromium θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="5872244334553252095">Να επιτρέπεται στο Phromium να εκτελείται στο παρασκήνιο</translation>
<translation id="2213761221916953829">Για να κάνουμε το Phromium πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="8807881428325438878">Κάντε κλικ στο κουμπί <ph name="BEGIN_BOLD" />Ναι<ph name="END_BOLD" /> στην ειδοποίηση των Windows, για να καρφιτσώσετε το Phromium στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="6861833596843600606">Επανεγκατάσταση του Phromium</translation>
<translation id="3950056404221550225">Το Phromium προσπαθεί να <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">Την επόμενη φορά που θα ανοίξετε το Phromium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση της Διαχείρισης κωδικών πρόσβασης Google.</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="2724678689951174927">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας Google, <ph name="BEGIN_LINK" />αποσυνδεθείτε από το Phromium<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">Κατεβάστε το Phromium στο τηλέφωνό σας για άνοιγμα ή δημιουργία νέων ομάδων καρτελών εν κινήσει.</translation>
<translation id="3191814926523151519">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας Google. Οι Λογαριασμοί σας Google χρησιμοποιούνται για το πρόγραμμα περιήγησης Phromium, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Μάθετε περισσότερα<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Αναζητήστε με την Αναζήτηση με εικόνες</translation>
<translation id="5453573140402957471">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="1236934630660512644">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Phromium. Τα δεδομένα σας στο Phromium, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του Phromium. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Το Phromium εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Υπηρεσία Phromium Updater</translation>
<translation id="5797624919204275541">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους Google, όπως το Gmail, χωρίς να συνδεθείτε στο Phromium</translation>
<translation id="6850971726764387814">Το Phromium δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="8289779763124483945">Ο οργανισμός σας, <ph name="MANAGER" />, απαιτεί να συνδεθείτε στο Phromium</translation>
<translation id="193439633299369377">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Chromium OS.</translation>
<translation id="3215238748514810076">Το Phromium απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE" /> λεπτά</translation>
<translation id="8529252122707161160">Το Phromium δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="197326043290947695">Περιηγηθείτε πιο έξυπνα με την Αναζήτηση με εικόνες</translation>
<translation id="7769772561254542263">Μάθετε γιατί το Phromium αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="3713013456746186442">Διατηρεί το λογισμικό Phromium ενημερωμένο. Εάν αυτή η υπηρεσία απενεργοποιηθεί ή σταματήσει, το λογισμικό Phromium δεν θα ενημερώνεται, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό Phromium που να τη χρησιμοποιεί.</translation>
<translation id="5690439379999550641">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Phromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="2039417478970545937">Ρυθμίσεις.</translation>
<translation id="4765042254400173473">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό Phromium για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες Google.</translation>
<translation id="1448229429009113044">Είναι ενσωματωμένη στο Phromium για να σας βοηθά να δημιουργείτε, να αποθηκεύετε και να συμπληρώνετε αυτόματα ισχυρούς κωδικούς πρόσβασης. Προσθέστε τη συντόμευση για εύκολη πρόσβαση.</translation>
<translation id="2145664943269651168">Κάντε κλικ στο κουμπί Προσαρμογή Phromium στη σελίδα Νέα καρτέλα, για να δώσετε μια νέα εμφάνιση στο Phromium</translation>
<translation id="6052463185672312901">Το Phromium απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="3825064703718009924">Την επόμενη φορά που θα ανοίξετε το Phromium iOS, θα δείτε μια προτροπή για να δοκιμάσετε τη λειτουργία <ph name="FEATURE_NAME" />.</translation>
<translation id="886729435477608858">Οι κωδικοί πρόσβασης και άλλα δεδομένα του Phromium που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Phromium, συνδεθείτε ξανά.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Phromium δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Phromium δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="2125838419757773031">Επιλέξτε περιοχή της οθόνης για αναζήτηση</translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2135919691573380097">Αναφορά αυτού του ιστοτόπου</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="2147218225094845757">Απόκρυψη πλαϊνού πλαισίου</translation>
<translation id="1628700182434635922">Το Phromium απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="2170098639895543546">Επιλέξτε οτιδήποτε στη σελίδα</translation>
<translation id="1807571394075492085">Προσαρμογή του Phromium</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="8332848361915479268">Phromium - Σύνδεση δικτύου - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Κατάργηση λογαριασμού από το Phromium</translation>
<translation id="6063124961634921864">Χρησιμοποιήστε την εφαρμογή Phromium για να έχετε τα καλύτερα εργαλεία αγορών εν κινήσει</translation>
<translation id="8646569091716523420">Παραμείνετε ασφαλείς εν κινήσει με τη Βελτιωμένη Ασφαλή περιήγηση στο Phromium για iOS</translation>
<translation id="3084983792533696835">Επικίνδυνος ιστότοπος. Το Phromium κατάργησε ειδοποιήσεις.</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="6387327671844988108">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας Google μετά τη σύνδεσή σας.</translation>
<translation id="722050260205928409">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Phromium ακριβώς όπως θέλουν.</translation>
<translation id="703211526866942526">Δεξιότητες στο Phromium</translation>
<translation id="2283803047247799269">Αναζήτηση σε αυτή την καρτέλα με την Αναζήτηση με εικόνες</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Το Phromium συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Phromium συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="2307973900865360088">Διατήρηση στο Dock</translation>
<translation id="6083276764640161328">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Phromium. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Phromium μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="2356070529366658676">Να γίνεται ερώτηση</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="741972887620936671">Η επέκταση <ph name="EXTENSION_NAME" /> θέλει να συνδεθείτε στο Phromium</translation>
<translation id="4709464915929597251">Απενεργοποίηση του Phromium, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="6804933363437420201">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS" />, συνδεθείτε στο Phromium.</translation>
<translation id="2384373936468275798">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Phromium}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Phromium}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις Phromium}}</translation>
<translation id="1394893265611797679">Το Phromium χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="8457868297375575309">Ανοίξτε συνδέσμους στο Phromium από οποιαδήποτε εφαρμογή και διατηρήστε το πρόγραμμα περιήγησης προσβάσιμο στη γραμμή εργαλείων</translation>
<translation id="5354209517289935579">Κάντε κλικ στο κουμπί Σύνοψη, για να κοινοποιήσετε αυτό το έγγραφο στο Gemini στο Phromium, να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="6628402244681586711">Με τα <ph name="BEGIN_LINK" />εργαλεία του Phromium<ph name="END_LINK" />, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="6454834963905669297">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="1593547119543498467">Το Phromium θα κλείσει σύντομα</translation>
<translation id="6814323389195469782">Στο Phromium</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Επιλογή κειμένου με την Αναζήτηση με εικόνες</translation>
<translation id="2643581100433412871">Το Phromium προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="4103676945224728292">Το Phromium χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="8743720024689622265">Πρόγραμμα βοήθειας Phromium</translation>
<translation id="2575822587468774919">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="8692134707551176334">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium</translation>
<translation id="6035715610127790081">Σαρώστε τον κωδικό QR με το τηλέφωνό σας, για να κατεβάσετε το Phromium και να συνδεθείτε στον Λογαριασμό σας Google.</translation>
<translation id="1579158377846894470">για αναζήτηση με το Phromium.</translation>
<translation id="3626651250874375470">Συνέχεια χρήσης του Phromium</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="7634640424937626608">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο Phromium</translation>
<translation id="2669565213445601962">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Phromium στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="3048500373778933960">{COUNT,plural, =0{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί μια ενημέρωση}=1{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="4393202019354077587">Έναρξη του Phromium</translation>
<translation id="3192212313802409327">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το Phromium ξανά.</translation>
<translation id="6648732950668475680">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Phromium ακριβώς όπως θέλουν.</translation>
<translation id="3501804488281766385">Εύκολη πρόσβαση για χρήση του Gemini στο Phromium σε όλη τη συσκευή σας, ακόμα και αν το Phromium είναι ελαχιστοποιημένο.</translation>
<translation id="5655763731487334489">Καρτέλα Phromium</translation>
<translation id="582020748041490207">Για επιπλέον ασφάλεια, το Phromium θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="2693283019505702310">Για να καταργήσετε τον Λογαριασμό σας Google από το Phromium, αποσυνδεθείτε</translation>
<translation id="2989508583692830513">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης, στους σελιδοδείκτες και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="3391021955306442819">Ορισμός του Phromium ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="293156805028931571">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το Phromium, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="4742633141454352374">Το δικό σας Phromium</translation>
<translation id="2816462166102338036">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="2191308357458164968">Ανακαλύψτε προϊόντα με την κάμερα, παρακολουθήστε τις πτώσεις τιμών και πολλά άλλα εν κινήσει με το Phromium σε iOS.</translation>
<translation id="2841525013647267359">Μετάφραση από</translation>
<translation id="2846251086934905009">Σφάλμα εγκατάστασης: Το πρόγραμμα εγκατάστασης δεν ολοκληρώθηκε. Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="4498037716339180906">Κατάργηση από το Phromium…</translation>
<translation id="4049188396834160957">Διατηρεί την ασφάλειά σας στο Phromium και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές Google όταν είστε συνδεδεμένοι.</translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="4119302609687132178">Σχετικά με το &amp;Phromium</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="8232968781653330429">Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Phromium στον Λογαριασμό σας Google.</translation>
<translation id="2945997411976714835">Σφάλμα εγκατάστασης: Απέτυχε η εκκίνηση της διεργασίας του προγράμματος εγκατάστασης.</translation>
<translation id="5624652745932625503">Συνδεθείτε πιο γρήγορα σε ιστοτόπους χρησιμοποιώντας αποθηκευμένους κωδικούς πρόσβασης για το Phromium σε iOS</translation>
<translation id="8821179372057577828">Ο οργανισμός σας διαχειρίζεται το Phromium</translation>
<translation id="741172935898285572">Το Phromium έχει ενημερωθεί</translation>
<translation id="8798708493876822519">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Phromium μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="6896740867011823632">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, συνδέσου στο Phromium</translation>
<translation id="3003694935412297923">Όλες οι εργασίες</translation>
<translation id="3580865868015023718">{count,plural, =1{Το Phromium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Το Phromium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="1211179250505223767">Άνοιγμα της διεύθυνσης <ph name="URL" /> σε νέα καρτέλα στο Phromium.</translation>
<translation id="4742400838355945730">Οι καινοτομίες AI, όπως οι δεξιότητες, αποθηκεύονται στον Λογαριασμό σας Google και η διαχείρισή τους γίνεται ξεχωριστά από τον συγχρονισμό του Phromium</translation>
<translation id="8070050512429584052">Για να έχετε πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium</translation>
<translation id="666691655897541311">Προσθήκη στο Phromium…</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="3045032126857188731">Γλώσσα μετάφρασης: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Κλείσιμο παραθύρου διαλόγου σχολίων</translation>
<translation id="919456815618829047">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />.</translation>
<translation id="6141754610526066487">Άλλα προφίλ Phromium</translation>
<translation id="2380720899384114679">Οι επεκτάσεις είναι πρόσθετα που σας επιτρέπουν να προσαρμόζετε το Phromium. Από την οργάνωση έως την απλοποίηση των καθημερινών εργασιών, οι επεκτάσεις σάς βοηθούν να προσαρμόζετε το Phromium στις ανάγκες σας.</translation>
<translation id="2507281899032275020">Βοηθήστε μας να κάνουμε το Phromium καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK" /> στην Google</translation>
<translation id="1514966729948178660">Χρησιμοποιήστε την εφαρμογή Phromium για να έχετε μαζί σας την ασφάλεια της Google</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Phromium}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Phromium}other{Αποκτήθηκε πρόσβαση σε # συσκευές USB από μία ή περισσότερες επεκτάσεις Phromium}}</translation>
<translation id="78720743239019396">Για να έχετε πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Phromium</translation>
<translation id="7000206277447032115">Ιστορικό Phromium</translation>
<translation id="4555002192651219296">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το Phromium ξανά.</translation>
<translation id="310459126943037700">Ο τερματισμός των εργασιών απέτυχε.</translation>
<translation id="3104828284009500087">Αναζητήστε οτιδήποτε στη σελίδα</translation>
<translation id="4867557516756736957">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Phromium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="8632308594821621017">Το Phromium χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="3130333203120345554">Νέα αναζήτηση</translation>
<translation id="3137969841538672700">Σύρετε για αναζήτηση</translation>
<translation id="9173792796158381383">Αυτή η καρτέλα χρησιμοποιεί επιπλέον πόρους. Για να βελτιώσετε την απόδοση, επιτρέψτε στο Phromium να την απενεργοποιήσει.</translation>
<translation id="8874679893080632357">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Phromium στις Ρυθμίσεις συστήματος</translation>
<translation id="101045618220347251">Επανεκκίνηση Phromium</translation>
<translation id="3161522574479303604">Όλες οι γλώσσες</translation>
<translation id="5940989267583033306">Άνοιγμα Συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης Phromium</translation>
<translation id="2045477525210426976">Προσαρμόστε το νέο σας προφίλ Phromium</translation>
<translation id="3540518135502114323">Μπορείτε να συνεχίσετε να συνομιλείτε με τη Λειτουργία AI χωρίς να αλλάξετε καρτέλες. Για να ξεκινήσετε, συνδεθείτε στο Phromium. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="1496180326063744749">Για να καταργήσετε τον Λογαριασμό σας Google από το Phromium, αποσυνδεθείτε από το Phromium στη σελίδα Ρυθμίσεις</translation>
<translation id="7792783034323745412">Αργότερα, το Phromium μπορεί να σας ρωτήσει αν θέλετε να χρησιμοποιήσετε τα αποθηκευμένα στοιχεία για την αυτόματη συμπλήρωση φορμών για εσάς</translation>
<translation id="5240091371721695404">Το Phromium δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">Μεταφέρετε μαζί σας τα αγαπημένα σας εργαλεία Google AI με το Phromium σε iOS.</translation>
<translation id="4848363951707149242">Για να έχετε πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Phromium</translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="8613877111531019527">Λείπουν κλειδιά του Google API. Ορισμένες λειτουργίες του Google Phromium θα απενεργοποιηθούν.</translation>
<translation id="2784090498377460662">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το Phromium είναι κλειστό</translation>
<translation id="3905054486991167751">Η ενημέρωση του Phromium θα γίνει κατά τη διάρκεια της απουσίας σας</translation>
<translation id="4502950976754616266">Το Phromium θα σας ειδοποιεί πριν από τη φόρτωση ιστοτόπων με μη ασφαλή σύνδεση</translation>
<translation id="6107453188231652861">Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Phromium, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Phromium. Για να επιτρέψετε στους ιστοτόπους να απομνημονεύουν τα στοιχεία σας, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">επάνω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="5896635343289575401">Δεδομένα Phromium στον λογαριασμό σας</translation>
<translation id="5662253013097242821">Χρησιμοποιήστε τους κωδικούς πρόσβασης με το Phromium στο τηλέφωνό σας</translation>
<translation id="3387527074123400161">Chromium OS</translation>
<translation id="5326080492429181135">Εναλλαγή σε υπάρχον προφίλ Phromium;</translation>
<translation id="3412460710772753638">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="657700335789940813">Το Phromium θέλει να κάνει ενημέρωση</translation>
<translation id="3487742274367151379">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Phromium</translation>
<translation id="3438772217992559640">Αναζήτηση αυτής της καρτέλας με την Αναζήτηση με εικόνες</translation>
<translation id="8062355070850891600">Επεκτείνετε τη Βελτιωμένη Ασφαλή περιήγηση με το Phromium στο τηλέφωνό σας</translation>
<translation id="5419337472918920970">Προσαρμογή του Phromium…</translation>
<translation id="6573105037542661278">Με αυτή την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT" /> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Phromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="4600986251755456192">Με τη συντόμευση <ph name="SHORTCUT" /> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ Phromium</translation>
<translation id="8118189978246431067">Κλείστε όλα τα παράθυρα του Phromium και δοκιμάστε ξανά.</translation>
<translation id="7430418346833889620">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Phromium στις Ρυθμίσεις συστήματος</translation>
<translation id="2943929290955142701">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος.  Για να διατηρήσετε ξεχωριστά την περιήγησή σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5896697187441340113">Κωδικός QR για τη λήψη του προγράμματος περιήγησης Phromium σε κινητές συσκευές</translation>
<translation id="354621070532799440">Υπενθύμιση: Οι καλύτερες λειτουργίες ασφαλείας της Google στην τσέπη σας</translation>
<translation id="6718500626359284607">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Phromium στις Ρυθμίσεις συστήματος.</translation>
<translation id="6511372913460632136">Η Βελτιωμένη προστασία απενεργοποιεί τη βελτιστοποίηση JavaScript για ιστοτόπους που δεν αναγνωρίζει το Phromium</translation>
<translation id="3597003331831379823">Απέτυχε η εκτέλεση της ρύθμισης με αναβαθμισμένα προνόμια. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Σύνδεση στο Phromium</translation>
<translation id="8702816719621016911">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο Phromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{Υπάρχει νέα διαθέσιμη ενημέρωση για το Phromium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}=1{Υπάρχει νέα διαθέσιμη ενημέρωση για το Phromium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Υπάρχει νέα διαθέσιμη ενημέρωση για το Phromium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="3667616615096815454">Δεν είναι δυνατή η εγκατάσταση, ο διακομιστής δεν γνωρίζει την εφαρμογή.</translation>
<translation id="678730369472836428">Χρησιμοποιήστε τη <ph name="BEGIN_LINK" />δική σας φράση πρόσβασης<ph name="END_LINK" /> για την κρυπτογράφηση όλων των δεδομένων Phromium στον Λογαριασμό σας Google. Οι τρόποι και οι διευθύνσεις πληρωμής από το Google Pay δεν θα κρυπτογραφούνται. Το ιστορικό περιήγησης από το Phromium δεν θα συγχρονίζεται.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση.}=1{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Phromium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="2203303261468330007">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα Phromium</translation>
<translation id="686463893976008238">Σύνδεση του Phromium και άλλων υπηρεσιών Google για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="3729187154190517324">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία, χρησιμοποιώντας το κουμπί "Προσθήκη καρτέλας και άλλων".</translation>
<translation id="5596264049590907430">Διαχείριση προφίλ Phromium</translation>
<translation id="5594723037153142396">Μάθετε γιατί το Phromium αποκλείει ορισμένες λήψεις</translation>
<translation id="3425307214497790458">Το Phromium θα σας ενημερώσει σε περίπτωση που χρειαστεί να ελέγξετε κάτι</translation>
<translation id="4247980944121268675">Το Phromium προφορτώνει σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνονται πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="3810973564298564668">Διαχείριση</translation>
<translation id="1058395779823101457">Για να χρησιμοποιήσετε τους αποθηκευμένους κωδικούς πρόσβασης, ακολουθήστε τον σύνδεσμο του κωδικού QR, κατεβάστε το Phromium για iOS και συνδεθείτε στον Λογαριασμό σας Google</translation>
<translation id="3846683726093018685">**Δημιουργήστε μια σύνοψη:** Σε μία πρόταση με λιγότερες από 30 λέξεις, περιγράψτε το κύριο θέμα και τον σκοπό του περιεχομένου στο στιγμιότυπο οθόνης.

          **Προτείνετε ερωτήσεις:** Δημιουργήστε μια λίστα με κουκκίδες με 3-5 ερωτήσεις που θα μπορούσε να κάνει ένας χρήστης για να κατανοήσει καλύτερα το στιγμιότυπο οθόνης. Αυτές οι ερωτήσεις πρέπει να περιλαμβάνουν τουλάχιστον μία η οποία θα αφορά συγκεκριμένα ένα οπτικό αντικείμενο, τον σχεδιασμό ή την τοποθέτησή του.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium</translation>
<translation id="3885770153807205175">Εργαλείο επιλογής γλώσσας</translation>
<translation id="5947409614720749543">Προσαρμογή και έλεγχος του Phromium. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="2176348074240183776">Κάντε κλικ στο όνομά σας, για να ανοίξετε το Phromium και να ξεκινήσετε την περιήγηση.</translation>
<translation id="3892148308691398805">Αντιγραφή κειμένου</translation>
<translation id="3679766722656346339">Ο χρήστης <ph name="EXISTING_USER" /> είναι συνδεδεμένος ήδη με αυτό το προφίλ Phromium. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το Phromium μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="6085953975934135790">Αυτή η επέκταση παραβαίνει την πολιτική του Chrome Web Store και μπορεί να μην είναι ασφαλής. Καταργήστε την από το Phromium, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="3941890832296813527">Σφάλμα εγκατάστασης: Το όνομα αρχείου του προγράμματος εγκατάστασης δεν είναι έγκυρο ή δεν υποστηρίζεται.</translation>
<translation id="608187946760434925">Το Phromium προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="3054592240125889472">Για να έχετε πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium</translation>
<translation id="3140795250676341027">Οι κωδικοί πρόσβασης, οι τρόποι πληρωμής και οι διευθύνσεις που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Phromium, συνδεθείτε ξανά.</translation>
<translation id="395904275706073188">Δεν είναι δυνατή η ανάγνωση προστατευμένων σελίδων. Δοκιμάστε διαφορετική σελίδα.</translation>
<translation id="4227910144250222665">Μάθετε πώς σας προστατεύει το Phromium</translation>
<translation id="3967822245660637423">Ολοκλήρωση λήψης</translation>
<translation id="4150430234581811723">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Phromium στέλνει αυτό που πληκτρολογείτε στα εργαλεία αναζήτησης, AI και agent του οργανισμού σας για να λάβει προτάσεις.</translation>
<translation id="3975724895399328945">Σχετικά με το &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">Σχετικά με το Chromium OS</translation>
<translation id="4847805566397342820">Όταν επισκέπτεστε έναν ιστότοπο, το Phromium στέλνει ένα παραμορφωμένο τμήμα του URL στην <ph name="BEGIN_LINK" />Ασφαλή περιήγηση Google<ph name="END_LINK" /> μέσω ενός διακομιστή απορρήτου που αποκρύπτει τη διεύθυνση IP σας. Εάν ένας ιστότοπος κάνει κάτι ύποπτο, αποστέλλονται επίσης πλήρη URL και τμήματα περιεχομένου της σελίδας.</translation>
<translation id="4016217212818346953">Μείνετε ασφαλείς με τη Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4019629340646866719">Το Chromium OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS" />περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Μετάφραση οθόνης</translation>
<translation id="4023601594785368013">Αρχική γλώσσα: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">Ανοίξτε συνδέσμους στο Phromium από οποιαδήποτε εφαρμογή. Επιπλέον, για εύκολη πρόσβαση, καρφιτσώνεται στη γραμμή εργαλείων.</translation>
<translation id="6916567874038032700">Συμβάλετε στη βελτίωση του Phromium, αναφέροντας τις <ph name="BEGIN_LINK" />τρέχουσες ρυθμίσεις<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4055805654398742145">Δ&amp;ιαχειριστής κωδικών πρόσβασης</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Phromium όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το Phromium όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="2498876341137940584">Ανώνυμη περιήγηση του Phromium</translation>
<translation id="1371775705240141332">Μετάβαση στη σελίδα Σχετικά με το Phromium</translation>
<translation id="1983555117242858621">Προσαρμόστε το Chrome για να δώσετε μια νέα εμφάνιση στο πρόγραμμα περιήγησης</translation>
<translation id="3730928612696305544">Π&amp;ροσαρμογή του Phromium</translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου - Phromium</translation>
<translation id="8940475598678719246">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="3361801572720154185">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το Phromium.</translation>
<translation id="5104340040322658377">Για να λάβετε αυτή την επέκταση και άλλα στοιχεία σε όλους τους υπολογιστές σας, συνδεθείτε στο Phromium</translation>
<translation id="6533832886058295845">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, επίλεξε το προφίλ Phromium στο οποίο έχεις ήδη συνδεθεί ως <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="4224210481850767180">Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="6904238369362879351">Να συνδεθούν τα δεδομένα σας στο Phromium με αυτόν το λογαριασμό;</translation>
<translation id="357744319784654404">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η Google στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του Phromium.</translation>
<translation id="7228779501660520489">Αποσύνδεση από το Phromium</translation>
<translation id="2782053121162821">Λήψη βοήθειας σχετικά με το Phromium</translation>
<translation id="4281844954008187215">Όροι παροχής υπηρεσιών</translation>
<translation id="5084022108026911204">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το Phromium εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="5139026954638666406">Εξαγωγή κωδικών πρόσβασης από το Phromium</translation>
<translation id="4304713468139749426">Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4334241893986177674">Αναζήτηση αυτού του στιγμιότυπου οθόνης</translation>
<translation id="8324735155671556570">Άνοιγμα του Phromium κατά την εκκίνηση των Windows</translation>
<translation id="4400772909124543403">Δεν υπάρχει διαθέσιμη ενημέρωση</translation>
<translation id="2185735215611818026">Να γίνει έξοδος από το Phromium ούτως ή άλλως;</translation>
<translation id="4413205837991854510">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="1338297030721125711">Να επιτρέπεται στο Phromium να εκτελείται στο παρασκήνιο</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{Το Phromium προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}other{Το Phromium προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}}</translation>
<translation id="1011403527148313450">Προσαρμογή και έλεγχος του Phromium</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="4434353761996769206">Σφάλμα προγράμματος εγκατάστασης: <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415">Ο οργανισμός <ph name="MANAGER" /> διαχειρίζεται το Phromium</translation>
<translation id="2477616462388290618">Προσθήκη προφίλ Phromium</translation>
<translation id="4447409407328223819">Σχετικά με το Chrome for Testing</translation>
<translation id="972523218852576493">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Phromium στον Λογαριασμό σας Google, εισαγάγετε τη φράση πρόσβασης</translation>
<translation id="4493028449971051158">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως διαχειριστής.</translation>
<translation id="4501471624619070934">Η εγκατάσταση απέτυχε επειδή η πρόσβαση είναι περιορισμένη σε αυτήν τη χώρα.</translation>
<translation id="8839763675940122379">Αυτή η επέκταση δεν έχει δημοσιεύσει πρακτικές απορρήτου, όπως τον τρόπο συλλογής και χρήσης δεδομένων. Το Phromium προτείνει να την καταργήσετε.</translation>
<translation id="2339640488105852505">Καλωσορίσατε στο Phromium. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="8536959233160434213">Το Phromium χρειάζεται άδεια για να χαρτογραφήσει τον περιβάλλοντα χώρο και να παρακολουθεί τα χέρια σας</translation>
<translation id="1077734277628859167">Έχετε συνδεθεί ήδη ως <ph name="USER_EMAIL_ADDRESS" /> σε άλλο προφίλ Phromium</translation>
<translation id="5512897665247593318">Το Phromium προφορτώνει τις σελίδες, κάτι το οποίο επιταχύνει την περιήγηση και την αναζήτηση. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις σελίδες προφόρτωσης<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Βελτιώστε την ασφάλεια στο διαδίκτυο για όλους, αναφέροντας ιστοτόπους που πιστεύετε ότι είναι επιβλαβείς.</translation>
<translation id="6624033199018630177">Το Phromium απέκλεισε αυτή τη λήψη, επειδή απενεργοποιήσατε την Ασφαλή περιήγηση και δεν είναι δυνατή η επαλήθευση του αρχείου</translation>
<translation id="3039804643080655517">Δοκιμάστε το Google Lens με το Phromium στο τηλέφωνό σας</translation>
<translation id="4594305310729380060">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="8064263528617889755">Εφαρμογές Phromium</translation>
<translation id="4598116752460667024">Αναζητήστε οποιαδήποτε διεργασία από τη λίστα.</translation>
<translation id="4613863813562375431">Έκδοση Chromium OS</translation>
<translation id="7245201002247176127">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το Phromium για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="8846891938874485868">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Phromium, αλλά καθιστά το Phromium ελαφρώς λιγότερο ανθεκτικό σε επιθέσεις</translation>
<translation id="7525500996671436081">Άνοιγμα Αναζήτησης με το Phromium</translation>
<translation id="1224842000407297331">Προφίλ Phromium</translation>
<translation id="4956303519269880412">Προειδοποίηση: Το Phromium δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτή την επέκταση σε κατάσταση ανώνυμης περιήγησης, καταργήστε αυτή την επιλογή.</translation>
<translation id="2708255035805733225">Εάν κοινοποιείτε επίσης αναφορές χρήσης του Phromium, αυτές περιλαμβάνουν τα URL που επισκέπτεστε.</translation>
<translation id="4673710618874938871">Συνδεθήκατε ως <ph name="USER_NAME" />: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="1883292567514549610">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του Phromium (<ph name="PROCESS_ID" />) σε άλλο υπολογιστή (<ph name="HOST_NAME" />). Το Phromium έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το Phromium.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="1889305042180577023">Ορισμένα δεδομένα του Phromium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="8079525505870459051">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο Phromium. Η συντόμευση <ph name="SHORTCUT" /> μπορεί να αλλάξει τις ρυθμίσεις των υπηρεσιών Google.</translation>
<translation id="2171507067211697961">Κάποιο άτομο συνδέθηκε προηγουμένως στο Phromium σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST" />. Δημιουργήστε έναν νέο χρήστη του Phromium, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="4724676981607797757">Η εγκατάσταση απέτυχε λόγω σφάλματος μη υποστηριζόμενου πρωτοκόλλου.</translation>
<translation id="6925701206088903005">Να τερματιστεί η λειτουργία του Phromium ούτως ή άλλως;</translation>
<translation id="4514755609496543621">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το Phromium. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="8673673368917636496">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Phromium κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="COUNT" /> ακόμη.</translation>
<translation id="3638319732826965647">Εάν το Gemini στο Phromium είναι ανοικτό, το πλαϊνό πλαίσιο παραμένει ανοικτό κατά τη δημιουργία νέων καρτελών</translation>
<translation id="479167709087336770">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση Google. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην Google. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="2659245507243672392">Χρήση του Phromium χωρίς λογαριασμό</translation>
<translation id="166411027652942990">Εισερχόμενος κανόνας για το Phromium για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="6031862420354068813">Επανεκκίνηση για ενημέρωση του &amp;Phromium</translation>
<translation id="4918086044614829423">Αποδοχή</translation>
<translation id="4918844574251943176">Η εικόνα αντιγράφηκε</translation>
<translation id="1531905832227009774">Για να έχετε πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium</translation>
<translation id="4319892378006430019">Το Phromium εκτελείται στο παρασκήνιο.</translation>
<translation id="8972359100025490790">Κάντε κλικ για να κλείσετε το παράθυρο διαλόγου σύνδεσης του Phromium</translation>
<translation id="3639078149590125530">Με τα προφίλ του Phromium μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο Phromium. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="7141327976224964788">Οι επισκέπτες μπορούν να χρησιμοποιούν το Phromium χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="7007327521155149139">Ο λογαριασμός σας στο Phromium</translation>
<translation id="5973804420920585431">Προσθήκη του εαυτού σας στο Phromium</translation>
<translation id="504699503110800016">Ανοίξτε το μενού υπερχείλισης</translation>
<translation id="2497925691306722252">Αποκτήστε πρόσβαση σε όλες τις αγαπημένες λειτουργίες της Google με το Phromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8678196879882043620">Το Phromium χρειάζεται άδεια για να παρακολουθεί τα χέρια σας</translation>
<translation id="3397880081430454820">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Phromium κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="PERMISSION_3" />.</translation>
<translation id="9114243566897924763">Σύνδεση στο Phromium</translation>
<translation id="5174969993834422967">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ στο εικονίδιο ειδοποίησης στη δεξιά γωνία της γραμμής τοποθεσίας.</translation>
<translation id="5174983315706567306">Δεν υπάρχει αρκετός χώρος δίσκου.</translation>
<translation id="7698884672439844280">Ο λογαριασμός Phromium απαιτεί εκ νέου έλεγχο ταυτότητας</translation>
<translation id="5629965056131882780">Συνεχίστε ακριβώς από εκεί που είχατε σταματήσει με το Phromium σε iOS.</translation>
<translation id="874294566462998787">Αποσύνδεση από το Phromium</translation>
<translation id="5234764350956374838">Παράβλεψη</translation>
<translation id="8605581794204249702">Άνοιγμα συνδέσμου σε παράθυρο για ανών&amp;υμη περιήγηση Phromium</translation>
<translation id="8722804301463582643">Αποκτήστε την εφαρμογή Phromium για να αποθηκεύετε κωδικούς πρόσβασης εν κινήσει</translation>
<translation id="6253936671561887082">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το Phromium</translation>
<translation id="7405713141437293142">Για να στείλετε αυτή την καρτέλα σε άλλη συσκευή, συνδεθείτε στο Phromium και στις δύο συσκευές</translation>
<translation id="5286907366254680517">Εντοπίστηκε</translation>
<translation id="2224284460884535818">Λήψη της εφαρμογής Phromium</translation>
<translation id="1426207087952749578">Κατά την περιήγηση σε Κατάσταση ανώνυμης περιήγησης, το Phromium θα σας ειδοποιεί πριν από τη φόρτωση ενός ιστοτόπου με μη ασφαλή σύνδεση</translation>
<translation id="8108751453879231987">Αναζήτηση με το Phromium</translation>
<translation id="7780358745459835678">Εσωτερική υπηρεσία Phromium Updater</translation>
<translation id="6956753580765202069">Χρησιμοποιήστε τις μαζί με άλλες λειτουργίες του Gemini στο Phromium</translation>
<translation id="5346389065299425353">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία</translation>
<translation id="8684266995248242891">Δείτε μια γρήγορη επισκόπηση αυτού του εγγράφου και κάντε ερωτήσεις με το Gemini στο Phromium</translation>
<translation id="586104673506947714">Το Phromium εντόπισε ορισμένες προτάσεις ασφάλειας για να ελέγξετε</translation>
<translation id="4657908558997566735">Άλλα προφίλ Phromium</translation>
<translation id="6097378010983112326">Δεν ήταν δυνατή η αποθήκευση δεδομένων Phromium στον Λογαριασμό σας Google από το ChromiumOS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα</translation>
<translation id="385020720581757591">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Phromium. Τα δεδομένα σας στο Phromium, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Επιπλέον κωδικός: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">Για εξατομίκευση, συμπεριλάβετε το Phromium στη Δραστηριότητα ιστού και εφαρμογών</translation>
<translation id="2756028035855809142">Άνοιγμα αναζήτησης με το Phromium</translation>
<translation id="4375021373215585423">Μάθετε γιατί το Phromium αποκλείει ορισμένα αρχεία</translation>
<translation id="4688227912949761884">Ενημέρωση του Phromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="4945147853702701048">Να επιτρέπεται η σύνδεση στο Phromium</translation>
<translation id="7813879193794658604">Κατάργηση από το Phromium</translation>
<translation id="2908302339618007937">Μειώνει την απόδοση αλλά καθιστά το Phromium πιο ανθεκτικό σε επιθέσεις</translation>
<translation id="8760365573983490520">Ορισμός του Phromium ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> - Phromium Beta</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{Το Phromium συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Phromium συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="975923236500175446">Το Phromium ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="7595270580374414215">Το Phromium απέκλεισε αυτή τη λήψη, επειδή το αρχείο μπορεί να βλάψει τους προσωπικούς σας λογαριασμούς και τους λογαριασμούς σας σε κοινωνικά δίκτυα</translation>
<translation id="5644162187312430027">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το Phromium.</translation>
<translation id="2476033563817685908">Το Phromium προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="1626952238284562558">Εργαστείτε απρόσκοπτα με τις αγαπημένες σας εφαρμογές, όπως το Google Drive και το YouTube, εν κινήσει με το Phromium.</translation>
<translation id="5524890928877629608">επάνω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="2860766395826060492">Άνοιγμα PDF στο Phromium</translation>
<translation id="5536164441519929134">Ερώτηση<ph name="LINE_BREAK" />σχετικά με αυτή την καρτέλα</translation>
<translation id="3915500272078806319">Για λόγους ασφαλείας, το Phromium απενεργοποιεί τη βελτιστοποίηση JavaScript όταν επισκέπτεστε έναν ιστότοπο για πρώτη φορά.

Εάν αυτή η σελίδα δεν λειτουργεί με τον αναμενόμενο τρόπο, δοκιμάστε να επιτρέψετε τη βελτιστοποίηση.</translation>
<translation id="6778733300408894918">Εμφάνιση του Gemini στο Phromium στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="8411908790152555435">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως απλός χρήστης και όχι ως διαχειριστής.</translation>
<translation id="6578510724610627339">Χρήση Phromium από προεπιλογή και καρφίτσωμα</translation>
<translation id="5596627076506792578">Περισσότερες επιλογές</translation>
<translation id="5605834417512968703">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="5618818588972826921">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="4431270188253419020">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του Phromium}=1{Υπάρχει μια διαθέσιμη ενημέρωση του Phromium}other{Υπάρχει μια διαθέσιμη ενημέρωση του Phromium για # ημέρες}}</translation>
<translation id="6903143702905157196">Να διαγράφονται πάντα τα δεδομένα ιστοτόπων από τη συσκευή σας όταν κλείνετε το Phromium</translation>
<translation id="5354366475527026551">Επανεκκινήστε το Phromium τώρα</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">Να εμφανίζεται το Phromium σε αυτήν τη γλώσσα</translation>
<translation id="569897634095159764">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Ο διακομιστής μεσολάβησης απαιτεί έλεγχο ταυτότητας.</translation>
<translation id="5724138350057003647">Το Phromium αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το Phromium γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση μνήμης<ph name="END_LINK" /></translation>
<translation id="3730992449058237228">Εάν ξεχάσατε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="SETTINGS_LINK" /> τα δεδομένα του Phromium στον λογαριασμό σας</translation>
<translation id="1983042639279920602">Προσαρμογή και έλεγχος του Phromium. Ορίστε το Phromium ως προεπιλογή.</translation>
<translation id="7136978005010973283">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές, ορίζοντας το Phromium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5809516625706423866">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 401 Unauthorized. Ελέγξτε τη διαμόρφωση παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="3059302031765226748">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Phromium, αλλά καθιστά το Phromium ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι απενεργοποιημένη.</translation>
<translation id="4904710047654714935">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Phromium στον Λογαριασμό σας Google, ενημερώστε το Phromium</translation>
<translation id="5824893331272123205">Δεν ήταν δυνατή η φόρτωση αυτού του πλαισίου. Δοκιμάστε ξανά.</translation>
<translation id="2582896742857095190">Καλώς ήρθατε στο Phromium</translation>
<translation id="5004643502851105876">Ενεργοποιεί πρόσθετες λειτουργίες για την παροχή των ισχυρότερων μέτρων προστασίας του Phromium</translation>
<translation id="5871205389137001634">Κάντε κλικ για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="7409018434452575206">Το Phromium εντόπισε κακόβουλο πρόγραμμα σε αυτά τα στοιχεία:</translation>
<translation id="3191822983646594827">Το Phromium ελέγχει τακτικά για να διασφαλίζει ότι το πρόγραμμα περιήγησης που χρησιμοποιείτε έχει τις πιο ασφαλείς ρυθμίσεις. Θα σας ενημερώνουμε, αν χρειάζεται να ελέγξετε κάτι.</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="625373791981566594">Gemini Enterprise στο Phromium</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="8650638130234822147">Για να έχετε πρόσβαση σε αυτόν τον σελιδοδείκτη και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium</translation>
<translation id="5010592102321399468">Εξατομίκευση του Phromium</translation>
<translation id="5960071705175224773">Οι ρυθμίσεις σας άλλαξαν από μια άγνωστη εφαρμογή</translation>
<translation id="5977420883993828287">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά τις Εργασίες με βάση τα συμφραζόμενα από τη γραμμή εργαλείων</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Phromium όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το Phromium όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="3160371268592376569">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το Phromium</translation>
<translation id="5990360079535151574">Από το κουμπί Εργασίες με βάση τα συμφραζόμενα στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS" /> ώρες</translation>
<translation id="6009821354356307391">Κάντε ένα επιπλέον ερώτημα</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="5783572280281297164">Αξιοποιήστε περισσότερο τις ηλεκτρονικές αγορές όταν χρησιμοποιείτε την εφαρμογή Phromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="2712461133060419287">Για την προστασία των δεδομένων σας, επιτρέψτε στο Phromium να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα. Δεν διακόπτει τις ειδοποιήσεις.</translation>
<translation id="7845842385196710435">&amp;Άνοιγμα στο Phromium</translation>
<translation id="6069027071882229820">Αντιγραφή ως εικόνα</translation>
<translation id="3752072756936611600">Η επέκταση <ph name="EXTENSION_NAME" /> έχει προστεθεί στο Phromium</translation>
<translation id="2775066550187002528">Προσαρμόστε και ελέγξτε το Phromium. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="6531352038528110565">Ενεργή • Το Phromium δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="2876078296400914679">Ο λογαριασμός σας στο Phromium</translation>
<translation id="3881538460441135554">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του Phromium</translation>
<translation id="7479187736743594081">Το αρχείο <ph name="FILE_NAME" /> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Phromium.</translation>
<translation id="6646104775883837119">Το Phromium θα κλείσει σύντομα και θα διαγράψει τα δεδομένα</translation>
<translation id="6138634751748297112">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ σας Phromium</translation>
<translation id="8660563290103481109">Εάν επιτρέπεται η λήψη cookie, το Phromium μπορεί να τα χρησιμοποιεί κατά την προφόρτωση</translation>
<translation id="6165508094623778733">Μάθετε περισσότερα</translation>
<translation id="969667123257916656">Διαγράψετε τα δεδομένα του Phromium στον λογαριασμό σας</translation>
<translation id="5528040738212560214">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο<ph name="LINE_BREAK" />Το Phromium μπορεί να ελέγξει αυτή τη λήψη για εσάς εάν καταχωρίσετε τον κωδικό πρόσβασης. Οι πληροφορίες σχετικά με το αρχείο αποστέλλονται στην Ασφαλή περιήγηση Google, αλλά το περιεχόμενο και ο κωδικός πρόσβασης του αρχείου παραμένουν στη συσκευή σας.</translation>
<translation id="6182736845697986886">Η εγκατάσταση απέτυχε λόγω εσωτερικού σφάλματος στον διακομιστή ενημέρωσης.</translation>
<translation id="6041381825442292659">Βεβαιωθείτε ότι έχετε συνδεθεί στο Phromium στη συσκευή σας <ph name="TARGET_DEVICE_NAME" /> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="2474943719592372017">Αναζητήστε και κάντε ερωτήσεις από οπουδήποτε, ακόμα και αν το Phromium είναι ελαχιστοποιημένο. Επιτρέπει στο Phromium να εκτελείται στο παρασκήνιο.</translation>
<translation id="2518372260387069450">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του Phromium. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το Phromium και κατεβάστε το ξανά.</translation>
<translation id="3832895416321159809">{0,plural, =0{Η επανεκκίνηση του Phromium θα γίνει τώρα}=1{Η επανεκκίνηση του Phromium θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του Phromium θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="2775110773501098464">Το Phromium χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="3505491405575013121">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Phromium</translation>
<translation id="2276249127856880228">Ορισμός Phromium ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="6248988683584659830">Αναζήτηση ρυθμίσεων</translation>
<translation id="554637698797403739">Αποκτήστε τις καλύτερες λειτουργίες ασφάλειας της Google εν κινήσει, με την εφαρμογή Phromium στο τηλέφωνό σας</translation>
<translation id="7016155178198587734">Θέλετε να αποσυνδεθείτε από το Phromium;</translation>
<translation id="5660287988409470276">Αυτές οι καρτέλες χρησιμοποιούν επιπλέον πόρους. Για να βελτιώσετε την απόδοσή σας, επιτρέψτε στο Phromium να τις απενεργοποιήσει.</translation>
<translation id="8429776045186716992">Προσαρμόστε το προφίλ σας Phromium</translation>
<translation id="3310436202618971091">Ονομάστε το προφίλ σας στο Phromium</translation>
<translation id="1478750151648434251">Μια επέκταση θέλει να συνδεθείτε στο Phromium</translation>
<translation id="9139712828910812615">Το αρχείο <ph name="FILE_NAME" /> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Phromium.</translation>
<translation id="5191618263102115907">Το Phromium χρησιμοποιεί την κάμερά σας.</translation>
<translation id="8247508943089477519">Μια άλλη λειτουργία στο Phromium βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="8271488218611798813">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το Phromium με το Λογαριασμό σας Google και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="446228390478495078">Αποκτήστε εύκολη πρόσβαση στις λειτουργίες που γνωρίζετε, αγαπάτε και εμπιστεύεστε, ορίζοντας το Phromium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="2203435422524224690">Συντόμευση Phromium</translation>
<translation id="3977517784144885449">Το Phromium απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του αρχείου και ενδέχεται να είναι επικίνδυνο</translation>
<translation id="8088471547690853921">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του Phromium;</translation>
<translation id="6375219077595103062">Προσθήκη συντόμευσης στον Διαχειριστή κωδικών πρόσβασης</translation>
<translation id="6388799252195623474">βοήθησέ με με αυτή την εργασία</translation>
<translation id="1774421040071124552">Για να συνεχίσετε, συνδεθείτε στο Phromium ως <ph name="EMAIL" />. Αυτή η ενέργεια διασφαλίζει ότι ακολουθείτε τις πολιτικές του οργανισμού σας.</translation>
<translation id="2343430845154053061">Λογότυπο Phromium μέσα σε οθόνη υπολογιστή.</translation>
<translation id="2724924185145648602">Το Phromium είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="7417453886359805803">Για να βεβαιωθείτε ότι θα μπορείτε να χρησιμοποιείτε και να αποθηκεύετε πάντα δεδομένα Phromium στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="3304683228794166031">Το Phromium εκτελείται πιο γρήγορα και οι λειτουργίες που χρησιμοποιούν JavaScript θα πρέπει να λειτουργούν με τον αναμενόμενο τρόπο</translation>
<translation id="6436260184216827876">Η Αναζήτηση με εικόνες δεν είναι διαθέσιμη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="6442900851116057561">Επανεκκίνηση Chromium OS</translation>
<translation id="9164801375934097818">Το Phromium προφορτώνει ακόμα περισσότερες σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνουν πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="2577121659922309103">Κατεβάστε το Phromium στο τηλέφωνό σας για παρακολούθηση τιμών και λήψη ειδοποιήσεων σε περίπτωση πτώσης τιμής σε οποιονδήποτε ιστότοπο</translation>
<translation id="2052328618318278030">Ανενεργή • Το Phromium δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="3122296739697671126">Καλώς ήρθατε στα προφίλ του Phromium</translation>
<translation id="3472445024540245926">Την επόμενη φορά που θα ανοίξετε το Phromium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση των ομάδων καρτελών.</translation>
<translation id="2144084801479939969">Κατάργηση λογαριασμού από το Phromium</translation>
<translation id="2473490714352939152">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Phromium.</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="359777544552173333">Απεγκατάσταση Phromium</translation>
<translation id="3890462049854841354">Οι συντομεύσεις ανοίγουν στο Phromium</translation>
<translation id="6616579671682178785">Ο οργανισμός σας κλείνει το Phromium όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="8662645370371079862">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο Phromium, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="6556755379298048869">Κάντε αναζήτηση με συντόμευση πληκτρολογίου.</translation>
<translation id="7133640529688742768">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK" />πώς το Phromium διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK" /></translation>
<translation id="8316065704185291024">Οι αλλαγές σε αυτή τη ρύθμιση θα εφαρμοστούν μετά από την επανεκκίνηση του Phromium.</translation>
<translation id="2816396636285296289">Διαχειριστείτε τις επεκτάσεις σας, κάνοντας κλικ στην επιλογή Επεκτάσεις στο κύριο μενού του Phromium.</translation>
<translation id="8831144879019828189">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ Phromium</translation>
<translation id="7017911482442558099">Χρησιμοποιήστε την εφαρμογή Phromium για να έχετε μαζί σας τα καλύτερα εργαλεία AI</translation>
<translation id="5784574554904759369">Για τη διόρθωση ορθογραφικών λαθών, το Phromium στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο Google</translation>
<translation id="8485501471305987872">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του Phromium</translation>
<translation id="6600016381025017075">Αναζητήστε οτιδήποτε σε αυτή τη σελίδα</translation>
<translation id="1462793186918694806">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το Phromium.</translation>
<translation id="7501991510212476553">Το Phromium ανοίγει πλέον κατά την εκκίνηση των Windows, ώστε να μπορείτε να ξεκινήσετε άμεσα την περιήγηση. Μπορείτε να απενεργοποιήσετε αυτή τη λειτουργία στις ρυθμίσεις.</translation>
<translation id="7686308613268368175">Συνεχίστε από εκεί που σταματήσατε: Το Phromium έκανε επαναφορά των καρτελών σας από την τελευταία περίοδο λειτουργίας. Μπορείτε να απενεργοποιήσετε αυτή τη ρύθμιση στην ενότητα</translation>
<translation id="5266723901802366313">Το Phromium χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="7085315067428293799">Εάν αποθηκεύσετε τους σελιδοδείκτες σας και στον Λογαριασμό σας Google, μπορείτε να παρακολουθείτε τις τιμές των προϊόντων στο Phromium και να λαμβάνετε ειδοποιήσεις όταν παρατηρείται πτώση τιμών</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="668175097507315160">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="5279767706090517695">Κατάργηση των δεδομένων αυτής της εφαρμογής από το Phromium</translation>
<translation id="6562226321659107531">Το Phromium χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="6712881677154121168">Σφάλμα λήψης: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του Phromium.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του Phromium.</translation>
<translation id="4914871493602315663">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το Phromium στη Δραστηριότητα ιστού και εφαρμογών και στις συνδεδεμένες υπηρεσίες Google</translation>
<translation id="5919390816124912606">Το Phromium είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="5867815953973052697">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium. Αυτός ο σελιδοδείκτης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="7381168634819530324">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Phromium, αλλά καθιστά το Phromium ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι ενεργοποιημένη.</translation>
<translation id="1509688792864707851">{count,plural, =1{Ορισμένα δεδομένα του Phromium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Ορισμένα δεδομένα του Phromium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="4702638565169602649">Το Phromium συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="6779406956731413166">Το Chromium OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="1564864902402454287">Το Phromium σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="684888714667046800">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Εάν χρησιμοποιείτε τείχος προστασίας, βεβαιωθείτε ότι το <ph name="PRODUCT_EXE_NAME" /> είναι στη λίστα επιτρεπομένων.</translation>
<translation id="6200419390448865091">Phromium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Πατήστε Tab για συνέχεια</translation>
<translation id="6862030660799253820">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="6869568587896659271">Εύκολη πρόσβαση σε ιστοτόπους κάτω από τη γραμμή διευθύνσεων</translation>
<translation id="4011399428346318467">Το Phromium εντόπισε κακόβουλο πρόγραμμα στην επέκταση <ph name="EXTENSION_NAME" />.</translation>
<translation id="6877155553248388166">κάτω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Αντιγραφή</translation>
<translation id="6898028264630240901">Μπορείτε να καρφιτσώσετε τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="1012681980425424211">Ορίστε το Phromium ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="1744625657438211994">&amp;Διαχείριση προφίλ Phromium</translation>
<translation id="7264818828956697552">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK" />
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK" />
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAK" />
            • Θα επαναφέρει τις συντομεύσεις του Phromium
            <ph name="LINE_BREAKS" />
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="6489000842445481390">Έχετε συμπληρώσει το όριο των <ph name="BOOKMARK_LIMIT" /> σελιδοδεικτών του Phromium, επομένως ορισμένοι από τους σελιδοδείκτες σας δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google.

Δεν θα είναι δυνατή η αποθήκευση νέων σελιδοδεικτών στον λογαριασμό σας μέχρι να διαγράψετε ορισμένους. Εάν αποσυνδεθείτε τώρα, οι μη αποθηκευμένοι σελιδοδείκτες θα διαγραφούν.</translation>
<translation id="2645108248038996858">Άνοιγμα συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης Phromium</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">Όροι του Chromium OS</translation>
<translation id="2947519843530032104">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Phromium στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Η εγκατάσταση απέτυχε επειδή αυτή η έκδοση του λειτουργικού συστήματος δεν υποστηρίζεται.</translation>
<translation id="7024536598735240744">Σφάλμα αποσυσκευασίας: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">Προσαρμόστε το Phromium για εσάς</translation>
<translation id="7047386856539490735">Είναι χρήσιμα αυτά τα αποτελέσματα;</translation>
<translation id="2448910402556368916">Ενημέρωση Phromium</translation>
<translation id="7834049737623892628">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Phromium θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google.</translation>
<translation id="1803168627715642217">Αξιοποιήστε τη δύναμη του AI όταν χρησιμοποιείτε την εφαρμογή Phromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="3321731353906178474">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή Phromium στο τηλέφωνό σας</translation>
<translation id="7141270731789036260">Προσαρμογή του Chrome for Testing</translation>
<translation id="8077731669779275332">Μπορείτε να χρησιμοποιείτε το Phromium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="611798798247797100">Κατάργηση της επέκτασης <ph name="EXTENSION_NAME" /> από το Phromium</translation>
<translation id="7962394294883785044">Ο οργανισμός σας διαγράφει τα δεδομένα του Phromium όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION" />. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="2611686760870033712">Το Phromium χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="71050417052775020">Δεν ήταν δυνατή η εκκίνηση του Phromium. Προσπάθησε ξανά.</translation>
<translation id="4817060241763895497">Ρωτήστε οτιδήποτε, όπου κι αν βρίσκεστε, με το Gemini στο Phromium</translation>
<translation id="869358700049263961">Διατηρήστε το Phromium στο Dock για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="7094488679340739251">Χρησιμοποιήστε το Phromium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="7216228761061470870">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες σε υπολογιστή, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή</translation>
<translation id="7802634650401946711">Διαχείριση Εργασιών - Phromium</translation>
<translation id="5182547787327636348">Ρωτήστε σχετικά με περιεχόμενο εκτός του Phromium, όπως για άλλες εφαρμογές ή αρχεία</translation>
<translation id="1673408954678067905">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="5761733252154904648">Ξεκινήστε άμεσα την περιήγηση: Το Phromium μπορεί πλέον να ανοίγει κατά την εκκίνηση των Windows.</translation>
<translation id="7274695763216404502">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά την Αναζήτηση με εικόνες από τη γραμμή εργαλείων</translation>
<translation id="7288567540154601580">Καρτέλες και επεκτάσεις</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{Το Phromium προτείνει να την καταργήσετε}other{Το Phromium προτείνει να τις καταργήσετε}}</translation>
<translation id="1408728332407453335">Για κοινή χρήση του ήχου συστήματος, ανοίξτε τις Ρυθμίσεις συστήματος και επιτρέψτε την επιλογή "Μόνο εγγραφή ήχου συστήματος" για το Phromium. Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Phromium.</translation>
<translation id="7299899569525778554">Αναζήτηση από υπολογιστή</translation>
<translation id="6194310460545162015">Ενημέρωση του Phromium</translation>
<translation id="1098154893096691883">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το Phromium δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="7324051657739063017">Μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="7024097830259741656">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του Phromium.</translation>
<translation id="852511575759652041">Μόνο κάποιος που γνωρίζει τη φράση πρόσβασης μπορεί να διαβάσει τα κρυπτογραφημένα δεδομένα σας. H φράση πρόσβασης δεν αποστέλλεται στην Google, ούτε αποθηκεύεται από αυτήν. Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, θα χρειαστεί να <ph name="BEGIN_LINK" />διαγράψετε τα δεδομένα του Phromium στον λογαριασμό σας<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505">Ο διαχειριστής συστήματος έχει διαμορφώσει το Phromium ώστε να ανοίγει το <ph name="ALTERNATIVE_BROWSER_NAME" /> για την πρόσβαση σε <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="7198690862684855451">Για τη λήψη μελλοντικών ενημερώσεων του Phromium, θα χρειαστείτε macOS 13 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 12.</translation>
<translation id="3224607549103501149">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Phromium κατάργησε τις άδειες <ph name="PERMISSION_1" /> και <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Άνοιγμα του Chrome Web Store</translation>
<translation id="8446269872172461565">Εμφάνιση του Gemini στο Phromium στην περιοχή ειδοποιήσεων</translation>
<translation id="7401687852903179959">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="3403529853122418035">Το Phromium είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="5649377421626481711">Συνεχίστε από το σημείο που σταματήσατε: Το Phromium επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να απενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="2467776530444676191">Εισαγωγή κωδικών πρόσβασης στο Phromium</translation>
<translation id="8814480293815136510">1. Κάντε κλικ στο κουμπί <ph name="BUTTON_LABEL" /> παρακάτω
2. Κάντε κλικ στο κουμπί <ph name="BUTTON_2" /> στις ρυθμίσεις των Windows
3. Κάντε κλικ στο κουμπί <ph name="BUTTON_3" /> στην ειδοποίηση των Windows για να καρφιτσώσετε το Phromium στη γραμμή εργαλείων για γρήγορη πρόσβαση</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - Phromium Dev</translation>
<translation id="7450541714075000668">Το κείμενο αντιγράφηκε</translation>
<translation id="6826407056979820031">Για χρήση του μικροφώνου, παραχωρήστε πρόσβαση στο Phromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="1392131731909663319">Για τη λήψη μελλοντικών ενημερώσεων του Phromium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="4512427777724578739">Επανεκκίνηση του Phromium;</translation>
<translation id="4510527847350985067">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του Phromium που εκτελείται αυτήν τη στιγμή. Κλείστε το Phromium και δοκιμάστε ξανά.</translation>
<translation id="7510190804000607802">Υπενθύμιση: Οι καλύτερες λειτουργίες της Google στην τσέπη σας</translation>
<translation id="4735608937705010375">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο. Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Phromium, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Phromium.</translation>
<translation id="7987051132742764178">{0,plural, =1{Η επανεκκίνηση του Phromium θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του Phromium θα γίνει σε # λεπτά}}</translation>
<translation id="1904271152425995672">Για την προστασία των δεδομένων σας, επιτρέψτε στο Phromium να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα.</translation>
<translation id="7909976731673595773">Ανοίξτε αυτόματα το Phromium, για να αρχίσετε άμεσα την περιήγηση.</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME" /></translation>
<translation id="3301232962183130807">Το Phromium χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="3230129417775002227">Το Phromium έγινε ακόμα καλύτερο</translation>
<translation id="1322165820810533683">Έχετε πλέον περισσότερες διαθέσιμες λειτουργίες στο Phromium</translation>
<translation id="7624307931717240213">Χρησιμοποιούμε πληροφορίες για τη βελτίωση αυτής της υπηρεσίας. Ανατρέξτε στην Πολιτική απορρήτου και στους Όρους παροχής υπηρεσιών.</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="3795437289339745990">Λήψη της εφαρμογής Phromium</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="6671257169702988694">Το Phromium δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="7270402397025248165">Συγχρονίστε και εξατομικεύστε το Phromium στις συσκευές σας</translation>
<translation id="6267574654655324634">Ενημέρωση Phromium</translation>
<translation id="4868190765388740513">Η εργασία σας προστατεύεται στο Phromium</translation>
<translation id="7716950018788545737">Οι εργασίες τερματίστηκαν.</translation>
<translation id="77283119132245232">Παρέχει υπηρεσίες ανίχνευσης συστήματος για το <ph name="BROWSER_NAME" />. Εάν αυτή η υπηρεσία είναι απενεργοποιημένη, τα ίχνη απόδοσης που δημιουργούνται από το πρόγραμμα περιήγησης δεν θα περιλαμβάνουν συμβάντα σε επίπεδο συστήματος, όπως συμβάντα εναλλαγής περιβάλλοντος και συμβάντα ετοιμότητας νήματος.</translation>
<translation id="2680098142787722612">Με αυτή την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Phromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="6830826880333833598">Επαναφορά της προεπιλογής Phromium</translation>
<translation id="448710321315554838">Για την προστασία της εργασίας σας στο Phromium, ο οργανισμός σας θα μπορεί να βλέπει ή να διαχειρίζεται ορισμένες πληροφορίες όταν είστε συνδεδεμένοι στο Phromium.</translation>
<translation id="7045209483723342691">Ορίστε το Phromium ως προεπιλογή και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="6452735947982563207">Κάντε το Phromium πιο γρήγορο</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - Phromium Canary</translation>
<translation id="6929858452581400763">Κάντε πιο δύσκολο για άτομα που έχουν πρόσβαση στη διαδικτυακή κίνησή σας να βλέπουν ποιους ιστοτόπους επισκέπτεστε. Το Phromium χρησιμοποιεί μια ασφαλή σύνδεση για να αναζητήσει τη διεύθυνση IP ενός ιστοτόπου στο DNS (Domain Name System).</translation>
<translation id="7810005234485217901">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση</translation>
<translation id="4343392731007327660">Επιλέξτε τι θα κοινοποιείτε στο Phromium</translation>
<translation id="3052274192923256457">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ Phromium με αυτόν τον λογαριασμό</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="5674414381037997114">Η μηχανή αναζήτησης άλλαξε από άλλο πρόγραμμα εκτός του Phromium. Για την προστασία σας, το Phromium την επανέφερε στην αρχική προεπιλογή. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Προσαρμόστε το Phromium για να του δώσετε μια νέα εμφάνιση</translation>
<translation id="3966946337517395351">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Phromium στέλνει αυτό που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησης για να λάβει καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ανώνυμη περιήγηση.</translation>
<translation id="3928367799779122681">Δεν ήταν δυνατή η ενημέρωση του Phromium στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS" /> δευτερόλεπτα.</translation>
<translation id="8492102592995742850">Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK" />διαγράψτε τα δεδομένα του Phromium στον λογαριασμό σας<ph name="END_LINK" /></translation>
<translation id="959404544431817539">Ανοίξτε γρήγορα το Gemini στο Phromium όποτε το χρειάζεστε</translation>
<translation id="8889749279816358185">Ορισμός του Phromium ως προεπιλογής</translation>
<translation id="3173775358556080672">Το Phromium αναβαθμίζει αυτόματα τις μη ασφαλείς συνδέσεις σε HTTPS, όταν είναι εφικτό</translation>
<translation id="2210801904933897209">Συνδεθήκατε στο Phromium ως <ph name="USER_EMAIL_ADDRESS" />. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="7291855477503010638">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="5706099517903615644">Αυτή είναι μια δευτερεύουσα εγκατάσταση του Phromium και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="2388440031754359882">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το Phromium συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="8205108509545565485">Αξιοποιήστε τις καλύτερες λειτουργίες της Google με την εφαρμογή Phromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8004582292198964060">Πρόγραμμα περιήγησης</translation>
<translation id="8010081455002666927">Αυτόματος εντοπισμός</translation>
<translation id="6421861275173778152">Όταν το Phromium αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="942087293138739513">Καρφιτσώστε το Phromium στη γραμμή εργαλείων για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="8069447462453318634">Επιλέξτε "Καρφίτσωμα στη γραμμή εργαλείων"</translation>
<translation id="8519423983825025511">Απενεργοποίηση του Phromium, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="80790299200510644">Αναζήτηση με εικόνες</translation>
<translation id="8086881907087796310">Η εγκατάσταση απέτυχε επειδή ο υπολογιστής σας δεν πληροί τις ελάχιστες απαιτήσεις εξοπλισμού.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="7988414336652558428">Το Phromium χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="1778610353097215460">Την επόμενη φορά που θα ανοίξετε το Phromium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για ενεργοποίηση των ειδοποιήσεων παρακολούθησης τιμής.</translation>
<translation id="4182143801062869250">Λάβετε ειδοποιήσεις για πτώση τιμής σε προϊόντα που σας ενδιαφέρουν με την εφαρμογή Phromium στο τηλέφωνό σας</translation>
<translation id="8118331347066725040">Αποστολή σχολίων για την αναζήτηση με το Lens</translation>
<translation id="849080025203861031">Εξατομικεύστε το Phromium</translation>
<translation id="8133124826068723441">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="139377652856781272">Ανοίξτε το Gemini στο Phromium με μια συντόμευση πληκτρολογίου.</translation>
<translation id="8577594891153686998">Πρόσθετοι όροι παροχής υπηρεσιών του Phromium</translation>
<translation id="6418547610462348357">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το Phromium.</translation>
<translation id="8177472873527554730">Δεν είναι δυνατή η εύρεση περιεχομένου στη σελίδα</translation>
<translation id="6257816439683677727">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Phromium στον λογαριασμό σας, <ph name="USER_EMAIL" /></translation>
<translation id="820759916613250543">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="8221491193165283816">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ εδώ.</translation>
<translation id="8672013454464753607">Για χρήση της κάμερας, παραχωρήστε πρόσβαση στο Phromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="8006746139865532235">Το Phromium δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Phromium, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων.</translation>
<translation id="5474258904581730105">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Phromium θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="5375524124600974413">Σύνδεση στο Phromium με νέο προφίλ;</translation>
<translation id="5242991719841602450">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Phromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="6524280192518819368">Εμφάνιση του Gemini στο Phromium στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="2082268001133511745"><ph name="BEGIN_LINK" />Το Phromium σας προειδοποιεί<ph name="END_LINK" /> σχετικά με μη ασφαλείς ιστοτόπους και λήψεις</translation>
<translation id="4030955203048827163">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Phromium κατάργησε την άδεια <ph name="PERMISSION" />.</translation>
<translation id="8358344509940735943">Αγοράστε, μεταφράστε και προσδιορίστε ό,τι βλέπετε με την κάμερα στην εφαρμογή Phromium iOS</translation>
<translation id="7062802333437169650">Κωδικός QR για σύνδεση στο Phromium ως <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Σφάλμα εκκίνησης: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062">Ο οργανισμός σας κλείνει το Phromium όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">Αποθήκευση ως εικόνα</translation>
<translation id="6013358021678212671">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS" /> χρησιμοποιούσε το Phromium στο παρελθόν</translation>
<translation id="5445795756751365814">Ενεργοποίηση Δεξιοτήτων στο Phromium</translation>
<translation id="7329745364783464770">Ενημερώστε το Phromium, για να συνεχίσετε να χρησιμοποιείτε τα δεδομένα του Phromium στον Λογαριασμό σας Google, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="5255856786869089460">Για τη λήψη μελλοντικών ενημερώσεων του Phromium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="8362914115861174987">Μετάφραση στα</translation>
<translation id="8367705492654390392">Ρωτήστε οτιδήποτε</translation>
<translation id="8370517070665726704">Πνευματικά δικαιώματα <ph name="YEAR" /> Google LLC. Με την επιφύλαξη παντός δικαιώματος.</translation>
<translation id="7349410893766975486">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Phromium. Αυτός ο κωδικός πρόσβασης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="394196307309768356">Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Phromium.</translation>
<translation id="7466825726005300631">Το Phromium προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" /></translation>
<translation id="264088846642173954">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Phromium, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="1867604241588004166">Το Phromium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="926481158288852551">{0,plural, =1{Επανεκκίνηση του Phromium σε μία ημέρα}other{Επανεκκίνηση του Phromium σε # ημέρες}}</translation>
<translation id="8438543370129609977">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">Μάθετε περισσότερα σχετικά με την αναζήτηση με την Αναζήτηση εικόνων στο Phromium</translation>
<translation id="1069576136282928177">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το Phromium ξανά.</translation>
<translation id="7082388216101480391">Το Phromium απαιτεί Windows 10 ή νεότερη έκδοση.</translation>
<translation id="8463672209299734063">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Chromium OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην Google.</translation>
<translation id="4343027289807602417">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Phromium στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="6746404578800969443">Εμφάνιση οδηγιών για σύνδεση στο Phromium</translation>
<translation id="5072642661707587697">Το Phromium δεν είναι ενημερωμένο</translation>
<translation id="759684005114911774">Σας ευχαριστούμε που ορίσατε το Phromium ως το προεπιλεγμένο πρόγραμμα περιήγησης!</translation>
<translation id="5209258538041302334">Το Phromium μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύετε</translation>
<translation id="8525579356836940628">Η εγκατάσταση διακόπηκε</translation>
<translation id="6348113608284833604">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή Phromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="5083347044281842800">Λάβετε ειδοποίηση, εάν το Phromium εντοπίσει έναν από τους κωδικούς πρόσβασής σας σε μια δημόσια παραβίαση δεδομένων</translation>
<translation id="8555465886620020932">Σφάλμα υπηρεσίας: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">Ορισμένες λειτουργίες και επεκτάσεις του Phromium διαθέτουν συντομεύσεις. Μπορείτε να επιλέξετε να τις ενεργοποιήσετε ξανά.</translation>
<translation id="8556420416730706394">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση. Κάντε κλικ στο κουμπί Καρφίτσωμα στο επάνω μέρος του πλαϊνού πλαισίου</translation>
<translation id="856656450041460113">Αναζήτηση λίστας γλωσσών</translation>
<translation id="9159785833243360958">Πολλοί οργανισμοί διαχειρίζονται το Phromium</translation>
<translation id="8586442755830160949">Πνευματικά δικαιώματα <ph name="YEAR" /> Οι συντάκτες του Chromium. Με επιφύλαξη παντός δικαιώματος.</translation>
<translation id="3489957831482527036">Εκκίνηση του Phromium…</translation>
<translation id="8624541899164515475">Ρυθμίσεις, ανοίγει σε νέα καρτέλα.</translation>
<translation id="8648201657708811153">Το Google Chrome for Testing δεν μπορεί να οριστεί ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="7150069986792019616">Αναζήτηση με το Phromium από οπουδήποτε</translation>
<translation id="1623850835554120265">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Phromium ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="8828478112210313529">Για να στείλετε αυτή την καρτέλα σε άλλη συσκευή, συνδεθείτε στο Phromium στη συγκεκριμένη συσκευή</translation>
<translation id="3592747099485557650">Ορίστε το δικό σας Phromium</translation>
<translation id="8712637175834984815">Κατάλαβα!</translation>
<translation id="3388228047978619624">Σύνδεση στο Phromium;</translation>
<translation id="8747073452963259673">κάτω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Σφάλμα εγκατάστασης: Ο διαχειριστής του δικτύου σας έχει εφαρμόσει μια πολιτική ομάδας που εμποδίζει την εγκατάσταση: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Υπενθύμιση αργότερα</translation>
<translation id="614494151403742465">Μοιραστείτε αυτό το έγγραφο με το Gemini στο Phromium για να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="6346068443590018348">Σύνδεση στο Phromium;</translation>
<translation id="1468806565762231794">Ορισμός Phromium ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφίτσωμα στη γραμμή εργαλείων</translation>
<translation id="8826492472752484139">Κάντε κλικ στην επιλογή Διαχείριση κωδικών πρόσβασης</translation>
<translation id="8833697763442816810">Σύστημα Chromium OS</translation>
<translation id="4854784568701005121">Αυτή η γλώσσα χρησιμοποιείται για την προβολή μενού, ρυθμίσεων, ειδοποιήσεων και άλλου κειμένου στο Phromium</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="7804139416589625033">Προσθήκη προφίλ Phromium</translation>
<translation id="6333867241557949259">Δεν ήταν δυνατή η αποθήκευση δεδομένων Phromium στον Λογαριασμό σας Google από το ChromiumOS λόγω σφάλματος κατά τη σύνδεση</translation>
<translation id="2888440364511152939">Ο οργανισμός σας απαιτεί να συνδεθείτε στο Phromium</translation>
<translation id="7111325571010992010">Το Phromium προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="4406716425954955281">Το Phromium δεν είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης. Θέλετε να ορίσετε το Phromium ως το προεπιλεγμένο πρόγραμμα περιήγησης;</translation>
<translation id="2999847959360823770">Δεν είναι δυνατή η ενημέρωση του Phromium</translation>
<translation id="8944232836376404813">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK" />
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK" />
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAKS" />
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="7461167469691640632">Εμφάνιση συντομεύσεων ιστοτόπων στο Phromium</translation>
<translation id="7394133813796947510">Λογότυπο Phromium Enterprise</translation>
<translation id="2476839923452631964">Απολαύστε την ασφάλεια της Google εν κινήσει με την εφαρμογή Phromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="2041306781031361744">Δεν είναι δυνατή η έναρξη του Phromium, επειδή προέκυψε πρόβλημα κατά το άνοιγμα του προφίλ σας. Δοκιμάστε να επανεκκινήσετε το Phromium.</translation>
<translation id="8355079108092011401">για αναζήτηση με το Phromium ή προσαρμογή στις <ph name="BEGIN_LINK" />Ρυθμίσεις<ph name="END_LINK" /></translation>
<translation id="820370893610994443">Διαχείριση προφίλ Phromium</translation>
<translation id="1885039203623228439">Χρησιμοποιήστε το πληκτρολόγιό σας για να πλοηγηθείτε μεταξύ του Gemini στο Phromium και της ανοιχτής καρτέλας σας.</translation>
<translation id="9018218886431812662">Η εγκατάσταση ολοκληρώθηκε</translation>
<translation id="8213523024005590363">Για να κάνουμε το Phromium πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="1376667286722804744">Σύνδεση στο Phromium</translation>
<translation id="5142314855184111999">Εμφάνιση της αναζήτησης με το Phromium στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="5166485487967090892">Το Phromium απέκλεισε αυτή τη λήψη, επειδή το αρχείο αρχειοθέτησης περιλαμβάνει άλλα αρχεία που ενδέχεται να κρύβουν κάποιο κακόβουλο πρόγραμμα</translation>
<translation id="1902493242619542969">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Phromium ως το προεπιλεγμένο πρόγραμμα περιήγησης. Το Phromium θα καρφιτσωθεί στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="7092992855996941035">Χρησιμοποιήστε τα καλύτερα εργαλεία AI της Google με την εφαρμογή Phromium στο τηλέφωνό σας</translation>
<translation id="4203475068093609811">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Phromium</translation>
<translation id="7699507532215026981">Σύνδεση στο Phromium όταν συνδέεστε σε άλλες υπηρεσίες Google</translation>
<translation id="5571207595456818809">Το Phromium έκλεισε αυτόματα</translation>
<translation id="3670200098293484473">Το Phromium δεν είναι ενημερωμένο</translation>
<translation id="5636382052119887392">{0,plural, =1{Η επανεκκίνηση του Phromium θα γίνει σε μία ώρα}other{Η επανεκκίνηση του Phromium θα γίνει σε # ώρες}}</translation>
<translation id="9106236359747881194">Επιλογή κειμένου για αναζήτηση</translation>
<translation id="9197093250229894135">Για τη λήψη μελλοντικών ενημερώσεων του Phromium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="7195134700293253698">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα Phromium</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="9134482777260927479">Βοήθεια για σχολικές εργασίες</translation>
<translation id="9148058034647219655">Έξοδος</translation>
<translation id="8888942844777295083">Συνεχίστε από το σημείο που σταματήσατε: Το Phromium μπορεί να επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να ενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="1485079858205975514">Ο διαχειριστής συστήματος έχει διαμορφώσει το Phromium έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="1096075777207775410">Επανεκκίνηση για ενημέρωση του &amp;Phromium</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">Εξατομίκευση του Phromium</translation>
<translation id="6554170182570636227">Το Phromium μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="8145475184469284022">Μεταφέρετε μαζί σας τις καλύτερες λειτουργίες ασφαλείας της Google με το Phromium.</translation>
<translation id="945522503751344254">Αποστολή σχολίων</translation>
<translation id="1258071069834143371">Ποιος χρησιμοποιεί το Phromium;</translation>
<translation id="8272911737374467274">Λάβετε την ισχυρότερη προστασία του Phromium</translation>
<translation id="983803489796659991">Η εγκατάσταση απέτυχε επειδή ο διακομιστής ενημέρωσης δεν διαθέτει δεδομένα κατακερματισμού για την εφαρμογή.</translation>
<translation id="4087190600867587768">Χρήση του Phromium χωρίς λογαριασμό</translation>
<translation id="985602178874221306">Οι συντάκτες του Chromium</translation>
<translation id="989970834842471429">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="6649431194696226496">Για χρήση της τοποθεσίας σας, παραχωρήστε πρόσβαση στο Phromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
</translationbundle>