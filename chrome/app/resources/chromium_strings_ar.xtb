<translation id="7479187736743594081">‏ملف <ph name="FILE_NAME" /> ضار، لذلك فقد حظره Phromium.</translation>
<translation id="6646104775883837119">‏سيتم إغلاق Phromium وحذف بيانات التصفُّح قريبًا</translation>
<translation id="6138634751748297112">‏يمكنك من هنا التبديل بين الملفات الشخصية على Phromium.</translation>
<translation id="8660563290103481109">‏في حال السماح بملفات تعريف الارتباط، قد يستخدمها Phromium في عملية التحميل المُسبق.</translation>
<translation id="6165508094623778733">مزيد من المعلومات</translation>
<translation id="969667123257916656">‏محو بيانات Phromium في حسابك</translation>
<translation id="5528040738212560214">‏قد يكون هذا الملف خطيرًا.<ph name="LINE_BREAK" />بإمكان Phromium التحقُّق من عملية التنزيل هذه في حال أدخلت كلمة المرور. وتُرسل معلومات حول الملف إلى ميزة "التصفّح الآمن من Google"، ولكن يظل محتوى الملف وكلمة المرور على جهازك.</translation>
<translation id="6182736845697986886">تعذَّر تثبيت التطبيق بسبب حدوث خطأ داخلي في خادم التحديث.</translation>
<translation id="6041381825442292659">‏يُرجى التأكُّد من تسجيل الدخول إلى متصفِّح Phromium على جهازك <ph name="TARGET_DEVICE_NAME" /> ثم محاولة الإرسال مرة أخرى.</translation>
<translation id="2474943719592372017">‏يمكنك البحث وطرح الأسئلة باستخدام Phromium من أي مكان، حتى إن كان مصغّرًا. ويسمح هذا الإعداد بتشغيل Phromium في الخلفية.</translation>
<translation id="2518372260387069450">‏يحتوي هذا الكمبيوتر فعلاً على إصدار أحدث من Phromium. إذا كان البرنامج لا يعمل، يُرجى إزالة Phromium وإعادة المحاولة.</translation>
<translation id="3832895416321159809">{0,plural, =0{‏ستتم إعادة تشغيل Phromium الآن}=1{‏ستتم إعادة تشغيل Phromium في غضون ثانية واحدة}two{‏ستتم إعادة تشغيل Phromium في غضون ثانيتين}few{‏ستتم إعادة تشغيل Phromium في غضون # ثوان}many{‏ستتم إعادة تشغيل Phromium في غضون # ثانيةً}other{‏ستتم إعادة تشغيل Phromium في غضون # ثانية}}</translation>
<translation id="2775110773501098464">‏يحتاج Phromium إلى إذن للوصول إلى مساحة التخزين من أجل تنزيل الملفات.</translation>
<translation id="3505491405575013121">‏يعمل هذا الوضع على التحقّق من عناوين URL باستخدام قائمة بمواقع إلكترونية غير آمنة مُخزّنة في Phromium.</translation>
<translation id="2276249127856880228">‏جعل Phromium المتصفح التلقائي</translation>
<translation id="6248988683584659830">البحث في الإعدادات</translation>
<translation id="554637698797403739">‏يمكنك الاستفادة من أفضل ميزات الأمان من Google أثناء التنقل باستخدام تطبيق Phromium على هاتفك</translation>
<translation id="7016155178198587734">‏هل تريد الخروج من Phromium؟</translation>
<translation id="5660287988409470276">‏تستخدم علامات التبويب هذه موارد إضافية. لتحسين أداء التصفُّح، ننصح بالسماح لمتصفّح Phromium بإيقاف علامات التبويب هذه.</translation>
<translation id="8429776045186716992">‏تخصيص ملفك الشخصي في Phromium</translation>
<translation id="3310436202618971091">‏تسمية ملفك الشخصي على Phromium</translation>
<translation id="1478750151648434251">‏تطلب منك إحدى الإضافات تسجيل الدخول إلى Phromium</translation>
<translation id="9139712828910812615">‏قد يكون ملف <ph name="FILE_NAME" /> ضارًا، لذلك فقد حظره Phromium.</translation>
<translation id="5191618263102115907">‏يستخدم Phromium الكاميرا.</translation>
<translation id="8247508943089477519">‏عملية أخرى على Phromium قيد التقدم. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="8271488218611798813">‏الآن أصبح استخدام Phromium مع حسابك في Google وفي أجهزة الكمبيوتر المشتركة أكثر سهولة.</translation>
<translation id="446228390478495078">‏يمكنك الوصول بسهولة إلى الميزات المفضَّلة والموثوقة لديك من خلال ضبط Phromium كمتصفِّحك التلقائي.</translation>
<translation id="2203435422524224690">‏اختصار Phromium</translation>
<translation id="3977517784144885449">‏حَظَر Phromium عملية التنزيل هذه لأنّ الملف لا يتم تنزيله عادةً، وقد يكون خطيرًا.</translation>
<translation id="8088471547690853921">‏هل تريد فعلًا إزالة Phromium؟</translation>
<translation id="6375219077595103062">إضافة اختصار إلى "مدير كلمات المرور"</translation>
<translation id="6388799252195623474">أريد مساعدة بخصوص هذا المحتوى</translation>
<translation id="1774421040071124552">‏للمتابعة، يُرجى تسجيل الدخول إلى Phromium باستخدام حساب <ph name="EMAIL" />. ويضمن ذلك أنّك قد اطّلعت على سياسات مؤسستك.</translation>
<translation id="2343430845154053061">‏شعار Phromium على شاشة كمبيوتر</translation>
<translation id="2724924185145648602">‏ إن Phromium هو متصفح ويب يشغّل صفحات الويب والتطبيقات بسرعة مذهلة. إنه سريع وثابت وسهل الاستخدام. يمكنك تصفح الويب بشكل أكثر أمانًا من خلال ميزات الحماية من البرامج الضارة والتصيّد الاحتيالي المدمجة في Phromium.</translation>
<translation id="7417453886359805803">‏لضمان إمكانية استخدامك لبيانات Phromium وحفظها في حسابك على Google متى شئت، يجب إثبات هويتك</translation>
<translation id="3304683228794166031">‏سيعمل Phromium بشكل أسرع ومن المفترض أن تعمل الميزات التي تستخدِم JavaScript على النحو المطلوب</translation>
<translation id="6436260184216827876">ميزة "البحث بالصور" ليست متوفرة. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="6442900851116057561">‏إعادة تشغيل نظام التشغيل Chromium</translation>
<translation id="9164801375934097818">‏يُحمِّل Phromium مسبقًا المزيد من الصفحات التي يُحتمل أن تزورها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="2577121659922309103">‏يكفي تنزيل متصفِّح Phromium على هاتفك لتتبُّع الأسعار والحصول على تنبيهات عند انخفاضها على أي موقع إلكتروني</translation>
<translation id="2052328618318278030">‏غير مفعَّلة • لا يمكن لمتصفّح Phromium التحقُّق من مصدر هذه الإضافة</translation>
<translation id="3122296739697671126">‏مرحبًا بك في الملفات الشخصية على Phromium</translation>
<translation id="3472445024540245926">‏عند فتح Phromium على <ph name="DEVICE_TYPE" /> في المرة القادمة، ستظهر لك رسالة تطلب منك استخدام مجموعات علامات التبويب.</translation>
<translation id="2144084801479939969">‏إزالة الحساب من Phromium</translation>
<translation id="2473490714352939152">‏كما أنها تتحكم في الصفحة التي تظهر عند تشغيل Phromium.</translation>
<translation id="648319183876919572">تعزِّز ميزة "الحماية المُحسّنة للتصفّح الآمن" حمايتك من المواقع الإلكترونية الضارة وعمليات التنزيل الخطيرة.</translation>
<translation id="359777544552173333">‏إزالة Phromium</translation>
<translation id="3890462049854841354">‏يتم فتح الاختصارات في Phromium</translation>
<translation id="6616579671682178785">‏تغلق مؤسستك Phromium في حال عدم استخدامه لمدّة <ph name="TIMEOUT_DURATION" />. تم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.</translation>
<translation id="8662645370371079862">‏يحتفظ كل ملف شخصي بالمعلومات الخاصة به على Phromium، مثل الإشارات المرجعية والسجلّ وكلمات المرور وغير ذلك.</translation>
<translation id="6556755379298048869">يمكنك البحث باستخدام أحد اختصارات لوحة المفاتيح.</translation>
<translation id="7133640529688742768">‏مزيد من المعلومات حول <ph name="BEGIN_LINK" />الطريقة التي يتّبعها Phromium للحفاظ على خصوصية بياناتك<ph name="END_LINK" /></translation>
<translation id="8316065704185291024">‏سيتم تطبيق التغييرات في هذا الإعداد بعد إعادة تشغيل Phromium.</translation>
<translation id="2816396636285296289">‏يمكنك إدارة الإضافات من خلال النقر على "الإضافات" في قائمة Phromium الرئيسية.</translation>
<translation id="8831144879019828189">‏يمكنك التبديل للاطّلاع على كلمات المرور من ملف شخصي آخر في Phromium.</translation>
<translation id="7017911482442558099">‏أفضل أدوات الذكاء الاصطناعي ستكون متاحة لك أثناء التنقل عند استخدام تطبيق Phromium</translation>
<translation id="5784574554904759369">‏لإصلاح الأخطاء الإملائية، يُرسِل Phromium ما تكتبه في حقول النص إلى Google</translation>
<translation id="8485501471305987872">‏الانتقال إلى إعدادات الإشعارات في Phromium</translation>
<translation id="6600016381025017075">البحث عن أي محتوى على هذه الصفحة</translation>
<translation id="1462793186918694806">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل Phromium.</translation>
<translation id="7501991510212476553">‏يتم الآن فتح Phromium تلقائيًا عند بدء تشغيل Windows، ما يتيح لك بدء التصفّح على الفور. ويمكنك إيقاف هذا الإجراء من خلال الإعدادات.</translation>
<translation id="7686308613268368175">‏المتابعة من حيث توقفت: استعاد Phromium علامات التبويب من جلستك الأخيرة. يمكنك إيقاف هذه الميزة في</translation>
<translation id="5266723901802366313">‏يحتاج Phromium إلى إذن للوصول إلى الكاميرا من أجل إنشاء خريطة ثلاثية الأبعاد للمكان حولك.</translation>
<translation id="7085315067428293799">‏إذا حفظت أيضًا إشاراتك المرجعية في حسابك على Google، يمكنك تتبُّع أسعار المنتجات من خلال Phromium وتلقّي إشعارات عند انخفاض السعر.</translation>
<translation id="6676384891291319759">الدخول إلى الإنترنت</translation>
<translation id="668175097507315160">‏تعذّر على نظام التشغيل Chromium مزامنة بياناتك بسبب حدوث خطأ أثناء تسجيل الدخول.</translation>
<translation id="5279767706090517695">‏إزالة بيانات هذا التطبيق من Phromium</translation>
<translation id="6562226321659107531">‏يحتاج Phromium إلى إذن للوصول إلى الميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="6712881677154121168">حدث خطأ في عملية التنزيل: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">‏لا يمكن استخدام ملفك الشخصي نظرًا لأنه من إصدار أحدث من Phromium.

قد تكون بعض الميزات غير متاحة. يُرجى تحديد دليل ملف شخصي مختلف أو استخدام إصدار أحدث من Phromium.</translation>
<translation id="4914871493602315663">‏للحصول على خيارات مخصَّصة والاستفادة من ميزات أخرى، يمكنك تضمين متصفّح Phromium في "النشاط على الويب وفي التطبيقات" وخدمات Google المرتبطة</translation>
<translation id="5919390816124912606">‏يتم تثبيت Phromium بالفعل لجميع المستخدمين على جهاز الكمبيوتر.</translation>
<translation id="5867815953973052697">‏يتيح لك تسجيل الدخول إلى Phromium الوصول إلى الإشارات المرجعية وغيرها على جميع أجهزتك. وسيتم حفظ هذه الإشارة المرجعية في حسابك على Google بعد تسجيل الدخول إليه.</translation>
<translation id="7381168634819530324">‏يعمل هذا الإعداد على زيادة سرعة المواقع الإلكترونية باستخدام محرّك V8 في Phromium، مع تقليل قدرة Phromium على مقاومة الهجمات قليلاً. هذا الإعداد مفعَّل.</translation>
<translation id="1509688792864707851">{count,plural, =1{‏لم يتم حفظ بعض بيانات Phromium في حسابك على Google إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف عنصر واحد من هذه البيانات.}zero{‏لم يتم حفظ بعض بيانات Phromium في حسابك على Google إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}two{‏لم يتم حفظ بعض بيانات Phromium في حسابك على Google إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف عنصرَين ({count}) من هذه البيانات.}few{‏لم يتم حفظ بعض بيانات Phromium في حسابك على Google إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عناصر من هذه البيانات.}many{‏لم يتم حفظ بعض بيانات Phromium في حسابك على Google إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصرًا من هذه البيانات.}other{‏لم يتم حفظ بعض بيانات Phromium في حسابك على Google إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}}</translation>
<translation id="4702638565169602649">‏ينصح متصفِّح Phromium بفحص هذا الملف لأنّه قد يكون خطيرًا.</translation>
<translation id="6779406956731413166">‏أصبح نظام التشغيل Chromium متاحًا من خلال <ph name="BEGIN_LINK_CROS_OSS" />برنامج إضافي مفتوح المصدر<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">ترجمة</translation>
<translation id="1564864902402454287">‏يتم إعلامك من خلال Phromium في حال تم اختراق كلمات المرور في أي وقت.</translation>
<translation id="684888714667046800">يتعذّر الاتصال بالإنترنت. في حال استخدام جدار حماية، يُرجى التأكّد من إدراج <ph name="PRODUCT_EXE_NAME" /> في القائمة المسموح بها.</translation>
<translation id="6200419390448865091">Phromium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">‏يجب النقر على مفتاح Tab للمتابعة</translation>
<translation id="6862030660799253820">البحث عن هذه الصورة باستخدام ميزة "البحث بالصور"</translation>
<translation id="6869568587896659271">يمكنك الوصول بسهولة إلى المواقع الإلكترونية أسفل شريط العناوين</translation>
<translation id="4011399428346318467">‏رصد Phromium أنّ الإضافة "<ph name="EXTENSION_NAME" />" تحتوي على برامج ضارة.</translation>
<translation id="6877155553248388166">أسفل يسار مساحة البحث: %<ph name="RIGHT" /> من الجهة اليسرى و%<ph name="BOTTOM" /> من الأسفل</translation>
<translation id="6896758677409633944">نسخ</translation>
<translation id="6898028264630240901">يمكنك تثبيت "المهام السياقية" لطرح الأسئلة أثناء التصفّح</translation>
<translation id="1012681980425424211">‏ننصحك بضبط Phromium كمتصفّح تلقائي وتثبيته في شريط المهام</translation>
<translation id="1744625657438211994">‏&amp;إدارة الملفات الشخصية على Phromium</translation>
<translation id="7264818828956697552">‏سيؤدي هذا الإجراء إلى ما يلي:
          <ph name="LINE_BREAKS" />
            • إعادة ضبط صفحة بدء التشغيل وصفحة علامة التبويب الجديدة ومحرك البحث وعلامات التبويب المثبَّتة
            <ph name="LINE_BREAK" />
            • إيقاف الإضافات
            <ph name="LINE_BREAK" />
            • حذف ملفات تعريف الارتباط وبيانات الموقع الإلكتروني المؤقَّتة الأخرى
            <ph name="LINE_BREAK" />
            • إعادة ضبط اختصارات Phromium
            <ph name="LINE_BREAKS" />
            لن يؤثّر هذا الإجراء في الإشارات المرجعية والسجلّ وكلمات المرور المحفوظة.</translation>
<translation id="6489000842445481390">‏لقد بلغت الحدّ الأقصى لعدد الإشارات المرجعية في Phromium، وهو <ph name="BOOKMARK_LIMIT" />، لذا لم يتم حفظ بعض إشاراتك المرجعية في حسابك على Google حتى الآن.

ولا يمكن حفظ إشارات مرجعية جديدة في حسابك إلا بعد حذف بعض الإشارات. وفي حال سجّلت الخروج الآن، سيتم حذف الإشارات المرجعية غير المحفوظة.</translation>
<translation id="2645108248038996858">‏فتح الرابط في نافذة تصفح متخفٍ في Phromium</translation>
<translation id="6965382102122355670">حسنًا</translation>
<translation id="6985329841647292029">‏بنود نظام التشغيل Chromium</translation>
<translation id="2947519843530032104">‏يُرجى إدخال عبارة المرور لاستخدام بيانات Phromium وحفظها في حسابك (<ph name="ACCOUNT_EMAIL" />)</translation>
<translation id="7011190694940573312">تعذّر تثبيت هذا الإصدار من نظام التشغيل لأنّه غير متوافق.</translation>
<translation id="7024536598735240744">حدث خطأ في فك ضغط الحزمة: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">‏اجعل Phromium متصفِّحك الدائم</translation>
<translation id="7047386856539490735">هل هذه النتائج مفيدة؟</translation>
<translation id="2448910402556368916">‏تحديث Phromium</translation>
<translation id="7834049737623892628">‏في حال لم تتضمن صورة ما وصفًا مفيدًا، سيحاول Phromium توفير وصف لك. لإنشاء الأوصاف، سيتم إرسال الصور إلى Google.</translation>
<translation id="1803168627715642217">‏إمكانات الذكاء الاصطناعي ستكون متاحة لك عند استخدام تطبيق Phromium على "<ph name="DEVICE_TYPE" />"</translation>
<translation id="3321731353906178474">‏يمكنك استخدام كلمات المرور وعلامات التبويب وغيرها من البيانات أثناء التنقل من خلال تطبيق Phromium على هاتفك</translation>
<translation id="7141270731789036260">‏تخصيص Chrome for Testing</translation>
<translation id="8077731669779275332">‏يمكنك استخدام Phromium في أي وقت عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى</translation>
<translation id="611798798247797100">‏إزالة "<ph name="EXTENSION_NAME" />" من Phromium</translation>
<translation id="7962394294883785044">‏تحذف مؤسستك بيانات Phromium في حال عدم استخدامها لمدّة <ph name="TIMEOUT_DURATION" />. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.</translation>
<translation id="2611686760870033712">‏يحتاج Phromium إلى إذن للوصول إلى الكاميرا من أجل هذا الموقع الإلكتروني.</translation>
<translation id="71050417052775020">‏تعذَّر إطلاق Phromium. يُرجى إعادة المحاولة.</translation>
<translation id="4817060241763895497">‏طرح أي سؤال من أي مكان باستخدام "Gemini في Phromium"</translation>
<translation id="869358700049263961">‏يمكنك الاحتفاظ بمتصفِّح Phromium في شريط التطبيقات (Dock) للوصول إليه بسرعة في أي وقت</translation>
<translation id="7094488679340739251">‏يمكنك فتح Phromium عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى</translation>
<translation id="7216228761061470870">‏عند استخدام ميزة "البحث بالصور" على الكمبيوتر المكتبي، يتم إرسال عنوان الصفحة ومحتواها وعنوان URL الخاص بها، بما في ذلك ملفات PDF، إلى الخادم.</translation>
<translation id="7802634650401946711">‏إدارة المهام - Phromium</translation>
<translation id="5182547787327636348">‏يمكنك طرح أسئلة حول محتوى خارج Phromium، مثل تطبيقات أو ملفات أخرى</translation>
<translation id="1673408954678067905">‏حساب "<ph name="EXISTING_USER" />" مسجّل الدخول حاليًا. للحصول على تجربة تصفّح منفصلة، يُرجى تسجيل الدخول إلى ملفك الشخصي في Phromium بحساب <ph name="USER_EMAIL_ADDRESS" />. سيتيح لك ذلك أيضًا الوصول إلى معلوماتك المحفوظة وغيرها على جميع أجهزتك.</translation>
<translation id="5761733252154904648">‏بدء التصفّح على الفور: يمكن الآن فتح Phromium تلقائيًا عند بدء تشغيل Windows.</translation>
<translation id="7274695763216404502">تمّ تثبيت اللوحة. يمكنك استخدام ميزة "البحث بالصور" مرة أخرى من خلال شريط الأدوات</translation>
<translation id="7288567540154601580">علامات التبويب والإضافات</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{‏ينصح متصفّح Phromium بإزالتها}zero{‏ينصح متصفّح Phromium بإزالتها}two{‏ينصح متصفّح Phromium بإزالتهما}few{‏ينصح متصفّح Phromium بإزالتها}many{‏ينصح متصفّح Phromium بإزالتها}other{‏ينصح متصفّح Phromium بإزالتها}}</translation>
<translation id="1408728332407453335">‏لمشاركة صوت النظام، افتح "إعدادات النظام" (System Settings) وفعِّل خيار "تسجيل صوت النظام فقط" (System Audio Recording Only) لمتصفّح Phromium، ثم أعِد تشغيل المتصفّح.</translation>
<translation id="7299899569525778554">البحث من خلال الكمبيوتر المكتبي</translation>
<translation id="6194310460545162015">‏تحديث Phromium</translation>
<translation id="1098154893096691883">‏ملف الإعدادات المفضّلة تالف أو غير صالح.

يتعذر على Phromium استعادة إعداداتك.</translation>
<translation id="7324051657739063017">يمكنك إعادة فتح "المهام السياقية" لطرح الأسئلة أثناء التصفّح</translation>
<translation id="7024097830259741656">‏الويب والإشارات المرجعية وغيرها من عناصر Phromium توجد هنا.</translation>
<translation id="852511575759652041">‏لا يمكن لأحد الوصول إلى بياناتك المشفّرة بدون استخدام عبارة المرور. ولا تحصل Google على عبارة المرور هذه أو تخزّنها. وفي حال نسيتها أو أردت تغيير هذه الإعدادات، يجب <ph name="BEGIN_LINK" />حذف بيانات Phromium في حسابك<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505">‏ضَبَط مشرف النظام Phromium لفتح <ph name="ALTERNATIVE_BROWSER_NAME" /> للوصول إلى <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">حدث خطأ</translation>
<translation id="7198690862684855451">‏للحصول على تحديثات Phromium في المستقبل، يجب استخدام كمبيوتر يعمل بنظام التشغيل macOS 13 أو إصدار أحدث. ويعمل هذا الكمبيوتر بنظام التشغيل macOS 12.</translation>
<translation id="3224607549103501149">‏لم تتم زيارة هذا الموقع الإلكتروني مؤخرًا، لذلك أزال Phromium إذنَي <ph name="PERMISSION_1" /> و<ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">‏فتح سوق Chrome الإلكتروني</translation>
<translation id="8446269872172461565">‏عرض "Gemini في Phromium" في لوحة النظام</translation>
<translation id="7401687852903179959">البحث عن هذا الفيديو باستخدام ميزة "البحث بالصور"</translation>
<translation id="3403529853122418035">‏تم ضبط Phromium كمتصفّحك التلقائي</translation>
<translation id="5649377421626481711">‏المتابعة من حيث توقفت: يمكن لمتصفّح Phromium استعادة علامات التبويب كلما أعدت تشغيله. لإيقاف هذه الميزة، يُرجى الانتقال إلى</translation>
<translation id="2467776530444676191">‏استيراد كلمات المرور إلى Phromium</translation>
<translation id="8814480293815136510">‏‫1. انقر على <ph name="BUTTON_LABEL" /> أدناه
‫2. انقر على <ph name="BUTTON_2" /> في إعدادات Windows
‫3. انقر على <ph name="BUTTON_3" /> في إشعار Windows لتثبيت Phromium في شريط التطبيقات والوصول إليه بسرعة</translation>
<translation id="4458219452141227397">‏<ph name="PAGE_TITLE" /> - إصدار قناة مطوري البرامج من Phromium</translation>
