<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="1026101648481255140">استئناف التثبيت</translation>
<translation id="1029669172902658969">‏إعادة التشغيل لتحديث نظام التشغيل &amp;Chromium</translation>
<translation id="7962340570690354348">‏ينصح Phromium بمراجعة هذه الإضافة</translation>
<translation id="2702007788032964762">‏عندما يطلب موقع إلكتروني تحميل الروابط في صفحته مسبقًا بخصوصية تامة، يستخدم Phromium خوادم Google. يؤدي هذا الإجراء إلى إخفاء هويتك عن الموقع الإلكتروني الذي يتم تحميله مسبقًا، ولكن تبقى Google على اطّلاع بالمواقع الإلكترونية التي يتم تحميلها مسبقًا.</translation>
<translation id="1051793555070215510">لمساعدتنا في تحسين وضع التصفّح المتخفي، يُرجى تخصيص دقيقة واحدة للإجابة عن أسئلة هذا الاستطلاع.</translation>
<translation id="1065672644894730302">لا يمكن قراءة إعداداتك المفضّلة. قد تكون بعض الميزات غير متاحة، ولن يتم حفظ التغييرات في الإعدادات المفضّلة.</translation>
<translation id="4964836565882496625">‏أوقفَ أحد والدَيك "أذونات المواقع الإلكترونية والتطبيقات والإضافات" لمتصفِّح Phromium.</translation>
<translation id="8409497136174302488">‏يحتاج Phromium إلى إذن بالوصول إلى شبكتك المحلية لرصد الأجهزة المجاورة واستخدامها</translation>
<translation id="4388904545107211948">‏للبحث عن ميزة أو إضافة محدّدة في Phromium، عليك كتابة اختصارها في شريط العناوين متبوعًا بمفتاح لوحة المفاتيح الذي تم اختياره</translation>
<translation id="7188624550427159072">‏عرض ميزة "البحث باستخدام Phromium" في لوحة النظام وتفعيل اختصارات لوحة المفاتيح</translation>
<translation id="3689248207461565136">‏يرغب Phromium في تصدير كلمات المرور، لذا يُرجى كتابة كلمة مرور Windows للسماح بذلك.</translation>
<translation id="112640046208448578">يمكنك التعرّف على الصور أو الأماكن ونسخ النصوص أو ترجمتها. وعند استخدام ميزة "البحث بالصور"، يتمّ إرسال لقطة شاشة للصفحة إلى الخادم. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">‏Phromium هو متصفحك التلقائي</translation>
<translation id="5414044255592121327">‏للتحقُّق مما إذا كانت كلمات المرور آمنة من عمليات اختراق البيانات ومشاكل الأمان الأخرى، يُرجى <ph name="BEGIN_LINK" />تسجيل الدخول إلى Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">‏انقر على قائمة Phromium.</translation>
<translation id="1157985233335035034">أحدث اللغات</translation>
<translation id="1184145431117212167">‏تعذَّر التثبيت بسبب عدم توافُق الإصدار الذي تستخدمه من نظام التشغيل Windows.</translation>
<translation id="7861581212703831457">‏لمحة عن Phromium</translation>
<translation id="8752630985505435738">‏تلقّي تنبيهات ميزة "تتبُّع الأسعار" باستخدام Phromium على هاتفك</translation>
<translation id="1203500561924088507">شكرًا على التثبيت. عليك إعادة تشغيل المتصفِّح قبل استخدام <ph name="BUNDLE_NAME" />.</translation>
<translation id="4933432676089063712">‏هناك <ph name="IMPORTANT_UPDATE" /> قيد الانتظار. للحفاظ على أمان تصفّحك، سيتم تحديث Phromium في المرة القادمة عند توقّف نشاطك عليه لمدة <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">‏عند فتح ميزة "البحث بالصور"، سيتم تلقائيًا إرسال عنوان الصفحة وعنوان URL والمحتوى (بما في ذلك ملفات PDF) إلى الخادم. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">‏بعد تسجيل الدخول إلى حسابك، يمكنك استخدام كلمات المرور وغيرها من بيانات حسابك على Google في Phromium. لتغيير ذلك، يُرجى الانتقال إلى "حسابك في Phromium".</translation>
<translation id="7402478829083317456">‏عرض "Gemini في Phromium" في شريط قوائم Mac</translation>
<translation id="4902531791098430822">‏يمكنك استخدام اختصار لوحة المفاتيح لاختيار جزء من الشاشة في "Gemini في Phromium".</translation>
<translation id="9002284132405311162">‏عندما كانت علامة التبويب هذه غير نشطة، تم إخلاء مساحة في الذاكرة للحفاظ على سرعة Phromium. يمكنك اختيار أن يظل هذا الموقع الإلكتروني نشطًا دائمًا.</translation>
<translation id="5561666811965903444">‏حَظَر Phromium عملية التنزيل هذه لأنّ الملف خطير.</translation>
<translation id="1340271056805240721">‏عند تسجيل الدخول إلى خدمات Google، مثل Gmail أو YouTube باستخدام <ph name="USER_EMAIL" />، يمكنك تسجيل الدخول تلقائيًا إلى Phromium باستخدام الحساب نفسه</translation>
<translation id="5048805453292757697">‏تنزيل Phromium على هاتفك</translation>
<translation id="1290883685122687410">حدث خطأ أثناء الإعداد: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">‏إعداد ملفك الشخصي الجديد على Phromium</translation>
<translation id="7871721155662336863">‏يمكنك تجربة "Gemini في Phromium"</translation>
<translation id="6569288432960798043">‏يجب منح Phromium الإذن بالوصول إلى البلوتوث لاستكشاف
الأجهزة التي تتضمّن بلوتوث. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">‏تسجيل الدخول إلى Phromium على الهاتف</translation>
<translation id="1330562121671411446">رصد اللغة</translation>
<translation id="1619655755195586133">‏حذف البيانات من Phromium أيضًا (<ph name="URL" />)</translation>
<translation id="1345251407431278948">تمّ تثبيت اللوحة. يمكنك الوصول إلى ميزة "البحث بالصور" مرة أخرى من خلال الزر الجديد في شريط الأدوات</translation>
<translation id="1383876407941801731">البحث</translation>
<translation id="2947996037737257951">‏يمكنك استخدام تطبيق Phromium لمواصلة التصفّح أثناء التنقل</translation>
<translation id="141901961143729572">شارِك أفكارك</translation>
<translation id="8355386219605656974">‏لمشاركة النافذة، يجب السماح بتسجيل الشاشة في Phromium ضِمن "إعدادات النظام" (System Settings).</translation>
<translation id="1478370723027452770">‏الحصول على مساعدة بشأن Chrome for Testing</translation>
<translation id="8398257182826094665">‏يمكنك تسجيل الدخول إلى Phromium للوصول إلى معلوماتك المحفوظة وغيرها على "<ph name="DEVICE" />"</translation>
<translation id="1497802159252041924">حدث خطأ أثناء التثبيت: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">هذه الصفحة محمية</translation>
<translation id="3484755999946650557">‏مشاركة علامة تبويب Phromium</translation>
<translation id="3309377459597801353">‏تسجيل الدخول إلى Phromium</translation>
<translation id="1547469039832541117">يؤدي النقر على هذا الزر إلى إنهاء المهمّة المحدّدة.</translation>
<translation id="2354363290397602683">‏تثبيت Phromium</translation>
<translation id="2244728813494358888">‏أدوات الأمان في Phromium</translation>
<translation id="707582364915018531">‏يريد Phromium حذف بياناتك في "مدير كلمات المرور". للسماح بذلك، يُرجى كتابة كلمة المرور المستخدَمة في Windows.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق تحديث.}=1{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق تحديث. لن تتم إعادة فتح نافذة التصفح المتخفي.}two{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق تحديث. لن تتم إعادة فتح نافذتَي التصفح المتخفي.}few{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق تحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}many{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق تحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}other{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق تحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}}</translation>
<translation id="5032531544901236587">‏يمكنك الاستفادة من أفضل ميزات Google باستخدام تطبيق Phromium على هاتفك</translation>
<translation id="7311082384439462587">‏يمكنك مراجعة العناصر الرئيسية للتحكّم في الخصوصية والأمان في Phromium.</translation>
<translation id="1640672724030957280">جارٍ التنزيل...</translation>
<translation id="1665602916345474427">تم تسجيل الدخول باسم <ph name="USER_NAME" />، باستخدام الحساب <ph name="USER_EMAIL" />، ولديك اشتراك. يمكنك فتح قائمة الحسابات</translation>
<translation id="4535436467771816034">‏يمكنك استخدام Phromium في أي وقت عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى. وسيتم أيضًا تثبيته في شريط التطبيقات.</translation>
<translation id="1709772298389099340">توفِّر الخدمة أذونات مميّزة وعالية المستوى لمتصفِّح <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">سيتيح لك هذا الإجراء الاختيار من بين الأجهزة المتاحة وعرض المحتوى عليها.</translation>
<translation id="3550860956769006392">‏سيحذف Phromium بيانات التصفُّح قريبًا</translation>
<translation id="2053384509423635834">‏سيحاول Phromium ترقية عمليات الانتقال إلى بروتوكول HTTPS.</translation>
<translation id="2516115567501600458">‏تم محو بيانات Phromium</translation>
<translation id="8571959122390670188">‏ستتم إعادة تشغيل Phromium خلال <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">‏سيستخدم Phromium اتصالاً غير آمن بدون تحذيرك في حال عدم توفُّر بروتوكول HTTPS.</translation>
<translation id="5872244334553252095">‏دع Phromium يعمل في الخلفية</translation>
<translation id="2213761221916953829">‏لجعل Phromium أكثر أمانًا، تم إيقاف بعض الإضافات غير المدرجة في <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> والتي ربما تمت إضافتها بدون علمك.</translation>
<translation id="8807881428325438878">‏انقر على <ph name="BEGIN_BOLD" />نعم<ph name="END_BOLD" /> في إشعار Windows لتثبيت Phromium في شريط التطبيقات والوصول إليه بسرعة.</translation>
<translation id="6861833596843600606">‏إعادة تثبيت Phromium</translation>
<translation id="3950056404221550225">‏يحاول Phromium <ph name="AUTHENTICATION_PURPOSE" />.</translation>
<translation id="2018401790887358950">‏حساب "<ph name="EXISTING_USER" />" مسجّل الدخول حاليًا. للحصول على تجربة تصفّح منفصلة، يُرجى تسجيل الدخول إلى ملفك الشخصي في Phromium بحساب <ph name="USER_EMAIL_ADDRESS" />. سيتيح لك ذلك أيضًا الوصول إلى إضافاتك وغيرها من <ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">‏عند فتح Phromium على <ph name="DEVICE_TYPE" /> في المرة القادمة، ستظهر لك رسالة تطلب منك استخدام "مدير كلمات المرور في Google".</translation>
<translation id="1838374766361614909">محو البحث</translation>
<translation id="2724678689951174927">‏لحذف بيانات التصفّح من هذا الجهاز فقط والاحتفاظ بها في حسابك على Google، يُرجى <ph name="BEGIN_LINK" />تسجيل الخروج من Phromium<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">‏يكفي تنزيل متصفِّح Phromium على هاتفك لفتح مجموعات علامات التبويب أو إنشائها أثناء التنقّل.</translation>
<translation id="3191814926523151519">‏يمكنك إدارة حسابات Google التي تم تسجيل الدخول إليها. يتم استخدام حساباتك على Google في متصفّح Phromium و"متجر Play" وGmail والمزيد. إذا أردت إضافة حساب لمستخدم آخر، مثل أحد أفراد العائلة، أضِف شخصًا جديدًا إلى <ph name="DEVICE_TYPE" /> بدلاً من ذلك. <ph name="LINK_BEGIN" />مزيد من المعلومات<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">البحث باستخدام ميزة "البحث بالصور"</translation>
<translation id="5453573140402957471">‏حساب "<ph name="EXISTING_USER" />" مسجّل الدخول حاليًا. للحصول على تجربة تصفّح منفصلة، يُرجى تسجيل الدخول إلى ملفك الشخصي في Phromium بحساب <ph name="USER_EMAIL_ADDRESS" />. سيتيح لك ذلك أيضًا الوصول إلى إشاراتك المرجعية وغيرها من <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">اختيار نص</translation>
<translation id="1236934630660512644">‏أنت تسجل الدخول باستخدام حساب يخضع للإدارة وتتيح للمشرف إمكانية التحكم في ملفك الشخصي على Phromium. وستكون بياناتك في Phromium مثل تطبيقاتك وإشاراتك المرجعية وسجلك وكلمات المرور التابعة لك والإعدادات الأخرى مرتبطة دائمًا بالمستخدم <ph name="USER_NAME" />. ستتمكن من حذف هذه البيانات عبر لوحة تحكم حسابات Google، ولكنك لن تتمكن من إقران هذه البيانات بحساب آخر. ويُمكنك اختيار إنشاء ملف شخصي جديد للإبقاء على بياناتك الحالية في Phromium بشكل مستقل. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">‏يحافظ Phromium على طاقة البطارية من خلال الحدّ من الأنشطة في الخلفية والتأثيرات المرئية، مثل التمرير السلس وعدد اللقطات في الثانية للفيديو. <ph name="BEGIN_LINK" />مزيد من المعلومات حول ميزة "توفير البطارية"<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">‏خدمة Phromium Updater</translation>
<translation id="5797624919204275541">‏من خلال إيقاف هذا الإعداد، يمكنك تسجيل الدخول إلى "مواقع Google" مثل Gmail بدون الحاجة إلى تسجيل الدخول إلى Phromium</translation>
<translation id="6850971726764387814">‏لا يستجيب Phromium. هل تريد إعادة التشغيل الآن؟</translation>
<translation id="8289779763124483945">‏تطلُب المؤسسة (<ph name="MANAGER" />) منك تسجيل الدخول إلى Phromium</translation>
<translation id="193439633299369377">‏يجب إعادة تشغيل نظام التشغيل Chromium حتى يتم تطبيق التحديث.</translation>
<translation id="3215238748514810076">‏حَظَر Phromium عملية التنزيل هذه لأنّ نوع الملف لا يتم تنزيله عادةً، وقد يكون خطيرًا.</translation>
<translation id="1953553007165777902">جارٍ التنزيل… عدد الدقائق المتبقّية: <ph name="MINUTE" /></translation>
<translation id="8529252122707161160">‏يتعذَّر على Phromium تحديد المتصفح التلقائي أو تعيينه</translation>
<translation id="197326043290947695">التصفّح أذكى مع ميزة "البحث بالصور"</translation>
<translation id="7769772561254542263">‏التعرّف على سبب حظر بعض الملفات في Phromium، يتم فتح الرابط في علامة تبويب جديدة</translation>
<translation id="3713013456746186442">‏تساعد هذه الخدمة على تحديث برامج Phromium باستمرار. لذا في حال إيقافها بشكل نهائي أو مؤقت، لن يتم تحديث برامج Phromium باستمرار، ما يعني أنّه لا يمكن إصلاح الثغرات الأمنية التي قد تحدث وقد لا تعمل بعض الميزات. ويتمّ إلغاء تثبيت هذه الخدمة تلقائيًا من الجهاز عند عدم استخدام أي من برامج Phromium لها.</translation>
<translation id="5690439379999550641">‏سيعمل هذا على حذف عنصر واحد من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Phromium كـ <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">تعذّر التثبيت. يُرجى إعادة المحاولة.</translation>
<translation id="2039417478970545937">الإعدادات</translation>
<translation id="4765042254400173473">‏اختَر ما إذا كنت تريد تضمين سجلّ Phromium للحصول على تجارب أكثر تخصيصًا في خدمات Google.</translation>
<translation id="1448229429009113044">‏هذه الخدمة مضمّنة في Phromium لمساعدتك في إنشاء كلمات مرور قوية وحفظها وملئها تلقائيًا. ويمكنك إضافة اختصار للوصول إليها بسهولة.</translation>
<translation id="2145664943269651168">‏يمكنك النقر على زر "تخصيص Phromium" في صفحة "علامة تبويب جديدة" لإضفاء مظهر جديد عليه</translation>
<translation id="6052463185672312901">‏حَظَر Phromium عملية التنزيل هذه لأنّ الملف مخادع وقد يُجري تغييرات غير متوقعة على جهازك.</translation>
<translation id="3825064703718009924">‏ستظهر لك رسالة تطلب منك تجربة "<ph name="FEATURE_NAME" />" عند فتح Phromium على iOS في المرة القادمة.</translation>
<translation id="886729435477608858">‏ستتم إزالة كلمات المرور وبيانات Phromium الأخرى التي تم حفظها في حسابك على Google من هذا الجهاز. ولاستخدامها مرة أخرى في Phromium، عليك تسجيل الدخول مجددًا.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Phromium لمدة دقيقة واحدة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Phromium لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}two{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Phromium لمدة دقيقتَين. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}few{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Phromium لمدة # دقائق. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}many{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Phromium لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}other{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Phromium لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}}</translation>
<translation id="2125838419757773031">يمكنك تحديد أي محتوى على الشاشة للبحث عنه</translation>
<translation id="2126108037660393668">تعذَّر التحقق من الملف الذي تم تنزيله.</translation>
<translation id="2135919691573380097">الإبلاغ عن هذا الموقع الإلكتروني</translation>
<translation id="2137162749895930932">إغلاق شاشة الترجمة</translation>
<translation id="2147218225094845757">إخفاء اللوحة الجانبية</translation>
<translation id="1628700182434635922">‏حَظَر Phromium عملية التنزيل هذه لأنّ الموقع الإلكتروني لا يستخدم اتصالاً آمنًا وربما تمّ التلاعب بالملف.</translation>
<translation id="2170098639895543546">اختيار أي محتوى على الصفحة</translation>
<translation id="1807571394075492085">‏تخصيص Phromium</translation>
<translation id="2174917724755363426">لم يكتمل التثبيت. هل تريد فعلاً الإلغاء؟</translation>
<translation id="8332848361915479268">‏Phromium - تسجيل الدخول إلى الشبكة - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">خطأ في عملية التحقق من التحديث: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">‏إزالة الحساب من Phromium</translation>
<translation id="6063124961634921864">‏أفضل أدوات التسوق ستكون متاحة لك أثناء التنقل باستخدام تطبيق Phromium</translation>
<translation id="8646569091716523420">‏يمكنك الحفاظ على أمانك أثناء التنقّل باستخدام ميزة "الحماية المحسّنة للتصفّح الآمن" في Phromium على أجهزة iOS</translation>
<translation id="3084983792533696835">‏هذا الموقع الإلكتروني خطير، لذلك أزال Phromium إذن الإشعارات.</translation>
<translation id="2236949375853147973">نشاطي</translation>
<translation id="6387327671844988108">‏يمكنك تسجيل الدخول إلى Phromium للوصول إلى العناوين وغيرها على جميع أجهزتك. وسيتم حفظ هذا العنوان في حسابك على Google بعد تسجيل الدخول.</translation>
<translation id="722050260205928409">‏إذا كنت تشارك الكمبيوتر مع أصدقائك وعائلتك، فبإمكانهم التصفح على حدة وإعداد Phromium على النحو الذي يريدونه.</translation>
<translation id="703211526866942526">‏"المهارات" في Phromium</translation>
<translation id="2283803047247799269">البحث في علامة التبويب هذه باستخدام ميزة "البحث بالصور"</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{‏ينصح Phromium بإيقاف علامة التبويب التي تبطئ المتصفّح مؤقتًا}zero{‏ينصح Phromium بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}two{‏ينصح Phromium بإيقاف علامتَي التبويب اللتين تبطئان المتصفّح مؤقتًا}few{‏ينصح Phromium بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}many{‏ينصح Phromium بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}other{‏ينصح Phromium بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}}</translation>
<translation id="2307973900865360088">‏إبقاء التطبيق في شريط التطبيقات (Dock)</translation>
<translation id="6083276764640161328">‏يعمل هذا الوضع على التحقّق من عناوين URL التي تحتوي على قائمة بمواقع إلكترونية غير آمنة مُخزّنة في Phromium. وإذا حاول موقع إلكتروني سرقة كلمة المرور أو إذا نزّلت ملفًا ضارًا، قد يرسل متصفِّح Phromium أيضًا عناوين URL تتضمّن أجزاء من محتوى الصفحة إلى "التصفُّح الآمن".</translation>
<translation id="2356070529366658676">طلب</translation>
<translation id="2359808026110333948">متابعة</translation>
<translation id="741972887620936671">‏تطلب منك الإضافة "<ph name="EXTENSION_NAME" />" تسجيل الدخول إلى Phromium</translation>
<translation id="4709464915929597251">‏إيقاف تشغيل Phromium في الخلفية أثناء عمل التطبيقات</translation>
<translation id="6804933363437420201">‏لاستخدام هذه الإضافة على الحساب <ph name="USER_EMAIL_ADDRESS" />، عليك تسجيل الدخول إلى Phromium.</translation>
<translation id="2384373936468275798">‏تعذّر على نظام التشغيل Chromium مزامنة بياناتك لأن تفاصيل تسجيل الدخول إلى حسابك قديمة.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{‏كانت إضافة واحدة أو أكثر من إضافات Phromium تصل إلى جهاز HID واحد}=1{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى جهاز HID واحد}two{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى جهازَي HID}few{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى # أجهزة HID}many{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى # جهاز HID}other{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى # جهاز HID}}</translation>
<translation id="1394893265611797679">‏يحتاج Phromium إلى إذن للوصول إلى الكاميرا والميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="2403703063067034158">خطأ في بدء التشغيل: هناك عملية إعداد أخرى قيد التشغيل حاليًا. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="8457868297375575309">‏يمكنك فتح الروابط من أي تطبيق على Phromium والوصول إلى المتصفّح بسهولة من خلال شريط المهام</translation>
<translation id="5354209517289935579">‏يمكنك النقر على زر "تلخيص" لمشاركة هذا المستند مع "Gemini في Phromium" والحصول على نظرة عامة سريعة وطرح أسئلة إضافية</translation>
<translation id="6628402244681586711">‏باستخدام <ph name="BEGIN_LINK" />أدوات من Phromium<ph name="END_LINK" />، يمكنك التصفُّح بأمان والتحكُّم بشكل كامل</translation>
<translation id="6454834963905669297">‏حساب "<ph name="EXISTING_USER" />" مسجّل الدخول حاليًا. للحصول على تجربة تصفّح منفصلة، يُرجى تسجيل الدخول إلى ملفك الشخصي في Phromium بحساب <ph name="USER_EMAIL_ADDRESS" />. سيتيح لك ذلك أيضًا الوصول إلى كلمات المرور وغيرها على جميع أجهزتك.</translation>
<translation id="2451727308784734061">استخدِم الاختصار للوصول بسرعة إلى "مدير كلمات المرور". بإمكانك نقل هذا الاختصار إلى الشاشة الرئيسية أو مشغِّل التطبيقات في جهاز الكمبيوتر.</translation>
<translation id="1593547119543498467">‏سيتم إغلاق Phromium قريبًا</translation>
<translation id="6814323389195469782">‏في Phromium</translation>
<translation id="2485422356828889247">إزالة التثبيت</translation>
<translation id="2513154137948333830"><ph name="INSTALL_SUCCESS" />: يجب إعادة التشغيل.</translation>
<translation id="2542968102051442371">اختيار نص باستخدام ميزة "بحث بالصور"</translation>
<translation id="2643581100433412871">‏يحاول Phromium استبدال كلمات المرور الحالية. للسماح بذلك، يُرجى كتابة كلمة المرور المستخدَمة في Windows.</translation>
<translation id="4103676945224728292">‏يحتاج Phromium إلى الوصول إلى مساحة التخزين لتنزيل الملفات.</translation>
<translation id="8743720024689622265">‏أداة مساعدة Phromium</translation>
<translation id="2575822587468774919">انقر أي محتوى للبحث عنه باستخدام ميزة "البحث بالصور"</translation>
<translation id="8692134707551176334">‏سجِّل الدخول إلى Phromium للوصول إلى كلمات المرور وغيرها على جميع أجهزتك</translation>
<translation id="6035715610127790081">‏يمكنك مسح رمز الاستجابة السريعة ضوئيًا باستخدام هاتفك لتنزيل تطبيق Phromium وتسجيل الدخول إلى حساب Google.</translation>
<translation id="1579158377846894470">‏للبحث باستخدام Phromium</translation>
<translation id="3626651250874375470">‏مواصلة استخدام Phromium</translation>
<translation id="259935314519650377">تعذَّر إجراء تخزين مؤقت للمثبّت الذي تم تنزيله. الخطأ: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">النظام</translation>
<translation id="7634640424937626608">‏يمكن لمؤسستك الاطّلاع على بيانات التصفّح وإدارتها، مثل الإشارات المرجعية والسجلّ وكلمات المرور. ولا يمكنها الاطّلاع على بيانات التصفّح في الملفات الشخصية الأخرى على Phromium</translation>
<translation id="2669565213445601962">‏يُرجى إثبات هويتك لاستخدام بيانات Phromium وحفظها في حسابك (<ph name="ACCOUNT_EMAIL" />)</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{‏تتطلّب "الحماية المتقدّمة" إعادة تشغيل Phromium لتحديثه}=1{‏تتطلّب "الحماية المتقدّمة" إعادة تشغيل Phromium لتحديثه، ولن تتم إعادة فتح نافذة التصفّح المتخفي.}two{‏تتطلّب "الحماية المتقدّمة" إعادة تشغيل Phromium لتحديثه، ولن تتم إعادة فتح نافذتَي التصفح المتخفي.}few{‏تتطلّب "الحماية المتقدّمة" إعادة تشغيل Phromium لتحديثه، ولن تتم إعادة فتح # نوافذ تصفّح متخفٍّ.}many{‏تتطلّب "الحماية المتقدّمة" إعادة تشغيل Phromium لتحديثه، ولن تتم إعادة فتح # نافذة تصفّح متخفٍّ.}other{‏تتطلّب "الحماية المتقدّمة" إعادة تشغيل Phromium لتحديثه، ولن تتم إعادة فتح # نافذة تصفّح متخفٍّ.}}</translation>
<translation id="4393202019354077587">‏بدء Phromium</translation>
<translation id="3192212313802409327">‏حدث خطأ في نظام التشغيل أثناء عملية التثبيت. يُرجى إعادة تنزيل Phromium.</translation>
<translation id="6648732950668475680">‏في حال مشاركة جهاز مع الأصدقاء والعائلة، يمكنهم الحصول على تجربة تصفّح منفصلة وإعداد Phromium على النحو المفضّل لديهم.</translation>
<translation id="3501804488281766385">‏يتيح لك هذا الزر الوصول بسهولة إلى "Gemini في Phromium" واستخدامه على جهازك، حتى إذا كان Phromium مصغّرًا.</translation>
<translation id="5655763731487334489">‏علامة تبويب Phromium</translation>
<translation id="582020748041490207">‏لمزيد من الأمان، سيشفر Phromium بياناتك</translation>
<translation id="2693283019505702310">‏لإزالة حسابك على Google من Phromium، يجب تسجيل الخروج</translation>
<translation id="2989508583692830513">‏للوصول إلى كلمات المرور والإشارات المرجعية وغيرهما على جميع أجهزتك، يجب تسجيل الدخول إلى Phromium</translation>
<translation id="2738871930057338499">‏تعذر الاتصال بالإنترنت. بروتوكول HTTP 403 محظور. يُرجى التحقق من إعدادات الخادم الوكيل.</translation>
<translation id="2753623023919742414">انقر للبحث</translation>
<translation id="3391021955306442819">‏ضبط Phromium كعارض PDF التلقائي</translation>
<translation id="293156805028931571">‏هذه الإضافة غير آمنة وتحتوي على برامج ضارة. يُرجى إزالة هذه الإضافة من Phromium كي لا تتمكّن من الاطّلاع على بياناتك وتغييرها، بما في ذلك معلوماتك الشخصية، على المواقع الإلكترونية التي تزورها.</translation>
<translation id="2799223571221894425">إعادة تشغيل</translation>
<translation id="4742633141454352374">‏بياناتك على Phromium</translation>
<translation id="2816462166102338036">البحث عن هذا الفيديو باستخدام ميزة "البحث بالصور"</translation>
<translation id="2191308357458164968">‏يمكنك اكتشاف المنتجات باستخدام الكاميرا وتتبُّع انخفاض الأسعار وتنفيذ مهام أخرى أثناء التنقّل من خلال Phromium على iOS.</translation>
<translation id="2841525013647267359">ترجمة من</translation>
<translation id="2846251086934905009">خطأ في التثبيت: لم تكتمل أداة التثبيت. تم إلغاء عملية التثبيت.</translation>
<translation id="4498037716339180906">‏إزالة من Phromium</translation>
<translation id="4049188396834160957">‏يوفّر لك هذا الوضع حماية في Phromium، ويمكن استخدامه لتحسين مستوى أمانك في تطبيقات Google الأخرى عندما تكون مسجلاً دخولك.</translation>
<translation id="2885378588091291677">إدارة المهام</translation>
<translation id="4119302609687132178">‏حو&amp;ل Phromium</translation>
<translation id="2915996080311180594">إعادة التشغيل لاحقًا</translation>
<translation id="8232968781653330429">‏تم تشفير بياناتك باستخدام عبارة المرور. عليك إدخال عبارة المرور لاستخدام بيانات Phromium وحفظها في حسابك على Google.</translation>
<translation id="2945997411976714835">خطأ في التثبيت: تعذّر بدء عملية التثبيت.</translation>
<translation id="5624652745932625503">‏يمكنك تسجيل الدخول بشكل أسرع إلى المواقع الإلكترونية باستخدام كلمات المرور المحفوظة في Phromium على أجهزة iOS</translation>
<translation id="8821179372057577828">‏تدير مؤسستك متصفِّح Phromium</translation>
<translation id="741172935898285572">‏Phromium محدّث</translation>
<translation id="8798708493876822519">‏إذا حاول موقع إلكتروني سرقة كلمة المرور أو إذا نزّلت ملفًا ضارًا، قد يرسِل متصفِّح Phromium أيضًا عناوين URL تتضمّن أجزاءً من محتوى الصفحة إلى خدمة "التصفُّح الآمن".</translation>
<translation id="6896740867011823632">‏للحفاظ على أمانك على الإنترنت من خلال خيارات أحد والدَيك، سجِّل الدخول إلى Phromium</translation>
<translation id="3003694935412297923">كل المهام</translation>
<translation id="3580865868015023718">{count,plural, =1{‏يحتاج Phromium إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Google واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف عنصر واحد من هذه البيانات.}zero{‏يحتاج Phromium إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Google واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}two{‏يحتاج Phromium إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Google واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف عنصرَين ({count}) من هذه البيانات.}few{‏يحتاج Phromium إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Google واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عناصر من هذه البيانات.}many{‏يحتاج Phromium إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Google واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصرًا من هذه البيانات.}other{‏يحتاج Phromium إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Google واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}}</translation>
<translation id="1211179250505223767">‏افتح <ph name="URL" /> في علامة تبويب جديدة في Phromium.</translation>
<translation id="4742400838355945730">‏يتم حفظ ابتكارات الذكاء الاصطناعي، مثل المهارات، في حسابك على Google وإدارتها بشكل منفصل عن ميزة "مزامنة Phromium"</translation>
<translation id="8070050512429584052">‏يمكنك تسجيل الدخول إلى Phromium للوصول إلى الإضافات وغيرها على جميع أجهزتك</translation>
<translation id="666691655897541311">‏جارٍ الإضافة إلى Phromium...</translation>
<translation id="3038232873781883849">في انتظار التثبيت...</translation>
<translation id="3045032126857188731">اللغة الهدف: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">إغلاق مربّع حوار الملاحظات</translation>
<translation id="919456815618829047">‏حساب "<ph name="EXISTING_USER" />" مسجّل الدخول حاليًا. للحصول على تجربة تصفّح منفصلة، يُرجى تسجيل الدخول إلى ملفك الشخصي في Phromium بحساب <ph name="USER_EMAIL_ADDRESS" />. سيتيح لك ذلك أيضًا الوصول إلى قائمة القراءة وغيرها من <ph name="DEVICE" />.</translation>
<translation id="6141754610526066487">‏الملفات الشخصية الأخرى على Phromium</translation>
<translation id="2380720899384114679">‏تتيح لك الإضافات تخصيص متصفِّح Phromium وإضفاء طابعك الشخصي عليه، مع الحفاظ على التنظيم وتبسيط المهام اليومية.</translation>
<translation id="2507281899032275020">‏يمكنك المساعدة في تحسين Phromium عن طريق إرسال تقارير الأعطال و<ph name="UMA_LINK" /> إلى Google</translation>
<translation id="1514966729948178660">‏ميزات الأمان من Google ستكون متاحة لك أثناء التنقل باستخدام تطبيق Phromium</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{‏كانت إضافة واحدة أو أكثر من إضافات Phromium تصل إلى جهاز USB واحد}=1{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى جهاز USB واحد}two{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى # جهازَي USB}few{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى # أجهزة USB}many{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى # جهاز USB}other{‏تصل إضافة واحدة أو أكثر من إضافات Phromium إلى # جهاز USB}}</translation>
<translation id="78720743239019396">‏يمكنك تسجيل الدخول إلى Phromium للوصول إلى قائمة القراءة وغيرها على "<ph name="DEVICE" />"</translation>
<translation id="7000206277447032115">‏سجلّ Phromium</translation>
<translation id="4555002192651219296">‏تعذّرت أداة التثبيت في فك ضغط الأرشيف. يُرجى إعادة تنزيل Phromium.</translation>
<translation id="310459126943037700">تعذَّر إنهاء المهام.</translation>
<translation id="3104828284009500087">البحث عن أي محتوى على الصفحة</translation>
<translation id="4867557516756736957">‏يمكنك الحفاظ على مزامنة كلمات المرور والإشارات المرجعية والسجلّ بشكل مثالي على جميع الأجهزة، وكذلك الوصول بسهولة إلى الميزات المألوفة والمفضَّلة لديك من خلال ضبط Phromium كمتصفِّحك التلقائي.</translation>
<translation id="8632308594821621017">‏يستخدم Phromium الميكروفون.</translation>
<translation id="3130333203120345554">بحث جديد</translation>
<translation id="3137969841538672700">اسحب للبحث</translation>
<translation id="9173792796158381383">‏تستخدم علامة التبويب هذه موارد إضافية. لتحسين أداء التصفُّح، ننصح بالسماح لمتصفّح Phromium بإيقاف علامة التبويب هذه.</translation>
<translation id="8874679893080632357">‏لمشاركة شاشتك، يجب السماح بتسجيل الشاشة في Phromium ضِمن "إعدادات النظام" (System Settings)</translation>
<translation id="101045618220347251">‏إعادة تشغيل Phromium</translation>
<translation id="3161522574479303604">كل اللغات</translation>
<translation id="5940989267583033306">‏فتح الرابط في نافذة تصفح متخفٍ في Phromium</translation>
<translation id="2045477525210426976">‏يمكنك الآن تخصيص ملفك الشخصي الجديد على Phromium.</translation>
<translation id="3540518135502114323">‏يمكنك مواصلة المحادثة مع "وضع AI" بدون التبديل بين علامات التبويب، فما عليك سوى تسجيل الدخول إلى Phromium للبدء. بإمكانك أيضًا الوصول إلى كلمات المرور وغيرها من البيانات على جميع أجهزتك.</translation>
<translation id="1496180326063744749">‏لإزالة حسابك على Google من Phromium، يجب تسجيل الخروج من Phromium في صفحة "الإعدادات"</translation>
<translation id="7792783034323745412">‏يمكن أن يسألك متصفِّح Phromium لاحقًا عن رغبتك في استخدام المعلومات المحفوظة لملء النماذج تلقائيًا بالنيابة عنك</translation>
<translation id="5240091371721695404">‏يتعذر على Phromium القراءة والكتابة في دليل البيانات الخاص به:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">‏أدوات ذكاء Google الاصطناعي المفضّلة لديك ستكون متاحة لك أثناء التنقل باستخدام Phromium على iOS.</translation>
<translation id="4848363951707149242">‏يمكنك تسجيل الدخول إلى Phromium للوصول إلى الإضافات وغيرها على "<ph name="DEVICE" />"</translation>
<translation id="3286538390144397061">إعادة التشغيل الآن</translation>
<translation id="8613877111531019527">‏مفاتيح واجهة برمجة تطبيقات Google مفقودة. وسيترتب على ذلك توقف بعض وظائف Phromium عن العمل.</translation>
<translation id="2784090498377460662">‏استمرار تشغيل تطبيقات الخلفية عند إغلاق Phromium</translation>
<translation id="3905054486991167751">‏سيتم تحديث Phromium عند توقّف نشاطك عليه</translation>
<translation id="4502950976754616266">‏سيحذرك Phromium قبل تحميل أي موقع إلكتروني يستخدم اتصالاً غير آمن.</translation>
<translation id="6107453188231652861">‏سيتم تسجيل خروجك من معظم المواقع الإلكترونية عند إغلاق جميع نوافذ Phromium، باستثناء حسابك على Google إذا كنت مسجلاً الدخول إلى Phromium. للسماح للمواقع الإلكترونية بتذكُّر بياناتك، <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">أعلى يسار مساحة البحث: %<ph name="RIGHT" /> من الجهة اليسرى و%<ph name="TOP" /> من الأعلى</translation>
<translation id="5896635343289575401">‏بيانات Phromium في حسابك</translation>
<translation id="5662253013097242821">‏بتنزيل Phromium، يمكنك استخدام كلمات المرور الخاصة بك على هاتفك</translation>
<translation id="3387527074123400161">‏نظام التشغيل Chromium</translation>
<translation id="5326080492429181135">‏هل تريد الانتقال إلى الملف الشخصي الحالي على Phromium؟</translation>
<translation id="3412460710772753638">في "مدير كلمات المرور" على هذا الجهاز</translation>
<translation id="657700335789940813">‏يجب تحديث Phromium</translation>
<translation id="3487742274367151379">‏يمكنك تسجيل الدخول إلى Phromium للوصول إلى الإشارات المرجعية وغيرها على "<ph name="DEVICE" />"</translation>
<translation id="3438772217992559640">البحث في علامة التبويب هذه باستخدام ميزة "البحث بالصور"</translation>
<translation id="8062355070850891600">‏بتنزيل Phromium، ستكون "الحماية المحّسنة للتصفح الآمن" متاحة على هاتفك أيضًا</translation>
<translation id="5419337472918920970">‏جارٍ تخصيص Phromium…</translation>
<translation id="6573105037542661278">‏سيعمل هذا على حذف <ph name="ITEMS_COUNT" /> من العناصر من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Phromium كـ <ph name="USER_EMAIL" />.</translation>
<translation id="4600986251755456192">‏يعمل الاختصار <ph name="SHORTCUT" /> على التبديل بين الملفات الشخصية على Phromium.</translation>
<translation id="8118189978246431067">‏يُرجى إغلاق جميع نوافذ Phromium وإعادة المحاولة.</translation>
<translation id="7430418346833889620">‏لمشاركة النافذة، يجب السماح بتسجيل الشاشة في Phromium ضِمن "إعدادات النظام" (System Settings)</translation>
<translation id="2943929290955142701">‏سبق أن تم تسجيل الدخول إلى حساب "<ph name="EXISTING_USER" />".  للحصول على تجربة تصفّح منفصلة، سجِّل الدخول إلى Phromium في ملفك الشخصي باستخدام العنوان <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5896697187441340113">‏يُرجى مسح رمز الاستجابة السريعة ضوئيًا لتنزيل متصفّح Phromium على الأجهزة الجوّالة</translation>
<translation id="354621070532799440">‏تذكير: أفضل ميزات الأمان من Google في متناول يدك</translation>
<translation id="6718500626359284607">‏لمشاركة شاشتك، يجب السماح بتسجيل الشاشة في Phromium ضِمن "إعدادات النظام" (System Settings).</translation>
<translation id="6511372913460632136">‏يؤدي تفعيل ميزة "الحماية المحسّنة" إلى إيقاف ميزة تحسين JavaScript للمواقع الإلكترونية التي لا يتعرّف عليها Phromium</translation>
<translation id="3597003331831379823">تعذَّر إجراء عملية الإعداد باستخدام أذونات مميزة وعالية المستوى. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">‏سجِّل الدخول إلى Phromium</translation>
<translation id="8702816719621016911">‏ستُحذَف بيانات تصفُّح هذا المستخدم من هذا الجهاز. ولاسترداد البيانات، سجّل الدخول إلى Phromium بصفتك <ph name="USER_EMAIL" />.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{‏يتوفر تحديث جديد لبرنامج Phromium وسيتم تطبيقه عند إعادة التشغيل.}=1{‏يتوفر تحديث جديد لبرنامج Phromium وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نافذة التصفح المتخفي.}two{‏يتوفر تحديث جديد لبرنامج Phromium وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نافذتَي التصفح المتخفي.}few{‏يتوفر تحديث جديد لبرنامج Phromium وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}many{‏يتوفر تحديث جديد لبرنامج Phromium وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}other{‏يتوفر تحديث جديد لبرنامج Phromium وسيتم تطبيقه عند إعادة التشغيل. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}}</translation>
<translation id="3667616615096815454">يتعذّر تثبيت التطبيق لأنّه غير معروف لدى الخادم.</translation>
<translation id="678730369472836428">‏لتشفير جميع بيانات Phromium في حسابك على Google، يمكنك استخدام <ph name="BEGIN_LINK" />عبارة المرور الخاصة بك<ph name="END_LINK" />. لن يتم تشفير طُرق الدفع والعناوين من Google Pay. ولن تتم مزامنة سجلّ التصفُّح من Phromium.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق هذا التحديث.}=1{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق هذا التحديث. لن تتم إعادة فتح نافذة التصفح المتخفي.}two{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق هذا التحديث. لن تتم إعادة فتح نافذتَي التصفح المتخفي.}few{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق هذا التحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}many{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق هذا التحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}other{‏يطلب المشرف إعادة تشغيل Phromium لتطبيق هذا التحديث. لن تتم إعادة فتح نوافذ التصفّح المتخفي البالغ عددها #.}}</translation>
<translation id="2203303261468330007">‏فتح الرابط في علامة تبويب جديدة في Phromium</translation>
<translation id="686463893976008238">‏ربط متصفّح Phromium وخدمات Google الأخرى لأغراض تخصيص الخيارات وأغراض أخرى</translation>
<translation id="3729187154190517324">يمكنك تعزيز نتائج بحثك عن طريق إضافة علامات تبويب وملفات وأدوات متعدّدة باستخدام زر "إضافة علامة تبويب والمزيد".</translation>
<translation id="5596264049590907430">‏إدارة الملفات الشخصية على Phromium</translation>
<translation id="5594723037153142396">‏تعرّف على سبب حظر Phromium لبعض عمليات التنزيل</translation>
<translation id="3425307214497790458">‏سيُعلِمك Phromium في حال العثور على اقتراحات مطلوب مراجعتها.</translation>
<translation id="4247980944121268675">‏يُحمِّل Phromium مسبقًا الصفحات التي من المرجَح أن تزورها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="3810973564298564668">إدارة</translation>
<translation id="1058395779823101457">‏لاستخدام كلمات المرور المحفوظة، يُرجى مسح رمز الاستجابة السريعة ضوئيًا وتنزيل Phromium لجهاز iOS، ثم تسجيل الدخول إلى حسابك على Google</translation>
<translation id="3846683726093018685">**تلخيص:** أريد وصفًا للموضوع الرئيسي وهدف محتوى لقطة الشاشة في جملة واحدة لا تزيد عن 30 كلمة.

          **اقتراح أسئلة:** أريد قائمة نقطية تتضمّن من 3 إلى 5 أسئلة تشجّع على التفكير ويمكن للمستخدم طرحها لفهم لقطة الشاشة بشكل أفضل. يجب أن تتضمّن هذه الأسئلة سؤالاً واحدًا على الأقل يتعلّق بعنصر مرئي أو تصميمه أو موضعه تحديدًا.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">‏يمكنك تسجيل الدخول إلى Phromium للوصول إلى الإشارات المرجعية وغيرها على جميع أجهزتك</translation>
<translation id="3885770153807205175">أداة اختيار اللغة</translation>
<translation id="5947409614720749543">‏تخصيص Phromium والتحكُّم فيه معلومات مهمة - انقر للحصول على التفاصيل.</translation>
<translation id="2176348074240183776">‏انقر على اسمك لفتح Phromium وبدء التصفح.</translation>
<translation id="3892148308691398805">نسخ النص</translation>
<translation id="3679766722656346339">‏سبَق تسجيل دخول <ph name="EXISTING_USER" /> إلى هذا الملف الشخصي على Phromium. لتوفير تجربة تصفّح منفصلة دائمًا، يمكن لمتصفِّح Phromium إنشاء ملف شخصي خاص بك.</translation>
<translation id="6085953975934135790">‏تنتهك هذه الإضافة "سياسة سوق Chrome الإلكتروني"، وقد تكون غير آمنة. يُرجى إزالة هذه الإضافة من Phromium كي لا تتمكّن من الاطّلاع على بياناتك وتغييرها، بما في ذلك معلوماتك الشخصية، على المواقع الإلكترونية التي تزورها.</translation>
<translation id="3941890832296813527">خطأ في التثبيت: اسم ملف أداة التثبيت غير صالح أو غير متوافق.</translation>
<translation id="608187946760434925">‏يحاول Phromium نسخ كلمات المرور. اكتب كلمة مرور Windows للسماح بذلك.</translation>
<translation id="3054592240125889472">‏يمكنك تسجيل الدخول إلى Phromium للوصول إلى معلوماتك المحفوظة وغيرها على جميع أجهزتك</translation>
<translation id="3140795250676341027">‏ستتم إزالة كلمات المرور وطرق الدفع والعناوين التي حفظتها في حسابك على Google من هذا الجهاز. ولاستخدامها مرة أخرى في Phromium، عليك تسجيل الدخول مجددًا.</translation>
<translation id="395904275706073188">لا يمكن قراءة الصفحات المحمية. ننصحك بتجربة الميزة على صفحة مختلفة.</translation>
<translation id="4227910144250222665">‏تعرّف على الطريقة التي يحافظ بها Phromium على أمانك</translation>
<translation id="3967822245660637423">اكتمل التنزيل</translation>
<translation id="4150430234581811723">‏عند الكتابة في شريط العناوين أو مربّع البحث، يرسل Phromium ما تمّت كتابته إلى أدوات البحث والذكاء الاصطناعي والوكلاء في مؤسستك للحصول على اقتراحات.</translation>
<translation id="3975724895399328945">‏لمحة عن الإصدار Google Chrome for Testing</translation>
<translation id="3997429360543082038">‏لمحة عن نظام التشغيل Chromium</translation>
<translation id="4847805566397342820">‏عند الانتقال إلى موقع إلكتروني، يرسل متصفِّح Phromium جزءًا مشفّرًا من عنوان URL إلى <ph name="BEGIN_LINK" />ميزة "التصفّح الآمن من Google"<ph name="END_LINK" /> من خلال خادم لحماية الخصوصية يُخفي عنوان IP الخاص بجهازك. وفي حال رصد سلوك مريب على موقع إلكتروني، يتم أيضًا إرسال عناوين URL الكاملة وأجزاء من محتوى الصفحة.</translation>
<translation id="4016217212818346953">أنت في أمان مع "مدير كلمات المرور"</translation>
<translation id="4019629340646866719">‏أصبح نظام التشغيل Chromium متاحًا من خلال <ph name="BEGIN_LINK_CROS_OSS" />برنامج إضافي مفتوح المصدر<ph name="END_LINK_CROS_OSS" />، كما هو الحال في <ph name="BEGIN_LINK_LINUX_OSS" />بيئة تطوير Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">ترجمة محتوى الشاشة</translation>
<translation id="4023601594785368013">اللغة الأصلية: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">‏يمكنك فتح الروابط من أي تطبيق في Phromium، ويمكن تثبيته في شريط المهام للوصول إليه بسهولة.</translation>
<translation id="6916567874038032700">‏ساعد في تحسين Phromium بالإبلاغ عن <ph name="BEGIN_LINK" />الإعدادات الحالية<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">تحسينات الأمان المهمة والميزات الجديدة متاحة في أحدث إصدار.</translation>
<translation id="4055805654398742145">مدير كلمات المرور</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Phromium تلقائيًا عند عدم استخدامه لمدة دقيقة واحدة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Phromium تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}two{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Phromium تلقائيًا عند عدم استخدامه لمدة دقيقتَين. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}few{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Phromium تلقائيًا عند عدم استخدامه لمدة # دقائق. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}many{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Phromium تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}other{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Phromium تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}}</translation>
