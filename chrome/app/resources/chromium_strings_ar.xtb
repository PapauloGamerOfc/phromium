<translation id="7649070708921625228">مساعدة</translation>
<translation id="3795437289339745990">‏تنزيل تطبيق Phromium</translation>
<translation id="7658239707568436148">إلغاء</translation>
<translation id="6671257169702988694">‏Phromium ليس متصفحك التلقائي.</translation>
