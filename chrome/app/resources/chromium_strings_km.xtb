<translation id="989970834842471429">ជ្រើសរើស​អក្សរ ឬ​រូបភាព ដើម្បី​ស្វែងរក​ដោយប្រើ​ការស្វែងរក​រូបភាព</translation>
<translation id="6649431194696226496">ដើម្បីប្រើ​ទីតាំង​របស់អ្នក សូមផ្ដល់​សិទ្ធិចូលប្រើឱ្យ Phromium នៅក្នុង<ph name="BEGIN_LINK" />ការកំណត់ប្រព័ន្ធ<ph name="END_LINK" /></translation>
</translationbundle>