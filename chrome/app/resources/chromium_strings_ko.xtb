<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ko">
<translation id="1026101648481255140">설치 다시 시작</translation>
<translation id="1029669172902658969">다시 실행하여 ChromiumOS 업데이트</translation>
<translation id="7962340570690354348">Chromium에서는 이 확장 프로그램을 검토할 것을 권장합니다.</translation>
<translation id="2702007788032964762">사이트에서 페이지에 있는 링크를 비공개로 미리 로드해 달라고 요청하면 Chromium은 Google 서버를 사용합니다. 이렇게 하면 미리 로드된 사이트에서 사용자의 신원을 숨길 수 있지만 Google은 어떤 사이트가 미리 로드되는지 학습하게 됩니다.</translation>
<translation id="1051793555070215510">1분 정도 소요되는 설문조사에 참여하여 시크릿 모드를 개선하는 데 도움을 주세요.</translation>
<translation id="1065672644894730302">환경설정을 읽을 수 없습니다.

일부 기능을 사용할 수 없으며 환경설정의 변경사항이 저장되지 않습니다.</translation>
<translation id="4964836565882496625">부모님이 Chromium의 ‘사이트, 앱, 확장 프로그램에 대한 권한’을 사용 중지했습니다</translation>
<translation id="8409497136174302488">근처 기기를 검색하고 사용하려면 Chromium에서 로컬 네트워크에 액세스해야 합니다.</translation>
<translation id="4388904545107211948">특정 Phromium 기능 또는 확장 프로그램을 검색하려면 주소 표시줄에 바로가기를 입력한 다음 선택한 키보드 키를 입력하세요</translation>
<translation id="7188624550427159072">작업 표시줄에 Chromium으로 검색 표시 및 키보드 단축키 사용 설정</translation>
<translation id="3689248207461565136">Chromium에서 비밀번호를 내보내려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="112640046208448578">사물 또는 장소를 식별하고 텍스트를 복사하거나 번역합니다. 이미지 검색을 사용하면 페이지의 스크린샷이 서버로 전송됩니다. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Chromium이 기본 브라우저로 설정되어 있습니다.</translation>
<translation id="5414044255592121327">암호가 정보 유출 및 다른 보안 문제로부터 안전한지 확인하려면 <ph name="BEGIN_LINK" />Chromium에 로그인<ph name="END_LINK" />하세요.</translation>
<translation id="1753507755668601921">Phromium 메뉴를 클릭합니다</translation>
<translation id="1157985233335035034">최근에 사용한 언어</translation>
<translation id="1184145431117212167">지원되지 않는 Windows 버전으로 인해 설치할 수 없습니다.</translation>
<translation id="7861581212703831457">Phromium 정보</translation>
<translation id="8752630985505435738">휴대전화에서 Chromium으로 가격 추적 알림을 받으세요</translation>
<translation id="1203500561924088507">설치해 주셔서 감사합니다. <ph name="BUNDLE_NAME" />을(를) 사용하려면 브라우저를 다시 시작해야 합니다.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" />가 대기 중입니다. 안전한 탐색을 위해 다음에 <ph name="IDLE_DURATION" /> 동안 비활성 상태가 되면 Chromium이 업데이트됩니다.</translation>
<translation id="1232234696885483911">이미지 검색을 열면 페이지 제목, URL, PDF를 포함한 콘텐츠가 서버로 자동 전송됩니다. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">로그인한 상태로 Chromium에서 Google 계정의 비밀번호 등을 사용할 수 있습니다. 이 설정을 변경하려면 'Chromium의 내 계정'으로 이동하세요.</translation>
<translation id="7402478829083317456">Mac 메뉴 바에 Chromium의 Gemini 표시</translation>
<translation id="4902531791098430822">Chromium의 Gemini에서 화면의 일부를 선택하려면 키보드 단축키를 사용하세요.</translation>
<translation id="9002284132405311162">이 탭이 비활성 상태인 동안 Chromium의 속도를 빠르게 유지하기 위해 메모리를 확보했습니다. 이 사이트가 비활성 상태가 되지 않도록 항상 제외할 수 있습니다.</translation>
<translation id="5561666811965903444">위험한 파일이므로 Chromium에서 이 다운로드를 차단했습니다.</translation>
<translation id="1340271056805240721"><ph name="USER_EMAIL" /> 계정으로 Gmail 또는 YouTube와 같은 Google 서비스에 로그인하면 동일한 계정으로 Chromium에 자동으로 로그인할 수 있습니다.</translation>
<translation id="5048805453292757697">휴대전화에 Chromium을 다운로드하세요</translation>
<translation id="1290883685122687410">설정 오류: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">새 Phromium 프로필 설정</translation>
<translation id="7871721155662336863">Chromium의 Gemini로 사용해 보기</translation>
<translation id="6569288432960798043">블루투스 기기를 탐색하려면 Chromium에 블루투스 액세스 권한이 필요합니다. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">휴대전화에서 Chromium에 로그인</translation>
<translation id="1330562121671411446">언어 감지</translation>
<translation id="1619655755195586133">Phromium(<ph name="URL" />)에서도 데이터 삭제</translation>
<translation id="1345251407431278948">고정되었습니다. 툴바의 새 버튼에서 이미지 검색을 다시 이용할 수 있습니다</translation>
<translation id="1383876407941801731">검색</translation>
<translation id="2947996037737257951">Phromium 앱을 사용하여 이동 중에도 탐색하세요.</translation>
<translation id="141901961143729572">의견 공유</translation>
<translation id="8355386219605656974">창을 공유하려면 시스템 설정에서 Chromium의 화면 녹화를 허용하세요.</translation>
<translation id="1478370723027452770">Chrome for Testing 관련 지원받기</translation>
<translation id="8398257182826094665"><ph name="DEVICE" />에서 저장된 정보 등을 사용하려면 Chromium에 로그인하세요</translation>
<translation id="1497802159252041924">설치 오류: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">보호된 페이지입니다</translation>
<translation id="3484755999946650557">Phromium 탭 공유</translation>
<translation id="3309377459597801353">Chromium에 로그인</translation>
<translation id="1547469039832541117">강조 표시된 작업을 종료합니다.</translation>
<translation id="2354363290397602683">Phromium 고정</translation>
<translation id="2244728813494358888">Chromium의 안전 도구</translation>
<translation id="707582364915018531">Chromium에서 비밀번호 관리자 데이터를 삭제하려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{관리자의 요구에 따라 업데이트를 적용하려면 Chromium을 다시 실행해야 합니다.}=1{관리자의 요구에 따라 업데이트를 적용하려면 Chromium을 다시 실행해야 합니다. 시크릿 창이 다시 열리지 않습니다.}other{관리자의 요구에 따라 업데이트를 적용하려면 Chromium을 다시 실행해야 합니다. 시크릿 창 #개가 다시 열리지 않습니다.}}</translation>
<translation id="5032531544901236587">휴대전화에서 Phromium 앱을 사용하여 Google 기능을 최대한 활용하세요</translation>
<translation id="7311082384439462587">Chromium의 주요 개인 정보 보호 및 보안 제어 기능을 검토합니다.</translation>
<translation id="1640672724030957280">다운로드 중...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, 멤버십으로 로그인되었습니다. 계정 메뉴 열기</translation>
<translation id="4535436467771816034">언제든지 메시지, 문서, 기타 앱에서 링크를 클릭하여 Chromium을 사용할 수 있습니다. 작업 표시줄에도 고정됩니다.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" />에 승격된 권한을 제공합니다.</translation>
<translation id="1722488837206509557">이렇게 하면 사용 가능한 기기 중에서 선택하고 해당 기기에 콘텐츠를 표시할 수 있습니다.</translation>
<translation id="3550860956769006392">Chromium에서 곧 인터넷 사용 기록이 삭제됩니다</translation>
<translation id="2053384509423635834">Chromium에서 탐색을 HTTPS로 업그레이드하려고 시도합니다</translation>
<translation id="2516115567501600458">Phromium 데이터 삭제 완료</translation>
<translation id="8571959122390670188"><ph name="REMAINING_TIME" /> 후에 Phromium 다시 시작</translation>
<translation id="6284080675125981628">HTTPS를 사용할 수 없는 경우, Chromium에서 경고 없이 안전하지 않은 연결을 사용합니다.</translation>
<translation id="5872244334553252095">백그라운드에서 Chromium을 실행</translation>
<translation id="2213761221916953829">Google에서는 Chromium의 보안을 강화하기 위해 <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />에 표시되지 않고 사용자 모르게 추가되었을 수 있는 일부 확장 프로그램의 사용을 중지했습니다.</translation>
<translation id="8807881428325438878">빠른 액세스를 위해 Windows 알림에서 <ph name="BEGIN_BOLD" />예<ph name="END_BOLD" /> 버튼을 클릭하여 Chromium을 태스크 바에 고정합니다.</translation>
<translation id="6861833596843600606">Phromium 재설치</translation>
<translation id="3950056404221550225">Chromium에서 <ph name="AUTHENTICATION_PURPOSE" />을(를) 시도하는 중입니다.</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다. 방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 Chromium에 로그인하세요. 이렇게 하면 <ph name="DEVICE" />에서 내 확장 프로그램 등을 사용할 수 있습니다.</translation>
<translation id="6114726049187747242">다음번에 <ph name="DEVICE_TYPE" />에서 Chromium을 열면 Google 비밀번호 관리자를 사용하라는 메시지가 표시됩니다.</translation>
<translation id="1838374766361614909">검색어 지우기</translation>
<translation id="2724678689951174927">인터넷 사용 기록을 이 기기에서만 삭제하고 Google 계정에서는 유지하려면 <ph name="BEGIN_LINK" />Chromium에서 로그아웃<ph name="END_LINK" />하세요.</translation>
<translation id="402854649782215414">이동 중에 새 탭 그룹을 열거나 만들려면 휴대전화에 Chromium을 다운로드하세요.</translation>
<translation id="3191814926523151519">로그인된 Google 계정을 관리할 수 있습니다. Google 계정은 Phromium 브라우저, Play 스토어, Gmail 등에서 사용됩니다. 가족 구성원 등 다른 사람을 위해 계정을 추가하고 싶다면 대신 <ph name="DEVICE_TYPE" />에 새 사용자를 추가하세요. <ph name="LINK_BEGIN" />자세히 알아보기<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">이미지 검색으로 검색</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다. 방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 Chromium에 로그인하세요. 이렇게 하면 <ph name="DEVICE" />에서 북마크 등을 사용할 수 있습니다.</translation>
<translation id="1880677175115548835">텍스트 선택</translation>
<translation id="1236934630660512644">관리 계정으로 로그인하고 Phromium 프로필에 대한 관리자 제어권을 부여하려고 합니다. 앱, 북마크, 방문 기록, 비밀번호 및 기타 설정 등 Phromium 데이터가 <ph name="USER_NAME" /> 계정에 영구적으로 연결됩니다. 이후 이 데이터를 Google 계정 대시보드에서 삭제할 수는 있지만 다른 계정에 연결할 수는 없습니다. 기존 Phromium 데이터를 유지하려면 새 프로필을 만드는 방법이 있습니다. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Chromium에서 부드러운 스크롤 및 동영상 프레임 속도 같은 시각 효과와 백그라운드 활동을 제한하여 배터리 전원을 절약합니다. <ph name="BEGIN_LINK" />에너지 절약 모드에 관해 자세히 알아보기<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium 업데이터 서비스</translation>
<translation id="5797624919204275541">이 기능을 사용 중지하면 Chromium에 로그인하지 않고도 Gmail 등의 Google 사이트에 로그인할 수 있습니다.</translation>
<translation id="6850971726764387814">Chromium이 응답하지 않습니다. 다시 시작하시겠습니까?</translation>
<translation id="8289779763124483945">조직(<ph name="MANAGER" />)에서 Chromium에 로그인할 것을 요구합니다</translation>
<translation id="193439633299369377">업데이트를 적용하려면 ChromiumOS를 다시 시작해야 합니다.</translation>
<translation id="3215238748514810076">일반적으로 다운로드하지 않는 파일 형식이며 위험할 가능성이 있기 때문에 Chromium에서 이 다운로드를 차단했습니다.</translation>
<translation id="1953553007165777902">다운로드 중... <ph name="MINUTE" />분 남음</translation>
<translation id="8529252122707161160">Chromium에서 기본 브라우저를 확인하거나 설정할 수 없습니다.</translation>
<translation id="197326043290947695">이미지 검색으로 더 스마트하게 탐색하세요</translation>
<translation id="7769772561254542263">Chromium에서 일부 파일을 차단하는 이유 알아보기, 새 탭에서 열기</translation>
<translation id="3713013456746186442">Phromium 소프트웨어를 최신 상태로 유지합니다. 이 서비스를 사용 중지하거나 중단하면 Phromium 소프트웨어가 최신 상태로 유지되지 않습니다. 즉, 발생할 수 있는 보안 취약점이 수정되지 않고 기능이 작동하지 않을 수 있습니다. 이 서비스를 사용하는 Phromium 소프트웨어가 없으면 이 서비스는 자동으로 제거됩니다.</translation>
<translation id="5690439379999550641">항목 1개가 기기에서 삭제됩니다. 나중에 데이터를 가져오려면 Chromium에 <ph name="USER_EMAIL" />(으)로 로그인하세요.</translation>
<translation id="2018879682492276940">설치할 수 없습니다. 다시 시도해 보세요.</translation>
<translation id="2039417478970545937">설정</translation>
<translation id="4765042254400173473">보다 맞춤설정된 Google 서비스 환경을 사용하기 위해 Phromium 방문 기록을 포함할지 선택하세요.</translation>
<translation id="1448229429009113044">Chromium에 내장되어 있어 안전한 비밀번호를 만들고, 저장하고, 자동 완성하도록 도와줍니다. 바로가기를 추가하여 간편하게 액세스하세요</translation>
<translation id="2145664943269651168">새 탭 페이지에서 'Phromium 맞춤설정' 버튼을 클릭하여 Chromium에 새로운 디자인을 적용하세요</translation>
<translation id="6052463185672312901">사기성 파일이며 기기에 예기치 않은 변경사항이 적용될 수 있기 때문에 Chromium에서 이 다운로드를 차단했습니다.</translation>
<translation id="3825064703718009924">다음번에 Phromium iOS를 열면 <ph name="FEATURE_NAME" /> 기능을 사용해 보라는 메시지가 표시됩니다.</translation>
<translation id="886729435477608858">Google 계정에 저장된 비밀번호 및 기타 Phromium 데이터가 이 기기에서 삭제됩니다. Chromium에서 다시 사용하려면 다시 로그인하세요</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Chromium을 1분 동안 사용하지 않으면 조직에서 인터넷 사용 기록을 자동으로 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다. 탭이 열린 상태로 유지됩니다.}other{Chromium을 #분 동안 사용하지 않으면 조직에서 인터넷 사용 기록을 자동으로 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다. 탭이 열린 상태로 유지됩니다.}}</translation>
<translation id="2125838419757773031">화면의 영역을 선택하여 검색하세요</translation>
<translation id="2126108037660393668">다운로드한 파일을 확인할 수 없습니다.</translation>
<translation id="2135919691573380097">이 사이트 신고</translation>
<translation id="2137162749895930932">번역 화면 닫기</translation>
<translation id="2147218225094845757">측면 패널 숨기기</translation>
<translation id="1628700182434635922">사이트에서 보안 연결을 사용하고 있지 않으며 파일이 조작되었을 가능성이 있기 때문에 Chromium에서 이 다운로드를 차단했습니다.</translation>
<translation id="2170098639895543546">페이지에서 항목 선택</translation>
<translation id="1807571394075492085">Phromium 맞춤설정</translation>
<translation id="2174917724755363426">설치가 완료되지 않았습니다. 취소하시겠습니까?</translation>
<translation id="8332848361915479268">Phromium - 네트워크 로그인 - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">업데이트 확인 오류: <ph name="UPDATE_CHECK_ERROR" /></translation>
<translation id="5023314501391717571">Chromium에서 계정 삭제</translation>
<translation id="6063124961634921864">Phromium 앱을 사용하여 이동 중에도 최고의 쇼핑 도구를 활용하세요.</translation>
<translation id="8646569091716523420">iOS용 Chromium의 향상된 세이프 브라우징으로 이동 중에도 더 안전하게 보호하세요.</translation>
<translation id="3084983792533696835">위험한 사이트입니다. Chromium에서 알림을 삭제했습니다.</translation>
<translation id="2236949375853147973">내 활동</translation>
<translation id="6387327671844988108">모든 기기에서 내 주소 등을 가져오려면 Chromium에 로그인하세요. 로그인하면 이 주소가 Google 계정에 저장됩니다</translation>
<translation id="722050260205928409">컴퓨터를 공유하는 경우 친구와 가족이 개별적으로 탐색하고 원하는 대로 Chromium을 설정할 수 있습니다.</translation>
<translation id="703211526866942526">Chromium의 스킬</translation>
<translation id="2283803047247799269">이미지 검색으로 이 탭 검색</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{브라우저 속도를 저하시키는 탭을 일시중지하는 것이 좋습니다}other{브라우저 속도를 저하시키는 탭을 일시중지하는 것이 좋습니다}}</translation>
<translation id="2307973900865360088">도크에 고정</translation>
<translation id="6083276764640161328">Chromium에 저장된 안전하지 않은 사이트 목록을 사용하여 URL을 검사합니다. 사이트에서 사용자의 비밀번호를 도용하려고 하거나 사용자가 유해한 파일을 다운로드하는 경우, Chromium에서 페이지 콘텐츠 일부를 비롯한 URL을 세이프 브라우징 서비스에 보낼 수 있습니다.</translation>
