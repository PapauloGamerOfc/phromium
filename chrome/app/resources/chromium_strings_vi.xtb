<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="1026101648481255140">Tiếp tục cài đặt</translation>
<translation id="1029669172902658969">Chạy lại để cập nhật &amp;ChromiumOS</translation>
<translation id="7962340570690354348">Phromium khuyên bạn nên xem xét tiện ích này</translation>
<translation id="2702007788032964762">Khi một trang web yêu cầu tải trước các đường liên kết trên trang ở chế độ riêng tư, Phromium sẽ sử dụng các máy chủ của Google. Điều này giúp ẩn danh tính của bạn khỏi trang web được tải trước, nhưng Google sẽ biết những trang web được tải trước.</translation>
<translation id="1051793555070215510">Vui lòng dành một phút làm bản khảo sát này để giúp chúng tôi cải thiện chế độ ẩn danh.</translation>
<translation id="1065672644894730302">Không thể đọc tùy chọn của bạn. Một số tính năng có thể không khả dụng và các thay đổi đối với tùy chọn sẽ không được lưu.</translation>
<translation id="4964836565882496625">Cha mẹ bạn đã tắt tuỳ chọn "Quyền của các trang web, ứng dụng và tiện ích" đối với Phromium</translation>
<translation id="8409497136174302488">Phromium cần có quyền truy cập vào mạng cục bộ của bạn để tìm và sử dụng thiết bị ở gần</translation>
<translation id="4388904545107211948">Để tìm kiếm một tính năng hoặc tiện ích cụ thể của Phromium, hãy nhập lối tắt của tính năng hoặc tiện ích đó vào thanh địa chỉ, sau đó nhấn phím bạn chọn trên bàn phím</translation>
<translation id="7188624550427159072">Hiện tính năng tìm kiếm bằng Phromium trên khay hệ thống và bật phím tắt</translation>
<translation id="3689248207461565136">Phromium muốn xuất các mật khẩu của bạn. Hãy nhập mật khẩu Windows để cho phép thực hiện việc này.</translation>
<translation id="112640046208448578">Xác định đồ vật hoặc địa điểm, sao chép hoặc dịch văn bản. Khi bạn sử dụng tính năng Tìm kiếm hình ảnh, ảnh chụp màn hình trang sẽ được gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium là trình duyệt mặc định của bạn</translation>
<translation id="5414044255592121327">Để kiểm tra xem mật khẩu của bạn có bị ảnh hưởng bởi các vụ rò rỉ dữ liệu và sự cố bảo mật khác hay không, hãy <ph name="BEGIN_LINK" />đăng nhập vào Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Nhấp vào trình đơn Phromium</translation>
<translation id="1157985233335035034">Ngôn ngữ gần đây</translation>
<translation id="1184145431117212167">Không cài đặt được vì phiên bản Windows bạn đang sử dụng chưa được hỗ trợ.</translation>
<translation id="7861581212703831457">Giới thiệu về Phromium</translation>
<translation id="8752630985505435738">Nhận thông báo theo dõi giá từ Phromium trên điện thoại</translation>
<translation id="1203500561924088507">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="4933432676089063712">Có một <ph name="IMPORTANT_UPDATE" /> đang chờ xử lý. Để đảm bảo an toàn cho hoạt động duyệt web của bạn, Phromium sẽ cập nhật vào lần tới khi bạn không hoạt động trong <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">Khi bạn mở tính năng Tìm kiếm hình ảnh, thì tiêu đề, URL và nội dung của trang, bao gồm cả tệp PDF, sẽ được tự động gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản Google của mình trong Phromium. Để thay đổi chế độ cài đặt này, hãy chuyển đến phần "Tài khoản của bạn trong Phromium".</translation>
<translation id="7402478829083317456">Hiện Gemini trong Phromium trên thanh trình đơn của máy Mac</translation>
<translation id="4902531791098430822">Để chọn một phần màn hình trong Gemini trong Phromium, hãy dùng phím tắt.</translation>
<translation id="9002284132405311162">Mặc dù thẻ này không hoạt động nhưng bộ nhớ đã được giải phóng để giúp Phromium luôn hoạt động nhanh. Bạn có thể chọn luôn loại trừ trang web này khỏi trạng thái không hoạt động.</translation>
<translation id="5561666811965903444">Phromium đã chặn tệp tải xuống này vì đây là tệp nguy hiểm</translation>
<translation id="1340271056805240721">Khi đăng nhập vào các dịch vụ của Google như Gmail hoặc YouTube bằng <ph name="USER_EMAIL" />, bạn có thể tự động được đăng nhập vào Phromium bằng cùng một tài khoản</translation>
<translation id="5048805453292757697">Tải Phromium về điện thoại</translation>
<translation id="1290883685122687410">Lỗi thiết lập: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">Thiết lập hồ sơ Phromium mới</translation>
<translation id="7871721155662336863">Dùng thử với Gemini trong Phromium</translation>
<translation id="6569288432960798043">Phromium cần có quyền truy cập Bluetooth để tìm
 các thiết bị Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">Đăng nhập vào Phromium trên điện thoại</translation>
<translation id="1330562121671411446">Phát hiện ngôn ngữ</translation>
<translation id="1619655755195586133">Cũng xoá dữ liệu khỏi Phromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Đã ghim! Bạn có thể nhấn vào nút mới trên thanh công cụ để truy cập lại vào tính năng Tìm kiếm hình ảnh</translation>
<translation id="1383876407941801731">Tìm kiếm</translation>
<translation id="2947996037737257951">Dùng ứng dụng Phromium để tiếp tục duyệt web mọi lúc, mọi nơi</translation>
<translation id="141901961143729572">Chia sẻ suy nghĩ của bạn</translation>
<translation id="8355386219605656974">Để chia sẻ cửa sổ, hãy cho phép Phromium ghi màn hình trong phần Cài đặt hệ thống.</translation>
<translation id="1478370723027452770">Nhận trợ giúp về Chrome for Testing</translation>
<translation id="8398257182826094665">Để sử dụng thông tin đã lưu và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Phromium</translation>
<translation id="1497802159252041924">Lỗi cài đặt: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Trang này được bảo vệ</translation>
<translation id="3484755999946650557">Chia sẻ một thẻ Phromium</translation>
<translation id="3309377459597801353">Đăng nhập vào Phromium</translation>
<translation id="1547469039832541117">Kết thúc tác vụ được làm nổi bật.</translation>
<translation id="2354363290397602683">Ghim Phromium</translation>
<translation id="2244728813494358888">Công cụ đảm bảo an toàn của Phromium</translation>
<translation id="707582364915018531">Phromium muốn xoá dữ liệu của bạn trong Trình quản lý mật khẩu. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{Quản trị viên của bạn yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật}=1{Quản trị viên của bạn yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Quản trị viên của bạn yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="5032531544901236587">Tận hưởng những tính năng tuyệt vời nhất của Google nhờ ứng dụng Phromium trên điện thoại</translation>
<translation id="7311082384439462587">Xem các chế độ kiểm soát quan trọng đối với quyền riêng tư và tính bảo mật trong Phromium</translation>
<translation id="1640672724030957280">Đang tải xuống...</translation>
<translation id="1665602916345474427">Đã đăng nhập bằng tài khoản <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, gói thành viên. Mở trình đơn tài khoản</translation>
<translation id="4535436467771816034">Bạn có thể sử dụng Phromium mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác. Phromium cũng sẽ được ghim vào thanh tác vụ.</translation>
<translation id="1709772298389099340">Cung cấp đặc quyền cấp cao cho <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Thao tác này sẽ cho phép bạn chọn trong số các thiết bị có sẵn và hiển thị nội dung trên các thiết bị đó.</translation>
<translation id="3550860956769006392">Phromium sắp xoá dữ liệu duyệt web</translation>
<translation id="2053384509423635834">Phromium sẽ cố gắng nâng các hình thức chuyển hướng lên giao thức HTTPS</translation>
<translation id="2516115567501600458">Đã xóa dữ liệu Phromium</translation>
<translation id="8571959122390670188">Phromium sẽ khởi động lại sau <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">Khi không có giao thức HTTPS, Phromium sẽ sử dụng kết nối không an toàn mà không cảnh báo bạn</translation>
<translation id="5872244334553252095">Cho phép Phromium chạy dưới nền</translation>
<translation id="2213761221916953829">Để làm cho Phromium an toàn hơn, chúng tôi đã vô hiệu hóa một số tiện ích không được liệt kê trong <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> và có thể đã được thêm mà bạn không biết.</translation>
<translation id="8807881428325438878">Nhấp vào <ph name="BEGIN_BOLD" />Có<ph name="END_BOLD" /> trong thông báo của Windows để ghim Phromium vào thanh tác vụ giúp truy cập nhanh.</translation>
<translation id="6861833596843600606">Cài đặt lại Phromium</translation>
<translation id="3950056404221550225">Phromium đang cố gắng <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng các tiện ích và nhiều nội dung khác trên <ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">Lần tới, khi mở Phromium trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc sử dụng Trình quản lý mật khẩu của Google.</translation>
<translation id="1838374766361614909">Xóa tìm kiếm</translation>
<translation id="2724678689951174927">Để xoá dữ liệu duyệt web chỉ trên thiết bị này mà không xoá trong Tài khoản Google, hãy <ph name="BEGIN_LINK" />đăng xuất khỏi Phromium<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">Tải Phromium xuống điện thoại để mở hoặc tạo nhóm thẻ mới trong khi di chuyển.</translation>
<translation id="3191814926523151519">Bạn có thể quản lý các Tài khoản Google đã đăng nhập của mình. Tài khoản Google của bạn được sử dụng cho trình duyệt Phromium, Cửa hàng Play, Gmail, v.v. Nếu bạn muốn thêm tài khoản cho người khác, chẳng hạn như thành viên gia đình, hãy thêm người dùng mới trên chiếc <ph name="DEVICE_TYPE" /> của bạn. <ph name="LINK_BEGIN" />Tìm hiểu thêm<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Tìm kiếm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng dấu trang và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Chọn văn bản</translation>
<translation id="1236934630660512644">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình Phromium của bạn. Dữ liệu Phromium của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME" />. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản Google nhưng không thể liên kết dữ liệu này với tài khoản khác. Bạn có thể tùy chọn tạo cấu hình mới để giữ cho dữ liệu Phromium hiện có của bạn riêng biệt. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium sẽ tiết kiệm pin bằng cách hạn chế hoạt động trong nền và hiệu ứng hình ảnh, chẳng hạn như hiệu ứng cuộn mượt mà và tốc độ khung hình của video. <ph name="BEGIN_LINK" />Tìm hiểu thêm về Trình tiết kiệm pin<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Dịch vụ Trình cập nhật Phromium</translation>
<translation id="5797624919204275541">Bằng việc tắt tính năng này, bạn có thể đăng nhập vào các trang web của Google, chẳng hạn như Gmail mà không cần đăng nhập vào Phromium</translation>
<translation id="6850971726764387814">Phromium không phản hồi. Chạy lại ngay bây giờ?</translation>
<translation id="8289779763124483945">Tổ chức <ph name="MANAGER" /> của bạn yêu cầu bạn đăng nhập vào Phromium</translation>
<translation id="193439633299369377">ChromiumOS cần được khởi động lại để áp dụng bản cập nhật.</translation>
<translation id="3215238748514810076">Phromium đã chặn tệp tải xuống này vì loại tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="1953553007165777902">Đang tải xuống... Còn <ph name="MINUTE" /> phút</translation>
<translation id="8529252122707161160">Phromium không thể xác định hoặc đặt trình duyệt mặc định</translation>
<translation id="197326043290947695">Duyệt web thông minh hơn với tính năng Tìm kiếm hình ảnh</translation>
<translation id="7769772561254542263">Tìm hiểu lý do Phromium chặn một số tệp, mở trong thẻ mới</translation>
<translation id="3713013456746186442">Dịch vụ này giúp cập nhật phần mềm Phromium của bạn. Nếu dịch vụ này bị vô hiệu hoá hoặc bị dừng, phần mềm Phromium của bạn sẽ không được cập nhật. Điều này có nghĩa là lỗ hổng bảo mật phát sinh sẽ không thể khắc phục được và các tính năng có thể không hoạt động. Dịch vụ này sẽ tự gỡ cài đặt khi không được phần mềm Phromium nào dùng.</translation>
<translation id="5690439379999550641">Thao tác này sẽ xóa 1 mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Phromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Không cài đặt được. Vui lòng thử lại.</translation>
<translation id="2039417478970545937">Cài đặt.</translation>
<translation id="4765042254400173473">Chọn xem có bao gồm nhật ký duyệt web trên Phromium hay không để mang lại trải nghiệm phù hợp hơn trong các dịch vụ của Google</translation>
<translation id="1448229429009113044">Tích hợp sẵn trong Phromium để giúp bạn tạo, lưu và tự động điền mật khẩu mạnh. Thêm lối tắt để dễ dàng truy cập.</translation>
<translation id="2145664943269651168">Nhấp vào nút Tuỳ chỉnh Phromium trên trang Thẻ mới để mang lại giao diện mới cho Phromium</translation>
<translation id="6052463185672312901">Phromium đã chặn tệp tải xuống này vì tệp này chứa nội dung lừa đảo và có thể thực hiện các thay đổi không mong muốn đối với thiết bị của bạn</translation>
<translation id="3825064703718009924">Lần tới, khi mở Phromium iOS, bạn sẽ thấy lời nhắc dùng thử <ph name="FEATURE_NAME" />.</translation>
<translation id="886729435477608858">Mật khẩu và các dữ liệu khác trên Phromium mà bạn đã lưu trong Tài khoản Google của mình sẽ bị xoá khỏi thiết bị này. Để tiếp tục sử dụng các dữ liệu đó trong Phromium, hãy đăng nhập lại.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau 1 phút bạn không dùng đến Phromium. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}other{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau # phút bạn không dùng đến Phromium. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}}</translation>
<translation id="2125838419757773031">Chọn vùng trên màn hình để tìm kiếm</translation>
<translation id="2126108037660393668">Không xác minh được tệp tải xuống.</translation>
<translation id="2135919691573380097">Báo cáo trang web này</translation>
<translation id="2137162749895930932">Đóng màn hình dịch</translation>
<translation id="2147218225094845757">Ẩn bảng điều khiển bên</translation>
<translation id="1628700182434635922">Phromium đã chặn tệp tải xuống này vì trang web không sử dụng kết nối an toàn và tệp có thể đã bị can thiệp</translation>
<translation id="2170098639895543546">Chọn nội dung bất kỳ trên trang</translation>
<translation id="1807571394075492085">Tùy chỉnh Phromium</translation>
<translation id="2174917724755363426">Chưa cài đặt xong. Bạn có chắc chắn muốn huỷ không?</translation>
<translation id="8332848361915479268">Phromium – Đăng nhập vào mạng – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Lỗi khi kiểm tra bản cập nhật: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Xoá tài khoản khỏi Phromium</translation>
<translation id="6063124961634921864">Dùng ứng dụng Phromium để mang theo các công cụ mua sắm tốt nhất mọi lúc, mọi nơi</translation>
<translation id="8646569091716523420">An toàn hơn khi di chuyển nhờ tính năng Duyệt web an toàn có tăng cường bảo vệ trên Phromium cho iOS</translation>
<translation id="3084983792533696835">Đây là trang web nguy hiểm. Phromium đã xoá quyền thông báo.</translation>
<translation id="2236949375853147973">Hoạt động của tôi</translation>
<translation id="6387327671844988108">Để sử dụng địa chỉ và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium. Địa chỉ này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="722050260205928409">Nếu bạn chia sẻ máy tính, bạn bè và gia đình có thể duyệt web một cách riêng biệt và thiết lập Phromium theo ý của họ.</translation>
<translation id="703211526866942526">Kỹ năng trong Phromium</translation>
<translation id="2283803047247799269">Tìm kiếm thẻ này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Phromium đề xuất tạm dừng thẻ làm chậm trình duyệt của bạn}other{Phromium đề xuất tạm dừng các thẻ làm chậm trình duyệt của bạn}}</translation>
<translation id="2307973900865360088">Ghim vào thanh Dock</translation>
<translation id="6083276764640161328">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong Phromium. Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì Chrome cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang.</translation>
<translation id="2356070529366658676">Yêu cầu</translation>
<translation id="2359808026110333948">Tiếp tục</translation>
<translation id="741972887620936671">Tiện ích "<ph name="EXTENSION_NAME" />" muốn bạn đăng nhập vào Phromium</translation>
<translation id="4709464915929597251">Tắt Phromium đối với các ứng dụng chạy trong nền</translation>
<translation id="6804933363437420201">Để sử dụng tiện ích này bằng tài khoản <ph name="USER_EMAIL_ADDRESS" />, hãy đăng nhập vào Phromium.</translation>
<translation id="2384373936468275798">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn vì thông tin đăng nhập vào tài khoản của bạn đã lỗi thời.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích Phromium đã truy cập vào 1 thiết bị HID}=1{Một hoặc nhiều tiện ích Phromium đang truy cập vào 1 thiết bị HID}other{Một hoặc nhiều tiện ích Phromium đang truy cập vào # thiết bị HID}}</translation>
<translation id="1394893265611797679">Phromium cần có quyền truy cập máy ảnh và micrô đối với trang web này</translation>
<translation id="2403703063067034158">Lỗi khi khởi động: một phiên bản thiết lập khác đang chạy, vui lòng thử lại sau.</translation>
<translation id="8457868297375575309">Mở đường liên kết trong Phromium từ ứng dụng bất kỳ và giữ cho trình duyệt luôn xuất hiện trên thanh tác vụ</translation>
<translation id="5354209517289935579">Nhấp vào nút Tóm tắt để chia sẻ tài liệu này với Gemini trong Phromium nhằm xem nhanh nội dung tổng quan và đặt các câu hỏi nối tiếp</translation>
<translation id="6628402244681586711">Với <ph name="BEGIN_LINK" />các công cụ của Phromium<ph name="END_LINK" />, bạn có thể duyệt web an toàn và luôn nắm quyền kiểm soát</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="2451727308784734061">Sử dụng lối tắt để nhanh chóng truy cập vào Trình quản lý mật khẩu. Bạn có thể di chuyển lối tắt đến màn hình chính hoặc trình chạy ứng dụng của máy tính.</translation>
<translation id="1593547119543498467">Phromium sắp đóng</translation>
<translation id="6814323389195469782">Trong Phromium</translation>
<translation id="2485422356828889247">Gỡ cài đặt</translation>
<translation id="2513154137948333830">Yêu cầu khởi động lại: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Chọn văn bản bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="2643581100433412871">Phromium đang cố gắng thay thế các mật khẩu hiện tại. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="4103676945224728292">Phromium cần quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="8743720024689622265">Trình trợ giúp của Phromium</translation>
<translation id="2575822587468774919">Chọn nội dung bạn muốn tìm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8692134707551176334">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium</translation>
<translation id="6035715610127790081">Quét mã QR bằng điện thoại để tải Phromium xuống rồi đăng nhập vào Tài khoản Google của bạn.</translation>
<translation id="1579158377846894470">để tìm kiếm bằng Phromium.</translation>
<translation id="3626651250874375470">Tiếp tục sử dụng Phromium</translation>
<translation id="259935314519650377">Không thể lưu trình cài đặt đã tải xuống vào bộ nhớ đệm. Lỗi: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Hệ thống</translation>
<translation id="7634640424937626608">Tổ chức của bạn có thể xem và quản lý dữ liệu duyệt web (chẳng hạn như dấu trang, nhật ký và mật khẩu). Tổ chức không thể xem dữ liệu duyệt web trong các hồ sơ Phromium khác</translation>
<translation id="2669565213445601962">Xác minh danh tính của bạn để sử dụng và lưu dữ liệu Phromium trong tài khoản <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật}=1{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="4393202019354077587">Khởi động Phromium</translation>
<translation id="3192212313802409327">Đã xảy ra lỗi hệ điều hành khi cài đặt. Hãy tải xuống Phromium lại lần nữa.</translation>
<translation id="6648732950668475680">Nếu các bạn dùng chung một thiết bị, thì bạn bè và gia đình có thể duyệt web một cách riêng biệt cũng như thiết lập Phromium theo ý muốn</translation>
<translation id="3501804488281766385">Dễ dàng truy cập để sử dụng Gemini trong Phromium trên thiết bị của bạn, ngay cả khi Phromium đang ở trạng thái thu nhỏ.</translation>
<translation id="5655763731487334489">Thẻ Phromium</translation>
<translation id="582020748041490207">Để bảo mật hơn, Phromium sẽ mã hóa dữ liệu của bạn.</translation>
<translation id="2693283019505702310">Để xoá Tài khoản Google của bạn khỏi Phromium, hãy đăng xuất</translation>
<translation id="2989508583692830513">Để sử dụng mật khẩu, dấu trang và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium</translation>
<translation id="2738871930057338499">Không thể kết nối với Internet. HTTP 403 bị cấm. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="2753623023919742414">Nhấp để tìm</translation>
<translation id="3391021955306442819">Đặt Phromium làm trình xem PDF mặc định</translation>
<translation id="293156805028931571">Tiện ích này chứa phần mềm độc hại và không an toàn. Hãy xoá khỏi Phromium để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="2799223571221894425">Chạy lại</translation>
<translation id="4742633141454352374">Phromium của bạn</translation>
<translation id="2816462166102338036">Sử dụng tính năng Tìm kiếm hình ảnh để tìm kiếm video này</translation>
<translation id="2191308357458164968">Khám phá sản phẩm bằng camera, theo dõi thông tin giảm giá và thực hiện nhiều việc khác mọi lúc, mọi nơi nhờ Phromium trên iOS.</translation>
<translation id="2841525013647267359">Dịch từ</translation>
<translation id="2846251086934905009">Lỗi cài đặt: Chưa hoàn tất trình cài đặt. Hoạt động cài đặt đã bị huỷ.</translation>
<translation id="4498037716339180906">Xóa khỏi Phromium...</translation>
<translation id="4049188396834160957">Giúp bạn an toàn trên Chrome và có thể dùng để cải thiện mức độ bảo mật cho bạn trong các ứng dụng khác của Google sau khi đăng nhập</translation>
<translation id="2885378588091291677">Trình quản lý tác vụ</translation>
<translation id="4119302609687132178">Giới thiệu về &amp;Phromium</translation>
<translation id="2915996080311180594">Khởi động lại sau</translation>
<translation id="8232968781653330429">Dữ liệu của bạn được mã hoá bằng cụm mật khẩu. Nhập cụm mật khẩu để sử dụng và lưu dữ liệu trên Phromium vào Tài khoản Google của bạn.</translation>
<translation id="2945997411976714835">Lỗi cài đặt: Trình cài đặt không thể bắt đầu quá trình.</translation>
<translation id="5624652745932625503">Đăng nhập vào các trang web nhanh hơn bằng mật khẩu đã lưu cho Phromium trên iOS</translation>
<translation id="8821179372057577828">Tổ chức bạn quản lý Phromium</translation>
<translation id="741172935898285572">Phromium đã được cập nhật</translation>
<translation id="8798708493876822519">Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì Phromium cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang</translation>
<translation id="6896740867011823632">Đăng nhập vào Phromium để an toàn hơn trên mạng nhờ các lựa chọn của cha mẹ bạn</translation>
<translation id="3003694935412297923">Tất cả tác vụ</translation>
<translation id="3580865868015023718">{count,plural, =1{Phromium cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất ngay, dữ liệu này (1 mục) sẽ bị xoá.}other{Phromium cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất ngay, dữ liệu này ({count}) sẽ bị xoá.}}</translation>
<translation id="1211179250505223767">Mở <ph name="URL" /> trong một thẻ mới trên Phromium.</translation>
<translation id="4742400838355945730">Các phát kiến về AI, chẳng hạn như kỹ năng, được lưu vào Tài khoản Google của bạn và được quản lý riêng với tính năng đồng bộ hoá Phromium</translation>
<translation id="8070050512429584052">Để sử dụng tiện ích và nhiều dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium</translation>
<translation id="666691655897541311">Đang thêm vào Phromium...</translation>
<translation id="3038232873781883849">Đang chờ cài đặt...</translation>
<translation id="3045032126857188731">Ngôn ngữ dịch: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Đóng hộp thoại phản hồi</translation>
<translation id="919456815618829047"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng danh sách đọc và nhiều nội dung khác trên <ph name="DEVICE" />.</translation>
<translation id="6141754610526066487">Các hồ sơ khác trên Phromium</translation>
<translation id="2380720899384114679">Tiện ích là các phần bổ sung giúp bạn tuỳ chỉnh Phromium. Từ sắp xếp khoa học đến đơn giản hoá các công việc hằng ngày, tiện ích giúp bạn biến Phromium thành trình duyệt của riêng mình.</translation>
<translation id="2507281899032275020">Giúp cải thiện Phromium bằng cách gửi báo cáo sự cố và <ph name="UMA_LINK" /> tới Google</translation>
<translation id="1514966729948178660">Dùng ứng dụng Phromium để mang theo các tính năng an toàn của Google mọi lúc, mọi nơi</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích Phromium đã truy cập vào 1 thiết bị USB}=1{Một hoặc nhiều tiện ích Phromium đang truy cập vào 1 thiết bị USB}other{Một hoặc nhiều tiện ích Phromium đang truy cập vào # thiết bị USB}}</translation>
<translation id="78720743239019396">Để sử dụng danh sách đọc và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Phromium</translation>
<translation id="7000206277447032115">Nhật ký duyệt web trên Phromium</translation>
<translation id="4555002192651219296">Trình cài đặt không thể giải nén tệp lưu trữ. Hãy tải xuống Phromium lại lần nữa.</translation>
<translation id="310459126943037700">Chưa thể kết thúc nhiệm vụ.</translation>
<translation id="3104828284009500087">Tìm nội dung bất kỳ trên trang</translation>
<translation id="4867557516756736957">Đồng bộ hoá hoàn toàn mật khẩu, dấu trang và nhật ký trên các thiết bị. Dễ dàng sử dụng các tính năng bạn quen thuộc và yêu thích bằng cách cập nhật trình duyệt mặc định thành Phromium.</translation>
<translation id="8632308594821621017">Phromium đang sử dụng micrô của bạn.</translation>
<translation id="3130333203120345554">Lượt tìm kiếm mới</translation>
<translation id="3137969841538672700">Kéo để tìm</translation>
<translation id="9173792796158381383">Thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép Phromium dừng hoạt động của thẻ này.</translation>
<translation id="8874679893080632357">Để chia sẻ màn hình, hãy cho phép Phromium ghi màn hình trong phần Cài đặt hệ thống</translation>
<translation id="101045618220347251">Chạy lại Phromium</translation>
<translation id="3161522574479303604">Tất cả ngôn ngữ</translation>
<translation id="5940989267583033306">Mở đường liên kết trong cửa sổ ẩn danh của Phromium</translation>
<translation id="2045477525210426976">Tùy chỉnh hồ sơ mới của bạn trên Phromium</translation>
<translation id="3540518135502114323">Bạn có thể tiếp tục trò chuyện với Chế độ AI mà không cần chuyển đổi giữa các thẻ. Để bắt đầu, hãy đăng nhập vào Phromium. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="1496180326063744749">Để xoá Tài khoản Google của bạn khỏi Phromium, hãy vào trang Cài đặt rồi đăng xuất khỏi Phromium</translation>
<translation id="7792783034323745412">Sau đó, Phromium có thể hỏi xem bạn có muốn sử dụng thông tin đã lưu để tự động điền vào biểu mẫu hay không</translation>
<translation id="5240091371721695404">Phromium không thể đọc và ghi vào thư mục dữ liệu:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">Mang theo các công cụ AI của Google mà bạn yêu thích mọi lúc, mọi nơi nhờ Phromium trên iOS.</translation>
<translation id="4848363951707149242">Để sử dụng tiện ích và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Phromium</translation>
<translation id="3286538390144397061">Khởi động lại Ngay bây giờ</translation>
<translation id="8613877111531019527">Khóa API của Google bị thiếu. Một số chức năng của Phromium sẽ bị tắt.</translation>
<translation id="2784090498377460662">Tiếp tục chạy các ứng dụng dưới nền khi Phromium bị đóng</translation>
<translation id="3905054486991167751">Phromium sẽ cập nhật khi bạn rời đi</translation>
<translation id="4502950976754616266">Phromium sẽ cảnh báo bạn trước khi tải trang web bằng kết nối không an toàn</translation>
<translation id="6107453188231652861">Khi đóng tất cả các cửa sổ Phromium, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản Google nếu bạn đã đăng nhập vào Phromium. Để cho phép trang web ghi nhớ bạn, hãy <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">góc trên cùng bên phải của khu vực tìm kiếm: <ph name="RIGHT" />% từ bên phải sang, <ph name="TOP" />% từ trên cùng xuống</translation>
<translation id="5896635343289575401">Dữ liệu Phromium trong tài khoản của bạn</translation>
<translation id="5662253013097242821">Sử dụng mật khẩu của bạn với Phromium trên điện thoại</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">Chuyển sang hồ sơ hiện có trên Phromium?</translation>
<translation id="3412460710772753638">Trong Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="657700335789940813">Phromium cần cập nhật</translation>
<translation id="3487742274367151379">Để sử dụng dấu trang và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Phromium</translation>
<translation id="3438772217992559640">Tìm kiếm thẻ này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8062355070850891600">Mở rộng phạm vi của tính năng Duyệt web an toàn có tăng cường bảo vệ với Phromium trên điện thoại</translation>
<translation id="5419337472918920970">Đang tuỳ chỉnh Phromium cho phù hợp với bạn...</translation>
<translation id="6573105037542661278">Thao tác này sẽ xóa <ph name="ITEMS_COUNT" /> mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Phromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="4600986251755456192">Phím tắt <ph name="SHORTCUT" /> có thể giúp chuyển đổi giữa các hồ sơ trên Phromium</translation>
<translation id="8118189978246431067">Hãy đóng tất cả cửa sổ Phromium và thử lại.</translation>
<translation id="7430418346833889620">Để chia sẻ cửa sổ, hãy cho phép Phromium ghi màn hình trong phần Cài đặt hệ thống</translation>
<translation id="2943929290955142701"><ph name="EXISTING_USER" /> đã đăng nhập.  Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5896697187441340113">Mã QR để tải trình duyệt Phromium xuống thiết bị di động</translation>
<translation id="354621070532799440">Lời nhắc: Các tính năng an toàn tốt nhất của Google ngay trên điện thoại của bạn</translation>
<translation id="6718500626359284607">Để chia sẻ màn hình, hãy cho phép Phromium ghi màn hình trong phần Cài đặt hệ thống.</translation>
<translation id="6511372913460632136">Chế độ bảo vệ nâng cao sẽ tắt tính năng tối ưu hoá JavaScript đối với những trang web mà Phromium không nhận ra</translation>
<translation id="3597003331831379823">Không thể chạy quy trình thiết lập bằng đặc quyền cấp cao. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Đăng nhập vào Phromium</translation>
<translation id="8702816719621016911">Dữ liệu duyệt web của người này sẽ bị xóa khỏi thiết bị này. Để khôi phục dữ liệu, hãy đăng nhập vào Phromium bằng <ph name="USER_EMAIL" />.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{Đã có bản cập nhật Phromium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Phromium.}=1{Đã có bản cập nhật Phromium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Phromium. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Đã có bản cập nhật Phromium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Phromium. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="3667616615096815454">Không thể cài đặt, máy chủ không xác định được ứng dụng.</translation>
<translation id="678730369472836428">Sử dụng <ph name="BEGIN_LINK" />cụm mật khẩu của riêng bạn<ph name="END_LINK" /> để mã hoá tất cả dữ liệu Chrome trong Tài khoản Google Các địa chỉ và phương thức thanh toán từ Google Pay sẽ không được mã hoá. Nhật ký duyệt web trên Phromium sẽ không đồng bộ hoá.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{Quản trị viên của bạn yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật này}=1{Quản trị viên của bạn yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật này. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Quản trị viên của bạn yêu cầu bạn chạy lại Phromium để áp dụng bản cập nhật này. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="2203303261468330007">Mở đường liên kết trong thẻ mới của Phromium</translation>
<translation id="686463893976008238">Liên kết Phromium và các dịch vụ khác của Google cho mục đích cá nhân hoá và các mục đích khác</translation>
<translation id="3729187154190517324">Mở rộng phạm vi tìm kiếm bằng cách thêm nhiều thẻ, tệp và công cụ bằng nút "Thêm một thẻ và các nội dung khác".</translation>
<translation id="5596264049590907430">Quản lý hồ sơ trên Phromium</translation>
<translation id="5594723037153142396">Tìm hiểu lý do Phromium chặn một số nội dung tải xuống</translation>
<translation id="3425307214497790458">Phromium sẽ thông báo cho bạn nếu có vấn đề cần bạn xem xét</translation>
<translation id="4247980944121268675">Phromium tải trước các trang mà bạn có thể sẽ truy cập để các trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="3810973564298564668">Quản lý</translation>
<translation id="1058395779823101457">Để sử dụng mật khẩu bạn đã lưu, hãy quét mã QR, tải Phromium dành cho iOS xuống rồi đăng nhập vào Tài khoản Google của bạn</translation>
<translation id="3846683726093018685">**Tóm tắt:** Hãy mô tả chủ đề và mục đích chính của nội dung trong ảnh chụp màn hình này bằng một câu dưới 30 từ.

          **Đề xuất câu hỏi:** Tạo một danh sách có dấu đầu dòng gồm 3 đến 5 câu hỏi gợi mở mà người dùng có thể đặt ra để hiểu rõ hơn về ảnh chụp màn hình này. Danh sách này phải có ít nhất một câu hỏi cụ thể về một đối tượng trực quan trong ảnh và thiết kế hoặc vị trí của đối tượng đó.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">Để sử dụng dấu trang và nhiều dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium</translation>
<translation id="3885770153807205175">Bộ chọn ngôn ngữ</translation>
<translation id="5947409614720749543">Tùy chỉnh và kiểm soát Phromium. Bạn cần lưu ý - nhấp để xem thông tin chi tiết.</translation>
<translation id="2176348074240183776">Nhấp vào tên của bạn để mở Phromium và bắt đầu duyệt web.</translation>
<translation id="3892148308691398805">Sao chép văn bản</translation>
<translation id="3679766722656346339"><ph name="EXISTING_USER" /> đã đăng nhập vào hồ sơ này trên Phromium. Để tách biệt hoạt động duyệt web của bạn, Phromium có thể tạo hồ sơ riêng cho bạn.</translation>
<translation id="6085953975934135790">Tiện ích này vi phạm chính sách của Cửa hàng Chrome trực tuyến và có thể không an toàn. Hãy xoá khỏi Phromium để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="3941890832296813527">Lỗi cài đặt: Tên tệp của trình cài đặt không hợp lệ hoặc không được hỗ trợ.</translation>
<translation id="608187946760434925">Phromium đang cố gắng sao chép mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="3054592240125889472">Để sử dụng thông tin đã lưu và nhiều dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium</translation>
<translation id="3140795250676341027">Mật khẩu, phương thức thanh toán và địa chỉ mà bạn đã lưu trong Tài khoản Google sẽ bị xoá khỏi thiết bị này. Để tiếp tục sử dụng các dữ liệu đó trong Phromium, hãy đăng nhập lại.</translation>
<translation id="395904275706073188">Không thể đọc các trang được bảo vệ. Hãy thử đọc một trang khác.</translation>
<translation id="4227910144250222665">Tìm hiểu cách Phromium bảo vệ bạn</translation>
<translation id="3967822245660637423">Đã tải xuống xong</translation>
<translation id="4150430234581811723">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, Phromium sẽ gửi nội dung bạn nhập đến công cụ tìm kiếm, AI và công cụ hỗ trợ của tổ chức bạn để đưa ra đề xuất.</translation>
<translation id="3975724895399328945">Giới thiệu về &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">Giới thiệu về ChromiumOS</translation>
<translation id="4847805566397342820">Khi bạn truy cập vào một trang web, Phromium sẽ gửi một phần URL đã làm rối mã nguồn cho tính năng <ph name="BEGIN_LINK" />Duyệt web An toàn của Google<ph name="END_LINK" /> thông qua một máy chủ đảm bảo quyền riêng tư giúp ẩn địa chỉ IP của bạn. Nếu một trang web có hành vi đáng ngờ, Chrome cũng sẽ gửi URL đầy đủ và các đoạn nội dung trên trang cho Google.</translation>
<translation id="4016217212818346953">Giữ an toàn với Trình quản lý mật khẩu</translation>
<translation id="4019629340646866719">ChromiumOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS" />phần mềm nguồn mở<ph name="END_LINK_CROS_OSS" /> bổ sung, tương tự như <ph name="BEGIN_LINK_LINUX_OSS" />môi trường phát triển Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Dịch màn hình</translation>
<translation id="4023601594785368013">Ngôn ngữ gốc: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">Mở đường liên kết trong Phromium từ ứng dụng bất kỳ. Ngoài ra, Phromium sẽ được ghim vào thanh tác vụ để bạn dễ dàng truy cập.</translation>
<translation id="6916567874038032700">Giúp cải thiện Phromium bằng cách báo cáo <ph name="BEGIN_LINK" />cài đặt hiện tại<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Cải thiện bảo mật quan trọng và tính năng mới có trong phiên bản mới nhất.</translation>
<translation id="4055805654398742145">Trình quản lý mật khẩu</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{Tổ chức sẽ tự động đóng Phromium sau 1 phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}other{Tổ chức sẽ tự động đóng Phromium sau # phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}}</translation>
<translation id="2498876341137940584">Chế độ ẩn danh của Phromium</translation>
<translation id="1371775705240141332">Chuyển đến trang Giới thiệu về Phromium</translation>
<translation id="1983555117242858621">Tuỳ chỉnh Phromium để mang lại giao diện mới cho trình duyệt</translation>
<translation id="3730928612696305544">Tuỳ chỉnh Phromium</translation>
<translation id="4148957013307229264">Đang cài đặt...</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> – Đăng nhập vào mạng – Phromium</translation>
<translation id="8940475598678719246"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng danh sách đọc và nhiều nội dung khác trên mọi thiết bị của mình.</translation>
<translation id="3361801572720154185">Khám phá các ứng dụng, trò chơi, tiện ích và chủ đề tuyệt vời cho Phromium.</translation>
<translation id="5104340040322658377">Để sử dụng tiện ích này và các tiện ích khác trên tất cả máy tính của bạn, hãy đăng nhập vào Phromium</translation>
<translation id="6533832886058295845">Để giúp bạn an toàn hơn trên mạng với các lựa chọn của cha mẹ, hãy chuyển sang hồ sơ Phromium mà bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Đang hủy...</translation>
<translation id="4224210481850767180">Quá trình cài đặt đã bị huỷ.</translation>
<translation id="6904238369362879351">Bạn muốn liên kết dữ liệu Phromium của bạn với tài khoản này?</translation>
<translation id="357744319784654404">Cảnh báo cho bạn về các trang web nguy hiểm, kể cả trang web mà Google chưa từng biết, bằng cách phân tích nhiều dữ liệu trên các trang web hơn so với chế độ bảo vệ tiêu chuẩn. Bạn có thể chọn bỏ qua cảnh báo của Phromium.</translation>
<translation id="7228779501660520489">Đăng xuất khỏi Phromium</translation>
<translation id="2782053121162821">Nhận trợ giúp về Phromium</translation>
<translation id="4281844954008187215">Điều khoản dịch vụ</translation>
<translation id="5084022108026911204">Không thể cài đặt do lỗi chưa xác định. Nếu Phromium hiện đang chạy, hãy đóng Phromium và thử lại.</translation>
<translation id="5139026954638666406">Xuất mật khẩu từ Phromium</translation>
<translation id="4304713468139749426">Trình quản lý mật khẩu</translation>
<translation id="4334241893986177674">Tìm kiếm thông tin trên ảnh chụp màn hình này</translation>
<translation id="8324735155671556570">Khởi chạy Phromium khi Windows khởi động</translation>
<translation id="4400772909124543403">Hiện không có bản cập nhật nào</translation>
<translation id="2185735215611818026">Bạn vẫn muốn thoát khỏi Phromium?</translation>
<translation id="4413205837991854510">Luôn hiện lối tắt Tìm kiếm hình ảnh</translation>
<translation id="1338297030721125711">Cho phép Phromium chạy trong nền</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{Phromium khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" />}other{Phromium khuyên bạn nên loại bỏ các tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" />.}}</translation>
<translation id="1011403527148313450">Tùy chỉnh và điều khiển Phromium</translation>
<translation id="4427306783828095590">Chế độ bảo vệ tăng cường giúp chặn phần mềm độc hại và hành vi lừa đảo hiệu quả hơn</translation>
<translation id="4434353761996769206">Lỗi trình cài đặt: <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415"><ph name="MANAGER" /> quản lý Phromium</translation>
<translation id="2477616462388290618">Thêm hồ sơ Phromium</translation>
<translation id="4447409407328223819">Giới thiệu về Chrome for Testing</translation>
<translation id="972523218852576493">Để sử dụng và lưu dữ liệu Phromium trong Tài khoản Google, hãy nhập cụm mật khẩu của bạn</translation>
<translation id="4493028449971051158">Lỗi khi khởi động: vui lòng chạy trình cài đặt với tư cách quản trị viên.</translation>
<translation id="4501471624619070934">Không cài đặt được do quyền truy cập bị giới hạn tại quốc gia này.</translation>
<translation id="8839763675940122379">Tiện ích này chưa công bố các phương thức bảo vệ quyền riêng tư, chẳng hạn như cách tiện ích thu thập và sử dụng dữ liệu. Phromium khuyên bạn nên xoá tiện ích này.</translation>
<translation id="2339640488105852505">Chào mừng bạn đến với Phromium. Cửa sổ trình duyệt mới đã mở ra</translation>
<translation id="8536959233160434213">Phromium cần có quyền tạo bản đồ về các khu vực xung quanh và theo dõi tay bạn</translation>
<translation id="1077734277628859167">Bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS" /> trong một hồ sơ Phromium khác</translation>
<translation id="5512897665247593318">Phromium tải trước các trang để giúp bạn duyệt web và tìm kiếm nhanh hơn. <ph name="BEGIN_LINK" />Tìm hiểu thêm về tính năng tải trước trang<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Cải thiện mức độ an toàn trên mạng cho mọi người khi bạn báo cáo một trang web mà bạn cho là có hại.</translation>
<translation id="6624033199018630177">Phromium đã chặn tệp tải xuống này do không thể xác minh tệp (vì bạn đã tắt tính năng Duyệt web an toàn)</translation>
<translation id="3039804643080655517">Dùng thử Google Ống kính với Phromium trên điện thoại</translation>
<translation id="4594305310729380060">Vào Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="8064263528617889755">Ứng dụng Phromium</translation>
<translation id="4598116752460667024">Tìm quy trình bất kỳ trong danh sách.</translation>
<translation id="4613863813562375431">Phiên bản ChromiumOS</translation>
<translation id="7245201002247176127">Gần được cập nhật! Hãy khởi chạy lại Phromium để hoàn tất cập nhật.</translation>
<translation id="8846891938874485868">Tăng tốc độ tải trang web bằng công cụ V8 của Phromium nhưng làm giảm khả năng chống lại các cuộc tấn công của Phromium</translation>
<translation id="7525500996671436081">Mở tính năng Tìm kiếm bằng Phromium</translation>
<translation id="1224842000407297331">Hồ sơ Phromium</translation>
<translation id="4956303519269880412">Cảnh báo: Phromium không thể ngăn các tiện ích ghi lại nhật ký duyệt web của bạn. Để tắt tiện ích này trong chế độ Ẩn danh, hãy bỏ chọn tùy chọn này.</translation>
<translation id="2708255035805733225">Nếu bạn cũng chia sẻ báo cáo sử dụng của Phromium, thì các báo cáo đó sẽ bao gồm cả những URL bạn truy cập</translation>
<translation id="4673710618874938871">Đã đăng nhập bằng tài khoản <ph name="USER_NAME" />, gói thành viên. Mở trình đơn tài khoản</translation>
<translation id="1883292567514549610">Dường như cấu hình này đang được quy trình Phromium khác (<ph name="PROCESS_ID" />) trên máy tính khác (<ph name="HOST_NAME" />) sử dụng. Phromium đã khóa cấu hình này để cấu hình không bị lỗi. Nếu bạn chắc chắn không có quy trình nào khác đang sử dụng cấu hình này, bạn có thể mở khóa cấu hình và chạy lại Phromium.</translation>
<translation id="4680828127924988555">Huỷ cài đặt</translation>
<translation id="1889305042180577023">Một số dữ liệu Phromium của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này sẽ bị xoá.</translation>
<translation id="8079525505870459051">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản Google của mình trong Phromium. <ph name="SHORTCUT" /> có thể thay đổi chế độ cài đặt cho các dịch vụ của Google mà bạn sử dụng.</translation>
<translation id="2171507067211697961">Ai đó trước đây đã đăng nhập vào Phromium trên máy tính này bằng <ph name="ACCOUNT_EMAIL_LAST" />. Vui lòng tạo người dùng Phromium mới để giữ riêng biệt thông tin của bạn.</translation>
<translation id="4724676981607797757">Không cài đặt được do lỗi giao thức không được hỗ trợ.</translation>
<translation id="6925701206088903005">Bạn vẫn muốn thoát khỏi Phromium?</translation>
<translation id="4514755609496543621">Phromium vừa áp dụng một bản cập nhật bảo mật đặc biệt. Vui lòng khởi động lại ngay bây giờ và chúng tôi sẽ khôi phục các thẻ của bạn.</translation>
<translation id="8673673368917636496">Gần đây bạn không truy cập trang web này. Phromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> và <ph name="COUNT" /> quyền khác.</translation>
<translation id="3638319732826965647">Nếu Gemini trong Phromium đang mở, thì bảng điều khiển bên sẽ vẫn mở khi bạn tạo thẻ mới</translation>
<translation id="479167709087336770">Dịch vụ này sử dụng cùng một trình kiểm tra chính tả dùng trong Google Tìm kiếm. Thông tin bạn nhập vào trình duyệt sẽ được gửi tới Google. Bạn luôn có thể thay đổi hành động này trong phần cài đặt.</translation>
<translation id="2659245507243672392">Dùng Phromium mà không cần tài khoản</translation>
<translation id="166411027652942990">Quy tắc kết nối để Phromium cho phép lưu lượng truy cập mDNS.</translation>
<translation id="6031862420354068813">Chạy lại để cập nhật &amp;Phromium</translation>
<translation id="4918086044614829423">Chấp nhận</translation>
<translation id="4918844574251943176">Đã sao chép hình ảnh</translation>
<translation id="1531905832227009774">Để sử dụng danh sách đọc và nhiều dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium</translation>
<translation id="4319892378006430019">Phromium đang chạy trong nền.</translation>
<translation id="8972359100025490790">Nhấp để đóng hộp thoại đăng nhập vào Phromium</translation>
<translation id="3639078149590125530">Với các hồ sơ trên Phromium, bạn có thể tách biệt mọi nội dung của mình khi dùng trình duyệt này. Hãy tạo hồ sơ cho bạn bè và gia đình hoặc phân tách nội dung công việc với nội dung giải trí.</translation>
<translation id="7141327976224964788">Khách có thể sử dụng Phromium mà không phải thoát khỏi bất cứ nội dung nào.</translation>
<translation id="7007327521155149139">Tài khoản của bạn trong Phromium</translation>
<translation id="5973804420920585431">Thêm chính bạn vào Phromium</translation>
<translation id="504699503110800016">Mở trình đơn mục bổ sung</translation>
<translation id="2497925691306722252">Truy cập vào tất cả tính năng của Google mà bạn yêu thích nhờ Phromium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="8678196879882043620">Phromium cần có quyền theo dõi cử chỉ tay của bạn</translation>
<translation id="3397880081430454820">Gần đây bạn không truy cập trang web này. Phromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="9114243566897924763">Đăng nhập vào Phromium</translation>
<translation id="5174969993834422967">Bạn thường chặn các thông báo. Để trang web này có thể gửi thông báo cho bạn, hãy nhấp vào biểu tượng thông báo ở góc bên phải của thanh vị trí.</translation>
<translation id="5174983315706567306">Dung lượng ổ đĩa không đủ.</translation>
<translation id="7698884672439844280">Tài khoản Phromium cần được xác thực lại</translation>
<translation id="5629965056131882780">Tiếp tục ngay tại nơi bạn đã dừng lại với Phromium trên iOS.</translation>
<translation id="874294566462998787">Đăng xuất khỏi Phromium</translation>
<translation id="5234764350956374838">Đóng</translation>
<translation id="8605581794204249702">Mở đường liên kết trong cửa sổ ẩn d&amp;anh của Phromium</translation>
<translation id="8722804301463582643">Tải ứng dụng Phromium để lưu mật khẩu mọi lúc, mọi nơi</translation>
<translation id="6253936671561887082">Để áp dụng các mục thay đổi của bạn, hãy chạy lại Phromium</translation>
<translation id="7405713141437293142">Để gửi thẻ này tới một thiết bị khác, hãy đăng nhập vào Phromium trên cả hai thiết bị</translation>
<translation id="5286907366254680517">Đã phát hiện</translation>
<translation id="2224284460884535818">Tải ứng dụng Phromium</translation>
<translation id="1426207087952749578">Khi bạn duyệt web ở Chế độ ẩn danh, Phromium sẽ cảnh báo bạn trước khi tải một trang web bằng kết nối không an toàn</translation>
<translation id="8108751453879231987">Tìm kiếm bằng Phromium</translation>
<translation id="7780358745459835678">Phromium Updater Internal Service</translation>
<translation id="6956753580765202069">Sử dụng các kỹ năng này cùng với các tính năng khác của Gemini trong Phromium</translation>
<translation id="5346389065299425353">Mở rộng phạm vi tìm kiếm bằng cách thêm nhiều thẻ, tệp và công cụ</translation>
<translation id="8684266995248242891">Xem tổng quan nhanh về tài liệu này và đặt câu hỏi cho Gemini trong Phromium</translation>
<translation id="586104673506947714">Phromium có một số ý kiến đề xuất về sự an toàn cần bạn xem xét</translation>
<translation id="4657908558997566735">Các hồ sơ khác trên Phromium</translation>
<translation id="6097378010983112326">ChromiumOS không thể lưu dữ liệu Phromium vào Tài khoản Google của bạn vì thông tin đăng nhập tài khoản đã lỗi thời</translation>
<translation id="385020720581757591">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình Phromium của bạn. Dữ liệu Phromium của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME" />. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản Google nhưng không thể liên kết dữ liệu này với tài khoản khác. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Mã bổ sung: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">Để sử dụng chế độ cá nhân hoá, hãy thêm Phromium vào mục Hoạt động trên web và ứng dụng</translation>
<translation id="2756028035855809142">Mở tính năng tìm kiếm bằng Phromium</translation>
<translation id="4375021373215585423">Tìm hiểu lý do Phromium chặn một số tệp</translation>
<translation id="4688227912949761884">Đang cập nhật Phromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng các tiện ích và nhiều nội dung khác trên mọi thiết bị của mình.</translation>
<translation id="4945147853702701048">Cho phép đăng nhập vào Phromium</translation>
<translation id="7813879193794658604">Xóa khỏi Phromium</translation>
<translation id="2908302339618007937">Làm giảm hiệu suất nhưng giúp Phromium tăng khả năng chống lại các cuộc tấn công</translation>
<translation id="8760365573983490520">Đặt Phromium là trình duyệt mặc định của bạn</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> - Phromium phiên bản beta</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{Phromium đề xuất tạm dừng thẻ làm chậm trình duyệt của bạn}other{Phromium đề xuất tạm dừng các thẻ làm chậm trình duyệt của bạn}}</translation>
<translation id="975923236500175446">Phromium có thể không hoạt động đúng cách do không còn được hỗ trợ trên bản phân phối Linux này</translation>
<translation id="7595270580374414215">Phromium đã chặn tệp tải xuống này vì tệp có thể gây hại cho tài khoản cá nhân và tài khoản mạng xã hội của bạn</translation>
<translation id="5644162187312430027">Vui lòng đợi khi Phromium cài đặt các bản cập nhật hệ thống mới nhất.</translation>
<translation id="2476033563817685908">Phromium đang cố gắng chỉnh sửa mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="1626952238284562558">Làm việc liền mạch với các ứng dụng bạn yêu thích như Google Drive và YouTube mọi lúc, mọi nơi nhờ Phromium.</translation>
<translation id="5524890928877629608">góc trên cùng bên trái của khu vực tìm kiếm: <ph name="LEFT" />% từ bên trái sang, <ph name="TOP" />% từ trên cùng xuống</translation>
<translation id="2860766395826060492">Mở tệp PDF trong Phromium</translation>
<translation id="5536164441519929134">Hỏi<ph name="LINE_BREAK" />về thẻ này</translation>
<translation id="3915500272078806319">Để đảm bảo an toàn, Phromium sẽ tắt tính năng tối ưu hoá JavaScript khi bạn truy cập vào một trang web lần đầu tiên.

Nếu trang này không hoạt động như mong đợi, hãy thử cho phép tính năng tối ưu hoá.</translation>
<translation id="6778733300408894918">Hiện Gemini trong Phromium trong thanh trình đơn của máy Mac và bật phím tắt</translation>
<translation id="8411908790152555435"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng sẽ nhận được thông tin đã lưu và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Lỗi khi khởi động: vui lòng chạy trình cài đặt với tư cách người dùng thông thường, không phải quản trị viên.</translation>
<translation id="6578510724610627339">Sử dụng Phromium theo mặc định và ghim Phromium</translation>
<translation id="5596627076506792578">Tuỳ chọn khác</translation>
<translation id="5605834417512968703">Chọn nội dung bạn muốn tìm bằng tính năng Tìm kiếm hình ảnh hoặc nhấn phím Escape để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="5618818588972826921">Chọn văn bản hoặc hình ảnh bất kỳ mà bạn muốn tìm kiếm bằng tính năng Tìm kiếm hình ảnh hoặc nhấn phím Escape để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="4431270188253419020">{0,plural, =0{Đã có bản cập nhật Phromium}=1{Đã có bản cập nhật Phromium}other{Đã có bản cập nhật Phromium từ # ngày trước}}</translation>
<translation id="6903143702905157196">Luôn xoá dữ liệu trang web khỏi thiết bị của bạn khi bạn đóng Phromium</translation>
<translation id="5354366475527026551">Vui lòng khởi động lại Phromium ngay bây giờ</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">Hiển thị Phromium bằng ngôn ngữ này</translation>
<translation id="569897634095159764">Không thể kết nối với Internet. Máy chủ proxy yêu cầu xác thực.</translation>
<translation id="5724138350057003647">Phromium giải phóng bộ nhớ khỏi các thẻ không hoạt động. Nhờ đó, các thẻ đang hoạt động và ứng dụng khác sẽ được sử dụng nhiều tài nguyên máy tính hơn, còn Phromium thì hoạt động nhanh chóng. Các thẻ không hoạt động sẽ tự động hoạt động trở lại khi bạn quay lại các thẻ đó. <ph name="BEGIN_LINK" />Tìm hiểu thêm về Trình tiết kiệm bộ nhớ<ph name="END_LINK" /></translation>
<translation id="3730992449058237228">Nếu bạn quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, hãy <ph name="SETTINGS_LINK" /> dữ liệu Phromium trong tài khoản của bạn</translation>
<translation id="1983042639279920602">Tuỳ chỉnh và kiểm soát Phromium. Đặt Phromium làm trình duyệt mặc định.</translation>
<translation id="7136978005010973283">Đặt Phromium làm trình duyệt mặc định để mật khẩu, dấu trang và nhật ký của bạn được đồng bộ hoá liền mạch trên mọi thiết bị.</translation>
<translation id="5809516625706423866">Không thể kết nối với Internet. HTTP 401 không được phép. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="3059302031765226748">Tăng tốc độ tải trang web bằng công cụ V8 của Phromium nhưng làm giảm khả năng chống lại các cuộc tấn công của Phromium. Chế độ cài đặt này đang tắt.</translation>
<translation id="4904710047654714935">Để sử dụng và lưu dữ liệu Phromium trong Tài khoản Google, hãy cập nhật Phromium</translation>
<translation id="5824893331272123205">Không tải được bảng điều khiển này, hãy thử lại</translation>
<translation id="2582896742857095190">Chào mừng bạn đến với Phromium</translation>
<translation id="5004643502851105876">Bật các tính năng bổ sung để sử dụng các biện pháp bảo vệ mạnh nhất của Phromium</translation>
<translation id="5871205389137001634">Nhấp để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="7409018434452575206">Phromium nhận thấy rằng các mục này chứa phần mềm độc hại:</translation>
<translation id="3191822983646594827">Phromium thường xuyên kiểm tra để đảm bảo trình duyệt của bạn có các chế độ cài đặt an toàn nhất. Chúng tôi sẽ thông báo cho bạn biết nếu có nội dung nào cần bạn xem xét.</translation>
<translation id="5895138241574237353">Khởi động lại</translation>
<translation id="625373791981566594">Gemini Enterprise trong Phromium</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Đăng nhập vào mạng</translation>
<translation id="5924017743176219022">Đang kết nối Internet...</translation>
<translation id="5941711191222866238">Thu nhỏ</translation>
<translation id="8650638130234822147">Để sử dụng dấu trang này và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium</translation>
<translation id="5010592102321399468">Biến Phromium thành trình duyệt của riêng bạn</translation>
<translation id="5960071705175224773">Một ứng dụng lạ đã thay đổi chế độ cài đặt của bạn</translation>
<translation id="5977420883993828287">Đã ghim! Bạn có thể sử dụng lại tính năng Tác vụ theo bối cảnh trên thanh công cụ</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{Tổ chức sẽ tự động đóng Phromium sau 1 phút bạn không dùng đến.}other{Tổ chức sẽ tự động đóng Phromium sau # phút bạn không dùng đến.}}</translation>
<translation id="3160371268592376569">Cập nhật Phromium để bắt đầu đồng bộ hóa</translation>
<translation id="5990360079535151574">Từ nút "Thao tác theo ngữ cảnh" trên thanh công cụ, bạn có thể mở lại Thao tác theo ngữ cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="6003112304606738118">Đang tải xuống... Còn <ph name="HOURS" /> giờ.</translation>
<translation id="6009821354356307391">Đặt câu hỏi nối tiếp</translation>
<translation id="6040143037577758943">Đóng</translation>
<translation id="5783572280281297164">Tận hưởng nhiều lợi ích hơn khi mua sắm trực tuyến bằng ứng dụng Phromium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="2712461133060419287">Để bảo vệ dữ liệu của bạn, hãy cho phép Phromium loại bỏ quyền khỏi các trang web mà gần đây bạn không truy cập. Bạn sẽ vẫn nhận được thông báo.</translation>
<translation id="7845842385196710435">&amp;Mở trong Phromium</translation>
<translation id="6069027071882229820">Sao chép dưới dạng hình ảnh</translation>
<translation id="3752072756936611600"><ph name="EXTENSION_NAME" /> đã được thêm vào Phromium</translation>
<translation id="2775066550187002528">Tùy chỉnh và kiểm soát Phromium. Đã có bản cập nhật.</translation>
<translation id="6531352038528110565">Bật • Phromium không thể xác minh nguồn gốc của tiện ích này</translation>
<translation id="2876078296400914679">Tài khoản của bạn trong Phromium</translation>
<translation id="3881538460441135554">Cho phép tiện ích hiện các yêu cầu truy cập trong thanh công cụ của Phromium</translation>
<translation id="7479187736743594081"><ph name="FILE_NAME" /> nguy hiểm, do đó Phromium đã chặn tệp.</translation>
<translation id="6646104775883837119">Phromium sắp đóng và xoá dữ liệu</translation>
<translation id="6138634751748297112">Bạn có thể chuyển đổi giữa các hồ sơ trên Phromium tại đây</translation>
<translation id="8660563290103481109">Nếu bạn cho phép cookie thì Phromium có thể dùng các cookie này khi tải trước</translation>
<translation id="6165508094623778733">Tìm hiểu thêm</translation>
<translation id="969667123257916656">Xoá dữ liệu Phromium trong tài khoản của bạn</translation>
<translation id="5528040738212560214">Tệp này có thể nguy hiểm<ph name="LINE_BREAK" />Phromium có thể giúp bạn kiểm tra nội dung tải xuống này nếu bạn cung cấp mật khẩu. Thông tin về tệp sẽ được gửi tới dịch vụ Duyệt web An toàn của Google nhưng nội dung tệp và mật khẩu vẫn nằm trên thiết bị của bạn.</translation>
<translation id="6182736845697986886">Không cài đặt được do lỗi nội bộ của máy chủ cập nhật.</translation>
<translation id="6041381825442292659">Đảm bảo bạn đã đăng nhập vào Phromium trên <ph name="TARGET_DEVICE_NAME" /> của mình rồi thử gửi lại.</translation>
<translation id="2474943719592372017">Tìm kiếm và đặt câu hỏi ở bất cứ đâu, ngay cả khi Phromium đang ở trạng thái thu nhỏ. Cho phép Phromium chạy ở chế độ nền.</translation>
<translation id="2518372260387069450">Máy tính này đã có phiên bản Phromium mới hơn. Nếu phần mềm không hoạt động, hãy gỡ cài đặt Phromium và thử lại.</translation>
<translation id="3832895416321159809">{0,plural, =0{Phromium sẽ khởi động lại ngay bây giờ}=1{Phromium sẽ khởi động lại sau 1 giây}other{Phromium sẽ khởi động lại sau # giây}}</translation>
<translation id="2775110773501098464">Phromium cần có quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="3505491405575013121">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong Phromium</translation>
<translation id="2276249127856880228">Đặt Phromium làm trình duyệt mặc định</translation>
<translation id="6248988683584659830">Tìm chế độ cài đặt</translation>
<translation id="554637698797403739">Tận hưởng các tính năng an toàn tốt nhất của Google mọi lúc, mọi nơi nhờ ứng dụng Phromium trên điện thoại</translation>
<translation id="7016155178198587734">Đăng xuất khỏi Phromium?</translation>
<translation id="5660287988409470276">Các thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép Phromium dừng hoạt động của các thẻ này.</translation>
<translation id="8429776045186716992">Tùy chỉnh hồ sơ Phromium của bạn</translation>
<translation id="3310436202618971091">Đặt tên cho hồ sơ của bạn trên Phromium</translation>
<translation id="1478750151648434251">Một tiện ích muốn bạn đăng nhập vào Phromium</translation>
<translation id="9139712828910812615"><ph name="FILE_NAME" /> có thể nguy hiểm, do đó Phromium đã chặn tệp.</translation>
<translation id="5191618263102115907">Phromium đang sử dụng máy ảnh của bạn.</translation>
<translation id="8247508943089477519">Một hoạt động khác trên Phromium đang diễn ra. Vui lòng thử lại sau.</translation>
<translation id="8271488218611798813">Giờ đây, việc sử dụng Phromium bằng tài khoản Google của bạn và trên máy tính dùng chung trở nên dễ dàng hơn.</translation>
<translation id="446228390478495078">Dễ dàng truy cập các tính năng bạn biết, yêu thích và tin tưởng bằng cách đặt Phromium làm trình duyệt mặc định.</translation>
<translation id="2203435422524224690">Lối tắt tới Phromium</translation>
<translation id="3977517784144885449">Phromium đã chặn tệp tải xuống này vì tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="8088471547690853921">Bạn có chắc chắn muốn gỡ cài đặt Phromium không?</translation>
<translation id="6375219077595103062">Thêm lối tắt vào Trình quản lý mật khẩu</translation>
<translation id="6388799252195623474">giúp tôi tra cứu về nội dung này</translation>
<translation id="1774421040071124552">Để tiếp tục, hãy đăng nhập vào Phromium bằng <ph name="EMAIL" />. Việc này sẽ đảm bảo các chính sách của tổ chức bạn được áp dụng.</translation>
<translation id="2343430845154053061">Biểu trưng Phromium trên màn hình máy tính.</translation>
<translation id="2724924185145648602">Phromium là trình duyệt web chạy các trang web và ứng dụng với tốc độ cực nhanh. Đây là một trình duyệt web nhanh, ổn định và dễ sử dụng. Duyệt web trở nên an toàn hơn với tính năng bảo vệ chống lại phần mềm độc hại và lừa đảo được tích hợp sẵn vào Phromium.</translation>
<translation id="7417453886359805803">Xác minh danh tính của bạn để đảm bảo bạn luôn sử dụng và lưu dữ liệu Phromium trong Tài khoản Google</translation>
<translation id="3304683228794166031">Phromium sẽ hoạt động nhanh hơn và các tính năng sử dụng JavaScript sẽ hoạt động như dự kiến</translation>
<translation id="6436260184216827876">Không dùng được tính năng Tìm kiếm hình ảnh. Hãy thử lại sau.</translation>
<translation id="6442900851116057561">Khởi động lại ChromiumOS</translation>
<translation id="9164801375934097818">Phromium tải trước thêm nhiều trang mà bạn có thể sẽ truy cập để những trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="2577121659922309103">Tải Phromium xuống điện thoại để theo dõi giá và nhận thông báo khi có chương trình giảm giá trên bất cứ trang web nào</translation>
<translation id="2052328618318278030">Tắt • Phromium không thể xác minh nguồn gốc của tiện ích này</translation>
<translation id="3122296739697671126">Chào mừng bạn đến với hồ sơ trên Phromium</translation>
<translation id="3472445024540245926">Lần tới, khi mở Phromium trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc sử dụng nhóm thẻ.</translation>
<translation id="2144084801479939969">Xoá tài khoản khỏi Phromium</translation>
<translation id="2473490714352939152">Tiện ích này cũng điều khiển trang nào được hiển thị khi bạn khởi động Phromium.</translation>
<translation id="648319183876919572">Tính năng Duyệt web an toàn có tăng cường bảo vệ hoạt động hiệu quả hơn để bảo vệ bạn khỏi các tệp đã tải xuống và trang web nguy hiểm</translation>
<translation id="359777544552173333">Gỡ cài đặt Phromium</translation>
<translation id="3890462049854841354">Phím tắt mở ra trong Phromium</translation>
<translation id="6616579671682178785">Tổ chức của bạn sẽ đóng Phromium khi Phromium không được dùng đến trong <ph name="TIMEOUT_DURATION" />. Dữ liệu duyệt web đã bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.</translation>
<translation id="8662645370371079862">Mỗi hồ sơ đều có thông tin riêng trên Phromium, chẳng hạn như dấu trang, các trang web đã truy cập, mật khẩu và nhiều thông tin khác</translation>
<translation id="6556755379298048869">Tìm kiếm bằng phím tắt.</translation>
<translation id="7133640529688742768">Tìm hiểu thêm về <ph name="BEGIN_LINK" />cách Phromium bảo mật dữ liệu của bạn<ph name="END_LINK" /></translation>
<translation id="8316065704185291024">Các thay đổi đối với chế độ cài đặt này sẽ được áp dụng sau khi Phromium khởi động lại.</translation>
<translation id="2816396636285296289">Quản lý các tiện ích bằng cách nhấp vào phần Tiện ích trong trình đơn chính của Phromium.</translation>
<translation id="8831144879019828189">Bạn có thể chuyển để xem mật khẩu trong một hồ sơ Phromium khác</translation>
<translation id="7017911482442558099">Dùng ứng dụng Phromium để mang theo các công cụ AI tốt nhất mọi lúc, mọi nơi</translation>
<translation id="5784574554904759369">Để sửa lỗi chính tả, Phromium sẽ gửi cho Google nội dung bạn nhập vào các trường văn bản</translation>
<translation id="8485501471305987872">Chuyển đến phần cài đặt thông báo của Phromium</translation>
<translation id="6600016381025017075">Tìm nội dung bất kỳ trên trang này</translation>
<translation id="1462793186918694806">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại Phromium.</translation>
<translation id="7501991510212476553">Phromium hiện khởi chạy khi Windows khởi động để bạn có thể bắt đầu duyệt web ngay lập tức. Bạn có thể tắt lựa chọn này trong phần cài đặt.</translation>
<translation id="7686308613268368175">Tiếp tục từ nơi bạn đã dừng lại: Phromium đã khôi phục các thẻ của bạn từ phiên trước đó. Bạn có thể tắt tính năng này trong phần</translation>
<translation id="5266723901802366313">Phromium cần có quyền truy cập camera để tạo bản đồ 3D khu vực xung quanh bạn</translation>
<translation id="7085315067428293799">Nếu cũng lưu dấu trang trong Tài khoản Google, bạn có thể theo dõi giá sản phẩm trong Phromium và nhận thông báo khi sản phẩm giảm giá</translation>
<translation id="6676384891291319759">Truy cập Internet</translation>
<translation id="668175097507315160">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn do lỗi khi đăng nhập.</translation>
<translation id="5279767706090517695">Xoá dữ liệu của ứng dụng này khỏi Phromium</translation>
<translation id="6562226321659107531">Phromium cần có quyền truy cập micrô đối với trang web này</translation>
<translation id="6712881677154121168">Lỗi khi tải xuống: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">Không thể sử dụng cấu hình của bạn do cấu hình này đến từ một phiên bản Phromium mới hơn.

Một số tính năng có thể không khả dụng. Hãy chỉ định thư mục cấu hình khác hoặc sử dụng phiên bản Phromium mới hơn.</translation>
<translation id="4914871493602315663">Để sử dụng chế độ cá nhân hoá và các tính năng khác, hãy thêm Phromium vào mục Hoạt động trên web và ứng dụng cũng như các dịch vụ của Google được liên kết</translation>
<translation id="5919390816124912606">Phromium đã được cài đặt cho tất cả người dùng trên máy tính của bạn.</translation>
<translation id="5867815953973052697">Để sử dụng mật khẩu, dấu trang và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium. Dấu trang này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="7381168634819530324">Tăng tốc độ tải trang web bằng công cụ V8 của Phromium nhưng làm giảm khả năng chống lại các cuộc tấn công của Phromium. Chế độ cài đặt này đang bật.</translation>
<translation id="1509688792864707851">{count,plural, =1{Một số dữ liệu Phromium của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này (1 mục) sẽ bị xoá.}other{Một số dữ liệu Phromium của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này ({count}) sẽ bị xoá.}}</translation>
<translation id="4702638565169602649">Phromium đề xuất quét tệp này vì tệp này có thể nguy hiểm.</translation>
<translation id="6779406956731413166">ChromiumOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS" />phần mềm nguồn mở<ph name="END_LINK_CROS_OSS" /> bổ sung.</translation>
<translation id="6831043979455480757">Dịch</translation>
<translation id="1564864902402454287">Phromium cho bạn biết mật khẩu của bạn có bị đánh cắp hay không</translation>
<translation id="684888714667046800">Không kết nối được với Internet. Nếu bạn sử dụng tường lửa, vui lòng đảm bảo <ph name="PRODUCT_EXE_NAME" /> có trong danh sách cho phép.</translation>
<translation id="6200419390448865091">Phromium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Nhấn phím Tab để tiếp tục</translation>
<translation id="6862030660799253820">Sử dụng tính năng Tìm kiếm hình ảnh để tìm kiếm hình ảnh này</translation>
<translation id="6869568587896659271">Dễ dàng truy cập các trang web bên dưới thanh địa chỉ</translation>
<translation id="4011399428346318467">Phromium nhận thấy rằng "<ph name="EXTENSION_NAME" />" chứa phần mềm độc hại</translation>
<translation id="6877155553248388166">góc dưới cùng bên phải của khu vực tìm kiếm: <ph name="RIGHT" />% từ bên phải sang, <ph name="BOTTOM" />% từ dưới cùng lên</translation>
<translation id="6896758677409633944">Sao chép</translation>
<translation id="6898028264630240901">Bạn có thể ghim tính năng Tác vụ theo bối cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="1012681980425424211">Đặt Phromium làm trình duyệt mặc định và ghim Phromium vào thanh tác vụ</translation>
<translation id="1744625657438211994">&amp;Quản lý hồ sơ trên Phromium</translation>
<translation id="7264818828956697552">Hành động này sẽ:
          <ph name="LINE_BREAKS" />
            • Đặt lại trang khởi động, trang thẻ mới, công cụ tìm kiếm và các thẻ được ghim.
            <ph name="LINE_BREAK" />
            • Tắt tiện ích
            <ph name="LINE_BREAK" />
            • Xoá cookie và dữ liệu trang web tạm thời khác
            <ph name="LINE_BREAK" />
            • Đặt lại phím tắt Phromium
            <ph name="LINE_BREAKS" />
            Dấu trang, nhật ký và mật khẩu đã lưu sẽ không bị ảnh hưởng.</translation>
<translation id="6489000842445481390">Bạn đã đạt đến hạn mức <ph name="BOOKMARK_LIMIT" /> dấu trang của Phromium nên một số dấu trang chưa được lưu vào Tài khoản Google của bạn.

Bạn phải xoá bớt một số dấu trang thì mới có thể lưu dấu trang mới vào tài khoản. Nếu bạn đăng xuất ngay bây giờ, các dấu trang chưa lưu sẽ bị xoá.</translation>
<translation id="2645108248038996858">Mở đường liên kết trong cửa sổ ẩn danh của Phromium</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">Điều khoản của ChromiumOS</translation>
<translation id="2947519843530032104">Nhập cụm mật khẩu để sử dụng và lưu dữ liệu Phromium trong tài khoản <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="7011190694940573312">Cài đặt không thành công vì phiên bản hệ điều hành này không được hỗ trợ.</translation>
<translation id="7024536598735240744">Lỗi khi giải nén: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">Biến Phromium thành trình duyệt của riêng bạn</translation>
<translation id="7047386856539490735">Những kết quả này có hữu ích không?</translation>
<translation id="2448910402556368916">Cập nhật Phromium</translation>
<translation id="7834049737623892628">Phromium sẽ cố gắng mô tả cho bạn những hình ảnh không có nội dung mô tả hữu ích. Để tạo nội dung mô tả, các hình ảnh sẽ được gửi đến Google.</translation>
<translation id="1803168627715642217">Khai thác sức mạnh của AI khi bạn dùng ứng dụng Phromium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="3321731353906178474">Mang theo mật khẩu, thẻ và nhiều dữ liệu khác mọi lúc, mọi nơi nhờ ứng dụng Phromium trên điện thoại</translation>
<translation id="7141270731789036260">Tuỳ chỉnh Chrome for Testing</translation>
<translation id="8077731669779275332">Bạn có thể sử dụng Phromium mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác</translation>
<translation id="611798798247797100">Xoá <ph name="EXTENSION_NAME" /> khỏi Phromium</translation>
<translation id="7962394294883785044">Tổ chức của bạn sẽ xoá dữ liệu Phromium khi dữ liệu này không được dùng đến trong <ph name="TIMEOUT_DURATION" />. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.</translation>
<translation id="2611686760870033712">Phromium cần có quyền truy cập máy ảnh đối với trang web này</translation>
<translation id="71050417052775020">Không thể mở Phromium. Hãy thử lại.</translation>
<translation id="4817060241763895497">Hỏi bất cứ điều gì và từ bất cứ đâu với Gemini trong Phromium</translation>
<translation id="869358700049263961">Ghim Phromium vào thanh Dock để truy cập nhanh chóng bất kỳ lúc nào</translation>
<translation id="7094488679340739251">Dùng Phromium mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác</translation>
<translation id="7216228761061470870">Khi bạn sử dụng tính năng Tìm kiếm hình ảnh trên máy tính thì nội dung, URL và tiêu đề của trang, bao gồm cả tệp PDF, sẽ được gửi đến máy chủ</translation>
<translation id="7802634650401946711">Trình quản lý tác vụ - Phromium</translation>
<translation id="5182547787327636348">Hỏi về nội dung bên ngoài Phromium, chẳng hạn như các ứng dụng hoặc tệp khác</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể truy cập thông tin đã lưu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="5761733252154904648">Bắt đầu duyệt web ngay lập tức: Giờ đây, Phromium có thể khởi chạy khi Windows khởi động.</translation>
<translation id="7274695763216404502">Đã ghim! Sử dụng lại tính năng Tìm kiếm hình ảnh trên thanh công cụ</translation>
<translation id="7288567540154601580">Thẻ và tiện ích</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{Phromium khuyên bạn nên xoá tiện ích đó}other{Phromium khuyên bạn nên xoá các tiện ích đó}}</translation>
<translation id="1408728332407453335">Để chia sẻ âm thanh hệ thống, hãy mở phần Cài đặt hệ thống rồi bật chế độ "Chỉ ghi âm thanh hệ thống" cho Phromium. Sau đó, bạn cần khởi động lại Phromium.</translation>
<translation id="7299899569525778554">Tìm kiếm trên máy tính</translation>
<translation id="6194310460545162015">Đang cập nhật Phromium</translation>
<translation id="1098154893096691883">Tệp tùy chọn của bạn bị hỏng hoặc không hợp lệ.

Phromium không thể khôi phục cài đặt của bạn.</translation>
<translation id="7324051657739063017">Bạn có thể mở lại Thao tác theo ngữ cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="7024097830259741656">Web, dấu trang và các nội dung khác của bạn trên Phromium đều có ở đây.</translation>
<translation id="852511575759652041">Chỉ những người có cụm mật khẩu mới đọc được dữ liệu đã mã hoá của bạn. Cụm mật khẩu không được gửi tới Google hay được Google lưu trữ. Nếu quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, bạn sẽ cần <ph name="BEGIN_LINK" />xoá dữ liệu Phromium khỏi tài khoản của bạn<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505">Quản trị viên hệ thống đã định cấu hình Phromium để mở <ph name="ALTERNATIVE_BROWSER_NAME" /> khi truy cập vào <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Đã xảy ra lỗi</translation>
<translation id="7198690862684855451">Để nhận các bản cập nhật Phromium sau này, bạn cần có macOS 13 trở lên. Máy tính này đang sử dụng macOS 12.</translation>
<translation id="3224607549103501149">Gần đây bạn không truy cập trang web này. Phromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Mở cửa hàng Chrome trực tuyến</translation>
<translation id="8446269872172461565">Hiện Gemini trong Phromium trong khay hệ thống</translation>
<translation id="7401687852903179959">Tìm kiếm video này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="3403529853122418035">Phromium đang là trình duyệt mặc định của bạn</translation>
<translation id="5649377421626481711">Tiếp tục từ nơi bạn đã dừng lại: Phromium khôi phục các thẻ của bạn mỗi khi bạn khởi động lại. Để tắt tính năng này, hãy chuyển đến</translation>
<translation id="2467776530444676191">Nhập mật khẩu vào Phromium</translation>
<translation id="8814480293815136510">1. Nhấp vào <ph name="BUTTON_LABEL" /> bên dưới
2. Nhấp vào <ph name="BUTTON_2" /> trong phần cài đặt Windows
3. Nhấp vào <ph name="BUTTON_3" /> trong thông báo của Windows để ghim Phromium vào thanh tác vụ giúp truy cập nhanh</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - Phromium dành cho nhà phát triển</translation>
<translation id="7450541714075000668">Đã sao chép văn bản</translation>
<translation id="6826407056979820031">Để cho phép Phromium dùng micrô, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
<translation id="1392131731909663319">Để nhận các bản cập nhật Phromium sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 7.</translation>
<translation id="4512427777724578739">Chạy lại Phromium?</translation>
<translation id="4510527847350985067">Không thể cài đặt phiên bản Phromium giống với phiên bản hiện đang chạy. Hãy đóng Phromium và thử lại.</translation>
<translation id="7510190804000607802">Lời nhắc: Các tính năng tốt nhất của Google ngay trên điện thoại của bạn</translation>
<translation id="4735608937705010375">Các trang web có thể sẽ hoạt động như dự kiến. Khi đóng tất cả các cửa sổ Phromium, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản Google nếu bạn đã đăng nhập vào Phromium.</translation>
<translation id="7987051132742764178">{0,plural, =1{Phromium sẽ khởi động lại sau 1 phút}other{Phromium sẽ khởi động lại sau # phút}}</translation>
<translation id="1904271152425995672">Để bảo vệ dữ liệu của bạn, hãy cho phép Phromium loại bỏ quyền của các trang web mà gần đây bạn không truy cập.</translation>
<translation id="7909976731673595773">Tự động khởi chạy Phromium để bắt đầu duyệt web ngay lập tức.</translation>
<translation id="7583399374488819119">Trình cài đặt <ph name="COMPANY_NAME" /></translation>
<translation id="3301232962183130807">Phromium đang sử dụng máy ảnh và micrô của bạn.</translation>
<translation id="3230129417775002227">Phromium được cải tiến hơn</translation>
<translation id="1322165820810533683">Giờ đây, bạn có thể sử dụng nhiều tính năng hơn trong Phromium</translation>
<translation id="7624307931717240213">Chúng tôi sử dụng thông tin để cải thiện dịch vụ này. Vui lòng xem Chính sách quyền riêng tư và Điều khoản dịch vụ.</translation>
<translation id="7649070708921625228">Trợ giúp</translation>
<translation id="3795437289339745990">Tải ứng dụng Phromium</translation>
<translation id="7658239707568436148">Huỷ</translation>
<translation id="6671257169702988694">Phromium không phải là trình duyệt mặc định của bạn</translation>
<translation id="7270402397025248165">Đồng bộ hóa và cá nhân hóa Phromium trên các thiết bị của bạn</translation>
<translation id="6267574654655324634">Cập nhật Phromium</translation>
<translation id="4868190765388740513">Bảo mật công việc của bạn trên Phromium</translation>
<translation id="7716950018788545737">Nhiệm vụ đã kết thúc.</translation>
<translation id="77283119132245232">Cung cấp dịch vụ theo dõi hệ thống cho <ph name="BROWSER_NAME" />. Nếu dịch vụ này bị vô hiệu hoá thì dấu vết hiệu suất do trình duyệt tạo ra sẽ không bao gồm các sự kiện trên toàn hệ thống như chuyển đổi ngữ cảnh và sự kiện luồng ở trạng thái sẵn sàng.</translation>
<translation id="2680098142787722612">Thao tác này sẽ xóa dữ liệu duyệt web của bạn khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Phromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Trình cài đặt không thể tạo thư mục tạm thời. Vui lòng kiểm tra dung lượng ổ đĩa còn trống và quyền cài đặt phần mềm.</translation>
<translation id="6830826880333833598">Đặt lại về Phromium mặc định</translation>
<translation id="448710321315554838">Để bảo mật công việc của bạn trên Phromium, tổ chức bạn sẽ có thể xem hoặc quản lý một số thông tin khi bạn đăng nhập vào Phromium.</translation>
<translation id="7045209483723342691">Đặt Phromium làm trình duyệt mặc định và ghim vào thanh tác vụ</translation>
<translation id="6452735947982563207">Giúp Phromium hoạt động nhanh hơn</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - Phromium Canary</translation>
<translation id="6929858452581400763">Đảm bảo những người có quyền truy cập vào dữ liệu lưu lượng truy cập Internet của bạn khó biết được các trang web bạn truy cập hơn. Phromium dùng một kết nối bảo mật để tra cứu địa chỉ IP của mỗi trang web trong DNS (Hệ thống tên miền).</translation>
<translation id="7810005234485217901">Bạn có thể ghim tính năng Tìm kiếm hình ảnh để thuận tiện sử dụng</translation>
<translation id="4343392731007327660">Chọn nội dung bạn muốn chia sẻ với Phromium</translation>
<translation id="3052274192923256457">Thiết bị này đã có một hồ sơ trên Phromium sử dụng tài khoản này</translation>
<translation id="7845233973568007926">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại máy tính trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="5674414381037997114">Công cụ tìm kiếm của bạn đã bị thay đổi từ bên ngoài Phromium. Để bảo vệ bạn, Phromium đã đặt lại công cụ này về chế độ mặc định ban đầu. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Tuỳ chỉnh Phromium để có giao diện mới</translation>
<translation id="3966946337517395351">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, Phromium sẽ gửi nội dung bạn nhập đến công cụ tìm kiếm mặc định để đề xuất cho bạn cụm từ phù hợp hơn. Tính năng này bị tắt trong chế độ Ẩn danh.</translation>
<translation id="3928367799779122681">Phromium không thể cập nhật lên phiên bản mới nhất nên bạn đang bỏ lỡ các tính năng và bản vá bảo mật mới.</translation>
<translation id="7872446069773932638">Đang tải xuống... Còn <ph name="SECONDS" /> giây</translation>
<translation id="8492102592995742850">Nếu bạn quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, hãy <ph name="BEGIN_LINK" />xoá dữ liệu Phromium khỏi tài khoản của bạn<ph name="END_LINK" /></translation>
<translation id="959404544431817539">Nhanh chóng mở Gemini trong Phromium bất cứ khi nào bạn cần</translation>
<translation id="8889749279816358185">Đặt Phromium làm trình duyệt mặc định</translation>
<translation id="3173775358556080672">Phromium tự động nâng cấp các kết nối không an toàn lên HTTPS mỗi khi có thể</translation>
<translation id="2210801904933897209">Bạn đã đăng nhập vào Phromium là <ph name="USER_EMAIL_ADDRESS" />. Vui lòng sử dụng cùng tài khoản để đăng nhập lại.</translation>
<translation id="7291855477503010638"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể truy cập dấu trang và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="5706099517903615644">Đây là cài đặt thứ cấp của Phromium và không thể trở thành trình duyệt mặc định của bạn.</translation>
<translation id="2388440031754359882">Các tiện ích, ứng dụng và giao diện không rõ nguồn gốc có thể làm hại thiết bị của bạn. Phromium đề xuất bạn chỉ nền cài đặt những mục nói trên qua <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="8205108509545565485">Tận hưởng những tính năng tốt nhất của Google nhờ ứng dụng Phromium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="8004582292198964060">Trình duyệt</translation>
<translation id="8010081455002666927">Tự động phát hiện</translation>
<translation id="6421861275173778152">Sau khi Phromium có quyền truy cập, các trang web sẽ có thể yêu cầu bạn cấp quyền truy cập.</translation>
<translation id="942087293138739513">Ghim Phromium vào thanh tác vụ để truy cập nhanh bất cứ lúc nào</translation>
<translation id="80471789339884597">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại tất cả trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">Luôn hiện lối tắt Tìm kiếm hình ảnh</translation>
<translation id="8069447462453318634">Chọn "Ghim vào thanh công cụ"</translation>
<translation id="8519423983825025511">Tắt Phromium đối với các ứng dụng chạy trong nền</translation>
<translation id="80790299200510644">Tìm kiếm hình ảnh</translation>
<translation id="8086881907087796310">Cài đặt không thành công vì máy tính của bạn không đáp ứng được các yêu cầu tối thiểu về phần cứng.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="7988414336652558428">Phromium cần có quyền truy cập thông tin vị trí đối với trang web này</translation>
<translation id="1778610353097215460">Lần tới, khi mở Phromium trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc bật thông báo theo dõi giá.</translation>
<translation id="4182143801062869250">Nhận thông báo giảm giá cho những mặt hàng bạn quan tâm nhờ ứng dụng Phromium trên điện thoại</translation>
<translation id="8118331347066725040">Gửi ý kiến phản hồi về tính năng tìm kiếm bằng Ống kính</translation>
<translation id="849080025203861031">Biến Phromium thành trình duyệt của riêng bạn</translation>
<translation id="8133124826068723441">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn vì miền của bạn không dùng được tính năng Đồng bộ hoá.</translation>
<translation id="813913629614996137">Đang khởi chạy...</translation>
<translation id="139377652856781272">Mở Gemini trong Phromium bằng một phím tắt.</translation>
<translation id="8577594891153686998">Điều khoản dịch vụ bổ sung của Phromium</translation>
<translation id="6418547610462348357">Tệp này nguy hiểm, do đó Phromium đã chặn tệp.</translation>
<translation id="8177472873527554730">Không tìm thấy nội dung trong trang</translation>
<translation id="6257816439683677727">Nhập cụm mật khẩu để sử dụng và lưu dữ liệu Phromium trong tài khoản <ph name="USER_EMAIL" /> của bạn</translation>
<translation id="820759916613250543">Tìm kiếm hình ảnh này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8221491193165283816">Bạn thường chặn các thông báo. Để cho phép trang web này thông báo cho bạn, hãy nhấp vào đây.</translation>
<translation id="8672013454464753607">Để cho phép Phromium dùng camera, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
<translation id="8006746139865532235">Phromium không thể xác minh nguồn gốc của tiện ích này. Tiện ích này có thể không an toàn. Hãy xoá khỏi Phromium để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web mà bạn truy cập nữa.</translation>
<translation id="5474258904581730105">Phromium sẽ cố gắng mô tả cho bạn những hình ảnh không có nội dung mô tả hữu ích. Để tạo nội dung mô tả, các hình ảnh sẽ được gửi đến Google. Bạn có thể tắt dịch vụ này trong phần cài đặt bất kỳ lúc nào.</translation>
<translation id="5375524124600974413">Bạn muốn đăng nhập vào Phromium bằng hồ sơ mới?</translation>
<translation id="5242991719841602450"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Phromium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="6524280192518819368">Hiện Gemini trong Phromium trong khay hệ thống và bật phím tắt</translation>
<translation id="2082268001133511745"><ph name="BEGIN_LINK" />Phromium cảnh báo bạn<ph name="END_LINK" /> về các trang web và nội dung tải xuống không an toàn</translation>
<translation id="4030955203048827163">Gần đây bạn không truy cập trang web này. Phromium đã xoá <ph name="PERMISSION" />.</translation>
<translation id="8358344509940735943">Mua sắm, dịch văn bản và nhận dạng những thứ bạn thấy bằng camera trên ứng dụng Phromium dành cho iOS</translation>
<translation id="7062802333437169650">Mã QR để đăng nhập vào Phromium bằng <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Lỗi khi khởi động: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062">Tổ chức của bạn sẽ đóng Phromium khi Phromium không được dùng đến trong <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">Lưu dưới dạng hình ảnh</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" /> trước đó đã sử dụng Phromium</translation>
<translation id="5445795756751365814">Bật tính năng Kỹ năng trong Phromium</translation>
<translation id="7329745364783464770">Cập nhật Phromium để tiếp tục sử dụng dữ liệu Phromium trong Tài khoản Google <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="5255856786869089460">Để nhận các bản cập nhật Phromium sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 8.</translation>
<translation id="8362914115861174987">Dịch sang</translation>
<translation id="8367705492654390392">Đặt câu hỏi bất kỳ</translation>
<translation id="8370517070665726704">Bản quyền <ph name="YEAR" /> Google LLC. Mọi quyền được bảo lưu.</translation>
<translation id="7349410893766975486">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Phromium. Mật khẩu này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="394196307309768356">Sau đó, bạn cần khởi động lại Phromium.</translation>
<translation id="7466825726005300631">Phromium khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" /></translation>
<translation id="264088846642173954">Tiện ích này đã bị nhà phát triển huỷ phát hành và có thể không an toàn. Hãy xoá khỏi Phromium để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="1867604241588004166">Phromium cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất bây giờ, dữ liệu này sẽ bị xoá.</translation>
<translation id="926481158288852551">{0,plural, =1{Khởi động lại Phromium trong vòng một ngày}other{Khởi động lại Phromium trong vòng # ngày}}</translation>
<translation id="8438543370129609977">Khi bạn sử dụng tính năng Tìm kiếm hình ảnh thì nội dung, URL và tiêu đề của trang, bao gồm cả tệp PDF, sẽ được gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">Tìm hiểu thêm về cách tìm kiếm bằng tính năng Tìm kiếm hình ảnh trong Phromium</translation>
<translation id="1069576136282928177">Tệp lưu trữ trình cài đặt bị hỏng hoặc không hợp lệ. Hãy tải xuống Phromium lại lần nữa.</translation>
<translation id="7082388216101480391">Phromium yêu cầu Windows 10 trở lên.</translation>
<translation id="8463672209299734063">Không bắt buộc: Giúp cải thiện hiệu suất và các tính năng của ChromiumOS bằng cách tự động gửi dữ liệu sử dụng và chẩn đoán cho Google.</translation>
<translation id="4343027289807602417">Để sử dụng và lưu dữ liệu Phromium trong Tài khoản Google, hãy xác minh danh tính của bạn</translation>
<translation id="6746404578800969443">Hiện lời nhắc đăng nhập vào Phromium</translation>
<translation id="5072642661707587697">Phromium đã lỗi thời</translation>
<translation id="759684005114911774">Cảm ơn bạn đã chọn Phromium làm trình duyệt mặc định!</translation>
<translation id="5209258538041302334">Phromium có thể kiểm tra mật khẩu của bạn khi bạn lưu các mật khẩu đó</translation>
<translation id="8525579356836940628">Đã dừng cài đặt</translation>
<translation id="6348113608284833604">Mang theo mật khẩu, thẻ và nhiều dữ liệu khác mọi lúc, mọi nơi nhờ ứng dụng Phromium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="5083347044281842800">Nhận cảnh báo nếu Phromium phát hiện một trong những mật khẩu của bạn bị lộ trong sự cố rò rỉ dữ liệu công khai</translation>
<translation id="8555465886620020932">Lỗi dịch vụ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">Một số tính năng và tiện ích của Phromium đi kèm lối tắt. Bạn có thể chọn bật lại các lối tắt này.</translation>
<translation id="8556420416730706394">Bạn có thể ghim tính năng Tìm kiếm hình ảnh để thuận tiện sử dụng; hãy nhấp vào nút Ghim ở đầu bảng điều khiển bên</translation>
<translation id="856656450041460113">Tìm kiếm trong danh sách ngôn ngữ</translation>
<translation id="9159785833243360958">Nhiều tổ chức quản lý Phromium</translation>
<translation id="8586442755830160949">Bản quyền <ph name="YEAR" /> Tác giả Chromium. Mọi quyền được bảo lưu.</translation>
<translation id="3489957831482527036">Đang khởi động Phromium...</translation>
<translation id="8624541899164515475">Trang Cài đặt, mở trong thẻ mới.</translation>
<translation id="8648201657708811153">Bạn không thể đặt Google Chrome for Testing làm trình duyệt mặc định.</translation>
<translation id="7150069986792019616">Tìm kiếm bằng Phromium ở bất cứ đâu</translation>
<translation id="1623850835554120265">Tiện ích này cũng điều khiển trang nào được hiển thị khi bạn khởi động Phromium hoặc tìm kiếm từ Thanh địa chỉ.</translation>
<translation id="8828478112210313529">Để gửi thẻ này tới một thiết bị khác, hãy đăng nhập vào Phromium trên thiết bị đó</translation>
<translation id="3592747099485557650">Đây là Phromium của bạn</translation>
<translation id="8712637175834984815">Tôi hiểu</translation>
<translation id="3388228047978619624">Bạn muốn đăng nhập vào Phromium?</translation>
<translation id="8747073452963259673">góc dưới cùng bên trái của khu vực tìm kiếm: <ph name="LEFT" />% từ bên trái sang, <ph name="BOTTOM" />% từ dưới cùng lên</translation>
<translation id="878572486461146056">Lỗi cài đặt: Quản trị viên mạng của bạn đã áp dụng Chính sách nhóm ngăn chặn hoạt động cài đặt: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Nhắc tôi sau</translation>
<translation id="614494151403742465">Chia sẻ tài liệu này với Gemini trong Phromium để xem thông tin tổng quan nhanh và đặt các câu hỏi nối tiếp</translation>
<translation id="6346068443590018348">Bạn muốn đăng nhập vào Phromium?</translation>
<translation id="1468806565762231794">Đặt Phromium làm trình duyệt mặc định và ghim vào thanh tác vụ</translation>
<translation id="8826492472752484139">Nhấp vào "Trình quản lý mật khẩu"</translation>
<translation id="8833697763442816810">Hệ thống ChromiumOS</translation>
<translation id="4854784568701005121">Ngôn ngữ này dùng để hiển thị trình đơn, chế độ cài đặt, cảnh báo và các nội dung khác trong Phromium</translation>
<translation id="8862326446509486874">Bạn không có quyền thích hợp để cài đặt cấp hệ thống. Thử chạy lại trình cài đặt với vai trò Quản trị viên.</translation>
<translation id="7804139416589625033">Thêm Hồ sơ Phromium</translation>
<translation id="6333867241557949259">ChromiumOS không thể lưu dữ liệu Phromium vào Tài khoản Google của bạn do xảy ra lỗi khi đăng nhập</translation>
<translation id="2888440364511152939">Tổ chức của bạn yêu cầu bạn đăng nhập vào Phromium</translation>
<translation id="7111325571010992010">Phromium đang cố gắng hiển thị mật khẩu. Nhập mật khẩu Windows của bạn để cho phép thực hiện việc này.</translation>
<translation id="4406716425954955281">Phromium không còn là trình duyệt mặc định của bạn. Đặt Phromium làm trình duyệt mặc định?</translation>
<translation id="2999847959360823770">Không thể cập nhật Phromium</translation>
<translation id="8944232836376404813">Hành động này sẽ:
          <ph name="LINE_BREAKS" />
            • Đặt lại trang khởi động, trang thẻ mới, công cụ tìm kiếm và các thẻ được ghim
            <ph name="LINE_BREAK" />
            • Tắt tiện ích
            <ph name="LINE_BREAK" />
            • Xoá cookie và dữ liệu trang web tạm thời khác
            <ph name="LINE_BREAKS" />
            Dấu trang, nhật ký và mật khẩu đã lưu sẽ không bị ảnh hưởng.</translation>
<translation id="7461167469691640632">Hiện lối tắt đến các trang web trên Phromium</translation>
<translation id="7394133813796947510">Biểu tượng Phromium Enterprise</translation>
<translation id="2476839923452631964">Mang theo các tính năng an toàn của Google mọi lúc, mọi nơi nhờ ứng dụng Phromium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="2041306781031361744">Không thể khởi động Phromium vì đã xảy ra lỗi khi mở hồ sơ của bạn. Hãy thử khởi động lại Phromium.</translation>
<translation id="8355079108092011401">để tìm kiếm bằng Phromium hoặc tuỳ chỉnh trong phần <ph name="BEGIN_LINK" />Cài đặt<ph name="END_LINK" /></translation>
<translation id="820370893610994443">Quản lý hồ sơ trên Phromium</translation>
<translation id="1885039203623228439">Dùng bàn phím để di chuyển giữa Gemini trong Phromium và thẻ đang mở.</translation>
<translation id="9018218886431812662">Đã cài đặt xong</translation>
<translation id="8213523024005590363">Để làm cho Phromium an toàn hơn, chúng tôi đã vô hiệu hóa tiện ích không được liệt kê trong <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> và có thể đã được thêm mà bạn không biết.</translation>
<translation id="1376667286722804744">Đăng nhập vào Phromium</translation>
<translation id="5142314855184111999">Hiện tính năng tìm kiếm bằng Phromium trên thanh trình đơn của máy Mac và bật phím tắt</translation>
<translation id="5166485487967090892">Phromium đã chặn tệp tải xuống này vì tệp lưu trữ gồm các tệp khác có thể ẩn chứa phần mềm độc hại</translation>
<translation id="1902493242619542969">Mật khẩu, dấu trang và nhật ký của bạn sẽ được đồng bộ hoá liền mạch trên mọi thiết bị. Hãy cập nhật trình duyệt mặc định thành Phromium để dễ dàng sử dụng các tính năng bạn quen thuộc và yêu thích. Phromium sẽ được ghim vào thanh tác vụ để bạn có thể truy cập nhanh chóng.</translation>
<translation id="7092992855996941035">Sử dụng các công cụ AI tốt nhất của Google nhờ ứng dụng Phromium trên điện thoại</translation>
<translation id="4203475068093609811">Để sử dụng mật khẩu và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Phromium</translation>
<translation id="7699507532215026981">Đăng nhập vào Phromium khi bạn đăng nhập vào các dịch vụ khác của Google</translation>
<translation id="5571207595456818809">Phromium đã tự động đóng</translation>
<translation id="3670200098293484473">Phromium đã lỗi thời</translation>
<translation id="5636382052119887392">{0,plural, =1{Phromium sẽ khởi động lại sau một giờ}other{Phromium sẽ khởi động lại sau # giờ}}</translation>
<translation id="9106236359747881194">Chọn văn bản bạn muốn tìm</translation>
<translation id="9197093250229894135">Để nhận các bản cập nhật Phromium sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 8.1.</translation>
<translation id="7195134700293253698">Mở đường liên kết trong thẻ mới của Phromium</translation>
<translation id="911206726377975832">Bạn cũng muốn xóa dữ liệu duyệt web của mình?</translation>
<translation id="9134482777260927479">Trợ giúp làm bài tập về nhà</translation>
<translation id="9148058034647219655">Thoát</translation>
<translation id="8888942844777295083">Tiếp tục từ nơi bạn đã dừng lại: Phromium có thể khôi phục các thẻ của bạn mỗi khi bạn khởi động lại. Để bật tính năng này, hãy chuyển đến</translation>
<translation id="1485079858205975514">Quản trị viên hệ thống của bạn đã định cấu hình Phromium để mở một trình duyệt thay thế khi truy cập vào <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="1096075777207775410">Chạy lại để cập nhật &amp;Phromium</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">Biến Phromium thành trình duyệt của riêng bạn</translation>
<translation id="6554170182570636227">Phromium có thể không hoạt động chính xác do không được hỗ trợ trên Windows XP hoặc Windows Vista nữa</translation>
<translation id="8145475184469284022">Tận hưởng các tính năng an toàn tốt nhất của Google mọi lúc, mọi nơi nhờ Phromium.</translation>
<translation id="945522503751344254">Gửi phản hồi</translation>
<translation id="1258071069834143371">Ai đang sử dụng Phromium?</translation>
<translation id="8272911737374467274">Có được chế độ bảo mật mạnh nhất của Phromium</translation>
<translation id="983803489796659991">Không cài đặt được do máy chủ cập nhật không có dữ liệu băm nào cho ứng dụng.</translation>
<translation id="4087190600867587768">Dùng Phromium mà không cần tài khoản</translation>
<translation id="985602178874221306">Tác giả Chromium</translation>
<translation id="989970834842471429">Chọn văn bản hoặc hình ảnh bất kỳ mà bạn muốn tìm kiếm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="6649431194696226496">Để cho phép Phromium dùng thông tin vị trí, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
</translationbundle>