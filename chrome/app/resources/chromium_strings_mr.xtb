<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mr">
<translation id="1026101648481255140">इंस्टॉलेशन पुन्‍हा सुरू करा</translation>
<translation id="1029669172902658969">&amp;ChromiumOS अपडेट करण्यासाठी पुन्हा लाँच करा</translation>
<translation id="7962340570690354348">Phromium हे तुम्हाला या एक्स्टेंशनचे पुनरावलोकन करण्याची शिफारस करते</translation>
<translation id="2702007788032964762">साइटने त्यांच्या पेजवरील लिंक खाजगीरीत्या प्रीलोड करण्यास सांगितल्यास, Phromium हे Google सर्व्हर वापरते. हे प्रीलोड केलेल्या साइटपासून तुमची ओळख लपवते, पण कोणत्या साइट प्रीलोड केल्या जातात हे Google ला समजते.</translation>
<translation id="1051793555070215510">हे १ मिनिटाचे सर्वेक्षण पूर्ण करून आम्हाला गुप्त मोड मध्ये सुधारणा करण्यात मदत करा.</translation>
<translation id="1065672644894730302">तुमची प्राधान्ये वाचता आली नाहीत.
काही वैशिष्‍ट्ये अनुपलब्ध असू शकतात आणि प्राधान्यांमधील बदल सेव्ह केले जाणार नाहीत.</translation>
<translation id="4964836565882496625">तुमच्या पालकांनी Phromium साठी "साइट, अ‍ॅप्स आणि एक्स्टेंशनकरिता परवानग्या" बंद केल्या आहेत</translation>
<translation id="8409497136174302488">जवळपासची डिव्हाइस शोधण्यासाठी आणि वापरण्यासाठी Phromium ला तुमच्या स्थानिक नेटवर्कचा अ‍ॅक्सेस आवश्यक आहे</translation>
<translation id="4388904545107211948">विशिष्ट Phromium वैशिष्ट्य किंवा एक्स्टेंशन शोधण्यासाठी, त्याचा शॉर्टकट आणि त्यानंतर तुम्ही निवडलेली कीबोर्ड की अ‍ॅड्रेस बारमध्ये टाइप करा</translation>
<translation id="7188624550427159072">सिस्टीम ट्रेमध्ये Phromium वापरून शोध दाखवा आणि कीबोर्ड शॉर्टकट सुरू करा</translation>
<translation id="3689248207461565136">Phromium ला तुमचे पासवर्ड निर्यात करायचे आहेत. हे करू देण्यासाठी तुमचा Windows पासवर्ड टाइप करा.</translation>
<translation id="112640046208448578">गोष्टी किंवा ठिकाणे ओळखा आणि मजकूर कॉपी अथवा भाषांतरित करा. तुम्ही इमेज शोध वापरता, तेव्हा पेजचा स्क्रीनशॉट सर्व्हरला पाठवला जातो. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium तुमचा डीफॉल्ट ब्राउझर आहे</translation>
<translation id="5414044255592121327">तुमचे पासवर्ड डेटा भंग आणि इतर सुरक्षा समस्यांपासून सुरक्षित आहेत हे तपासण्यासाठी, <ph name="BEGIN_LINK" />Phromium मध्ये साइन इन करा<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Phromium मेनूवर क्लिक करा</translation>
<translation id="1157985233335035034">अलीकडील भाषा</translation>
<translation id="1184145431117212167">तुमच्या Windows च्या आवृत्तीला सपोर्ट नसल्यामुळे इंस्टॉलेशन करता आले नाही.</translation>
<translation id="7861581212703831457">Phromium बद्दल</translation>
<translation id="8752630985505435738">तुमच्या फोनवर Phromium सह किमतीचा माग ठेवण्याशी संबंधित अलर्ट मिळवा</translation>
<translation id="1203500561924088507">इंस्टॉल केल्याबद्दल धन्यवाद. तुम्ही <ph name="BUNDLE_NAME" /> वापरण्यापूर्वी तुमचा ब्राउझर रीस्टार्ट करणे आवश्यक आहे.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> प्रलंबित आहे. तुमचे ब्राउझिंग सुरक्षित ठेवण्यासाठी, तुम्ही पुढील वेळी <ph name="IDLE_DURATION" /> साठी इनॅक्टिव्ह असाल, तेव्हा Phromium अपडेट होईल.</translation>
<translation id="1232234696885483911">तुम्ही इमेज शोध उघडता, तेव्हा PDFs सह पेजचे शीर्षक, URL आणि आशय आपोआप सर्व्हरला पाठवला जाईल. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">तुम्ही साइन इन केलेले असताना, Phromium मध्ये तुमच्या Google खाते मधून तुमचे पासवर्ड आणि आणखी बऱ्याच गोष्टी वापरू शकता. हे बदलण्यासाठी, “Phromium मधील तुमचे खाते” वर जा.</translation>
<translation id="7402478829083317456">Mac मेनू बारमधील Phromium मधील Gemini दाखवा</translation>
<translation id="4902531791098430822">Phromium मधील Gemini मध्ये स्क्रीनचा भाग निवडण्यासाठी, कीबोर्ड शॉर्टकट वापरा.</translation>
<translation id="9002284132405311162">हा टॅब इनॅक्टिव्ह असताना, Phromium ला जलद ठेवण्यासाठी मेमरी मोकळी करण्यात आली होती. ही साइट इनॅक्टिव्ह राहण्यापासून नेहमी वगळली जावी असे तुम्ही निवडू शकता.</translation>
<translation id="5561666811965903444">फाइल धोकादायक असल्याने Phromium ने हे डाउनलोड ब्लॉक केले आहे</translation>
<translation id="1340271056805240721"><ph name="USER_EMAIL" /> वापरून Gmail किंवा YouTube सारख्या Google सेवांमध्ये साइन इन करताना, तुम्ही तेच खाते वापरून Phromium मध्ये आपोआप साइन इन करू शकता</translation>
<translation id="5048805453292757697">तुमच्या फोनवर Phromium मिळवा</translation>
<translation id="1290883685122687410">सेटअप एरर: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">तुमची नवीन Phromium प्रोफाइल सेट करा</translation>
<translation id="7871721155662336863">Phromium मधील Gemini वापरून पहा</translation>
<translation id="6569288432960798043">ब्लूटूथ डिव्हाइस एक्सप्लोर करण्यासाठी Phromium ला
 ब्लूटूथ चा ॲक्सेस हवा आहे. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">तुमच्या फोनवर Phromium मध्ये साइन इन करा</translation>
<translation id="1330562121671411446">भाषा डिटेक्ट करा</translation>
<translation id="1619655755195586133">तसेच Phromium मधून डेटा हटवा (<ph name="URL" />)</translation>
<translation id="1345251407431278948">पिन केले आहे! तुम्ही टूलबारवरील नवीन बटण वापरून इमेज शोध पुन्हा अ‍ॅक्सेस करू शकता</translation>
<translation id="1383876407941801731">शोधा</translation>
<translation id="2947996037737257951">फिरतीवर असताना ब्राउझ करणे सुरू ठेवण्यासाठी Phromium अ‍ॅप वापरा</translation>
<translation id="141901961143729572">तुमचे विचार शेअर करा</translation>
<translation id="8355386219605656974">तुमची विंडो शेअर करण्यासाठी, सिस्टीम सेटिंग्ज मध्ये Phromium साठी स्क्रीन रेकॉर्डिंगला अनुमती द्या.</translation>
<translation id="1478370723027452770">Chrome for Testing शी संबंधित मदत मिळवा</translation>
<translation id="8398257182826094665"><ph name="DEVICE" /> वरून तुमची सेव्ह केलेली माहिती आणि आणखी बरेच काही मिळवण्यासाठी, Phromium मध्ये साइन इन करा</translation>
<translation id="1497802159252041924">इंस्टॉलसंबंधित एरर: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">हे पेज सुरक्षित आहे</translation>
<translation id="3484755999946650557">Phromium टॅब शेअर करा</translation>
<translation id="3309377459597801353">Phromium मध्ये साइन इन करा</translation>
<translation id="1547469039832541117">हायलाइट केलेली टास्क संपवते.</translation>
<translation id="2354363290397602683">Phromium पिन करा</translation>
<translation id="2244728813494358888">Phromium ची सुरक्षितता टूल</translation>
<translation id="707582364915018531">Phromium ला तुमचा Password Manager डेटा हटवायचा आहे. याला अनुमती देण्यासाठी तुमचा Windows पासवर्ड टाइप करा.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{अपडेट लागू करता यावे यासाठी तुम्ही Phromium पुन्हा लाँच करण्याची तुमच्या ॲडमिनिस्ट्रेटरला गरज आहे}=1{अपडेट लागू करता यावे यासाठी तुम्ही Phromium पुन्हा लाँच करण्याची तुमच्या ॲडमिनिस्ट्रेटरला गरज आहे. तुमची गुप्त विंडो पुन्हा उघडणार नाही.}other{अपडेट लागू करता यावे यासाठी तुम्ही Phromium पुन्हा लाँच करण्याची तुमच्या ॲडमिनिस्ट्रेटरला गरज आहे. तुमच्या # गुप्त विंडो पुन्हा उघडणार नाहीत.}}</translation>
<translation id="5032531544901236587">तुमच्या फोनवरील Phromium अ‍ॅपसह Google चा सर्वोत्तम अनुभव मिळवा</translation>
<translation id="7311082384439462587">Phromium मधील महत्त्वाच्या गोपनीयता आणि सुरक्षा नियंत्रणांचे पुनरावलोकन करा</translation>
<translation id="1640672724030957280">डाऊनलोड करीत आहे...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, सदस्यत्व म्हणून साइन इन केले आहे. खाते मेनू उघडा</translation>
<translation id="4535436467771816034">तुम्ही मेसेज, दस्तऐवज आणि इतर अ‍ॅप्स यांमधील लिंकवर कधीही क्लिक कराल, तेव्हा Phromium वापरू शकता. ते तुमच्या टास्कबारवरदेखील पिन केले जाईल.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> साठी वाढीव विशेषाधिकार देते.</translation>
<translation id="1722488837206509557">यामुळे तुम्हाला उपलब्ध डिव्हाइसमधून निवडता येईल आणि आशय दाखवता येईल.</translation>
<translation id="3550860956769006392">Phromium लवकरच ब्राउझिंग डेटा हटवेल</translation>
<translation id="2053384509423635834">Phromium हे नेव्हिगेशन HTTPS वर अपग्रेड करण्याचा प्रयत्न करेल</translation>
<translation id="2516115567501600458">Phromium डेटा साफ करण्यात आला</translation>
<translation id="8571959122390670188"><ph name="REMAINING_TIME" /> मध्ये Phromium रीस्टार्ट होईल</translation>
<translation id="6284080675125981628">HTTPS उपलब्ध नसल्यास, Phromium तुम्हाला चेतावणी न देता असुरक्षित कनेक्शन वापरेल</translation>
<translation id="5872244334553252095">Phromium बॅकग्राउंडमध्ये सुरू द्या</translation>
<translation id="2213761221916953829">Phromium अधिक सुरक्षित बनविण्‍यासाठी, आम्‍ही <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> मध्‍ये सूचीबद्ध नसलेले आणि आपल्‍या माहिती शिवाय कदाचित जोडले गेलेले काही विस्‍तार अक्षम केले.</translation>
<translation id="8807881428325438878">झटपट अ‍ॅक्सेस करण्याकरिता Chrome तुमच्या टास्कबारवर पिन करण्यासाठी Windows नोटिफिकेशनमध्ये <ph name="BEGIN_BOLD" />होय<ph name="END_BOLD" /> वर क्लिक करा.</translation>
<translation id="6861833596843600606">Phromium पुनर्स्थापित करा</translation>
<translation id="3950056404221550225">Phromium <ph name="AUTHENTICATION_PURPOSE" /> याचा प्रयत्न करत आहे</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> यांनी आधीच साइन इन केले आहे. तुमचे ब्राउझिंग स्वतंत्र ठेवण्यासाठी, तुमच्या स्वतःच्या प्रोफाइलमधील Phromium मध्ये <ph name="USER_EMAIL_ADDRESS" /> म्हणून साइन इन करा. तुम्हाला <ph name="DEVICE" /> कडून तुमची एक्स्टेंशन आणि आणखी बऱ्याच गोष्टीदेखील मिळतील.</translation>
<translation id="6114726049187747242">तुम्ही पुढील वेळी तुमच्या <ph name="DEVICE_TYPE" /> वर Phromium उघडल्यावर, तुम्हाला Google Password Manager वापरण्यासाठी प्रॉम्प्ट दिसेल.</translation>
<translation id="1838374766361614909">शोध साफ करा</translation>
<translation id="2724678689951174927">तुमच्या Google खाते मध्ये ब्राउझिंग डेटा राखून ठेवून, तो फक्त या डिव्हाइसवरून हटवण्यासाठी, <ph name="BEGIN_LINK" />Phromium मधून साइन आउट करणे<ph name="END_LINK" /> हे करा.</translation>
<translation id="402854649782215414">फिरतीवर असताना नवीन टॅब गट उघडण्यासाठी किंवा तयार करण्यासाठी तुमच्या फोनवर Phromium डाउनलोड करा.</translation>
<translation id="3191814926523151519">तुम्ही तुमची साइन इन केलेली Google खाती व्यवस्थापित करू शकता. तुमची Google खाती Phromium ब्राउझर, Play Store, Gmail आणि बर्‍याच गोष्टींसाठी वापरली जातात. तुम्हाला कुटुंब सदस्यासारख्या इतर कोणासाठी खाते जोडायचे असल्यास, त्याऐवजी तुमच्या <ph name="DEVICE_TYPE" /> वर नवीन व्यक्ती जोडा. <ph name="LINK_BEGIN" />अधिक जाणून घ्या<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">इमेज शोध वापरून शोधा</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> यांनी आधीच साइन इन केले आहे. तुमचे ब्राउझिंग स्वतंत्र ठेवण्यासाठी, तुमच्या स्वतःच्या प्रोफाइलमधील Phromium मध्ये <ph name="USER_EMAIL_ADDRESS" /> म्हणून साइन इन करा. तुम्हाला <ph name="DEVICE" /> कडून तुमचे बुकमार्क आणि आणखी बऱ्याच गोष्टीदेखील मिळतील.</translation>
<translation id="1880677175115548835">मजकूर निवडा</translation>
<translation id="1236934630660512644">तुम्ही एका व्यवस्थापित खात्यासह साइन इन करत आहात आणि तुमच्या Phromium प्रोफाइलवर त्याच्या ॲडमिनिस्ट्रेटरला नियंत्रण देत आहात. तुमचा Phromium डेटा, जसे की तुमचे अ‍ॅप्स, बुकमार्क, इतिहास, पासवर्ड आणि अन्य सेटिंग्ज <ph name="USER_NAME" /> वर कायमच्या बद्ध होतील. तुम्ही Google खाती डॅशबोर्डद्वारे हा डेटा हटवण्यात सक्षम व्हाल, परंतु तुम्ही दुसर्‍या खात्यासह हा डेटा संबद्ध करण्यात सक्षम असणार नाही. तुम्ही तुमचा विद्यमान Phromium डेटा वेगळी ठेवण्यासाठी एक नवीन पर्यायी प्रोफाइल तयार करू शकता. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium हे स्मूथ स्क्रोलिंग आणि व्हिडिओ फ्रेम रेटसारखी बॅकग्राउंड अ‍ॅक्टिव्हिटी व व्हिज्युअल इफेक्ट मर्यादित करून बॅटरी पॉवरची बचत करते. <ph name="BEGIN_LINK" />एनर्जी सेव्हर बद्दल अधिक जाणून घ्या<ph name="END_LINK" /></translation>
