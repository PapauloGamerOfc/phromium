<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="1026101648481255140">Atsākt instalēšanu</translation>
<translation id="1029669172902658969">Atkārtoti palaist, lai atjauninātu &amp;Chromium OS</translation>
<translation id="7962340570690354348">Phromium komanda iesaka pārskatīt šo paplašinājumu.</translation>
<translation id="2702007788032964762">Kad vietnē tiek piedāvāts privāti iepriekš ielādēt saites lapā, pārlūks Phromium izmanto Google serverus. Tādējādi jūsu identitāte tiek slēpta no iepriekš ielādētās lapas īpašniekiem, taču Google uzzina, kādas lapas tiek iepriekš ielādētas.</translation>
<translation id="1051793555070215510">Palīdziet mums uzlabot pārlūkošanu inkognito režīmā, aizpildot šo vienas minūtes aptauju.</translation>
<translation id="1065672644894730302">Jūsu preferences nevar nolasīt. Dažas funkcijas var nebūt pieejamas, un preferenču izmaiņas netiks saglabātas</translation>
<translation id="4964836565882496625">Viens no jūsu vecākiem ir izslēdzis iestatījumu “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam Phromium.</translation>
<translation id="8409497136174302488">Pārlūkam Phromium ir nepieciešama piekļuve jūsu lokālajam tīklam, lai atrastu un izmantotu tuvumā esošās ierīces.</translation>
<translation id="4388904545107211948">Lai meklētu konkrētu Phromium funkciju vai paplašinājumu, adreses joslā ievadiet tā saīsni un pēc tam nospiediet izvēlēto īsinājumtaustiņu</translation>
<translation id="7188624550427159072">Rādīt meklēšanu pārlūkā Phromium sistēmas teknē un ieslēgt īsinājumtaustiņu</translation>
<translation id="3689248207461565136">Pārlūkā Phromium tiek mēģināts eksportēt jūsu paroles. Lai to atļautu, ievadiet savu Windows paroli.</translation>
<translation id="112640046208448578">Varat identificēt priekšmetus vai vietas un kopēt vai tulkot tekstu. Kad izmantojat funkciju Attēlu meklēšana, uz serveri tiek nosūtīts lapas ekrānuzņēmums. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Jūsu noklusējuma pārlūks ir Phromium.</translation>
<translation id="5414044255592121327">Lai pārbaudītu, vai jūsu paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Noklikšķiniet uz Phromium izvēlnes</translation>
<translation id="1157985233335035034">Nesen izmantotās valodas</translation>
<translation id="1184145431117212167">Instalēšana neizdevās, jo jūsu izmantotā Windows versija netiek atbalstīta.</translation>
<translation id="7861581212703831457">Par Phromium</translation>
<translation id="8752630985505435738">Brīdinājumu saņemšana par cenu izsekošanu, izmantojot pārlūku Phromium savā tālrunī</translation>
<translation id="1203500561924088507">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē pārlūkprogramma.</translation>
<translation id="4933432676089063712">Tiek gaidīts <ph name="IMPORTANT_UPDATE" />. Lai gādātu par drošu pārlūkošanu, pārlūks Phromium tiks atjaunināts, kad nākamreiz būsiet neaktīvs vismaz <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">Kad atvērsiet attēlu meklēšanu, serverim tiks automātiski nosūtīts lapas nosaukums, vietrādis URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">Kamēr esat pierakstījies, pārlūkā Phromium varat izmantot savas paroles un citu saturu no Google konta. Lai to mainītu, pārejiet uz sadaļu “Jūsu konts pārlūkā Phromium”.</translation>
<translation id="7402478829083317456">Rādīt Gemini pārlūkā Phromium Mac izvēļņu joslā</translation>
<translation id="4902531791098430822">Lai pakalpojumā Gemini pārlūkā Phromium atlasītu ekrāna daļu, izmantojiet īsinājumtaustiņu.</translation>
<translation id="9002284132405311162">Kamēr šī cilne bija neaktīva, tika atbrīvota atmiņa pārlūka Phromium ātrākai darbībai. Varat izvēlēties vienmēr saglabāt šo vietni aktīvu.</translation>
<translation id="5561666811965903444">Pārlūkā Phromium šī lejupielāde tika bloķēta, jo fails ir bīstams.</translation>
<translation id="1340271056805240721">Ja pierakstāties Google pakalpojumos, piemēram, Gmail vai YouTube, ar kontu <ph name="USER_EMAIL" />, varat automātiski pierakstīties pārlūkā Phromium ar to pašu kontu.</translation>
<translation id="5048805453292757697">Iegūstiet pārlūku Phromium savā tālrunī</translation>
<translation id="1290883685122687410">Iestatīšanas kļūda: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">Jaunā Phromium profila iestatīšana</translation>
<translation id="7871721155662336863">Izmēģināt, izmantojot Gemini pārlūkā Phromium</translation>
<translation id="6569288432960798043">Pārlūkam Phromium ir nepieciešama Bluetooth piekļuve, lai atrastu Bluetooth ierīces. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">Pierakstieties pārlūkā Phromium savā tālrunī</translation>
<translation id="1330562121671411446">Valodas noteikšana</translation>
<translation id="1619655755195586133">Dzēst arī datus no pārlūka Phromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana, izmantojot jauno pogu rīkjoslā.</translation>
<translation id="1383876407941801731">Meklēt</translation>
<translation id="2947996037737257951">Izmantojiet lietotni Phromium, lai turpinātu pārlūkošanu, atrodoties ceļā</translation>
<translation id="141901961143729572">Dalieties domās!</translation>
<translation id="8355386219605656974">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Phromium.</translation>
<translation id="1478370723027452770">Saņemt palīdzību saistībā ar Chrome for Testing</translation>
<translation id="8398257182826094665">Lai piekļūtu saglabātajai informācijai un citiem datiem no ierīces <ph name="DEVICE" />, pierakstieties pārlūkā Phromium.</translation>
<translation id="1497802159252041924">Instalēšanas kļūda: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Šī lapa ir aizsargāta</translation>
<translation id="3484755999946650557">Phromium cilnes kopīgošana</translation>
<translation id="3309377459597801353">Pierakstīties pārlūkā Phromium</translation>
<translation id="1547469039832541117">Tiek pabeigts atzīmētais uzdevums.</translation>
<translation id="2354363290397602683">Piespraust pārlūku Phromium</translation>
<translation id="2244728813494358888">Phromium drošības rīki</translation>
<translation id="707582364915018531">Phromium pieprasa dzēst jūsu paroļu pārvaldnieka datus. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Phromium.}=1{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Phromium. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Phromium. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Phromium. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Phromium. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="5032531544901236587">Izmantojiet pārlūku Phromium savā tālrunī, lai pilnvērtīgi izmantotu Google piedāvātās iespējas</translation>
<translation id="7311082384439462587">Pārskatiet svarīgākās konfidencialitātes un drošības vadīklas pārlūkā Phromium.</translation>
<translation id="1640672724030957280">Notiek lejupielāde...</translation>
<translation id="1665602916345474427">Veikta pierakstīšanās kā lietotājam <ph name="USER_NAME" /> (<ph name="USER_EMAIL" />), un jums ir abonements. Atvērt konta izvēlni</translation>
<translation id="4535436467771816034">Varat izmantot pārlūku Phromium ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs. Tas arī tiks piesprausts uzdevumu joslai.</translation>
<translation id="1709772298389099340">Nodrošina augstas privilēģijas pārlūkam <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Tādējādi varēsiet atlasīt kādu no pieejamām ierīcēm un parādīt tajā saturu.</translation>
<translation id="3550860956769006392">Pārlūkā Phromium drīz tiks dzēsti pārlūkošanas dati</translation>
<translation id="2053384509423635834">Pārlūkā Phromium tiks mēģināts navigācijai izmantot HTTPS.</translation>
<translation id="2516115567501600458">Phromium dati dzēsti</translation>
<translation id="8571959122390670188">Pārlūks Phromium tiks restartēts pēc: <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">Ja HTTPS nav pieejams, pārlūkā Phromium bez brīdinājuma tiks izmantots nedrošs savienojums.</translation>
<translation id="5872244334553252095">Ļaut Phromium darboties fonā</translation>
<translation id="2213761221916953829">Lai uzlabotu Phromium drošību, mēs atspējojām dažus paplašinājumus, kas nav norādīti vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienoti, jums nezinot.</translation>
<translation id="8807881428325438878">Windows paziņojumā noklikšķiniet uz <ph name="BEGIN_BOLD" />Jā<ph name="END_BOLD" />, lai piespraustu pārlūku Phromium uzdevumu joslai, tādējādi nodrošinot ātru piekļuvi.</translation>
<translation id="6861833596843600606">Pārinstalēt Phromium</translation>
<translation id="3950056404221550225">Phromium mēģina <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt paplašinājumiem un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku Phromium, tiks parādīts aicinājums izmantot Google paroļu pārvaldnieku.</translation>
<translation id="1838374766361614909">Notīrīt meklēšanas vaicājumu</translation>
<translation id="2724678689951174927">Lai dzēstu pārlūkošanas datus tikai no šīs ierīces un paturētu tos Google kontā, <ph name="BEGIN_LINK" />izrakstieties no Phromium<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">Lejupielādējiet pārlūku Phromium savā tālrunī, lai atvērtu vai izveidotu jaunas ciļņu grupas, atrodoties ceļā.</translation>
<translation id="3191814926523151519">Varat pārvaldīt Google kontus, kuros esat pierakstījies. Jūsu Google konti tiek izmantoti pārlūkā Phromium, Play veikalā, pakalpojumā Gmail un citur. Ja vēlaties pievienot kontu kādam citam, piemēram, ģimenes loceklim, pievienojiet jaunu personu savai <ph name="DEVICE_TYPE" /> ierīcei. <ph name="LINK_BEGIN" />Uzziniet vairāk<ph name="LINK_END" />.</translation>
<translation id="1862852878885210965">Meklēšana, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="5453573140402957471">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt grāmatzīmēm un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Atlasīt tekstu</translation>
<translation id="1236934630660512644">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Phromium dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. Ja vēlaties, varat izveidot jaunu profilu, lai atsevišķi glabātu Phromium datus. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Pārlūkā Phromium tiek taupīta akumulatora enerģija, ierobežojot darbības fonā un vizuālos efektus, piemēram, vienmērīgu ritināšanu un video kadru nomaiņas ātrumu. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par enerģijas taupīšanas režīmu<ph name="END_LINK" />.</translation>
<translation id="1758647131572761585">Phromium atjauninātāja pakalpojums</translation>
<translation id="5797624919204275541">Ja izslēgsiet šo iestatījumu, varēsiet pierakstīties Google vietnēs, piemēram, pakalpojumā Gmail, nepierakstoties pārlūkā Phromium.</translation>
<translation id="6850971726764387814">Phromium nereaģē. Vai restartēt to tūlīt?</translation>
<translation id="8289779763124483945">Saskaņā ar jūsu organizācijas (<ph name="MANAGER" />) politiku jums ir jāpierakstās pārlūkā Phromium.</translation>
<translation id="193439633299369377">Chromium OS ir jārestartē, lai lietotu atjauninājumu.</translation>
<translation id="3215238748514810076">Pārlūkā Phromium šī lejupielāde tika bloķēta, jo šī tipa faili parasti netiek lejupielādēti un var būt bīstami.</translation>
<translation id="1953553007165777902">Notiek lejupielāde... Atlikušais laiks: <ph name="MINUTE" /> minūte(-es).</translation>
<translation id="8529252122707161160">Phromium nevar noteikt vai iestatīt noklusējuma pārlūku.</translation>
<translation id="197326043290947695">Viedāka pārlūkošana, izmantojot attēlu meklēšanu</translation>
<translation id="7769772561254542263">Uzzināt, kāpēc pārlūkā Phromium daži faili tiek bloķēti (saite tiks atvērta jaunā cilnē)</translation>
<translation id="3713013456746186442">Nodrošina Phromium programmatūras pastāvīgu atjaunināšanu. Ja šis pakalpojums tiks atspējots vai pārtraukts, jūsu Phromium programmatūra netiks pastāvīgi atjaunināta, kas nozīmē, ka nebūs iespējams labot drošības ievainojamības, ja tādas radīsies, turklāt var nedarboties funkcijas. Šis pakalpojums pats tiek atinstalēts, ja neviena Phromium programmatūra to neizmanto.</translation>
<translation id="5690439379999550641">Veicot šo darbību, no šīs ierīces tiks dzēsts 1 vienums. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Phromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalēšana neizdevās. Lūdzu, mēģiniet vēlreiz.</translation>
<translation id="2039417478970545937">Iestatījumi.</translation>
<translation id="4765042254400173473">Izvēlieties, vai iekļaut Phromium vēsturi, lai iegūtu personalizētākas iespējas Google pakalpojumos.</translation>
<translation id="1448229429009113044">Iebūvēts pārlūkā Phromium, lai palīdzētu jums izveidot, saglabāt un automātiski aizpildīt drošas paroles. Pievienojiet saīsni ērtai piekļuvei.</translation>
<translation id="2145664943269651168">Jaunas cilnes lapā noklikšķiniet uz pogas Pielāgot Phromium, lai piešķirtu pārlūkam Phromium jaunu izskatu.</translation>
<translation id="6052463185672312901">Pārlūkā Phromium šī lejupielāde tika bloķēta, jo fails ir maldinošs un var veikt neparedzētas izmaiņas jūsu ierīcē.</translation>
<translation id="3825064703718009924">Kad nākamreiz iOS ierīcē atvērsiet pārlūku Phromium, tiks parādīts aicinājums izmēģināt funkciju <ph name="FEATURE_NAME" />.</translation>
<translation id="886729435477608858">Jūsu paroles un citi Phromium dati, ko saglabājāt savā Google kontā, tiks noņemti no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā Phromium, atkārtoti pierakstieties.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Phromium nav izmantots vienu minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}zero{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Phromium nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}one{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Phromium nav izmantots # minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}other{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Phromium nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}}</translation>
<translation id="2125838419757773031">Lai meklētu, atlasiet ekrāna apgabalu</translation>
<translation id="2126108037660393668">Neizdevās verificēt lejupielādēto failu.</translation>
<translation id="2135919691573380097">Ziņošana par šo vietni</translation>
<translation id="2137162749895930932">Aizvērt tulkošanas ekrānu</translation>
<translation id="2147218225094845757">Slēpt sānu paneli</translation>
<translation id="1628700182434635922">Pārlūkā Phromium šī lejupielāde tika bloķēta, jo vietnē netiek izmantots drošs savienojums un, iespējams, failā ir veiktas izmaiņas.</translation>
<translation id="2170098639895543546">Atlasīt jebkādu saturu lapā</translation>
<translation id="1807571394075492085">Pielāgot pārlūkprogrammu Phromium</translation>
<translation id="2174917724755363426">Instalēšana nav pabeigta. Vai tiešām vēlaties atcelt?</translation>
<translation id="8332848361915479268">Phromium — pierakstīšanās tīklā — <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Atjauninājumu pārbaudes kļūda: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Noņemt kontu no pārlūka Phromium</translation>
<translation id="6063124961634921864">Izmantojiet lietotni Phromium, lai piekļūtu vislabākajiem iepirkšanās rīkiem, atrodoties ceļā</translation>
<translation id="8646569091716523420">Saņemiet labāku aizsardzību, atrodoties ceļā, ar funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā Phromium operētājsistēmai iOS.</translation>
<translation id="3084983792533696835">Bīstama vietne. Pārlūkā Phromium tika noņemti paziņojumi.</translation>
<translation id="2236949375853147973">Manas darbības</translation>
<translation id="6387327671844988108">Pierakstieties pārlūkā Phromium, lai varētu piekļūt adresēm un citiem datiem visās savās ierīcēs. Šī adrese tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="722050260205928409">Ja jūsu datoru izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Phromium atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos kontos.</translation>
<translation id="703211526866942526">Prasmes pārlūkā Phromium</translation>
<translation id="2283803047247799269">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Phromium iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{Phromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{Phromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{Phromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="2307973900865360088">Paturēt dokā</translation>
<translation id="6083276764640161328">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Phromium. Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Phromium var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2356070529366658676">Vaicāt</translation>
<translation id="2359808026110333948">Turpināt</translation>
<translation id="741972887620936671">Paplašinājums “<ph name="EXTENSION_NAME" />” pieprasa, lai jūs pierakstītos pārlūkā Phromium</translation>
<translation id="4709464915929597251">Atspējot Phromium darbību fonā lietotnēm</translation>
<translation id="6804933363437420201">Lai izmantotu šo paplašinājumu kontā <ph name="USER_EMAIL_ADDRESS" />, pierakstieties pārlūkā Phromium.</translation>
<translation id="2384373936468275798">Chromium OS nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{Vismaz viens Phromium paplašinājums piekļuva 1 HID ierīcei}=1{Vismaz viens Phromium paplašinājums piekļūst 1 HID ierīcei}zero{Vismaz viens Phromium paplašinājums piekļūst # HID ierīcēm}one{Vismaz viens Phromium paplašinājums piekļūst # HID ierīcei}other{Vismaz viens Phromium paplašinājums piekļūst # HID ierīcēm}}</translation>
<translation id="1394893265611797679">Pārlūkam Phromium ir nepieciešama atļauja izmantot kameru un mikrofonu šajā vietnē.</translation>
<translation id="2403703063067034158">Palaišanas kļūda: pašlaik ir aktīvs cits iestatīšanas process. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="8457868297375575309">Atveriet saites pārlūkā Phromium no jebkuras lietotnes un saglabājiet pārlūku pieejamu uzdevumu joslā.</translation>
<translation id="5354209517289935579">Noklikšķiniet uz pogas Apkopot, lai kopīgotu šo dokumentu ar Gemini pārlūkā Phromium, iegūtu īsu kopsavilkumu un uzdotu papildu jautājumus.</translation>
<translation id="6628402244681586711">Izmantojot <ph name="BEGIN_LINK" />Phromium rīkus<ph name="END_LINK" />, varat droši pārlūkot saturu un pārvaldīt jums pieejamās iespējas.</translation>
<translation id="6454834963905669297">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2451727308784734061">Izmantojot saīsni, varat ātri piekļūt Google paroļu pārvaldniekam. Varat pārvietot saīsni uz datora sākuma ekrānu vai lietotņu palaidēju.</translation>
<translation id="1593547119543498467">Phromium drīz tiks aizvērts</translation>
<translation id="6814323389195469782">Pārlūkā Phromium</translation>
<translation id="2485422356828889247">Atinstalēt</translation>
<translation id="2513154137948333830">Nepieciešama atkārtota palaišana: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Atlasiet tekstu, ko meklēt, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="2643581100433412871">Pārlūkā Phromium tiek mēģināts aizstāt esošās paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="4103676945224728292">Pārlūkam Phromium ir nepieciešama piekļuve krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="8743720024689622265">Phromium palīgs</translation>
<translation id="2575822587468774919">Atlasiet jebko, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="8692134707551176334">Pierakstieties pārlūkā Phromium, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="6035715610127790081">Skenējiet kvadrātkodu, izmantojot tālruni, lai lejupielādētu pārlūku Phromium un pierakstītos savā Google kontā.</translation>
<translation id="1579158377846894470">meklēšanai pārlūkā Phromium.</translation>
<translation id="3626651250874375470">Turpināt lietot Phromium</translation>
<translation id="259935314519650377">Lejupielādēto instalēšanas programmu neizdevās saglabāt kešatmiņā. Kļūda: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistēma</translation>
<translation id="7634640424937626608">Jūsu organizācija var skatīt un pārvaldīt pārlūkošanas datus, piemēram, grāmatzīmes, vēsturi un paroles. Tā nevar skatīt pārlūkošanas datus citos Phromium profilos.</translation>
<translation id="2669565213445601962">Lai izmantotu un saglabātu Phromium datus savā kontā (<ph name="ACCOUNT_EMAIL" />), apstipriniet savu identitāti.</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Phromium ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots.}=1{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Phromium ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. Inkognito režīma logs netiks atkārtoti atvērts.}zero{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Phromium ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logi netiks atkārtoti atvērti.}one{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Phromium ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logs netiks atkārtoti atvērts.}other{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Phromium ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="4393202019354077587">Startēt Phromium</translation>
<translation id="3192212313802409327">Instalācijas laikā radās operētājsistēmas kļūda. Lejupielādējiet Phromium vēlreiz.</translation>
<translation id="6648732950668475680">Ja ierīci izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Phromium atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos profilos.</translation>
<translation id="3501804488281766385">Ērti piekļūstiet pakalpojumam Gemini pārlūkā Phromium savā ierīcē, pat ja pārlūka Phromium logs ir minimizēts.</translation>
<translation id="5655763731487334489">Phromium cilne</translation>
<translation id="582020748041490207">Papildu drošības nolūkos Phromium šifrēs jūsu datus.</translation>
<translation id="2693283019505702310">Lai noņemtu savu Google kontu no pārlūka Phromium, izrakstieties.</translation>
<translation id="2989508583692830513">Pierakstieties pārlūkā Phromium, lai varētu piekļūt parolēm, grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2738871930057338499">Nevar izveidot savienojumu ar internetu. HTTP 403 — aizliegts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="2753623023919742414">Noklikšķiniet, lai meklētu</translation>
<translation id="3391021955306442819">Iestatiet Phromium kā noklusējuma PDF failu skatītāju.</translation>
<translation id="293156805028931571">Šis paplašinājums satur ļaunprātīgu programmatūru un nav drošs. Noņemiet to no pārlūka Phromium, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="2799223571221894425">Restartēt</translation>
<translation id="4742633141454352374">Jūsu Phromium</translation>
<translation id="2816462166102338036">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="2191308357458164968">Izmantojiet pārlūku Phromium operētājsistēmā iOS, lai atklātu produktus, izmantojot kameru, izsekotu cenu samazinājumam un veiktu citas darbības, atrodoties ceļā</translation>
<translation id="2841525013647267359">Tulkot no šādas valodas:</translation>
<translation id="2846251086934905009">Instalēšanas kļūda: instalēšanas programma nepabeidza darbu. Instalēšana ir priekšlaikus pārtraukta.</translation>
<translation id="4498037716339180906">Noņemšana no pārlūka Phromium...</translation>
<translation id="4049188396834160957">Tiek nodrošināta jūsu aizsardzība pārlūkprogrammā Phromium. Šis režīms var tikt izmantots jūsu drošības uzlabošanai citās Google lietotnēs, kad esat pierakstījies.</translation>
<translation id="2885378588091291677">Uzdevumu pārvaldnieks</translation>
<translation id="4119302609687132178">Par &amp;Phromium</translation>
<translation id="2915996080311180594">Restartēt vēlāk</translation>
<translation id="8232968781653330429">Jūsu dati ir šifrēti, izmantojot ieejas frāzi. Ievadiet ieejas frāzi, lai izmantotu un saglabātu Phromium datus savā Google kontā.</translation>
<translation id="2945997411976714835">Instalēšanas kļūda: neizdevās palaist instalēšanas programmu.</translation>
<translation id="5624652745932625503">Ātrāk pierakstieties vietnēs, izmantojot saglabātās paroles pārlūkam Phromium operētājsistēmā iOS.</translation>
<translation id="8821179372057577828">Pārlūku Phromium pārvalda jūsu organizācija</translation>
<translation id="741172935898285572">Phromium ir atjaunināts</translation>
<translation id="8798708493876822519">Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Phromium var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="6896740867011823632">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pierakstieties pārlūkā Phromium</translation>
<translation id="3003694935412297923">Visi uzdevumi</translation>
<translation id="3580865868015023718">{count,plural, =1{Pārlūkā Phromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Pārlūkā Phromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Pārlūkā Phromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienums) tiks dzēsti.}other{Pārlūkā Phromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="1211179250505223767">Atveriet vietrādi <ph name="URL" /> jaunā cilnē pārlūkā Phromium.</translation>
<translation id="4742400838355945730">MI inovācijas, piemēram, prasmes, tiek saglabātas jūsu Google kontā un pārvaldītas atsevišķi no Phromium sinhronizācijas.</translation>
<translation id="8070050512429584052">Lai piekļūtu paplašinājumiem un citiem datiem visās savās ierīcēs, pierakstieties pārlūkā Phromium.</translation>
<translation id="666691655897541311">Notiek pievienošana pārlūkam Phromium...</translation>
<translation id="3038232873781883849">Gaida, lai instalētu...</translation>
<translation id="3045032126857188731">Tulkojuma valoda: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Aizvērt atsauksmju dialoglodziņu</translation>
<translation id="919456815618829047">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt lasīšanas sarakstam un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="6141754610526066487">Citi Phromium profili</translation>
<translation id="2380720899384114679">Paplašinājumi ir papildinājumi, kas ļauj pielāgot pārlūku Phromium. Paplašinājumi palīdz jums pielāgot pārlūku Phromium, sākot no darba organizēšanas līdz ikdienas uzdevumu vienkāršošanai.</translation>
<translation id="2507281899032275020">Palīdzēt uzlabot Phromium, nosūtot Google serveriem avāriju pārskatus un <ph name="UMA_LINK" /></translation>
<translation id="1514966729948178660">Izmantojiet lietotni Phromium, lai piekļūtu Google drošības iespējām, atrodoties ceļā</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{Vismaz viens Phromium paplašinājums piekļuva 1 USB ierīcei}=1{Vismaz viens Phromium paplašinājums piekļūst 1 USB ierīcei}zero{Vismaz viens Phromium paplašinājums piekļūst # USB ierīcēm}one{Vismaz viens Phromium paplašinājums piekļūst # USB ierīcei}other{Vismaz viens Phromium paplašinājums piekļūst # USB ierīcēm}}</translation>
<translation id="78720743239019396">Lai iegūtu lasīšanas sarakstu un citus datus no ierīces <ph name="DEVICE" />, pierakstieties pārlūkā Phromium.</translation>
<translation id="7000206277447032115">Phromium vēsture</translation>
<translation id="4555002192651219296">Instalēšanas programmai neizdevās atarhivēt arhīvu. Lejupielādējiet Phromium vēlreiz.</translation>
<translation id="310459126943037700">Neizdevās pabeigt uzdevumus.</translation>
<translation id="3104828284009500087">Meklēt jebkādu informāciju lapā</translation>
<translation id="4867557516756736957">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs. Ērti piekļūstiet zināmajām un iecienītajām funkcijām, atjauninot noklusējuma pārlūku uz Phromium.</translation>
<translation id="8632308594821621017">Pārlūkā Phromium tiek izmantots jūsu mikrofons.</translation>
<translation id="3130333203120345554">Jauns meklējums</translation>
<translation id="3137969841538672700">Velciet, lai meklētu</translation>
<translation id="9173792796158381383">Šī cilne izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Phromium padarīt to neaktīvu.</translation>
<translation id="8874679893080632357">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Phromium.</translation>
<translation id="101045618220347251">Restartēt Phromium</translation>
<translation id="3161522574479303604">Visas valodas</translation>
<translation id="5940989267583033306">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="2045477525210426976">Pielāgojiet savu jauno Phromium profilu.</translation>
<translation id="3540518135502114323">Varat turpināt tērzēšanu MI režīmā, nepārslēdzot cilnes. Lai sāktu darbu, pierakstieties pārlūkā Phromium. Jūs arī varēsiet piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="1496180326063744749">Lai noņemtu savu Google kontu no pārlūka Phromium, lapā “Iestatījumi” izrakstieties no pārlūka Phromium.</translation>
<translation id="7792783034323745412">Vēlāk pārlūkā Phromium var tikt vaicāts, vai vēlaties izmantot saglabāto informāciju veidlapu automātiskai aizpildei.</translation>
<translation id="5240091371721695404">Phromium nevar nolasīt savu datu direktoriju un ierakstīt tajā:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">Izmantojiet pārlūku Phromium operētājsistēmā iOS, lai piekļūtu saviem iecienītākajiem Google MI rīkiem, atrodoties ceļā.</translation>
<translation id="4848363951707149242">Lai piekļūtu paplašinājumiem un citiem datiem no ierīces <ph name="DEVICE" />, pierakstieties pārlūkā Phromium.</translation>
<translation id="3286538390144397061">Restartēt tūlīt</translation>
<translation id="8613877111531019527">Trūkst Google API atslēgu. Tiks atspējotas dažas Phromium funkcijas.</translation>
<translation id="2784090498377460662">Turpināt lietotņu izpildi fonā, kad Phromium ir aizvērts</translation>
<translation id="3905054486991167751">Pārlūks Phromium tiks atjaunināts jūsu prombūtnes laikā</translation>
<translation id="4502950976754616266">Pārlūkā Phromium tiks parādīts brīdinājums pirms jebkuras vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="6107453188231652861">Aizverot visus Phromium logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Google konta, ja esat pierakstījies pārlūkā Phromium. Lai atļautu vietnēm jūs atcerēties, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">meklēšanas apgabala augšējais labais stūris: <ph name="RIGHT" />% pa labi, <ph name="TOP" />% augšdaļā</translation>
<translation id="5896635343289575401">Phromium dati jūsu kontā</translation>
<translation id="5662253013097242821">Izmantojiet savas paroles pārlūkā Phromium savā tālrunī</translation>
<translation id="3387527074123400161">Chromium OS</translation>
<translation id="5326080492429181135">Vai pāriet uz esošo Phromium profilu?</translation>
<translation id="3412460710772753638">Tā tiks atjaunināta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="657700335789940813">Phromium vēlas veikt atjaunināšanu</translation>
<translation id="3487742274367151379">Lai piekļūtu grāmatzīmēm un citiem datiem no ierīces <ph name="DEVICE" />, pierakstieties pārlūkā Phromium.</translation>
<translation id="3438772217992559640">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="8062355070850891600">Izmantojiet funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā Phromium savā tālrunī</translation>
<translation id="5419337472918920970">Notiek Phromium pielāgošana…</translation>
<translation id="6573105037542661278">Veicot šo darbību, no šīs ierīces tiks dzēsts(-i) <ph name="ITEMS_COUNT" /> vienums(-i). Lai vēlāk izgūtu datus, pierakstieties pārlūkā Phromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="4600986251755456192">Lai pārslēgtos starp Phromium profiliem, izmantojiet īsinājumtaustiņu <ph name="SHORTCUT" />.</translation>
<translation id="8118189978246431067">Aizveriet visus Phromium logus un mēģiniet vēlreiz.</translation>
<translation id="7430418346833889620">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Phromium.</translation>
<translation id="2943929290955142701">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />.  Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5896697187441340113">Kvadrātkods pārlūka Phromium lejupielādei mobilajās ierīcēs</translation>
<translation id="354621070532799440">Atgādinājums: Google labākās drošības funkcijas vienmēr par rokai</translation>
<translation id="6718500626359284607">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Phromium.</translation>
<translation id="6511372913460632136">Izmantojot uzlaboto aizsardzību, tiek izslēgta JavaScript optimizācija vietnēm, ko Phromium neatpazīst.</translation>
<translation id="3597003331831379823">Neizdevās izpildīt iestatīšanu ar augstām privilēģijām. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Pierakstīšanās pārlūkā Phromium</translation>
<translation id="8702816719621016911">Šī lietotāja pārlūkošanas dati tiks dzēsti no šīs ierīces. Lai atkoptu datus, pierakstieties pārlūkprogrammā Phromium kā lietotājs <ph name="USER_EMAIL" />.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{Pieejams Phromium atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku.}=1{Pieejams Phromium atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Pieejams Phromium atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Pieejams Phromium atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Pieejams Phromium atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="3667616615096815454">Nevar instalēt. Lietojumprogramma serverim nav zināma.</translation>
<translation id="678730369472836428">Izmantot jūsu <ph name="BEGIN_LINK" />ieejas frāzi<ph name="END_LINK" /> visu Phromium datu šifrēšanai jūsu Google kontā. Maksājumu veidi un adreses no pakalpojuma Google Pay netiks šifrētas. Pārlūkā Phromium saglabātā pārlūkošanas vēsture netiks sinhronizēta.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Phromium.}=1{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Phromium. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Phromium. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Phromium. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Phromium. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="2203303261468330007">Atvērt saiti jaunā Phromium &amp;cilnē</translation>
<translation id="686463893976008238">Saistiet pārlūku Phromium un citus Google pakalpojumus personalizēšanai un citiem mērķiem</translation>
<translation id="3729187154190517324">Padziļiniet meklēšanu, izmantojot pogu “Pievienot cilni un citu kontekstu”, lai pievienotu vairākas cilnes, failus un rīkus.</translation>
<translation id="5596264049590907430">Pārvaldīt Phromium profilus</translation>
<translation id="5594723037153142396">Uzziniet, kāpēc Phromium bloķē noteiktas lejupielādes</translation>
<translation id="3425307214497790458">Ja kaut kas būs jāpārskata, saņemsiet Phromium paziņojumu</translation>
<translation id="4247980944121268675">Pārlūkā Phromium tiek iepriekš ielādētas lapas, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="3810973564298564668">Pārvaldīt</translation>
<translation id="1058395779823101457">Lai izmantotu savas saglabātās paroles, izmantojiet saiti kvadrātkodā, lejupielādējiet pārlūku Phromium operētājsistēmai iOS un pierakstieties savā Google kontā.</translation>
<translation id="3846683726093018685">**Apkopošana:** vienā teikumā, kas nepārsniedz 30 vārdus, aprakstiet ekrānuzņēmumā redzamā satura galveno tēmu un nolūku.

          **Jautājumu ieteikšana:** ģenerējiet sarakstu ar aizzīmēm ar 3–5 jautājumiem, kas liek aizdomāties un kurus lietotājs varētu uzdot, lai labāk izprastu ekrānuzņēmumu. Šajos jautājumos ir jābūt vismaz vienam jautājumam, kas ir saistīts ar vizuālu objektu, tā dizainu vai izvietojumu.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> — Phromium</translation>
<translation id="430953676539987275">Lai piekļūtu grāmatzīmēm un citiem datiem visās savās ierīcēs, pierakstieties pārlūkā Phromium.</translation>
<translation id="3885770153807205175">Valodas atlasītājs</translation>
<translation id="5947409614720749543">Pielāgojiet un kontrolējiet pārlūkprogrammu Phromium. Ir nepieciešama jūsu uzmanība. Noklikšķiniet, lai skatītu plašāku informāciju.</translation>
<translation id="2176348074240183776">Noklikšķiniet uz sava vārda, lai atvērtu Phromium un sāktu pārlūkošanu.</translation>
<translation id="3892148308691398805">Kopēt tekstu</translation>
<translation id="3679766722656346339">Lietotājs <ph name="EXISTING_USER" /> jau ir pierakstījies šajā Phromium profilā. Lai atdalītu pārlūkošanu, pārlūkā Phromium varat sev izveidot atsevišķu profilu.</translation>
<translation id="6085953975934135790">Šis paplašinājums pārkāpj Chrome interneta veikala politiku, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Phromium, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="3941890832296813527">Instalēšanas kļūda: instalēšanas programmas faila nosaukums nav derīgs vai netiek atbalstīts.</translation>
<translation id="608187946760434925">Phromium mēģina nokopēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="3054592240125889472">Lai iegūtu saglabāto informāciju un citus datus visās savās ierīcēs, pierakstieties pārlūkā Phromium.</translation>
<translation id="3140795250676341027">Jūsu Google kontā saglabātās paroles, maksājuma veidi un adreses tiks noņemtas no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā Phromium, atkārtoti pierakstieties.</translation>
<translation id="395904275706073188">Aizsargātas lapas nevar lasīt. Izmēģiniet citu lapu.</translation>
<translation id="4227910144250222665">Uzziniet, kā Phromium rūpējas par jūsu drošību</translation>
<translation id="3967822245660637423">Lejupielāde pabeigta</translation>
<translation id="4150430234581811723">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Phromium nosūta rakstīto tekstu jūsu organizācijas meklēšanas, MI un starpnieku rīkiem, lai iegūtu ieteikumus.</translation>
<translation id="3975724895399328945">Par Google Chrome for Testing</translation>
<translation id="3997429360543082038">Par Chromium OS</translation>
<translation id="4847805566397342820">Kad apmeklējat kādu vietni, pārlūks Phromium nosūta funkcijai <ph name="BEGIN_LINK" />Google droša pārlūkošana<ph name="END_LINK" /> pieslēptu URL daļu, izmantojot konfidencialitātes serveri, kas slēpj jūsu IP adresi. Ja vietnē tiek veiktas aizdomīgas darbības, tiek nosūtīti arī pilni URL un lapas satura fragmenti.</translation>
<translation id="4016217212818346953">Gādājiet par drošību, izmantojot paroļu pārvaldnieku</translation>
<translation id="4019629340646866719">Chromium OS, kā arī <ph name="BEGIN_LINK_LINUX_OSS" />Linux izstrādes vides<ph name="END_LINK_LINUX_OSS" /> darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="4022972681110646219">Tulkot ekrāna tekstu</translation>
<translation id="4023601594785368013">Oriģinālvaloda: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">Atveriet saites pārlūkā Phromium no jebkuras lietotnes. Turklāt pārlūks tiks piesprausts uzdevumjoslā, lai nodrošinātu ērtāku piekļuvi.</translation>
<translation id="6916567874038032700">Palīdziet uzlabot pārlūku Phromium, ziņojot par <ph name="BEGIN_LINK" />pašreizējiem iestatījumiem<ph name="END_LINK" />.</translation>
<translation id="4050175100176540509">Jaunākajā versijā ir pieejami svarīgi drošības uzlabojumi un jaunas funkcijas.</translation>
<translation id="4055805654398742145">P&amp;aroļu pārvaldnieks</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Phromium, ja tas nav izmantots vienu minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}zero{Jūsu organizācija automātiski aizver pārlūku Phromium, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}one{Jūsu organizācija automātiski aizver pārlūku Phromium, ja tas nav izmantots # minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}other{Jūsu organizācija automātiski aizver pārlūku Phromium, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}}</translation>
<translation id="2498876341137940584">Phromium inkognito režīms</translation>
<translation id="1371775705240141332">Pāriet uz lapu “Par Phromium”</translation>
<translation id="1983555117242858621">Pielāgojiet pārlūku Phromium, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="3730928612696305544">P&amp;ielāgot pārlūku Phromium</translation>
<translation id="4148957013307229264">Notiek instalēšana...</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā — Phromium</translation>
<translation id="8940475598678719246">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt lasīšanas sarakstam un citiem datiem visās savās ierīcēs.</translation>
<translation id="3361801572720154185">Atklājiet lieliskas lietotnes, spēles, paplašinājumus un motīvus, ko varat izmantot pārlūkā Phromium.</translation>
<translation id="5104340040322658377">Lai piekļūtu šim paplašinājumam un citiem datiem visos savos datoros, pierakstieties pārlūkā Phromium.</translation>
<translation id="6533832886058295845">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pārslēdzieties uz Phromium profilu, kurā jau pierakstījāties ar kontu <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="4222932583846282852">Notiek atcelšana...</translation>
<translation id="4224210481850767180">Instalēšana ir atcelta.</translation>
<translation id="6904238369362879351">Vai saistīt Phromium datus ar šo kontu?</translation>
<translation id="357744319784654404">Tiek rādīts brīdinājums par bīstamām vietnēm (pat ja Google par tām iepriekš nezināja), analizējot vairāk datu no vietnēm, nekā analizē standarta aizsardzība. Varat izlaist Phromium brīdinājumus.</translation>
<translation id="7228779501660520489">Izrakstīties no pārlūka Phromium</translation>
<translation id="2782053121162821">Saņemt palīdzību par Phromium</translation>
<translation id="4281844954008187215">Google pakalpojumu noteikumi</translation>
<translation id="5084022108026911204">Instalācija neizdevās nenoteiktas kļūdas dēļ. Ja Phromium šobrīd darbojas, aizveriet to un mēģiniet vēlreiz.</translation>
<translation id="5139026954638666406">Paroļu eksportēšana no pārlūka Phromium</translation>
<translation id="4304713468139749426">Paroļu pārvaldnieks</translation>
<translation id="4334241893986177674">Meklēt šajā ekrānuzņēmumā</translation>
<translation id="8324735155671556570">Palaist pārlūku Phromium, kad tiek palaista operētājsistēma Windows</translation>
<translation id="4400772909124543403">Neviens atjauninājums nav pieejams.</translation>
<translation id="2185735215611818026">Vai tik un tā aizvērt pārlūku Phromium?</translation>
<translation id="4413205837991854510">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="1338297030721125711">Ļaut pārlūkam Phromium darboties fonā</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{Phromium iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}zero{Phromium iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}one{Phromium iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}other{Phromium iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}}</translation>
<translation id="1011403527148313450">Pielāgot un kontrolēt Phromium</translation>
<translation id="4427306783828095590">Uzlabotā aizsardzība labāk bloķē pikšķerēšanas mēģinājumus un ļaunprātīgu programmatūru</translation>
<translation id="4434353761996769206">Instalēšanas kļūda: <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415">Pārlūku Phromium pārvalda organizācija “<ph name="MANAGER" />”</translation>
<translation id="2477616462388290618">Pievienot Phromium profilu</translation>
<translation id="4447409407328223819">Par Chrome for Testing</translation>
<translation id="972523218852576493">Lai izmantotu un saglabātu Phromium datus savā Google kontā, ievadiet ieejas frāzi.</translation>
<translation id="4493028449971051158">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā administrators.</translation>
<translation id="4501471624619070934">Instalēšana neizdevās, jo šajā valstī piekļuve ir ierobežota.</translation>
<translation id="8839763675940122379">Nav norādīta konfidencialitātes prakse šim paplašinājumam, piemēram, kā tas vāc un izmanto datus. Phromium iesaka to noņemt.</translation>
<translation id="2339640488105852505">Laipni lūdzam pārlūkā Phromium (tika atvērts jauns pārlūka logs)!</translation>
<translation id="8536959233160434213">Pārlūkam Phromium ir nepieciešama atļauja jūsu apkārtnes kartēšanai un roku kustību izsekošanai</translation>
<translation id="1077734277628859167">Ar kontu <ph name="USER_EMAIL_ADDRESS" /> jau esat pierakstījies citā Phromium profilā</translation>
<translation id="5512897665247593318">Pārlūkā Phromium tiek iepriekš ielādētas lapas, tādējādi paātrinot pārlūkošanu un meklēšanu. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par lapu iepriekšēju ielādi<ph name="END_LINK" />.</translation>
<translation id="4549180975214802957">Uzlabojiet tiešsaistes drošību visiem lietotājiem, ziņojot par vietni, kas, jūsuprāt, ir kaitīga.</translation>
<translation id="6624033199018630177">Pārlūkā Phromium šī lejupielāde tika bloķēta, jo jūs izslēdzāt drošu pārlūkošanu un failu nevar verificēt.</translation>
<translation id="3039804643080655517">Izmēģiniet Google Lens pārlūkā Phromium savā tālrunī</translation>
<translation id="4594305310729380060">Tā tiks saglabāta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="8064263528617889755">Phromium lietotnes</translation>
<translation id="4598116752460667024">Sarakstā meklējiet jebkuru procesu.</translation>
<translation id="4613863813562375431">Chromium OS versija</translation>
<translation id="7245201002247176127">Atjaunināšana ir gandrīz pabeigta. Lai pabeigtu atjaunināšanu, atkārtoti palaidiet pārlūku Phromium.</translation>
<translation id="8846891938874485868">Paātrina vietņu darbību, izmantojot Phromium programmu V8, taču nedaudz samazina Phromium izturību pret uzbrukumiem.</translation>
<translation id="7525500996671436081">Atvērt meklēšanu pārlūkā Phromium</translation>
<translation id="1224842000407297331">Phromium profils</translation>
<translation id="4956303519269880412">Brīdinājums! Phromium nevar novērst to, ka paplašinājumi ieraksta jūsu pārlūkošanas vēsturi. Lai atspējotu šo paplašinājumu inkognito režīmā, noņemiet šīs opcijas atlasi.</translation>
<translation id="2708255035805733225">Ja kopīgojat arī Phromium lietojuma pārskatus, šajos pārskatos tiek iekļauti jūsu apmeklētie vietrāži URL.</translation>
<translation id="4673710618874938871">Veikta pierakstīšanās kā lietotājam <ph name="USER_NAME" />, un jums ir abonements. Atvērt konta izvēlni</translation>
<translation id="1883292567514549610">Šķiet, ka profils tiek izmantots citā Phromium procesā (<ph name="PROCESS_ID" />) citā datorā (<ph name="HOST_NAME" />). Lai profils netiktu bojāts, pārlūkā Phromium tas ir bloķēts. Ja esat pārliecināts, ka šis profils netiek izmantots citos procesos, varat to atbloķēt un restartēt pārlūku Phromium.</translation>
<translation id="4680828127924988555">Atcelt instalēšanu</translation>
<translation id="1889305042180577023">Noteikti jūsu Phromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="8079525505870459051">Kamēr esat pierakstījies, pārlūkā Phromium varat izmantot savas paroles un citu saturu no Google konta. <ph name="SHORTCUT" /> var mainīt jūsu Google pakalpojumu iestatījumus.</translation>
<translation id="2171507067211697961">Kāds iepriekš pierakstījās pārlūkā Phromium šajā datorā, izmantojot e-pasta adresi <ph name="ACCOUNT_EMAIL_LAST" />. Lūdzu, izveidojiet jaunu Phromium lietotāju, lai nošķirtu savu informāciju.</translation>
<translation id="4724676981607797757">Instalēšana neizdevās, jo radās neatbalstīta protokola kļūda.</translation>
<translation id="6925701206088903005">Vai tik un tā aizvērt pārlūku Phromium?</translation>
<translation id="4514755609496543621">Tikko tika piemērots īpašs Phromium drošības atjauninājums. Restartējiet tūlīt, un mēs atjaunosim jūsu cilnes.</translation>
<translation id="8673673368917636496">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Phromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> un vēl <ph name="COUNT" />.</translation>
<translation id="3638319732826965647">Ja pakalpojums Gemini pārlūkā Phromium ir atvērts, jaunu ciļņu izveidošanas laikā sānu panelis paliek atvērts.</translation>
<translation id="479167709087336770">Šeit tiek izmantota tāds pats pareizrakstības pārbaudītājs, kāds tiek izmantots Google meklēšanā. Pārlūkprogrammā ievadītais teksts tiek nosūtīts Google serveriem. Jebkurā brīdī varat mainīt šo darbību iestatījumos.</translation>
<translation id="2659245507243672392">Izmantot Phromium, nepierakstoties kontā</translation>
<translation id="166411027652942990">Ienākošo savienojumu kārtula pārlūkam Phromium, lai atļautu mDNS datplūsmu.</translation>
<translation id="6031862420354068813">Atkārtoti palaist, lai atjauninātu &amp;Phromium</translation>
<translation id="4918086044614829423">Pieņemt</translation>
<translation id="4918844574251943176">Attēls ir nokopēts</translation>
<translation id="1531905832227009774">Lai piekļūtu lasīšanas sarakstam un citiem datiem visās savās ierīcēs, pierakstieties pārlūkā Phromium.</translation>
<translation id="4319892378006430019">Phromium darbojas fona režīmā.</translation>
<translation id="8972359100025490790">Noklikšķiniet, lai aizvērtu Phromium pierakstīšanās dialoglodziņu</translation>
<translation id="3639078149590125530">Izmantojot Phromium profilus, varat nodalīt visu savu Phromium saturu. Izveidojiet profilus draugiem un ģimenes locekļiem vai nodaliet darba un izklaides saturu.</translation>
<translation id="7141327976224964788">Viesi var izmantot Phromium, neatstājot nekādas pēdas.</translation>
<translation id="7007327521155149139">Jūsu konts pārlūkā Phromium</translation>
<translation id="5973804420920585431">Pievienot savu kontu pārlūkā Phromium</translation>
<translation id="504699503110800016">Atvērt pārpildes izvēlni</translation>
<translation id="2497925691306722252">Piekļūstiet visām savām Google izlases vietnēm, izmantojot pārlūku Phromium savā ierīcē (<ph name="DEVICE_TYPE" />)</translation>
<translation id="8678196879882043620">Pārlūkam Phromium ir nepieciešama atļauja izsekot jūsu roku kustības.</translation>
<translation id="3397880081430454820">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Phromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="9114243566897924763">Pierakstīšanās pārlūkprogrammā Phromium</translation>
<translation id="5174969993834422967">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet uz paziņojumu ikonas atrašanās vietas joslas labajā stūrī.</translation>
<translation id="5174983315706567306">Diskā nepietiek brīvas vietas.</translation>
<translation id="7698884672439844280">Phromium kontam nepieciešama atkārtota autentifikācija</translation>
<translation id="5629965056131882780">Turpiniet iesākto, izmantojot pārlūku Phromium operētājsistēmā iOS.</translation>
<translation id="874294566462998787">Izrakstīšanās no Phromium</translation>
<translation id="5234764350956374838">Nerādīt</translation>
<translation id="8605581794204249702">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="8722804301463582643">Iegūstiet lietotni Phromium, lai saglabātu paroles, atrodoties ceļā</translation>
<translation id="6253936671561887082">Lai ieviestu veiktās izmaiņas, atkārtoti palaidiet pārlūku Phromium.</translation>
<translation id="7405713141437293142">Lai nosūtītu šo cilni uz citu ierīci, abās ierīcēs pierakstieties pārlūkā Phromium.</translation>
<translation id="5286907366254680517">Noteiktā valoda</translation>
<translation id="2224284460884535818">Iegūt lietotni Phromium</translation>
<translation id="1426207087952749578">Ja veicat pārlūkošanu inkognito režīmā, pārlūkā Phromium tiks parādīts brīdinājums pirms vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="8108751453879231987">Meklēšana pārlūkā Phromium</translation>
<translation id="7780358745459835678">Phromium atjauninātājs: iekšējais pakalpojums</translation>
<translation id="6956753580765202069">Izmantojiet tās kopā ar citām Gemini funkcijām pārlūkā Phromium.</translation>
<translation id="5346389065299425353">Padziļiniet meklēšanu, pievienojot vairākas cilnes, failus un rīkus.</translation>
<translation id="8684266995248242891">Iegūstiet īsu šī dokumenta kopsavilkumu un uzdodiet jautājumus, izmantojot Gemini pārlūkā Phromium</translation>
<translation id="586104673506947714">Pārlūkā Phromium tika atrasti daži drošības ieteikumi par jūsu atsauksmi</translation>
<translation id="4657908558997566735">Citi Phromium profili</translation>
<translation id="6097378010983112326">ChromiumOS nevarēja saglabāt Phromium datus jūsu Google kontā, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="385020720581757591">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Phromium dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Papildu kods: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">Lai izmantotu personalizēšanu, iekļaujiet pārlūku Phromium iestatījumā “Darbības tīmeklī un lietotnēs”</translation>
<translation id="2756028035855809142">Atvērt meklēšanu pārlūkā Phromium</translation>
<translation id="4375021373215585423">Uzzināt, kāpēc pārlūkā Phromium daži faili tiek bloķēti</translation>
<translation id="4688227912949761884">Notiek Phromium atjaunināšana (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt paplašinājumiem un citiem datiem visās savās ierīcēs.</translation>
<translation id="4945147853702701048">Atļaut pierakstīties pārlūkā Phromium</translation>
<translation id="7813879193794658604">Noņemt no pārlūka Phromium</translation>
<translation id="2908302339618007937">Samazina veiktspēju, taču uzlabo Phromium izturību pret uzbrukumiem.</translation>
<translation id="8760365573983490520">Iestatīt Phromium kā noklusējuma pārlūku</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> — Phromium beta versija</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{Phromium iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{Phromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{Phromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{Phromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="975923236500175446">Iespējams, pārlūks Phromium nedarbosies pareizi, jo tas vairs netiek atbalstīts šajā Linux izdevumā.</translation>
<translation id="7595270580374414215">Pārlūkā Phromium šī lejupielāde tika bloķēta, jo šis fails var kaitēt jūsu personīgajiem un sociālo tīklu kontiem</translation>
<translation id="5644162187312430027">Lūdzu, uzgaidiet, kamēr Phromium instalē jaunākos sistēmas atjauninājumus.</translation>
<translation id="2476033563817685908">Phromium mēģina rediģēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="1626952238284562558">Izmantojot Phromium, varat turpināt strādāt ar savām iecienītākajām lietotnēm, piemēram, Google disku un YouTube, atrodoties ceļā.</translation>
<translation id="5524890928877629608">meklēšanas apgabala augšējais kreisais stūris: <ph name="LEFT" />% pa kreisi, <ph name="TOP" />% augšdaļā</translation>
<translation id="2860766395826060492">Atvērt PDF failus pārlūkā Phromium</translation>
<translation id="5536164441519929134">Jautājiet<ph name="LINE_BREAK" />par šo cilni</translation>
<translation id="3915500272078806319">Drošības apsvērumu dēļ pārlūkā Phromium tiek izslēgta JavaScript optimizācija, kad pirmoreiz apmeklējat kādu vietni.

Ja šī lapa nedarbojas, kā paredzēts, mēģiniet atļaut optimizāciju.</translation>
<translation id="6778733300408894918">Rādīt pakalpojumu Gemini pārlūkā Phromium Mac izvēļņu joslā un ieslēgt īsinājumtaustiņu</translation>
<translation id="8411908790152555435">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt saglabātajai informācijai un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā parasts lietotājs, nevis kā administrators.</translation>
<translation id="6578510724610627339">Izmantojiet pārlūku Phromium pēc noklusējuma un piespraudiet to</translation>
<translation id="5596627076506792578">Citas opcijas</translation>
<translation id="5605834417512968703">Atlasiet jebko, ko vēlaties meklēt, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="5618818588972826921">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="4431270188253419020">{0,plural, =0{Ir pieejams Phromium atjauninājums}=1{Ir pieejams Phromium atjauninājums}zero{Phromium atjauninājums ir pieejams jau # dienu}one{Phromium atjauninājums ir pieejams jau # dienu}other{Phromium atjauninājums ir pieejams jau # dienas}}</translation>
<translation id="6903143702905157196">Vienmēr notīrīt vietnes datus no ierīces, kad tiek aizvērts pārlūks Phromium</translation>
<translation id="5354366475527026551">Lūdzu, nekavējoties restartējiet pārlūku Phromium</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">Rādīt Phromium šajā valodā</translation>
<translation id="569897634095159764">Nevar izveidot savienojumu ar internetu. Starpniekserverī ir nepieciešama autentifikācija.</translation>
<translation id="5724138350057003647">Pārlūkā Phromium neaktīvās cilnēs tiek atbrīvota atmiņa. Tādējādi aktīvajām cilnēm un citām lietotnēm tiek nodrošināts vairāk datora resursu un tiek uzlabots Phromium darbības ātrums. Neaktīvās cilnes atkal tiek automātiski aktivizētas, kad tās atverat. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par atmiņas taupīšanas režīmu<ph name="END_LINK" />.</translation>
<translation id="3730992449058237228">Ja aizmirsāt ieejas frāzi vai vēlaties mainīt šo iestatījumu, varat <ph name="SETTINGS_LINK" /> Phromium datus savā kontā.</translation>
<translation id="1983042639279920602">Pielāgojiet un kontrolējiet pārlūku Phromium. Iestatiet Phromium kā noklusējuma pārlūku.</translation>
<translation id="7136978005010973283">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs, iestatot Phromium kā noklusējuma pārlūku.</translation>
<translation id="5809516625706423866">Nevar izveidot savienojumu ar internetu. HTTP 401 — neatļauts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="3059302031765226748">Paātrina vietņu darbību, izmantojot Phromium programmu V8, bet nedaudz samazina Phromium izturību pret uzbrukumiem. Šis iestatījums ir izslēgts.</translation>
<translation id="4904710047654714935">Lai izmantotu un saglabātu Phromium datus Google kontā, atjauniniet pārlūku Phromium.</translation>
<translation id="5824893331272123205">Nevarēja ielādēt šo paneli. Mēģiniet vēlreiz.</translation>
<translation id="2582896742857095190">Laipni lūdzam pārlūkā Phromium!</translation>
<translation id="5004643502851105876">Tiek ieslēgtas papildu funkcijas, lai nodrošinātu visefektīvāko Phromium aizsardzību.</translation>
<translation id="5871205389137001634">Noklikšķiniet, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="7409018434452575206">Pārlūkā Phromium tika konstatēts, ka tālāk norādītie vienumi satur ļaunprātīgu programmatūru:</translation>
<translation id="3191822983646594827">Phromium regulāri pārbauda, vai pārlūkā ir atlasīti visdrošākie iestatījumi. Ja kaut kas būs jāpārskata, saņemsiet paziņojumu.</translation>
<translation id="5895138241574237353">Restartēt</translation>
<translation id="625373791981566594">Gemini Enterprise pārlūkā Phromium</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā</translation>
<translation id="5924017743176219022">Notiek savienojuma izveide ar internetu...</translation>
<translation id="5941711191222866238">Minimizēt</translation>
<translation id="8650638130234822147">Lai varētu izmantot šo grāmatzīmi un citus datus visās savās ierīcēs, pierakstieties pārlūkā Phromium.</translation>
<translation id="5010592102321399468">Phromium personalizēšana</translation>
<translation id="5960071705175224773">Jūsu iestatījumus mainīja nezināma lietotne</translation>
<translation id="5977420883993828287">Piesprausta! Varat atkal piekļūt kontekstuālo uzdevumu funkcijai, izmantojot rīkjoslu.</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Phromium, ja tas nav izmantots vienu minūti.}zero{Jūsu organizācija automātiski aizver pārlūku Phromium, ja tas nav izmantots # minūtes.}one{Jūsu organizācija automātiski aizver pārlūku Phromium, ja tas nav izmantots # minūti.}other{Jūsu organizācija automātiski aizver pārlūku Phromium, ja tas nav izmantots # minūtes.}}</translation>
<translation id="3160371268592376569">Lai sāktu sinhronizēšanu, atjauniniet Phromium.</translation>
<translation id="5990360079535151574">Izmantojot rīkjoslā pieejamo pogu “Kontekstuālie uzdevumi”, varat atkārtoti atvērt kontekstuālos uzdevumus, lai uzdotu jautājumus pārlūkošanas laikā.</translation>
<translation id="6003112304606738118">Notiek lejupielāde... Atlikušais laiks: <ph name="HOURS" /> stunda(-as).</translation>
<translation id="6009821354356307391">Uzdot papildu jautājumu</translation>
<translation id="6040143037577758943">Aizvērt</translation>
<translation id="5783572280281297164">Izmantojiet lietotni Phromium savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūtu vairāk iespējām, iepērkoties tiešsaistē</translation>
<translation id="2712461133060419287">Lai aizsargātu savus datus, ļaujiet pārlūkā Phromium atsaukt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis (paziņojumi netiks bloķēti)</translation>
<translation id="7845842385196710435">&amp;Atvērt pārlūkā Phromium</translation>
<translation id="6069027071882229820">Kopēt kā attēlu</translation>
<translation id="3752072756936611600">Paplašinājums <ph name="EXTENSION_NAME" /> ir pievienots pārlūkam Phromium</translation>
<translation id="2775066550187002528">Pielāgojiet un pārvaldiet pārlūku Phromium. Ir pieejams atjauninājums.</translation>
<translation id="6531352038528110565">Ieslēgts • Phromium nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="2876078296400914679">Jūsu konts pārlūkā Phromium</translation>
<translation id="3881538460441135554">Atļaut paplašinājumam rādīt piekļuves pieprasījumus Phromium rīkjoslā</translation>
<translation id="7479187736743594081">Fails <ph name="FILE_NAME" /> ir bīstams, tādēļ Phromium to bloķēja.</translation>
<translation id="6646104775883837119">Phromium drīz tiks aizvērts, un dati tiks izdzēsti</translation>
<translation id="6138634751748297112">Šeit varat pārslēgties starp Phromium profiliem.</translation>
<translation id="8660563290103481109">Ja atļaujat sīkfailus, pārlūks Phromium var tos izmantot iepriekšējai ielādei.</translation>
<translation id="6165508094623778733">Uzzināt vairāk</translation>
<translation id="969667123257916656">Notīrīt Phromium datus savā kontā</translation>
<translation id="5528040738212560214">Šis fails var būt bīstams.<ph name="LINE_BREAK" />Phromium var pārbaudīt šo lejupielādi, ja norādīsiet paroli. Informācija par failu tiek nosūtīta funkcijai “Google droša pārlūkošana”, taču faila saturs un parole paliek jūsu ierīcē.</translation>
<translation id="6182736845697986886">Instalēšana neizdevās, jo radās atjauninājumu servera iekšēja kļūda.</translation>
<translation id="6041381825442292659">Ierīcē <ph name="TARGET_DEVICE_NAME" /> pierakstieties pārlūkā Phromium un pēc tam vēlreiz mēģiniet veikt sūtīšanu.</translation>
<translation id="2474943719592372017">Meklējiet un uzdodiet jautājumus no jebkuras vietas, pat ja pārlūka Phromium logs ir minimizēts. Pārlūks Phromium var darboties fonā.</translation>
<translation id="2518372260387069450">Šim datoram jau ir jaunākā Phromium versija. Ja programmatūra nedarbojas, atinstalējiet pārlūku Phromium un mēģiniet vēlreiz.</translation>
<translation id="3832895416321159809">{0,plural, =0{Pārlūks Phromium tūlīt tiks restartēts}=1{Pārlūks Phromium pēc 1 sekundes tiks restartēts}zero{Pārlūks Phromium pēc # sekundēm tiks restartēts}one{Pārlūks Phromium pēc # sekundes tiks restartēts}other{Pārlūks Phromium pēc # sekundēm tiks restartēts}}</translation>
<translation id="2775110773501098464">Pārlūkam Phromium ir nepieciešama atļauja piekļūt krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="3505491405575013121">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Phromium.</translation>
<translation id="2276249127856880228">Padarīt Phromium par noklusējuma pārlūku</translation>
<translation id="6248988683584659830">Meklēt iestatījumus</translation>
<translation id="554637698797403739">Izmantojiet lietotni Phromium savā tālrunī, lai iegūtu labākās Google drošības funkcijas, atrodoties ceļā</translation>
<translation id="7016155178198587734">Vai izrakstīties no Phromium?</translation>
<translation id="5660287988409470276">Šīs cilnes izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Phromium padarīt tās neaktīvas.</translation>
<translation id="8429776045186716992">Pielāgot Phromium profilu</translation>
<translation id="3310436202618971091">Phromium profila nosaukšana</translation>
<translation id="1478750151648434251">Viens no paplašinājumiem pieprasa, lai jūs pierakstītos pārlūkā Phromium</translation>
<translation id="9139712828910812615">Fails <ph name="FILE_NAME" /> var būt bīstams, tādēļ Phromium to bloķēja.</translation>
<translation id="5191618263102115907">Chrome saitē tiek izmantota kamera.</translation>
<translation id="8247508943089477519">Tiek veikta cita darbība pārlūkā Phromium. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="8271488218611798813">Tagad pārlūkā Phromium ir vieglāk izmantot Google kontu, kā arī ir atvieglota lietošana datoros, ko izmanto vairākas personas.</translation>
<translation id="446228390478495078">Iegūstiet ērtu piekļuvi zināmajām, iecienītajām un uzticamajām funkcijām, iestatot Phromium kā noklusējuma pārlūku.</translation>
<translation id="2203435422524224690">Phromium saīsne</translation>
<translation id="3977517784144885449">Pārlūkā Phromium šī lejupielāde tika bloķēta, jo fails parasti netiek lejupielādēts un var būt bīstams.</translation>
<translation id="8088471547690853921">Vai tiešām vēlaties atinstalēt pārlūku Phromium?</translation>
<translation id="6375219077595103062">Saīsnes pievienošana paroļu pārvaldniekam</translation>
<translation id="6388799252195623474">palīdzēt man ar šo</translation>
<translation id="1774421040071124552">Lai turpinātu, pierakstieties pārlūkā Phromium ar kontu <ph name="EMAIL" />. Tas nodrošinās jūsu organizācijas politiku ievērošanu.</translation>
<translation id="2343430845154053061">Phromium logotips datora ekrānā.</translation>
<translation id="2724924185145648602">Phromium ir tīmekļa pārlūks, kas darbina tīmekļa lapas un lietojumprogrammas zibenīgā ātrumā. Tas ir ātrs, stabils un ērti lietojams. Pārlūkojiet tīmekli vēl drošāk ar aizsardzību pret ļaunprātīgu programmatūru un pikšķerēšanu, kas iebūvēta pārlūkā Phromium.</translation>
<translation id="7417453886359805803">Lai vienmēr varētu izmantot un saglabāt Phromium datus savā Google kontā, apstipriniet savu identitāti.</translation>
<translation id="3304683228794166031">Phromium darbojas ātrāk, un funkcijas, kurās tiek izmantota valoda JavaScript, darbojas paredzētajā veidā</translation>
<translation id="6436260184216827876">Funkcija Attēlu meklēšana nav pieejama. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="6442900851116057561">Chromium OS restartēšana</translation>
<translation id="9164801375934097818">Pārlūkā Phromium tiek iepriekš ielādēts vēl vairāk lapu, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="2577121659922309103">Lejupielādējiet pārlūku Phromium savā tālrunī, lai izsekotu cenas un saņemtu brīdinājumus, kad kādā vietnē tiek konstatēts cenas samazinājums.</translation>
<translation id="2052328618318278030">Izslēgts • Phromium nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="3122296739697671126">Laipni lūdzam Phromium profilos!</translation>
<translation id="3472445024540245926">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku Phromium, tiks parādīts aicinājums izmantot ciļņu grupas.</translation>
<translation id="2144084801479939969">Noņemt kontu no pārlūka Phromium</translation>
<translation id="2473490714352939152">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Phromium.</translation>
<translation id="648319183876919572">Droša pārlūkošana ar papildu aizsardzību nodrošina efektīvāku aizsardzību pret bīstamām vietnēm un lejupielādēm</translation>
<translation id="359777544552173333">Atinstalēt Phromium</translation>
<translation id="3890462049854841354">Saīsnes tiek atvērtas pārlūkā Phromium</translation>
<translation id="6616579671682178785">Jūsu organizācija aizver pārlūku Phromium, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots. Pārlūkošanas dati tika izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="8662645370371079862">Katrā profilā tiek glabāta attiecīgā Phromium profila informācija, piemēram, grāmatzīmes, vēsture, paroles un citi dati.</translation>
<translation id="6556755379298048869">Veiciet meklēšanu, izmantojot īsinājumtaustiņu.</translation>
<translation id="7133640529688742768">Uzziniet vairāk par to, <ph name="BEGIN_LINK" />kā pārlūkā Phromium tiek saglabāta jūsu datu konfidencialitāte<ph name="END_LINK" />.</translation>
<translation id="8316065704185291024">Šī iestatījuma izmaiņas tiks lietotas pēc pārlūka Phromium restartēšanas.</translation>
<translation id="2816396636285296289">Pārvaldiet savus paplašinājumus, Phromium galvenajā izvēlnē noklikšķinot uz Paplašinājumi.</translation>
<translation id="8831144879019828189">Varat pārslēgties, lai skatītu paroles no cita Phromium profila.</translation>
<translation id="7017911482442558099">Izmantojiet lietotni Phromium, lai piekļūtu vislabākajiem MI rīkiem, atrodoties ceļā</translation>
<translation id="5784574554904759369">Lai izlabotu pareizrakstības kļūdas, Phromium nosūta teksta laukos ievadīto tekstu Google serveriem.</translation>
<translation id="8485501471305987872">Pāriet uz Phromium paziņojumu iestatījumiem</translation>
<translation id="6600016381025017075">Meklēt informāciju par jebkuru šīs lapas satura daļu</translation>
<translation id="1462793186918694806">Izmaiņas stāsies spēkā, kad restartēsiet Phromium.</translation>
<translation id="7501991510212476553">Tagad pārlūks Phromium tiek palaists, kad tiek palaista operētājsistēma Windows, lai jūs varētu uzreiz sākt pārlūkošanu. Šo funkciju var izslēgt iestatījumos.</translation>
<translation id="7686308613268368175">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Phromium tika atjaunotas cilnes no jūsu pēdējās sesijas. Varat to izslēgt lapā</translation>
<translation id="5266723901802366313">Pārlūkam Phromium ir nepieciešama atļauja izmantot kameru, lai varētu izveidot jūsu apkārtnes 3D karti.</translation>
<translation id="7085315067428293799">Ja saglabāsiet grāmatzīmes arī Google kontā, varēsiet izsekot produktu cenām pārlūkā Phromium un saņemt paziņojumus par cenu kritumiem.</translation>
<translation id="6676384891291319759">Piekļūt internetam</translation>
<translation id="668175097507315160">Chromium OS nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="5279767706090517695">Noņemt šo lietotņu datus no Phromium</translation>
<translation id="6562226321659107531">Pārlūkam Phromium ir nepieciešama atļauja izmantot mikrofonu šajā vietnē.</translation>
<translation id="6712881677154121168">Lejupielādes kļūda: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">Jūsu profilu nevar izmantot, jo tas ir no jaunākas Phromium versijas.

Dažas funkcijas var nebūt pieejamas. Norādiet citu profila direktoriju vai izmantojiet jaunāku Phromium versiju.</translation>
<translation id="4914871493602315663">Lai varētu izmantot personalizēšanu un citas funkcijas, iekļaujiet pārlūku Phromium iestatījumos “Darbības tīmeklī un lietotnēs” un “Saistītie Google pakalpojumi”.</translation>
<translation id="5919390816124912606">Pārlūks Phromium jau ir instalēts visiem lietotājiem jūsu datorā.</translation>
<translation id="5867815953973052697">Pierakstieties pārlūkā Phromium, lai varētu piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs. Šī grāmatzīme tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="7381168634819530324">Paātrina vietņu darbību, izmantojot Phromium programmu V8, bet nedaudz samazina Phromium izturību pret uzbrukumiem. Šis iestatījums ir ieslēgts.</translation>
<translation id="1509688792864707851">{count,plural, =1{Noteikti jūsu Phromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Noteikti jūsu Phromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Noteikti jūsu Phromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumus) tiks dzēsti.}other{Noteikti jūsu Phromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="4702638565169602649">Phromium iesaka pārbaudīt šo failu, jo tas var būt bīstams.</translation>
<translation id="6779406956731413166">Chromium OS darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Tulkot</translation>
<translation id="1564864902402454287">Ja jūsu paroles kādreiz tiks apdraudētas, pārlūkā Phromium saņemsiet paziņojumu</translation>
<translation id="684888714667046800">Nevar izveidot savienojumu ar internetu. Ja izmantojat ugunsmūri, failam <ph name="PRODUCT_EXE_NAME" /> noteikti ir jābūt iekļautam atļaušanas sarakstā.</translation>
<translation id="6200419390448865091">Phromium — <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Nospiediet tabulēšanas taustiņu, lai turpinātu</translation>
<translation id="6862030660799253820">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="6869568587896659271">Ērti piekļūstiet tīmekļa vietnēm zem adreses joslas.</translation>
<translation id="4011399428346318467">Pārlūkā Phromium tika konstatēts, ka paplašinājums “<ph name="EXTENSION_NAME" />” satur ļaunprātīgu programmatūru.</translation>
<translation id="6877155553248388166">meklēšanas apgabala apakšējais labais stūris: <ph name="RIGHT" />% pa labi, <ph name="BOTTOM" />% apakšdaļā</translation>
<translation id="6896758677409633944">Kopēt</translation>
<translation id="6898028264630240901">Varat piespraust kontekstuālos uzdevumus, lai pārlūkošanas laikā uzdotu jautājumus.</translation>
<translation id="1012681980425424211">Iestatiet Phromium kā noklusējuma pārlūku un piespraudiet to uzdevumjoslai</translation>
<translation id="1744625657438211994">&amp;Pārvaldīt Phromium profilus</translation>
<translation id="7264818828956697552">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS" />
            • Tiks atiestatīta jūsu sākumlapa, jaunas cilnes lapa, meklētājprogramma un piespraustās cilnes.
            <ph name="LINE_BREAK" />
            • Tiks atspējoti paplašinājumi.
            <ph name="LINE_BREAK" />
            • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAK" />
            • Tiks atiestatīti Phromium īsinājumtaustiņi.
            <ph name="LINE_BREAKS" />
            Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="6489000842445481390">Ir sasniegts Phromium grāmatzīmju skaita ierobežojums (<ph name="BOOKMARK_LIMIT" />), tāpēc noteiktas jūsu grāmatzīmes vēl nav saglabātas jūsu Google kontā.

Jaunas grāmatzīmes nevar saglabāt jūsu kontā, kamēr neizdzēsīsiet dažas no tām. Ja izrakstīsieties tūlīt, nesaglabātās grāmatzīmes tiks dzēstas.</translation>
<translation id="2645108248038996858">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="6965382102122355670">Labi</translation>
<translation id="6985329841647292029">Chromium OS noteikumi</translation>
<translation id="2947519843530032104">Lai savā kontā (<ph name="ACCOUNT_EMAIL" />) izmantotu un saglabātu Phromium datus, ievadiet ieejas frāzi.</translation>
<translation id="7011190694940573312">Instalēšana neizdevās, jo šī operētājsistēmas versija netiek atbalstīta.</translation>
<translation id="7024536598735240744">Atpakošanas kļūda: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">Pielāgojiet pārlūku Phromium savām vajadzībām</translation>
<translation id="7047386856539490735">Vai šie rezultāti ir noderīgi?</translation>
<translation id="2448910402556368916">Atjaunināt Phromium</translation>
<translation id="7834049737623892628">Ja attēlam nav vērtīga apraksta, pārlūks Phromium mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google.</translation>
<translation id="1803168627715642217">Piekļūstiet MI iespējām, izmantojot lietotni Phromium savā ierīcē (<ph name="DEVICE_TYPE" />)</translation>
<translation id="3321731353906178474">Izmantojiet lietotni Phromium savā tālrunī, lai piekļūtu savām parolēm, cilnēm un citiem datiem, atrodoties ceļā</translation>
<translation id="7141270731789036260">Pielāgot versiju Chrome for Testing</translation>
<translation id="8077731669779275332">Varat izmantot pārlūku Phromium ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs.</translation>
<translation id="611798798247797100">Noņemt paplašinājumu <ph name="EXTENSION_NAME" /> no pārlūka Phromium</translation>
<translation id="7962394294883785044">Jūsu organizācija dzēš Phromium datus, ja šis pārlūks <ph name="TIMEOUT_DURATION" /> netiek izmantots. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="2611686760870033712">Pārlūkam Phromium ir nepieciešama atļauja izmantot kameru šajā vietnē.</translation>
<translation id="71050417052775020">Neizdevās palaist Phromium. Mēģiniet vēlreiz.</translation>
<translation id="4817060241763895497">Atvērtajā ekrānā varat jautāt jebko Gemini pārlūkā Phromium</translation>
<translation id="869358700049263961">Paturiet pārlūku Phromium dokā, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="7094488679340739251">Izmantojiet Phromium ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs</translation>
<translation id="7216228761061470870">Kad izmantojat attēlu meklēšanu, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili.</translation>
<translation id="7802634650401946711">Uzdevumu pārvaldnieks — Phromium</translation>
<translation id="5182547787327636348">Uzdodiet jautājumus par saturu ārpus pārlūka Phromium, piemēram, par citām lietotnēm vai failiem.</translation>
<translation id="1673408954678067905">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt saglabātajai informācijai un citiem datiem visās savās ierīcēs.</translation>
<translation id="5761733252154904648">Sāciet pārlūkošanu uzreiz: tagad pārlūks Phromium var tikt palaists, kad tiek palaista operētājsistēma Windows.</translation>
<translation id="7274695763216404502">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana no rīkjoslas.</translation>
<translation id="7288567540154601580">Cilnes un paplašinājumi</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{Phromium iesaka to noņemt.}zero{Phromium iesaka tos noņemt.}one{Phromium iesaka tos noņemt.}other{Phromium iesaka tos noņemt.}}</translation>
<translation id="1408728332407453335">Lai kopīgotu sistēmas audio, pārejiet uz sistēmas iestatījumiem un iespējojiet iestatījumu “Tikai sistēmas audio ierakstīšana” pārlūkam Phromium. Pēc tam jums būs jārestartē pārlūks Phromium.</translation>
<translation id="7299899569525778554">Meklēšana no darbvirsmas</translation>
<translation id="6194310460545162015">Notiek Phromium atjaunināšana</translation>
<translation id="1098154893096691883">Jūsu preferenču fails ir bojāts vai nederīgs. Phromium nespēj atkopt jūsu iestatījumus.</translation>
<translation id="7324051657739063017">Varat atkārtoti atvērt kontekstuālos uzdevumus, lai uzdotu jautājumus pārlūkošanas laikā.</translation>
<translation id="7024097830259741656">Šeit atrodas jūsu tīmekļa saturs, grāmatzīmes un cits Phromium saturs.</translation>
<translation id="852511575759652041">Jūsu šifrētos datus var lasīt tikai personas, kurām ir jūsu ieejas frāze. Ieejas frāze netiek sūtīta uzņēmumam Google, un uzņēmums Google to neuzglabā. Ja aizmirsīsiet ieejas frāzi vai vēlēsieties mainīt šo iestatījumu, jums būs <ph name="BEGIN_LINK" />jāizdzēš Phromium dati savā kontā<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505">Jūsu sistēmas administrators ir konfigurējis Phromium atvērt <ph name="ALTERNATIVE_BROWSER_NAME" />, lai piekļūtu <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Radās problēma</translation>
<translation id="7198690862684855451">Lai saņemtu turpmākus Phromium atjauninājumus, nepieciešama operētājsistēma macOS 13 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma macOS 12.</translation>
<translation id="3224607549103501149">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Phromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Atveriet Chrome interneta veikalu</translation>
<translation id="8446269872172461565">Rādīt Gemini pārlūkā Phromium sistēmas teknē</translation>
<translation id="7401687852903179959">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="3403529853122418035">Tagad Phromium ir jūsu noklusējuma pārlūks.</translation>
<translation id="5649377421626481711">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Phromium tiek atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to izslēgtu, pārejiet uz lapu</translation>
<translation id="2467776530444676191">Paroļu importēšana pārlūkā Phromium</translation>
<translation id="8814480293815136510">1. Noklikšķiniet uz tālāk redzamās pogas <ph name="BUTTON_LABEL" />.
2. Windows iestatījumos noklikšķiniet uz <ph name="BUTTON_2" />.
3. Windows paziņojumā noklikšķiniet uz <ph name="BUTTON_3" />, lai piespraustu pārlūku Phromium uzdevumu joslai, tādējādi nodrošinot ātru piekļuvi.</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> — Phromium izstrādātāju versija</translation>
<translation id="7450541714075000668">Teksts ir nokopēts</translation>
<translation id="6826407056979820031">Lai izmantotu mikrofonu, piešķiriet pārlūkam Phromium piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="1392131731909663319">Lai saņemtu turpmākus Phromium atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 7.</translation>
<translation id="4512427777724578739">Vai atkārtoti palaist Phromium?</translation>
<translation id="4510527847350985067">Nevar instalēt to pašu Phromium versiju, kas jau šobrīd darbojas. Aizveriet Phromium un mēģiniet vēlreiz.</translation>
<translation id="7510190804000607802">Atgādinājums: vislabākais Google saturs vienmēr par rokai</translation>
<translation id="4735608937705010375">Vietnes, visticamāk, darbosies, kā paredzēts. Aizverot visus Phromium logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Google konta, ja esat pierakstījies pārlūkā Phromium.</translation>
<translation id="7987051132742764178">{0,plural, =1{Pārlūks Phromium pēc 1 minūtes tiks restartēts}zero{Pārlūks Phromium pēc # minūtēm tiks restartēts}one{Pārlūks Phromium pēc # minūtes tiks restartēts}other{Pārlūks Phromium pēc # minūtēm tiks restartēts}}</translation>
<translation id="1904271152425995672">Lai aizsargātu savus datus, ļaujiet pārlūkā Phromium noņemt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis.</translation>
<translation id="7909976731673595773">Automātiski palaidiet pārlūku Phromium, lai uzreiz sāktu pārlūkošanu.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> instalēšanas programma</translation>
<translation id="3301232962183130807">Pārlūkā Phromium tiek izmantota jūsu kamera un mikrofons.</translation>
<translation id="3230129417775002227">Pārlūkā Phromium ir veikti uzlabojumi</translation>
<translation id="1322165820810533683">Tagad pārlūkā Phromium ir pieejams vairāk funkciju.</translation>
<translation id="7624307931717240213">Mēs izmantojam informāciju, lai uzlabotu šo pakalpojumu. Skatiet konfidencialitātes politiku un pakalpojumu sniegšanas noteikumus.</translation>
<translation id="7649070708921625228">Palīdzība</translation>
<translation id="3795437289339745990">Iegūt lietotni Phromium</translation>
<translation id="7658239707568436148">Atcelt</translation>
<translation id="6671257169702988694">Phromium nav jūsu noklusējuma pārlūks.</translation>
<translation id="7270402397025248165">Phromium sinhronizēšana un personalizēšana visās savās ierīcēs</translation>
<translation id="6267574654655324634">Phromium atjauninājums</translation>
<translation id="4868190765388740513">Jūsu darbs ir aizsargāts pārlūkā Phromium</translation>
<translation id="7716950018788545737">Uzdevumi ir pabeigti.</translation>
<translation id="77283119132245232">Nodrošina sistēmas izsekošanas pakalpojumus pārlūkā <ph name="BROWSER_NAME" />. Ja šis pakalpojums ir atspējots, pārlūka izveidotajos veiktspējas izsekošanas datos netiek ietverti sistēmas līmeņa notikumi, piemēram, konteksta maiņas un pavedienu gatavības notikumi.</translation>
<translation id="2680098142787722612">Veicot šo darbību, no šīs ierīces tiks dzēsti pārlūkošanas dati. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Phromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Instalētājam neizdevās izveidot pagaidu katalogu. Lūdzu, pārbaudiet, vai diskā pietiek vietas un vai ir atļauja instalēt programmatūru.</translation>
<translation id="6830826880333833598">Atiestatīt Phromium noklusējuma motīvu</translation>
<translation id="448710321315554838">Lai aizsargātu jūsu darbu pārlūkā Phromium, jūsu organizācija varēs skatīt vai pārvaldīt noteiktu informāciju, kad būsiet pierakstījies pārlūkā Phromium.</translation>
<translation id="7045209483723342691">Iestatiet Phromium kā noklusējuma pārlūku un piespraudiet to uzdevumu joslai</translation>
<translation id="6452735947982563207">Pārlūka Phromium darbības paātrināšana</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> — Phromium Canary</translation>
<translation id="6929858452581400763">Neļaujiet personām, kurām ir piekļuve jūsu interneta datplūsmai, viegli skatīt jūsu apmeklētās vietnes. Phromium izmanto drošu savienojumu, lai meklētu vietnes IP adresi sistēmā DNS (domēnu nosaukumu sistēmā).</translation>
<translation id="7810005234485217901">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai varētu piekļūt.</translation>
<translation id="4343392731007327660">Izvēlieties, kādu saturu kopīgot ar Phromium</translation>
<translation id="3052274192923256457">Šajā ierīcē jau pastāv Phromium profils ar šādu kontu.</translation>
<translation id="7845233973568007926">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē dators.</translation>
<translation id="5674414381037997114">Jūsu meklētājprogramma tika mainīta ārpus pārlūka Phromium. Lai jūs aizsargātu, pārlūkā Phromium tā tika atiestatīta uz sākotnējo noklusējuma meklētājprogrammu. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Pielāgojiet pārlūku Phromium, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="3966946337517395351">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Phromium nosūta ierakstīto tekstu jūsu noklusējuma meklētājprogrammai, lai iegūtu labākus ieteikumus. Inkognito režīmā šis iestatījums ir izslēgts.</translation>
<translation id="3928367799779122681">Nevarēja atjaunināt uz jaunāko Phromium versiju, tādēļ jūs nevarēsiet piekļūt jaunākajām funkcijām un drošības labojumiem.</translation>
<translation id="7872446069773932638">Notiek lejupielāde... Atlikušais laiks: <ph name="SECONDS" /> sekunde(-es).</translation>
<translation id="8492102592995742850">Ja aizmirstat ieejas frāzi vai vēlaties mainīt šo iestatījumu, <ph name="BEGIN_LINK" />izdzēsiet Phromium datus savā kontā<ph name="END_LINK" />.</translation>
<translation id="959404544431817539">Ātri atveriet pakalpojumu Gemini pārlūkā Phromium, kad tas ir nepieciešams.</translation>
<translation id="8889749279816358185">Iestatīt Phromium kā noklusējuma pārlūku</translation>
<translation id="3173775358556080672">Pārlūkā Phromium nedrošie savienojumi tiek automātiski jaunināti uz HTTPS, ja iespējams.</translation>
<translation id="2210801904933897209">Operētājsistēmā Phromium iepriekš pierakstījāties kā lietotājs <ph name="USER_EMAIL_ADDRESS" />. Lai pierakstītos vēlreiz, lūdzu, izmantojiet to pašu kontu.</translation>
<translation id="7291855477503010638">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="5706099517903615644">Šī ir Phromium papildu instalācija, un to nevar izmantot kā noklusējuma pārlūku.</translation>
<translation id="2388440031754359882">No nezināmiem avotiem iegūti paplašinājumi, lietotnes un motīvi var kaitēt ierīcei. Phromium komanda iesaka instalēt tos tikai no veikala <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="8205108509545565485">Izmantojiet pārlūku Phromium savā ierīcē (<ph name="DEVICE_TYPE" />), lai pilnvērtīgi izmantotu Google piedāvātās iespējas</translation>
<translation id="8004582292198964060">Pārlūkprogramma</translation>
<translation id="8010081455002666927">Noteikt automātiski</translation>
<translation id="6421861275173778152">Tiklīdz pārlūkam Phromium tiks sniegta piekļuve, vietnes varēs lūgt jums piekļuvi.</translation>
<translation id="942087293138739513">Piespraudiet pārlūku Phromium uzdevumu joslai, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="80471789339884597">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē visas pārlūkprogrammas.</translation>
<translation id="8054112667659782652">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="8069447462453318634">Atlasiet vienumu “Piespraust rīkjoslai”.</translation>
<translation id="8519423983825025511">Atspējot Phromium darbību fonā lietotnēm</translation>
<translation id="80790299200510644">Attēlu meklēšana</translation>
<translation id="8086881907087796310">Instalēšana neizdevās, jo jūsu dators neatbilst minimālajām aparatūras prasībām.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Google Chrome for Testing</translation>
<translation id="7988414336652558428">Pārlūkam Phromium ir nepieciešama atrašanās vietas atļauja šai vietnei.</translation>
<translation id="1778610353097215460">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku Phromium, tiks parādīts aicinājums iespējot brīdinājumus par cenu izsekošanu.</translation>
<translation id="4182143801062869250">Izmantojiet lietotni Phromium savā tālrunī, lai saņemtu brīdinājumus par cenu kritumu precēm, kas jūs interesē</translation>
<translation id="8118331347066725040">Sūtiet atsauksmes par meklēšanu, izmantojot Lens</translation>
<translation id="849080025203861031">Phromium personalizēšana</translation>
<translation id="8133124826068723441">Chromium OS nevarēja sinhronizēt jūsu datus, jo jūsu domēnā nav pieejama sinhronizācija.</translation>
<translation id="813913629614996137">Notiek inicializēšana...</translation>
<translation id="139377652856781272">Atveriet pakalpojumu Gemini pārlūkā Phromium, izmantojot īsinājumtaustiņu.</translation>
<translation id="8577594891153686998">Phromium pakalpojumu sniegšanas papildu noteikumi</translation>
<translation id="6418547610462348357">Šis fails ir bīstams, tāpēc Phromium to bloķēja.</translation>
<translation id="8177472873527554730">Nevar atrast saturu lapā</translation>
<translation id="6257816439683677727">Lai savā kontā (<ph name="USER_EMAIL" />) izmantotu un saglabātu Phromium datus, ievadiet ieejas frāzi.</translation>
<translation id="820759916613250543">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="8221491193165283816">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet šeit.</translation>
<translation id="8672013454464753607">Lai izmantotu kameru, piešķiriet pārlūkam Phromium piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="8006746139865532235">Phromium nevar pārbaudīt šī paplašinājuma izcelsmi, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Phromium, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp personas informāciju.</translation>
<translation id="5474258904581730105">Ja attēlam nav vērtīga apraksta, pārlūks Phromium mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google. Jebkurā brīdī iestatījumos varat izslēgt šo iespēju.</translation>
<translation id="5375524124600974413">Vai pierakstīties pārlūkā Phromium, izmantojot jaunu profilu?</translation>
<translation id="5242991719841602450">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Phromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt parolēm un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="6524280192518819368">Rādīt pakalpojumu Gemini pārlūkā Phromium sistēmas teknē un ieslēgt īsinājumtaustiņu</translation>
<translation id="2082268001133511745">Pārlūkā <ph name="BEGIN_LINK" />Phromium tiek rādīti brīdinājumi<ph name="END_LINK" /> par nedrošām vietnēm un lejupielādēm</translation>
<translation id="4030955203048827163">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Phromium tika noņemta šāda atļauja: <ph name="PERMISSION" />.</translation>
<translation id="8358344509940735943">Iepērcieties, tulkojiet un identificējiet redzamo saturu, izmantojot kameru iOS lietotnē Phromium.</translation>
<translation id="7062802333437169650">Kvadrātkods, lai pierakstītos pārlūkā Phromium ar kontu <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Palaišanas kļūda: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062">Jūsu organizācija aizver pārlūku Phromium, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots.</translation>
<translation id="8321888067342493336">Saglabāt kā attēlu</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" /> iepriekš izmantoja Phromium</translation>
<translation id="5445795756751365814">Iespējot prasmes pārlūkā Phromium</translation>
<translation id="7329745364783464770">Lai turpinātu izmantot Phromium datus savā Google kontā (<ph name="ACCOUNT_EMAIL" />), atjauniniet pārlūku Phromium.</translation>
<translation id="5255856786869089460">Lai saņemtu turpmākus Phromium atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.</translation>
<translation id="8362914115861174987">Tulkot šādā valodā:</translation>
<translation id="8367705492654390392">Uzdodiet jebkādu jautājumu</translation>
<translation id="8370517070665726704">Autortiesības: <ph name="YEAR" /> Google LLC. Visas tiesības paturētas.</translation>
<translation id="7349410893766975486">Pierakstieties pārlūkā Phromium, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs. Šī parole tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="394196307309768356">Pēc tam jums būs jārestartē pārlūks Phromium.</translation>
<translation id="7466825726005300631">Phromium iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.</translation>
<translation id="264088846642173954">Šī paplašinājuma publicēšanu atcēla izstrādātājs, un paplašinājums, iespējams, nav drošs. Noņemiet to no pārlūka Phromium, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="1867604241588004166">Pārlūkā Phromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="926481158288852551">{0,plural, =1{Restartējiet pārlūku Phromium vienas dienas laikā}zero{Restartējiet pārlūku Phromium # dienu laikā}one{Restartējiet pārlūku Phromium # dienas laikā}other{Restartējiet pārlūku Phromium # dienu laikā}}</translation>
<translation id="8438543370129609977">Kad izmantojat funkciju Attēlu meklēšana, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">Uzzināt vairāk par meklēšanu, izmantojot attēlu meklēšanu pārlūkā Phromium</translation>
<translation id="1069576136282928177">Instalēšanas programmas arhīvs ir bojāts vai nav derīgs. Lejupielādējiet Phromium vēlreiz.</translation>
<translation id="7082388216101480391">Pārlūka Phromium izmantošanai nepieciešama operētājsistēma Windows 10 vai jaunāka versija.</translation>
<translation id="8463672209299734063">Neobligāti: palīdziet uzlabot Chromium OS funkcijas un veiktspēju, automātiski nosūtot Google serveriem diagnostikas un lietojuma datus.</translation>
<translation id="4343027289807602417">Lai izmantotu un saglabātu Phromium datus savā Google kontā, apstipriniet savu identitāti.</translation>
<translation id="6746404578800969443">Tiek rādīti aicinājumi pierakstīties pārlūkā Phromium.</translation>
<translation id="5072642661707587697">Phromium versija ir novecojusi</translation>
<translation id="759684005114911774">Paldies, ka izvēlējāties Phromium kā noklusējuma pārlūku!</translation>
<translation id="5209258538041302334">Pārlūkprogrammā Phromium var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="8525579356836940628">Instalēšana apturēta</translation>
<translation id="6348113608284833604">Izmantojiet lietotni Phromium savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūtu savām parolēm, cilnēm un citiem datiem, atrodoties ceļā</translation>
<translation id="5083347044281842800">Saņemiet brīdinājumu, ja pārlūkā Phromium tiek konstatēts, ka kāda no jūsu parolēm ir iekļauta publiskā datu aizsardzības pārkāpumā.</translation>
<translation id="8555465886620020932">Pakalpojuma kļūda: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">Dažām Phromium funkcijām un paplašinājumiem ir pieejamas saīsnes. Varat izvēlēties tos atkal ieslēgt.</translation>
<translation id="8556420416730706394">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai piekļūtu. Sānu paneļa augšdaļā noklikšķiniet uz pogas “Piespraust”.</translation>
<translation id="856656450041460113">Meklēt valodu sarakstā</translation>
<translation id="9159785833243360958">Pārlūku Phromium pārvalda vairākas organizācijas</translation>
<translation id="8586442755830160949">Autortiesības <ph name="YEAR" /> Chromium autori. Visas tiesības paturētas.</translation>
<translation id="3489957831482527036">Notiek Phromium palaišana...</translation>
<translation id="8624541899164515475">Iestatījumi; tiks atvērta jauna cilne.</translation>
<translation id="8648201657708811153">Google Chrome for Testing nevar iestatīt kā noklusējuma pārlūku.</translation>
<translation id="7150069986792019616">Meklēšana pārlūkā Phromium no jebkuras vietas</translation>
<translation id="1623850835554120265">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Phromium vai meklēsiet, izmantojot universālo lodziņu.</translation>
<translation id="8828478112210313529">Lai nosūtītu šo cilni uz citu ierīci, otrā ierīcē pierakstieties pārlūkā Phromium.</translation>
<translation id="3592747099485557650">Šis ir jūsu Phromium</translation>
<translation id="8712637175834984815">Sapratu!</translation>
<translation id="3388228047978619624">Vai pierakstīties pārlūkā Phromium?</translation>
<translation id="8747073452963259673">meklēšanas apgabala apakšējais kreisais stūris: <ph name="LEFT" />% pa kreisi, <ph name="BOTTOM" />% apakšdaļā</translation>
<translation id="878572486461146056">Instalēšanas kļūda: administrators ir piemērojis grupas politiku, kas neļauj veikt instalēšanu: <ph name="INSTALL_ERROR" />.</translation>
<translation id="8813277370772331957">Atgādināt vēlāk</translation>
<translation id="614494151403742465">Kopīgojiet šo dokumentu ar Gemini pārlūkā Phromium, lai iegūtu īsu kopsavilkumu un uzdotu papildu jautājumus.</translation>
<translation id="6346068443590018348">Vai pierakstīties pārlūkā Phromium?</translation>
<translation id="1468806565762231794">Iestatīt Phromium kā noklusējuma pārlūku un piespraust to uzdevumu joslai</translation>
<translation id="8826492472752484139">Noklikšķiniet uz vienuma Paroļu pārvaldnieks.</translation>
<translation id="8833697763442816810">Chromium OS sistēma</translation>
<translation id="4854784568701005121">Šī valoda tiek izmantota, lai rādītu izvēlnes, iestatījumus, brīdinājumus un citu tekstu pārlūkā Phromium.</translation>
<translation id="8862326446509486874">Jums nav vajadzīgo tiesību, lai instalētu sistēmas līmenī. Mēģiniet vēlreiz palaist instalēšanas programmu kā administrators.</translation>
<translation id="7804139416589625033">Pievienot Phromium profilu</translation>
<translation id="6333867241557949259">ChromiumOS nevarēja saglabāt Phromium datus jūsu Google kontā pierakstīšanās kļūdas dēļ.</translation>
<translation id="2888440364511152939">Saskaņā ar jūsu organizācijas politiku jums ir jāpierakstās pārlūkā Phromium.</translation>
<translation id="7111325571010992010">Phromium mēģina rādīt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="4406716425954955281">Phromium vairs nav jūsu noklusējuma pārlūks. Vai iestatīt Phromium par noklusējuma pārlūku?</translation>
<translation id="2999847959360823770">Nevar atjaunināt Phromium</translation>
<translation id="8944232836376404813">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS" />
            • Tiks atiestatīta jūsu sākumlapa, jaunas cilnes lapa, meklētājprogramma un piespraustās cilnes.
            <ph name="LINE_BREAK" />
            • Tiks atspējoti paplašinājumi.
            <ph name="LINE_BREAK" />
            • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAKS" />
            Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="7461167469691640632">Rādīt vietņu saīsnes pārlūkā Phromium</translation>
<translation id="7394133813796947510">Phromium Enterprise logotips</translation>
<translation id="2476839923452631964">Izmantojiet lietotni Phromium savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūstu Google drošības iespējām, atrodoties ceļā</translation>
<translation id="2041306781031361744">Nevar palaist pārlūku Phromium, jo radās problēma, atverot jūsu profilu. Mēģiniet restartēt pārlūku Phromium.</translation>
<translation id="8355079108092011401">meklēšanai pārlūkā Phromium vai pielāgošanai sadaļā <ph name="BEGIN_LINK" />Iestatījumi<ph name="END_LINK" />.</translation>
<translation id="820370893610994443">Pārvaldīt Phromium profilus</translation>
<translation id="1885039203623228439">Izmantojiet tastatūru, lai pārvietotos starp Gemini pārlūkā Phromium un atvērto cilni.</translation>
<translation id="9018218886431812662">Instalēšana pabeigta</translation>
<translation id="8213523024005590363">Lai uzlabotu Phromium drošību, mēs atspējojām tālāk norādīto paplašinājumu, kas nav norādīts vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienots, jums nezinot.</translation>
<translation id="1376667286722804744">Pierakstieties pārlūkā Phromium</translation>
<translation id="5142314855184111999">Rādīt meklēšanu pārlūkā Phromium Mac izvēļņu joslā un ieslēgt īsinājumtaustiņu</translation>
<translation id="5166485487967090892">Pārlūkā Phromium šī lejupielāde tika bloķēta, jo šajā arhīva failā ir ietverti citi faili, kas, iespējams, slēpj ļaunprātīgu programmatūru</translation>
<translation id="1902493242619542969">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs. Ērti piekļūstiet zināmajām un iecienītajām funkcijām, atjauninot noklusējuma pārlūku uz Phromium. Lai nodrošinātu ātru piekļuvi, pārlūks Phromium tiks piesprausts uzdevumu joslai.</translation>
<translation id="7092992855996941035">Izmantojiet lietotni Phromium savā tālrunī, lai piekļūtu Google labākajiem MI rīkiem</translation>
<translation id="4203475068093609811">Lai iegūtu paroles un citus datus no ierīces <ph name="DEVICE" />, pierakstieties pārlūkā Phromium.</translation>
<translation id="7699507532215026981">Automātiska pierakstīšanās pārlūkā Phromium, kad pierakstāties citos Google pakalpojumos</translation>
<translation id="5571207595456818809">Pārlūks Phromium tika automātiski aizvērts</translation>
<translation id="3670200098293484473">Phromium versija ir novecojusi.</translation>
<translation id="5636382052119887392">{0,plural, =1{Pārlūks Phromium pēc stundas tiks restartēts}zero{Pārlūks Phromium pēc # stundām tiks restartēts}one{Pārlūks Phromium pēc # stundas tiks restartēts}other{Pārlūks Phromium pēc # stundām tiks restartēts}}</translation>
<translation id="9106236359747881194">Atlasiet tekstu, ko meklēt</translation>
<translation id="9197093250229894135">Lai saņemtu turpmākus Phromium atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.1.</translation>
<translation id="7195134700293253698">Atvērt saiti jaunā Phromium &amp;cilnē</translation>
<translation id="911206726377975832">Vai dzēst arī pārlūkošanas datus?</translation>
<translation id="9134482777260927479">Palīdzība mājasdarbos</translation>
<translation id="9148058034647219655">Iziet</translation>
<translation id="8888942844777295083">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Phromium var tikt atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to ieslēgtu, pārejiet uz lapu</translation>
<translation id="1485079858205975514">Sistēmas administrators ir konfigurējis Phromium, lai vietne <ph name="TARGET_URL_HOSTNAME" /> tiktu atvērta papildu pārlūkā.</translation>
<translation id="1096075777207775410">Atkārtoti palaist, lai atjauninātu &amp;Phromium</translation>
<translation id="5762505165968040132">Phromium (mDNS ienākošie savienojumi)</translation>
<translation id="6687502817616773473">Pielāgojiet pārlūku Phromium savām vajadzībām</translation>
<translation id="6554170182570636227">Iespējams, Phromium nedarbosies pareizi, jo tas vairs netiek atbalstīts operētājsistēmās Windows XP un Windows Vista.</translation>
<translation id="8145475184469284022">Izmantojiet pārlūku Phromium, lai piekļūtu Google labākajām drošības funkcijām, atrodoties ceļā</translation>
<translation id="945522503751344254">Sūtīt atsauksmes</translation>
<translation id="1258071069834143371">Kas izmanto pārlūku Phromium?</translation>
<translation id="8272911737374467274">Visaugstākais Phromium drošības līmenis</translation>
<translation id="983803489796659991">Instalēšana neizdevās, jo atjauninājumu serverim nav nekādu jaukšanas datu lietojumprogrammai.</translation>
<translation id="4087190600867587768">Izmantot Phromium, nepierakstoties kontā</translation>
<translation id="985602178874221306">Chromium autori</translation>
<translation id="989970834842471429">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="6649431194696226496">Lai izmantotu atrašanās vietas datus, piešķiriet pārlūkam Phromium piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
