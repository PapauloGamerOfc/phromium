<translation id="2474943719592372017">ค้นหาและถามคำถามได้จากทุกที่ แม้ว่าจะย่อ Phromium อยู่ก็ตาม อนุญาตให้ Phromium ทำงานในเบื้องหลัง</translation>
<translation id="2518372260387069450">คอมพิวเตอร์เครื่องนี้ติดตั้ง Phromium รุ่นที่ใหม่กว่าอยู่แล้ว ถ้าซอฟต์แวร์ไม่ทำงาน โปรดถอนการติดตั้ง Phromium และลองอีกครั้ง</translation>
<translation id="3832895416321159809">{0,plural, =0{Phromium จะเปิดขึ้นมาใหม่ตอนนี้}=1{Phromium จะเปิดขึ้นมาใหม่ใน 1 วินาที}other{Phromium จะเปิดขึ้นมาใหม่ใน # วินาที}}</translation>
<translation id="2775110773501098464">Phromium ต้องการสิทธิ์เข้าถึงพื้นที่เก็บข้อมูลเพื่อดาวน์โหลดไฟล์</translation>
