<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1026101648481255140">ดำเนินการติดตั้งต่อ</translation>
<translation id="1029669172902658969">เปิดอีกครั้งเพื่ออัปเดต &amp;Chromium OS</translation>
<translation id="7962340570690354348">Phromium ขอแนะนำให้คุณตรวจสอบส่วนขยายนี้</translation>
<translation id="2702007788032964762">เมื่อเว็บไซต์ขอโหลดลิงก์ในหน้าเว็บของตนล่วงหน้าแบบส่วนตัว Phromium จะใช้เซิร์ฟเวอร์ของ Google การดำเนินการนี้จะซ่อนตัวตนของคุณจากเว็บไซต์ที่โหลดล่วงหน้า แต่ Google จะทราบถึงเว็บไซต์ที่ได้รับการโหลดล่วงหน้า</translation>
<translation id="1051793555070215510">ช่วยเราปรับปรุงโหมดไม่ระบุตัวตนโดยทำแบบสำรวจนี้ซึ่งใช้เวลาเพียง 1 นาที</translation>
<translation id="1065672644894730302">ค่ากำหนดของคุณไม่สามารถอ่านได้ ฟีเจอร์บางอย่างอาจใช้ไม่ได้และการเปลี่ยนแปลงค่ากำหนดจะไม่ได้รับการบันทึก</translation>
<translation id="4964836565882496625">ผู้ปกครองได้ปิด "สิทธิ์สำหรับเว็บไซต์ แอป และส่วนขยาย" ใน Phromium</translation>
<translation id="8409497136174302488">Phromium ต้องการสิทธิ์เข้าถึงเครือข่ายภายในเพื่อค้นหาและใช้อุปกรณ์ที่อยู่ใกล้เคียง</translation>
<translation id="4388904545107211948">หากต้องการค้นหาฟีเจอร์หรือส่วนขยาย Phromium ที่เฉพาะเจาะจง ให้พิมพ์ทางลัดของฟีเจอร์หรือส่วนขยายนั้นในแถบที่อยู่ แล้วตามด้วยปุ่มบนแป้นพิมพ์ที่เลือกไว้</translation>
<translation id="7188624550427159072">แสดงการค้นหาด้วย Phromium ในถาดระบบและเปิดแป้นพิมพ์ลัด</translation>
<translation id="3689248207461565136">Phromium ต้องการส่งออกรหัสผ่านของคุณ พิมพ์รหัสผ่าน Windows เพื่ออนุญาตให้ดำเนินการ</translation>
<translation id="112640046208448578">ระบุสิ่งหรือสถานที่ต่างๆ แล้วคัดลอกหรือแปลข้อความ เมื่อใช้การค้นหารูปภาพ ระบบจะส่งภาพหน้าจอของหน้าเว็บไปยังเซิร์ฟเวอร์ <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="5414044255592121327"><ph name="BEGIN_LINK" />ลงชื่อเข้าใช้ Phromium<ph name="END_LINK" /> เพื่อตรวจสอบว่ารหัสผ่านของคุณไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="1753507755668601921">คลิกเมนู Phromium</translation>
<translation id="1157985233335035034">ภาษาล่าสุด</translation>
<translation id="1184145431117212167">ติดตั้งไม่สำเร็จเนื่องจากระบบไม่รองรับ Windows เวอร์ชันที่คุณใช้</translation>
<translation id="7861581212703831457">เกี่ยวกับ Phromium</translation>
<translation id="8752630985505435738">รับการแจ้งเตือนการติดตามราคาด้วย Phromium ในโทรศัพท์</translation>
<translation id="1203500561924088507">ขอขอบคุณที่ติดตั้ง คุณต้องรีสตาร์ทเบราว์เซอร์ก่อนใช้ <ph name="BUNDLE_NAME" /></translation>
<translation id="4933432676089063712">มี<ph name="IMPORTANT_UPDATE" />รอดำเนินการอยู่ Phromium จะอัปเดตในครั้งถัดไปที่คุณไม่ได้ใช้งานเป็นเวลา <ph name="IDLE_DURATION" /> เพื่อให้การท่องเว็บของคุณปลอดภัย</translation>
<translation id="1232234696885483911">เมื่อคุณเปิดการค้นหารูปภาพ ระบบจะส่งชื่อหน้า, URL และเนื้อหา รวมถึง PDF ไปยังเซิร์ฟเวอร์โดยอัตโนมัติ <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">เมื่อลงชื่อเข้าใช้อยู่ คุณจะใช้รหัสผ่านและข้อมูลอื่นๆ จากบัญชี Google ใน Phromium ได้ หากต้องการเปลี่ยน ให้ไปที่ "บัญชีของคุณใน Phromium"</translation>
<translation id="7402478829083317456">แสดง Gemini ใน Phromium ในแถบเมนูของ Mac</translation>
<translation id="4902531791098430822">ใช้แป้นพิมพ์ลัดเพื่อเลือกส่วนหนึ่งของหน้าจอใน Gemini ใน Phromium</translation>
<translation id="9002284132405311162">ขณะที่แท็บนี้ไม่มีการใช้งาน ระบบจะเพิ่มพื้นที่ว่างในหน่วยความจำเพื่อให้ใช้ Phromium ได้อย่างรวดเร็วอยู่เสมอ ทั้งนี้คุณจะเลือกยกเว้นให้เว็บไซต์นี้ทำงานตลอดเวลาได้</translation>
<translation id="5561666811965903444">Phromium บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์เป็นอันตราย</translation>
<translation id="1340271056805240721">เมื่อลงชื่อเข้าใช้บริการของ Google อย่าง Gmail หรือ YouTube ด้วย <ph name="USER_EMAIL" /> คุณจะลงชื่อเข้าใช้ Phromium ด้วยบัญชีเดียวกันได้โดยอัตโนมัติ</translation>
<translation id="5048805453292757697">ดาวน์โหลด Phromium ในโทรศัพท์</translation>
<translation id="1290883685122687410">ข้อผิดพลาดในการตั้งค่า: <ph name="METAINSTALLER_EXIT_CODE" /> <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">ตั้งค่าโปรไฟล์ Phromium ใหม่</translation>
<translation id="7871721155662336863">ลองใช้ Gemini ใน Phromium</translation>
<translation id="6569288432960798043">Phromium ต้องการสิทธิ์เข้าถึงบลูทูธเพื่อสำรวจอุปกรณ์บลูทูธ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">ลงชื่อเข้าใช้ Phromium ในโทรศัพท์</translation>
<translation id="1330562121671411446">ตรวจหาภาษา</translation>
<translation id="1619655755195586133">ลบข้อมูลออกจาก Phromium (<ph name="URL" />) ด้วย</translation>
<translation id="1345251407431278948">ปักหมุดแล้ว คุณเข้าถึงการค้นหารูปภาพได้อีกครั้งจากปุ่มใหม่ในแถบเครื่องมือ</translation>
<translation id="1383876407941801731">ค้นหา</translation>
<translation id="2947996037737257951">ใช้แอป Phromium เพื่อท่องเว็บได้ทุกที่ทุกเวลา</translation>
<translation id="141901961143729572">แชร์ความคิดเห็นของคุณ</translation>
<translation id="8355386219605656974">หากต้องการแชร์หน้าต่าง ให้อนุญาตการบันทึกหน้าจอสำหรับ Phromium ใน "การตั้งค่าระบบ"</translation>
<translation id="1478370723027452770">รับความช่วยเหลือเกี่ยวกับ Chrome สำหรับการทดสอบ</translation>
<translation id="8398257182826094665">ลงชื่อเข้าใช้ Phromium เพื่อเข้าถึงข้อมูลที่บันทึกไว้และข้อมูลอื่นๆ จาก <ph name="DEVICE" /></translation>
<translation id="1497802159252041924">ข้อผิดพลาดในการติดตั้ง: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">หน้านี้ได้รับการป้องกัน</translation>
<translation id="3484755999946650557">แชร์แท็บ Phromium</translation>
<translation id="3309377459597801353">ลงชื่อเข้าใช้ Phromium</translation>
<translation id="1547469039832541117">สิ้นสุดงานที่ไฮไลต์ไว้</translation>
<translation id="2354363290397602683">ปักหมุด Phromium</translation>
<translation id="2244728813494358888">เครื่องมือด้านความปลอดภัยของ Phromium</translation>
<translation id="707582364915018531">Phromium ต้องการลบข้อมูลในเครื่องมือจัดการรหัสผ่าน โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{ผู้ดูแลระบบต้องการให้คุณเปิด Phromium ขึ้นมาใหม่เพื่อใช้การอัปเดต}=1{ผู้ดูแลระบบต้องการให้คุณเปิด Phromium ขึ้นมาใหม่เพื่อใช้การอัปเดต หน้าต่างที่ไม่ระบุตัวตนจะไม่เปิดให้อีก}other{ผู้ดูแลระบบต้องการให้คุณเปิด Phromium ขึ้นมาใหม่เพื่อใช้การอัปเดต หน้าต่างที่ไม่ระบุตัวตนจำนวน # หน้าต่างจะไม่เปิดให้อีก}}</translation>
<translation id="5032531544901236587">ใช้ประโยชน์สูงสุดจาก Google ด้วยแอป Phromium ในโทรศัพท์</translation>
<translation id="7311082384439462587">ตรวจสอบการควบคุมที่สำคัญด้านความเป็นส่วนตัวและความปลอดภัยใน Phromium</translation>
<translation id="1640672724030957280">กำลังดาวน์โหลด...</translation>
<translation id="1665602916345474427">ลงชื่อเข้าใช้ด้วย <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, สมาชิก เปิดเมนูบัญชี</translation>
<translation id="4535436467771816034">คุณจะใช้ Phromium ได้ทุกครั้งที่คลิกลิงก์ในข้อความ เอกสาร และแอปอื่นๆ จะมีการปักหมุดไว้ที่แถบงานด้วย</translation>
<translation id="1709772298389099340">ให้สิทธิ์ในระดับสูงขึ้นกับ <ph name="BROWSER_NAME" /></translation>
<translation id="1722488837206509557">สิทธิ์นี้จะช่วยให้คุณสามารถเลือกจากอุปกรณ์ที่พร้อมใช้งานและแสดงเนื้อหาบนอุปกรณ์เหล่านั้น</translation>
<translation id="3550860956769006392">Phromium จะลบข้อมูลการท่องเว็บเร็วๆ นี้</translation>
<translation id="2053384509423635834">Phromium จะพยายามอัปเกรดการนำทางให้เป็นแบบ HTTPS</translation>
<translation id="2516115567501600458">ล้างข้อมูล Phromium แล้ว</translation>
<translation id="8571959122390670188">Phromium จะรีสตาร์ทใน <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">เมื่อ HTTPS ไม่พร้อมใช้งาน Phromium จะใช้การเชื่อมต่อที่ไม่ปลอดภัยโดยไม่แจ้งเตือนคุณ</translation>
<translation id="5872244334553252095">ให้ Phromium ทำงานในพื้นหลัง</translation>
<translation id="2213761221916953829">เพื่อให้ Phromium ปลอดภัยขึ้น เราได้ปิดส่วนขยายบางรายการที่ไม่ได้ระบุไว้ใน <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> และอาจถูกเพิ่มเข้ามาโดยที่คุณไม่รู้ตัว</translation>
<translation id="8807881428325438878">คลิก<ph name="BEGIN_BOLD" />ใช่<ph name="END_BOLD" />ในการแจ้งเตือนของ Windows เพื่อปักหมุด Phromium ไว้ที่แถบงานเพื่อให้เข้าถึงได้รวดเร็ว</translation>
<translation id="6861833596843600606">ติดตั้ง Phromium ใหม่</translation>
<translation id="3950056404221550225">Phromium กำลังพยายาม<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ Phromium ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS" /> นอกจากนี้ คุณยังรับส่วนขยายและข้อมูลอื่นๆ จาก <ph name="DEVICE" /> ได้ด้วย</translation>
<translation id="6114726049187747242">ครั้งถัดไปที่เปิด Phromium ใน <ph name="DEVICE_TYPE" /> คุณจะเห็นข้อความแจ้งให้ใช้เครื่องมือจัดการรหัสผ่านบน Google</translation>
<translation id="1838374766361614909">ล้างการค้นหา</translation>
<translation id="2724678689951174927">หากต้องการลบข้อมูลการท่องเว็บออกจากอุปกรณ์นี้เท่านั้น แต่ยังเก็บข้อมูลดังกล่าวไว้ในบัญชี Google ให้<ph name="BEGIN_LINK" />ออกจากระบบ Phromium<ph name="END_LINK" /></translation>
<translation id="402854649782215414">ดาวน์โหลด Phromium บนโทรศัพท์เพื่อเปิดหรือสร้างกลุ่มแท็บใหม่ได้ทุกที่ทุกเวลา</translation>
<translation id="3191814926523151519">คุณจัดการบัญชี Google ที่ลงชื่อเข้าใช้ได้ บัญชี Google ใช้สำหรับเบราว์เซอร์ Phromium, Play Store, Gmail และอื่นๆ หากต้องการเพิ่มบัญชีให้คนอื่น เช่น สมาชิกในครอบครัว ให้เพิ่มบุคคลใหม่ลงใน <ph name="DEVICE_TYPE" /> แทน <ph name="LINK_BEGIN" />ดูข้อมูลเพิ่มเติม<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ค้นหาด้วยการค้นหารูปภาพ</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ Phromium ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS" /> นอกจากนี้ คุณยังรับบุ๊กมาร์กและข้อมูลอื่นๆ จาก <ph name="DEVICE" /> ได้ด้วย</translation>
<translation id="1880677175115548835">เลือกข้อความ</translation>
<translation id="1236934630660512644">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ Phromium ของคุณ ข้อมูล Phromium เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME" /> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี Google แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น คุณสามารถเลือกที่จะสร้างโปรไฟล์ใหม่เพื่อแยกเก็บข้อมูล Phromium ที่มีอยู่ของคุณ <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium จะช่วยสงวนพลังงานแบตเตอรี่โดยการจำกัดกิจกรรมในเบื้องหลังและเอฟเฟกต์ภาพ เช่น การเลื่อนอย่างราบรื่นและอัตราเฟรมวิดีโอ <ph name="BEGIN_LINK" />ดูข้อมูลเพิ่มเติมเกี่ยวกับโหมดประหยัดพลังงาน<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">บริการ Phromium Updater</translation>
<translation id="5797624919204275541">เมื่อปิดการตั้งค่านี้ คุณจะลงชื่อเข้าใช้เว็บไซต์ของ Google อย่างเช่น Gmail ได้โดยไม่ต้องลงชื่อเข้าใช้ Phromium</translation>
<translation id="6850971726764387814">Phromium ไม่ตอบสนอง เปิดใหม่เลยหรือไม่</translation>
<translation id="8289779763124483945">องค์กร <ph name="MANAGER" /> กำหนดให้คุณต้องลงชื่อเข้าใช้ Phromium</translation>
<translation id="193439633299369377">ต้องรีสตาร์ท Chromium OS เพื่อใช้การอัปเดต</translation>
<translation id="3215238748514810076">Phromium บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์ประเภทนี้ไม่ได้มีการดาวน์โหลดกันโดยทั่วไปและอาจเป็นอันตราย</translation>
<translation id="1953553007165777902">กำลังดาวน์โหลด... เหลืออีก <ph name="MINUTE" /> นาที</translation>
<translation id="8529252122707161160">Phromium ไม่สามารถกำหนดหรือตั้งค่าเบราว์เซอร์เริ่มต้น</translation>
<translation id="197326043290947695">เรียกดูอย่างชาญฉลาดยิ่งขึ้นด้วยการค้นหารูปภาพ</translation>
<translation id="7769772561254542263">ดูสาเหตุที่ Phromium บล็อกบางไฟล์ เปิดในแท็บใหม่</translation>
<translation id="3713013456746186442">โปรดอัปเดตซอฟต์แวร์ Phromium ให้เป็นเวอร์ชันล่าสุดอยู่เสมอ หากปิดใช้หรือหยุดบริการนี้ ซอฟต์แวร์ Phromium ของคุณจะไม่ได้รับการอัปเดต ซึ่งหมายความว่าช่องโหว่ด้านความปลอดภัยที่อาจเกิดขึ้นจะไม่สามารถแก้ไขได้และฟีเจอร์อาจไม่ทำงาน บริการนี้จะถอนการติดตั้งตัวเองเมื่อไม่มีซอฟต์แวร์ Phromium ใช้งานอยู่</translation>
<translation id="5690439379999550641">การดำเนินการนี้จะลบ 1 รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ Phromium ด้วย <ph name="USER_EMAIL" /></translation>
<translation id="2018879682492276940">การติดตั้งไม่สำเร็จ โปรดลองอีกครั้ง</translation>
<translation id="2039417478970545937">การตั้งค่า</translation>
<translation id="4765042254400173473">เลือกว่าจะรวมประวัติการเข้าชม Phromium เพื่อรับประสบการณ์ที่ปรับเปลี่ยนในแบบของคุณมากขึ้นในบริการของ Google หรือไม่</translation>
<translation id="1448229429009113044">ติดตั้งมาใน Phromium เพื่อช่วยคุณสร้าง บันทึก และป้อนรหัสผ่านที่รัดกุมโดยอัตโนมัติ เพิ่มทางลัดเพื่อให้เข้าถึงได้ง่าย</translation>
<translation id="2145664943269651168">คลิกปุ่มปรับแต่ง Phromium ในหน้าแท็บใหม่เพื่อสร้างรูปลักษณ์ใหม่ๆ ให้ Phromium</translation>
<translation id="6052463185672312901">Phromium บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์มีการหลอกลวงและอาจทำการเปลี่ยนแปลงที่ไม่คาดคิดกับอุปกรณ์</translation>
<translation id="3825064703718009924">คุณจะเห็นข้อความแจ้งให้ลองใช้ <ph name="FEATURE_NAME" /> ในครั้งถัดไปที่เปิด Phromium บน iOS</translation>
<translation id="886729435477608858">ระบบจะนำรหัสผ่านและข้อมูลอื่นๆ ของ Phromium ที่คุณบันทึกไว้ในบัญชี Google ออกจากอุปกรณ์นี้ หากต้องการใช้ข้อมูลเหล่านี้ใน Phromium ให้ลงชื่อเข้าใช้อีกครั้ง</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{องค์กรจะลบข้อมูลการท่องเว็บโดยอัตโนมัติเมื่อไม่มีการใช้ Phromium เป็นเวลา 1 นาที ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด ทั้งนี้ แท็บจะยังคงเปิดอยู่}other{องค์กรจะลบข้อมูลการท่องเว็บโดยอัตโนมัติเมื่อไม่มีการใช้ Phromium เป็นเวลา # นาที ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด ทั้งนี้ แท็บจะยังคงเปิดอยู่}}</translation>
