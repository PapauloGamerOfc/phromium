<translation id="8536959233160434213">Phromium ต้องการสิทธิ์ในการแมปสิ่งต่างๆ รอบตัวคุณและติดตามการเคลื่อนไหวของมือ</translation>
<translation id="1077734277628859167">คุณลงชื่อเข้าใช้ด้วย <ph name="USER_EMAIL_ADDRESS" /> ในโปรไฟล์ Phromium อื่นอยู่แล้ว</translation>
<translation id="5512897665247593318">Phromium จะโหลดหน้าเว็บล่วงหน้าซึ่งทำให้ท่องเว็บและค้นหาได้เร็วขึ้น <ph name="BEGIN_LINK" />ดูข้อมูลเพิ่มเติมเกี่ยวกับการโหลดหน้าเว็บล่วงหน้า<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">ช่วยให้ทุกคนบนโลกออนไลน์ปลอดภัยยิ่งขึ้นด้วยการรายงานเว็บไซต์ที่คิดว่าเป็นอันตราย</translation>
<translation id="6624033199018630177">Phromium บล็อกการดาวน์โหลดนี้เนื่องจากคุณปิด Google Safe Browsing จึงยืนยันไฟล์ไม่ได้</translation>
<translation id="3039804643080655517">ลองใช้ Google Lens กับ Phromium ในโทรศัพท์</translation>
<translation id="4594305310729380060">ไปยังเครื่องมือจัดการรหัสผ่านบนอุปกรณ์นี้</translation>
<translation id="8064263528617889755">แอป Phromium</translation>
<translation id="4598116752460667024">ค้นหากระบวนการใดๆ จากรายการ</translation>
<translation id="4613863813562375431">เวอร์ชัน Chromium OS</translation>
<translation id="7245201002247176127">การอัปเดตใกล้จะเสร็จเรียบร้อยแล้ว เปิด Phromium อีกครั้งเพื่อให้การอัปเดตเสร็จสิ้น</translation>
<translation id="8846891938874485868">เพิ่มความเร็วให้เว็บไซต์ด้วยเครื่องมือ V8 ของ Phromium แต่ทำให้ Phromium ต้านทานการโจมตีได้น้อยลงเล็กน้อย</translation>
<translation id="7525500996671436081">เปิดการค้นหาด้วย Phromium</translation>
<translation id="1224842000407297331">โปรไฟล์ Phromium</translation>
<translation id="4956303519269880412">คำเตือน: Phromium ไม่สามารถป้องกันไม่ให้ส่วนขยายบันทึกประวัติการท่องเว็บได้ หากคุณต้องการปิดใช้ส่วนขยายนี้ในโหมดไม่ระบุตัวตน ให้ยกเลิกการเลือกตัวเลือกนี้</translation>
<translation id="2708255035805733225">หากคุณแชร์รายงานการใช้งาน Phromium ด้วย รายงานดังกล่าวจะรวม URL ที่คุณเข้าชม</translation>
<translation id="4673710618874938871">ลงชื่อเข้าใช้ด้วย <ph name="USER_NAME" />, สมาชิก เปิดเมนูบัญชี</translation>
<translation id="1883292567514549610">ดูเหมือนว่าโปรไฟล์กำลังถูกใช้งานโดยกระบวนการอื่นของ Phromium (<ph name="PROCESS_ID" />) บนคอมพิวเตอร์อีกเครื่อง (<ph name="HOST_NAME" />) Phromium ล็อกโปรไฟล์ไว้เพื่อไม่ให้โปรไฟล์เกิดความเสียหาย หากคุณมั่นใจว่าไม่มีกระบวนการอื่นใดกำลังใช้โปรไฟล์นี้อยู่ คุณสามารถปลดล็อกโปรไฟล์และเปิด Phromium ใหม่</translation>
<translation id="4680828127924988555">ยกเลิกการติดตั้ง</translation>
<translation id="1889305042180577023">ยังไม่ได้บันทึกข้อมูล Phromium บางอย่างของคุณลงในบัญชี Google โปรดรอสักครู่ก่อนออกจากระบบ หากคุณออกจากระบบตอนนี้ ระบบจะลบข้อมูลนี้</translation>
<translation id="8079525505870459051">เมื่อลงชื่อเข้าใช้อยู่ คุณจะใช้รหัสผ่านและข้อมูลอื่นๆ จากบัญชี Google ใน Phromium ได้ โดยสามารถใช้ <ph name="SHORTCUT" /> เพื่อเปลี่ยนการตั้งค่าบริการของ Google</translation>
<translation id="2171507067211697961">ก่อนหน้านี้มีผู้ลงชื่อเข้าใช้ Phromium ในคอมพิวเตอร์นี้ด้วยชื่อ <ph name="ACCOUNT_EMAIL_LAST" /> โปรดสร้างผู้ใช้ Phromium ใหม่เพื่อเก็บข้อมูลแยก</translation>
<translation id="4724676981607797757">การติดตั้งไม่สำเร็จเนื่องจากเกิดข้อผิดพลาดเกี่ยวกับโปรโตคอลที่ไม่รองรับ</translation>
<translation id="6925701206088903005">ปิด Phromium ใช่ไหม</translation>
<translation id="4514755609496543621">ระบบเพิ่งนำการอัปเดตความปลอดภัยพิเศษไปใช้กับ Phromium รีสตาร์ทเลย แล้วเราจะคืนค่าแท็บให้คุณ</translation>
<translation id="8673673368917636496">คุณไม่ได้เข้าชมเมื่อเร็วๆ นี้ Phromium นำสิทธิ์เข้าถึง<ph name="PERMISSION_1" /> <ph name="PERMISSION_2" /> และอีก <ph name="COUNT" /> รายการออกแล้ว</translation>
<translation id="3638319732826965647">หาก Gemini ใน Phromium เปิดอยู่ แผงด้านข้างจะเปิดอยู่เมื่อสร้างแท็บใหม่</translation>
<translation id="479167709087336770">การดำเนินการนี้จะใช้โปรแกรมตรวจตัวสะกดแบบเดียวกับใน Google Search ข้อความที่คุณพิมพ์ในเบราว์เซอร์จะส่งไปยัง Google คุณปรับเปลี่ยนลักษณะการทำงานนี้ได้ทุกเมื่อในการตั้งค่า</translation>
<translation id="2659245507243672392">ใช้ Phromium โดยไม่มีบัญชี</translation>
<translation id="166411027652942990">กฎขาเข้าสำหรับ Phromium เพื่ออนุญาตการเข้าชมแบบ mDNS</translation>
<translation id="6031862420354068813">เปิดอีกครั้งเพื่ออัปเดต Phromium</translation>
<translation id="4918086044614829423">ยอมรับ</translation>
<translation id="4918844574251943176">คัดลอกรูปภาพแล้ว</translation>
<translation id="1531905832227009774">ลงชื่อเข้าใช้ Phromium เพื่อเข้าถึงเรื่องรออ่านและข้อมูลอื่นๆ ในอุปกรณ์ทุกเครื่อง</translation>
<translation id="4319892378006430019">Phromium กำลังอยู่ในโหมดทำงานในพื้นหลัง</translation>
<translation id="8972359100025490790">คลิกเพื่อปิดกล่องโต้ตอบการลงชื่อเข้าใช้ Phromium</translation>
<translation id="3639078149590125530">โปรไฟล์ Phromium ช่วยให้คุณแยกข้อมูลต่างๆ ใน Phromium ออกจากกันได้ สร้างโปรไฟล์สำหรับเพื่อนและครอบครัว หรือแยกการทำงานออกจากความบันเทิง</translation>
<translation id="7141327976224964788">ผู้เยี่ยมชมสามารถใช้ Phromium โดยไม่ทิ้งร่องรอยไว้</translation>
<translation id="7007327521155149139">บัญชีของคุณใน Phromium</translation>
<translation id="5973804420920585431">เพิ่มตัวคุณเองใน Phromium</translation>
<translation id="504699503110800016">เปิดเมนูรายการเพิ่มเติม</translation>
<translation id="2497925691306722252">เข้าถึงแอป Google โปรดทั้งหมดด้วย Phromium ใน <ph name="DEVICE_TYPE" /></translation>
<translation id="8678196879882043620">Phromium ต้องการสิทธิ์ในการติดตามการเคลื่อนไหวของมือ</translation>
<translation id="3397880081430454820">คุณไม่ได้เข้าชมเมื่อเร็วๆ นี้ Phromium นำสิทธิ์เข้าถึง<ph name="PERMISSION_1" /> <ph name="PERMISSION_2" /> และ<ph name="PERMISSION_3" />ออกแล้ว</translation>
<translation id="9114243566897924763">ลงชื่อเข้าใช้ Phromium</translation>
<translation id="5174969993834422967">คุณมักจะบล็อกการแจ้งเตือน หากต้องการให้เว็บไซต์ส่งการแจ้งเตือน ให้คลิกไอคอนการแจ้งเตือนที่มุมขวาของแถบตําแหน่ง</translation>
<translation id="5174983315706567306">มีพื้นที่ในดิสก์ไม่เพียงพอ</translation>
<translation id="7698884672439844280">บัญชี Phromium ต้องมีการตรวจสอบสิทธิ์อีกครั้ง</translation>
<translation id="5629965056131882780">ดำเนินการต่อจากที่ค้างไว้ด้วย Phromium บน iOS</translation>
<translation id="874294566462998787">ออกจากระบบ Phromium</translation>
<translation id="5234764350956374838">ปิด</translation>
<translation id="8605581794204249702">เปิดลิงก์ในหน้าต่างที่ไม่ระบุตัวตนของ Phromium</translation>
<translation id="8722804301463582643">ดาวน์โหลดแอป Phromium เพื่อบันทึกรหัสผ่านได้ทุกที่ทุกเวลา</translation>
<translation id="6253936671561887082">เปิด Phromium ขึ้นมาใหม่เพื่อให้การเปลี่ยนแปลงมีผล</translation>
<translation id="7405713141437293142">หากต้องการส่งแท็บนี้ไปยังอุปกรณ์อื่น ให้ลงชื่อเข้าใช้ Phromium ในอุปกรณ์ทั้ง 2 เครื่อง</translation>
<translation id="5286907366254680517">ตรวจพบ</translation>
<translation id="2224284460884535818">ดาวน์โหลดแอป Phromium</translation>
<translation id="1426207087952749578">เมื่อท่องเว็บในโหมดไม่ระบุตัวตน Phromium จะแจ้งเตือนคุณก่อนโหลดเว็บไซต์โดยใช้การเชื่อมต่อที่ไม่ปลอดภัย</translation>
<translation id="8108751453879231987">ค้นหาด้วย Phromium</translation>
<translation id="7780358745459835678">บริการภายในของ Phromium Updater</translation>
<translation id="6956753580765202069">ใช้พร้อมกับฟีเจอร์อื่นๆ ของ Gemini ใน Phromium</translation>
<translation id="5346389065299425353">เจาะลึกการค้นหาด้วยการเพิ่มแท็บ ไฟล์ และเครื่องมือหลายรายการ</translation>
<translation id="8684266995248242891">ดูภาพรวมของเอกสารนี้อย่างรวดเร็วและถามคำถามด้วย Gemini ใน Phromium</translation>
<translation id="586104673506947714">Phromium พบคำแนะนำด้านความปลอดภัยบางอย่างที่คุณควรตรวจสอบ</translation>
<translation id="4657908558997566735">โปรไฟล์ Phromium อื่นๆ</translation>
<translation id="6097378010983112326">Phromium OS บันทึกข้อมูล Phromium ในบัญชี Google ไม่ได้เนื่องจากรายละเอียดการลงชื่อเข้าใช้บัญชีของคุณไม่ใช่ข้อมูลปัจจุบัน</translation>
<translation id="385020720581757591">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ Phromium ของคุณ ข้อมูล Phromium เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME" /> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี Google แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">รหัสเพิ่มเติม: <ph name="EXTRA_CODE" /></translation>
<translation id="3729704134418183937">รวม Phromium ไว้ในกิจกรรมบนเว็บและแอปเพื่อรับการปรับเปลี่ยนในแบบของคุณ</translation>
<translation id="2756028035855809142">เปิดการค้นหาด้วย Phromium</translation>
<translation id="4375021373215585423">ดูสาเหตุที่ Phromium บล็อกบางไฟล์</translation>
