<translation id="264088846642173954">นักพัฒนาซอฟต์แวร์เลิกเผยแพร่ส่วนขยายนี้แล้วและอาจไม่ปลอดภัย นำส่วนขยายดังกล่าวออกจาก Phromium เพื่อไม่ให้ดูและเปลี่ยนแปลงข้อมูลของคุณในเว็บไซต์ที่เข้าชม รวมถึงข้อมูลส่วนบุคคลได้อีกต่อไป</translation>
<translation id="1867604241588004166">Phromium จำเป็นต้องยืนยันว่าเป็นคุณก่อนจึงจะบันทึกข้อมูลบางอย่างในบัญชี Google และใช้ในอุปกรณ์ทุกเครื่องได้ หากคุณออกจากระบบตอนนี้ ระบบจะลบข้อมูลนี้</translation>
<translation id="926481158288852551">{0,plural, =1{เปิด Phromium ขึ้นมาใหม่ภายใน 1 วัน}other{เปิด Phromium ขึ้นมาใหม่ภายใน # วัน}}</translation>
<translation id="8438543370129609977">เมื่อคุณใช้ฟีเจอร์ค้นหารูปภาพ ระบบจะส่งชื่อหน้า, URL และเนื้อหา รวมถึง PDF ไปยังเซิร์ฟเวอร์ <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">ดูข้อมูลเพิ่มเติมเกี่ยวกับการค้นหาด้วยฟีเจอร์ค้นหารูปภาพใน Phromium</translation>
<translation id="1069576136282928177">การเก็บข้อมูลของโปรแกรมติดตั้งเสียหายหรือไม่ถูกต้อง โปรดดาวน์โหลด Phromium อีกครั้ง</translation>
<translation id="7082388216101480391">Phromium ต้องใช้ Windows 10 ขึ้นไป</translation>
<translation id="8463672209299734063">ไม่บังคับ: ช่วยปรับปรุงฟีเจอร์และประสิทธิภาพของ Chromium OS โดยการส่งข้อมูลการวินิจฉัยและการใช้งานให้ Google โดยอัตโนมัติ</translation>
<translation id="4343027289807602417">โปรดยืนยันว่าเป็นคุณเพื่อใช้และบันทึกข้อมูล Phromium ในบัญชี Google</translation>
<translation id="6746404578800969443">แสดงข้อความแจ้งให้ลงชื่อเข้าใช้ Phromium</translation>
<translation id="5072642661707587697">Phromium ล้าสมัย</translation>
<translation id="759684005114911774">ขอขอบคุณที่เลือกใช้ Phromium เป็นเบราว์เซอร์เริ่มต้น</translation>
<translation id="5209258538041302334">Phromium จะตรวจสอบรหัสผ่านได้เมื่อคุณบันทึกรหัสผ่านไว้</translation>
<translation id="8525579356836940628">หยุดการติดตั้งแล้ว</translation>
<translation id="6348113608284833604">เข้าถึงรหัสผ่าน แท็บ และอื่นๆ ได้ทุกที่ทุกเวลาด้วยแอป Phromium ในโทรศัพท์<ph name="DEVICE_TYPE" /></translation>
<translation id="5083347044281842800">รับคำเตือนหาก Phromium พบรหัสผ่านของคุณในการละเมิดข้อมูลสาธารณะ</translation>
<translation id="8555465886620020932">ข้อผิดพลาดในการบริการ: <ph name="SERVICE_ERROR" /></translation>
<translation id="6712621562501854928">ฟีเจอร์และส่วนขยายบางอย่างของ Phromium มาพร้อมทางลัด ซึ่งคุณเลือกเปิดใช้อีกครั้งได้</translation>
<translation id="8556420416730706394">คุณสามารถปักหมุดการค้นหารูปภาพเพื่อให้เข้าถึงได้ง่าย โดยการคลิกปุ่ม "ปักหมุด" ที่ด้านบนของแผงด้านข้าง</translation>
<translation id="856656450041460113">ค้นหารายการภาษา</translation>
<translation id="9159785833243360958">องค์กรหลายแห่งจัดการ Phromium</translation>
<translation id="8586442755830160949">ลิขสิทธิ์ <ph name="YEAR" /> The Chromium Authors สงวนลิขสิทธิ์</translation>
<translation id="3489957831482527036">กำลังเปิด Phromium...</translation>
<translation id="8624541899164515475">การตั้งค่า เปิดในแท็บใหม่</translation>
<translation id="8648201657708811153">ไม่สามารถตั้ง Google Chrome สำหรับการทดสอบเป็นเบราว์เซอร์เริ่มต้นได้</translation>
<translation id="7150069986792019616">ค้นหาด้วย Phromium ได้จากทุกที่</translation>
<translation id="1623850835554120265">อีกทั้งยังควบคุมหน้าที่จะแสดงเมื่อคุณเปิด Phromium หรือทำการค้นหาจากแถบอเนกประสงค์ด้วย</translation>
<translation id="8828478112210313529">หากต้องการส่งแท็บนี้ไปยังอุปกรณ์อื่น ให้ลงชื่อเข้าใช้ Phromium ในอุปกรณ์นั้น</translation>
<translation id="3592747099485557650">นี่คือ Phromium ของคุณ</translation>
<translation id="8712637175834984815">รับทราบ</translation>
<translation id="3388228047978619624">ลงชื่อเข้าใช้ Phromium ไหม</translation>
<translation id="8747073452963259673">มุมซ้ายล่างของพื้นที่การค้นหา: ซ้าย <ph name="LEFT" />% ล่าง <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ข้อผิดพลาดในการติดตั้ง: ผู้ดูแลเครือข่ายของคุณใช้นโยบายระดับกลุ่มซึ่งป้องกันการติดตั้ง: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">เตือนฉันภายหลัง</translation>
<translation id="614494151403742465">แชร์เอกสารนี้กับ Gemini ใน Phromium เพื่อดูภาพรวมคร่าวๆ และถามคำถามต่อเนื่อง</translation>
<translation id="6346068443590018348">ลงชื่อเข้าใช้ Phromium ไหม</translation>
<translation id="1468806565762231794">ตั้ง Phromium เป็นเบราว์เซอร์เริ่มต้นและปักหมุดไว้ที่แถบงาน</translation>
<translation id="8826492472752484139">คลิก "เครื่องมือจัดการรหัสผ่าน"</translation>
<translation id="8833697763442816810">ระบบ Chromium OS</translation>
<translation id="4854784568701005121">ระบบจะใช้ภาษานี้เพื่อแสดงเมนู การตั้งค่า การแจ้งเตือน และข้อความอื่นๆ ใน Phromium</translation>
<translation id="8862326446509486874">คุณไม่มีสิทธิ์ในการติดตั้งระดับระบบ ทดลองใช้งานโปรแกรมติดตั้งอีกครั้งโดยกำหนดให้เป็นผู้ดูแลระบบ</translation>
<translation id="7804139416589625033">เพิ่มโปรไฟล์ Phromium</translation>
<translation id="6333867241557949259">Phromium OS บันทึกข้อมูล Phromium ในบัญชี Google ไม่ได้เนื่องจากเกิดข้อผิดพลาดในการลงชื่อเข้าใช้</translation>
<translation id="2888440364511152939">องค์กรกำหนดให้คุณต้องลงชื่อเข้าใช้ Phromium</translation>
<translation id="7111325571010992010">Phromium กำลังพยายามแสดงรหัสผ่าน พิมพ์รหัสผ่าน Windows ของคุณเพื่อแสดงรหัสผ่าน</translation>
<translation id="4406716425954955281">Phromium ไม่ใช่เบราว์เซอร์เริ่มต้นของคุณอีกต่อไป ทำให้ Phromium เป็นเบราว์เซอร์เริ่มต้นไหม</translation>
<translation id="2999847959360823770">อัปเดต Phromium ไม่ได้</translation>
<translation id="8944232836376404813">การดำเนินการนี้จะทำสิ่งต่อไปนี้
          <ph name="LINE_BREAKS" />
            • รีเซ็ตหน้าเริ่มต้นใช้งาน หน้าแท็บใหม่ เครื่องมือค้นหา และแท็บที่ปักหมุดไว้
            <ph name="LINE_BREAK" />
            • ปิดใช้ส่วนขยาย
            <ph name="LINE_BREAK" />
            • ลบคุกกี้และข้อมูลเว็บไซต์ชั่วคราวอื่นๆ
            <ph name="LINE_BREAKS" />
            การดำเนินการนี้จะไม่มีผลกับบุ๊กมาร์ก ประวัติการเข้าชม และรหัสผ่านที่บันทึกไว้</translation>
<translation id="7461167469691640632">แสดงทางลัดเว็บไซต์ Phromium</translation>
<translation id="7394133813796947510">โลโก้ Phromium Enterprise</translation>
<translation id="2476839923452631964">นำความปลอดภัยของ Google ไปได้ทุกที่ทุกเวลาด้วยแอป Phromium ใน <ph name="DEVICE_TYPE" /></translation>
<translation id="2041306781031361744">เริ่ม Phromium ไม่ได้เนื่องจากเกิดข้อผิดพลาดขณะเปิดโปรไฟล์ ลองรีสตาร์ท Phromium</translation>
<translation id="8355079108092011401">เพื่อค้นหาด้วย Phromium หรือปรับแต่งใน<ph name="BEGIN_LINK" />การตั้งค่า<ph name="END_LINK" /></translation>
<translation id="820370893610994443">จัดการโปรไฟล์ Phromium</translation>
<translation id="1885039203623228439">ใช้แป้นพิมพ์เพื่อไปยังส่วนต่างๆ ระหว่าง Gemini ใน Phromium กับแท็บที่เปิดอยู่</translation>
<translation id="9018218886431812662">ติดตั้งเสร็จสมบูรณ์แล้ว</translation>
<translation id="8213523024005590363">เพื่อให้ Phromium ปลอดภัยขึ้น เราได้ปิดส่วนขยายต่อไปนี้ซึ่งไม่ได้แสดงอยู่ใน <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> และอาจมีการเพิ่มเข้ามาโดยที่คุณไม่รู้ตัว</translation>
<translation id="1376667286722804744">ลงชื่อเข้าใช้ Phromium</translation>
<translation id="5142314855184111999">แสดงการค้นหาด้วย Phromium ในแถบเมนูของ Mac และเปิดแป้นพิมพ์ลัด</translation>
<translation id="5166485487967090892">Phromium บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์ที่เก็บถาวรมีไฟล์อื่นๆ ที่อาจซ่อนมัลแวร์ไว้</translation>
<translation id="1902493242619542969">ซิงค์รหัสผ่าน บุ๊กมาร์ก และประวัติการเข้าชมในอุปกรณ์ต่างๆ ได้อย่างสมบูรณ์แบบ เข้าถึงฟีเจอร์ที่คุณรู้จักและชื่นชอบได้อย่างง่ายดายโดยอัปเดตเบราว์เซอร์เริ่มต้นเป็น Phromium ระบบจะปักหมุด Phromium ไว้ที่แถบงานเพื่อให้เข้าถึงได้อย่างรวดเร็ว</translation>
<translation id="7092992855996941035">ใช้เครื่องมือ AI ที่ดีที่สุดของ Google ด้วยแอป Phromium ในโทรศัพท์</translation>
<translation id="4203475068093609811">ลงชื่อเข้าใช้ Phromium เพื่อเข้าถึงรหัสผ่านและข้อมูลอื่นๆ จาก <ph name="DEVICE" /></translation>
<translation id="7699507532215026981">ลงชื่อเข้าใช้ Phromium เมื่อคุณลงชื่อเข้าใช้บริการอื่นๆ ของ Google</translation>
<translation id="5571207595456818809">มีการปิด Phromium โดยอัตโนมัติ</translation>
<translation id="3670200098293484473">Phromium ล้าสมัย</translation>
<translation id="5636382052119887392">{0,plural, =1{Phromium จะเปิดขึ้นมาใหม่ใน 1 ชั่วโมง}other{Phromium จะเปิดขึ้นมาใหม่ใน # ชั่วโมง}}</translation>
<translation id="9106236359747881194">เลือกข้อความที่จะค้นหา</translation>
<translation id="9197093250229894135">คุณจะต้องใช้ Windows 10 ขึ้นไปเพื่อรับการอัปเดต Phromium ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ Windows 8.1</translation>
<translation id="7195134700293253698">เปิดลิงก์ใน Phromium แท็บใหม่</translation>
<translation id="911206726377975832">ลบข้อมูลการท่องเว็บด้วยหรือไม่</translation>
<translation id="9134482777260927479">ความช่วยเหลือเรื่องการบ้าน</translation>
<translation id="9148058034647219655">ออก</translation>
<translation id="8888942844777295083">ดำเนินการต่อจากที่ค้างไว้: Phromium สามารถคืนค่าแท็บทุกครั้งที่คุณรีสตาร์ท หากต้องการเปิดตัวเลือกนี้ ให้ไปที่</translation>
<translation id="1485079858205975514">ผู้ดูแลระบบของคุณกำหนดค่าให้ Phromium เปิดเบราว์เซอร์สำรองเพื่อเข้าถึง <ph name="TARGET_URL_HOSTNAME" /></translation>
<translation id="1096075777207775410">เปิดอีกครั้งเพื่ออัปเดต Phromium</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">ปรับเปลี่ยน Phromium ในแบบของคุณ</translation>
<translation id="6554170182570636227">Phromium อาจทำงานไม่ถูกต้องเพราะไม่รองรับ Windows XP หรือ Windows Vista อีกต่อไป</translation>
<translation id="8145475184469284022">ใช้ฟีเจอร์ความปลอดภัยที่ดีที่สุดของ Google ได้ทุกที่ทุกเวลาด้วย Phromium</translation>
<translation id="945522503751344254">ส่งความคิดเห็น</translation>
<translation id="1258071069834143371">ใครกำลังใช้ Phromium อยู่</translation>
<translation id="8272911737374467274">รับการรักษาความปลอดภัยที่เข้มงวดที่สุดของ Phromium</translation>
<translation id="983803489796659991">การติดตั้งไม่สำเร็จเนื่องจากเซิร์ฟเวอร์การอัปเดตไม่มีข้อมูลแฮชสำหรับแอปพลิเคชัน</translation>
<translation id="4087190600867587768">ใช้ Phromium โดยไม่มีบัญชี</translation>
<translation id="985602178874221306">The Chromium Authors</translation>
<translation id="989970834842471429">เลือกข้อความหรือรูปภาพเพื่อค้นหาด้วยการค้นหารูปภาพ</translation>
<translation id="6649431194696226496">หากต้องการใช้ตำแหน่ง โปรดให้สิทธิ์เข้าถึงแก่ Phromium ใน<ph name="BEGIN_LINK" />การตั้งค่าระบบ<ph name="END_LINK" /></translation>
</translationbundle>