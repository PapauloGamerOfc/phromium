<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kn">
<translation id="1026101648481255140">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ಪುನರಾರಂಭಿಸಿ</translation>
<translation id="1029669172902658969">&amp;ChromiumOS ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="7962340570690354348">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲು Phromium ನಿಮಗೆ ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ</translation>
<translation id="2702007788032964762">ತಮ್ಮ ಪುಟದಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ಖಾಸಗಿಯಾಗಿ ಪ್ರಿಲೋಡ್ ಮಾಡಲು ಸೈಟ್ ಕೇಳಿದಾಗ, Phromium, Google ಸರ್ವರ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ. ಇದು ಪ್ರಿಲೋಡ್ ಮಾಡಿದ ಸೈಟ್‌ನಿಂದ ನಿಮ್ಮ ಗುರುತನ್ನು ಮರೆಮಾಡುತ್ತದೆ, ಆದರೆ ಯಾವ ಸೈಟ್‌ಗಳು ಪ್ರಿಲೋಡ್ ಆಗುತ್ತವೆ ಎಂಬುದನ್ನು Google ತಿಳಿಯುತ್ತದೆ.</translation>
<translation id="1051793555070215510">ಈ 1 ನಿಮಿಷದ ಸಮೀಕ್ಷೆಯಲ್ಲಿ ಭಾಗವಹಿಸುವ ಮೂಲಕ ಅಜ್ಞಾತ ಮೋಡ್‌ ಅನ್ನು ಸುಧಾರಿಸಲು ನಮಗೆ ಸಹಾಯ ಮಾಡಿ.</translation>
<translation id="1065672644894730302">ನಿಮ್ಮ ಪ್ರಾಶಸ್ತ್ಯಗಳನ್ನು ರೀಡ್‌ ಮಾಡಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ಅಲ್ಲದೇ, ಕೆಲವು ವೈಶಿಷ್ಟ್ಯಗಳು ಲಭ್ಯವಿಲ್ಲದಿರಬಹುದು ಮತ್ತು ಪ್ರಾಶಸ್ತ್ಯಗಳಲ್ಲಿ ಮಾಡಿದ ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸಲಾಗುವುದಿಲ್ಲ.</translation>
<translation id="4964836565882496625">ನಿಮ್ಮ ಪೋಷಕರು Phromium ನಲ್ಲಿ "ಸೈಟ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ವಿಸ್ತರಣೆಗಳಿಗಾಗಿ ಅನುಮತಿಗಳನ್ನು" ಆಫ್ ಮಾಡಿದ್ದಾರೆ</translation>
<translation id="8409497136174302488">ಸಮೀಪದ ಸಾಧನಗಳನ್ನು ಅನ್ವೇಷಿಸಲು ಮತ್ತು ಬಳಸಲು Phromium ಗೆ ನಿಮ್ಮ ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಆ್ಯಕ್ಸೆಸ್‌ನ ಅಗತ್ಯವಿದೆ</translation>
<translation id="4388904545107211948">ನಿರ್ದಿಷ್ಟ Phromium ಫೀಚರ್ ಅಥವಾ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ಹುಡುಕಲು, ವಿಳಾಸ ಪಟ್ಟಿಯಲ್ಲಿ ಅದರ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ, ನಂತರ ನೀವು ಆಯ್ಕೆಮಾಡಿದ ಕೀಬೋರ್ಡ್ ಕೀಯನ್ನು ಟೈಪ್ ಮಾಡಿ</translation>
<translation id="7188624550427159072">ಸಿಸ್ಟಮ್ ಟ್ರೇನಲ್ಲಿ Phromium ಮೂಲಕ ಹುಡುಕಿ ಅನ್ನು ತೋರಿಸಿ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="3689248207461565136">Phromium ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ರಫ್ತು ಮಾಡಲು ಬಯಸುತ್ತದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="112640046208448578">ವಸ್ತುಗಳನ್ನು ಅಥವಾ ಸ್ಥಳಗಳನ್ನು ಗುರುತಿಸಿ ಮತ್ತು ಪಠ್ಯವನ್ನು ಕಾಪಿ ಮಾಡಿ ಅಥವಾ ಅನುವಾದಿಸಿ. ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿದಾಗ, ಪುಟದ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ ಅನ್ನು ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿದೆ.</translation>
<translation id="5414044255592121327">ನಿಮ್ಮ ಇತರ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಡೇಟಾ ಉಲ್ಲಂಘನೆ ಮತ್ತು ಭದ್ರತಾ ಸಮಸ್ಯೆಗಳಿಂದ ಸುರಕ್ಷಿತವಾಗಿವೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಲು, <ph name="BEGIN_LINK" />Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Phromium ಮೆನು ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="1157985233335035034">ಇತ್ತೀಚಿನ ಭಾಷೆಗಳು</translation>
<translation id="1184145431117212167">ನಿಮ್ಮ Windows ಆವೃತ್ತಿಯನ್ನು ಬೆಂಬಲಿಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="7861581212703831457">Phromium ಕುರಿತು</translation>
<translation id="8752630985505435738">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Phromium ಮೂಲಕ ದರ ಟ್ರ್ಯಾಕಿಂಗ್ ಅಲರ್ಟ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="1203500561924088507">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME" /> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನೀವು ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> ಬಾಕಿ ಉಳಿದಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಸುರಕ್ಷಿತವಾಗಿರಿಸಲು, ಮುಂದಿನ ಬಾರಿ ನೀವು <ph name="IDLE_DURATION" /> ರವರೆಗೆ ನಿಷ್ಕ್ರಿಯರಾಗಿದ್ದಾಗ Chrome ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ.</translation>
<translation id="1232234696885483911">ನೀವು ಇಮೇಜ್‌ ಹುಡುಕಾಟವನ್ನು ತೆರೆದಾಗ, PDF ಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪುಟದ ಶೀರ್ಷಿಕೆ, URL ಮತ್ತು ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">ನೀವು ಸೈನ್ ಇನ್ ಆಗಿರುವಾಗ, Phromium ನಲ್ಲಿ ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿನ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟನ್ನು ನೀವು ಬಳಸಬಹುದು. ಇದನ್ನು ಬದಲಾಯಿಸಲು, "Phromium ನಲ್ಲಿ ನಿಮ್ಮ ಖಾತೆ" ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ.</translation>
<translation id="7402478829083317456">Phromium ನಲ್ಲಿ Gemini ಅನ್ನು Mac ಮೆನು ಬಾರ್‌ನಲ್ಲಿ ತೋರಿಸಿ</translation>
<translation id="4902531791098430822">Phromium ನಲ್ಲಿ Gemini ಬಳಸುವಾಗ ಸ್ಕ್ರೀನ್‌ನ ಒಂದು ಭಾಗವನ್ನು ಆಯ್ಕೆ ಮಾಡಲು, ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಬಳಸಿ.</translation>
<translation id="9002284132405311162">ಈ ಟ್ಯಾಬ್ ನಿಷ್ಕ್ರಿಯವಾಗಿದ್ದಾಗ, Phromium ವೇಗವಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸಲು ಮೆಮೊರಿಯನ್ನು ಮುಕ್ತಗೊಳಿಸಿದೆ. ಈ ಸೈಟ್ ಅನ್ನು ನಿಷ್ಕ್ರಿಯವಾಗಿರದಂತೆ ಎಲ್ಲಾ ಸಮಯದಲ್ಲೂ ಹೊರಗಿಡಲು ನೀವು ಆಯ್ಕೆ ಮಾಡಬಹುದು.</translation>
<translation id="5561666811965903444">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿರುವ ಕಾರಣ Phromium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="1340271056805240721"><ph name="USER_EMAIL" /> ಬಳಸಿಕೊಂಡು Gmail ಅಥವಾ YouTube ನಂತಹ Google ಸೇವೆಗಳಿಗೆ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದರೆ, ನೀವು ಅದೇ ಖಾತೆಯೊಂದಿಗೆ Phromium ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು</translation>
<translation id="5048805453292757697">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Phromium ಪಡೆಯಿರಿ</translation>
<translation id="1290883685122687410">ಸೆಟಪ್ ದೋಷ: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">ನಿಮ್ಮ ಹೊಸ Phromium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೆಟಪ್ ಮಾಡಿ</translation>
<translation id="7871721155662336863">Phromium ನಲ್ಲಿ Gemini ಜೊತೆಗೆ ಬಳಸಿ ನೋಡಿ</translation>
<translation id="6569288432960798043">ಬ್ಲೂಟೂತ್ ಸಾಧನಗಳನ್ನು
ಎಕ್ಸ್‌ಪ್ಲೋರ್ ಮಾಡಲು Phromium ಗೆ ಬ್ಲೂಟೂತ್ ಆ್ಯಕ್ಸೆಸ್‌ನ ಅಗತ್ಯವಿದೆ. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="1330562121671411446">ಭಾಷೆಯನ್ನು ಪತ್ತೆ ಮಾಡಿ</translation>
<translation id="1619655755195586133">Phromium (<ph name="URL" />) ನಿಂದ ಡೇಟಾವನ್ನು ಸಹ ಅಳಿಸಿ</translation>
<translation id="1345251407431278948">ಪಿನ್ ಮಾಡಲಾಗಿದೆ! ಟೂಲ್‌ಬಾರ್‌ನಲ್ಲಿರುವ ಹೊಸ ಬಟನ್‌ನಿಂದ ನೀವು ಮತ್ತೊಮ್ಮೆ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಬಹುದು</translation>
<translation id="1383876407941801731">ಹುಡುಕಿ</translation>
<translation id="2947996037737257951">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ಮುಂದುವರಿಸಲು Phromium ಆ್ಯಪ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="141901961143729572">ನಿಮ್ಮ ವಿಚಾರಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="8355386219605656974">ನಿಮ್ಮ ವಿಂಡೋ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Phromium ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ.</translation>
<translation id="1478370723027452770">Chrome for Testing ನ ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="8398257182826094665"><ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಲಾದ ಮಾಹಿತಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="1497802159252041924">ಇನ್‌ಸ್ಟಾಲ್ ದೋಷ: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">ಈ ಪುಟವನ್ನು ರಕ್ಷಿಸಲಾಗಿದೆ</translation>
<translation id="3484755999946650557">Phromium ಟ್ಯಾಬ್ ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="3309377459597801353">Phromium ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="1547469039832541117">ಹೈಲೈಟ್ ಮಾಡಿದ ಕಾರ್ಯವನ್ನು ಕೊನೆಗೊಳಿಸುತ್ತದೆ.</translation>
<translation id="2354363290397602683">Phromium ಅನ್ನು ಪಿನ್ ಮಾಡಿ</translation>
<translation id="2244728813494358888">Phromium ನ ಸುರಕ್ಷತೆ ಟೂಲ್‌ಗಳು</translation>
<translation id="707582364915018531">Phromium ನಿಮ್ಮ Password Manager ಡೇಟಾವನ್ನು ಅಳಿಸಲು ಬಯಸುತ್ತದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ}=1{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="5032531544901236587">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Phromium ಆ್ಯಪ್ ಮೂಲಕ Google ನ ಅತ್ಯುತ್ತಮವಾದದ್ದನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="7311082384439462587">Phromium ನಲ್ಲಿ ಪ್ರಮುಖ ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತಾ ನಿಯಂತ್ರಣಗಳನ್ನು ಪರಿಶೀಲಿಸಿ</translation>
<translation id="1640672724030957280">ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, ಸದಸ್ಯತ್ವ ಎಂಬುದಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ಖಾತೆಯ ಮೆನುವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="4535436467771816034">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ Phromium ಅನ್ನು ಬಳಸಬಹುದು. ಅದನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಸಹ ಪಿನ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> ಗಾಗಿ ಎಲಿವೇಟೆಡ್ ಪ್ರಿವಿಲೇಜಸ್ ಅನ್ನು ಒದಗಿಸುತ್ತದೆ.</translation>
<translation id="1722488837206509557">ಲಭ್ಯವಿರುವ ಸಾಧನಗಳಿಂದ ಆಯ್ಕೆ ಮಾಡಲು ಮತ್ತು ಅವುಗಳಲ್ಲಿ ಕಂಟೆಂಟ್‌ ಅನ್ನು ಪ್ರದರ್ಶಿಸಲು ಇದು ನಿಮಗೆ ಅನುಮತಿಸುತ್ತದೆ.</translation>
<translation id="3550860956769006392">Phromium ಶೀಘ್ರದಲ್ಲೇ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ</translation>
<translation id="2053384509423635834">ನ್ಯಾವಿಗೇಶನ್‌ಗಳನ್ನು HTTPS ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಲು Phromium ಪ್ರಯತ್ನಿಸುತ್ತದೆ</translation>
<translation id="2516115567501600458">Phromium ಡೇಟಾ ತೆರವುಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="8571959122390670188"><ph name="REMAINING_TIME" /> ಸೆಕೆಂಡ್‌ಗಳಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ</translation>
<translation id="6284080675125981628">HTTPS ಲಭ್ಯವಿಲ್ಲದಿದ್ದಾಗ, Phromium ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡದೆ ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸುತ್ತದೆ</translation>
<translation id="5872244334553252095">Phromium ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಚಾಲನೆಗೊಳ್ಳಲು ಅನುಮತಿಸಿ</translation>
<translation id="2213761221916953829">Phromium  ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಲು, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ನಲ್ಲಿ ನಾವು ಪಟ್ಟಿ ಮಾಡಲಾದ ಕೆಲವು ವಿಸ್ತರಣೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದ್ದೇವೆ ಮತ್ತು ಇದು ಗಮನಕ್ಕೆ ಬಾರದೇ ಸೇರಿಸಿರಬಹುದು.</translation>
<translation id="8807881428325438878">ತ್ವರಿತ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ Phromium ಅನ್ನು ಪಿನ್ ಮಾಡಲು Windows ನೋಟಿಫಿಕೇಶನ್‌ನಲ್ಲಿ <ph name="BEGIN_BOLD" />ಹೌದು<ph name="END_BOLD" /> ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="6861833596843600606">Phromium ಅನ್ನು ಮರುಸ್ಥಾಪಿಸು</translation>
<translation id="3950056404221550225">Phromium <ph name="AUTHENTICATION_PURPOSE" /> ಅನ್ನು ಮಾಡಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="6114726049187747242">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ ನೀವು Phromium ಅನ್ನು ತೆರೆದಾಗ, Google Password Manager ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="1838374766361614909">ಹುಡುಕಾಟ ತೆರವುಗೊಳಿಸಿ</translation>
<translation id="2724678689951174927">ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು Google ಖಾತೆಯಲ್ಲಿ ಇರಿಸಿಕೊಂಡು, ಅದನ್ನು ಈ ಸಾಧನದಿಂದ ಮಾತ್ರ ಅಳಿಸಲು, <ph name="BEGIN_LINK" />Phromium ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡಿ<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಹೊಸ ಟ್ಯಾಬ್ ಗುಂಪುಗಳನ್ನು ತೆರೆಯಲು ಅಥವಾ ರಚಿಸಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Phromium ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="3191814926523151519">ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ Google ಖಾತೆಗಳನ್ನು ನೀವು ನಿರ್ವಹಿಸಬಹುದು. ನಿಮ್ಮ Google ಖಾತೆಗಳನ್ನು Phromium ಬ್ರೌಸರ್, Play Store ‌‌, Gmail ಹಾಗೂ ಮುಂತಾದವುಗಳಲ್ಲಿ ಬಳಸಲಾಗುತ್ತದೆ. ಕುಟುಂಬದ ಸದಸ್ಯರಂತಹ ಬೇರೊಬ್ಬರಿಗೆ ನೀವು ಖಾತೆಯನ್ನು ಸೇರಿಸಲು ಬಯಸಿದರೆ, ಬದಲಿಗೆ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗೆ ಹೊಸ ವ್ಯಕ್ತಿಯನ್ನು ಸೇರಿಸಿ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಹುಡುಕಿ</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="1880677175115548835">ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="1236934630660512644">ನೀವು ನಿರ್ವಹಿಸಲಾದ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡುತ್ತಿರುವಿರಿ ಮತ್ತು ನಿಮ್ಮ Phromium ಪ್ರೊಫೈಲ್ ಮೂಲಕ ಅದರ ನಿರ್ವಾಹಕ ನಿಯಂತ್ರಣವನ್ನು ನೀಡುತ್ತಿರುವಿರಿ. ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಹಾಗೂ ಇತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಂತಹ ನಿಮ್ಮ Phromium ಡೇಟಾವನ್ನು <ph name="USER_NAME" /> ಅವರಿಗೆ ಶಾಶ್ವತವಾಗಿ ಬಂಧಿಸಲಾಗುತ್ತದೆ. Google ಖಾತೆಗಳ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಮೂಲಕ ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯ, ಆದರೆ ಬೇರೊಂದು ಖಾತೆಯೊಂದಿಗೆ ಈ ಡೇಟಾವನ್ನು ಸಂಯೋಜಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ನಿಮ್ಮ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ Phromium ಡೇಟಾವನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಇರಿಸಿಕೊಳ್ಳಲು ನೀವು ಐಚ್ಛಿಕವಾಗಿ ಹೊಸ ಪ್ರೊಫೈಲ್ ಅನ್ನು ರಚಿಸಬಹುದು. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">ಹಿನ್ನೆಲೆ ಚಟುವಟಿಕೆ ಮತ್ತು ಮೃದುವಾಗಿ ಸ್ಕ್ರೋಲ್ ಮಾಡುವುದು ಹಾಗೂ ವೀಡಿಯೊ ಫ್ರೇಮ್ ರೇಟ್‌ಗಳಂತಹ ವಿಷುವಲ್ ಎಫೆಕ್ಟ್‌ಗಳನ್ನು ಮಿತಿಗೊಳಿಸುವ ಮೂಲಕ ಬ್ಯಾಟರಿ ಪವರ್ ಅನ್ನು Phromium ಸಂರಕ್ಷಿಸುತ್ತದೆ. <ph name="BEGIN_LINK" />ಎನರ್ಜಿ ಸೇವರ್‌ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium ಅಪ್‌ಡೇಟರ್ ಸೇವೆ</translation>
<translation id="5797624919204275541">ಇದನ್ನು ಆಫ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡದೆಯೇ Gmail ನಂತಹ Google ಸೈಟ್‌ಗಳಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು</translation>
<translation id="6850971726764387814">Phromium ಸ್ಪಂದಿಸುತ್ತಿಲ್ಲ. ಇದೀಗ ಮರುಪ್ರಾರಂಭಿಸುವುದೇ?</translation>
<translation id="8289779763124483945">ನೀವು Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡುವುದು ನಿಮ್ಮ ಸಂಸ್ಥೆ, <ph name="MANAGER" /> ಗೆ ಅಗತ್ಯವಿದೆ</translation>
<translation id="193439633299369377">ಅಪ್‌ಡೇಟ್ ಅನ್ವಯಿಸಲು ChromiumOS ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="3215238748514810076">ಈ ಫೈಲ್ ಪ್ರಕಾರವನ್ನು ಸಾಮಾನ್ಯ ರೀತಿಯಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡದ ಕಾರಣ Phromium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಹಾಗೂ ಇದು ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು</translation>
<translation id="1953553007165777902">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="MINUTE" /> ನಿಮಿಷ(ಗಳು) ಬಾಕಿ ಉಳಿದಿವೆ</translation>
<translation id="8529252122707161160">ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅನ್ನು ನಿರ್ಧರಿಸಲು ಅಥವಾ ಹೊಂದಿಸಲು Phromium ಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ</translation>
<translation id="197326043290947695">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟದಿಂದ ಸ್ಮಾರ್ಟ್ ಬ್ರೌಸಿಂಗ್</translation>
<translation id="7769772561254542263">Phromium ಕೆಲವು ಫೈಲ್‌ಗಳನ್ನು ಏಕೆ ನಿರ್ಬಂಧಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ, ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ</translation>
<translation id="3713013456746186442">ನಿಮ್ಮ Phromium ಸಾಫ್ಟ್‌ವೇರ್ ಅನ್ನು ಅಪ್ ಟು ಡೇಟ್ ಆಗಿರಿಸುತ್ತದೆ. ಈ ಸೇವೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದರೆ ಅಥವಾ ಸ್ಥಗಿತಗೊಳಿಸಿದರೆ, ನಿಮ್ಮ Phromium ಸಾಫ್ಟ್‌‌ವೇರ್ ಅನ್ನು ಅಪ್ ಟು ಡೇಟ್ ಆಗಿರಿಸಲಾಗುವುದಿಲ್ಲ, ಅದರರ್ಥ ಸಂಭವಿಸಬಹುದಾದ ಭದ್ರತಾ ದೌರ್ಬಲ್ಯಗಳನ್ನು ಸರಿಪಡಿಸಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ ಮತ್ತು ಫೀಚರ್‌ಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು. ಈ ಸೇವೆಯನ್ನು ಯಾವುದೇ Phromium ಸಾಫ್ಟ್‌ವೇರ್ ಬಳಸದೇ ಇದ್ದಾಗ ಅದು ತಾನಾಗಿಯೇ ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಆಗುತ್ತದೆ.</translation>
<translation id="5690439379999550641">ಈ ಸಾಧನದಿಂದ 1 ಐಟಂ ಅನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL" /> ನಂತೆ Phromium ಗೆ ಸೈನ್‌ಇನ್ ಮಾಡಿ.</translation>
<translation id="2018879682492276940">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2039417478970545937">ಸೆಟ್ಟಿಂಗ್‌ಗಳು.</translation>
<translation id="4765042254400173473">Google ಸೇವೆಗಳಲ್ಲಿ ಹೆಚ್ಚು ವೈಯಕ್ತೀಕರಿಸಿದ ಅನುಭವಗಳಿಗಾಗಿ Phromium ಇತಿಹಾಸವನ್ನು ಸೇರಿಸಬೇಕೆ ಬೇಡವೇ ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="1448229429009113044">ಸದೃಢ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ರಚಿಸಲು, ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಆಟೋಫಿಲ್ ಮಾಡಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡಲು Phromium ನಲ್ಲಿ ಬಿಲ್ಟ್ ಇನ್ ಆಗಿದೆ. ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಸೇರಿಸಿ.</translation>
<translation id="2145664943269651168">Phromium ಗೆ ಹೊಸ ಲುಕ್ ನೀಡಲು, ಹೊಸ ಟ್ಯಾಬ್ ಎಂಬ ಪುಟದಲ್ಲಿ Phromium ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಎಂಬ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="6052463185672312901">ಈ ಫೈಲ್ ಮೋಸದಾಯಕವಾಗಿದೆ ಮತ್ತು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಅನಿರೀಕ್ಷಿತ ಬದಲಾವಣೆಗಳನ್ನು ಮಾಡಬಹುದಾದ ಕಾರಣದಿಂದ Phromium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="3825064703718009924">ನೀವು ಮುಂದಿನ ಬಾರಿ Phromium iOS ಅನ್ನು ತೆರೆದಾಗ <ph name="FEATURE_NAME" /> ಅನ್ನು ಪ್ರಯತ್ನಿಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="886729435477608858">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ನೀವು ಸೇವ್ ಮಾಡಿರುವ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತರ Phromium ಡೇಟಾವನ್ನು ಈ ಸಾಧನದಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. Phromium ನಲ್ಲಿ ಅವುಗಳನ್ನು ಮತ್ತೆ ಬಳಸಲು, ಮರಳಿ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Phromium ಅನ್ನು 1 ನಿಮಿಷದ ಕಾಲ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}one{Phromium ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}other{Phromium ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}}</translation>
<translation id="2125838419757773031">ಹುಡುಕಲು ಸ್ಕ್ರೀನ್‌ನ ಪ್ರದೇಶವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="2126108037660393668">ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಫೈಲ್‌ನ ಪರಿಶೀಲನೆ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="2135919691573380097">ಈ ಸೈಟ್ ಕುರಿತು ವರದಿ ಮಾಡಿ</translation>
<translation id="2137162749895930932">ಅನುವಾದದ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಮುಚ್ಚಿರಿ</translation>
<translation id="2147218225094845757">ಪಾರ್ಶ್ವ ಫಲಕವನ್ನು ಮರೆಮಾಡಿ</translation>
<translation id="1628700182434635922">ಈ ಸೈಟ್ ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸುತ್ತಿಲ್ಲ ಮತ್ತು ಫೈಲ್ ಅನ್ನು ಟ್ಯಾಂಪರ್ ಮಾಡಿರಬಹುದಾದ ಕಾರಣದಿಂದ Phromium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="2170098639895543546">ಪುಟದಲ್ಲಿ ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="1807571394075492085">Phromium ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="2174917724755363426">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ. ನೀವು ಖಂಡಿತವಾಗಿಯೂ ರದ್ದುಮಾಡಲು ಬಯಸುವಿರಾ?</translation>
<translation id="8332848361915479268">Phromium - ನೆಟ್‌ವರ್ಕ್ ಸೈನ್ ಇನ್ - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">ಅಪ್‌ಡೇಟ್‌‌ ಪರಿಶೀಲನೆ ದೋಷ: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Phromium ನಿಂದ ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="6063124961634921864">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ಅತ್ಯುತ್ತಮ ಶಾಪಿಂಗ್ ಟೂಲ್‌ಗಳ ಪ್ರಯೋಜನ ಪಡೆಯಲು Phromium ಆ್ಯಪ್ ಬಳಸಿ</translation>
<translation id="8646569091716523420">iOS ಗಾಗಿ Phromium ನಲ್ಲಿ ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ನೊಂದಿಗೆ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ಸುರಕ್ಷಿತವಾಗಿರಿ</translation>
<translation id="3084983792533696835">ಅಪಾಯಕಾರಿ ಸೈಟ್. Phromium ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="2236949375853147973">ನನ್ನ ಚಟುವಟಿಕೆ</translation>
<translation id="6387327671844988108">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ವಿಳಾಸಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ವಿಳಾಸವನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="722050260205928409">ನೀವು ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಹಂಚಿಕೊಂಡರೆ, ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರು ಪ್ರತ್ಯೇಕವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು Phromium ಅನ್ನು ಅವರಿಗೆ ಬೇಕಾದಂತೆ ಹೊಂದಿಸಿಕೊಳ್ಳಬಹುದು.</translation>
<translation id="703211526866942526">Phromium ನಲ್ಲಿ ಕೌಶಲ್ಯಗಳು</translation>
<translation id="2283803047247799269">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಎಂಬ ಫೀಚರ್ ಬಳಸಿಕೊಂಡು ಈ ಟ್ಯಾಬ್ ಅನ್ನು ಹುಡುಕಿ</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್ ಅನ್ನು ವಿರಾಮಗೊಳಿಸಲು Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}one{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}other{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}}</translation>
<translation id="2307973900865360088">ಡಾಕ್‌ನಲ್ಲಿ ಇರಿಸಿ</translation>
<translation id="6083276764640161328">Phromium ನಲ್ಲಿ ಸಂಗ್ರಹಣೆ ಮಾಡಲಾಗಿರುವ ಅಸುರಕ್ಷಿತ ಸೈಟ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಬಳಸಿ, URL ಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ. ಯಾವುದಾದರೂ ಸೈಟ್, ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಕದಿಯಲು ಪ್ರಯತ್ನಿಸಿದರೆ ಅಥವಾ ನೀವು ಹಾನಿಕಾರಕ ಫೈಲ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದಾಗ, ಪುಟದ ಕಂಟೆಂಟ್‌ನ ತುಣುಕುಗಳನ್ನು ಒಳಗೊಂಡ URL ಗಳನ್ನು ಸಹ Phromium, ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ಗೆ ಕಳುಹಿಸಬಹುದು.</translation>
<translation id="2356070529366658676">ಕೇಳಿ</translation>
<translation id="2359808026110333948">ಮುಂದುವರೆಸಿ</translation>
<translation id="741972887620936671">"<ph name="EXTENSION_NAME" />" ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯ ಮೂಲಕ ಬಳಸುವುದಕ್ಕಾಗಿ ನೀವು Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕಿದೆ</translation>
<translation id="4709464915929597251">ಆ್ಯಪ್‌ಗಳಿಗೆ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗುತ್ತಿರುವ Phromium ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="6804933363437420201"><ph name="USER_EMAIL_ADDRESS" /> ಮೂಲಕ ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ಬಳಸಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="2384373936468275798">ನಿಮ್ಮ ಖಾತೆಯ ಸೈನ್ ಇನ್ ವಿವರಗಳು ತೀರಾ ಹಳೆಯದಾಗಿರುವ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromiumOS ಗೆ ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{1 HID ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Phromium ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}=1{1 HID ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Phromium ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}one{# HID ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Phromium ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}other{# HID ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Phromium ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}}</translation>
<translation id="1394893265611797679">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ Phromium ಗೆ ಕ್ಯಾಮರಾ ಮತ್ತು ಮೈಕ್ರೊಫೋನ್ ಅನುಮತಿಗಳ ಅಗತ್ಯವಿದೆ</translation>
<translation id="2403703063067034158">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: ಸೆಟಪ್‌ನ ಮತ್ತೊಂದು ನಿದರ್ಶನ ಪ್ರಸ್ತುತ ರನ್ ಆಗುತ್ತಿದೆ, ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8457868297375575309">ಯಾವುದೇ ಆ್ಯಪ್‌ನಿಂದ Phromium ನಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ನಲ್ಲಿ ಬ್ರೌಸರ್ ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡುವ ಹಾಗೆ ಇರಿಸಿ</translation>
<translation id="5354209517289935579">ತ್ವರಿತ ಅವಲೋಕನವನ್ನು ಪಡೆಯಲು ಮತ್ತು ಫಾಲೋ-ಅಪ್ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು Phromium ನಲ್ಲಿ Gemini ಜೊತೆಗೆ ಈ ಡಾಕ್ಯುಮೆಂಟ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು ಸಾರಾಂಶಗೊಳಿಸಿ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="6628402244681586711"><ph name="BEGIN_LINK" />Phromium ನಲ್ಲಿನ ಟೂಲ್‌ಗಳ<ph name="END_LINK" /> ಮೂಲಕ ನೀವು ಸುರಕ್ಷಿತವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು ನಿಯಂತ್ರಣದಲ್ಲಿರಬಹುದು</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="2451727308784734061">Password Manager ಗೆ ತ್ವರಿತವಾಗಿ ಹೋಗಲು ನಿಮ್ಮ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಬಳಸಿ. ನಿಮ್ಮ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನ ಹೋಮ್‌ ಸ್ಕ್ರೀನ್ ಅಥವಾ ಆ್ಯಪ್ ಲಾಂಚರ್‌ಗೆ ನೀವು ಸರಿಸಬಹುದು.</translation>
<translation id="1593547119543498467">Phromium ಶೀಘ್ರದಲ್ಲೇ ಮುಚ್ಚಲ್ಪಡುತ್ತದೆ</translation>
<translation id="6814323389195469782">Phromium ನಲ್ಲಿ</translation>
<translation id="2485422356828889247">ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್</translation>
<translation id="2513154137948333830">ರೀಬೂಟ್ ಮಾಡುವ ಅಗತ್ಯವಿದೆ: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="2643581100433412871">ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು Phromium ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="4103676945224728292">ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು Phromium ಗೆ ಸಂಗ್ರಹಣೆಯನ್ನು ಪ್ರವೇಶಿಸುವ ಅಗತ್ಯವಿದೆ</translation>
<translation id="8743720024689622265">Phromium ಸಹಾಯಕ</translation>
<translation id="2575822587468774919">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಹುಡುಕಲು ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8692134707551176334">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="6035715610127790081">Phromium ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಮತ್ತು ನಿಮ್ಮ Google ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ನಿಮ್ಮ ಫೋನ್ ಮೂಲಕ QR ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ.</translation>
<translation id="1579158377846894470">Phromium ಮೂಲಕ ಹುಡುಕಲು.</translation>
<translation id="3626651250874375470">Phromium ಬಳಸಿಕೊಂಡು ಮುಂದುವರಿಯಿರಿ</translation>
<translation id="259935314519650377">ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಅನ್ನು ಕ್ಯಾಷ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ. ದೋಷ: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">ಸಿಸ್ಟಂ</translation>
<translation id="7634640424937626608">ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್‌ಗಳಂತಹ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ನೋಡಬಹುದು ಮತ್ತು ನಿರ್ವಹಿಸಬಹುದು. ಅದಕ್ಕೆ ಇತರ Phromium ಪ್ರೊಫೈಲ್‌ಗಳಲ್ಲಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ನೋಡಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ</translation>
<translation id="2669565213445601962">ನಿಮ್ಮ ಖಾತೆ <ph name="ACCOUNT_EMAIL" /> ನಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ಇದು ನೀವೇ ಎಂಬುದನ್ನು ದೃಢೀಕರಿಸಿ</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ಸುಧಾರಿತ ಸಂರಕ್ಷಣೆಯು ಬಯಸುತ್ತದೆ}=1{ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ಸುಧಾರಿತ ಸಂರಕ್ಷಣೆಯು ಬಯಸುತ್ತದೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ಸುಧಾರಿತ ಸಂರಕ್ಷಣೆಯು ಬಯಸುತ್ತದೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ಸುಧಾರಿತ ಸಂರಕ್ಷಣೆಯು ಬಯಸುತ್ತದೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="4393202019354077587">Phromium ಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="3192212313802409327">ಸ್ಥಾಪಿಸುತ್ತಿರುವಾಗ ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಂ ದೋಷ ಸಂಭವಿಸಿದೆ. ದಯವಿಟ್ಟು Phromium ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="6648732950668475680">ನೀವು ಸಾಧನವನ್ನು ಹಂಚಿಕೊಂಡರೆ, ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರು ಪ್ರತ್ಯೇಕವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು Phromium ಅನ್ನು ಅವರಿಗೆ ಬೇಕಾದಂತೆ ಸೆಟಪ್ ಮಾಡಬಹುದು</translation>
<translation id="3501804488281766385">Phromium ಅನ್ನು ಮಿನಿಮೈಸ್ ಮಾಡಿದ್ದರೂ ಸಹ, ನಿಮ್ಮ ಸಾಧನದಾದ್ಯಂತ Phromium ನಲ್ಲಿ Gemini ಅನ್ನು ಬಳಸಲು ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್ ಪಡೆಯಿರಿ.</translation>
<translation id="5655763731487334489">Phromium ಟ್ಯಾಬ್</translation>
<translation id="582020748041490207">ಹೆಚ್ಚುವರಿ ಭದ್ರತೆಗಾಗಿ, Phromium ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡುತ್ತದೆ.</translation>
<translation id="2693283019505702310">Phromium ನಿಂದ ನಿಮ್ಮ Google ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಲು, ಸೈನ್ ಔಟ್ ಮಾಡಿ</translation>
<translation id="2989508583692830513">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="2738871930057338499">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. HTTP 403 ನಿಷೇಧಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಪ್ರಾಕ್ಸಿ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="2753623023919742414">ಹುಡುಕಲು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="3391021955306442819">Phromium ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ PDF ವೀಕ್ಷಕವನ್ನಾಗಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="293156805028931571">ಈ ವಿಸ್ತರಣೆಯು ಮಾಲ್‌ವೇರ್ ಅನ್ನು ಹೊಂದಿದೆ ಮತ್ತು ಸುರಕ್ಷಿತವಾಗಿಲ್ಲ. Phromium ನಿಂದ ವಿಸ್ತರಣೆಯನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="2799223571221894425">ಮರುಪ್ರಾರಂಭಿಸು</translation>
<translation id="4742633141454352374">ನಿಮ್ಮ Phromium</translation>
<translation id="2816462166102338036">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಬಳಸಿಕೊಂಡು ಈ ವೀಡಿಯೊವನ್ನು ಹುಡುಕಿ</translation>
<translation id="2191308357458164968">ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಮೂಲಕ ಉತ್ಪನ್ನಗಳನ್ನು ಹುಡುಕಿ, ದರ ಇಳಿಕೆಯ ಮಾಹಿತಿ ಪಡೆಯಿರಿ ಮತ್ತು iOS ನಲ್ಲಿ Phromium ಬಳಸುವ ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ಇನ್ನೂ ಹೆಚ್ಚಿನದನ್ನು ಮಾಡಿ.</translation>
<translation id="2841525013647267359">ಈ ಭಾಷೆಯಿಂದ ಅನುವಾದಿಸಿ</translation>
<translation id="2846251086934905009">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ. ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="4498037716339180906">Phromium ನಿಂದ ತೆಗೆದುಹಾಕಿ...</translation>
<translation id="4049188396834160957">ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ, Phromium ನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸುತ್ತದೆ ಮತ್ತು ಇತರ Google ಆ್ಯಪ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಸುರಕ್ಷತೆಯನ್ನು ಸುಧಾರಿಸಲು ಬಳಸಬಹುದು</translation>
<translation id="2885378588091291677">ಕಾರ್ಯ ನಿರ್ವಾಹಕ</translation>
<translation id="4119302609687132178">&amp;Phromium ಕುರಿತು</translation>
<translation id="2915996080311180594">ನಂತರ ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="8232968781653330429">ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಮೂಲಕ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಸೇವ್‌ ಮಾಡಲು, ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ.</translation>
<translation id="2945997411976714835">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಪ್ರಕ್ರಿಯೆಯು ಪ್ರಾರಂಭಿಸಲು ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="5624652745932625503">iOS ನಲ್ಲಿ Phromium ಗಾಗಿ ಸೇವ್ ಮಾಡಲಾದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಸೈಟ್‌ಗಳಿಗೆ ವೇಗವಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="8821179372057577828">ನಿಮ್ಮ ಸಂಸ್ಥೆಯು Phromium ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತದೆ</translation>
<translation id="741172935898285572">Phromium ಅಪ್‌ ಟು ಡೇಟ್‌ ಆಗಿದೆ</translation>
<translation id="8798708493876822519">ಯಾವುದಾದರೂ ಸೈಟ್ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಕದಿಯಲು ಪ್ರಯತ್ನಿಸಿದರೆ ಅಥವಾ ನೀವು ಹಾನಿಕಾರಕ ಫೈಲ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದಾಗ, ಪುಟದ ವಿಷಯದ ತುಣುಕುಗಳನ್ನು ಒಳಗೊಂಡ URL ಗಳನ್ನು ಸಹ Phromium, ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ಗೆ ಕಳುಹಿಸುತ್ತದೆ</translation>
<translation id="6896740867011823632">ನಿಮ್ಮ ಪೋಷಕರ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿರಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3003694935412297923">ಎಲ್ಲಾ ಕಾರ್ಯಗಳು</translation>
<translation id="3580865868015023718">{count,plural, =1{ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು Phromium ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು (1 ಐಟಂ) ಅಳಿಸಲಾಗುತ್ತದೆ.}one{ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು Phromium ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}other{ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು Phromium ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}}</translation>
<translation id="1211179250505223767">Phromium ನಲ್ಲಿ <ph name="URL" /> ಅನ್ನು ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯಿರಿ.</translation>
<translation id="4742400838355945730">ಕೌಶಲ್ಯಗಳಂತಹ AI ನಾವೀನ್ಯತೆಗಳನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ ಮತ್ತು Phromium ಸಿಂಕ್‌ನಿಂದ ಪ್ರತ್ಯೇಕವಾಗಿ ನಿರ್ವಹಿಸಲಾಗುತ್ತದೆ</translation>
<translation id="8070050512429584052">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="666691655897541311">Phromium ಗೆ ಸೇರಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3038232873781883849">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನಿರೀಕ್ಷಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3045032126857188731">ಅನುವಾದಿಸಿದ ಭಾಷೆ: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">ಫೀಡ್‌ಬ್ಯಾಕ್ ಡೈಲಾಗ್ ಅನ್ನು ಮುಚ್ಚಿ</translation>
<translation id="919456815618829047"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಓದುವ ಪಟ್ಟಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="6141754610526066487">ಇತರ Phromium ಪ್ರೊಫೈಲ್‌ಗಳು</translation>
<translation id="2380720899384114679">ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಆ್ಯಡ್-ಆನ್‌ಗಳಾಗಿದ್ದು, ಅವು Phromium ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಲು ನಿಮಗೆ ಅವಕಾಶ ನೀಡುತ್ತವೆ. ವ್ಯವಸ್ಥಿತವಾಗಿರುವುದರಿಂದ ಹಿಡಿದು ದೈನಂದಿನ ಕಾರ್ಯಗಳನ್ನು ಸರಳಗೊಳಿಸುವವರೆಗೆ, ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು Phromium ಅನ್ನು ನಿಮಗೆ ಬೇಕಾದ ಹಾಗೆ ಕಸ್ಟಮೈಸ್ ಮಾಡಲು ನೆರವಾಗುತ್ತವೆ.</translation>
<translation id="2507281899032275020">Google ಗೆ ಕ್ರ್ಯಾಶ್ ವರದಿಗಳನ್ನು ಮತ್ತು <ph name="UMA_LINK" /> ಕಳುಹಿಸುವುದರಿಂದ Phromium ಅನ್ನು ಉತ್ತಮಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="1514966729948178660">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ Google ನ ಸುರಕ್ಷತೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು Phromium ಆ್ಯಪ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{1 USB ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Phromium ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}=1{1 USB ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Phromium ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}one{# USB ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Phromium ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}other{# USB ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Phromium ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}}</translation>
<translation id="78720743239019396"><ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಓದುವ ಪಟ್ಟಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="7000206277447032115">Phromium ಇತಿಹಾಸ</translation>
<translation id="4555002192651219296">ಆರ್ಕೈವ್ ಅನ್ನು ಸಂಕ್ಷೇಪ ಮಾಡದಿರಲು ಸ್ಥಾಪಕ ವಿಫಲಗೊಂಡಿದೆ. ದಯವಿಟ್ಟು Phromium ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="310459126943037700">ಕಾರ್ಯವನ್ನು(ಗಳು) ಅಂತ್ಯಗೊಳಿಸಲು ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="3104828284009500087">ಪುಟದಲ್ಲಿ ಏನನ್ನಾದರೂ ಹುಡುಕಿ</translation>
<translation id="4867557516756736957">ಸಾಧನಗಳಾದ್ಯಂತ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತಿಹಾಸವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಿಂಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅನ್ನು Phromium ಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡುವ ಮೂಲಕ ನಿಮಗೆ ತಿಳಿದಿರುವ ಮತ್ತು ಇಷ್ಟಪಡುವ ಫೀಚರ್‌ಗಳನ್ನು ಸುಲಭವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಿ.</translation>
<translation id="8632308594821621017">Phromium ನಿಮ್ಮ ಮೈಕ್ರೋಫೋನ್ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="3130333203120345554">ಹೊಸ ಹುಡುಕಾಟ</translation>
<translation id="3137969841538672700">ಹುಡುಕಲು ಡ್ರ್ಯಾಗ್ ಮಾಡಿ</translation>
<translation id="9173792796158381383">ಈ ಟ್ಯಾಬ್ ಇನ್ನಷ್ಟು ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸುತ್ತಿದೆ. ನಿಮ್ಮ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು, ಅದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು Phromium ಅನ್ನು ಅನುಮತಿಸಿ.</translation>
<translation id="8874679893080632357">ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Phromium ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ</translation>
<translation id="101045618220347251">Phromium ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="3161522574479303604">ಎಲ್ಲಾ ಭಾಷೆಗಳು</translation>
<translation id="5940989267583033306">Phromium ಅ&amp;ದೃಶ್ಯ ವಿಂಡೋದಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="2045477525210426976">ನಿಮ್ಮ ಹೊಸ Phromium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="3540518135502114323">ಟ್ಯಾಬ್‌ಗಳನ್ನು ಬದಲಿಸದೆಯೇ ನೀವು AI ಮೋಡ್‌ನೊಂದಿಗೆ ಚಾಟ್ ಮಾಡುವುದನ್ನು ಮುಂದುವರಿಸಬಹುದು. ಪ್ರಾರಂಭಿಸಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="1496180326063744749">Phromium ನಿಂದ ನಿಮ್ಮ Google ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಲು, ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಪುಟದಲ್ಲಿ Phromium ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡಿ</translation>
<translation id="7792783034323745412">ನಂತರ, ನಿಮಗಾಗಿ ಫಾರ್ಮ್‌ಗಳನ್ನು ಆಟೋಫಿಲ್ ಮಾಡಲು, ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿಯನ್ನು ಬಳಸಲು ನೀವು ಬಯಸುತ್ತೀರಾ ಎಂದು Phromium ಕೇಳಬಹುದು</translation>
<translation id="5240091371721695404">Phromium ಗೆ ಇದರ ಡೇಟಾ ಡೈರೆಕ್ಟರಿಯನ್ನು ಓದಲಾಗುವುದಿಲ್ಲ ಮತ್ತು ಬರೆಯಲಾಗುವುದಿಲ್ಲ: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">iOS ನಲ್ಲಿ Phromium ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ನಿಮ್ಮ ನೆಚ್ಚಿನ Google AI ಟೂಲ್‌ಗಳನ್ನು ಬಳಸಿ.</translation>
<translation id="4848363951707149242"><ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3286538390144397061">ಈಗ ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="8613877111531019527">Google API ಕೀಗಳು ಕಾಣೆಯಾಗಿವೆ. Phromium ನ ಕೆಲವು ಕಾರ್ಯವಿಧಾನಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="2784090498377460662">Phromium ಮುಚ್ಚಿದಾಗ ರನ್‌ ಆಗುತ್ತಿರುವ ಹಿನ್ನೆಲೆ ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ಮುಂದುವರಿಸು</translation>
<translation id="3905054486991167751">ನೀವು ಹೊರಗಿರುವಾಗ Phromium ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ</translation>
<translation id="4502950976754616266">ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ಯಾವುದೇ ಸೈಟ್ ಅನ್ನು ಲೋಡ್ ಮಾಡುವ ಮೊದಲು Phromium ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ</translation>
<translation id="6107453188231652861">ನೀವು Phromium ಗೆ ಸೈನ್ ಇನ್ ಆಗಿದ್ದರೆ, ನಿಮ್ಮ Google ಖಾತೆಯನ್ನು ಹೊರತುಪಡಿಸಿ ಎಲ್ಲಾ Phromium ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚುವುದರಿಂದ ಹೆಚ್ಚಿನ ಸೈಟ್‌ಗಳಿಂದ ನಿಮ್ಮನ್ನು ಸೈನ್ ಔಟ್ ಮಾಡಲಾಗುತ್ತದೆ. ಸೈಟ್‌ಗಳು ನಿಮ್ಮನ್ನು ನೆನಪಿಟ್ಟುಕೊಳ್ಳಲು ಅವಕಾಶ ಮಾಡಿಕೊಡಲು, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಮೇಲಿನ ಬಲ ಮೂಲೆ: ಬಲಕ್ಕೆ <ph name="RIGHT" />%, ಮೇಲಕ್ಕೆ <ph name="TOP" />%</translation>
<translation id="5896635343289575401">ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ Phromium ಡೇಟಾ</translation>
<translation id="5662253013097242821">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ Phromium ಮೂಲಕ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">ಈಗಿರುವ Phromium ಪ್ರೊಫೈಲ್‌ಗೆ ಬದಲಿಸಬೇಕೆ?</translation>
<translation id="3412460710772753638">ಈ ಸಾಧನದಲ್ಲಿನ Password Manager ನಲ್ಲಿ</translation>
<translation id="657700335789940813">Phromium ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಬಯಸುತ್ತದೆ</translation>
<translation id="3487742274367151379"><ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3438772217992559640">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಈ ಟ್ಯಾಬ್ ಅನ್ನು ಹುಡುಕಿ</translation>
<translation id="8062355070850891600">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ Phromium ಮೂಲಕ ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ವಿಸ್ತರಿಸಿ</translation>
<translation id="5419337472918920970">Phromium ಅನ್ನು ನಿಮ್ಮದಾಗಿಸಿಕೊಳ್ಳಲಾಗುತ್ತಿದೆ...</translation>
<translation id="6573105037542661278">ಈ ಸಾಧನದಿಂದ <ph name="ITEMS_COUNT" /> ಐಟಂಗಳನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL" /> ನಂತೆ Phromium ಗೆ ಸೈನ್‌ಇನ್ ಮಾಡಿ.</translation>
<translation id="4600986251755456192">Phromium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು <ph name="SHORTCUT" /> ಅನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="8118189978246431067">ದಯವಿಟ್ಟು ಎಲ್ಲಾ Phromium ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚಿರಿ ಹಾಗೂ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="7430418346833889620">ನಿಮ್ಮ ವಿಂಡೋ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Phromium ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ</translation>
<translation id="2943929290955142701"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ.  ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, ನಿಮ್ಮ ಸ್ವಂತ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ನಂತೆ Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="5896697187441340113">ಮೊಬೈಲ್ ಸಾಧನಗಳಲ್ಲಿ Phromium ಬ್ರೌಸರ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು QR ಕೋಡ್</translation>
<translation id="354621070532799440">ರಿಮೈಂಡರ್: ನಿಮ್ಮ ಜೇಬಿನಲ್ಲಿ Google ನ ಅತ್ಯುತ್ತಮ ಸುರಕ್ಷತಾ ಫೀಚರ್‌ಗಳು</translation>
<translation id="6718500626359284607">ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Phromium ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ.</translation>
<translation id="6511372913460632136">Phromium ಗುರುತಿಸದ ಸೈಟ್‌ಗಳಿಗೆ ವರ್ಧಿತ ಸುರಕ್ಷತೆಯು JavaScript ಆಪ್ಟಿಮೈಸೇಷನ್ ಅನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ</translation>
<translation id="3597003331831379823">ಎಲಿವೇಟೆಡ್ ಪ್ರಿವಿಲೇಜಸ್ ಮೂಲಕ ಸೆಟಪ್ ಅನ್ನು ರನ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Phromium ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="8702816719621016911">ಈ ವ್ಯಕ್ತಿಯ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಈ ಸಾಧನದಿಂದ ಅಳಿಸಲಾಗುತ್ತದೆ. ಡೇಟಾವನ್ನು ಪುನಃ ಪಡೆದುಕೊಳ್ಳಲು, Phromium ನಲ್ಲಿ <ph name="USER_EMAIL" /> ಎಂದು ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{Phromium ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ.}=1{Phromium ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{Phromium ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{Phromium ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="3667616615096815454">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ, ಅಪ್ಲಿಕೇಶನ್ ಸರ್ವರ್‌ಗೆ ತಿಳಿದಿಲ್ಲ.</translation>
<translation id="678730369472836428">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿರುವ ಎಲ್ಲಾ Phromium ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲು ನಿಮ್ಮ <ph name="BEGIN_LINK" />ಸ್ವಂತ ಪಾಸ್‌ಫ್ರೇಸ್<ph name="END_LINK" /> ಬಳಸಿ. Google Pay ನಲ್ಲಿನ ಪಾವತಿ ವಿಧಾನಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ. Phromium ನ ಬ್ರೌಸಿಂಗ್ ಇತಿಹಾಸವು ಸಿಂಕ್ ಆಗುವುದಿಲ್ಲ.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ}=1{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="2203303261468330007">ಹೊಸ Phromium &amp;ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="686463893976008238">ವೈಯಕ್ತೀಕರಣ ಮತ್ತು ಇತರ ಉದ್ದೇಶಗಳಿಗಾಗಿ Phromium ಮತ್ತು ಇತರ Google ಸೇವೆಗಳನ್ನು ಲಿಂಕ್ ಮಾಡಿ</translation>
<translation id="3729187154190517324">"ಟ್ಯಾಬ್ ಮತ್ತು ಇನ್ನಷ್ಟು ಸೇರಿಸಿ" ಬಟನ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ಬಹು ಟ್ಯಾಬ್‌ಗಳು, ಫೈಲ್‌ಗಳು ಮತ್ತು ಟೂಲ್‌ಗಳನ್ನು ಸೇರಿಸುವ ಮೂಲಕ ನಿಮ್ಮ ಹುಡುಕಾಟವನ್ನು ಇನ್ನಷ್ಟು ಆಳವಾಗಿಸಿ.</translation>
<translation id="5596264049590907430">Phromium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="5594723037153142396">Phromium ಕೆಲವು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಏಕೆ ನಿರ್ಬಂಧಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="3425307214497790458">ನಿಮ್ಮ ಪರಿಶೀಲನೆಗೆ ಏನಾದರೂ ಅಗತ್ಯವಿದ್ದರೆ Phromium ನಿಮಗೆ ತಿಳಿಸುತ್ತದೆ</translation>
<translation id="4247980944121268675">ನೀವು ಭೇಟಿ ನೀಡುವ ಸಾಧ್ಯತೆಯಿರುವ ಪುಟಗಳನ್ನು Phromium ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಅವುಗಳಿಗೆ ಭೇಟಿ ನೀಡಿದಾಗ ಅವುಗಳು ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ</translation>
<translation id="3810973564298564668">ನಿರ್ವಹಿಸಿ</translation>
<translation id="1058395779823101457">ನೀವು ಸೇವ್ ಮಾಡಿರುವ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಲು, QR ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ, Phromium iOS ಆ್ಯಪ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ Google ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3846683726093018685">**ಸಾರಾಂಶಗೊಳಿಸಿ:** 30 ಪದಗಳ ಒಳಗೆ ಒಂದೇ ವಾಕ್ಯದಲ್ಲಿ, ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ನಲ್ಲಿರುವ ಕಂಟೆಂಟ್‌ನ ಪ್ರಾಥಮಿಕ ವಿಷಯ ಮತ್ತು ಉದ್ದೇಶವನ್ನು ವಿವರಿಸಿ.

          **ಪ್ರಶ್ನೆಗಳನ್ನು ಸೂಚಿಸಿ:** ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅನ್ನು ಚೆನ್ನಾಗಿ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಬಳಕೆದಾರರು ಕೇಳಬಹುದಾದ 3-5 ಚಿಂತನೆಗೆ ಒರೆ ಹಚ್ಚುವ ಪ್ರಶ್ನೆಗಳ ಬುಲೆಟ್ ಪಟ್ಟಿಯನ್ನು ರಚಿಸಿ. ಈ ಪ್ರಶ್ನೆಗಳು ವಿಷುವಲ್‌ ಆಬ್ಜೆಕ್ಟ್, ಅದರ ವಿನ್ಯಾಸ ಅಥವಾ ಅದರ ಪ್ಲೇಸ್‌ಮೆಂಟ್‌‌ನ ಬಗ್ಗೆ ನಿರ್ದಿಷ್ಟವಾಗಿ ಇವುಗಳಲ್ಲಿ ಕನಿಷ್ಠ ಒಂದನ್ನಾದರೂ ಒಳಗೊಂಡಿರಬೇಕು.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3885770153807205175">ಭಾಷಾ ಪಿಕರ್‌</translation>
<translation id="5947409614720749543">Phromium ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಮತ್ತು ನಿಯಂತ್ರಿಸಿ. ನೀವು ಕೆಲವು ಸಂಗತಿಗಳ ಕುರಿತು ಗಮನಹರಿಸಬೇಕಿದೆ - ವಿವರಗಳಿಗಾಗಿ ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="2176348074240183776">Phromium ತೆರೆಯಲು ಮತ್ತು ಬ್ರೌಸ್ ಮಾಡುವುದನ್ನು ಪ್ರಾರಂಭಿಸಲು ನಿಮ್ಮ ಹೆಸರನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="3892148308691398805">ಪಠ್ಯ ಕಾಪಿ ಮಾಡಿ</translation>
<translation id="3679766722656346339">ಈ Phromium ಪ್ರೊಫೈಲ್‌ಗೆ ಈಗಾಗಲೇ <ph name="EXISTING_USER" /> ಅವರು ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ನಿಮಗಾಗಿ ನಿಮ್ಮ ಸ್ವಂತ ಪ್ರೊಫೈಲ್ ಅನ್ನು ರಚಿಸಬಹುದು.</translation>
<translation id="6085953975934135790">ಈ ವಿಸ್ತರಣೆಯು Chrome ವೆಬ್ ಸ್ಟೋರ್‌ನ ಕಾರ್ಯನೀತಿಯನ್ನು ಉಲ್ಲಂಘಿಸುತ್ತದೆ ಮತ್ತು ಸುರಕ್ಷಿತ ಆಗಿಲ್ಲದಿರಬಹುದು. Phromium ನಿಂದ ವಿಸ್ತರಣೆಯನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="3941890832296813527">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಫೈಲ್ ಹೆಸರು ಅಮಾನ್ಯವಾಗಿದೆ ಅಥವಾ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ.</translation>
<translation id="608187946760434925">Phromium, ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ನಕಲಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="3054592240125889472">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3140795250676341027">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ನೀವು ಸೇವ್ ಮಾಡದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಪಾವತಿ ವಿಧಾನಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಈ ಸಾಧನದಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. Phromium ನಲ್ಲಿ ಅವುಗಳನ್ನು ಮತ್ತೆ ಬಳಸಲು, ಮರಳಿ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="395904275706073188">ಸಂರಕ್ಷಿತ ಪುಟಗಳನ್ನು ಓದಲಾಗುವುದಿಲ್ಲ. ಬೇರೆ ಪುಟವನ್ನು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="4227910144250222665">Phromium ನಿಮ್ಮನ್ನು ಹೇಗೆ ಸುರಕ್ಷಿತವಾಗಿರಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="3967822245660637423">ಡೌನ್‌ಲೋಡ್‌‌ ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="4150430234581811723">ನೀವು ವಿಳಾಸ ಪಟ್ಟಿ ಅಥವಾ ಸರ್ಚ್ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡಿದಾಗ, ಸಲಹೆಗಳನ್ನು ಪಡೆಯಲು Phromium ನೀವು ಟೈಪ್ ಮಾಡುವುದನ್ನು ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಹುಡುಕಾಟ, AI ಮತ್ತು ಏಜೆಂಟ್ ಟೂಲ್‌ಗಳಿಗೆ ಕಳುಹಿಸುತ್ತದೆ.</translation>
<translation id="3975724895399328945">Google Chrome for Testing ಕುರಿತು</translation>
<translation id="3997429360543082038">ChromiumOS ಕುರಿತು</translation>
<translation id="4847805566397342820">ನೀವು ಸೈಟ್‌ಗೆ ಭೇಟಿ ನೀಡಿದಾಗ, Phromium ನಿಮ್ಮ IP ವಿಳಾಸವನ್ನು ಮರೆಮಾಡುವ ಗೌಪ್ಯತೆ ಸರ್ವರ್ ಮೂಲಕ URL ನ ಮಬ್ಬುಗೊಳಿಸಿದ ಭಾಗವನ್ನು <ph name="BEGIN_LINK" />Google Safe Browsing<ph name="END_LINK" /> ಗೆ ಕಳುಹಿಸುತ್ತದೆ. ಸೈಟ್ ಅನುಮಾನಾಸ್ಪದವಾಗಿ ಏನಾದರೂ ಮಾಡಿದರೆ, ಪೂರ್ಣ URL ಗಳು ಮತ್ತು ಪುಟದ ಕಂಟೆಂಟ್‌ನ ಬಿಟ್‌ಗಳನ್ನು ಸಹ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="4016217212818346953">Password Manager ಮೂಲಕ ಸುರಕ್ಷಿತವಾಗಿರಿ</translation>
<translation id="4019629340646866719">ಹೆಚ್ಚುವರಿ <ph name="BEGIN_LINK_CROS_OSS" />ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್‌<ph name="END_LINK_CROS_OSS" /> ನಿಂದ ChromiumOS ನ ರಚನೆ, ಹಾಗೆಯೇ <ph name="BEGIN_LINK_LINUX_OSS" />Linux ಡೆವಲಪ್‌ಮೆಂಟ್ ಎನ್ವಿರಾನ್‌ಮೆಂಟ್<ph name="END_LINK_LINUX_OSS" /> ರಚನೆ ಸಹ ಸಾಧ್ಯವಾಯಿತು.</translation>
<translation id="4022972681110646219">ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಅನುವಾದಿಸಿ</translation>
<translation id="4023601594785368013">ಮೂಲ ಭಾಷೆ: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">ಯಾವುದೇ ಆ್ಯಪ್‌ನಿಂದ Phromium ನಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ. ಜೊತೆಗೆ ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ, ಅದನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="6916567874038032700"><ph name="BEGIN_LINK" />ಪ್ರಸ್ತುತ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು<ph name="END_LINK" /> ವರದಿ ಮಾಡುವ ಮೂಲಕ Phromium ಅನ್ನು ಉತ್ತಮಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="4050175100176540509">ಇತ್ತೀಚಿನ ಆವೃತ್ತಿಯಲ್ಲಿ ಪ್ರಮುಖವಾದ ಭದ್ರತಾ ಸುಧಾರಣೆಗಳು ಮತ್ತು ಹೊಸ ವೈಶಿಷ್ಟ್ಯಗಳು ಲಭ್ಯವಿದೆ.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{Phromium ಅನ್ನು 1 ನಿಮಿಷದ ಕಾಲ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.}one{Phromium ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.}other{Phromium ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.}}</translation>
<translation id="2498876341137940584">Phromium ಅಜ್ಞಾತ ಮೋಡ್</translation>
<translation id="1371775705240141332">Phromium ಕುರಿತ ಪುಟಕ್ಕೆ ಹೋಗಿ</translation>
<translation id="1983555117242858621">ನಿಮ್ಮ ಬ್ರೌಸರ್‌ಗೆ ಹೊಸ ಲುಕ್ ಅನ್ನು ನೀಡಲು Phromium ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="3730928612696305544">ನಿಮ್ಮ Phromium ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="4148957013307229264">ಸ್ಥಾಪನೆಗೊಳ್ಳುತ್ತಿದೆ...</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> - ನೆಟ್‌ವರ್ಕ್ ಸೈನ್ ಇನ್ - Phromium</translation>
<translation id="8940475598678719246"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಓದುವ ಪಟ್ಟಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="3361801572720154185">Phromium ಗಾಗಿ ಅದ್ಭುತ ಅಪ್ಲಿಕೇಶನ್‌‌ಗಳು, ಗೇಮ್‌ಗಳು, ಎಕ್ಸ್‌ಟೆನ್ಷನ್‌‌ಗಳು ಹಾಗೂ ಥೀಮ್‌ಗಳನ್ನು ಅನ್ವೇಷಿಸಿ.</translation>
<translation id="5104340040322658377">ನಿಮ್ಮ ಎಲ್ಲಾ ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="6533832886058295845">ನಿಮ್ಮ ಪೋಷಕರ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿರಲು, ನೀವು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಿರುವ ನಿಮ್ಮ Phromium ಪ್ರೊಫೈಲ್‌ <ph name="USER_EMAIL_ADDRESS" /> ಗೆ ಬದಲಿಸಿ</translation>
<translation id="4222932583846282852">ರದ್ದುಗೊಳಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="4224210481850767180">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="6904238369362879351">ಈ ಖಾತೆಗೆ ನಿಮ್ಮ Phromium ಡೇಟಾವನ್ನು ಲಿಂಕ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="357744319784654404">ಪ್ರಮಾಣಿತ ಸುರಕ್ಷತೆಗಿಂತ ಹೆಚ್ಚಿನ ಡೇಟಾವನ್ನು ವೆಬ್‌ಸೈಟ್‌ಗಳಿಂದ ವಿಶ್ಲೇಷಿಸುವ ಮೂಲಕ Google ತಿಳಿದಿರದಂತಹ ಅಪಾಯಕಾರಿ ವೆಬ್‌ಸೈಟ್‌ಗಳ ಕುರಿತು ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ. ನೀವು Phromium ಎಚ್ಚರಿಕೆಗಳನ್ನು ಸ್ಕಿಪ್ ಮಾಡಲು ಆಯ್ಕೆಮಾಡಬಹುದು.</translation>
<translation id="7228779501660520489">Phromium ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಿ</translation>
<translation id="2782053121162821">Phromium ಜೊತೆಗೆ ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="4281844954008187215">ಸೇವೆಯ ನಿಯಮಗಳು</translation>
<translation id="5084022108026911204">ಅನಿರ್ದಿಷ್ಟ ದೋಷದಿಂದಾಗಿ ಸ್ಥಾಪನೆಯು ವಿಫಲಗೊಂಡಿದೆ. Phromium ಪ್ರಸ್ತುತ ಚಾಲನೆಯಲ್ಲಿದ್ದರೆ, ದಯವಿಟ್ಟು ಅದನ್ನು ಮುಚ್ಚಿರಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="5139026954638666406">Phromium ನಿಂದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಮಾಡಿ</translation>
<translation id="4304713468139749426">ಪಾಸ್‌ವರ್ಡ್ ನಿರ್ವಾಹಕ</translation>
<translation id="4334241893986177674">ಈ ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅನ್ನು ಹುಡುಕಿ</translation>
<translation id="8324735155671556570">Windows ಪ್ರಾರಂಭವಾದಾಗ Phromium ಅನ್ನು ಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="4400772909124543403">ಯಾವುದೇ ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿಲ್ಲ</translation>
<translation id="2185735215611818026">ಹೇಗಿದ್ದರೂ Phromium ನಿಂದ ನಿರ್ಗಮಿಸುವುದೇ?</translation>
<translation id="4413205837991854510">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಯಾವಾಗಲೂ ತೋರಿಸಿ</translation>
<translation id="1338297030721125711">Phromium ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗಲು ಅನುಮತಿಸಿ</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK" />ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK" />}one{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK" />ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK" />}other{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK" />ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK" />}}</translation>
<translation id="1011403527148313450">Phromium ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಮತ್ತು ನಿಯಂತ್ರಿಸಿ</translation>
<translation id="4427306783828095590">ಫಿಶಿಂಗ್ ಮತ್ತು ಮಾಲ್‌ವೇರ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲು ವರ್ಧಿತ ಸುರಕ್ಷತೆ ಹೆಚ್ಚಿನ ಸಹಾಯ ಮಾಡುತ್ತದೆ</translation>
<translation id="4434353761996769206">ಇನ್‌ಸ್ಟಾಲರ್‌‌ ದೋಷ: <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415"><ph name="MANAGER" /> Phromium ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತದೆ</translation>
<translation id="2477616462388290618">Phromium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="4447409407328223819">Chrome for Testing ಕುರಿತು</translation>
<translation id="972523218852576493">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಉಳಿಸಲು, ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="4493028449971051158">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಅನ್ನು ನಿರ್ವಾಹಕರಾಗಿ ರನ್ ಮಾಡಿ.</translation>
<translation id="4501471624619070934">ಈ ರಾಷ್ಟ್ರದಲ್ಲಿ ಆ್ಯಕ್ಸೆಸ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿರುವುದರ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="8839763675940122379">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಡೇಟಾವನ್ನು ಹೇಗೆ ಸಂಗ್ರಹಿಸುತ್ತದೆ ಮತ್ತು ಬಳಸುತ್ತದೆ ಎಂಬಂತಹ ಗೌಪ್ಯತೆಯ ರೂಢಿಗಳನ್ನು ಪ್ರಕಟಿಸಿಲ್ಲ. ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.</translation>
<translation id="2339640488105852505">Phromium ಗೆ ಸುಸ್ವಾಗತ; ಹೊಸ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಹೊಸ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗಿದೆ</translation>
<translation id="8536959233160434213">ನಿಮ್ಮ ಸುತ್ತಲಿನ ಪರಿಸರವನ್ನು ನಕ್ಷೆ ಮಾಡಲು ಮತ್ತು ನಿಮ್ಮ ಕೈಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು Phromium ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="1077734277628859167">ನೀವು ಈಗಾಗಲೇ ಮತ್ತೊಂದು Phromium ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಮೂಲಕ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದೀರಿ</translation>
<translation id="5512897665247593318">Phromium, ಪುಟಗಳನ್ನು ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ಬ್ರೌಸಿಂಗ್ ಹಾಗೂ ಹುಡುಕಾಟ ವೇಗವಾಗುತ್ತದೆ. <ph name="BEGIN_LINK" /> ಪ್ರಿಲೋಡ್‌ ಪುಟಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">ನೀವು ಹಾನಿಕಾರಕವೆಂದು ಭಾವಿಸುವ ಸೈಟ್ ಕುರಿತು ನೀವು ವರದಿ ಮಾಡಿದಾಗ ಎಲ್ಲರಿಗೂ ಆನ್‌ಲೈನ್ ಸುರಕ್ಷತೆಯನ್ನು ಸುಧಾರಿಸಿ.</translation>
<translation id="6624033199018630177">ನೀವು ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಫೀಚರ್‌ ಅನ್ನು ಆಫ್ ಮಾಡಿರುವುದರಿಂದ ಮತ್ತು ಈ ಫೈಲ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗದ ಕಾರಣ Phromium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="3039804643080655517">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ Phromium ಮೂಲಕ Google Lens ಅನ್ನು ಬಳಸಿ ನೋಡಿ</translation>
<translation id="4594305310729380060">ಈ ಸಾಧನದಲ್ಲಿನ Password Manager ಗೆ</translation>
<translation id="8064263528617889755">Phromium ಅಪ್ಲಿಕೇಶನ್‌ಗಳು</translation>
<translation id="4598116752460667024">ಪಟ್ಟಿಯಿಂದ ಯಾವುದೇ ಪ್ರಕ್ರಿಯೆಗಾಗಿ ಹುಡುಕಿ.</translation>
<translation id="4613863813562375431">ChromiumOS ಆವೃತ್ತಿ</translation>
<translation id="7245201002247176127">ಬಹುಪಾಲು ನವೀಕೃತವಾಗಿದೆ! ಅಪ್‌ಡೇಟ್ ಮಾಡುವುದನ್ನು ಮುಗಿಸಲು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="8846891938874485868">Phromium ನ V8 ಇಂಜಿನ್‌ ಮೂಲಕ ಸೈಟ್‌ಗಳನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ, ಆದರೆ Phromium ದಾಳಿಗಳ ವಿರುದ್ದ ಸ್ವಲ್ಪ ಕಡಿಮೆ ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ</translation>
<translation id="7525500996671436081">Phromium ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="1224842000407297331">Phromium ಪ್ರೊಫೈಲ್</translation>
<translation id="4956303519269880412">ಎಚ್ಚರಿಕೆ: ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಇತಿಹಾಸವನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡದಂತೆ ವಿಸ್ತರಣೆಗಳನ್ನು ತಡೆಯಲು Phromium ಗೆ ಸಾಧ್ಯವಿಲ್ಲ. ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿ ವಿಸ್ತರಣೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು ಈ ಆಯ್ಕೆಯನ್ನು ಆರಿಸಬೇಡಿ.</translation>
<translation id="2708255035805733225">ನೀವು Phromium ಬಳಕೆಯ ವರದಿಗಳನ್ನು ಸಹ ಹಂಚಿಕೊಂಡರೆ, ಆ ವರದಿಗಳು ನೀವು ಭೇಟಿ ನೀಡುವ URL ಗಳನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ, ಸದಸ್ಯತ್ವ. ಖಾತೆಯ ಮೆನುವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="1883292567514549610">ಮತ್ತೊಂದು ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ (<ph name="HOST_NAME" />) ಇನ್ನೊಂದು Phromium ಪ್ರಕ್ರಿಯೆಯ (<ph name="PROCESS_ID" />) ಮೂಲಕ ಪ್ರೊಫೈಲ್ ಬಳಕೆಯಲ್ಲಿರುವಂತೆ ತೋರುತ್ತಿದೆ. ಪ್ರೊಫೈಲ್ ದೋಷಪೂರಿತಗೊಳ್ಳದಂತೆ ಅದನ್ನು Phromium ಲಾಕ್ ಮಾಡಿದೆ. ಇತರ ಯಾವುದೇ ಪ್ರಕ್ರಿಯೆಗಳು ಈ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಬಳಸುತ್ತಿಲ್ಲವೆಂದು ನಿಮಗೆ ಖಚಿತವಾಗಿದ್ದರೆ, ನೀವು ಪ್ರೊಫೈಲ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಬಹುದು ಮತ್ತು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬಹುದು.</translation>
<translation id="4680828127924988555">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ರದ್ದುಮಾಡಿ</translation>
<translation id="1889305042180577023">ನಿಮ್ಮ ಕೆಲವು Phromium ಡೇಟಾವನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಉಳಿಸಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="8079525505870459051">ನೀವು ಸೈನ್ ಇನ್ ಆಗಿರುವಾಗ, Phromium ನಲ್ಲಿ ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿನ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟನ್ನು ನೀವು ಬಳಸಬಹುದು. <ph name="SHORTCUT" /> ನಿಮ್ಮ Google ಸೇವೆಗಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="2171507067211697961">ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ <ph name="ACCOUNT_EMAIL_LAST" /> ನಂತೆ Phromium ಗೆ ಯಾರೋ ಈ ಹಿಂದೆಯೇ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಇರಿಸಿಕೊಳ್ಳಲು ಹೊಸ Phromium ಬಳಕೆದಾರರನ್ನು ರಚಿಸಿ.</translation>
<translation id="4724676981607797757">ಬೆಂಬಲವಿಲ್ಲದ ಪ್ರೊಟೊಕಾಲ್ ದೋಷದಿಂದಾಗಿ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="6925701206088903005">ಹೇಗಿದ್ದರೂ Phromium ಅನ್ನು ಮುಚ್ಚುವುದೇ?</translation>
<translation id="4514755609496543621">Phromium ಗೆ ವಿಶೇಷ ಸುರಕ್ಷತೆಯ ಅಪ್‌ಡೇಟ್‌‌ ಅನ್ನು ಈಗ ತಾನೇ ಅನ್ವಯಿಸಲಾಗಿದೆ. ಇದೀಗ ಮರುಪ್ರಾರಂಭಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ನಾವು ಮರುಸ್ಥಾಪಿಸುತ್ತೇವೆ.</translation>
<translation id="8673673368917636496">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, ಮತ್ತು ಇನ್ನೂ <ph name="COUNT" /> ಅನ್ನು Phromium ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="3638319732826965647">Phromium ನಲ್ಲಿ Gemini ತೆರೆದಿದ್ದರೆ, ನೀವು ಹೊಸ ಟ್ಯಾಬ್‌ಗಳನ್ನು ತೆರೆದಾಗಲೂ ಸೈಡ್ ಪ್ಯಾನೆಲ್ ತೆರೆದ ಸ್ಥಿತಿಯಲ್ಲಿಯೇ ಇರುತ್ತದೆ</translation>
<translation id="479167709087336770">ಇದು Google ಹುಡುಕಾಟದಲ್ಲಿ ಬಳಸಲಾದ ಅದೇ ಕಾಗುಣಿತ ಪರೀಕ್ಷೆಯನ್ನು ಬಳಸುತ್ತದೆ. ನೀವು ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡುವ ಪಠ್ಯವನ್ನು Google ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ನೀವು ಈ ವರ್ತನೆಯನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="2659245507243672392">Phromium ಅನ್ನು ಖಾತೆಯಿಲ್ಲದೆಯೇ ಬಳಸಿ</translation>
<translation id="166411027652942990">mDNS ಟ್ರಾಫಿಕ್‌ಗೆ ಅನುಮತಿಸುವ ನಿಟ್ಟಿನಲ್ಲಿ Phromium ಗೆ ಒಳಬರುವ ನಿಯಮ.</translation>
<translation id="6031862420354068813">&amp;Phromium ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="4918086044614829423">ಸಮ್ಮತಿಸು</translation>
<translation id="4918844574251943176">ಚಿತ್ರವನ್ನು ಕಾಪಿ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="1531905832227009774">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಓದುವ ಪಟ್ಟಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="4319892378006430019">Phromium ಹಿನ್ನೆಲೆ ಮೋಡ್‌ನಲ್ಲಿದೆ.</translation>
<translation id="8972359100025490790">Phromium ಸೈನ್ ಇನ್ ಡೈಲಾಗ್ ಅನ್ನು ಮುಚ್ಚಲು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="3639078149590125530">Phromium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು Phromium ಗೆ ಸಂಬಂಧಿಸಿದ ನಿಮ್ಮ ಎಲ್ಲಾ ಸಂಗತಿಗಳನ್ನು ನೀವು ಪ್ರತ್ಯೇಕವಾಗಿಸಬಹುದು. ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರಿಗಾಗಿ ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ರಚಿಸಿ ಅಥವಾ ಕೆಲಸ ಮತ್ತು ಮೋಜಿನ ವಿಷಯಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿಸಿ.</translation>
<translation id="7141327976224964788">ಅತಿಥಿಗಳು ಏನನ್ನೂ ಉಳಿಸದೆಯೇ Phromium ಬಳಸಬಹುದು.</translation>
<translation id="7007327521155149139">Phromium ನಲ್ಲಿನ ನಿಮ್ಮ ಖಾತೆ</translation>
<translation id="5973804420920585431">ನೀವಾಗಿಯೇ Phromium ಗೆ ಸೇರಿಕೊಳ್ಳಿ</translation>
<translation id="504699503110800016">ಓವರ್‌ಫ್ಲೋ ಮೆನು ತೆರೆಯಿರಿ</translation>
<translation id="2497925691306722252">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ Phromium ಮೂಲಕ ನಿಮ್ಮ ಎಲ್ಲಾ Google ಮೆಚ್ಚಿನವುಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಿ</translation>
<translation id="8678196879882043620">ನಿಮ್ಮ ಹ್ಯಾಂಡ್‌ಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು Phromium ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="3397880081430454820">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> ಅನ್ನು Phromium ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="9114243566897924763">Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="5174969993834422967">ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತೀರಿ. ನಿಮಗೆ ಸೂಚನೆ ನೀಡಲು ಈ ಸೈಟ್‌ಗೆ ಅನುಮತಿಸುವುದಕ್ಕಾಗಿ, ನಿಮ್ಮ ಸ್ಥಳ ಪಟ್ಟಿಯ ಬಲ ಮೂಲೆಯಲ್ಲಿರುವ ನೋಟಿಫಿಕೇಶನ್ ಐಕಾನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="5174983315706567306">ಸಾಕಷ್ಟು ಡಿಸ್ಕ್ ಸ್ಪೇಸ್ ಇಲ್ಲ.</translation>
<translation id="7698884672439844280">Phromium ಖಾತೆಗೆ ಸಂಬಂಧಿಸಿದಂತೆ ಮರು-ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ</translation>
<translation id="5629965056131882780">iOS ನಲ್ಲಿ Phromium ಬಳಸುವ ಮೂಲಕ ನೀವು ಎಲ್ಲಿ ನಿಲ್ಲಿಸಿದ್ದಿರೋ ಅಲ್ಲಿಂದಲೇ ಮುಂದುವರಿಸಿ.</translation>
<translation id="874294566462998787">Phromium ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಿ</translation>
<translation id="5234764350956374838">ವಜಾಗೊಳಿಸಿ</translation>
<translation id="8605581794204249702">ಲಿಂಕ್ ಅನ್ನು Phromium ಅಜ್ಞಾತ ವಿಂಡೋದಲ್ಲಿ ತೆರೆಯಿರಿ</translation>
<translation id="8722804301463582643">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಲು Phromium ಆ್ಯಪ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="6253936671561887082">ನಿಮ್ಮ ಬದಲಾವಣೆಗಳನ್ನು ಅನ್ವಯಿಸಲು, Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="7405713141437293142">ಈ ಟ್ಯಾಬ್ ಅನ್ನು ಬೇರೊಂದು ಸಾಧನಕ್ಕೆ ಕಳುಹಿಸಲು, ಎರಡೂ ಸಾಧನಗಳಲ್ಲಿ Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="5286907366254680517">ಪತ್ತೆಹಚ್ಚಲಾಗಿದೆ</translation>
<translation id="2224284460884535818">Phromium ಆ್ಯಪ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="1426207087952749578">ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿ ಬ್ರೌಸ್ ಮಾಡುವಾಗ, ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ಸೈಟ್ ಅನ್ನು ಲೋಡ್ ಮಾಡುವ ಮೊದಲು Phromium ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ</translation>
<translation id="8108751453879231987">Phromium ಮೂಲಕ ಹುಡುಕಿ</translation>
<translation id="7780358745459835678">Phromium ಅಪ್‌ಡೇಟರ್ ಆಂತರಿಕ ಸೇವೆ</translation>
<translation id="6956753580765202069">Phromium ನಲ್ಲಿ ಇತರ Gemini ಫೀಚರ್‌ಗಳ ಜೊತೆಗೆ ಅವುಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="5346389065299425353">ಹಲವಾರು ಟ್ಯಾಬ್‌ಗಳು, ಫೈಲ್‌ಗಳು ಮತ್ತು ಟೂಲ್‌ಗಳನ್ನು ಸೇರಿಸುವ ಮೂಲಕ ನಿಮ್ಮ ಹುಡುಕಾಟವನ್ನು ಇನ್ನಷ್ಟು ಆಳವಾಗಿಸಿ</translation>
<translation id="8684266995248242891">ಈ ಡಾಕ್ಯುಮೆಂಟ್‌ನ ತ್ವರಿತ ಓವರ್‌ವ್ಯೂ ಪಡೆಯಿರಿ ಮತ್ತು Phromium ನಲ್ಲಿ Gemini ಮೂಲಕ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಿ</translation>
<translation id="586104673506947714">Phromium ನಿಮ್ಮ ಪರಿಶೀಲನೆಗಾಗಿ ಕೆಲವು ಸುರಕ್ಷತೆಯ ಶಿಫಾರಸುಗಳನ್ನು ಕಂಡುಕೊಂಡಿದೆ</translation>
<translation id="4657908558997566735">ಇತರ Phromium ಪ್ರೊಫೈಲ್‌ಗಳು</translation>
<translation id="6097378010983112326">ನಿಮ್ಮ ಖಾತೆಯ ಸೈನ್ ಇನ್ ವಿವರಗಳು ತೀರಾ ಹಳೆಯದಾಗಿರುವ ಕಾರಣ ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ChromiumOS ಗೆ ಸಾಧ್ಯವಾಗಲಿಲ್ಲ</translation>
<translation id="385020720581757591">ನೀವು ನಿರ್ವಹಿಸಲಾದ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡುತ್ತಿರುವಿರಿ ಮತ್ತು ನಿಮ್ಮ Phromium ಪ್ರೊಫೈಲ್ ಮೂಲಕ ಅದರ ನಿರ್ವಾಹಕ ನಿಯಂತ್ರಣವನ್ನು ನೀಡುತ್ತಿರುವಿರಿ. ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಹಾಗೂ ಇತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಂತಹ ನಿಮ್ಮ Phromium ಡೇಟಾವನ್ನು <ph name="USER_NAME" /> ಅವರಿಗೆ ಶಾಶ್ವತವಾಗಿ ಬಂಧಿಸಲಾಗುತ್ತದೆ. Google ಖಾತೆಗಳ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಮೂಲಕ ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯ, ಆದರೆ ಬೇರೊಂದು ಖಾತೆಯೊಂದಿಗೆ ಈ ಡೇಟಾವನ್ನು ಸಂಯೋಜಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">ಹೆಚ್ಚುವರಿ ಕೋಡ್: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">ವೈಯಕ್ತೀಕರಣವನ್ನು ಪಡೆಯಲು, ವೆಬ್ ಮತ್ತು ಆ್ಯಪ್ ಚಟುವಟಿಕೆಯಲ್ಲಿ Phromium ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="2756028035855809142">Phromium ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="4375021373215585423">Phromium ಕೆಲವು ಫೈಲ್‌ಗಳನ್ನು ಏಕೆ ನಿರ್ಬಂಧಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="4688227912949761884">Phromium ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="4945147853702701048">Phromium ಸೈನ್-ಇನ್ ಅನ್ನು ಅನುಮತಿಸಿ</translation>
<translation id="7813879193794658604">Phromium ನಿಂದ ತೆಗೆದುಹಾಕಿ</translation>
<translation id="2908302339618007937">ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಕಡಿಮೆ ಮಾಡುತ್ತದೆ ಆದರೆ Phromium ಅನ್ನು ಅಸಿಮೆಟ್ರಿಕ್ ಎನ್‌ಕ್ರಿಪ್ಶನ್‌ಗಳ ವಿರುದ್ದ ಮತ್ತಷ್ಟು ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ</translation>
<translation id="8760365573983490520">Phromium ಅನ್ನು ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್‌ ರೂಪದಲ್ಲಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> - Phromium ಬೀಟಾ</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್ ಅನ್ನು ವಿರಾಮಗೊಳಿಸಲು Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}one{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}other{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}}</translation>
<translation id="975923236500175446">ಈ Linux ವಿತರಣೆಯಲ್ಲಿ ಇನ್ನು ಮುಂದೆ Phromium ಬೆಂಬಲಿಸದಿರುವ ಕಾರಣ, ಅದು ಸರಿಯಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು</translation>
<translation id="7595270580374414215">Phromium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಏಕೆಂದರೆ ಫೈಲ್ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮತ್ತು ಸಾಮಾಜಿಕ ನೆಟ್‌ವರ್ಕ್ ಖಾತೆಗಳಿಗೆ ಹಾನಿಯುಂಟುಮಾಡಬಹುದು</translation>
<translation id="5644162187312430027">ದಯವಿಟ್ಟು ಇತ್ತೀಚಿನ ಸಿಸ್ಟಂ ನವೀಕರಣಗಳನ್ನು Phromium ಸ್ಥಾಪಿಸುವಾಗ ಕಾಯಿರಿ.</translation>
<translation id="2476033563817685908">Phromium, ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಎಡಿಟ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="1626952238284562558">Phromium ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ Google Drive ಮತ್ತು YouTube ನಂತಹ ನಿಮ್ಮ ಮೆಚ್ಚಿನ ಆ್ಯಪ್‌ಗಳೊಂದಿಗೆ ತಡೆರಹಿತವಾಗಿ ಕೆಲಸ ಮಾಡಿ.</translation>
<translation id="5524890928877629608">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಮೇಲಿನ ಎಡ ಮೂಲೆ: ಎಡಕ್ಕೆ <ph name="LEFT" />%, ಮೇಲಕ್ಕೆ <ph name="TOP" />%</translation>
<translation id="2860766395826060492">Phromium ನಲ್ಲಿ PDF ಗಳನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="5536164441519929134">ಈ ಟ್ಯಾಬ್ ಕುರಿತು<ph name="LINE_BREAK" />ಕೇಳಿ</translation>
<translation id="3915500272078806319">ಭದ್ರತೆಗಾಗಿ, ನೀವು ಮೊದಲ ಬಾರಿಗೆ ಸೈಟ್‌ಗೆ ಭೇಟಿ ನೀಡಿದಾಗ JavaScript ಆಪ್ಟಿಮೈಸೇಷನ್ ಅನ್ನು Phromium ಆಫ್ ಮಾಡುತ್ತದೆ.

ಈ ಪುಟವು ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸದಿದ್ದರೆ, ಆಪ್ಟಿಮೈಸೇಷನ್‌ ಅನ್ನು ಅನುಮತಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="6778733300408894918">Phromium ನಲ್ಲಿ Gemini ಅನ್ನು Mac ಮೆನು ಬಾರ್‌ನಲ್ಲಿ ತೋರಿಸಿ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="8411908790152555435"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="5579324208890605088">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಅನ್ನು ಸಾಮಾನ್ಯ ಬಳಕೆದಾರರಂತೆ ರನ್ ಮಾಡಿ, ನಿರ್ವಾಹಕರಾಗಿ ಅಲ್ಲ.</translation>
<translation id="6578510724610627339">Phromium ಅನ್ನು ಡೀಫಾಲ್ಟ್ ಆಗಿ ಬಳಸಿ ಮತ್ತು ಅದು ಪಿನ್ ಆಗಿರಲಿ</translation>
<translation id="5596627076506792578">ಇನ್ನಷ್ಟು ಆಯ್ಕೆಗಳು</translation>
<translation id="5605834417512968703">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಹುಡುಕಲು ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನಿಂದ ನಿರ್ಗಮಿಸಲು Escape ಒತ್ತಿರಿ</translation>
<translation id="5618818588972826921">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಹುಡುಕಲು ಯಾವುದೇ ಪಠ್ಯ ಅಥವಾ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆ ಮಾಡಿ ಅಥವಾ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನಿಂದ ಹೊರಬರಲು escape ಅನ್ನು ಒತ್ತಿ</translation>
<translation id="4431270188253419020">{0,plural, =0{Phromium ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ}=1{Phromium ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ}one{# ದಿನಗಳ ಮಟ್ಟಿಗೆ Phromium ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ}other{# ದಿನಗಳ ಮಟ್ಟಿಗೆ Phromium ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ}}</translation>
