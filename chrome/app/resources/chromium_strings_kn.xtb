<translation id="6646104775883837119">Phromium ಶೀಘ್ರದಲ್ಲೇ ಮುಚ್ಚಲ್ಪಡುತ್ತದೆ ಮತ್ತು ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ</translation>
<translation id="6138634751748297112">ನೀವು ಇಲ್ಲಿ Phromium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು</translation>
<translation id="8660563290103481109">ನೀವು ಕುಕೀಗಳನ್ನು ಅನುಮತಿಸಿದರೆ, ಪ್ರಿಲೋಡ್ ಮಾಡುವಾಗ Phromium ಅವುಗಳನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="6165508094623778733">ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="969667123257916656">ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ Phromium ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸಿ</translation>
<translation id="5528040738212560214">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಬಹುದು<ph name="LINE_BREAK" />ನೀವು ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಒದಗಿಸಿದರೆ Phromium ನಿಮಗಾಗಿ ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ಪರಿಶೀಲಿಸಬಹುದು. ಫೈಲ್ ಕುರಿತು ಮಾಹಿತಿಯನ್ನು Google Safe Browsing ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ, ಆದರೆ ಫೈಲ್‌ನ ವಿಷಯಗಳು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಉಳಿಯುತ್ತದೆ.</translation>
<translation id="6182736845697986886">ಅಪ್‌ಡೇಟ್ ಸರ್ವರ್ ಆಂತರಿಕ ದೋಷದಿಂದಾಗಿ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="6041381825442292659">ನಿಮ್ಮ <ph name="TARGET_DEVICE_NAME" /> ನಲ್ಲಿ ನೀವು Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದೀರಿ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ನಂತರ ಪುನಃ ಕಳುಹಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2474943719592372017">Phromium ಅನ್ನು ಮಿನಿಮೈಸ್ ಮಾಡಿದ್ದರೂ ಸಹ, ಎಲ್ಲಿಂದಲಾದರೂ ಹುಡುಕಿ ಮತ್ತು ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಿ. Phromium ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗಲು ಅನುಮತಿಸುತ್ತದೆ.</translation>
<translation id="2518372260387069450">ಈ ಕಂಪ್ಯೂಟರ್ Phromium ನ ಇತ್ತೀಚಿನ ಹೆಚ್ಚಿನ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿದೆ. ಸಾಫ್ಟ್‌ವೇರ್ ಕಾರ್ಯನಿರ್ವಹಿಸದಿದ್ದರೆ, ದಯವಿಟ್ಟು Phromium ಅನ್ನು ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="3832895416321159809">{0,plural, =0{ಇದೀಗ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}=1{1 ಸೆಕೆಂಡಿನಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ಸೆಕೆಂಡುಗಳಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ಸೆಕೆಂಡುಗಳಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="2775110773501098464">ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು Phromium ಗೆ ಸಂಗ್ರಹಣೆಯ ಪ್ರವೇಶದ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="3505491405575013121">Phromium ನಲ್ಲಿ ಸಂಗ್ರಹಣೆ ಮಾಡಲಾಗಿರುವ ಅಸುರಕ್ಷಿತ ಸೈಟ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಬಳಸಿ, URL ಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ</translation>
<translation id="2276249127856880228">Phromium ಅನ್ನು ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಮಾಡಿ</translation>
<translation id="6248988683584659830">ಸೆಟ್ಟಿಂಗ್‌‌ಗಳಲ್ಲಿ ಹುಡುಕಿ</translation>
<translation id="554637698797403739">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ Phromium ಆ್ಯಪ್ ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ Google ನ ಅತ್ಯುತ್ತಮ ಸುರಕ್ಷತಾ ಫೀಚರ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="7016155178198587734">Phromium ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಬೇಕೆ?</translation>
<translation id="5660287988409470276">ಈ ಟ್ಯಾಬ್‌ಗಳು ಹೆಚ್ಚುವರಿ ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸುತ್ತಿವೆ. ನಿಮ್ಮ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು, ಅವುಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು Phromium ಅನ್ನು ಅನುಮತಿಸಿ.</translation>
<translation id="8429776045186716992">ನಿಮ್ಮ Phromium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="3310436202618971091">ನಿಮ್ಮ Phromium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಹೆಸರಿಸಿ</translation>
<translation id="1478750151648434251">Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ನಿಮ್ಮನ್ನು ಕೇಳುತ್ತದೆ</translation>
<translation id="9139712828910812615"><ph name="FILE_NAME" /> ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು, ಹಾಗಾಗಿ Phromium ಅದನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ.</translation>
<translation id="5191618263102115907">Phromium ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="8247508943089477519">Phromium ನಲ್ಲಿ ಬೇರೆ ಕಾರ್ಯಾಚರಣೆಯು ಪ್ರಗತಿಯಲ್ಲಿದೆ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8271488218611798813">ನಿಮ್ಮ Google ಖಾತೆಯ ಮೂಲಕ ಮತ್ತು ಹಂಚಿದ ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ Phromium ಬಳಕೆಯು ಇದೀಗ ತುಂಬಾ ಸುಲಭವಾಗಿದೆ.</translation>
<translation id="446228390478495078">Phromium ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಸೆಟ್ ಮಾಡುವ ಮೂಲಕ ನಿಮಗೆ ತಿಳಿದಿರುವ, ಇಷ್ಟಪಡುವ ಮತ್ತು ವಿಶ್ವಾಸವಿಡುವ ಫೀಚರ್‌ಗಳಿಗೆ ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್ ಪಡೆಯಿರಿ.</translation>
<translation id="2203435422524224690">Phromium ಶಾರ್ಟ್‌ಕಟ್</translation>
<translation id="3977517784144885449">ಈ ಫೈಲ್ ಅನ್ನು ಸಾಮಾನ್ಯ ರೀತಿಯಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡದ ಕಾರಣ Phromium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಹಾಗೂ ಇದು ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು</translation>
<translation id="8088471547690853921">Phromium ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನೀವು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ?</translation>
<translation id="6375219077595103062">Password Manager ಗೆ ಶಾರ್ಟ್‌ಕಟ್ ಸೇರಿಸಿ</translation>
<translation id="6388799252195623474">ಈ ಕುರಿತು ನನಗೆ ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="1774421040071124552">ಮುಂದುವರಿಯಲು, Phromium ಗೆ <ph name="EMAIL" /> ಎಂಬುದಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ಇದು ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ನೀತಿಗಳನ್ನು ನೀವು ಪಡೆದುಕೊಂಡಿದ್ದೀರಿ ಎಂದು ಖಚಿತಪಡಿಸುತ್ತದೆ.</translation>
<translation id="2343430845154053061">ಕಂಪ್ಯೂಟರ್ ಸ್ಕ್ರೀನ್‌ನೊಳಗೆ Phromium ಲೋಗೋ.</translation>
<translation id="2724924185145648602">Phromium ಒಂದು ವೆಬ್ ಬ್ರೌಸರ್ ಆಗಿದ್ದು ವೆಬ್‌ಪುಟಗಳನ್ನು ಮತ್ತು ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ವೇಗದೊಂದಿಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ. ಇದು ವೇಗವಾದ, ಸ್ಥಿರವಾದ, ಮತ್ತು ಬಳಸಲು ಸುಲಭವಾಗಿದೆ. ಮಾಲ್‌ವೇರ್‌ನೊಂದಿಗೆ ಹೆಚ್ಚು ಸುರಕ್ಷಿತವಾಗಿ ಹಾಗೂ Phromium ನಲ್ಲಿ ವಿನ್ಯಾಸಗೊಳಿಸಲಾದ ಫಿಶಿಂಗ್ ಸುರಕ್ಷೆಯೊಂದಿಗೆ ವೆಬ್ ಅನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ.</translation>
<translation id="7417453886359805803">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ನೀವು ಯಾವಾಗಲೂ Phromium ಡೇಟಾವನ್ನು ಬಳಸಬಹುದು ಮತ್ತು ಸೇವ್ ಮಾಡಬಹುದು ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಲು, ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸಿ</translation>
<translation id="3304683228794166031">Phromium ವೇಗವಾಗಿ ರನ್ ಆಗುತ್ತದೆ ಮತ್ತು JavaScript ಅನ್ನು ಬಳಸುವ ಫೀಚರ್‌ಗಳು, ವಿನ್ಯಾಸಗೊಳಿಸಿದಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸಬೇಕು</translation>
<translation id="6436260184216827876">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಲಭ್ಯವಿಲ್ಲ. ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="6442900851116057561">ChromiumOS ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="9164801375934097818">ನೀವು ಭೇಟಿ ನೀಡುವ ಸಾಧ್ಯತೆಯಿರುವ ಇನ್ನೂ ಹೆಚ್ಚಿನ ಪುಟಗಳನ್ನು Phromium ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಅವುಗಳಿಗೆ ಭೇಟಿ ನೀಡಿದಾಗ ಅವುಗಳು ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ</translation>
<translation id="2577121659922309103">ದರಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಮತ್ತು ಯಾವುದೇ ಸೈಟ್‌ನಲ್ಲಿ ದರ ಇಳಿಕೆಯಾದಾಗ ಅಲರ್ಟ್‌ಗಳನ್ನು ಪಡೆಯಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Phromium ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ</translation>
<translation id="2052328618318278030">ಆಫ್ • ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ ಎಂಬುದನ್ನು ಪರಿಶೀಲಿಸಲು Phromium ಗೆ ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="3122296739697671126">Phromium ಪ್ರೊಫೈಲ್‌ಗಳಿಗೆ ಸುಸ್ವಾಗತ</translation>
<translation id="3472445024540245926">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ ನೀವು Phromium ಅನ್ನು ತೆರೆದಾಗ, ಟ್ಯಾಬ್ ಗುಂಪುಗಳನ್ನು ಬಳಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="2144084801479939969">Phromium ನಿಂದ ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="2473490714352939152">ನೀವು Phromium ಪ್ರಾರಂಭಿಸಿದಾಗ ತೋರಿಸಬೇಕಾದ ಪುಟವನ್ನು ಕೂಡಾ ಇದು ನಿಯಂತ್ರಿಸುತ್ತದೆ.</translation>
<translation id="648319183876919572">ಅಪಾಯಕಾರಿ ವೆಬ್‌ಸೈಟ್‌ಗಳು ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳ ವಿರುದ್ಧ ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸಲು ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಹೆಚ್ಚಿನ ಸಹಾಯ ಮಾಡುತ್ತದೆ</translation>
<translation id="359777544552173333">Phromium ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="3890462049854841354">Phromium ನಲ್ಲಿ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳು ತೆರೆದಿರುತ್ತವೆ</translation>
<translation id="6616579671682178785">Phromium ಅನ್ನು <ph name="TIMEOUT_DURATION" /> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದನ್ನು ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.</translation>
<translation id="8662645370371079862">ಪ್ರತಿಯೊಂದು ಪ್ರೊಫೈಲ್ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟವುಗಳಂತಹ ತನ್ನ ಸ್ವಂತ Phromium ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ</translation>
<translation id="6556755379298048869">ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಮೂಲಕ ಹುಡುಕಿ.</translation>
<translation id="7133640529688742768"><ph name="BEGIN_LINK" />Phromium ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಹೇಗೆ ಖಾಸಗಿಯಾಗಿ ಇರಿಸುತ್ತದೆ<ph name="END_LINK" /> ಎಂಬುದರ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="8316065704185291024">Phromium ಮರುಪ್ರಾರಂಭಗೊಂಡ ನಂತರ ಈ ಸೆಟ್ಟಿಂಗ್‌ಗೆ ಬದಲಾವಣೆಗಳನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="2816396636285296289">Phromium ಮುಖ್ಯ ಮೆನುವಿನಲ್ಲಿರುವ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ಕ್ಲಿಕ್ ಮಾಡುವ ಮೂಲಕ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ.</translation>
<translation id="8831144879019828189">ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಲು ನೀವು ಇನ್ನೊಂದು Phromium ಪ್ರೊಫೈಲ್‌ಗೆ ಬದಲಾಯಿಸಬಹುದು</translation>
<translation id="7017911482442558099">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಅತ್ಯುತ್ತಮ AI ಟೂಲ್‌ಗಳನ್ನು ಬಳಸಲು Phromium ಆ್ಯಪ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="5784574554904759369">ಕಾಗುಣಿತ ದೋಷಗಳನ್ನು ಸರಿಪಡಿಸಲು, ನೀವು ಪಠ್ಯ ಕ್ಷೇತ್ರಗಳಲ್ಲಿ ಟೈಪ್ ಮಾಡುವ ಪಠ್ಯವನ್ನು Phromium, Google ಗೆ ಕಳುಹಿಸುತ್ತದೆ</translation>
<translation id="8485501471305987872">Phromium ನೋಟಿಫಿಕೇಶನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ</translation>
<translation id="6600016381025017075">ಈ ಪುಟದಲ್ಲಿ ಯಾವುದನ್ನಾದರೂ ಹುಡುಕಿ</translation>
<translation id="1462793186918694806">ನೀವು ಮುಂದಿನ ಬಾರಿ Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಕಾರ್ಯಗತಗೊಳ್ಳುತ್ತವೆ.</translation>
<translation id="7501991510212476553">Windows ಪ್ರಾರಂಭವಾದಾಗ Phromium ಈಗ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ನೀವು ತಕ್ಷಣವೇ ಬ್ರೌಸ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಬಹುದು. ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಇದನ್ನು ಆಫ್ ಮಾಡಬಹುದು.</translation>
<translation id="7686308613268368175">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಯಿರಿ: Phromium ನಿಮ್ಮ ಕೊನೆಯ ಸೆಶನ್‌ನಿಂದ ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಿದೆ. ನೀವು ಇದನ್ನು ಇದರಲ್ಲಿ ಆಫ್ ಮಾಡಬಹುದು</translation>
<translation id="5266723901802366313">ನಿಮ್ಮ ಸುತ್ತಮುತ್ತಲಿನ ಪ್ರದೇಶದ 3D ನಕ್ಷೆಯನ್ನು ರಚಿಸಲು Phromium ಗೆ ಕ್ಯಾಮರಾ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="7085315067428293799">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಸಹ ನೀವು ಸೇವ್ ಮಾಡಿದರೆ, ನೀವು Phromium ನಲ್ಲಿ ಉತ್ಪನ್ನದ ಬೆಲೆಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಬಹುದು ಮತ್ತು ಬೆಲೆ ಕಡಿಮೆಯಾದಾಗ ಸೂಚನೆ ಪಡೆಯಬಹುದು</translation>
<translation id="6676384891291319759">ಇಂಟರ್ನೆಟ್ ಅನ್ನು ಪ್ರವೇಶಿಸಿ</translation>
<translation id="668175097507315160">ಸೈನ್ ಇನ್ ಮಾಡುವಾಗ ದೋಷವಿರುವ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromiumOS ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ.</translation>
<translation id="5279767706090517695">Phromium ನಿಂದ ಈ ಆ್ಯಪ್‌ನ ಡೇಟಾವನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="6562226321659107531">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ Phromium ಗೆ ಮೈಕ್ರೊಫೋನ್ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="6712881677154121168">ಡೌನ್‌ಲೋಡ್ ದೋಷ: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">Phromium ನ ಹೊಸ ಆವೃತ್ತಿಯಾಗಿರುವುದರಿಂದ ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಬಳಸಲಾಗುವುದಿಲ್ಲ. ಕೆಲವೊಂದು ವೈಶಿಷ್ಟ್ಯಗಳು ಲಭ್ಯವಿಲ್ಲದಿರಬಹುದು. ದಯವಿಟ್ಟು ಬೇರೆ ಒಂದು ಪೊಫೈಲ್ ಡೈರೆಕ್ಟರಿ ಅನ್ನು ನಿರ್ದಿಷ್ಟಪಡಿಸಿ ಅಥವಾ Phromium ನ ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಬಳಸಿ.</translation>
<translation id="4914871493602315663">ವೈಯಕ್ತೀಕರಣ ಮತ್ತು ಇತರ ಫೀಚರ್‌ಗಳನ್ನು ಪಡೆಯಲು, ವೆಬ್ ಮತ್ತು ಆ್ಯಪ್ ಚಟುವಟಿಕೆ ಹಾಗೂ ಲಿಂಕ್ ಮಾಡಲಾದ Google ಸೇವೆಗಳಲ್ಲಿ Phromium ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="5919390816124912606">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿನ ಎಲ್ಲ ಬಳಕೆದಾರರಿಗೆ ಈಗಾಗಲೇ Phromium ಸ್ಥಾಪಿತವಾಗಿದೆ.</translation>
<translation id="5867815953973052697">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ಬುಕ್‌ಮಾರ್ಕ್ ಅನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="7381168634819530324">Phromium ನ V8 ಇಂಜಿನ್‌ ಮೂಲಕ ಸೈಟ್‌ಗಳನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ, ಆದರೆ Phromium ದಾಳಿಗಳ ವಿರುದ್ದ ಸ್ವಲ್ಪ ಕಡಿಮೆ ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ. ಈ ಸೆಟ್ಟಿಂಗ್ ಆನ್ ಆಗಿದೆ.</translation>
<translation id="1509688792864707851">{count,plural, =1{ನಿಮ್ಮ ಕೆಲವು Phromium ಡೇಟಾವನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು (1 ಐಟಂ) ಅಳಿಸಲಾಗುತ್ತದೆ.}one{ನಿಮ್ಮ ಕೆಲವು Phromium ಡೇಟಾವನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}other{ನಿಮ್ಮ ಕೆಲವು Phromium ಡೇಟಾವನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}}</translation>
<translation id="4702638565169602649">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು, ಆದ್ದರಿಂದ ಇದನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಬೇಕೆಂದು Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.</translation>
<translation id="6779406956731413166">ಹೆಚ್ಚುವರಿ <ph name="BEGIN_LINK_CROS_OSS" />ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_CROS_OSS" /> ನಿಂದ ChromiumOS ಮಾಡಲು ಸಾಧ್ಯ.</translation>
<translation id="6831043979455480757">Translate</translation>
<translation id="1564864902402454287">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಎಂದಾದರೂ ಹ್ಯಾಕ್‌ ಆಗಿವೆಯೇ ಎಂಬುದನ್ನು Phromium ನಿಮಗೆ ತಿಳಿಸುತ್ತದೆ</translation>
<translation id="684888714667046800">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ನೀವು ಫೈರ್‌ವಾಲ್ ಅನ್ನು ಬಳಸುತ್ತಿದ್ದರೆ, <ph name="PRODUCT_EXE_NAME" /> ಅನುಮತಿ ಪಟ್ಟಿಯಲ್ಲಿ ಇದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="6200419390448865091">Phromium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">ಮುಂದುವರಿಸಲು ಟ್ಯಾಬ್ ಅನ್ನು ಒತ್ತಿರಿ</translation>
<translation id="6862030660799253820">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಬಳಸಿಕೊಂಡು ಈ ಚಿತ್ರವನ್ನು ಹುಡುಕಿ</translation>
<translation id="6869568587896659271">ವಿಳಾಸ ಪಟ್ಟಿಯ ಕೆಳಗಿನ ವೆಬ್‌ಸೈಟ್‌ಗಳಿಗೆ ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್</translation>
<translation id="4011399428346318467">"<ph name="EXTENSION_NAME" />" ನಲ್ಲಿ ಮಾಲ್‌ವೇರ್ ಇರುವುದನ್ನು Phromium ಪತ್ತೆಹಚ್ಚಿದೆ</translation>
<translation id="6877155553248388166">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಕೆಳಗಿನ ಬಲ ಮೂಲೆ: ಬಲಕ್ಕೆ <ph name="RIGHT" />%, ಕೆಳಕ್ಕೆ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">ನಕಲಿಸು</translation>
<translation id="6898028264630240901">ನೀವು ಬ್ರೌಸ್ ಮಾಡುವಾಗ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು ನೀವು ಸಾಂದರ್ಭಿಕ ಕಾರ್ಯಗಳನ್ನು ಪಿನ್ ಮಾಡಬಹುದು</translation>
<translation id="1012681980425424211">Phromium ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ ಮತ್ತು ಅದನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="1744625657438211994">&amp;Phromium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="7264818828956697552">ಈ ಕ್ರಿಯೆಯು:
          <ph name="LINE_BREAKS" />
            • ನಿಮ್ಮ ಆರಂಭಿಕ ಪುಟ, ಹೊಸ ಟ್ಯಾಬ್ ಪುಟ, ಸರ್ಚ್ ಎಂಜಿನ್ ಮತ್ತು ಪಿನ್ ಮಾಡಿದ ಟ್ಯಾಬ್‌ಗಳನ್ನು ರೀಸೆಟ್ ಮಾಡುತ್ತದೆ
            <ph name="LINE_BREAK" />
            • ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAK" />
            • ಕುಕೀಗಳು ಮತ್ತು ಇತರ ತಾತ್ಕಾಲಿಕ ಸೈಟ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAK" />
            • Phromium ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ರೀಸೆಟ್ ಮಾಡುತ್ತದೆ
            <ph name="LINE_BREAKS" />
            ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಸೇವ್ ಮಾಡಿದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳ ಮೇಲೆ ಇದು ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ.</translation>
<translation id="6489000842445481390">ನೀವು Phromium ನ <ph name="BOOKMARK_LIMIT" /> ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳ ಮಿತಿಯನ್ನು ತಲುಪಿದ್ದೀರಿ, ಆದ್ದರಿಂದ ನಿಮ್ಮ ಕೆಲವು ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಇನ್ನೂ ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ.

ನೀವು ಕೆಲವು ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಅಳಿಸುವವರೆಗೆ ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ ಹೊಸ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಸೇವ್ ಮಾಡದ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="2645108248038996858">Phromium ಅ&amp;ದೃಶ್ಯ ವಿಂಡೋದಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="6965382102122355670">ಸರಿ</translation>
<translation id="6985329841647292029">ChromiumOS ನಿಯಮಗಳು</translation>
<translation id="2947519843530032104">ನಿಮ್ಮ ಖಾತೆ <ph name="ACCOUNT_EMAIL" /> ನಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="7011190694940573312">ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಂನ ಈ ಆವೃತ್ತಿಯನ್ನು ಬೆಂಬಲಿಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="7024536598735240744">ಅನ್‌ಪ್ಯಾಕ್ ದೋಷ: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">ನಿಮ್ಮ ಸ್ವಂತ Phromium ಅನ್ನು ರಚಿಸಿ</translation>
<translation id="7047386856539490735">ಈ ಫಲಿತಾಂಶಗಳು ಉಪಯುಕ್ತವಾಗಿವೆಯೇ?</translation>
<translation id="2448910402556368916">Phromium ಅಪ್‌ಡೇಟ್‌ ಮಾಡಿ</translation>
<translation id="7834049737623892628">ಚಿತ್ರದಲ್ಲಿ ಉಪಯುಕ್ತ ವಿವರಣೆಯು ಇಲ್ಲದಿದ್ದರೆ, Phromium ನಿಮಗಾಗಿ ಒಂದು ವಿವರಣೆಯನ್ನು ಒದಗಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ವಿವರಣೆಗಳನ್ನು ರಚಿಸಲು, ಚಿತ್ರಗಳನ್ನು Google ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="1803168627715642217">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ Phromium ಆ್ಯಪ್ ಅನ್ನು ಬಳಸುವಾಗ AI ನ ಪವರ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="3321731353906178474">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ Phromium ಆ್ಯಪ್‌ ಮೂಲಕ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಟ್ಯಾಬ್‌ಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ನಿಮ್ಮ ಜೊತೆಗೇ ಇರಿಸಿಕೊಳ್ಳಿ</translation>
<translation id="7141270731789036260">Chrome for Testing ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="8077731669779275332">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ Phromium ಅನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="611798798247797100">Phromium ನಿಂದ <ph name="EXTENSION_NAME" /> ಅನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="7962394294883785044">Phromium ಅನ್ನು <ph name="TIMEOUT_DURATION" /> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದರ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.</translation>
<translation id="2611686760870033712">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ Phromium ಗೆ ಕ್ಯಾಮರಾ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="71050417052775020">Phromium ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="4817060241763895497">ನೀವು ಎಲ್ಲಿದ್ದರೂ, Phromium ನಲ್ಲಿ Gemini ಮೂಲಕ ಏನನ್ನಾದರೂ ಕೇಳಿ</translation>
<translation id="869358700049263961">ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ತ್ವರಿತವಾಗಿ ಪಡೆಯಲು Phromium ಅನ್ನು ನಿಮ್ಮ ಡಾಕ್‌ನಲ್ಲಿ ಇರಿಸಿ</translation>
<translation id="7094488679340739251">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ Phromium ಅನ್ನು ಬಳಸಿ</translation>
<translation id="7216228761061470870">ನೀವು ಡೆಸ್ಕ್‌ಟಾಪ್‌ನಲ್ಲಿ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿದಾಗ, PDF ಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪುಟದ ಶೀರ್ಷಿಕೆ, URL ಮತ್ತು ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="7802634650401946711">ಕಾರ್ಯನಿರ್ವಾಹಕ - Phromium</translation>
<translation id="5182547787327636348">ಇತರ ಆ್ಯಪ್‌ಗಳು ಅಥವಾ ಫೈಲ್‌ಗಳಂತಹ Phromium ನ ಹೊರಗಿನ ಕಂಟೆಂಟ್ ಕುರಿತು ಕೇಳಿ</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="5761733252154904648">ತಕ್ಷಣವೇ ಬ್ರೌಸ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಿ: Windows ಪ್ರಾರಂಭವಾದಾಗ Phromium ಈಗ ಪ್ರಾರಂಭಿಸಬಹುದು.</translation>
<translation id="7274695763216404502">ಪಿನ್ ಮಾಡಲಾಗಿದೆ! ಟೂಲ್‌ಬಾರ್‌ನಿಂದ ಮತ್ತೊಮ್ಮೆ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="7288567540154601580">ಟ್ಯಾಬ್‌ಗಳು ಮತ್ತು ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}one{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}other{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}}</translation>
<translation id="1408728332407453335">ಸಿಸ್ಟಂ ಆಡಿಯೊವನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು Phromium ಗಾಗಿ 'ಸಿಸ್ಟಂ ಆಡಿಯೊ ರೆಕಾರ್ಡಿಂಗ್ ಮಾತ್ರ' ಎಂಬುದನ್ನು ಅನುಮತಿಸಿ. ನಂತರ ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="7299899569525778554">ಡೆಸ್ಕ್‌ಟಾಪ್‌ನಿಂದ ಹುಡುಕಿ</translation>
<translation id="6194310460545162015">Phromium ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="1098154893096691883">ನಿಮ್ಮ ಪ್ರಾಶಸ್ತ್ಯಗಳ ಫೈಲ್ ದೋಷಪೂರಿತವಾಗಿದೆ ಅಥವಾ ಅಮಾನ್ಯವಾಗಿದೆ. ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರುಪಡೆದುಕೊಳ್ಳುವಲ್ಲಿ Phromium ವಿಫಲಗೊಂಡಿದೆ.</translation>
<translation id="7324051657739063017">ನೀವು ಬ್ರೌಸ್ ಮಾಡುವಾಗ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು ನೀವು ಸಾಂದರ್ಭಿಕ ಕಾರ್ಯಗಳನ್ನು ಪುನಃ ತೆರೆಯಬಹುದು</translation>
<translation id="7024097830259741656">ನಿಮ್ಮ ವೆಬ್, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತರ Phromium ಸಂಗತಿಗಳು ಇಲ್ಲಿ ಲೈವ್ ಆಗುತ್ತವೆ.</translation>
<translation id="852511575759652041">ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಹೊಂದಿರುವವರು ಮಾತ್ರ ನಿಮ್ಮ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಡೇಟಾವನ್ನು ಓದಬಹುದು. ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು Google ಗೆ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಅದನ್ನು Google ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ. ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನೀವು ಮರೆತರೆ ಅಥವಾ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ಬಯಸಿದರೆ, ನೀವು <ph name="BEGIN_LINK" />ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ Phromium ಡೇಟಾವನ್ನು ಅಳಿಸಬೇಕಾಗುತ್ತದೆ<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505"><ph name="TARGET_URL_HOSTNAME" /> ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಪಡೆಯುವುದಕ್ಕಾಗಿ <ph name="ALTERNATIVE_BROWSER_NAME" /> ಅನ್ನು ತೆರೆಯಲು, ನಿಮ್ಮ ಸಿಸ್ಟಂ ನಿರ್ವಾಹಕರು Phromium ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ್ದಾರೆ.</translation>
<translation id="7352651011704765696">ಯಾವುದೋ ತಪ್ಪು ಸಂಭವಿಸಿದೆ</translation>
<translation id="7198690862684855451">ಭವಿಷ್ಯದ Phromium ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನಿಮಗೆ macOS 13 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಗಳ ಅಗತ್ಯವಿದೆ. ಈ ಕಂಪ್ಯೂಟರ್ macOS 12 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="3224607549103501149">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ಅನ್ನು Phromium ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="73786666777299047">Chrome ವೆಬ್‌ ಸ್ಟೋರ್ ತೆರೆಯಿರಿ</translation>
<translation id="8446269872172461565">Phromium ನಲ್ಲಿ Gemini ಅನ್ನು ಸಿಸ್ಟಮ್ ಟ್ರೇನಲ್ಲಿ ತೋರಿಸಿ</translation>
<translation id="7401687852903179959">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಈ ವೀಡಿಯೊವನ್ನು ಹುಡುಕಿ</translation>
<translation id="3403529853122418035">Phromium ಈಗ ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿದೆ</translation>
<translation id="5649377421626481711">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಸಿ: ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗಲೆಲ್ಲಾ Phromium ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸುತ್ತದೆ. ಇದನ್ನು ಆಫ್ ಮಾಡಲು, ಇಲ್ಲಿಗೆ ಹೋಗಿ</translation>
<translation id="2467776530444676191">Phromium ಗೆ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಇಂಪೋರ್ಟ್ ಮಾಡಿ</translation>
<translation id="8814480293815136510">1. ಕೆಳಗಿನ <ph name="BUTTON_LABEL" /> ಅನ್ನು ಕ್ಲಿಕ್‌ ಮಾಡಿ
2. ನಿಮ್ಮ Windows ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ <ph name="BUTTON_2" /> ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ
3. ತ್ವರಿತ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ Phromium ಅನ್ನು ಪಿನ್ ಮಾಡಲು Windows ನೋಟಿಫಿಕೇಶನ್‌ನಲ್ಲಿ <ph name="BUTTON_3" /> ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - Phromium Dev</translation>
<translation id="7450541714075000668">ಪಠ್ಯವನ್ನು ಕಾಪಿ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="6826407056979820031">ನಿಮ್ಮ ಮೈಕ್ರೊಫೋನ್ ಬಳಸಲು, <ph name="BEGIN_LINK" />ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK" /> Phromium ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
<translation id="1392131731909663319">ಭವಿಷ್ಯದ Phromium ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 7 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="4512427777724578739">Phromium ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆ?</translation>
<translation id="4510527847350985067">ಪ್ರಸ್ತುತ ಚಾಲನೆಯಲ್ಲಿರುವ Phromium ನ ಅದೇ ಆವೃತ್ತಿಯನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ದಯವಿಟ್ಟು Phromium ಅನ್ನು ಮುಚ್ಚಿರಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="7510190804000607802">ನೆನಪಿರಲಿ: Google ನ ಅತ್ಯುತ್ತಮ ಅನುಭವ ಈಗ ನಿಮ್ಮ ಜೇಬಿನಲ್ಲಿದೆ</translation>
<translation id="4735608937705010375">ಸೈಟ್‌ಗಳು ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ. ನೀವು Phromium ಗೆ ಸೈನ್ ಇನ್ ಆಗಿದ್ದರೆ, ಎಲ್ಲಾ Phromium ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚುವುದರಿಂದ ನಿಮ್ಮ Google ಖಾತೆಯನ್ನು ಹೊರತುಪಡಿಸಿ ಹೆಚ್ಚಿನ ಸೈಟ್‌ಗಳಿಂದ ನಿಮ್ಮನ್ನು ಸೈನ್ ಔಟ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="7987051132742764178">{0,plural, =1{1 ನಿಮಿಷದಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ನಿಮಿಷಗಳಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ನಿಮಿಷಗಳಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="1904271152425995672">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ರಕ್ಷಿಸಲು, ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡದ ಸೈಟ್‌ಗಳಿಂದ ಅನುಮತಿಗಳನ್ನು ತೆಗೆದುಹಾಕಲು Phromium ಗೆ ಅವಕಾಶ ನೀಡಿ.</translation>
<translation id="7909976731673595773">ತಕ್ಷಣವೇ ಬ್ರೌಸಿಂಗ್ ಪ್ರಾರಂಭಿಸಲು Phromium ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ಇನ್‌ಸ್ಟಾಲರ್‌‌</translation>
<translation id="3301232962183130807">Phromium ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಮತ್ತು ಮೈಕ್ರೋಫೋನ್ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="3230129417775002227">Phromium ಇದೀಗ ಉತ್ತಮಗೊಂಡಿದೆ</translation>
<translation id="1322165820810533683">ಈಗ ನೀವು Phromium ನಲ್ಲಿ ಇನ್ನಷ್ಟು ಫೀಚರ್‌ಗಳನ್ನು ಹೊಂದಿದ್ದೀರಿ</translation>
<translation id="7624307931717240213">ಈ ಸೇವೆಯನ್ನು ಸುಧಾರಿಸಲು ನಾವು ಮಾಹಿತಿಯನ್ನು ಬಳಸುತ್ತೇವೆ. ಗೌಪ್ಯತೆ ನೀತಿ ಮತ್ತು ಸೇವಾ ನಿಯಮಗಳನ್ನು ನೋಡಿ.</translation>
<translation id="7649070708921625228">ಸಹಾಯ</translation>
<translation id="3795437289339745990">Phromium ಆ್ಯಪ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="7658239707568436148">ರದ್ದುಮಾಡಿ</translation>
<translation id="6671257169702988694">Phromium ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅಲ್ಲ</translation>
<translation id="7270402397025248165">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ Phromium ಅನ್ನು ಸಿಂಕ್ ಮಾಡಿ ಮತ್ತು ವೈಯಕ್ತೀಕರಿಸಿ</translation>
<translation id="6267574654655324634">Phromium ಅಪ್‌ಡೇಟ್</translation>
<translation id="4868190765388740513">Phromium ನಲ್ಲಿ ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸುರಕ್ಷಿತಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="7716950018788545737">ಕಾರ್ಯ(ಗಳು) ಮುಗಿದಿದೆ.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" /> ಗಾಗಿ ಸಿಸ್ಟಮ್‌ ಟ್ರೇಸಿಂಗ್‌ ಸೇವೆಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ. ಈ ಸೇವೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದರೆ, ಬ್ರೌಸರ್‌ನಿಂದ ರಚಿಸಲಾದ ಪರ್ಫಾರ್ಮೆನ್ಸ್‌ ಟ್ರೇಸ್‌ಗಳು ಕಂಟೆಕ್ಸ್‌ಟ್‌ ಸ್ವಿಚ್‌ ಮತ್ತು ಸಿದ್ಧ ಥ್ರೆಡ್ ಈವೆಂಟ್‌ಗಳಂತಹ ಸಿಸ್ಟಮ್-ವೈಡ್‌ ಈವೆಂಟ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರುವುದಿಲ್ಲ.</translation>
<translation id="2680098142787722612">ಈ ಸಾಧನದಿಂದ ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL" /> ನಂತೆ Phromium ಗೆ ಸೈನ್‌ ಇನ್ ಮಾಡಿ.</translation>
<translation id="7747138024166251722">ಇನ್‌ಸ್ಟಾಲರ್‌‌‌ಗೆ ತಾತ್ಕಾಲಿಕ ಡೈರೆಕ್ಟರಿಯನ್ನು ರಚಿಸಲಾಗಲಿಲ್ಲ. ಸಾಫ್ಟ್‌ವೇರ್ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಮುಕ್ತ ಡಿಸ್ಕ್ ಜಾಗ ಮತ್ತು ಅನುಮತಿಗಾಗಿ ದಯವಿಟ್ಟು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="6830826880333833598">ಡೀಫಾಲ್ಟ್ Phromium ಗೆ ರೀಸೆಟ್ ಮಾಡಿ</translation>
<translation id="448710321315554838">Phromium ನಲ್ಲಿ ನಿಮ್ಮ ಕೆಲಸವನ್ನು ಸುರಕ್ಷಿತಗೊಳಿಸುವ ಸಲುವಾಗಿ, ನೀವು Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಕೆಲವು ಮಾಹಿತಿಯನ್ನು ವೀಕ್ಷಿಸಲು ಅಥವಾ ನಿರ್ವಹಿಸಲು ಸಾಧ್ಯವಾಗುತ್ತದೆ.</translation>
<translation id="7045209483723342691">Phromium ಅನ್ನು ಡೀಫಾಲ್ಟ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ ಮತ್ತು ಅದನ್ನು ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="6452735947982563207">Phromium ಅನ್ನು ವೇಗಗೊಳಿಸಿ</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - Phromium Canary</translation>
<translation id="6929858452581400763">ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಟ್ರಾಫಿಕ್‌ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಹೊಂದಿರುವ ಜನರಿಗೆ ನೀವು ಯಾವ ಸೈಟ್‌ಗಳಿಗೆ ಭೇಟಿ ನೀಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ನೋಡಲು ಕಷ್ಟವಾಗುವಂತೆ ಮಾಡಿ. DNS (ಡೊಮೇನ್ ಹೆಸರು ಸಿಸ್ಟಮ್) ನಲ್ಲಿ ಸೈಟ್‌ನ IP ವಿಳಾಸವೊಂದನ್ನು ಹುಡುಕಲು Phromium ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಒಂದನ್ನು ಬಳಸುತ್ತದೆ.</translation>
<translation id="7810005234485217901">ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಪಿನ್ ಮಾಡಬಹುದು</translation>
<translation id="4343392731007327660">Phromium ಜೊತೆ ಏನನ್ನು ಹಂಚಿಕೊಳ್ಳಬೇಕು ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="3052274192923256457">ಈ ಸಾಧನದಲ್ಲಿ ಈ ಖಾತೆಯೊಂದಿಗಿನ Phromium ಪ್ರೊಫೈಲ್ ಈಗಾಗಲೇ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ</translation>
<translation id="7845233973568007926">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME" /> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನೀವು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="5674414381037997114">ನಿಮ್ಮ ಸರ್ಚ್ ಎಂಜಿನ್ ಅನ್ನು Phromium ನ ಹೊರಗಿನಿಂದ ಬದಲಾಯಿಸಲಾಗಿದೆ. ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸಲು, Phromium ಅದನ್ನು ಅದರ ಮೂಲ ಡೀಫಾಲ್ಟ್‌ಗೆ ರೀಸೆಟ್ ಮಾಡಿದೆ. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Phromium ಗೆ ಹೊಸ ಲುಕ್ ನೀಡಲು ಅದನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="3966946337517395351">ನೀವು ವಿಳಾಸ ಪಟ್ಟಿ ಅಥವಾ ಹುಡುಕಾಟ ಪೆಟ್ಟಿಗೆಯಲ್ಲಿ ಟೈಪ್ ಮಾಡಿದಾಗ, ಉತ್ತಮ ಸಲಹೆಗಳನ್ನು ಪಡೆಯಲು Phromium ನೀವು ಟೈಪ್ ಮಾಡಿದ್ದನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಸರ್ಚ್ ಎಂಜಿನ್‌ಗೆ ಕಳುಹಿಸುತ್ತದೆ. ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿ ಇದು ಆಫ್ ಆಗಿರುತ್ತದೆ.</translation>
<translation id="3928367799779122681">Phromium ಗೆ ಇತ್ತೀಚಿನ ಆವೃತ್ತಿಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಈ ಮೂಲಕ ನೀವು ಹೊಸ ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಭದ್ರತೆ ಸರಿಪಡಿಸುವಿಕೆಗಳನ್ನು ಕಳೆದುಕೊಳ್ಳುತ್ತಿರಬಹುದು.</translation>
<translation id="7872446069773932638">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="SECONDS" /> ಸೆಕೆಂಡ್(ಗಳು) ಬಾಕಿ ಉಳಿದಿವೆ.</translation>
<translation id="8492102592995742850">ನೀವು ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ಮರೆತಿದ್ದರೆ ಅಥವಾ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ಬಯಸಿದರೆ, <ph name="BEGIN_LINK" />ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ Phromium ಡೇಟಾವನ್ನು ಅಳಿಸಿ<ph name="END_LINK" /></translation>
<translation id="959404544431817539">ನಿಮಗೆ ಅಗತ್ಯವಿರುವಾಗ Phromium ನಲ್ಲಿ Gemini ಅನ್ನು ತ್ವರಿತವಾಗಿ ತೆರೆಯಿರಿ</translation>
<translation id="8889749279816358185">Phromium ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="3173775358556080672">ಸಾಧ್ಯವಾದಾಗ, Phromium ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್‌ಗಳನ್ನು HTTPS ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡುತ್ತದೆ</translation>
<translation id="2210801904933897209"><ph name="USER_EMAIL_ADDRESS" /> ನಂತೆ Phromium ಅನ್ನು ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿರುವಿರಿ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಅದೇ ಖಾತೆಯನ್ನು ಬಳಸಿ.</translation>
<translation id="7291855477503010638"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="5706099517903615644">ಇದು Phromium ನ ದ್ವಿತೀಯ ಸ್ಥಾಪನೆಯಾಗಿದೆ ಮತ್ತು ಅದನ್ನು ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಲಾಗುವುದಿಲ್ಲ.</translation>
<translation id="2388440031754359882">ಅಜ್ಞಾತ ಮೂಲಗಳಿಂದ ಎಕ್ಸ್‌ಟೆನ್ಷನ್‌‌ಗಳು, ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಥೀಮ್‌ಗಳು ನಿಮ್ಮ ಸಾಧನಕ್ಕೆ ಹಾನಿಯುಂಟು ಮಾಡಬಹುದು. <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ನಿಂದ ಮಾತ್ರ ಅವುಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ</translation>
<translation id="8205108509545565485">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ Phromium ಆ್ಯಪ್ ಬಳಸುವ ಮೂಲಕ Google ನ ಅತ್ಯುತ್ತಮ ಅನುಭವವನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="8004582292198964060">ಬ್ರೌಸರ್</translation>
<translation id="8010081455002666927">ಸ್ವಯಂ ಪತ್ತೆಮಾಡುವಿಕೆ</translation>
<translation id="6421861275173778152">Phromium ಒಮ್ಮೆ ಪ್ರವೇಶವನ್ನು ಪಡೆದ ಬಳಿಕ, ಪ್ರವೇಶಕ್ಕಾಗಿ ನಿಮ್ಮನ್ನು ಕೇಳಲು ವೆಬ್‍ಸೈಟ್‍ಗಳಿಗೆ ಸಾಧ್ಯವಾಗುತ್ತದೆ.</translation>
<translation id="942087293138739513">ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ತ್ವರಿತವಾಗಿ ಪಡೆಯಲು Phromium ಅನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="80471789339884597">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME" /> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನಿಮ್ಮ ಎಲ್ಲಾ ಬ್ರೌಸರ್ ಅನ್ನು ಮರು ಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="8054112667659782652">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಯಾವಾಗಲೂ ತೋರಿಸಿ</translation>
<translation id="8069447462453318634">"ಟೂಲ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ" ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8519423983825025511">ಆ್ಯಪ್‌ಗಳಿಗೆ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗುತ್ತಿರುವ Phromium ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="80790299200510644">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ</translation>
<translation id="8086881907087796310">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಕನಿಷ್ಠ ಹಾರ್ಡ್‌ವೇರ್ ಅಗತ್ಯತೆಗಳನ್ನು ಪೂರೈಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="7988414336652558428">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ Phromium ಗೆ ಸ್ಥಳ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="1778610353097215460">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ ನೀವು Phromium ಅನ್ನು ತೆರೆದಾಗ, ದರ ಟ್ರ್ಯಾಕಿಂಗ್ ಅಲರ್ಟ್‌ಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="4182143801062869250">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ Phromium ಆ್ಯಪ್ ಮೂಲಕ ನಿಮಗೆ ಆಸಕ್ತಿಯಿರುವ ಐಟಂಗಳ ಬೆಲೆ ಇಳಿಕೆಯ ಅಲರ್ಟ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="8118331347066725040">Lens ಬಳಸಿಕೊಂಡು ಹುಡುಕಲು ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ</translation>
<translation id="849080025203861031">Phromium ಅನ್ನು ನಿಮ್ಮದಾಗಿಸಿ</translation>
<translation id="8133124826068723441">ನಿಮ್ಮ ಡೊಮೇನ್‌ನಲ್ಲಿ ಸಿಂಕ್ ಮಾಡುವ ಸೌಲಭ್ಯವಿಲ್ಲದ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromiumOS ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ.</translation>
<translation id="813913629614996137">ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="139377652856781272">ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಮೂಲಕ Phromium ನಲ್ಲಿ Gemini ಅನ್ನು ತೆರೆಯಿರಿ.</translation>
<translation id="8577594891153686998">Phromium ಹೆಚ್ಚುವರಿ ಸೇವಾ ನಿಯಮಗಳು</translation>
<translation id="6418547610462348357">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿದೆ, ಹೀಗಾಗಿ Phromium ಇದನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ.</translation>
<translation id="8177472873527554730">ಪುಟದಲ್ಲಿ ಕಂಟೆಂಟ್‌ ಅನ್ನು ಹುಡುಕಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="6257816439683677727">ನಿಮ್ಮ ಖಾತೆ <ph name="USER_EMAIL" /> ನಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="820759916613250543">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಈ ಚಿತ್ರವನ್ನು ಹುಡುಕಿ</translation>
<translation id="8221491193165283816">ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ಅಧಿಸೂಚನೆಗಳನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತೀರಿ. ನಿಮಗೆ ಸೂಚನೆ ನೀಡಲು ಈ ಸೈಟ್‌ಗೆ ಅನುಮತಿಸುವುದಕ್ಕಾಗಿ, ಇಲ್ಲಿ ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="8672013454464753607">ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಬಳಸಲು, <ph name="BEGIN_LINK" />ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK" /> Phromium ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
<translation id="8006746139865532235">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ ಎಂಬುದನ್ನು ದೃಢೀಕರಿಸಲು Phromium ಗೆ ಸಾಧ್ಯವಿಲ್ಲ ಮತ್ತು ಇದು ಅಸುರಕ್ಷಿತವಾಗಿರಬಹುದು. Phromium ನಿಂದ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="5474258904581730105">ಚಿತ್ರದಲ್ಲಿ ಉಪಯುಕ್ತ ವಿವರಣೆಯು ಇಲ್ಲದಿದ್ದರೆ, Phromium ನಿಮಗಾಗಿ ಒಂದು ವಿವರಣೆಯನ್ನು ಒದಗಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ವಿವರಣೆಗಳನ್ನು ರಚಿಸಲು, ಚಿತ್ರಗಳನ್ನು Google ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ಇದನ್ನು ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಆಫ್ ಮಾಡಬಹುದು.</translation>
<translation id="5375524124600974413">ಹೊಸ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ Phromium ಗೆ ಸೈನ್‌ ಇನ್‌ ಮಾಡಬೇಕೆ?</translation>
<translation id="5242991719841602450"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Phromium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು <ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ಪಡೆಯುತ್ತೀರಿ.</translation>
<translation id="6524280192518819368">Phromium ನಲ್ಲಿ Gemini ಅನ್ನು ಸಿಸ್ಟಮ್ ಟ್ರೇನಲ್ಲಿ ತೋರಿಸಿ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="2082268001133511745">ಸುರಕ್ಷಿತವಲ್ಲದ ಸೈಟ್‌ಗಳು ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳ ಕುರಿತು <ph name="BEGIN_LINK" />Phromium ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ<ph name="END_LINK" /></translation>
<translation id="4030955203048827163">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION" /> ಅನ್ನು Phromium ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="8358344509940735943">Phromium iOS ಆ್ಯಪ್ ಮೂಲಕ, ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಬಳಸಿಕೊಂಡು ನಿಮ್ಮ ಕಣ್ಣಿಗೆ ಬೀಳುವ ವಸ್ತುಗಳನ್ನು ಶಾಪಿಂಗ್ ಮಾಡಿ, ಪಠ್ಯಗಳನ್ನು ಅನುವಾದಿಸಿ ಹಾಗೂ ಸುತ್ತಮುತ್ತಲಿನ ವಿಷಯಗಳನ್ನು ಗುರುತಿಸಿ</translation>
<translation id="7062802333437169650"><ph name="USER_NAME" /> ಆಗಿ Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು QR ಕೋಡ್</translation>
<translation id="8313851650939857356">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062">Phromium ಅನ್ನು <ph name="TIMEOUT_DURATION" /> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದನ್ನು ಮುಚ್ಚುತ್ತದೆ.</translation>
<translation id="8321888067342493336">ಚಿತ್ರದ ರೂಪದಲ್ಲಿ ಸೇವ್ ಮಾಡಿ</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" /> ಅವರು ಮೊದಲಿನಿಂದಲೆ Phromium ಬಳಸುತ್ತಿದ್ದರು</translation>
<translation id="5445795756751365814">Phromium ನಲ್ಲಿ ಕೌಶಲ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="7329745364783464770">ನಿಮ್ಮ Google ಖಾತೆ <ph name="ACCOUNT_EMAIL" /> ನಲ್ಲಿ Phromium ಡೇಟಾ ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಲು Phromium ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ</translation>
<translation id="5255856786869089460">ಭವಿಷ್ಯದ Phromium ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 8 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="8362914115861174987">ಈ ಭಾಷೆಗೆ ಅನುವಾದಿಸಿ</translation>
<translation id="8367705492654390392">ಏನನ್ನಾದರೂ ಕೇಳಿ</translation>
<translation id="8370517070665726704">ಕೃತಿಸ್ವಾಮ್ಯ <ph name="YEAR" /> Google LLC. ಎಲ್ಲ ಹಕ್ಕುಗಳನ್ನು ಕಾಯ್ದಿರಿಸಲಾಗಿದೆ.</translation>
<translation id="7349410893766975486">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಉಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="394196307309768356">ನಂತರ ನೀವು Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="7466825726005300631">ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Phromium ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK" />ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK" /></translation>
<translation id="264088846642173954">ಈ ವಿಸ್ತರಣೆಯನ್ನು ಅದರ ಡೆವಲಪರ್‌ನಿಂದ ಪ್ರಕಟಣೆಯನ್ನು ರದ್ದುಮಾಡಿದೆ ಮತ್ತು ಸುರಕ್ಷಿತ ಆಗಿಲ್ಲದಿರಬಹುದು. Phromium ನಿಂದ ವಿಸ್ತರಣೆಯನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="1867604241588004166">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು Phromium ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="926481158288852551">{0,plural, =1{ಒಂದು ದಿನದ ಒಳಗೆ Phromium ಮರುಪ್ರಾರಂಭಿಸಿ}one{# ದಿನಗಳ ಒಳಗೆ Phromium ಮರುಪ್ರಾರಂಭಿಸಿ}other{# ದಿನಗಳ ಒಳಗೆ Phromium ಮರುಪ್ರಾರಂಭಿಸಿ}}</translation>
<translation id="8438543370129609977">ನೀವು ಇಮೇಜ್‌ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿದಾಗ, PDF ಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪುಟದ ಶೀರ್ಷಿಕೆ, URL ಮತ್ತು ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.<ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">Phromium ನಲ್ಲಿ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟದ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="1069576136282928177">ಸ್ಥಾಪಕ ಆರ್ಕೈವ್ ದೋಷಪೂರಿತವಾಗಿದೆ ಅಥವಾ ಅಮಾನ್ಯವಾಗಿದೆ. ದಯವಿಟ್ಟು Phromium ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="7082388216101480391">Phromium ಗೆ Windows 10 ಅಥವಾ ಹೆಚ್ಚಿನ ಆವೃತ್ತಿಯ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="8463672209299734063">ಐಚ್ಛಿಕ: ಡಯಗ್ನೊಸ್ಟಿಕ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾವನ್ನು Google ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಳುಹಿಸುವ ಮೂಲಕ ChromiumOS ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಿ.</translation>
<translation id="4343027289807602417">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಸೇವ್‌ ಮಾಡಲು, ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸಿ</translation>
<translation id="6746404578800969443">Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಪ್ರಾಂಪ್ಟ್ ಅನ್ನು ತೋರಿಸುತ್ತದೆ</translation>
<translation id="5072642661707587697">Phromium ನ ಅವಧಿ ಮುಗಿದಿದೆ</translation>
<translation id="759684005114911774">Phromium ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಆಯ್ಕೆ ಮಾಡಿದ್ದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು!</translation>
<translation id="5209258538041302334">ನೀವು ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಿದಾಗ, Phromium ಅವುಗಳನ್ನು ಪರಿಶೀಲಿಸಬಹುದು</translation>
<translation id="8525579356836940628">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ನಿಲ್ಲಿಸಲಾಗಿದೆ</translation>
<translation id="6348113608284833604">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ Phromium ಆ್ಯಪ್ ಬಳಸುವ ಮೂಲಕ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಟ್ಯಾಬ್‌ಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ನಿಮ್ಮ ಜೊತೆಗೆ ಇರಿಸಿಕೊಳ್ಳಿ</translation>
<translation id="5083347044281842800">ಸಾರ್ವಜನಿಕ ಡೇಟಾ ಉಲ್ಲಂಘನೆಯಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳಲ್ಲಿ ಒಂದು Phromium ಗೆ ಕಂಡುಬಂದರೆ ಎಚ್ಚರಿಕೆ ಪಡೆಯಿರಿ</translation>
<translation id="8555465886620020932">ಸೇವಾ ದೋಷ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">ಕೆಲವು Phromium ಫೀಚರ್‌ಗಳು ಮತ್ತು ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಶಾರ್ಟ್‌ಕಟ್‌ಗಳೊಂದಿಗೆ ಬರುತ್ತವೆ. ನೀವು ಅವುಗಳನ್ನು ಮರಳಿ ಆನ್ ಮಾಡಲು ಆಯ್ಕೆ ಮಾಡಬಹುದು.</translation>
<translation id="8556420416730706394">ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಪಿನ್ ಮಾಡಬಹುದು; ಸೈಡ್ ಪ್ಯಾನಲ್‌ನ ಮೇಲ್ಭಾಗದಲ್ಲಿರುವ ಪಿನ್ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="856656450041460113">ಭಾಷೆಯ ಪಟ್ಟಿಯನ್ನು ಹುಡುಕಿ</translation>
<translation id="9159785833243360958">ಬಹು ಸಂಸ್ಥೆಗಳು Phromium ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತವೆ</translation>
<translation id="8586442755830160949">ಹಕ್ಕುಸ್ವಾಮ್ಯ <ph name="YEAR" /> Chromium ಲೇಖಕರು. ಎಲ್ಲಾ ಹಕ್ಕುಗಳನ್ನು ಕಾಯ್ದಿರಿಸಲಾಗಿದೆ.</translation>
<translation id="3489957831482527036">Phromium ಅನ್ನು ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="8624541899164515475">ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ.</translation>
<translation id="8648201657708811153">Google Chrome for Testing ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="7150069986792019616">ಎಲ್ಲಿಂದಲಾದರೂ Phromium ಮೂಲಕ ಹುಡುಕಿ</translation>
<translation id="1623850835554120265">ನೀವು Phromium ಪ್ರಾರಂಭಿಸಿದಾಗ ಅಥವಾ ಓಮ್ನಿಬಾಕ್ಸ್‌ನಿಂದ ಹುಡುಕಿದಾಗ ತೋರಿಸಬೇಕಾದ ಪುಟವನ್ನು ಕೂಡಾ ಇದು ನಿಯಂತ್ರಿಸುತ್ತದೆ.</translation>
<translation id="8828478112210313529">ಈ ಟ್ಯಾಬ್ ಅನ್ನು ಬೇರೊಂದು ಸಾಧನಕ್ಕೆ ಕಳುಹಿಸಲು, ಅಲ್ಲಿ Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3592747099485557650">ಇದು ನಿಮ್ಮ Phromium</translation>
<translation id="8712637175834984815">ಅರ್ಥವಾಯಿತು</translation>
<translation id="3388228047978619624">Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="8747073452963259673">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಕೆಳಗಿನ ಎಡ ಮೂಲೆ: ಎಡಕ್ಕೆ <ph name="LEFT" />%, ಕೆಳಕ್ಕೆ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ನಿರ್ವಾಹಕರು ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ತಡೆಯುವ ಗುಂಪು ನೀತಿಯನ್ನು ಅನ್ವಯಿಸಿದ್ದಾರೆ: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">ನಂತರ ನನಗೆ ಜ್ಞಾಪಿಸಿ</translation>
<translation id="614494151403742465">ತ್ವರಿತ ಅವಲೋಕನವನ್ನು ಪಡೆಯಲು ಮತ್ತು ಫಾಲೋ ಅಪ್ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಲು Phromium ನಲ್ಲಿ Gemini ಜೊತೆಗೆ ಈ ಡಾಕ್ಯುಮೆಂಟ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="6346068443590018348">Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="1468806565762231794">Phromium ಅನ್ನು ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಿ ಮತ್ತು ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="8826492472752484139">“Password Manager” ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="8833697763442816810">ChromiumOS ಸಿಸ್ಟಂ</translation>
<translation id="4854784568701005121">Phromium ನಲ್ಲಿ ಮೆನುಗಳು, ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಎಚ್ಚರಿಕೆಗಳು ಮತ್ತು ಇತರ ಪಠ್ಯವನ್ನು ಪ್ರದರ್ಶಿಸಲು ಈ ಭಾಷೆಯನ್ನು ಬಳಸಲಾಗುತ್ತದೆ</translation>
<translation id="8862326446509486874">ಸಿಸ್ಟಂ ಮಟ್ಟದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನೀವು ಸರಿಯಾದ ಹಕ್ಕುಗಳನ್ನು ಹೊಂದಿಲ್ಲ. ನಿರ್ವಾಹಕರಂತೆ ಮತ್ತೆ ಇನ್‌ಸ್ಟಾಲರ್ ಅನ್ನು ರನ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="7804139416589625033">Phromium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="6333867241557949259">ಸೈನ್ ಇನ್ ಮಾಡುವಾಗ ದೋಷವಿರುವ ಕಾರಣ ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ChromiumOS ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="2888440364511152939">ನೀವು Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡುವುದು ನಿಮ್ಮ ಸಂಸ್ಥೆಗೆ ಅಗತ್ಯವಿದೆ</translation>
<translation id="7111325571010992010">Phromium ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪ್ರದರ್ಶಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="4406716425954955281">Phromium ಇನ್ನು ಮುಂದೆ ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿರುವುದಿಲ್ಲ. Phromium ಅನ್ನು ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="2999847959360823770">Phromium ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="8944232836376404813">ಈ ಕ್ರಿಯೆಯು:
          <ph name="LINE_BREAKS" />
            • ನಿಮ್ಮ ಆರಂಭಿಕ ಪುಟ, ಹೊಸ ಟ್ಯಾಬ್ ಪುಟ, ಸರ್ಚ್ ಎಂಜಿನ್ ಮತ್ತು ಪಿನ್ ಮಾಡಲಾದ ಟ್ಯಾಬ್‌ಗಳನ್ನು ರೀಸೆಟ್ ಮಾಡುತ್ತದೆ
            <ph name="LINE_BREAK" />
            • ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAK" />
            • ಕುಕೀಗಳು ಮತ್ತು ಇತರ ತಾತ್ಕಾಲಿಕ ಸೈಟ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAKS" />
            ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಸೇವ್ ಮಾಡಿದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳ ಮೇಲೆ ಇದು ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ.</translation>
<translation id="7461167469691640632">Phromium ಸೈಟ್ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ತೋರಿಸಿ</translation>
<translation id="7394133813796947510">Phromium Enterprise ಲೋಗೋ</translation>
<translation id="2476839923452631964">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ Phromium ಆ್ಯಪ್ ಬಳಸುವ ಮೂಲಕ Google ನ ಸುರಕ್ಷತೆಯನ್ನು ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ನಿಮ್ಮ ಜೊತೆಗೆ ಇರಿಸಿಕೊಳ್ಳಿ</translation>
<translation id="2041306781031361744">ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಅನ್ನು ತೆರೆಯುವಾಗ ಏನೋ ತಪ್ಪಾಗಿರುವ ಕಾರಣ Phromium ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. Phromium ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8355079108092011401">Phromium ಮೂಲಕ ಹುಡುಕಲು ಅಥವಾ <ph name="BEGIN_LINK" />ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK" /> ಕಸ್ಟಮೈಸ್ ಮಾಡಲು</translation>
<translation id="820370893610994443">Phromium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="1885039203623228439">Phromium ನಲ್ಲಿ Gemini ಮತ್ತು ನಿಮ್ಮ ತೆರೆದ ಟ್ಯಾಬ್ ನಡುವೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು ನಿಮ್ಮ ಕೀಬೋರ್ಡ್ ಬಳಸಿ.</translation>
<translation id="9018218886431812662">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಿಕೆಯು ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="8213523024005590363">Phromium ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಲು, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ನಲ್ಲಿ ಪಟ್ಟಿ ಮಾಡದಿರುವ ಕೆಳಗಿನ ವಿಸ್ತರಣೆಯನ್ನು ನಾವು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದ್ದೇವೆ ಮತ್ತು ಇದು ನಿಮ್ಮ ಗಮನಕ್ಕೆ ಬಾರದೇ ಸೇರಿಸಲಾಗಿರಬಹುದು.</translation>
<translation id="1376667286722804744">Phromium ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="5142314855184111999">Mac ಮೆನು ಬಾರ್‌ನಲ್ಲಿ Phromium ಮೂಲಕ ಹುಡುಕಿ ಅನ್ನು ತೋರಿಸಿ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="5166485487967090892">Phromium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಏಕೆಂದರೆ ಆರ್ಕೈವ್ ಫೈಲ್ ಮಾಲ್‌ವೇರ್ ಅನ್ನು ಮರೆಮಾಡಬಹುದಾದ ಇತರ ಫೈಲ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿದೆ</translation>
<translation id="1902493242619542969">ಸಾಧನಗಳಾದ್ಯಂತ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತಿಹಾಸವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಿಂಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅನ್ನು Phromium ಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡುವ ಮೂಲಕ ನಿಮಗೆ ತಿಳಿದಿರುವ ಮತ್ತು ಇಷ್ಟಪಡುವ ಫೀಚರ್‌ಗಳನ್ನು ಸುಲಭವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಿ. ತ್ವರಿತವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡುವುದಕ್ಕಾಗಿ Phromium ಅನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="7092992855996941035">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Phromium ಆ್ಯಪ್‌ನ ಮೂಲಕ Google ನ ಅತ್ಯುತ್ತಮ AI ಟೂಲ್‌ಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="4203475068093609811"><ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="7699507532215026981">ನೀವು ಇತರ Google ಸೇವೆಗಳಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ Phromium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="5571207595456818809">Phromium ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚಲಾಗಿದೆ</translation>
<translation id="3670200098293484473">Phromium ನ ಅವಧಿ ಮುಗಿದಿದೆ</translation>
<translation id="5636382052119887392">{0,plural, =1{ಒಂದು ಗಂಟೆಯಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ಗಂಟೆಗಳಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ಗಂಟೆಗಳಲ್ಲಿ Phromium ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="9106236359747881194">ಹುಡುಕಲು ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="9197093250229894135">ಭವಿಷ್ಯದ Phromium ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 8.1 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="7195134700293253698">ಹೊಸ Phromium &amp;ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="911206726377975832">ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಸಹ ಅಳಿಸುವುದೇ?</translation>
<translation id="9134482777260927479">ಹೋಮ್‌ವರ್ಕ್ ಸಹಾಯ</translation>
<translation id="9148058034647219655">ನಿರ್ಗಮಿಸಿ</translation>
<translation id="8888942844777295083">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಸಿ: ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗಲೆಲ್ಲಾ Phromium ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಬಹುದು. ಇದನ್ನು ಆನ್ ಮಾಡಲು, ಇಲ್ಲಿಗೆ ಹೋಗಿ</translation>
<translation id="1485079858205975514"><ph name="TARGET_URL_HOSTNAME" /> ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ಒಂದು ಪರ್ಯಾಯ ಬ್ರೌಸರ್ ತೆರೆಯುವಂತೆ ನಿಮ್ಮ ಸಿಸ್ಟಂ ನಿರ್ವಾಹಕರು Phromium ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ್ದಾರೆ.</translation>
<translation id="1096075777207775410">&amp;Phromium ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">ನಿಮ್ಮ ಸ್ವಂತ Phromium ಅನ್ನು ರಚಿಸಿ</translation>
<translation id="6554170182570636227">Windows XP ಅಥವಾ Windows Vista ದಲ್ಲಿ Phromium ಗೆ ಈಗ ಬೆಂಬಲವಿಲ್ಲದೇ ಇರುವುದರಿಂದ ಅದು ಸರಿಯಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು</translation>
<translation id="8145475184469284022">Phromium ಮೂಲಕ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ Google ನ ಅತ್ಯುತ್ತಮ ಸುರಕ್ಷತಾ ಫೀಚರ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ.</translation>
<translation id="945522503751344254">ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ</translation>
<translation id="1258071069834143371">Phromium ಅನ್ನು ಯಾರು ಬಳಸುತ್ತಿದ್ದಾರೆ?</translation>
<translation id="8272911737374467274">Phromium ನ ಪ್ರಬಲ ಭದ್ರತೆಯನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="983803489796659991">ಅಪ್‌ಡೇಟ್ ಸರ್ವರ್, ಅಪ್ಲಿಕೇಶನ್‌ಗಾಗಿ ಯಾವುದೇ ಹ್ಯಾಶ್ ಡೇಟಾವನ್ನು ಹೊಂದಿಲ್ಲದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="4087190600867587768">Phromium ಅನ್ನು ಖಾತೆಯಿಲ್ಲದೆಯೇ ಬಳಸಿ</translation>
<translation id="985602178874221306">Chromium ಲೇಖಕರು</translation>
<translation id="989970834842471429">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಹುಡುಕಲು ಯಾವುದೇ ಪಠ್ಯ ಅಥವಾ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆ ಮಾಡಿ</translation>
<translation id="6649431194696226496">ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಬಳಸಲು, <ph name="BEGIN_LINK" />ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK" /> Phromium ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
</translationbundle>