<translation id="5809516625706423866">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. HTTP 401 ಅನಧಿಕೃತವಾಗಿದೆ. ನಿಮ್ಮ ಪ್ರಾಕ್ಸಿ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="3059302031765226748">Phromium ನ V8 ಇಂಜಿನ್‌ ಮೂಲಕ ಸೈಟ್‌ಗಳನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ, ಆದರೆ Phromium ದಾಳಿಗಳ ವಿರುದ್ದ ಸ್ವಲ್ಪ ಕಡಿಮೆ ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ. ಈ ಸೆಟ್ಟಿಂಗ್ ಆಫ್ ಆಗಿದೆ.</translation>
<translation id="4904710047654714935">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ Phromium ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಸೇವ್‌ ಮಾಡಲು, Phromium ಅನ್ನು ಅಪ್‌ಡೇಟ್‌ ಮಾಡಿ</translation>
<translation id="5824893331272123205">ಈ ಪ್ಯಾನೆಲ್ ಅನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಪುನಃ ಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="2582896742857095190">Phromium ಗೆ ಸುಸ್ವಾಗತ</translation>
<translation id="5004643502851105876">Phromium ನ ಪ್ರಬಲ ರಕ್ಷಣೆಗಳನ್ನು ಒದಗಿಸಲು ಹೆಚ್ಚುವರಿ ಫೀಚರ್‌ಗಳನ್ನು ಆನ್ ಮಾಡುತ್ತದೆ</translation>
<translation id="5871205389137001634">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನಿಂದ ನಿರ್ಗಮಿಸಲು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
