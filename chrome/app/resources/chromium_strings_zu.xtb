<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="1029669172902658969">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromiumOS</translation>
<translation id="7962340570690354348">I-Phromium incoma ukuthi ubuyekeze lesi sandiso</translation>
<translation id="2702007788032964762">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-Phromium isebenzisa amaseva e-Google. Lokhu kufihla ubuwena kusayithi elayishwe ngaphambilini, kodwa i-Google ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="1051793555070215510">Sisize sithuthukise i-Incognito ngokuthatha le nhlolovo yomzuzu o-1.</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="4964836565882496625">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-Phromium</translation>
<translation id="8409497136174302488">IChromium idinga ukufinyelela kunethiwekhi yakho yendawo ukuze ithole futhi isebenzise amadivayisi aseduze</translation>
<translation id="4388904545107211948">Ukuze useshe isakhi noma isandiso esithile seChromium, thayipha isinqamuleli sayo kubha yekheli, kulandelwe ukhiye wakho wekhibhodi okhethiwe</translation>
<translation id="7188624550427159072">Bonisa ukusesha ngeChromium kugqoko lwesistimu bese uvula isinqamuleli sekhibhodi</translation>
<translation id="3689248207461565136">I-Phromium ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="112640046208448578">Thola izinto noma izindawo bese ukopisha noma uhumusha umbhalo. Lapho usebenzisa Usesho Lomfanekiso, isithombe-sikrini sekhasi sithunyelwa eseveni. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">I-Phromium iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="5414044255592121327">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Chofoza imenyu ye-Phromium</translation>
<translation id="1157985233335035034">Izilimi zakamuva</translation>
<translation id="1184145431117212167">Ukufaka kwehlulekile ngoba uhlobo lweWindows yakho alusekelwa.</translation>
<translation id="7861581212703831457">Mayelana ne-Phromium</translation>
<translation id="8752630985505435738">Thola izexwayiso zokulandelela intengo nge-Phromium efonini yakho</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME" />.</translation>
<translation id="4933432676089063712">I-<ph name="IMPORTANT_UPDATE" /> isalungiswa. Ukuze ugcine ukubhrawuza kwakho kuphephile, iChromium izobuyekeza ngokuzayo uma ungasebenzi ngo-<ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">Uma uvula Usesho Lomfanekiso, isihloko sekhasi, i-URL, nekhontenti, okuhlanganisa ama-PDF, kuzothunyelwa ngokuzenzekelayo kuseva. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ngeGoogle Account yakho kuChromium. Ukuze ushintshe lokhu, iya kokuthi “I-akhawunti yakho kuChromium”.</translation>
<translation id="7402478829083317456">Bonisa iGemini kuChromium kubha yemenyu yeMac</translation>
<translation id="4902531791098430822">Ukuze ukhethe ingxenye yesikrini kuGemini kuChromium, sebenzisa isinqamuleli sekhibhodi.</translation>
<translation id="9002284132405311162">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-Phromium ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="5561666811965903444">I-Phromium ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="1340271056805240721">Uma ungena ngemvume kumasevisi eGoogle efana neGmail noma iYouTube nge-<ph name="USER_EMAIL" />, ungangena ngemvume ngokuzenzakalela kuChromium nge-akhawunti efanayo</translation>
<translation id="5048805453292757697">Thola iChromium efonini yakho</translation>
<translation id="1290883685122687410">Iphutha lesethaphu: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">Setha iphrofayela yakho entsha ye-Phromium</translation>
<translation id="7871721155662336863">Zama ngeGemini kuChromium</translation>
<translation id="6569288432960798043">I-Phromium idinga ukufinyelela i-Bluetooth ukuze ihlole amadivayisi we-Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">Ngena ngemvume kuChromium efonini yakho</translation>
<translation id="1330562121671411446">Thola ulimi</translation>
<translation id="1619655755195586133">Futhi sula idatha ku-Phromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Kuphiniwe! Ungafinyelela futhi Usesho Lomfanekiso ngenkinobho entsha kubha yamathuluzi</translation>
<translation id="1383876407941801731">Sesha</translation>
<translation id="2947996037737257951">Sebenzisa i-app yeChromium ukuze uqhubeke nokubhrawuza usendleleni</translation>
<translation id="141901961143729572">Yabelana ngemicabango yakho</translation>
<translation id="8355386219605656974">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweChromium Kumasethingi Ohlelo.</translation>
<translation id="1478370723027452770">Thola usizo nge-Chrome Yokuhlola</translation>
<translation id="8398257182826094665">Ukuze uthole imininingwane yakho egciniwe nokukuma<ph name="DEVICE" />, ngena ngemvume kuChromium</translation>
<translation id="1497802159252041924">Iphutha lokufaka <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Leli khasi livikelwe</translation>
<translation id="3484755999946650557">Yabelana ngethebhu ye-Phromium</translation>
<translation id="3309377459597801353">Ngena ngemvume kuChromium</translation>
<translation id="1547469039832541117">Ivala umsebenzi ogqanyisiwe.</translation>
<translation id="2354363290397602683">Phina iChromium</translation>
<translation id="2244728813494358888">Amathuluzi okuphepha e-Phromium</translation>
<translation id="707582364915018531">IChromium ifuna ukusula idatha Yesiphathi sakho Sephasiwedi. Thayipha iphasiwedi yakho yeWindows ukuze uvumele lokhu.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-Phromium ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-Phromium ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-Phromium ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-Phromium ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="5032531544901236587">Thola okuhamba phambili kweGoogle nge-app yeChromium efonini yakho</translation>
<translation id="7311082384439462587">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-Phromium</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="1665602916345474427">Ungene ngemvume njengo-<ph name="USER_NAME" />, <ph name="USER_EMAIL" />, ubulungu. Vula imenyu ye-akhawunti</translation>
<translation id="4535436467771816034">Ungasebenzisa iChromium noma nini lapho uchofoza amalinki emiyalezweni, kumadokhumenti, nakwamanye ama-app Izobuye iphinwe ku-taskbar yakho.</translation>
<translation id="1709772298389099340">Inikeza amalungelo aphakeme e-<ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Lokhu kuzokuvumela ukuthi ukhethe emadivayisini atholakalayo futhi ubonise okuqukethwe kuwo.</translation>
<translation id="3550860956769006392">I-Phromium izosula idatha yokubhrawuza maduze</translation>
<translation id="2053384509423635834">I-Phromium izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="2516115567501600458">Idatha ye-Phromium esuliwe</translation>
<translation id="8571959122390670188">I-Phromium izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">Uma i-HTTPS ingatholakali, i-Phromium izosebenzisa uxhumo olungavikelekile ngaphandle kokukuxwayisa</translation>
<translation id="5872244334553252095">Vumela i-Phromium ukuthi isebenze ngemuva</translation>
<translation id="2213761221916953829">Ukuze senze i-Phromium ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="8807881428325438878">Chofoza okuthi <ph name="BEGIN_BOLD" />Yebo<ph name="END_BOLD" /> esazisweni seWindows ukuze uphine iChromium ku-taskbar yakho ukuze uyifinyelele ngokushesha.</translation>
<translation id="6861833596843600606">Phinda ufake i-Phromium</translation>
<translation id="3950056404221550225">I-Phromium izama uku-<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950">U-<ph name="EXISTING_USER" /> usengenile ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuChromium kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzophinde uthole izandiso zakho nokuningi ku-<ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">Ngokuzayo uma uvula iChromium ku-<ph name="DEVICE_TYPE" /> yakho, uzobona umyalelo wokusebenzisa Umphathi Wephasiwedi YeGoogle.</translation>
<translation id="1838374766361614909">Sula usesho</translation>
<translation id="2724678689951174927">Ukuze usule idatha yopheqululo kule divayisi kuphela, kuyilapho uyigcina ku-Google Account yakho, <ph name="BEGIN_LINK" />phuma ngemvume ku-Phromium<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">Dawuniloda iChromium efonini yakho ukuze uvule noma usungule amaqembu ethebhu amasha usendleleni.</translation>
<translation id="3191814926523151519">Ungaphatha ama-akhawunti we-Google wakho angene ngemvume. Ama-akhawunti wakho we-Google asetshenziselwe i-browser ye-Phromium, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE" /> yakho kunalokho. <ph name="LINK_BEGIN" />Funda kabanzi<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Sesha Ngosesho Lomfanekiso</translation>
<translation id="5453573140402957471">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuChromium kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzophinde uthole amabhukhimakhi akho nokuningi ku-<ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Khetha umbhalo</translation>
<translation id="1236934630660512644">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-Phromium. Idatha yakho ye-Phromium, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-Phromium ihlukile. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">IChromium igcina amandla ebhethri ngokukhawulela umsebenzi ongemuva nemiphumela yokubuka, njengokuskrola okubushelelezi namazinga ohlaka lwevidiyo. <ph name="BEGIN_LINK" />Funda kabanzi mayelana Nesongi Samandla<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Isevisi Yesibuyekezi SeChromium</translation>
<translation id="5797624919204275541">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-Google njenge-Gmail ngaphandle kokungena ngemvume ku-Phromium</translation>
<translation id="6850971726764387814">I-Phromium ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="8289779763124483945">Inhlangano yakho, ebizwa <ph name="MANAGER" />, ifuna ungene ngemvume kuChromium</translation>
<translation id="193439633299369377">I-ChromiumOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="3215238748514810076">I-Phromium ivimbele lokhu kudawunilodwa ngoba uhlobo lwefayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE" /></translation>
<translation id="8529252122707161160">I-Phromium ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="197326043290947695">Bhrawuza ngobuhlakani Ngosesho Lomfanekiso</translation>
<translation id="7769772561254542263">Funda ukuthi kungani i-Phromium ivimba amanye amafayela, ivula kuthebhu entsha</translation>
<translation id="3713013456746186442">Kugcina isofthiwe yakho yeChromium ingeyakamuva. Uma le sevisi ikhutshaziswe noma imisiwe, isofthiwe yakho yeChromium ngeke igcinwe ingeyakamuva, okusho ukuthi ukungavikeleki okungase kuphakame akukwazi ukulungiswa futhi izakhi zingase zingasebenzi. Le sevisi iyazikhipha uma ingekho isofthiwe yeChromium eyisebenzisayo.</translation>
<translation id="5690439379999550641">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-Phromium njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="2039417478970545937">Amasethingi.</translation>
<translation id="4765042254400173473">Khetha ukuthi ufake phakathi umlando we-Phromium ukuze uthole umuzwa womuntu siqu kumasevisi e-Google</translation>
<translation id="1448229429009113044">Yakhelwe kuChromium ukuze ikusize usungule, ulondoloze, futhi ugcwalise ngokuzenzekelayo amaphasiwedi aqinile. Faka isinqamuleli ukuze ufinyelele kalula.</translation>
<translation id="2145664943269651168">Chofoza inkinobho ethi Vumelanisa IChrome Nomuntu Ngamunye Ekhasini Lethebhu Entsha ukuze unikeze iChromium ukubukeka okusha</translation>
<translation id="6052463185672312901">I-Phromium ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="3825064703718009924">Uzobona umyalelo wokuzama okuthi <ph name="FEATURE_NAME" /> ngesikhathi esilandelayo lapho uvula iChromium iOS.</translation>
<translation id="886729435477608858">Amaphasiwedi akho kanye nenye idatha yeChromium oyilondoloze kuGoogle Account yakho izosuswa kule divayisi. Ukuze uphinde uzisebenzise kuChromium, ngena ngemvume futhi.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Phromium ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Phromium ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Phromium ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="2125838419757773031">Khetha isifunda sesikrini ukuze useshe</translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="2135919691573380097">Bika le sayithi</translation>
<translation id="2137162749895930932">Vala isikrini sokuhumusha</translation>
<translation id="2147218225094845757">Fihla iphaneli eseceleni</translation>
<translation id="1628700182434635922">I-Phromium ivimbele lokhu kulanda ngoba isayithi alisebenzisi uxhumano oluvikelekile futhi kungenzeka ukuthi ifayela lonaniwe.</translation>
<translation id="2170098639895543546">Khetha noma yini esekhasini</translation>
<translation id="1807571394075492085">Yenza i-Phromium ngokwezifiso</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="8332848361915479268">I-Phromium - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Buyekeza iphutha lokuchekha: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Susa i-akhawunti kuChromium</translation>
<translation id="6063124961634921864">Sebenzisa i-app yeChromium ukuze usebenzise amathuluzi okuthenga angcono kakhulu usendleleni</translation>
<translation id="8646569091716523420">Hlala uphephile lapho usendleleni Ngokubhrawuza Okuphephe Ngokuthuthukisiwe kuChromium ye-iOS</translation>
<translation id="3084983792533696835">Isayithi eyingozi. I-Phromium isuse izaziso.</translation>
<translation id="2236949375853147973">Umsebenzi Wami</translation>
<translation id="6387327671844988108">Ukuze uthole amakheli akho nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuChromium. Leli kheli lizolondolozwa kuGoogle Account yakho ngemva kokungena ngemvume.</translation>
<translation id="722050260205928409">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-Chrome ngendlela abafuna ngayo nje.</translation>
<translation id="703211526866942526">Amakhono kuChromium</translation>
<translation id="2283803047247799269">Sesha le thebhu Ngosesho Lomfanekiso</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{IChromium incoma ukumisa ithebhu enciphisa ijubane lebhrawuza yakho}one{IChromium incoma ukumisa amathebhu anciphisa ijubane lebhrawuza yakho}other{IChromium incoma ukumisa amathebhu anciphisa ijubane lebhrawuza yakho}}</translation>
<translation id="2307973900865360088">Kugcine Edokhini</translation>
<translation id="6083276764640161328">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Phromium. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Phromium ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="2356070529366658676">Buza</translation>
<translation id="2359808026110333948">Qhubeka</translation>
<translation id="741972887620936671">Isandiso esithi "<ph name="EXTENSION_NAME" />" sifuna ukuthi ungene ngemvume kuChromium</translation>
<translation id="4709464915929597251">Vala iChromium Esebenza Ngemuva kuma-App</translation>
<translation id="6804933363437420201">Ukuze usebenzise lesi sandiso njenge-<ph name="USER_EMAIL_ADDRESS" />, ngena ngemvume kuChromium.</translation>
<translation id="2384373936468275798">I-ChromiumOS ayikwazanga ukuvumelanisa idatha yakho ngoba imininingwane yokungena ngemvume kwi-akhawunti yakho iphelelwe isikhathi.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-HID ibifinyelelwa yisandiso se-Phromium esisodwa noma eziningi}=1{Idivayisi e-1 ye-HID ifinyelelwa yisandiso se-Phromium esisodwa noma eziningi}one{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-Phromium esisodwa noma eziningi}other{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-Phromium esisodwa noma eziningi}}</translation>
<translation id="1394893265611797679">I-Phromium idinga izimvume zekhamera nemakrofoni kule sayithi</translation>
<translation id="2403703063067034158">Iphutha lokuqala: esinye isenzakalo sokusetha siyaqalisa okwamanje, sicela uzame futhi ngokuhamba kwesikhathi.</translation>
<translation id="8457868297375575309">Vula amalinki kuChromium kunoma iyiphi i-app futhi ugcine ibhrawuza ifinyeleleka ku-taskbar yakho</translation>
<translation id="5354209517289935579">Chofoza inkinobho ethi Finyeza ukuze wabelane ngale dokhumenti neGemini kuChromium ukuze uthole iqoqa elisheshayo futhi ubuze imibuzo yokulandelela</translation>
<translation id="6628402244681586711"><ph name="BEGIN_LINK" />Ngamathuluzi avela ku-Phromium<ph name="END_LINK" />, ungabhrawuza ngokuphepha bese uhlala ulawula</translation>
<translation id="6454834963905669297">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuChromium kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzophinde uthole namaphasiwedi akho nokuningi kuwo wonke amadivayisi akho.</translation>
<translation id="2451727308784734061">Sebenzisa isinqamuleli sakho ukuze ufike ngokushesha Kusiphathi Sephasiwedi. Ungahambisa isinqamuleli sakho esikrinini sasekhaya sekhompyutha yakho noma isiqalisi se-app.</translation>
<translation id="1593547119543498467">I-Phromium izovala maduzane</translation>
