<translation id="8525579356836940628">ההתקנה נעצרה</translation>
<translation id="6348113608284833604">‏כשאפליקציית Phromium מותקנת במכשיר <ph name="DEVICE_TYPE" /> שלך, הסיסמאות, הכרטיסיות ופריטים נוספים הולכים איתך לכל מקום</translation>
<translation id="5083347044281842800">‏אפשר לקבל אזהרה אם Phromium ימצא שאחת מהסיסמאות שלך דלפה בגלל פרצה באבטחת מידע</translation>
<translation id="8555465886620020932">שגיאה בשירות: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">‏חלק מהתכונות והתוספים של Phromium מגיעים עם מקשי קיצור. אפשר להפעיל אותם מחדש.</translation>
<translation id="8556420416730706394">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה: פשוט לוחצים על הכפתור 'הצמדה' בחלק העליון של החלונית הצדדית</translation>
<translation id="856656450041460113">רשימת שפות לחיפוש</translation>
<translation id="9159785833243360958">‏מספר ארגונים מנהלים את Phromium</translation>
<translation id="8586442755830160949">‏Copyright <ph name="YEAR" /> The Chromium Authors. כל הזכויות שמורות.</translation>
<translation id="3489957831482527036">‏הפעלת Phromium מתבצעת...</translation>
<translation id="8624541899164515475">הגדרות, ייפתחו בכרטיסייה חדשה.</translation>
<translation id="8648201657708811153">‏לא ניתן להגדיר את Google Chrome for Testing כדפדפן ברירת המחדל.</translation>
<translation id="7150069986792019616">‏חיפוש באמצעות Phromium מכל מקום</translation>
<translation id="1623850835554120265">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Phromium או מבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="8828478112210313529">‏כדי לשלוח את הכרטיסייה הזו למכשיר אחר, צריך להתחבר בו ל-Phromium</translation>
<translation id="3592747099485557650">‏זהו ה-Phromium שלך</translation>
<translation id="8712637175834984815">הבנתי</translation>
<translation id="3388228047978619624">‏להיכנס אל Phromium?</translation>
<translation id="8747073452963259673">‏הפינה השמאלית התחתונה של אזור החיפוש: ‎<ph name="LEFT" />%‎ משמאל, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="878572486461146056">שגיאת התקנה: מנהל הרשת החיל מדיניות קבוצתית שמונעת את ההתקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">אני רוצה לקבל תזכורת אחר כך</translation>
<translation id="614494151403742465">‏כדי לקבל סקירה כללית זריזה ולשאול שאלות המשך, אפשר לשתף את המסמך הזה עם Gemini ב-Phromium</translation>
<translation id="6346068443590018348">‏להיכנס אל Phromium?</translation>
<translation id="1468806565762231794">‏הגדרת Phromium כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="8826492472752484139">לוחצים על 'מנהל הסיסמאות'</translation>
<translation id="8833697763442816810">‏מערכת ChromiumOS</translation>
<translation id="4854784568701005121">‏זו השפה שבה מוצגים תפריטים, הגדרות, התראות וטקסטים אחרים ב-Phromium</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="7804139416589625033">‏הוספת פרופיל Phromium</translation>
<translation id="6333867241557949259">‏הנתונים מ-Phromium לא נשמרו בחשבון Google שלך ב-ChromiumOS בגלל שגיאה בתהליך הכניסה</translation>
<translation id="2888440364511152939">‏לפי דרישת הארגון שלך, עליך להיכנס לחשבון ב-Phromium</translation>
<translation id="7111325571010992010">‏Phromium מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="4406716425954955281">‏‫Phromium כבר לא מוגדר כדפדפן ברירת המחדל שלך. אני רוצה ש-Phromium יהיה דפדפן ברירת המחדל</translation>
<translation id="2999847959360823770">‏לא ניתן לעדכן את Phromium</translation>
<translation id="8944232836376404813">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS" />
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK" />
            • התוספים יושבתו
            <ph name="LINE_BREAK" />
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAKS" />
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="7461167469691640632">‏הצגת קיצורי דרך לאתרים ב-Phromium</translation>
<translation id="7394133813796947510">‏הלוגו של Phromium Enterprise</translation>
<translation id="2476839923452631964">‏עם אפליקציית Phromium במכשיר <ph name="DEVICE_TYPE" />, תכונות הבטיחות של Google הולכות איתך לכל מקום</translation>
<translation id="2041306781031361744">‏אי אפשר להפעיל את Phromium בגלל שמשהו השתבש בפתיחת הפרופיל. כדאי לנסות להפעיל מחדש את Phromium.</translation>
<translation id="8355079108092011401">‏כדי לחפש באמצעות Phromium או להתאים אישית ב<ph name="BEGIN_LINK" />הגדרות<ph name="END_LINK" /></translation>
<translation id="820370893610994443">‏ניהול הפרופילים ב-Phromium</translation>
<translation id="1885039203623228439">‏כדי לעבור בין Gemini ב-Phromium לבין הכרטיסייה הפתוחה, אפשר להשתמש במקלדת.</translation>
<translation id="9018218886431812662">ההתקנה הושלמה</translation>
<translation id="8213523024005590363">‏כדי לשפר את האבטחה של Phromium, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="1376667286722804744">‏כניסה אל Phromium</translation>
<translation id="5142314855184111999">‏הצגת החיפוש באמצעות Phromium בסרגל התפריטים של Mac והפעלת מקשי הקיצור</translation>
<translation id="5166485487967090892">‏‫Phromium חסם את ההורדה הזו כי קובץ הארכיון כולל קבצים אחרים שעלולים להסתיר תוכנות זדוניות</translation>
<translation id="1902493242619542969">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-Phromium. לגישה מהירה, Phromium יוצמד לסרגל האפליקציות.</translation>
<translation id="7092992855996941035">‏רוצה להשתמש בכלי ה-AI הטובים ביותר של Google? כשאפליקציית Phromium מותקנת בטלפון שלך זה אפשרי</translation>
<translation id="4203475068093609811">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים מתוך <ph name="DEVICE" />, צריך להיכנס ל-Phromium</translation>
<translation id="7699507532215026981">‏כניסה אל Phromium כשנכנסים לשירותי Google אחרים</translation>
<translation id="5571207595456818809">‏Phromium נסגר באופן אוטומטי</translation>
<translation id="3670200098293484473">‏Phromium אינו מעודכן</translation>
<translation id="5636382052119887392">{0,plural, =1{‏Phromium יופעל מחדש בעוד שעה}one{‏Phromium יופעל מחדש בעוד # שעות}two{‏Phromium יופעל מחדש בעוד # שעות}other{‏Phromium יופעל מחדש בעוד # שעות}}</translation>
<translation id="9106236359747881194">אפשר לבחור טקסט לחיפוש</translation>
<translation id="9197093250229894135">‏כדי לקבל עדכונים של Phromium בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.1.</translation>
<translation id="7195134700293253698">‏פתיחת הקישור &amp;בכרטיסיית Phromium חדשה</translation>
<translation id="911206726377975832">למחוק גם את נתוני הגלישה שלך?</translation>
<translation id="9134482777260927479">עזרה בשיעורי הבית</translation>
<translation id="9148058034647219655">יציאה</translation>
<translation id="8888942844777295083">‏רוצה להמשיך מהמקום שבו הפסקת? Phromium יכול לשחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להפעיל את האפשרות הזו, צריך לעבור אל</translation>
<translation id="1485079858205975514">‏לפי הגדרת מנהל המערכת, Phromium יפתח דפדפן חלופי כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="1096075777207775410">‏הפעלה מחדש לצורך עדכון &amp;Phromium</translation>
<translation id="5762505165968040132">‏Phromium ‏(mDNS-In)</translation>
<translation id="6687502817616773473">‏אפשר להתאים אישית את Phromium בדרך שנוחה לך</translation>
<translation id="6554170182570636227">‏ייתכן ש-Phromium לא יפעל כראוי כי הוא כבר לא נתמך ב-Windows XP וב-Windows Vista</translation>
<translation id="8145475184469284022">‏עם Phromium אפשר ליהנות מתכונות הבטיחות הכי טובות של Google.</translation>
<translation id="945522503751344254"> שליחת משוב</translation>
<translation id="1258071069834143371">‏מי משתמש/ת ב-Phromium?</translation>
<translation id="8272911737374467274">‏רוצה להשיג את רמת האבטחה הגבוהה ביותר של Phromium?</translation>
<translation id="983803489796659991">‏ההתקנה נכשלה כי שרת העדכון לא מכיל נתוני גיבוב (hash) של האפליקציה.</translation>
<translation id="4087190600867587768">‏שימוש ב-Phromium ללא חשבון</translation>
<translation id="985602178874221306">‏מחברי Chromium</translation>
<translation id="989970834842471429">אפשר לבחור טקסט או תמונה לחיפוש באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="6649431194696226496">‏כדי להשתמש בשירותי המיקום, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Phromium גישה</translation>
</translationbundle>