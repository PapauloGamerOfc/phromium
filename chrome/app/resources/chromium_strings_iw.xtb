<translation id="4688227912949761884">‏מתבצע עדכון של Phromium‏ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035">‏החשבון של <ph name="EXISTING_USER" /> כבר מחובר. כדי לשמור על סביבת גלישה נפרדת, אפשר להיכנס ל-Phromium בפרופיל נפרד בתור <ph name="USER_EMAIL_ADDRESS" />. אפשר לקבל גם את התוספים ופריטים נוספים בכל המכשירים.</translation>
<translation id="4945147853702701048">‏התרת כניסה אל Phromium</translation>
<translation id="7813879193794658604">‏להסיר מ-‏Phromium‏</translation>
<translation id="2908302339618007937">‏ירידה ברמת הביצועים בתמורה להגברת העמידות של Phromium בפני מתקפות</translation>
<translation id="8760365573983490520">‏הגדרת Phromium כדפדפן ברירת המחדל שלך</translation>
<translation id="6395910175148753946">‏<ph name="PAGE_TITLE" /> - Phromium בגרסת בטא</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{‏ההמלצה של Phromium היא להשהות את הכרטיסייה שמאטה את הדפדפן}one{‏ההמלצה של Phromium היא להשהות את הכרטיסיות שמאטות את הדפדפן}two{‏ההמלצה של Phromium היא להשהות את הכרטיסיות שמאטות את הדפדפן}other{‏ההמלצה של Phromium היא להשהות את הכרטיסיות שמאטות את הדפדפן}}</translation>
<translation id="975923236500175446">‏יכול להיות ש-Phromium לא יפעל כראוי כי הוא כבר לא נתמך בגרסה הזו של Linux</translation>
<translation id="7595270580374414215">‏‫Phromium חסם את ההורדה הזו כי הקובץ יכול לפגוע בחשבונות האישיים ובחשבונות שלך ברשתות החברתיות</translation>
<translation id="5644162187312430027">‏יש להמתין בזמן ש-Phromium מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="2476033563817685908">‏Phromium מנסה לערוך את הסיסמאות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="1626952238284562558">‏עם Phromium אפשר להשתמש בקלות ומכל מקום באפליקציות שמעניינות אותך, כמו Google Drive ו-YouTube.</translation>
<translation id="5524890928877629608">‏הפינה השמאלית העליונה של אזור החיפוש: ‎<ph name="LEFT" />%‎ משמאל, ‎<ph name="TOP" />%‎ מלמעלה</translation>
<translation id="2860766395826060492">‏פתיחה של קובצי PDF ב-Phromium</translation>
<translation id="5536164441519929134">יש לי שאלה<ph name="LINE_BREAK" />לגבי הכרטיסייה הזו</translation>
<translation id="3915500272078806319">‏אם נכנסת לאתר בפעם הראשונה, Phromium משבית את האופטימיזציה של JavaScript מטעמי אבטחה.

אם הדף הזה לא פועל כמו שצריך, כדאי להפעיל את האופטימיזציה.</translation>
<translation id="6778733300408894918">‏הצגת Gemini ב-Phromium בסרגל התפריטים של Mac והפעלת מקשי הקיצור</translation>
<translation id="8411908790152555435">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Phromium בתור <ph name="USER_EMAIL_ADDRESS" />. המידע השמור ופריטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כמשתמש רגיל ולא כאדמין.</translation>
<translation id="6578510724610627339">‏שימוש ב-Phromium כברירת מחדל והצמדה שלו</translation>
<translation id="5596627076506792578">אפשרויות נוספות</translation>
<translation id="5605834417512968703">‏אפשר לבחור משהו לחיפוש באמצעות התכונה 'חיפוש תמונות' או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
<translation id="5618818588972826921">‏אפשר לבחור טקסט או תמונה לחיפוש באמצעות התכונה "חיפוש תמונות" או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
<translation id="4431270188253419020">{0,plural, =0{‏יש עדכון ל-Phromium}=1{‏יש עדכון ל-Phromium}one{‏עדכון של Phromium זמין כבר # ימים}two{‏עדכון של Phromium זמין כבר # ימים}other{‏עדכון של Phromium זמין כבר # ימים}}</translation>
<translation id="6903143702905157196">‏מחיקת נתונים מאתרים מהמכשיר בכל פעם שסוגרים את Phromium</translation>
<translation id="5354366475527026551">‏יש להפעיל מחדש את Phromium</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">‏הצגת Phromium בשפה זו</translation>
<translation id="569897634095159764">‏לא ניתן להתחבר לאינטרנט. נדרש אימות של שרת ה-proxy.</translation>
<translation id="5724138350057003647">‏‫Phromium מפנה מקום בזיכרון שמוקצה לכרטיסיות לא פעילות. כך, לכרטיסיות הפעילות ולאפליקציות אחרות יש יותר משאבים מהמחשב ו-Phromium פועל מהר. כשחוזרים לכרטיסיות הלא פעילות, הן מופעלות מחדש באופן אוטומטי. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון בזיכרון<ph name="END_LINK" /></translation>
<translation id="3730992449058237228">‏אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="SETTINGS_LINK" /> את נתוני Phromium בחשבון</translation>
<translation id="1983042639279920602">‏אפשר להתאים אישית את Phromium ולנהל אותו. הגדרת Phromium כברירת המחדל.</translation>
<translation id="7136978005010973283">‏רוצה סנכרון מושלם של הסיסמאות, הסימניות וההיסטוריה שלך בין מכשירים? כדאי להגדיר את Phromium כדפדפן ברירת המחדל.</translation>
<translation id="5809516625706423866">‏לא ניתן להתחבר לאינטרנט. HTTP 401: אין הרשאה. צריך לבדוק את ההגדרה של שרת ה-proxy.</translation>
<translation id="3059302031765226748">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Phromium, אבל Phromium יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו מושבתת.</translation>
<translation id="4904710047654714935">‏כדי להשתמש בנתוני Phromium ולשמור אותם בחשבון Google, עליך לעדכן את Phromium</translation>
<translation id="5824893331272123205">לא הצלחנו לטעון את החלונית, אפשר לנסות שוב</translation>
<translation id="2582896742857095190">‏ברוכים הבאים ל-Phromium‏</translation>
<translation id="5004643502851105876">‏מפעילה תכונות נוספות שמספקות את ההגנות החזקות ביותר של Phromium</translation>
<translation id="5871205389137001634">יש ללחוץ כדי לצאת מחיפוש התמונות</translation>
<translation id="7409018434452575206">‏מערכת Phromium גילתה שהפריטים האלה מכילים תוכנה זדונית:</translation>
<translation id="3191822983646594827">‏Phromium בודק בקביעות כדי לוודא שלדפדפן יש את ההגדרות הבטוחות ביותר. נודיע לך אם צריך לבדוק משהו.</translation>
<translation id="5895138241574237353">הפעלה מחדש</translation>
<translation id="625373791981566594">‏‫Gemini Enterprise ב-Phromium</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – כניסה לרשת</translation>
<translation id="5924017743176219022">מתבצעת התחברות לאינטרנט…</translation>
<translation id="5941711191222866238">מזעור</translation>
<translation id="8650638130234822147">‏כדי לקבל גישה לסימניה הזו ולנתונים נוספים בכל המכשירים שלך, צריך להיכנס ל-Phromium</translation>
<translation id="5010592102321399468">‏התאמה אישית של Phromium</translation>
<translation id="5960071705175224773">ההגדרות שלך שונו על ידי אפליקציה לא ידועה</translation>
<translation id="5977420883993828287">התכונה הוצמדה. מעכשיו אפשר להשתמש ב"משימות לפי הקשר" דרך סרגל הכלים</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{‏לפי הגדרת הארגון, Phromium נסגר אוטומטית כשלא משתמשים בו במשך דקה.}one{‏לפי הגדרת הארגון, Phromium נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}two{‏לפי הגדרת הארגון, Phromium נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}other{‏לפי הגדרת הארגון, Phromium נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}}</translation>
<translation id="3160371268592376569">‏יש לעדכן את Phromium כדי להתחיל את הסנכרון</translation>
<translation id="5990360079535151574">כדי לשאול שאלות תוך כדי גלישה, אפשר ללחוץ על הכפתור משימות לפי הקשר שבסרגל הכלים ולפתוח את החלונית מחדש</translation>
<translation id="6003112304606738118">מתבצעת הורדה… יש עוד <ph name="HOURS" /> שע'</translation>
<translation id="6009821354356307391">הוספה של שאילתת המשך</translation>
<translation id="6040143037577758943">סגירה</translation>
<translation id="5783572280281297164">‏עם אפליקציית Phromium במכשיר <ph name="DEVICE_TYPE" /> אפשר ליהנות עוד יותר מהקניות באינטרנט</translation>
<translation id="2712461133060419287">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-Phromium להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה. המערכת תמשיך לשלוח התראות.</translation>
<translation id="7845842385196710435">‏&amp;פתיחה ב-Phromium</translation>
<translation id="6069027071882229820">העתקה כתמונה</translation>
<translation id="3752072756936611600">‏<ph name="EXTENSION_NAME" /> נוסף ל-‏Phromium‏</translation>
<translation id="2775066550187002528">‏כדי להתאים אישית את Google Chrome ולשלוט בו טוב יותר, כדאי להוריד את העדכון החדש.</translation>
<translation id="6531352038528110565">‏מופעל • Phromium לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="2876078296400914679">‏החשבון שלך ב-Phromium</translation>
<translation id="3881538460441135554">‏מתן הרשאה לתוסף להציג בקשות גישה בסרגל הכלים של Phromium</translation>
<translation id="7479187736743594081">‏<ph name="FILE_NAME" /> מסוכן, ולכן Phromium חסם אותו.</translation>
<translation id="6646104775883837119">‏Phromium ייסגר בקרוב והנתונים שבו יימחקו</translation>
<translation id="6138634751748297112">‏כאן ניתן לעבור בין פרופילים של Phromium</translation>
<translation id="8660563290103481109">‏אם מאפשרים שימוש בקובצי cookie, יכול להיות שמערכת Phromium תשתמש בהם במהלך טעינה מראש.</translation>
<translation id="6165508094623778733">למידע נוסף</translation>
<translation id="969667123257916656">‏צריך למחוק את נתוני Phromium בחשבון</translation>
<translation id="5528040738212560214">‏הקובץ הזה עלול להיות מסוכן<ph name="LINE_BREAK" />דפדפן Phromium יכול לבדוק את ההורדה הזו אם מזינים את הסיסמה. מידע על הקובץ נשלח אל התכונה 'גלישה בטוחה של Google', אבל הסיסמה והתוכן של הקובץ נשארים במכשיר.</translation>
<translation id="6182736845697986886">ההתקנה נכשלה עקב שגיאה פנימית בשרת העדכון.</translation>
<translation id="6041381825442292659">‏יש לוודא שנכנסת ל-Phromium ב-<ph name="TARGET_DEVICE_NAME" /> שלך ולשלוח שוב.</translation>
<translation id="2474943719592372017">‏הקלדת חיפושים ושאלות מכל מקום במכשיר, גם אם Phromium ממוזער ההגדרה מאפשרת ל-Phromium לפעול ברקע.</translation>
<translation id="2518372260387069450">‏במחשב זה קיימת כבר גרסה מתקדמת יותר של Phromium. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של Phromium ולנסות שוב.</translation>
<translation id="3832895416321159809">{0,plural, =0{‏Phromium יופעל מחדש עכשיו}=1{‏Phromium יופעל מחדש בעוד שנייה אחת}one{‏Phromium יופעל מחדש בעוד # שניות}two{‏Phromium יופעל מחדש בעוד # שניות}other{‏Phromium יופעל מחדש בעוד # שניות}}</translation>
<translation id="2775110773501098464">‏נדרשת הרשאת גישה לאחסון ב-Phromium כדי להוריד קבצים</translation>
<translation id="3505491405575013121">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Phromium</translation>
<translation id="2276249127856880228">‏יש להפוך את Phromium לדפדפן ברירת המחדל</translation>
<translation id="6248988683584659830">חיפוש בהגדרות</translation>
<translation id="554637698797403739">‏כשאפליקציית Phromium מותקנת בטלפון שלך, תכונות הבטיחות הטובות ביותר של Google מלוות אותך לכל מקום</translation>
<translation id="7016155178198587734">‏האם לצאת מ-Phromium?</translation>
<translation id="5660287988409470276">‏הכרטיסיות האלה משתמשות במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-Phromium להשבית אותן.</translation>
<translation id="8429776045186716992">‏התאמה אישית של פרופיל Phromium</translation>
<translation id="3310436202618971091">‏בחירת שם לפרופיל Phromium שלך</translation>
<translation id="1478750151648434251">‏תוסף מבקש ממך להיכנס ל-Phromium</translation>
<translation id="9139712828910812615">‏<ph name="FILE_NAME" /> עלול להיות מסוכן, ולכן Phromium חסם אותו.</translation>
<translation id="5191618263102115907">‏Phromium משתמש במצלמה שלך.</translation>
<translation id="8247508943089477519">‏מתבצעת כרגע פעולה אחרת ב-Phromium. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="8271488218611798813">‏קל יותר כעת להשתמש ב-Phromium באמצעות חשבון Google שלך ובמחשבים משותפים.</translation>
<translation id="446228390478495078">‏כדי להשתמש בקלות בתכונות המוכרות והאהובות, כדאי להגדיר את Phromium בתור דפדפן ברירת המחדל.</translation>
<translation id="2203435422524224690">‏קיצור דרך ב-Phromium</translation>
<translation id="3977517784144885449">‏Phromium חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים כאלה ויכול להיות שהקובץ מסוכן</translation>
<translation id="8088471547690853921">‏ברצונך באמת להסיר את התקנת Phromium?</translation>
<translation id="6375219077595103062">ניתן להוסיף קיצור דרך למנהל הסיסמאות</translation>
<translation id="6388799252195623474">אני רוצה עזרה בנושא הזה</translation>
<translation id="1774421040071124552">‏כדי להמשיך, עליך להיכנס ל-Phromium באמצעות החשבון <ph name="EMAIL" />. כך המדיניות של הארגון תחול על המכשיר שלך.</translation>
<translation id="2343430845154053061">‏הלוגו של Phromium בתוך מסך מחשב.</translation>
<translation id="2724924185145648602">‏Phromium הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-Phromium.</translation>
<translation id="7417453886359805803">‏כדי שתמיד תהיה לך אפשרות להשתמש בנתונים ב-Phromium ולשמור אותם בחשבון שלך ב-Google, עליך לאמת את הזהות שלך</translation>
<translation id="3304683228794166031">‏דפדפן Phromium פועל מהר יותר ותכונות שמשתמשות ב-JavaScript אמורות לפעול כמו שצריך</translation>
<translation id="6436260184216827876">התכונה 'חיפוש תמונות' לא זמינה. יש לנסות שוב מאוחר יותר.</translation>
<translation id="6442900851116057561">‏הפעלה מחדש של ChromiumOS</translation>
<translation id="9164801375934097818">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Phromium טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="2577121659922309103">‏כדי לעקוב אחרי מחירים ולקבל התראות על ירידות במחיר באתר מסוים, כדאי להוריד את Phromium לטלפון שלך</translation>
<translation id="2052328618318278030">‏מושבת • Phromium לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="3122296739697671126">‏ברוך בואך לפרופילים של Phromium</translation>
<translation id="3472445024540245926">‏בפתיחה הבאה של Phromium במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להשתמש בקבוצות של כרטיסיות.</translation>
<translation id="2144084801479939969">‏הסרת החשבון מ-Phromium</translation>
<translation id="2473490714352939152">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Phromium.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="359777544552173333">‏הסרה של התקנת Phromium</translation>
<translation id="3890462049854841354">‏קיצורי הדרך נפתחים ב-Phromium</translation>
<translation id="6616579671682178785">‏לפי הגדרת הארגון, Phromium נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="8662645370371079862">‏בכל פרופיל מאוחסנים נתוני Phromium משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="6556755379298048869">חיפוש באמצעות מקשי הקיצור.</translation>
<translation id="7133640529688742768">‏<ph name="BEGIN_LINK" />מידע נוסף לגבי השמירה על פרטיות הנתונים ב-Phromium<ph name="END_LINK" /></translation>
<translation id="8316065704185291024">‏השינויים בהגדרה הזו ייכנסו לתוקף לאחר הפעלה מחדש של Phromium.</translation>
<translation id="2816396636285296289">‏אפשר לנהל את התוספים בלחיצה על "תוספים" בתפריט הראשי של Phromium.</translation>
<translation id="8831144879019828189">‏אפשר לעבור לפרופיל Phromium אחר כדי לראות סיסמאות</translation>
<translation id="7017911482442558099">‏עם אפליקציית Phromium אפשר ליהנות מכלי ה-AI הכי טובים בכל מקום</translation>
<translation id="5784574554904759369">‏Phromium שולח את הטקסט שמוקלד בשדות טקסט ל-Google כדי לתקן שגיאות כתיב</translation>
<translation id="8485501471305987872">‏מעבר אל הגדרות ההודעות של Phromium</translation>
<translation id="6600016381025017075">אפשר לחפש משהו בדף הזה</translation>
<translation id="1462793186918694806">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Phromium‏.</translation>
<translation id="7501991510212476553">‏‫Phromium מופעל עכשיו יחד עם Windows, כך שאפשר להתחיל לגלוש מיד. ניתן להשבית זאת בהגדרות.</translation>
<translation id="7686308613268368175">‏אפשר להמשיך מהמקום שבו הפסקת: Phromium שחזר את הכרטיסיות מהסשן האחרון שלך. כדי להשבית את האפשרות הזאת, צריך לעבור אל</translation>
<translation id="5266723901802366313">‏נדרשת הרשאת גישה למצלמה ב-Phromium כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="7085315067428293799">‏אם הסימניות שלך נשמרות גם בחשבון Google, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-Phromium ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="668175097507315160">‏לא בוצע סנכרון של הנתונים ב-ChromiumOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="5279767706090517695">‏להסיר את הנתונים של האפליקציה הזאת מ-Phromium?</translation>
<translation id="6562226321659107531">‏נדרשת הרשאת גישה למיקרופון ב-Phromium עבור האתר הזה</translation>
<translation id="6712881677154121168">שגיאה בהורדה: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של Phromium.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של Phromium.</translation>
<translation id="4914871493602315663">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את Phromium ב'פעילות באינטרנט ובאפליקציות' ובשירותי Google המקושרים</translation>
<translation id="5919390816124912606">‏Phromium כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="5867815953973052697">‏כדי לקבל גישה לסימניות ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-Phromium. לאחר הכניסה, הסימנייה הזו תישמר בחשבון Google.</translation>
<translation id="7381168634819530324">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Phromium, אבל Phromium יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו פועלת.</translation>
<translation id="1509688792864707851">{count,plural, =1{‏חלק מהנתונים ב-Phromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו (פריט אחד).}one{‏חלק מהנתונים ב-Phromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}two{‏חלק מהנתונים ב-Phromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}other{‏חלק מהנתונים ב-Phromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}}</translation>
<translation id="4702638565169602649">‏ההמלצה של Phromium היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="6779406956731413166">‏<ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת מאפשרת את השימוש ב-ChromiumOS.</translation>
<translation id="6831043979455480757">תרגום</translation>
<translation id="1564864902402454287">‏Phromium מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="684888714667046800">לא ניתן להתחבר לאינטרנט. אם משתמשים בחומת אש, צריך לוודא ש-<ph name="PRODUCT_EXE_NAME" /> ברשימת ההיתרים.</translation>
<translation id="6200419390448865091">‏Phromium‏ - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">צריך ללחוץ כדי להמשיך</translation>
<translation id="6862030660799253820">חיפוש התמונה הזו באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="6869568587896659271">גישה קלה לאתרים מתחת לסרגל הכתובות</translation>
<translation id="4011399428346318467">‏הפריט "<ph name="EXTENSION_NAME" />" שנמצא ב-Phromium מכיל תוכנה זדונית</translation>
<translation id="6877155553248388166">‏הפינה הימנית התחתונה של אזור החיפוש: ‎<ph name="RIGHT" />%‎ מימין, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="6896758677409633944">העתקה</translation>
<translation id="6898028264630240901">כדי לשאול שאלות במהלך הגלישה, אפשר להצמיד "משימות לפי הקשר"</translation>
<translation id="1012681980425424211">‏הגדרת Phromium כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="1744625657438211994">‏&amp;ניהול הפרופילים ב-Phromium</translation>
<translation id="7264818828956697552">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS" />
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK" />
            • התוספים יושבתו
            <ph name="LINE_BREAK" />
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAK" />
            • יתאפסו קיצורי הדרך של Phromium
            <ph name="LINE_BREAKS" />
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="6489000842445481390">‏הגעת למגבלת הסימניות ב-Phromium (<ph name="BOOKMARK_LIMIT" />), לכן חלק מהסימניות עדיין לא נשמרו בחשבון Google.

כדי לשמור סימניות חדשות בחשבון, צריך למחוק חלק מהסימניות הקיימות. יציאה מהחשבון תמחק את הסימניות שלא נשמרו.</translation>
<translation id="2645108248038996858">‏פתיחת הקישור בחלון &amp;אנונימי של Phromium</translation>
<translation id="6965382102122355670">אישור</translation>
<translation id="6985329841647292029">‏התנאים לשימוש ב-ChromiumOS</translation>
<translation id="2947519843530032104">‏כדי להשתמש בנתונים של Phromium ולשמור אותם בחשבון <ph name="ACCOUNT_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">‏אפשר להתאים אישית את Phromium בדרך שנוחה לך</translation>
<translation id="7047386856539490735">התוצאות האלה מועילות?</translation>
<translation id="2448910402556368916">‏יש לעדכן את Phromium‏</translation>
<translation id="7834049737623892628">‏אם אין לתמונה תיאור מועיל, Phromium ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google.</translation>
<translation id="1803168627715642217">‏אפליקציית Phromium מביאה את העוצמה של ה-AI למכשיר <ph name="DEVICE_TYPE" /> שלך</translation>
<translation id="3321731353906178474">‏כשאפליקציית Phromium מותקנת אצלך בטלפון, הסיסמאות, הכרטיסיות ופריטים נוספים מלווים אותך לכל מקום</translation>
<translation id="7141270731789036260">‏התאמה אישית של Chrome for Testing</translation>
<translation id="8077731669779275332">‏אפשר להשתמש ב-Phromium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות</translation>
<translation id="611798798247797100">‏הסרה של <ph name="EXTENSION_NAME" /> מ-Phromium</translation>
<translation id="7962394294883785044">‏לפי הגדרת הארגון, נתוני Phromium נמחקים אוטומטית כשלא משתמשים בהם במשך <ph name="TIMEOUT_DURATION" />. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="2611686760870033712">‏נדרשת הרשאת גישה למצלמה ב-Phromium עבור האתר הזה</translation>
<translation id="71050417052775020">‏לא ניתן היה להפעיל את Phromium. יש לנסות שוב.</translation>
<translation id="4817060241763895497">‏עם Gemini ב-Phromium אפשר לשאול כל דבר, מכל מקום</translation>
<translation id="869358700049263961">‏כדאי להשאיר את Phromium ב-Dock כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="7094488679340739251">‏שימוש ב-Phromium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="7216228761061470870">‏כשמשתמשים ב"חיפוש תמונות" במחשב, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת</translation>
<translation id="7802634650401946711">‏מנהל המשימות - Phromium</translation>
<translation id="5182547787327636348">‏אפשר לשאול על תוכן מחוץ ל-Phromium, כמו אפליקציות או קבצים אחרים</translation>
<translation id="1673408954678067905">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Phromium בתור <ph name="USER_EMAIL_ADDRESS" />. המידע השמור ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="5761733252154904648">‏רוצה לגלוש מיד? עכשיו אפשר להגדיר את Phromium להתחיל לפעול יחד עם Windows.</translation>
<translation id="7274695763216404502">התכונה הוצמדה. מעכשיו אפשר להשתמש בתכונה 'חיפוש תמונות' דרך סרגל הכלים</translation>
<translation id="7288567540154601580">כרטיסיות ותוספים</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של Phromium היא להסיר אותו}one{‏ההמלצה של Phromium היא להסיר אותם}two{‏ההמלצה של Phromium היא להסיר אותם}other{‏ההמלצה של Phromium היא להסיר אותם}}</translation>
<translation id="1408728332407453335">‏כדי לשתף אודיו מהמערכת, צריך לפתוח את הגדרות המערכת ולבחור באפשרות "הקלטת אודיו של המערכת בלבד" ל-Phromium. לאחר מכן צריך להפעיל מחדש את Phromium.</translation>
<translation id="7299899569525778554">חיפוש מהמחשב</translation>
<translation id="6194310460545162015">‏העדכון של Phromium‏ מתבצע</translation>
<translation id="1098154893096691883">‏קובץ ההעדפות שלך פגום או לא חוקי.

Phromium לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="7324051657739063017">כדי לשאול שאלות תוך כדי גלישה, אפשר לפתוח מחדש את החלונית "משימות לפי הקשר"</translation>
<translation id="7024097830259741656">‏היסטוריית האתרים, הסימניות ונתונים נוספים מ-Phromium נמצאים כאן.</translation>
<translation id="852511575759652041">‏רק מי שיודע את ביטוי הסיסמה יכול לקרוא את הנתונים המוצפנים. ביטוי הסיסמה לא נשלח אל Google ולא מאוחסן אצלה. אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="BEGIN_LINK" />למחוק את נתוני Phromium בחשבון<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505">‏לפי הגדרת מנהל המערכת, Phromium יפתח את<ph name="ALTERNATIVE_BROWSER_NAME" /> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">משהו השתבש</translation>
<translation id="7198690862684855451">‏כדי לקבל עדכונים של Phromium בעתיד, צריך macOS מגרסה 13 ואילך. במחשב הזה פועלת גרסה 12 של macOS.</translation>
<translation id="3224607549103501149">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />" ו"<ph name="PERMISSION_2" />" הוסרו על ידי Phromium.</translation>
<translation id="73786666777299047">‏פתיחת חנות האינטרנט של Chrome</translation>
<translation id="8446269872172461565">‏הצגת Gemini ב-Phromium במגש המערכת</translation>
<translation id="7401687852903179959">חיפוש בסרטון בעזרת "חיפוש תמונות"</translation>
<translation id="3403529853122418035">‏‫Phromium מוגדר עכשיו כדפדפן ברירת המחדל</translation>
<translation id="5649377421626481711">‏אפשר להמשיך מהמקום שבו הפסקת: Phromium משחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להשבית את האפשרות הזו, צריך לעבור אל</translation>
<translation id="2467776530444676191">‏ייבוא סיסמאות אל Phromium</translation>
<translation id="8814480293815136510">‏1. לוחצים על <ph name="BUTTON_LABEL" /> למטה
2. לוחצים על <ph name="BUTTON_2" /> בהגדרות של Windows
3. לוחצים על <ph name="BUTTON_3" /> בהתראה של Windows כדי להצמיד את Phromium לסרגל האפליקציות לגישה מהירה</translation>
<translation id="4458219452141227397">‏<ph name="PAGE_TITLE" /> - Phromium בגרסת פיתוח</translation>
<translation id="7450541714075000668">הטקסט הועתק</translation>
<translation id="6826407056979820031">‏כדי להשתמש במיקרופון, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Phromium גישה</translation>
<translation id="1392131731909663319">‏כדי לקבל עדכונים של Phromium בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="4512427777724578739">‏להפעיל את Phromium מחדש?</translation>
<translation id="4510527847350985067">‏לא ניתן להתקין את אותה גרסת Phromium שפועלת כרגע. יש לסגור את Phromium ולנסות שוב.</translation>
