<translation id="919456815618829047">‏החשבון של <ph name="EXISTING_USER" /> כבר מחובר. כדי לשמור על סביבת גלישה נפרדת, אפשר להיכנס ל-Phromium בפרופיל נפרד בתור <ph name="USER_EMAIL_ADDRESS" />. אפשר לקבל גם את רשימת הקריאה ופריטים נוספים ממכשיר <ph name="DEVICE" />.</translation>
<translation id="6141754610526066487">‏פרופילים אחרים ב-Phromium</translation>
<translation id="2380720899384114679">‏תוספים הם רכיבים נוספים שמאפשרים לך להתאים אישית את Phromium. תוספים עוזרים לך להתאים את Phromium לצרכים שלך, בין אם זה לשמור על הסדר או לפשט משימות יומיומיות.</translation>
<translation id="2507281899032275020">‏עזרה בשיפור Phromium על ידי שליחת <ph name="UMA_LINK" /> ודוחות קריסה אל Google</translation>
<translation id="1514966729948178660">‏עם אפליקציית Phromium אפשר ליהנות מתכונות הבטיחות של Google בכל מקום</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{‏תוסף אחד לפחות ל-Phromium ניגש להתקן USB אחד}=1{‏תוסף אחד לפחות ל-Phromium ניגש להתקן USB אחד}one{‏תוסף אחד לפחות ל-Phromium ניגש ל-# התקני USB}two{‏תוסף אחד לפחות ל-Phromium ניגש ל-# התקני USB}other{‏תוסף אחד לפחות ל-Phromium ניגש ל-# התקני USB}}</translation>
<translation id="78720743239019396">‏כדי לקבל גישה לרשימת הקריאה ולנתונים נוספים מתוך <ph name="DEVICE" />, צריך להיכנס ל-Phromium</translation>
<translation id="7000206277447032115">‏ההיסטוריה ב-Phromium</translation>
<translation id="4555002192651219296">‏המתקין לא הצליח לבטל את דחיסת הארכיון. יש להוריד שוב את Phromium.</translation>
<translation id="310459126943037700">סיום המשימות נכשל.</translation>
<translation id="3104828284009500087">אפשר לחפש משהו בדף הזה</translation>
<translation id="4867557516756736957">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-Phromium.</translation>
<translation id="8632308594821621017">‏Phromium משתמש במיקרופון שלך.</translation>
<translation id="3130333203120345554">חיפוש חדש</translation>
<translation id="3137969841538672700">צריך לגרור כדי לחפש</translation>
<translation id="9173792796158381383">‏בכרטיסייה הזו נעשה שימוש במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-Phromium להשבית אותה.</translation>
<translation id="8874679893080632357">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-Phromium בקטע "הגדרות המערכת"</translation>
<translation id="101045618220347251">‏הפעלה מחדש של Phromium</translation>
<translation id="3161522574479303604">כל השפות</translation>
<translation id="5940989267583033306">‏פתיחת הקישור בחלון &amp;אנונימי של Phromium</translation>
<translation id="2045477525210426976">‏התאמה אישית של פרופיל Phromium החדש</translation>
<translation id="3540518135502114323">‏אפשר להמשיך להתכתב בצ'אט עם מצב AI בלי לעבור בין כרטיסיות. כדי להתחיל, עליך להיכנס לחשבון שלך ב-Phromium. אחרי הכניסה, הסיסמאות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="1496180326063744749">‏כדי להסיר את החשבון שלך ב-Google מ-Phromium, צריך לצאת מ-Phromium בדף ההגדרות</translation>
<translation id="7792783034323745412">‏בהמשך, תוצג לך שאלה ב-Phromium אם להשתמש במידע השמור כדי למלא בשבילך טפסים באופן אוטומטי</translation>
<translation id="5240091371721695404">‏Phromium אינו יכול לקרוא ולכתוב בספריית הנתונים שלו: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">‏עם Phromium ב-iOS, אפשר לקחת את הכלים שמבוססים על Google AI איתך לכל מקום.</translation>
<translation id="4848363951707149242">‏כדי לקבל גישה לתוספים ולנתונים נוספים מתוך <ph name="DEVICE" />, צריך להיכנס ל-Phromium</translation>
<translation id="3286538390144397061">הפעל מחדש כעת</translation>
<translation id="8613877111531019527">‏המפתחות של Google API חסרים. פונקציונליות מסוימת של Phromium תהיה מושבתת.</translation>
<translation id="2784090498377460662">‏המשך הפעלת יישומים ברקע כאשר Phromium סגור</translation>
<translation id="3905054486991167751">‏‫Phromium יתעדכן כשלא תהיה פעילות</translation>
<translation id="4502950976754616266">‏Phromium יציג אזהרה לפני טעינת אתר כלשהו באמצעות חיבור לא מאובטח</translation>
<translation id="6107453188231652861">‏אם סוגרים את כל החלונות של Phromium, מתבצעת יציאה מהחשבון ברוב האתרים, אבל לא מחשבון Google, אם נכנסת אליו ב-Phromium. כדי לאפשר לאתרים לזכור אותך, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">‏הפינה הימנית העליונה של אזור החיפוש: ‎<ph name="RIGHT" />%‎ מימין, ‎<ph name="TOP" />%‎ מלמעלה</translation>
<translation id="5896635343289575401">‏נתוני Phromium בחשבון שלך</translation>
<translation id="5662253013097242821">‏רוצה להשתמש בסיסמאות שלך ב-Phromium בטלפון?</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">‏לעבור לפרופיל קיים של Phromium?</translation>
<translation id="3412460710772753638">עדכון במנהל הסיסמאות במכשיר הזה</translation>
<translation id="657700335789940813">‏‫Phromium רוצה להתעדכן</translation>
<translation id="3487742274367151379">‏כדי לקבל גישה לסימניות ולנתונים נוספים מתוך <ph name="DEVICE" />, צריך להיכנס ל-Phromium</translation>
<translation id="3438772217992559640">חיפוש בכרטיסייה בעזרת "חיפוש תמונות"</translation>
<translation id="8062355070850891600">‏רוצה להרחיב את הגרסה המשופרת של גלישה בטוחה ב-Phromium בטלפון?</translation>
<translation id="5419337472918920970">‏‫Phromium מבצע התאמה אישית…</translation>
<translation id="6573105037542661278">‏פעולה זו תמחק <ph name="ITEMS_COUNT" /> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Phromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="4600986251755456192">‏ניתן לעבור בין פרופילים של Phromium באמצעות <ph name="SHORTCUT" /></translation>
<translation id="8118189978246431067">‏יש לסגור את כל חלונות Phromium ולנסות שוב.</translation>
<translation id="7430418346833889620">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-Phromium בקטע "הגדרות המערכת"</translation>
<translation id="2943929290955142701">‏כבר בוצעה כניסה לחשבון על ידי <ph name="EXISTING_USER" />.  כדי להפריד בין פעילויות הגלישה, עליך להיכנס ל-Phromium בפרופיל שלך עם האימייל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5896697187441340113">‏קוד QR להורדת הדפדפן Phromium למכשירים ניידים</translation>
<translation id="354621070532799440">‏תזכורת: תכונות הבטיחות הכי טובות של Google – אצלך בכיס</translation>
<translation id="6718500626359284607">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-Phromium בקטע "הגדרות המערכת".</translation>
<translation id="6511372913460632136">‏הפעלת ההגנה המשופרת משביתה את האופטימיזציה של JavaScript באתרים ש-Phromium לא מזהה</translation>
<translation id="3597003331831379823">הפעלת ההגדרה נכשלה עם הרשאות מורחבות. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">‏כניסה ל-Phromium</translation>
<translation id="8702816719621016911">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-Phromium בתור <ph name="USER_EMAIL" />.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{‏יש עדכון חדש בשביל Phromium והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש.}=1{‏יש עדכון חדש בשביל Phromium והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. החלון האנונימי לא ייפתח מחדש.}one{‏יש עדכון חדש בשביל Phromium והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏יש עדכון חדש בשביל Phromium והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏יש עדכון חדש בשביל Phromium והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="3667616615096815454">אין אפשרות להתקין, האפליקציה לא מוכרת לשרת.</translation>
<translation id="678730369472836428">‏שימוש ב<ph name="BEGIN_LINK" />ביטוי סיסמה משלך<ph name="END_LINK" /> כדי להצפין את כל נתוני Phromium בחשבון Google. אמצעי תשלום וכתובות שנשמרו ב-Google Pay לא יוצפנו. היסטוריית הגלישה ב-Phromium לא תסונכרן.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל את העדכון הזה}=1{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל את העדכון הזה. החלון האנונימי לא ייפתח מחדש.}one{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="2203303261468330007">‏פתיחת הקישור ב&amp;כרטיסיית Phromium חדשה</translation>
<translation id="686463893976008238">‏אפשר לקשר את Phromium לשירותי Google אחרים לצורך התאמה אישית ולמטרות אחרות</translation>
<translation id="3729187154190517324">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים באמצעות הכפתור "הוספת כרטיסייה ועוד".</translation>
<translation id="5596264049590907430">‏ניהול הפרופילים ב-Phromium</translation>
<translation id="5594723037153142396">‏למה הורדות מסוימות נחסמות ב-Phromium</translation>
<translation id="3425307214497790458">‏Phromium יעדכן אותך אם יש משהו שצריך לבדוק</translation>
<translation id="4247980944121268675">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Phromium טוענת מראש דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="3810973564298564668">ניהול</translation>
<translation id="1058395779823101457">‏כדי להשתמש בסיסמאות השמורות, צריך לסרוק את קוד ה-QR, להוריד את Phromium ל-iOS ולהיכנס לחשבון Google</translation>
<translation id="3846683726093018685">**סיכום:** במשפט אחד של פחות מ-30 מילים, צריך לתאר את הנושא והמטרה העיקריים של התוכן בצילום המסך.

          **הצעת שאלות:** יצירת רשימה של 3-5 שאלות מעוררות מחשבה שהמשתמש יכול לשאול כדי להבין טוב יותר את צילום המסך. לפחות שאלה אחת צריכה להתייחס באופן ספציפי לאובייקט חזותי, לעיצוב שלו או למיקום שלו.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">‏כדי לקבל גישה לסימניות ולנתונים נוספים בכל המכשירים שלך, צריך להיכנס ל-Phromium</translation>
<translation id="3885770153807205175">הכלי לבחירת שפה</translation>
<translation id="5947409614720749543">‏התאמה אישית וניהול של Phromium נחוצה פעולה שלך - יש ללחוץ לקבלת פרטים נוספים.</translation>
<translation id="2176348074240183776">‏יש ללחוץ על השם שלך כדי לפתוח את Phromium ולהתחיל לגלוש.</translation>
<translation id="3892148308691398805">העתקת הטקסט</translation>
<translation id="3679766722656346339">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל Phromium הזה. כדי להפריד בין פעילויות גלישה, Phromium יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="6085953975934135790">‏התוסף הזה מפר את המדיניות של חנות האינטרנט של Chrome, ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-Phromium כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="3941890832296813527">שגיאת התקנה: שם הקובץ של מנהל ההתקנה לא תקין או לא נתמך.</translation>
<translation id="608187946760434925">‏Phromium מנסה להעתיק את הסיסמאות. כדי לאפשר למערכת לעשות זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="3054592240125889472">‏כדי לקבל גישה למידע השמור ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-Phromium</translation>
<translation id="3140795250676341027">‏הסיסמאות, אמצעי התשלום והכתובות ששמרת בחשבון שלך ב-Google יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-Phromium, צריך להיכנס שוב לחשבון.</translation>
<translation id="395904275706073188">לא ניתן לקרוא דפים מוגנים. כדאי לנסות דף אחר.</translation>
<translation id="4227910144250222665">‏איך מערכת Phromium שומרת על האבטחה שלך</translation>
<translation id="3967822245660637423">ההורדה הושלמה</translation>
<translation id="4150430234581811723">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Phromium שולח את הטקסט הזה לכלי החיפוש, הבינה המלאכותית והסוכנים של הארגון כדי לקבל הצעות.</translation>
<translation id="3975724895399328945">‏מידע על &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">‏מידע על ChromiumOS</translation>
<translation id="4847805566397342820">‏כשמבקרים באתר מסוים, Phromium שולח ל<ph name="BEGIN_LINK" />גלישה בטוחה של Google<ph name="END_LINK" /> קטע קוד מעורפל מכתובת ה-URL דרך שרת פרטיות שמסתיר את כתובת ה-IP. אם האתר פועל באופן שמעורר חשד, יישלחו גם כתובות URL מלאות וקטעי תוכן מדפים.</translation>
<translation id="4016217212818346953">מנהל הסיסמאות עוזר לשמור על הבטיחות שלך</translation>
<translation id="4019629340646866719">‏השימוש ב-ChromiumOS מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS" />תוכנות קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספות כמו <ph name="BEGIN_LINK_LINUX_OSS" />סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">תרגום המסך</translation>
<translation id="4023601594785368013">שפה מקורית: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">‏אפשר לפתוח קישורים ב-Phromium מכל אפליקציה. בנוסף Phromium מוצמד לשורת המשימות לגישה נוחה.</translation>
<translation id="6916567874038032700">‏דיווח על <ph name="BEGIN_LINK" />ההגדרות הנוכחיות<ph name="END_LINK" /> יעזור לשפר את Phromium</translation>
<translation id="4050175100176540509">הגרסה החדשה כוללת שיפורי בטיחות חשובים ותכונות חדשות.</translation>
<translation id="4055805654398742145">מנהל הס&amp;יסמאות</translation>
