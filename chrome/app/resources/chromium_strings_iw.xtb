<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="1029669172902658969">‏הפעלה מחדש לצורך עדכון ‎&amp;ChromiumOS</translation>
<translation id="7962340570690354348">‏לפי המלצת Phromium, כדאי לבדוק את התוסף הזה</translation>
<translation id="2702007788032964762">‏כשאתר מבקש לטעון מראש קישורים בדף שלו באופן פרטי, מערכת Phromium משתמשת בשרתי Google. כך מוסתרת הזהות שלך מהאתר שנטען מראש, אבל Google יכולה לדעת אילו אתרים נטענים מראש.</translation>
<translation id="1051793555070215510">מילוי הסקר הזה ייקח רק דקה ויעזור לנו לשפר את המצב הפרטי.</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="4964836565882496625">‏ההורה שלך השבית ב-Phromium את ההגדרה 'הרשאות לאתרים, לאפליקציות ולתוספים'</translation>
<translation id="8409497136174302488">‏כדי ש-Phromium יוכל למצוא מכשירים קרובים ולהשתמש בהם, צריך לתת לו גישה לרשת המקומית</translation>
<translation id="4388904545107211948">‏כדי לחפש תכונה או תוסף ספציפיים של Phromium, אפשר להקליד את השם המקוצר שלהם בסרגל הכתובות ואז ללחוץ על מקש המקלדת שנבחר</translation>
<translation id="7188624550427159072">‏הצגת החיפוש באמצעות Phromium במגש המערכת והפעלת מקשי הקיצור</translation>
<translation id="3689248207461565136">‏Phromium רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="112640046208448578">אפשר לנסות לזהות דברים או מקומות ולהעתיק או לתרגם טקסטים. כשמשתמשים בחיפוש תמונות, צילום מסך של הדף נשלח לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">‏Phromium מוגדר כדפדפן ברירת המחדל</translation>
<translation id="5414044255592121327">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK" />יש להיכנס ל-Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">‏לוחצים על תפריט Phromium</translation>
<translation id="1157985233335035034">שפות אחרונות</translation>
<translation id="1184145431117212167">‏ההתקנה נכשלה כי הגרסה של Windows לא נתמכת.</translation>
<translation id="7861581212703831457">‏על Phromium</translation>
<translation id="8752630985505435738">‏רוצה לקבל התראות על מעקב מחירים באמצעות Phromium בטלפון?</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="4933432676089063712">‏יש <ph name="IMPORTANT_UPDATE" /> בהמתנה. כדי לשמור על בטיחות הגלישה, Phromium יתעדכן בפעם הבאה שלא תהיה פעילות במשך <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">‏כשפותחים את חיפוש התמונות, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים באופן אוטומטי לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">‏אחרי הכניסה לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Google ב-Phromium. כדי לשנות את האפשרות הזאת, כדאי לעבור אל "החשבון שלך ב-Phromium".</translation>
<translation id="7402478829083317456">‏הצגת Gemini ב-Phromium בסרגל התפריטים של Mac</translation>
<translation id="4902531791098430822">‏כדי לבחור חלק מהמסך ב-Gemini ב-Phromium צריך להשתמש במקש קיצור.</translation>
<translation id="9002284132405311162">‏בזמן שהכרטיסייה הזו לא הייתה פעילה, התפנה זיכרון כדי ש-Phromium ימשיך לפעול במהירות. ניתן לבחור להחריג תמיד את האתר הזה כדי שיישאר במצב פעיל.</translation>
<translation id="5561666811965903444">‏Phromium חסם את ההורדה הזאת כי הקובץ מסוכן</translation>
<translation id="1340271056805240721">‏כשנכנסים לשירותי Google כמו Gmail או YouTube עם <ph name="USER_EMAIL" />, אפשר להיכנס אוטומטית ל-Phromium עם אותו חשבון</translation>
<translation id="5048805453292757697">‏הורדת Phromium לטלפון</translation>
<translation id="1290883685122687410">שגיאה בהגדרה: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">‏הגדרת הפרופיל החדש שלך ב-Phromium</translation>
<translation id="7871721155662336863">‏כדאי לנסות את Gemini ב-Phromium</translation>
<translation id="6569288432960798043">‏ל-Phromium נדרשת גישה ל-Bluetooth כדי למצוא
 מכשירי Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">‏כניסה ל-Phromium בטלפון</translation>
<translation id="1330562121671411446">זיהוי שפה אוטומטי</translation>
<translation id="1619655755195586133">‏אני רוצה למחוק את הנתונים גם מ-Phromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">התכונה הוצמדה. מעכשיו אפשר לגשת לחיפוש התמונות דרך הכפתור החדש בסרגל הכלים</translation>
<translation id="1383876407941801731">חיפוש</translation>
<translation id="2947996037737257951">‏עם אפליקציית Phromium אפשר להמשיך לגלוש בכל מקום</translation>
<translation id="141901961143729572">כאן אפשר לשתף את המחשבות שלך</translation>
<translation id="8355386219605656974">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-Phromium בקטע "הגדרות המערכת".</translation>
<translation id="1478370723027452770">‏קבלת עזרה לגבי Chrome for Testing</translation>
<translation id="8398257182826094665">‏כדי לקבל גישה למידע השמור ולנתונים נוספים מתוך <ph name="DEVICE" />, צריך להיכנס ל-Phromium</translation>
<translation id="1497802159252041924">שגיאת התקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">הדף הזה מוגן</translation>
<translation id="3484755999946650557">‏שיתוף כרטיסיית Phromium</translation>
<translation id="3309377459597801353">‏כניסה ל-Phromium</translation>
<translation id="1547469039832541117">סיום המשימה המודגשת.</translation>
<translation id="2354363290397602683">‏הצמדת Phromium</translation>
<translation id="2244728813494358888">‏הכלים לבטיחות של Phromium</translation>
<translation id="707582364915018531">‏‫Phromium רוצה למחוק את הנתונים שלך במנהל הסיסמאות. כדי לאפשר זאת, צריך להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל עדכון}=1{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל עדכון. החלון האנונימי לא ייפתח מחדש.}one{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏מנהל המערכת מבקש להפעיל מחדש את Phromium כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="5032531544901236587">‏מיטב הטכנולוגיות של Google אצלך בידיים עם אפליקציית Phromium לטלפון</translation>
<translation id="7311082384439462587">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-Phromium</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="1665602916345474427">נכנסת בתור <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, עם מינוי. פתיחת תפריט החשבון</translation>
<translation id="4535436467771816034">‏אפשר להשתמש ב-Phromium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות. הדפדפן גם יוצמד לסרגל האפליקציות.</translation>
<translation id="1709772298389099340">השירות הזה מספק הרשאות מורחבות ל-<ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">כך תהיה לך אפשרות לבחור מבין המכשירים הזמינים ולהציג בהם תוכן.</translation>
<translation id="3550860956769006392">‏נתוני הגלישה ב-Phromium יימחקו בקרוב</translation>
<translation id="2053384509423635834">‏Phromium ינסה לשדרג את הניווטים ל-HTTPS</translation>
<translation id="2516115567501600458">‏נתוני Phromium נמחקו</translation>
<translation id="8571959122390670188">‏Phromium יופעל מחדש בעוד <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">‏כש-HTTPS לא יהיה זמין, Phromium ישתמש בחיבור לא מאובטח בלי להציג אזהרה</translation>
<translation id="5872244334553252095">‏התרה ל-Phromium לפעול ברקע</translation>
<translation id="2213761221916953829">‏כדי לשפר את האבטחה של Phromium, השבתנו חלק מהתוספים שלא רשומים ב<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוספו ללא ידיעתך.</translation>
<translation id="8807881428325438878">‏כדי להצמיד את Phromium לסרגל האפליקציות לגישה מהירה, צריך ללחוץ על <ph name="BEGIN_BOLD" />כן<ph name="END_BOLD" /> בהתראה של Windows.</translation>
<translation id="6861833596843600606">‏התקנת Phromium מחדש</translation>
<translation id="3950056404221550225">‏Phromium מנסה <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950">‏החשבון של <ph name="EXISTING_USER" /> כבר מחובר. כדי לשמור על סביבת גלישה נפרדת, אפשר להיכנס ל-Phromium בפרופיל נפרד בתור <ph name="USER_EMAIL_ADDRESS" />. אפשר לקבל גם את התוספים ופריטים נוספים ממכשיר <ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">‏בפעם הבאה ש-Phromium ייפתח במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להשתמש במנהל הסיסמאות של Google.</translation>
<translation id="1838374766361614909">ניקוי חיפוש</translation>
<translation id="2724678689951174927">‏כדי למחוק את נתוני הגלישה מהמכשיר הזה בלבד ועדיין לשמור אותם בחשבון שלך ב-Google, <ph name="BEGIN_LINK" />עליך לצאת מהחשבון ב-Phromium<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">‏כדי לפתוח או ליצור קבוצות חדשות של כרטיסיות תוך כדי תנועה, כדאי להוריד את Phromium לטלפון שלך.</translation>
<translation id="3191814926523151519">‏יש לך אפשרות לנהל את חשבונות Google שאליהם נכנסת. כדי ליהנות מחיבור לחשבון בדפדפן Phromium, בחנות Play, ב-‏Gmail ובשירותים נוספים, עליך להיכנס עם חשבונות Google שלך. כדי להוסיף חשבון של מישהו אחר, כמו חבר/ה בקבוצה המשפחתית, יש להוסיף משתמש חדש ל-<ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />מידע נוסף<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">חיפוש באמצעות התכונה 'חיפוש תמונות'</translation>
<translation id="5453573140402957471">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Phromium בתור <ph name="USER_EMAIL_ADDRESS" />. הסימניות ופריטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">בחירת טקסט</translation>
<translation id="1236934630660512644">‏נכנסת עם חשבון מנוהל שנותן למנהל המערכת שלו שליטה על הפרופיל שלך ב-Phromium. הנתונים שלך ב-Phromium, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Google, אבל אי אפשר לשייך את הנתונים האלה לחשבון אחר. לחלופין, באפשרותך ליצור פרופיל חדש כדי לשמור את הנתונים הקיימים שלך ב-Phromium בנפרד.<ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">‏‫Phromium חוסך בחיי הסוללה על ידי הגבלת הפעילות ברקע והאפקטים החזותיים, כמו גלילה חלקה וקצב פריימים של סרטונים. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון באנרגיה<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">‏שירות לעדכון של Phromium</translation>
<translation id="5797624919204275541">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי Google, כמו Gmail, בלי להיכנס אל Phromium</translation>
<translation id="6850971726764387814">‏Phromium אינו מגיב. להפעיל מחדש עכשיו?</translation>
<translation id="8289779763124483945">‏לפי דרישת הארגון שלך, <ph name="MANAGER" />, עליך להיכנס לחשבון ב-Phromium</translation>
<translation id="193439633299369377">‏צריך להפעיל מחדש את ChromiumOS כדי להחיל את העדכון הזה.</translation>
<translation id="3215238748514810076">‏Phromium חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים מהסוג הזה ויכול להיות שהקובץ מסוכן</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE" /> דק'</translation>
<translation id="8529252122707161160">‏ב-Phromium לא ניתן לקבוע או להגדיר את דפדפן ברירת המחדל</translation>
<translation id="197326043290947695">גלישה חכמה יותר עם "חיפוש תמונות"</translation>
<translation id="7769772561254542263">‏מידע על חסימה של קבצים מסוימים ב-Phromium, נפתח בכרטיסייה חדשה</translation>
<translation id="3713013456746186442">‏השירות הזה שומר על תוכנת Phromium עדכנית. אם השירות הזה מושבת או מופסק, תוכנת Phromium לא תתעדכן באופן קבוע. כתוצאה מכך, לא ניתן יהיה לתקן פרצות אבטחה שעלולות להיווצר, וייתכן שחלק מהתכונות לא יפעלו. השירות הזה יוסר באופן אוטומטי אם אין תוכנת Phromium שמשתמשת בו.</translation>
<translation id="5690439379999550641">‏הפעולה הזו תמחק פריט אחד מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, היכנס אל Phromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="2039417478970545937">הגדרות.</translation>
<translation id="4765042254400173473">‏בוחרים אם לכלול את ההיסטוריה ב-Phromium להתאמה אישית מדויקת יותר בשירותי Google</translation>
<translation id="1448229429009113044">‏מנהל הסיסמאות מובנה ב-Phromium ומאפשר לך ליצור סיסמאות חזקות, לשמור אותן ולמלא אותן אוטומטית. כדי להגיע אליו בקלות, אפשר להוסיף את קיצור הדרך.</translation>
<translation id="2145664943269651168">‏אפשר ללחוץ על הכפתור "התאמה אישית של Phromium" בדף הכרטיסייה החדשה כדי לשנות את המראה שלו</translation>
<translation id="6052463185672312901">‏Phromium חסם את ההורדה הזאת כי הקובץ מטעה ועשוי לבצע שינויים לא צפויים במכשיר שלך</translation>
<translation id="3825064703718009924">‏בפעם הבאה ש-Phromium ייפתח ב-iOS, תופיע הנחיה לנסות את <ph name="FEATURE_NAME" />.</translation>
<translation id="886729435477608858">‏הסיסמאות ונתונים אחרים מ-Phromium ששמרת בחשבון שלך ב-Google יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-Phromium, צריך להיכנס בחזרה לחשבון.</translation>
