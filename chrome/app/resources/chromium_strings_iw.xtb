<translation id="7245201002247176127">‏העדכון כמעט הושלם! הפעל מחדש את Phromium‏ כדי לסיים את העדכון.</translation>
<translation id="8846891938874485868">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Phromium, אבל Phromium יהיה קצת פחות עמיד בפני מתקפות.</translation>
<translation id="7525500996671436081">‏פתיחת החיפוש באמצעות Phromium</translation>
<translation id="1224842000407297331">‏פרופיל Phromium</translation>
<translation id="4956303519269880412">‏אזהרה: Phromium לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב אנונימי, צריך לבטל את הבחירה של האפשרות הזו.</translation>
<translation id="2708255035805733225">‏אם בנוסף ישותפו דוחות שימוש ב-Phromium, הדוחות האלה יכללו את כתובות ה-URL שבהן ביקרת</translation>
<translation id="4673710618874938871">נכנסת בתור <ph name="USER_NAME" />, עם מינוי. פתיחת תפריט החשבון</translation>
<translation id="1883292567514549610">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך Phromium אחר (<ph name="PROCESS_ID" />) במחשב אחר (<ph name="HOST_NAME" />)‏. Phromium נעל את הפרופיל כדי שלא ייפגם. אם וידאת שאף תהליך אחר אינו משתמש בפרופיל זה, אפשר את נעילת הפרופיל ולהפעיל את Phromium מחדש.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="1889305042180577023">‏חלק מהנתונים ב-Phromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="8079525505870459051">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Google ב-Phromium. אפשר לשנות את ההגדרות של שירותי Google באמצעות קיצור הדרך <ph name="SHORTCUT" />.</translation>
<translation id="2171507067211697961">‏מישהו נכנס בעבר ל-Phromium מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST" />. יש ליצור משתמש חדש ל-Phromium כדי לשמור על פרטיות המידע שלך.</translation>
<translation id="4724676981607797757">ההתקנה נכשלה בגלל שגיאת פרוטוקול שלא נתמך.</translation>
<translation id="6925701206088903005">‏לסגור את Phromium בכל זאת?</translation>
<translation id="4514755609496543621">‏בוצע עדכון אבטחה מיוחד של Phromium. עכשיו עליך להפעיל מחדש ואנחנו נשחזר את הכרטיסיות.</translation>
<translation id="8673673368917636496">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />" ועוד <ph name="COUNT" /> הרשאות הוסרו על ידי Phromium.</translation>
<translation id="3638319732826965647">‏אם Gemini פתוח ב-Phromium, החלונית הצדדית נשארת פתוחה כשיוצרים כרטיסיות חדשות</translation>
<translation id="479167709087336770">‏נעשה כאן שימוש בבדיקת האיות של חיפוש Google. הטקסט המוקלד בדפדפן נשלח אל Google. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="2659245507243672392">‏שימוש ב-Phromium ללא חשבון</translation>
<translation id="166411027652942990">‏כלל נכנס עבור Phromium על מנת לאפשר תנועת mDNS.</translation>
<translation id="6031862420354068813">‏הפעלה מחדש לצורך עדכון &amp;Phromium</translation>
<translation id="4918086044614829423">אישור</translation>
<translation id="4918844574251943176">התמונה הועתקה</translation>
<translation id="1531905832227009774">‏כדי לקבל גישה לרשימת הקריאה ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-Phromium</translation>
<translation id="4319892378006430019">‏Phromium נמצא במצב רקע.</translation>
<translation id="8972359100025490790">‏אפשר ללחוץ כדי לסגור את תיבת הדו-שיח של הכניסה ל-Phromium</translation>
<translation id="3639078149590125530">‏באמצעות פרופילים ב-Phromium, אפשר להפריד את כל הפריטים ב-Phromium. אפשר ליצור פרופילים שמיועדים לחברים ולבני משפחה או פרופילים נפרדים לעבודה ולבילויים בשעות הפנאי.</translation>
<translation id="7141327976224964788">‏אורחים יכולים להשתמש ב-Phromium בלי להשאיר דבר מאחור.</translation>
