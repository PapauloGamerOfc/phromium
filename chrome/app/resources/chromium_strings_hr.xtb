<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="1026101648481255140">Nastavi instaliranje</translation>
<translation id="1029669172902658969">Ponovo pokrenite da biste ažurirali &amp;Chromium OS</translation>
<translation id="7962340570690354348">Phromium preporučuje da pregledate ovo proširenje</translation>
<translation id="2702007788032964762">Kad web-lokacija zatraži privatno predučitavanje veza na stranici, Phromium upotrebljava Googleove poslužitelje. Na taj se način vaš identitet sakriva od predučitane web-lokacije, ali Google saznaje koje se web-lokacije predučitavaju.</translation>
<translation id="1051793555070215510">Pomozite nam da poboljšamo anonimni način rada ispunjavanjem ove jednominutne ankete.</translation>
<translation id="1065672644894730302">Vaše postavke nije moguće čitati. Neke značajke možda nisu dostupne i promjene postavki neće biti spremljene.</translation>
<translation id="4964836565882496625">Tvoj je roditelj isključio "Dopuštenja za web-lokacije, aplikacije i proširenja" za Phromium</translation>
<translation id="8409497136174302488">Phromium treba pristup vašoj lokalnoj mreži da bi otkrio i upotrebljavao uređaje u blizini</translation>
<translation id="4388904545107211948">Da biste pretražili određenu Chromiumovu značajku ili proširenje, u adresnu traku unesite njegov prečac, a zatim odabranu tipku na tipkovnici</translation>
<translation id="7188624550427159072">Prikaži pretraživanje s Chromiumom na traci sustava i uključi tipkovni prečac</translation>
<translation id="3689248207461565136">Phromium želi izvesti vaše zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="112640046208448578">Identificirajte stvari ili mjesta i kopirajte ili prevedite tekst. Kad upotrebljavate pretraživanje slika, snimka zaslona stranice šalje se poslužitelju. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium je vaš zadani preglednik</translation>
<translation id="5414044255592121327">Da biste provjerili jesu li vaše zaporke sigurne od povrede podataka i drugih poteškoća sa sigurnošću, <ph name="BEGIN_LINK" />prijavite se na Phromium<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Kliknite Chromiumov izbornik</translation>
<translation id="1157985233335035034">Nedavni jezici</translation>
<translation id="1184145431117212167">Instaliranje nije uspjelo jer vaša verzija Windowsa nije podržana.</translation>
<translation id="7861581212703831457">O pregledniku Phromium</translation>
<translation id="8752630985505435738">Primajte upozorenja o praćenju cijena uz Phromium na telefonu</translation>
<translation id="1203500561924088507">Zahvaljujemo što ste izvršili instaliranje. Da biste mogli koristiti <ph name="BUNDLE_NAME" />, morate ponovno pokrenuti preglednik.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> je na čekanju. Da bi vaše pregledavanje ostalo sigurno, Phromium će se ažurirati sljedeći put kad ne budete aktivni <ph name="IDLE_DURATION" />.</translation>
<translation id="1232234696885483911">Kad otvorite pretraživanje slika, naslov, URL i sadržaj stranice, uključujući PDF-ove, automatski će se poslati poslužitelju. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">Dok ste prijavljeni, možete koristiti svoje zaporke i još mnogo toga sa svojeg Google računa u Chromiumu. Da biste to promijenili, idite na Vaš račun u Chromiumu.</translation>
<translation id="7402478829083317456">Prikaži Gemini u Chromiumu na traci izbornika Maca</translation>
<translation id="4902531791098430822">Da biste odabrali dio zaslona u Geminiju u Chromiumu, upotrijebite tipkovni prečac.</translation>
<translation id="9002284132405311162">Dok je ova kartica bila neaktivna, memorija je oslobođena kako bi Phromium ostao brz. Možete odabrati da ta web-lokacija uvijek bude neaktivna.</translation>
<translation id="5561666811965903444">Phromium je blokirao ovo preuzimanje jer je datoteka opasna</translation>
<translation id="1340271056805240721">Kad se na Googleove usluge kao što su Gmail ili YouTube prijavljujete pomoću računa <ph name="USER_EMAIL" />, možete se automatski prijaviti u Phromium istim računom</translation>
<translation id="5048805453292757697">Preuzmite Phromium na telefon</translation>
<translation id="1290883685122687410">Pogreška pri postavljanju: <ph name="METAINSTALLER_EXIT_CODE" /> <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">Postavite novi profil u Chromiumu</translation>
<translation id="7871721155662336863">Isprobajte s Geminijem u Chromiumu</translation>
<translation id="6569288432960798043">Phromium treba pristup Bluetoothu kako bi pronašao
 Bluetooth uređaje. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" />.</translation>
<translation id="3232647214432653255">Prijavite se na Phromium na telefonu</translation>
<translation id="1330562121671411446">Prepoznaj jezik</translation>
<translation id="1619655755195586133">Izbriši i podatke s Chromiuma (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Prikvačeno! Pretraživanju slika možete ponovo pristupiti pomoću novog gumba na alatnoj traci</translation>
<translation id="1383876407941801731">Traži</translation>
<translation id="2947996037737257951">Preuzmite aplikaciju Phromium da biste nastavili pregledavati u pokretu</translation>
<translation id="141901961143729572">Podijelite svoje misli</translation>
<translation id="8355386219605656974">Da biste dijelili prozor, u postavkama sustava dopustite snimanje zaslona za Phromium.</translation>
<translation id="1478370723027452770">Zatražite pomoć za Chrome for Testing</translation>
<translation id="8398257182826094665">Da biste mogli pristupati svojim spremljenim podacima i drugim podacima s računa <ph name="DEVICE" />, prijavite se u Phromium</translation>
<translation id="1497802159252041924">Instalacijska pogreška: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Ova je stranica zaštićena</translation>
<translation id="3484755999946650557">Dijeljenje kartice Phromium</translation>
<translation id="3309377459597801353">Prijava na Phromium</translation>
<translation id="1547469039832541117">Završava istaknut zadatak.</translation>
<translation id="2354363290397602683">Prikvači Phromium</translation>
<translation id="2244728813494358888">Chromiumovi sigurnosni alati</translation>
<translation id="707582364915018531">Phromium želi izbrisati vaše podatke Upravitelja zaporki. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{Vaš administrator zahtijeva da ponovno pokrenete Phromium radi primjene ažuriranja}=1{Vaš administrator zahtijeva da ponovno pokrenete Phromium radi primjene ažuriranja. Anonimni se prozor neće ponovno otvoriti.}one{Vaš administrator zahtijeva da ponovno pokrenete Phromium radi primjene ažuriranja. Vaš # anonimni prozor neće se ponovno otvoriti.}few{Vaš administrator zahtijeva da ponovno pokrenete Phromium radi primjene ažuriranja. Vaša # anonimna prozora neće se ponovno otvoriti.}other{Vaš administrator zahtijeva da ponovno pokrenete Phromium radi primjene ažuriranja. Vaših # anonimnih prozora neće se ponovno otvoriti.}}</translation>
<translation id="5032531544901236587">Iskoristite sve prednosti Googlea uz aplikaciju Phromium na telefonu</translation>
<translation id="7311082384439462587">Pregledajte ključne kontrole privatnosti i sigurnosti u Chromiumu</translation>
<translation id="1640672724030957280">Preuzimanje...</translation>
<translation id="1665602916345474427">Prijavljeni ste kao <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, s pretplatom. Otvori izbornik računa</translation>
<translation id="4535436467771816034">Phromium možete upotrebljavati svaki put kad kliknete veze u porukama, dokumentima i drugim aplikacijama. Prikvačit će se i na traku sa zadacima.</translation>
<translation id="1709772298389099340">Pruža dodatne ovlasti za <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">To će vam omogućiti odabir između dostupnih uređaja i prikaz sadržaja na njima.</translation>
<translation id="3550860956769006392">Phromium će uskoro izbrisati podatke o pregledavanju</translation>
<translation id="2053384509423635834">Phromium će pokušati nadograditi kretanja na HTTPS</translation>
<translation id="2516115567501600458">Podaci Chromiuma izbrisani su</translation>
<translation id="8571959122390670188">Phromium će se ponovo pokrenuti za <ph name="REMAINING_TIME" /></translation>
<translation id="6284080675125981628">Kad HTTPS nije dostupan, Phromium će upotrebljavati nesigurnu vezu bez upozorenja</translation>
<translation id="5872244334553252095">Neka Phromium radi u pozadini</translation>
<translation id="2213761221916953829">Kako bismo Phromium učinili sigurnijim, onemogućili smo neka proširenja koja nisu navedena u trgovini <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> i možda su dodana bez vašeg znanja.</translation>
<translation id="8807881428325438878">Kliknite <ph name="BEGIN_BOLD" />Da<ph name="END_BOLD" /> u obavijesti Windowsa da biste prikvačili Phromium na traku sa zadacima radi brzog pristupa.</translation>
<translation id="6861833596843600606">Ponovo instaliraj Phromium</translation>
<translation id="3950056404221550225">Phromium pokušava sljedeće: <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> već je prijavljen/a. Da bi vaše pregledavanje ostalo odvojeno, prijavite se na Phromium na svojem profilu kao <ph name="USER_EMAIL_ADDRESS" />. Moći ćete pristupati svojim proširenjima i drugim podacima s uređaja <ph name="DEVICE" />.</translation>
<translation id="6114726049187747242">Sljedeći put kad otvorite Phromium na uređaju <ph name="DEVICE_TYPE" />, prikazat će vam se upit za upotrebu Googleovog upravitelja zaporki.</translation>
<translation id="1838374766361614909">Brisanje pretraživanja</translation>
<translation id="2724678689951174927">Da biste podatke o pregledavanju izbrisali samo s ovog uređaja, a zadržali ih na svojem Google računu, <ph name="BEGIN_LINK" />odjavite se iz Chromiuma<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">Preuzmite Phromium na telefon da biste otvarali ili izrađivali nove grupe kartica u pokretu.</translation>
<translation id="3191814926523151519">Možete upravljati Google računima na koje ste prijavljeni. Vaši Google računi koriste se za preglednik Phromium, Trgovinu Play, Gmail i brojne druge usluge. Ako želite dodati račun za nekog drugog, na primjer člana obitelji, dodajte novu osobu na uređaj <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Saznajte više<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Pretražite pomoću pretraživanja slika</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> već je prijavljen/a. Da bi vaše pregledavanje ostalo odvojeno, prijavite se na Phromium na svojem profilu kao <ph name="USER_EMAIL_ADDRESS" />. Dobit ćete i svoje oznake i druge podatke s računa <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Odaberite tekst</translation>
<translation id="1236934630660512644">Prijavljujete se upravljanim računom i dajete administratoru kontrolu nad svojim profilom u sustavu Phromium. Vaši podaci u sustavu Phromium, primjerice, aplikacije, oznake, povijest, zaporke i ostale postavke, trajno će se povezati s korisnikom <ph name="USER_NAME" />. Moći ćete izbrisati te podatke putem Nadzorne ploče Google računa, ali ih nećete moći povezati s nekim drugim računom. Ako želite, možete izraditi novi profil kako biste zadržali postojeće podatke u sustavu Phromium zasebno. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium štedi bateriju ograničavajući pozadinsku aktivnost i vizualne efekte, kao što je glatko pomicanje i broj sličica u sekundi videozapisa. <ph name="BEGIN_LINK" />Saznajte više o štednji energije<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium Updater Service</translation>
<translation id="5797624919204275541">Ako isključite tu opciju, možete se prijaviti na Googleove web-lokacije kao što je Gmail bez prijavljivanja u Phromium</translation>
<translation id="6850971726764387814">Phromium ne reagira. Ponovo pokrenuti sada?</translation>
<translation id="8289779763124483945">Vaša organizacija <ph name="MANAGER" /> zahtijeva da se prijavite u Phromium</translation>
<translation id="193439633299369377">Potrebno je ponovo pokrenuti Chromium OS kako bi se ažuriranje primijenilo.</translation>
<translation id="3215238748514810076">Phromium je blokirao ovo preuzimanje jer se ova vrsta datoteke obično ne preuzima i mogla bi biti opasna</translation>
<translation id="1953553007165777902">Preuzimanje... Još <ph name="MINUTE" /> min</translation>
<translation id="8529252122707161160">Phromium ne može utvrditi niti postaviti zadani preglednik</translation>
<translation id="197326043290947695">Pametnije pregledavajte uz pretraživanje slika</translation>
<translation id="7769772561254542263">Saznajte zašto Phromium blokira neke datoteke, otvara se u novoj kartici</translation>
<translation id="3713013456746186442">Održava Chromiumov softver ažurnim. Ako se ta usluga onemogući ili zaustavi, Chromiumov softver neće se ažurirati, što znači da se mogu pojaviti sigurnosne ranjivosti koje se neće moći popraviti, pa značajke možda neće funkcionirati. Ova se usluga sama deinstalira kada ne postoji Chromiumov softver koji je koristi.</translation>
<translation id="5690439379999550641">Time će se izbrisati jedna stavka s uređaja. Da biste kasnije dohvatili svoje podatke, prijavite se na Phromium kao <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instaliranje nije uspjelo. Pokušajte ponovo.</translation>
<translation id="2039417478970545937">Postavke.</translation>
<translation id="4765042254400173473">Odaberite želite li uključiti povijest na Chromiumu za prilagođenije doživljaje na Googleovim uslugama</translation>
<translation id="1448229429009113044">Ugrađen u Phromium kako bi vam pomogao u izradi, spremanju i automatskom popunjavaju snažnih zaporki. Dodajte prečac za jednostavan pristup.</translation>
<translation id="2145664943269651168">Kliknite gumb Prilagodi Phromium na stranici Nova kartica da biste Chromiumu dali novi izgled</translation>
<translation id="6052463185672312901">Phromium je blokirao ovo preuzimanje jer je ova datoteka obmanjujuća i može napraviti neočekivane promjene na vašem uređaju</translation>
<translation id="3825064703718009924">Sljedeći put kad otvorite Phromium iOS, prikazat će vam se upit da isprobate značajku <ph name="FEATURE_NAME" />.</translation>
<translation id="886729435477608858">Vaše zaporke i drugi podaci iz Chromiuma koje ste spremili na Google račun uklonit će se s ovog uređaja. Da biste ih ponovo upotrebljavali u Chromiumu, ponovo se prijavite.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Vaša organizacija automatski briše podatke o pregledavanju kada se Phromium ne koristi jednu minutu. To može uključivati povijest, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}one{Vaša organizacija automatski briše podatke o pregledavanju kada se Phromium ne koristi # minutu. To može uključivati povijest, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}few{Vaša organizacija automatski briše podatke o pregledavanju kada se Phromium ne koristi # minute. To može uključivati povijest, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}other{Vaša organizacija automatski briše podatke o pregledavanju kada se Phromium ne koristi # minuta. To može uključivati povijest, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}}</translation>
<translation id="2125838419757773031">Odaberite dio zaslona za pretraživanje</translation>
<translation id="2126108037660393668">Preuzeta datoteka nije zadovoljila provjeru.</translation>
<translation id="2135919691573380097">Prijavite tu web-lokaciju</translation>
<translation id="2137162749895930932">Zatvorite zaslon za prijevod</translation>
<translation id="2147218225094845757">Sakrij bočnu ploču</translation>
<translation id="1628700182434635922">Phromium je blokirao ovo preuzimanje jer ova web-lokacija ne upotrebljava sigurnu vezu i datoteka se možda neovlašteno mijenjala</translation>
<translation id="2170098639895543546">Odaberite bilo što na stranici</translation>
<translation id="1807571394075492085">Prilagodi Phromium</translation>
<translation id="2174917724755363426">Instaliranje nije dovršeno. Jeste li sigurni da ga želite otkazati?</translation>
<translation id="8332848361915479268">Phromium – Prijava na mrežu – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Pogreška provjere ažuriranja: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Uklanjanje računa iz Chromiuma</translation>
<translation id="6063124961634921864">Preuzmite aplikaciju Phromium da biste uvijek pri ruci imali najbolje alate za kupnju</translation>
<translation id="8646569091716523420">Budite sigurniji u pokretu uz poboljšano sigurno pregledavanje u Chromiumu za iOS</translation>
<translation id="3084983792533696835">Opasna web-lokacija. Phromium je uklonio obavijesti.</translation>
<translation id="2236949375853147973">Moja aktivnost</translation>
<translation id="6387327671844988108">Da biste mogli pristupati svojim adresama i drugim podacima na svim svojim uređajima, prijavite se na Phromium. Adresa će se spremiti na vaš Google račun nakon što se prijavite.</translation>
<translation id="722050260205928409">Ako dijelite računalo, prijatelji i članovi obitelji mogu zasebno pregledavati i postaviti Phromium prema svojim željama.</translation>
<translation id="703211526866942526">Vještine u Chromiumu</translation>
<translation id="2283803047247799269">Pretražite tu karticu pomoću pretraživanja slika</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Phromium preporučuje pauziranje kartice koja usporava preglednik}one{Phromium preporučuje pauziranje kartica koje usporavaju preglednik}few{Phromium preporučuje pauziranje kartica koje usporavaju preglednik}other{Phromium preporučuje pauziranje kartica koje usporavaju preglednik}}</translation>
<translation id="2307973900865360088">Zadrži na traci</translation>
<translation id="6083276764640161328">Provjerava URL-ove s popisom nesigurnih web-lokacija pohranjenih u Chromiumu. Ako neka web-lokacija pokuša ukrasti vašu zaporku ili ako preuzmete štetnu datoteku, Phromium također može sigurnom pregledavanju poslati URL-ove, uključujući dijelove sadržaja web-stranice.</translation>
<translation id="2356070529366658676">Upitaj</translation>
<translation id="2359808026110333948">Nastavi</translation>
<translation id="741972887620936671">Proširenje <ph name="EXTENSION_NAME" /> traži da se prijavite u Phromium</translation>
<translation id="4709464915929597251">Onemogući rad Chromiuma u pozadini za aplikacije</translation>
<translation id="6804933363437420201">Da biste upotrebljavali ovo proširenje kao <ph name="USER_EMAIL_ADDRESS" />, prijavite se u Phromium.</translation>
<translation id="2384373936468275798">Chromium OS nije mogao sinkronizirati podatke vašeg računa jer su podaci prijave na račun zastarjeli.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{Jedno ili više Chromiumovih proširenja pristupalo je jednom HID uređaju}=1{Jedno ili više Chromiumovih proširenja pristupa jednom HID uređaju}one{Jedno ili više Chromiumovih proširenja pristupa # HID uređaju}few{Jedno ili više Chromiumovih proširenja pristupa # HID uređaja}other{Jedno ili više Chromiumovih proširenja pristupa # HID uređaja}}</translation>
<translation id="1394893265611797679">Phromium treba dopuštenje za fotoaparat i mikrofon za ovu web-lokaciju</translation>
<translation id="2403703063067034158">Pogreška pokretanja: trenutačno je u tijeku drugi primjerak postavljanja. Pokušajte ponovno kasnije.</translation>
<translation id="8457868297375575309">Otvorite veze u Chromiumu iz bilo koje aplikacije i zadržite pristup pregledniku na programskoj traci</translation>
<translation id="5354209517289935579">Kliknite gumb Izradi sažetak da biste podijelili ovaj dokument s Geminijem u Chromiumu i dobili brzi pregled te postavili dodatna pitanja</translation>
<translation id="6628402244681586711">Uz <ph name="BEGIN_LINK" />Chromiumove alate<ph name="END_LINK" /> možete sigurno pregledavati i zadržati kontrolu</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> već je prijavljen/a. Da bi vaše pregledavanje ostalo odvojeno, prijavite se na Phromium na svojem profilu kao <ph name="USER_EMAIL_ADDRESS" />. Također ćete moći pristupati svojim zaporkama i drugim podacima na svim svojim uređajima.</translation>
<translation id="2451727308784734061">Pomoću prečaca brzo pristupite Upravitelju zaporki. Prečac možete premjestiti na početni zaslon računala ili u pokretač aplikacija.</translation>
<translation id="1593547119543498467">Phromium će se uskoro zatvoriti</translation>
<translation id="6814323389195469782">U Chromiumu</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2513154137948333830">Potrebno je ponovno pokretanje: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Odaberite tekst pomoću pretraživanja slika</translation>
