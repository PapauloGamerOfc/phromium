<translation id="625373791981566594">Gemini Enterprise u Chromiumu</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Prijava na mrežu</translation>
<translation id="5924017743176219022">Povezivanje s internetom...</translation>
<translation id="5941711191222866238">Minimiziraj</translation>
<translation id="8650638130234822147">Da biste imali ovu oznaku i druge na svim svojim uređajima, prijavite se u Phromium</translation>
<translation id="5010592102321399468">Prilagodite Phromium sebi</translation>
<translation id="5960071705175224773">Vaše su postavke promijenjene pomoću nepoznate aplikacije</translation>
<translation id="5977420883993828287">Prikvačeno! Nastavite upotrebljavati kontekstualne zadatke s alatne trake</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{Kad se Phromium ne koristi jednu minutu, vaša ga organizacija automatski zatvara.}one{Kad se Phromium ne koristi # minutu, vaša ga organizacija automatski zatvara.}few{Kad se Phromium ne koristi # minute, vaša ga organizacija automatski zatvara.}other{Kad se Phromium ne koristi # minuta, vaša ga organizacija automatski zatvara.}}</translation>
<translation id="3160371268592376569">Ažurirajte Phromium da bi se pokrenula sinkronizacija</translation>
<translation id="5990360079535151574">Pomoću gumba Kontekstualni zadaci na alatnoj traci možete ponovo otvoriti kontekstualne zadatke da biste postavljali pitanja dok pregledavate</translation>
<translation id="6003112304606738118">Preuzimanje... Još <ph name="HOURS" /> h</translation>
<translation id="6009821354356307391">Postavite dodatni upit</translation>
<translation id="6040143037577758943">Zatvori</translation>
<translation id="5783572280281297164">Iskoristite više pogodnosti online kupnje kad upotrebljavate aplikaciju Phromium na uređaju <ph name="DEVICE_TYPE" /></translation>
<translation id="2712461133060419287">Da biste zaštitili svoje podatke, dopustite Chromiumu da ukloni dopuštenja s web-lokacija koje niste posjetili u posljednje vrijeme. Obavijesti se ne zaustavljaju.</translation>
<translation id="7845842385196710435">&amp;Otvori u Chromiumu</translation>
<translation id="6069027071882229820">Kopiraj kao sliku</translation>
<translation id="3752072756936611600">Proširenje <ph name="EXTENSION_NAME" /> dodano je u Phromium</translation>
<translation id="2775066550187002528">Prilagodite i kontrolirajte Phromium. Dostupno je ažuriranje.</translation>
<translation id="6531352038528110565">Uključeno • Phromium ne može provjeriti odakle dolazi ovo proširenje</translation>
<translation id="2876078296400914679">Vaš račun u Chromiumu</translation>
<translation id="3881538460441135554">Omogućuje proširenju da prikazuje zahtjeve za pristup na alatnoj traci Chromiuma</translation>
<translation id="7479187736743594081">Datoteka <ph name="FILE_NAME" /> opasna je, pa ju je Phromium blokirao.</translation>
<translation id="6646104775883837119">Phromium će se uskoro zatvoriti i izbrisati podatke</translation>
<translation id="6138634751748297112">Ovdje se možete prebacivati između profila u Chromiumu</translation>
<translation id="8660563290103481109">Ako dopustite kolačiće, Phromium ih može koristiti prilikom predučitavanja.</translation>
<translation id="6165508094623778733">Saznajte više</translation>
<translation id="969667123257916656">Izbrišite Chromiumove podatke na svojem računu</translation>
<translation id="5528040738212560214">Datoteka može biti opasna<ph name="LINE_BREAK" />Phromium može provjeriti tu datoteku za vas ako unesete zaporku. Podaci o datoteci šalju se Google sigurnom pregledavanju, ali sadržaj i zaporka datoteke ostaju na vašem uređaju.</translation>
<translation id="6182736845697986886">Instalacija nije uspjela zbog interne pogreške poslužitelja ažuriranja.</translation>
<translation id="6041381825442292659">Obavezno se prijavite na Phromium na uređaju <ph name="TARGET_DEVICE_NAME" /> i nakon toga ponovno pokušajte sa slanjem.</translation>
<translation id="2474943719592372017">Pretražujte i postavljajte pitanja s bilo kojeg mjesta, čak i ako je Phromium minimiziran. Omogućuje Chromiumu da se izvodi u pozadini.</translation>
<translation id="2518372260387069450">Ovo računalo već ima noviju verziju Chromiuma. Ako softver ne funkcionira, deinstalirajte Phromium i pokušajte ponovo.</translation>
<translation id="3832895416321159809">{0,plural, =0{Phromium će se sada ponovo pokrenuti}=1{Phromium će se ponovo pokrenuti za jednu sekundu}one{Phromium će se ponovo pokrenuti za # sekundu}few{Phromium će se ponovo pokrenuti za # sekunde}other{Phromium će se ponovo pokrenuti za # sekundi}}</translation>
<translation id="2775110773501098464">Phromium treba dopuštenje za pristup pohrani radi preuzimanja datoteka</translation>
<translation id="3505491405575013121">Provjerava nalaze li se URL-ovi na popisu nesigurnih web-lokacija pohranjenom u Chromiumu</translation>
<translation id="2276249127856880228">Neka Phromium bude zadani preglednik</translation>
<translation id="6248988683584659830">Pretraživanje postavki</translation>
<translation id="554637698797403739">Iskoristite prednosti najboljih Googleovih sigurnosnih značajki u pokretu uz aplikaciju Phromium na telefonu</translation>
<translation id="7016155178198587734">Želite li se odjaviti iz Chromiuma?</translation>
<translation id="5660287988409470276">Te kartice upotrebljavaju dodatne resurse. Da biste poboljšali izvedbu, dopustite Chromiumu da ih deaktivira.</translation>
<translation id="8429776045186716992">Prilagodite profil u Chromiumu</translation>
<translation id="3310436202618971091">Odaberite naziv profila za Phromium</translation>
<translation id="1478750151648434251">Proširenje traži da se prijavite na Phromium</translation>
<translation id="9139712828910812615">Datoteka <ph name="FILE_NAME" /> mogla bi biti opasna, pa ju je Phromium blokirao.</translation>
<translation id="5191618263102115907">Phromium upotrebljava vašu kameru.</translation>
<translation id="8247508943089477519">U tijeku je neka druga operacija na Chromiumu. Pokušajte ponovo kasnije.</translation>
<translation id="8271488218611798813">Upotreba Chromiuma s vašim Google računom te na dijeljenim računalima sada je još jednostavnija.</translation>
<translation id="446228390478495078">Postavite Phromium kao zadani preglednik da biste jednostavno pristupali svojim omiljenim pouzdanim značajkama.</translation>
<translation id="2203435422524224690">Prečac za Chrome</translation>
<translation id="3977517784144885449">Phromium je blokirao ovo preuzimanje jer se ova datoteka obično ne preuzima i mogla bi biti opasna</translation>
<translation id="8088471547690853921">Jeste li sigurni da želite deinstalirati Phromium?</translation>
<translation id="6375219077595103062">Dodajte prečac Upravitelju zaporki</translation>
<translation id="6388799252195623474">trebam pomoć</translation>
<translation id="1774421040071124552">Da biste nastavili, prijavite se u Phromium kao <ph name="EMAIL" />. Time se omogućuje primjena pravila vaše organizacije.</translation>
<translation id="2343430845154053061">Logotip Chromiuma na zaslonu računala.</translation>
<translation id="2724924185145648602">Phromium je web-preglednik koji munjevitom brzinom prikazuje web-stranice i aplikacije. Brz je, stabilan i jednostavan za upotrebu. Pregledavajte web sigurnije jer je zaštita od zlonamjernog softvera i krađe identiteta ugrađena u Phromium.</translation>
<translation id="7417453886359805803">Da biste uvijek mogli upotrebljavati i spremati podatke iz Chromiuma na svojem Google računu, potvrdite svoj identitet</translation>
<translation id="3304683228794166031">Phromium se pokreće brže, a značajke koje upotrebljavaju JavaScript trebale bi funkcionirati kako je predviđeno</translation>
<translation id="6436260184216827876">Pretraživanje slika nije dostupno. Pokušajte ponovo kasnije.</translation>
<translation id="6442900851116057561">Ponovo pokrenite Chromium OS</translation>
<translation id="9164801375934097818">Phromium predučitava još više stranica koje ćete vjerojatno posjetiti kako bi se brže učitale kad ih posjetite.</translation>
<translation id="2577121659922309103">Preuzmite Phromium na telefon da biste pratili cijene i primali upozorenja kad cijena padne na bilo kojoj web-lokaciji</translation>
<translation id="2052328618318278030">Isključeno • Phromium ne može provjeriti odakle dolazi ovo proširenje</translation>
<translation id="3122296739697671126">Dobro došli u Chromiumove profile</translation>
<translation id="3472445024540245926">Sljedeći put kad otvorite Phromium na uređaju <ph name="DEVICE_TYPE" />, prikazat će vam se upit za upotrebu grupa kartica.</translation>
<translation id="2144084801479939969">Uklanjanje računa iz Chromiuma</translation>
<translation id="2473490714352939152">Upravlja i time koja se stranica prikazuje prilikom pokretanja Chromiuma.</translation>
<translation id="648319183876919572">Poboljšano sigurno pregledavanje pruža vam više zaštite od opasnih web-lokacija i preuzimanja</translation>
<translation id="359777544552173333">Deinstaliranje Chromiuma</translation>
<translation id="3890462049854841354">Prečaci se otvaraju u Chromiumu</translation>
<translation id="6616579671682178785">Vaša organizacija zatvara Phromium kada se ne upotrebljava <ph name="TIMEOUT_DURATION" />. Podaci o pregledavanju su izbrisani. To može uključivati povijest, automatsko popunjavanje i preuzimanja.</translation>
<translation id="8662645370371079862">Svaki profil ima vlastite podatke u Chromiumu kao što su oznake, povijest, zaporke i slično</translation>
<translation id="6556755379298048869">Pretražujte pomoću tipkovnog prečaca.</translation>
<translation id="7133640529688742768">Saznajte više o tome <ph name="BEGIN_LINK" />kako Phromium štiti privatnost vaših podataka<ph name="END_LINK" /></translation>
<translation id="8316065704185291024">Promjene ove postavke primijenit će se nakon ponovnog pokretanja Chromiuma.</translation>
<translation id="2816396636285296289">Upravljajte svojim proširenjima tako da u glavnom izborniku Chromiuma kliknete Proširenja.</translation>
<translation id="8831144879019828189">Možete se prebaciti da biste vidjeli zaporke s nekog drugog profila na Chromiumu</translation>
<translation id="7017911482442558099">Preuzmite aplikaciju Phromium da biste uvijek pri ruci imali najbolje AI alate</translation>
<translation id="5784574554904759369">Phromium Googleu šalje tekst koji utipkate u tekstualna polja kako bi ispravio pravopisne pogreške</translation>
<translation id="8485501471305987872">Otvori postavke obavijesti za Phromium</translation>
<translation id="6600016381025017075">Pretražite bilo što na ovoj stranici</translation>
<translation id="1462793186918694806">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete Phromium.</translation>
<translation id="7501991510212476553">Phromium se sada pokreće kad se pokrene Windows kako biste mogli odmah početi pregledavati. To možete isključiti u postavkama.</translation>
<translation id="7686308613268368175">Nastavite tamo gdje ste stali: Phromium je vratio vaše kartice iz posljednje sesije. To možete isključiti u odjeljku</translation>
<translation id="5266723901802366313">Phromium treba dopuštenje za fotoaparat kako bi mogao izraditi 3D kartu vašeg okruženja</translation>
<translation id="7085315067428293799">Ako oznake spremate i na Google račun, cijene proizvoda možete pratiti u Chromiumu i primati obavijesti kad cijena padne</translation>
<translation id="6676384891291319759">Pristup Internetu</translation>
<translation id="668175097507315160">Chromium OS nije mogao sinkronizirati vaše podatke zbog pogreške prilikom prijave.</translation>
<translation id="5279767706090517695">Uklonite podatke ove aplikacije iz Chromiuma</translation>
<translation id="6562226321659107531">Phromium treba dopuštenje za mikrofon za ovu web-lokaciju</translation>
<translation id="6712881677154121168">Pogreška pri preuzimanju: <ph name="DOWNLOAD_ERROR" /></translation>
<translation id="259800793807512787">Vaš se profil ne može upotrebljavati jer je iz novije verzije Chromiuma.

Neke su značajke možda nedostupne. Navedite neki drugi direktorij profila ili upotrijebite noviju verziju Chromiuma.</translation>
<translation id="4914871493602315663">Da biste dobili personalizaciju i druge značajke, uključite Phromium u aktivnost na webu i u aplikacijama te povezane Googleove usluge</translation>
<translation id="5919390816124912606">Phromium je već instaliran za sve korisnike na računalu.</translation>
<translation id="5867815953973052697">Da biste mogli pristupati svojim oznakama i drugim podacima na svim svojim uređajima, prijavite se u Phromium. Oznaka će se spremiti na vaš Google račun nakon što se prijavite.</translation>
<translation id="7381168634819530324">Ubrzava web-lokacije s Chromiumovom tražilicom V8, ali Phromium čini malo manje otpornim na napade. Postavka je uključena.</translation>
<translation id="1509688792864707851">{count,plural, =1{Neki vaši podaci iz Chromiuma još nisu spremljeni na vaš Google račun. Pokušajte pričekati nekoliko minuta prije odjave. Ako se sada odjavite, ti će se podaci (1 stavka) izbrisati.}one{Neki vaši podaci iz Chromiuma još nisu spremljeni na vaš Google račun. Pokušajte pričekati nekoliko minuta prije odjave. Ako se sada odjavite, ti će se podaci ({count} stavka) izbrisati.}few{Neki vaši podaci iz Chromiuma još nisu spremljeni na vaš Google račun. Pokušajte pričekati nekoliko minuta prije odjave. Ako se sada odjavite, ti će se podaci ({count} stavke) izbrisati.}other{Neki vaši podaci iz Chromiuma još nisu spremljeni na vaš Google račun. Pokušajte pričekati nekoliko minuta prije odjave. Ako se sada odjavite, ti će se podaci ({count} stavki) izbrisati.}}</translation>
<translation id="4702638565169602649">Phromium preporučuje skeniranje datoteke jer je možda opasna.</translation>
<translation id="6779406956731413166">Chromium OS omogućen je dodatnim <ph name="BEGIN_LINK_CROS_OSS" />softverom utemeljenim na otvorenom izvornom kodu<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Prevedi</translation>
<translation id="1564864902402454287">Phromium će vas obavijestiti ako vaše zaporke budu ugrožene</translation>
<translation id="684888714667046800">Povezivanje s internetom nije moguće. Ako upotrebljavate vatrozid, provjerite je li <ph name="PRODUCT_EXE_NAME" /> na popisu dopuštenih.</translation>
<translation id="6200419390448865091">Phromium – <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Pritisnite Tab za nastavak</translation>
<translation id="6862030660799253820">Pretražite tu sliku pomoću pretraživanja slika</translation>
<translation id="6869568587896659271">Jednostavan pristup web-lokacijama ispod adresne trake</translation>
<translation id="4011399428346318467">Phromium je otkrio da <ph name="EXTENSION_NAME" /> sadrži zlonamjerni softver</translation>
<translation id="6877155553248388166">donji desni kut područja za pretraživanje: desno <ph name="RIGHT" />%, dno <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Kopiraj</translation>
<translation id="6898028264630240901">Možete prikvačiti kontekstualne zadatke da biste postavljali pitanja dok pregledavate</translation>
<translation id="1012681980425424211">Postavite Phromium kao zadani preglednik i prikvačite ga na traku sa zadacima</translation>
<translation id="1744625657438211994">&amp;Upravljajte profilima na Chromiumu</translation>
<translation id="7264818828956697552">Tom ćete radnjom:
          <ph name="LINE_BREAKS" />
            • vratiti početnu stranicu, stranicu Nova kartica, tražilicu i prikvačene kartice na zadano
            <ph name="LINE_BREAK" />
            • onemogućiti proširenja
            <ph name="LINE_BREAK" />
            • izbrisati kolačiće i druge privremene podatke web-lokacije
            <ph name="LINE_BREAK" />
            • vratiti prečace na Chromiumu na zadano.
            <ph name="LINE_BREAKS" />
            To neće utjecati na oznake, povijest i spremljene zaporke.</translation>
<translation id="6489000842445481390">Dosegli ste Chromiumovo ograničenje od ovoliko oznaka: <ph name="BOOKMARK_LIMIT" />, pa neke vaše oznake još nisu spremljene na vaš Google račun.

Nove oznake ne mogu se spremiti na vaš račun dok neke ne izbrišete. Ako se sada odjavite, nespremljene oznake će se izbrisati.</translation>
<translation id="2645108248038996858">Otvori vezu u ano&amp;nimnom prozoru Chromiuma</translation>
<translation id="6965382102122355670">U redu</translation>
<translation id="6985329841647292029">Uvjeti Chromium OS-a</translation>
<translation id="2947519843530032104">Unesite šifru kako biste upotrebljavali i spremali podatke iz Chromiuma na svojem računu, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Instalacija nije uspjela jer ova verzija operativnog sustava nije podržana.</translation>
<translation id="7024536598735240744">Pogreška pri raspakiranju: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">Prilagodite Phromium sebi</translation>
<translation id="7047386856539490735">Jesu li vam ti rezultati korisni?</translation>
<translation id="2448910402556368916">Ažuriraj Phromium</translation>
<translation id="7834049737623892628">Ako slika nema koristan opis, Phromium će ga pokušati pružiti. Da bi se izradili opisi, slike se šalju Googleu.</translation>
<translation id="1803168627715642217">Iskoristite prednosti umjetne inteligencije kad upotrebljavate aplikaciju Phromium na uređaju <ph name="DEVICE_TYPE" /></translation>
<translation id="3321731353906178474">Imajte pristup svojim zaporkama, karticama i drugim podacima u pokretu uz aplikaciju Phromium na telefonu</translation>
<translation id="7141270731789036260">Prilagodite Chrome for Testing</translation>
<translation id="8077731669779275332">Phromium možete upotrebljavati svaki put kad kliknete veze u porukama, dokumentima i drugim aplikacijama</translation>
<translation id="611798798247797100">Uklanjanje proširenja <ph name="EXTENSION_NAME" /> iz Chromiuma</translation>
<translation id="7962394294883785044">Vaša organizacija briše podatke iz Chromiuma kada se ne upotrebljavaju <ph name="TIMEOUT_DURATION" />. To može uključivati povijest, automatsko popunjavanje i preuzimanja.</translation>
<translation id="2611686760870033712">Phromium treba dopuštenje za fotoaparat za ovu web-lokaciju</translation>
<translation id="71050417052775020">Pokretanje Chromiuma nije uspjelo. Pokušajte ponovo.</translation>
<translation id="4817060241763895497">Pitajte bilo što, gdje god se nalazili, uz Gemini u Chromiumu</translation>
<translation id="869358700049263961">Zadržite Phromium na traci da biste mu brzo pristupili kad god želite</translation>
<translation id="7094488679340739251">Upotrijebite Phromium svaki put kada kliknete veze u porukama, dokumentima i drugim aplikacijama</translation>
<translation id="7216228761061470870">Kad upotrebljavate pretraživanje slika na računalu, naslov, URL i sadržaj stranice, uključujući PDF-ove, šalju se poslužitelju</translation>
<translation id="7802634650401946711">Upravitelj zadataka – Phromium</translation>
<translation id="5182547787327636348">Postavite pitanje o sadržaju izvan Chromiuma, kao što su druge aplikacije ili datoteke</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> već je prijavljen/a. Da bi vaše pregledavanje ostalo odvojeno, prijavite se na Phromium na svojem profilu kao <ph name="USER_EMAIL_ADDRESS" />. Također ćete moći pristupati svojim spremljenim podacima i drugim podacima na svim svojim uređajima.</translation>
<translation id="5761733252154904648">Odmah počnite pregledavati: Phromium se sada može pokrenuti kad se pokrene Windows.</translation>
