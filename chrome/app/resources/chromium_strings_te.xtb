<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="1026101648481255140">ఇన్‌స్టలేషన్‌ను కొనసాగించండి</translation>
<translation id="1029669172902658969">&amp;ChromiumOSను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="7962340570690354348">ఈ ఎక్స్‌టెన్షన్‌ను రివ్యూ చేయమని Phromium మీకు సిఫార్సు చేస్తోంది</translation>
<translation id="2702007788032964762">వారి పేజీలో లింక్‌లను ప్రైవేట్‌గా ప్రీ - లోడ్ చేయమని సైట్ కోరినప్పుడు, Phromium, Google సర్వర్‌లను ఉపయోగిస్తుంది. ఇది ప్రీ - లోడ్ చేయబడిన సైట్ నుండి మీ గుర్తింపును దాచిపెడుతుంది, కానీ ఏ సైట్‌లు ప్రీ - లోడ్ అయ్యాయి అనేది Googleకు తెలుస్తుంది.</translation>
<translation id="1051793555070215510">ఈ 1 నిమిషం సర్వేను పూర్తి చేసి అజ్ఞాత మోడ్‌ను మెరుగుపరచడంలో మాకు సహాయపడండి.</translation>
<translation id="1065672644894730302">మీ ప్రాధాన్యతలు చదవబడలేవు. కొన్ని లక్షణాలు అందుబాటులో ఉండకపోవచ్చు మరియు ప్రాధాన్యతలకు మార్పులు సేవ్ చేయబడకపోవచ్చు.</translation>
<translation id="4964836565882496625">Chromiumలో సైట్‌లు, యాప్‌లు, ఎక్స్‌టెన్షన్‌లకు సంబంధించిన అనుమతులను మీ తల్లి/తండ్రి ఆఫ్ చేశారు</translation>
<translation id="8409497136174302488">సమీపంలోని డివైజ్‌లను కనుగొనడానికి, ఉపయోగించడానికి Chromiumకు మీ లోకల్ నెట్‌వర్క్‌కు యాక్సెస్ అవసరం</translation>
<translation id="4388904545107211948">నిర్దిష్ట Phromium ఫీచర్ లేదా ఎక్స్‌టెన్షన్‌ను సెర్చ్ చేయడానికి, అడ్రస్ బార్‌లో దాని షార్ట్‌కట్‌ను టైప్ చేసి, ఆపై మీరు ఎంచుకున్న కీబోర్డ్ కీని టైప్ చేయండి</translation>
<translation id="7188624550427159072">సిస్టమ్ ట్రేలో Chromiumతో సెర్చ్‌ను చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="3689248207461565136">Phromium మీ పాస్‌వర్డ్‌లను ఎగుమతి చేయాలనుకుంటోంది. దీనిని అనుమతించడం కోసం మీ Windows పాస్‌వర్డ్‌ని టైప్ చేయండి.</translation>
<translation id="112640046208448578">వస్తువులను లేదా ప్రదేశాలను గుర్తించండి, టెక్స్ట్‌ను కాపీ చేయండి లేదా అనువదించండి. మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీకి సంబంధించిన స్క్రీన్‌షాట్, సర్వర్‌కు పంపబడుతుంది. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">మీ డిఫాల్ట్ బ్రౌజర్ Phromium</translation>
<translation id="5414044255592121327">డేటా ఉల్లంఘనల నుండి, ఇతర భద్రతా సమస్యల నుండి మీ పాస్‌వర్డ్‌లు సురక్షితంగా ఉన్నాయో లేదో చెక్ చేయడానికి, <ph name="BEGIN_LINK" />Chromiumకు సైన్ ఇన్ చేయండి<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">Phromium మెనూను క్లిక్ చేయండి</translation>
<translation id="1157985233335035034">ఇటీవలి భాషలు</translation>
<translation id="1184145431117212167">మీ Windows వెర్షన్‌ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="7861581212703831457">Phromium గురించి</translation>
<translation id="8752630985505435738">మీ ఫోన్‌లో Chromiumతో ధర ట్రాకింగ్ అలర్ట్‌లను పొందండి</translation>
<translation id="1203500561924088507">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించడానికి ముందు మీరు బ్రౌజర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> పెండింగ్‌లో ఉంది. మీ బ్రౌజింగ్‌ను సురక్షితంగా ఉంచడానికి, మీరు తర్వాతిసారి <ph name="IDLE_DURATION" /> పాటు ఇన్‌యాక్టివ్‌గా ఉన్నప్పుడు Phromium అప్‌డేట్ అవుతుంది.</translation>
<translation id="1232234696885483911">మీరు ఇమేజ్ సెర్చ్‌ను తెరిచినప్పుడు, PDFలతో సహా పేజీ టైటిల్, URL, కంటెంట్ ఆటోమేటిక్‌గా సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">మీరు సైన్ ఇన్ చేసినప్పుడు, Chromiumలో మీ Google ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. దీన్ని మార్చడానికి, “Chromiumలో మీ ఖాతా”కు వెళ్లండి.</translation>
<translation id="7402478829083317456">Mac మెనూ బార్‌లో Chromiumలో Geminiని చూపండి</translation>
<translation id="4902531791098430822">Chromiumలోని Geminiలో స్క్రీన్ మీద మీకు కావాల్సిన భాగాన్ని ఎంచుకోవడానికి, కీబోర్డ్ షార్ట్‌కట్‌ను ఉపయోగించండి.</translation>
<translation id="9002284132405311162">ఈ ట్యాబ్ ఇన్‌యాక్టివ్‌గా ఉన్నప్పుడు, Chromiumను వేగంగా ఉంచడానికి మెమరీ ఖాళీ చేయబడింది. మీరు ఏ సమయంలోనైనా ఈ సైట్ ఇన్‌యాక్టివ్‌గా ఉండకుండా మినహాయించడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="5561666811965903444">ఫైల్ ప్రమాదకరంగా ఉన్నందున Phromium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="1340271056805240721"><ph name="USER_EMAIL" />‌తో Gmail లేదా YouTube వంటి Google సర్వీస్‌లకు ఆటోమేటిక్‌గా సైన్ ఇన్ చేస్తున్నప్పుడు, మీరు అదే ఖాతాతో Chromiumకి సైన్ ఇన్ చేయవచ్చు</translation>
<translation id="5048805453292757697">మీ ఫోన్‌లో Chromiumను పొందండి</translation>
<translation id="1290883685122687410">సెటప్ ఎర్రర్: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">మీ కొత్త Phromium ప్రొఫైల్‍ను సెట్ అప్ చేయండి</translation>
<translation id="7871721155662336863">Chromiumలో Geminiని ట్రై చేయండి</translation>
<translation id="6569288432960798043">బ్లూటూత్ పరికరాలను
 అన్వేషించడానికి Chromiumకు బ్లూటూత్ యాక్సెస్ అవసరం. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">మీ ఫోన్‌లో Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1330562121671411446">భాషను గుర్తించండి</translation>
<translation id="1619655755195586133">Phromium (<ph name="URL" />) నుండి కూడా డేటాను తొలగించండి</translation>
<translation id="1345251407431278948">పిన్ చేశారు! మీరు టూల్‌బార్‌లోని కొత్త బటన్‌ను ఉపయోగించి ఇమేజ్ సెర్చ్‌ను మళ్లీ యాక్సెస్ చేయవచ్చు</translation>
<translation id="1383876407941801731">సెర్చ్</translation>
<translation id="2947996037737257951">ప్రయాణంలోనూ బ్రౌజింగ్‌ను కొనసాగించడానికి Phromium యాప్‌ను ఉపయోగించండి</translation>
<translation id="141901961143729572">మీ ఆలోచనలను షేర్ చేయండి</translation>
<translation id="8355386219605656974">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Phromium కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="1478370723027452770">Chrome for Testingకు సంబంధించి సహాయాన్ని పొందండి</translation>
<translation id="8398257182826094665"><ph name="DEVICE" /> నుండి మీరు సేవ్ చేసిన సమాచారాన్ని, అలాగే మరిన్ని వివరాలను పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1497802159252041924">ఇన్‌స్టాలేషన్ ఎర్రర్: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">ఈ పేజీకి ప్రొటెక్షన్ జోడించబడింది</translation>
<translation id="3484755999946650557">Phromium ట్యాబ్‌ను షేర్ చేయండి</translation>
<translation id="3309377459597801353">Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1547469039832541117">హైలైట్ అయిన టాస్క్‌ను ముగిస్తుంది.</translation>
<translation id="2354363290397602683">Chromiumను పిన్ చేయండి</translation>
<translation id="2244728813494358888">Phromium భద్రతా టూల్స్</translation>
<translation id="707582364915018531">Phromium మీ Password Manager డేటాను తొలగించాలనుకుంటోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Chromiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Chromiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Chromiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="5032531544901236587">మీ ఫోన్‌లోని Phromium యాప్‌తో Google అందించే అత్యుత్తమ ప్రయోజనాలను పొందండి</translation>
<translation id="7311082384439462587">Chromiumలోని ముఖ్య గోప్యతా, సెక్యూరిటీ కంట్రోల్స్‌ను రివ్యూ చేయండి</translation>
<translation id="1640672724030957280">డౌన్‌లోడ్ చేయబడుతోంది...</translation>
<translation id="1665602916345474427">మీరు మెంబర్‌షిప్ ఉన్న <ph name="USER_NAME" />‌గా, <ph name="USER_EMAIL" /> ఈమెయిల్‌తో సైన్ ఇన్ చేశారు. ఖాతా మెనూను తెరవండి</translation>
<translation id="4535436467771816034">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Chromiumను ఉపయోగించవచ్చు. ఇది మీ టాస్క్‌బార్‌కు కూడా పిన్ చేయబడుతుంది.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> కోసం అదనపు అధికారాలను అందిస్తుంది.</translation>
<translation id="1722488837206509557">ఇది అందుబాటులో ఉన్న పరికరాల నుండి ఎంచుకోవడానికి, వాటిలో కంటెంట్‌ను డిస్‌ప్లే చేయడానికి మిమ్మల్ని అనుమతిస్తుంది.</translation>
<translation id="3550860956769006392">Phromium త్వరలోనే బ్రౌజింగ్ డేటాను తొలగిస్తుంది</translation>
<translation id="2053384509423635834">Phromium నావిగేషన్‌లను HTTPSకి అప్‌గ్రేడ్ చేయడానికి ట్రై చేస్తుంది</translation>
<translation id="2516115567501600458">Phromium డేటా తీసేసింది</translation>
<translation id="8571959122390670188">Phromium <ph name="REMAINING_TIME" /> సమయంలో రీస్టార్ట్ అవుతుంది</translation>
<translation id="6284080675125981628">HTTPS అందుబాటులో లేనప్పుడు, Phromium మిమ్మల్ని హెచ్చరించకుండా సురక్షితం కాని కనెక్షన్‌ను ఉపయోగిస్తుంది</translation>
<translation id="5872244334553252095">బ్యాక్‌గ్రౌండ్‌లో Chromiumని అమలు చేయడానికి అనుమతించండి</translation>
<translation id="2213761221916953829">Chromiumను సురక్షితం చేయడానికి, మేము <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />లో లిస్ట్‌ చేయబడని మరియు మీకు తెలియకుండానే జోడించబడిన కొన్ని ఎక్స్‌టెన్షన్‌లను నిలిపివేసాము.</translation>
<translation id="8807881428325438878">Chromiumను మీ టాస్క్‌బార్‌కు పిన్ చేసి, దాన్ని ఫాస్ట్‌గా యాక్సెస్ చేసేందుకు, Windows నోటిఫికేషన్‌లో <ph name="BEGIN_BOLD" />Yes<ph name="END_BOLD" />ను క్లిక్ చేయండి</translation>
<translation id="6861833596843600606">Chromiumను మళ్లీ ఇన్‌స్టాల్ చేయి</translation>
<translation id="3950056404221550225"><ph name="AUTHENTICATION_PURPOSE" /> కోసం Phromium ట్రై చేస్తోంది</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="6114726049187747242">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో Chromiumను తెరిచినప్పుడు, Google Password Managerను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="1838374766361614909">శోధనను తీసివేయండి</translation>
<translation id="2724678689951174927">ఈ పరికరం నుండి మాత్రమే బ్రౌజింగ్ డేటాను తొలగించడానికి, దీన్ని మీ Google ఖాతాలో ఉంచుతూ, <ph name="BEGIN_LINK" />Phromium నుండి సైన్ అవుట్ చేయండి<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">ప్రయాణంలో ఉన్నప్పుడు కొత్త ట్యాబ్ గ్రూప్‌లను తెరవడానికి లేదా క్రియేట్ చేయడానికి మీ ఫోన్‌లో Chromiumను డౌన్‌లోడ్ చేసుకోండి.</translation>
<translation id="3191814926523151519">మీరు సైన్ ఇన్ చేసిన Google ఖాతాలను మీరు మేనేజ్ చేయవచ్చు. Phromium బ్రౌజర్, Play Store, Gmail, ఇంకా మరిన్నింటి కోసం మీ Google ఖాతాలు ఉపయోగించబడతాయి. ఫ్యామిలీ మెంబర్ వంటి వారి కోసం మీరు ఖాతాను జోడించాలనుకుంటే, బదులుగా కొత్త వ్యక్తిని మీ <ph name="DEVICE_TYPE" />కు జోడించండి. <ph name="LINK_BEGIN" />మరింత తెలుసుకోండి<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయండి</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ బుక్‌మార్క్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="1880677175115548835">టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="1236934630660512644">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ Phromium ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ Phromium డేటా శాశ్వతంగా <ph name="USER_NAME" />కు అనుబంధించబడుతుంది. మీరు Google ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. మీరు ప్రస్తుతం ఉన్న మీ Phromium డేటాను వేరుగా ఉంచడానికి ఐచ్ఛికంగా కొత్త ప్రొఫైల్‌ను క్రియేట్ చేయవచ్చు. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium బ్యాక్‌గ్రౌండ్ యాక్టివిటీని, స్మూత్ స్క్రోలింగ్, వీడియో ఫ్రేమ్ రేట్‌ల వంటి విజువల్ ఎఫెక్ట్‌లను పరిమితం చేయడం ద్వారా బ్యాటరీ పవర్‌ను ఆదా చేస్తుంది. <ph name="BEGIN_LINK" />ఎనర్జీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium అప్‌డేటర్ సర్వీస్</translation>
<translation id="5797624919204275541">దీనిని ఆఫ్ చేయడం ద్వారా, మీరు Chromiumకి సైన్ ఇన్ చేయకుండానే Gmail లాంటి Google సైట్‌లలో సైన్ ఇన్ చేయగలరు</translation>
<translation id="6850971726764387814">Phromium ప్రతిస్పందించడం లేదు. ఇప్పుడు మళ్లీ ప్రారంభించాలా?</translation>
<translation id="8289779763124483945">మీ సంస్థ పాలసీ, <ph name="MANAGER" /> ప్రకారం మీరు Chromiumకు సైన్ ఇన్ చేయాలి</translation>
<translation id="193439633299369377">అప్‌డేట్‌ను వర్తింపజేయడానికి ChromiumOSను రీస్టార్ట్ చేయాలి.</translation>
<translation id="3215238748514810076">ఫైల్ రకం సాధారణంగా డౌన్‌లోడ్ అవ్వదు, అలాగే ఇది ప్రమాదకరమైనది అయినందున Phromium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="1953553007165777902">డౌన్‌లోడ్ అవుతోంది... <ph name="MINUTE" /> నిమిషం(లు) సమయం మిగిలి ఉంది</translation>
<translation id="8529252122707161160">Phromium డిఫాల్ట్ బ్రౌజర్‌ను నిశ్చయించలేదు లేదా సెట్ చేయలేదు</translation>
<translation id="197326043290947695">ఇమేజ్ సెర్చ్‌తో స్మార్ట్‌గా బ్రౌజ్ చేయండి</translation>
<translation id="7769772561254542263">Phromium కొన్ని ఫైళ్లను బ్లాక్ చేసి, కొత్త ట్యాబ్‌లో ఎందుకు తెరుస్తుందో తెలుసుకోండి</translation>
<translation id="3713013456746186442">మీ Phromium సాఫ్ట్‌వేర్‌ను అప్‌డేట్‌గా ఉంచుతుంది. ఈ సర్వీస్ డిజేబుల్ చేయబడినా లేదా ఆపివేయబడినా, మీ Phromium సాఫ్ట్‌వేర్ అప్‌డేట్ చేసి ఉంచబడదు, అంటే సంభవించే సెక్యూరిటీ లోపాలను పరిష్కరించడం సాధ్యం కాదు, ఫీచర్‌లు పని చేయకపోవచ్చు. Phromium సాఫ్ట్‌వేర్ ఉపయోగించనప్పుడు ఈ సర్వీస్ దానికదే అన్‌ఇన్‌స్టాల్ అవుతుంది.</translation>
<translation id="5690439379999550641">ఇది ఈ పరికరం నుండి 1 అంశాన్ని తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="2018879682492276940">ఇన్‌స్టాల్ చేయడం విఫలమైంది. దయచేసి మళ్లీ ట్రై చేయండి.</translation>
<translation id="2039417478970545937">సెట్టింగ్‌లు.</translation>
<translation id="4765042254400173473">Google సర్వీస్‌లలో మరింత వ్యక్తిగతీకరించిన అనుభవం కోసం Phromium హిస్టరీని చేర్చాలో, లేదో ఎంచుకోండి</translation>
<translation id="1448229429009113044">మీరు బలమైన పాస్‌వర్డ్‌లను క్రియేట్ చేయడానికి, సేవ్ చేయడానికి, ఆటోఫిల్ చేయడానికి సాయపడేలా ఇది Chromiumలో బిల్ట్-ఇన్‌గా వస్తుంది. సులభంగా యాక్సెస్ చేయడానికి షార్ట్‌కట్‌ను జోడించండి.</translation>
<translation id="2145664943269651168">Chromiumకు కొత్త రూపాన్ని అందించడానికి కొత్త ట్యాబ్ పేజీలో Chromiumను అనుకూలంగా మార్చండి బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="6052463185672312901">ఫైల్ మోసపూరితమైనది అలాగే మీ పరికరానికి ఊహించని మార్పులు చేసే అవకాశం ఉన్నందున Phromium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="3825064703718009924">మీరు నెక్స్ట్ టైమ్ Phromium iOSను తెరిచినప్పుడు, <ph name="FEATURE_NAME" />‌ను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="886729435477608858">మీ Google ఖాతాలో మీరు సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, ఇతర Phromium డేటా ఈ డివైజ్ నుండి తీసివేయబడతాయి. వాటిని మళ్లీ Chromiumలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Chromiumను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}other{Chromiumను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}}</translation>
<translation id="2125838419757773031">సెర్చ్ చేయడానికి స్క్రీన్‌పై భాగాన్ని ఎంచుకోండి</translation>
<translation id="2126108037660393668">డౌన్‌లోడ్ చేయబడిన ఫైల్ వెరిఫికేషన్ విఫలమైంది.</translation>
<translation id="2135919691573380097">ఈ సైట్‌ను రిపోర్ట్ చేయండి</translation>
<translation id="2137162749895930932">స్క్రీన్‌ను అనువదించండి అనే ఆప్షన్‌ను మూసివేయండి</translation>
<translation id="2147218225094845757">సైడ్ ప్యానెల్‌ను దాచండి</translation>
<translation id="1628700182434635922">సైట్ సురక్షిత కనెక్షన్‌ను ఉపయోగించని అలాగే ఫైల్ ట్యాంపర్ చేయబడిన కారణంగా Phromium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="2170098639895543546">పేజీలో ఏదైనా ఎంచుకోండి</translation>
<translation id="1807571394075492085">Chromiumను అనుకూలంగా మార్చండి</translation>
<translation id="2174917724755363426">ఇన్‌స్టాలేషన్ పూర్తి కాలేదు. మీరు ఖచ్చితంగా రద్దు చేయాలనుకుంటున్నారా?</translation>
<translation id="8332848361915479268">Phromium - నెట్‌వర్క్ సైన్ ఇన్ - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">అప్‌డేట్‌ల కోసం చెక్ చేసేటప్పుడు ఎర్రర్ ఏర్పడింది: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Phromium నుండి ఖాతాను తీసివేయండి</translation>
<translation id="6063124961634921864">అత్యుత్తమ షాపింగ్ టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లడానికి Phromium యాప్‌ను ఉపయోగించండి</translation>
<translation id="8646569091716523420">iOS కోసం Chromiumలో మెరుగైన సురక్షిత బ్రౌజింగ్‌కు సంబంధించి ప్రయాణంలో సురక్షితంగా ఉండండి</translation>
<translation id="3084983792533696835">హానికరమైన సైట్. Phromium నోటిఫికేషన్‌లను తీసివేసింది.</translation>
<translation id="2236949375853147973">నా యాక్టివిటీ</translation>
<translation id="6387327671844988108">Chromiumకు సైన్ ఇన్ చేసి, మీ పరికరాలన్నింటిలో మీ అడ్రస్‌లను, ఇంకా మరిన్నింటిని పొందండి. మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ అడ్రస్ మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="722050260205928409">మీరు కంప్యూటర్‌ను షేర్‌ చేస్తే, స్నేహితులు, ఫ్యామిలీ మెంబర్‌లు విడివిడిగా బ్రౌజ్ చేయవచ్చు. Chromiumను వారికి నచ్చిన రీతిలో సెటప్ చేసుకోవచ్చు.</translation>
<translation id="703211526866942526">Chromiumలో స్కిల్స్</translation>
<translation id="2283803047247799269">ఇమేజ్ సెర్చ్‌తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని Phromium సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని Phromium సిఫార్సు చేస్తుంది}}</translation>
<translation id="2307973900865360088">డాక్‌లో ఉంచండి</translation>
<translation id="6083276764640161328">Chromiumలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది. ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా Phromium, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు.</translation>
<translation id="2356070529366658676">అడుగు</translation>
<translation id="2359808026110333948">కొనసాగించండి</translation>
<translation id="741972887620936671">ఎక్స్‌టెన్షన్ "<ph name="EXTENSION_NAME" />" కోసం, మీరు Chromiumకు సైన్ ఇన్ చేయాలి</translation>
<translation id="4709464915929597251">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న Chromiumను డిజేబుల్ చేయండి</translation>
<translation id="6804933363437420201"><ph name="USER_EMAIL_ADDRESS" />‌గా ఈ ఎక్స్‌టెన్షన్‌ను ఉపయోగించడానికి, Chromiumకు సైన్ ఇన్ చేయండి.</translation>
<translation id="2384373936468275798">మీ ఖాతా సైన్ ఇన్ వివరాల గడువు ముగిసినందున ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ Phromium ఎక్స్‌టెన్షన్‌లు 1 HID డివైజ్‌ను యాక్సెస్ చేస్తున్నాయి}=1{1 HID డివైజ్ ఒకటి లేదా అంతకంటే ఎక్కువ Phromium ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ Phromium ఎక్స్‌టెన్షన్‌లు # HID డివైజ్‌లను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="1394893265611797679">ఈ సైట్ కోసం Chromiumకు కెమెరా, ఇంకా మైక్రోఫోన్ అనుమతులు అవసరం</translation>
<translation id="2403703063067034158">స్టార్టప్ ఎర్రర్: ప్రస్తుతం వేరొక సెటప్ రన్ అవుతోంది, దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="8457868297375575309">ఏదైనా యాప్ నుండి Chromiumలో లింక్‌లను తెరవండి, మీ టాస్క్‌బార్‌లో బ్రౌజర్‌ను యాక్సెస్ చేయండి</translation>
<translation id="5354209517289935579">త్వరగా ఓవర్‌వ్యూ పొందడానికి, ఫాలో-అప్ ప్రశ్నలు అడగడానికి ఈ డాక్యుమెంట్‌ను Chromiumలోని Geminiకి షేర్ చేసేందుకు 'సారాంశం' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="6628402244681586711"><ph name="BEGIN_LINK" />Phromium నుండి టూల్స్‌<ph name="END_LINK" />‌తో, మీరు సురక్షితంగా బ్రౌజ్ చేయవచ్చు, కంట్రోల్‌లో ఉండవచ్చు</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="2451727308784734061">Password Managerను త్వరగా చేరుకోవడానికి మీ షార్ట్‌కట్‌ను ఉపయోగించండి. మీరు మీ షార్ట్‌కట్‌ను మీ కంప్యూటర్ మొదటి స్క్రీన్ లేదా యాప్ లాంచర్‌కు తరలించవచ్చు.</translation>
<translation id="1593547119543498467">Phromium త్వరలోనే మూసివేయబడుతుంది</translation>
<translation id="6814323389195469782">Chromiumలో</translation>
<translation id="2485422356828889247">అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="2513154137948333830">రీబూట్ అవసరం: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">ఇమేజ్ సెర్చ్‌ను ఉపయోగించి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="2643581100433412871">Phromium ఇప్పటికే ఉన్న పాస్‌వర్డ్‌లను రీప్లేస్ చేయడానికి ట్రై చేస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="4103676945224728292">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి Chromiumకు స్టోరేజ్‌ యాక్సెస్ అవసరం</translation>
<translation id="8743720024689622265">Phromium సహాయకం</translation>
<translation id="2575822587468774919">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి</translation>
<translation id="8692134707551176334">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="6035715610127790081">Chromiumను డౌన్‌లోడ్ చేసి, మీ Google ఖాతాకు సైన్ ఇన్ చేయడానికి మీ ఫోన్‌తో QR కోడ్‌ను స్కాన్ చేయండి.</translation>
<translation id="1579158377846894470">Chromiumతో సెర్చ్ చేయడానికి.</translation>
<translation id="3626651250874375470">Chromiumని ఉపయోగించడం కొనసాగించండి</translation>
<translation id="259935314519650377">డౌన్‌లోడ్ చేసిన ఇన్‌స్టాలర్‌ను కాష్ చేయడంలో విఫలమైంది. ఎర్రర్: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">సిస్టమ్</translation>
<translation id="7634640424937626608">మీ సంస్థ మీ బుక్‌మార్క్‌లు, హిస్టరీ, అలాగే పాస్‌వర్డ్‌ల వంటి బ్రౌజింగ్ డేటాను చూడగలదు, మేనేజ్ చేయగలదు. ఇతర Phromium ప్రొఫైల్స్‌లోని బ్రౌజింగ్ డేటాను ఇది చూడలేదు</translation>
<translation id="2669565213445601962">మీ ఖాతా <ph name="ACCOUNT_EMAIL" />‌లో Phromium డేటాను ఉపయోగించింది, సేవ్ చేసింది మీరేనని వెరిఫై చేయండి</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Chromiumను రీ-లాంచ్ చేయాలని అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోరుతోంది}=1{అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోసం, మీరు అప్‌డేట్‌ను వర్తింపజేయడానికి Chromiumను రీ-లాంచ్ చేయాలి. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోసం, మీరు అప్‌డేట్‌ను వర్తింపజేయడానికి Chromiumను రీ-లాంచ్ చేయాలి. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="4393202019354077587">Chromiumని ప్రారంభించండి</translation>
<translation id="3192212313802409327">ఇన‌స్ట‌లేష‌న్‌ సమయంలో ఆపరేటింగ్ సిస్టమ్ ఎర్ర‌ర్‌ ఏర్పడింది. దయచేసి Chromiumను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="6648732950668475680">మీరు ఒక డివైజ్‌ను షేర్ చేస్తే, ఫ్రెండ్స్, ఫ్యామిలీ విడివిడిగా బ్రౌజ్ చేయవచ్చు, Chromiumను వారికి నచ్చిన విధంగా సెటప్ చేసుకోవచ్చు</translation>
<translation id="3501804488281766385">Phromium మినిమైజ్ చేయబడినప్పటికీ, మీ డివైజ్‌లో ఎక్కడి నుండైనా Geminiని సులభంగా యాక్సెస్ చేసి ఉపయోగించుకోండి.</translation>
<translation id="5655763731487334489">Phromium ట్యాబ్</translation>
<translation id="582020748041490207">అదనపు భద్రత కోసం, Phromium మీ డేటాను ఎన్‌క్రిప్ట్ చేస్తుంది.</translation>
<translation id="2693283019505702310">Phromium నుండి మీ Google ఖాతాను తీసివేయడానికి, సైన్ అవుట్ చేయండి</translation>
<translation id="2989508583692830513">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="2738871930057338499">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 403 అనుమతి లేదు. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="2753623023919742414">సెర్చ్ చేయడానికి క్లిక్ చేయండి</translation>
<translation id="3391021955306442819">మీ ఆటోమేటిక్ సెట్టింగ్ PDF వ్యూయర్‌గా Chromiumను సెట్ చేయండి</translation>
<translation id="293156805028931571">ఈ ఎక్స్‌టెన్షన్‌లో మాల్‌వేర్ ఉంది, ఇది సురక్షితం కాకపోవచ్చు. Phromium నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="2799223571221894425">మళ్లీ ప్రారంభించండి</translation>
<translation id="4742633141454352374">మీ Phromium</translation>
<translation id="2816462166102338036">ఇమేజ్ సెర్చ్‌తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="2191308357458164968">iOSలోని Chromiumతో ప్రయాణంలోనూ మీ కెమెరాతో ప్రోడక్ట్‌లను కనుగొనండి, ధరల తగ్గుదలను ట్రాక్ చేయండి, ఇంకా మరెన్నో చేయండి.</translation>
<translation id="2841525013647267359">ఈ భాష నుండి అనువదించండి</translation>
<translation id="2846251086934905009">ఇన్‌స్టాల్ లోపం: ఇన్‌స్టాలర్ ప్రాసెస్‌ను పూర్తి చేయలేదు. ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="4498037716339180906">Phromium నుండి తీసివేయండి...</translation>
<translation id="4049188396834160957">Chromiumలో మిమ్మల్ని సురక్షితంగా ఉంచుతుంది, మీరు సైన్ ఇన్ చేసినప్పుడు ఇతర Google యాప్‌లలో మీ సెక్యూరిటీని మెరుగుపరచడానికి ఉపయోగించబడవచ్చు</translation>
<translation id="2885378588091291677">విధి సంచాలకులు</translation>
<translation id="4119302609687132178">&amp;Phromium గురించి</translation>
<translation id="2915996080311180594">తర్వాత రీస్టార్ట్ చేయండి</translation>
<translation id="8232968781653330429">మీ రహస్య పదబంధంతో మీ డేటా ఎన్‌క్రిప్ట్ అయింది. మీ Google ఖాతాలో Phromium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి దాన్ని ఎంటర్ చేయండి.</translation>
<translation id="2945997411976714835">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ప్రాసెస్‌ను ప్రారంభించడంలో విఫలమైంది.</translation>
<translation id="5624652745932625503">iOSలో Phromium కోసం సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించి సైట్‌లకు వేగంగా సైన్ ఇన్ చేయండి</translation>
<translation id="8821179372057577828">మీ సంస్థ Chromiumను మేనేజ్ చేస్తుంది</translation>
<translation id="741172935898285572">Phromium తాజాగా ఉంది</translation>
<translation id="8798708493876822519">ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా Phromium, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు</translation>
<translation id="6896740867011823632">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3003694935412297923">అన్ని టాస్క్‌లు</translation>
<translation id="3580865868015023718">{count,plural, =1{మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని Phromium ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని Phromium ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="1211179250505223767"><ph name="URL" /> ను Chromiumలో కొత్త ట్యాబ్‌లో తెరవండి.</translation>
<translation id="4742400838355945730">స్కిల్స్ వంటి AI ఆవిష్కరణలు మీ Google ఖాతాలో సేవ్ చేయబడతాయి, Phromium సింక్ నుండి విడిగా మేనేజ్ చేయబడతాయి</translation>
<translation id="8070050512429584052">మీ అన్ని డివైజ్‌లలో మీ ఎక్స్‌టెన్షన్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="666691655897541311">Chromiumకి జోడిస్తోంది...</translation>
<translation id="3038232873781883849">ఇన్‌స్టాల్ చేయడానికి వేచి ఉంది...</translation>
<translation id="3045032126857188731">అనువదించిన భాష: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">ఫీడ్‌బ్యాక్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="919456815618829047"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ చదవాల్సిన లిస్ట్‌ను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="6141754610526066487">ఇతర Phromium ప్రొఫైల్స్</translation>
<translation id="2380720899384114679">ఎక్స్‌టెన్షన్‌లు అనేవి Chromiumను అనుకూలంగా మార్చడానికి మిమ్మల్ని అనుమతించే యాడ్-ఆన్‌లు. ఆర్గనైజ్డ్‌గా ఉండటం నుండి రోజువారీ టాస్క్‌లను సులభతరం చేయడం వరకు, Chromiumను మీ స్వంతం చేసుకోవడంలో ఎక్స్‌టెన్షన్‌లు మీకు సహాయపడతాయి.</translation>
<translation id="2507281899032275020">Googleకు వినియోగ గణాంకాలు, <ph name="UMA_LINK" />ను పంపడం ద్వారా Chromiumను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="1514966729948178660">ప్రయాణంలోనూ Google భద్రతను పొందడానికి Phromium యాప్‌ను ఉపయోగించండి</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ Phromium ఎక్స్‌టెన్షన్‌లు 1 USB డివైజ్‌ను యాక్సెస్ చేస్తున్నాయి}=1{1 USB డివైజ్ ఒకటి లేదా అంతకంటే ఎక్కువ Phromium ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ Phromium ఎక్స్‌టెన్షన్‌లు # USB డివైజ్‌లను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="78720743239019396"><ph name="DEVICE" /> నుండి మీ చదవాల్సిన లిస్ట్‌ను, మరిన్నింటిని పొందడానికి, Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="7000206277447032115">Phromium హిస్టరీ</translation>
<translation id="4555002192651219296">ఇన్‌స్టాలర్ ఆర్కైవ్‌ను వాస్తవ పరిమాణానికి తీసుకుని రావడంలో విఫలమైంది. దయచేసి Chromiumను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="310459126943037700">టాస్క్(లు) ముగించడంలో విఫలమైంది.</translation>
<translation id="3104828284009500087">పేజీలో ఏదైనా సెర్చ్ చేయండి</translation>
<translation id="4867557516756736957">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను Chromiumకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి.</translation>
<translation id="8632308594821621017">Phromium మీ మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="3130333203120345554">కొత్త సెర్చ్</translation>
<translation id="3137969841538672700">సెర్చ్ చేయడానికి ఇమేజ్‌లో కొంత భాగాన్ని ఎంచుకోండి</translation>
<translation id="9173792796158381383">ఈ ట్యాబ్ అదనపు రిసోర్స్‌లను ఉపయోగిస్తోంది. మీ పనితీరును మెరుగుపరచడానికి, దాన్ని ఇన్‌యాక్టివ్‌గా ఉంచడానికి Chromiumకు అనుమతినివ్వండి.</translation>
<translation id="8874679893080632357">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Phromium కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="101045618220347251">Chromiumను పునఃప్రారంభించండి</translation>
<translation id="3161522574479303604">అన్ని భాషలు</translation>
<translation id="5940989267583033306">Phromium అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="2045477525210426976">మీ కొత్త Phromium ప్రొఫైల్‌ను అనుకూలంగా మార్చుకోండి</translation>
<translation id="3540518135502114323">మీరు ట్యాబ్‌లను మార్చకుండానే AI మోడ్‌తో చాట్ చేయవచ్చు. ప్రారంభించడానికి, Chromiumకు సైన్ ఇన్ చేయండి. మీ డివైజ్‌లన్నిటిలో మీ పాస్‌వర్డ్‌లు, మరిన్ని ప్రయోజనాలను కూడా పొందుతారు.</translation>
<translation id="1496180326063744749">Phromium నుండి మీ Google ఖాతాను తీసివేయడానికి, సెట్టింగ్‌ల పేజీలోని Phromium నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="7792783034323745412">తర్వాత, మీ కోసం ఫారమ్‌లను ఆటోఫిల్ చేయడానికి సేవ్ చేసిన సమాచారాన్ని ఉపయోగించాలనుకుంటున్నారా అని Phromium అడగవచ్చు</translation>
<translation id="5240091371721695404">Phromium దీని డేటా డైరెక్టరీని చదవలేదు మరియు దీనిలో రాయ‌లేదు: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">iOSలోని Chromiumతో మీకు నచ్చిన Google AI టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి.</translation>
<translation id="4848363951707149242"><ph name="DEVICE" /> నుండి మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3286538390144397061">ఇప్పుడు పునఃప్రారంభించండి</translation>
<translation id="8613877111531019527">Google API కీలు లేవు. Phromium కార్యాచరణలో కొంత భాగం నిలిపివేయబడుతుంది.</translation>
<translation id="2784090498377460662">Phromium మూసివేయబడినప్పుడు నేపథ్య యాప్‌లను అమలు చేయడాన్ని కొనసాగించండి</translation>
<translation id="3905054486991167751">మీరు అందుబాటులో లేనప్పుడు Phromium అప్‌డేట్ అవుతుంది</translation>
<translation id="4502950976754616266">సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి ఏదైనా సైట్‌ను లోడ్ చేసే ముందు Phromium మిమ్మల్ని హెచ్చరిస్తుంది</translation>
<translation id="6107453188231652861">మీరు Chromiumకు సైన్ ఇన్ చేసినట్లయితే, Phromium విండోలన్నింటినీ మూసివేసినప్పుడు, మీ Google ఖాతా మినహా, దాదాపుగా సైట్‌లన్నింటి నుండి సైన్ అవుట్ అవుతారు. మిమ్మల్ని సైట్‌లు గుర్తుంచుకోవడానికి, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">సెర్చ్ ఏరియాకు ఎగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT" />%, ఎగువ <ph name="TOP" />%</translation>
<translation id="5896635343289575401">మీ ఖాతాలోని Phromium డేటా</translation>
<translation id="5662253013097242821">మీ ఫోన్‌లో Chromiumతో మీ పాస్‌వర్డ్‌లను ఉపయోగించండి</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">ప్రస్తుతం ఉన్న Phromium ప్రొఫైల్‌కు స్విచ్ చేయాలా?</translation>
<translation id="3412460710772753638">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌లో</translation>
<translation id="657700335789940813">Phromium అప్‌డేట్ చేయాలనుకుంటోంది</translation>
<translation id="3487742274367151379"><ph name="DEVICE" /> నుండి మీ బుక్‌మార్క్‌లను, మరిన్నింటిని పొందడానికి, Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3438772217992559640">"ఇమేజ్ సెర్చ్‌"తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="8062355070850891600">మీ ఫోన్‌లో Chromiumతో మెరుగైన సురక్షిత బ్రౌజింగ్‌ను విస్తరించండి</translation>
<translation id="5419337472918920970">మీరు కోరుకున్న విధంగా Phromium వ్యక్తిగతీకరించబడుతోంది...</translation>
<translation id="6573105037542661278">ఇది ఈ పరికరం నుండి <ph name="ITEMS_COUNT" /> అంశాలను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="4600986251755456192"><ph name="SHORTCUT" /> Phromium ప్రొఫైళ్ల మధ్య స్విచ్ చేయగలదు</translation>
<translation id="8118189978246431067">దయచేసి అన్ని Phromium విండోలను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="7430418346833889620">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Phromium కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="2943929290955142701"><ph name="EXISTING_USER" />‌తో ఇప్పటికే సైన్ ఇన్ చేశారు.  మీ బ్రౌజింగ్‌ను ప్రత్యేకంగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />‌గా మీ స్వంత ప్రొఫైల్‌లో Chromiumకి సైన్ ఇన్ చేయండి.</translation>
<translation id="5896697187441340113">మొబైల్ డివైజ్‌లలో Phromium బ్రౌజర్‌ను డౌన్‌లోడ్ చేయడానికి QR కోడ్</translation>
<translation id="354621070532799440">రిమైండర్: Google అత్యుత్తమ భద్రతా ఫీచర్‌లు ఇక ఎల్లప్పుడూ మీతోనే!</translation>
<translation id="6718500626359284607">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Phromium కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="6511372913460632136">Phromium గుర్తించని సైట్‌లకు మెరుగైన రక్షణ JavaScript ఆప్టిమైజేషన్‌ను ఆఫ్ చేస్తుంది</translation>
<translation id="3597003331831379823">అదనపు అధికారాలతో సెటప్‌ను రన్ చేయడం విఫలమైంది. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="8702816719621016911">ఈ వ్యక్తి బ్రౌజింగ్ డేటా‌ ఈ పరికరం నుండి తొలగించబడుతుంది. డేటాను పునరుద్ధరించడానికి, <ph name="USER_EMAIL" />గా Chromiumకు సైన్ ఇన్ చేయండి.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{Chromiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది.}=1{Chromiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{Chromiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="3667616615096815454">ఇన్‌స్టాల్ చేయడం సాధ్యపడలేదు, అప్లికేషన్‌ను సర్వర్ గుర్తించలేదు.</translation>
<translation id="678730369472836428">మీ Google ఖాతాలో Phromium డేటా మొత్తాన్ని ఎన్‌క్రిప్ట్ చేయడానికి మీ <ph name="BEGIN_LINK" />స్వంత రహస్య పదబంధాన్ని<ph name="END_LINK" /> ఉపయోగించండి. Google Pay నుండి పేమెంట్ ఆప్షన్‌లు, అడ్రస్‌లు ఎన్‌క్రిప్ట్ అవ్వవు. Chromiumకు చెందిన బ్రౌజింగ్ హిస్టరీ సింక్ అవ్వదు.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Chromiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Chromiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Chromiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="2203303261468330007">కొత్త Phromium &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="686463893976008238">వ్యక్తిగతీకరణ, ఇతర ప్రయోజనాల కోసం Phromium, ఇతర Google సర్వీస్‌లను లింక్ చేయండి</translation>
<translation id="3729187154190517324">"ట్యాబ్‌ను, మరిన్నింటిని జోడించండి" బటన్‌ను ఉపయోగించి పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి.</translation>
<translation id="5596264049590907430">Phromium ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="5594723037153142396">Phromium కొన్ని డౌన్‌లోడ్‌లను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="3425307214497790458">దేనికైనా మీ రివ్యూ అవసరం అయితే, Phromium మీకు తెలియజేస్తుంది</translation>
<translation id="4247980944121268675">Phromium మీరు చూసే అవకాశం ఉన్న పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని చూసినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="3810973564298564668">మేనేజ్ చేయండి</translation>
<translation id="1058395779823101457">మీరు సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించడానికి, QR కోడ్‌ను ఫాలో అయ్యి, iOSకు సంబంధించిన Chromiumను డౌన్‌లోడ్ చేసి, ఆపై మీ Google ఖాతాకు సైన్ ఇన్ చేయండి</translation>
<translation id="3846683726093018685">**సారాంశం:** 30 పదాల కన్నా తక్కువ ఉన్న ఒక వాక్యంలో, స్క్రీన్‌షాట్‌లో ప్రధాన సబ్జెక్ట్, కంటెంట్ ఉద్దేశాన్ని వివరించండి.

          **ప్రశ్నలను సూచించండి:** స్క్రీన్‌షాట్‌ను బాగా అర్థం చేసుకోవడానికి యూజర్ అడగగలిగే ఆలోచనను రేకెత్తించే విధంగా ఉండే 3-5 ప్రశ్నల బుల్లెట్‌లతో కూడిన లిస్ట్‌ను జెనరేట్ చేయండి. ఈ ప్రశ్నలలో కనీసం ఒక విజువల్ ఆబ్జెక్ట్, దాని డిజైన్, లేదా దాని లొకేషన్‌కు సంబంధించి నిర్దిష్టంగా ఒక ప్రశ్న అయినా ఉండాలి.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">మీ డివైజ్‌లన్నింటిలో మీ బుక్‌మార్క్‌లను, మరిన్నింటిని పొందడానికి, Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3885770153807205175">భాష సెలెక్టర్</translation>
<translation id="5947409614720749543">Chromiumను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. మీరు గమనించాల్సిన విషయం ఒకటి ఉంది - వివరాల కోసం క్లిక్ చేయండి.</translation>
<translation id="2176348074240183776">Chromiumను తెరిచి, బ్రౌజింగ్‌ను ప్రారంభించడానికి మీ పేరును క్లిక్ చేయండి.</translation>
<translation id="3892148308691398805">టెక్స్ట్‌ను కాపీ చేయి</translation>
<translation id="3679766722656346339"><ph name="EXISTING_USER" /> ఇప్పటికే ఈ Phromium ప్రొఫైల్‌కు సైన్ ఇన్ చేశారు. మీరు బ్రౌజ్ చేసిన వాటిని విడిగా ఉంచడానికి, Phromium మీ కోసం మీ సొంత ప్రొఫైల్‌ను క్రియేట్ చేయగలదు.</translation>
<translation id="6085953975934135790">ఈ ఎక్స్‌టెన్ష‌న్ Chrome వెబ్ స్టోర్ పాలసీని ఉల్లంఘిస్తోంది, ఇది సురక్షితం కాకపోవచ్చు. Phromium నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="3941890832296813527">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ఫైల్ పేరు చెల్లదు లేదా సపోర్ట్ చేయదు.</translation>
<translation id="608187946760434925">పాస్‌వర్డ్‌లను కాపీ చేయడానికి Phromium ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="3054592240125889472">మీ డివైజ్‌లన్నింటిలో సేవ్ చేసిన మీ సమాచారాన్ని, ఇంకా మరెన్నో వివరాలను పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3140795250676341027">మీరు Google ఖాతాలో సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, పేమెంట్ ఆప్షన్‌లు, ఇంకా అడ్రస్‌లు ఈ పరికరం నుండి తీసివేయబడతాయి. వాటిని మళ్లీ Chromiumలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="395904275706073188">ప్రొటెక్షన్ ఉన్న పేజీలను రీడ్ చేయడం సాధ్యం కాలేదు. వేరే పేజీని ట్రై చేయండి.</translation>
<translation id="4227910144250222665">Phromium మిమ్మల్ని ఎలా సురక్షితంగా ఉంచుతుందో తెలుసుకోండి</translation>
<translation id="3967822245660637423">డౌన్‌లోడ్ పూర్తయింది</translation>
<translation id="4150430234581811723">మీరు అడ్రస్ బార్ లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, Phromium మీరు టైప్ చేసే దాన్ని మీ సంస్థకు సంబంధించిన సెర్చ్, AI, ఇంకా ఏజెంట్ టూల్స్‌కు పంపి, మీకు సూచనలను అందిస్తుంది.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing పరిచయం</translation>
<translation id="3997429360543082038">ChromiumOS గురించి</translation>
<translation id="4847805566397342820">మీరు సైట్‌కు వెళ్లినప్పుడు, Phromium మీ IP అడ్రస్‌ను దాచిపెట్టే గోప్యతా సర్వర్ ద్వారా URLకు సంబంధించిన గందరగోళానికి గురి చేసే భాగాన్ని <ph name="BEGIN_LINK" />Google సురక్షిత బ్రౌజింగ్<ph name="END_LINK" />కు పంపుతుంది. ఏదైనా సైట్ అనుమానాస్పదంగా ఉంటే, పూర్తి URLలు, పేజీ కంటెంట్‌కు సంబంధించిన బిట్‌లు కూడా పంపబడతాయి.</translation>
<translation id="4016217212818346953">Password Managerతో సురక్షితంగా ఉండండి</translation>
<translation id="4019629340646866719">ChromiumOS అనేది <ph name="BEGIN_LINK_LINUX_OSS" />Linux డెవలప్‌మెంట్ ఎన్విరాన్‌మెంట్<ph name="END_LINK_LINUX_OSS" /> తరహాలోనే, అదనపు <ph name="BEGIN_LINK_CROS_OSS" />ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS" /> ద్వారా సాధ్యమైంది.</translation>
<translation id="4022972681110646219">స్క్రీన్‌ను అనువదించండి</translation>
<translation id="4023601594785368013">అసలు భాష: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">ఏదైనా యాప్ నుండి Chromiumలో లింక్‌లను తెరవండి. అలాగే సులభంగా యాక్సెస్ చేయడానికి, అది మీ టాస్క్‌బార్‌కు పిన్ అవుతుంది.</translation>
<translation id="6916567874038032700"><ph name="BEGIN_LINK" />ప్రస్తుత సెట్టింగ్‌లను<ph name="END_LINK" /> రిపోర్ట్ చేయడం ద్వారా Chromiumను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="4050175100176540509">ముఖ్యమైన భద్రతా మెరుగుదలలు మరియు కొత్త ఫీచర్‌లు తాజా వెర్షన్‌లో అందుబాటులో ఉన్నాయి.</translation>
<translation id="4055805654398742145">Password Manager</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{Chromiumను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}other{Chromiumను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}}</translation>
<translation id="2498876341137940584">Phromium అజ్ఞాత మోడ్</translation>
<translation id="1371775705240141332">Phromium పేజీ వివరాలకు వెళ్లండి</translation>
<translation id="1983555117242858621">మీ బ్రౌజర్‌కు కొత్త రూపాన్ని అందించడానికి Chromiumను అనుకూలంగా మార్చండి</translation>
<translation id="3730928612696305544">మీ Chromiumను అనుకూలంగా మార్చండి</translation>
<translation id="4148957013307229264">వ్యవస్థాపిస్తోంది...</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> - నెట్‌వర్క్ సైన్ ఇన్ - Phromium</translation>
<translation id="8940475598678719246"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ చదవాల్సిన లిస్ట్‌ను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="3361801572720154185">Phromium కోసం గొప్ప యాప్‌లు, ఆటలు, ఎక్స్‌టెన్షన్‌లు మరియు థీమ్‌లను కనుగొనండి.</translation>
<translation id="5104340040322658377">మీ కంప్యూటర్‌లన్నింటిలో ఈ ఎక్స్‌టెన్షన్‌తో పాటు మరిన్నింటిని పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="6533832886058295845">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, మీరు ఇప్పటికే <ph name="USER_EMAIL_ADDRESS" />‌గా సైన్ ఇన్ చేసిన మీ Phromium ప్రొఫైల్‌కు మారండి</translation>
<translation id="4222932583846282852">రద్దు చేస్తోంది...</translation>
<translation id="4224210481850767180">ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="6904238369362879351">మీ Phromium డేటాను ఈ ఖాతాకు జోడించాలా?</translation>
<translation id="357744319784654404">స్టాండర్డ్ రక్షణ కంటే ఎక్కువగా సైట్‌లలోని డేటాను విశ్లేషించి, Googleకు మనుపెన్నడూ తెలియని ప్రమాదకరమైన సైట్‌ల గురించి కూడా ఇది హెచ్చరిస్తుంది. Phromium హెచ్చరికలను స్కిప్ చేయడానికి మీరు ఎంచుకోవచ్చు.</translation>
<translation id="7228779501660520489">Phromium నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="2782053121162821">Phromium గురించి సహాయాన్ని పొందండి</translation>
<translation id="4281844954008187215">సర్వీస్ నియమాలు</translation>
<translation id="5084022108026911204">పేర్కొనబడని ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది. ప్రస్తుతం Phromium అమలు చేయబడుతుంటే, దయచేసి దీనిని మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="5139026954638666406">Phromium నుండి పాస్‌వర్డ్‌లను ఎగుమతి చేయండి</translation>
<translation id="4304713468139749426">పాస్‌వర్డ్ మేనేజర్</translation>
<translation id="4334241893986177674">ఈ స్క్రీన్‌షాట్ కోసం సెర్చ్ చేయండి</translation>
<translation id="8324735155671556570">Windows ప్రారంభమైనప్పుడు Chromiumను ప్రారంభించండి</translation>
<translation id="4400772909124543403">అప్‌డేట్ ఏదీ అందుబాటులో లేదు</translation>
<translation id="2185735215611818026">ఏదేమైనా Phromium నుండి నిష్క్రమించాలా?</translation>
<translation id="4413205837991854510">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="1338297030721125711">బ్యాక్‌గ్రౌండ్‌లో అమలయ్యేందుకు Chromiumని అనుమతించండి</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా Phromium సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" />}other{మీరు వాటిని తీసివేయవలసిందిగా Phromium సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" />}}</translation>
<translation id="1011403527148313450">Chromiumను అనుకూలంగా మార్చండి మరియు నియంత్రించండి</translation>
<translation id="4427306783828095590">ఫిషింగ్, అలాగే మాల్‌వేర్‌ను బ్లాక్ చేయడానికి మెరుగుపరచిన రక్షణ మరింత చేయగలదు</translation>
<translation id="4434353761996769206">ఇన్‌స్టాలర్ ఎర్రర్: <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415"><ph name="MANAGER" />, Chromiumను మేనేజ్ చేస్తుంది</translation>
<translation id="2477616462388290618">Phromium ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="4447409407328223819">Chrome for Testing పరిచయం</translation>
<translation id="972523218852576493">మీ Google ఖాతాలోని Phromium డేటాను ఉపయోగించడానికి, అందులో డేటాను సేవ్ చేయడానికి, మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="4493028449971051158">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా రన్ చేయండి.</translation>
<translation id="4501471624619070934">ఈ దేశంలో యాక్సెస్ పరిమితం చేయబడినందున ఇన్‌స్టలేషన్ విఫలమైంది.</translation>
<translation id="8839763675940122379">ఈ ఎక్స్‌టెన్షన్ అది డేటాను ఎలా సేకరిస్తుంది, దాన్ని ఎలా ఉపయోగిస్తుంది వంటి గోప్యతా పద్ధతులను పబ్లిష్ చేయలేదు. మీరు దాన్ని తీసివేయవలసిందిగా Phromium సిఫార్సు చేస్తోంది.</translation>
<translation id="2339640488105852505">Chromiumకు స్వాగతం; కొత్త బ్రౌజర్ విండో తెరవబడింది</translation>
<translation id="8536959233160434213">మీ పరిసరాలను మ్యాప్ చేయడానికి, మీ చేతి సంజ్ఞలు అలాగే కదలికలను ట్రాక్ చేయడానికి Chromiumకి అనుమతి అవసరం</translation>
<translation id="1077734277628859167">మీరు ఇప్పటికే మరొక Phromium ప్రొఫైల్‌లో <ph name="USER_EMAIL_ADDRESS" />‌గా సైన్ ఇన్ చేశారు</translation>
<translation id="5512897665247593318">Phromium పేజీలను ప్రీ - లోడ్ చేస్తుంది, దీని వల్ల బ్రౌజింగ్, సెర్చింగ్ త్వరగా అవుతుంది. <ph name="BEGIN_LINK" />ప్రీ - లోడ్ పేజీల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">మీరు హానికరమని భావించే సైట్‌ను రిపోర్ట్ చేసినప్పుడు అందరికీ ఆన్‌లైన్ భద్రతను మెరుగుపరచండి.</translation>
<translation id="6624033199018630177">మీరు సురక్షిత బ్రౌజింగ్‌ను ఆఫ్ చేశారు అలాగే ఫైల్‌ను వెరిఫై చేయడం సాధ్యం కానందున Phromium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="3039804643080655517">మీ ఫోన్‌లో Chromiumతో Google Lensను ట్రై చేయండి</translation>
<translation id="4594305310729380060">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌కు</translation>
<translation id="8064263528617889755">Phromium యాప్‌లు</translation>
<translation id="4598116752460667024">లిస్ట్ నుండి ఏదైనా ప్రాసెస్ కోసం సెర్చ్ చేయండి.</translation>
<translation id="4613863813562375431">ChromiumOS వెర్షన్</translation>
<translation id="7245201002247176127">దాదాపుగా నవీకృతంగా ఉంది! అప్‌డేట్‌ను పూర్తి చేయడానికి Chromiumని పునఃప్రారంభించండి.</translation>
<translation id="8846891938874485868">Chromiumకు చెందిన V8 ఇంజిన్, వెబ్‌సైట్లను స్పీడ్‌గా లోడ్ చేస్తుంది. అయితే సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో తక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="7525500996671436081">Chromiumతో Searchను ఓపెన్ చేయండి</translation>
<translation id="1224842000407297331">Phromium ప్రొఫైల్</translation>
<translation id="4956303519269880412">హెచ్చరిక: Phromium మీ బ్రౌజింగ్ హిస్టరీను రికార్డ్ చేయకుండా ఎక్స్‌టెన్ష‌న్‌లను నివారించలేదు. ఈ ఎక్స్‌టెన్ష‌న్‌ను అజ్ఞాత మోడ్‌లో డిజేబుల్ చేయడానికి, ఈ ఆప్షన్‌ను రద్దు చేయండి.</translation>
<translation id="2708255035805733225">మీరు Phromium వినియోగ రిపోర్ట్‌లను కూడా షేర్ చేస్తున్నట్లయితే, ఆ రిపోర్ట్‌లలో మీరు సందర్శించే URLలు ఉంటాయి</translation>
<translation id="4673710618874938871">మీరు మెంబర్‌షిప్ ఉన్న <ph name="USER_NAME" />‌గా సైన్ ఇన్ చేశారు. ఖాతా మెనూను తెరవండి</translation>
<translation id="1883292567514549610">ఈ ప్రొఫైల్‌ను మరొక కంప్యూటర్ (<ph name="HOST_NAME" />)లో మరో Phromium ప్రాసెస్ (<ph name="PROCESS_ID" />) ఉపయోగిస్తున్నట్లు కనిపిస్తోంది. Phromium ప్రొఫైల్‌ను లాక్ చేసినందున అది పాడవదు. ఈ ప్రొఫైల్‌ను వేరే ప్రాసెస్‌లు ఏవీ ఉపయోగించడం లేదని మీకు ఖచ్చితంగా తెలిస్తే, ప్రొఫైల్‌ను అన్‌లాక్ చేసి Chromiumను మళ్లీ ప్రారంభించవచ్చు.</translation>
<translation id="4680828127924988555">ఇన్‌స్టాలేషన్‌ను రద్దు చేయండి</translation>
<translation id="1889305042180577023">మీ Phromium డేటాలో కొంత భాగం ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="8079525505870459051">మీరు సైన్ ఇన్ చేసినప్పుడు, Chromiumలో మీ Google ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. <ph name="SHORTCUT" /> మీ Google సర్వీస్‌ల సెట్టింగ్‌లను మార్చగలదు.</translation>
<translation id="2171507067211697961">ఒకరు ఈ కంప్యూటర్‌లో మునుపు <ph name="ACCOUNT_EMAIL_LAST" /> లాగా Chromiumకు సైన్ ఇన్ చేశారు. దయచేసి మీ సమాచారాన్ని విడిగా ఉంచేందుకు కొత్త Phromium వినియోగదారును క్రియేట్ చేయండి.</translation>
<translation id="4724676981607797757">సపోర్ట్ చేయని ప్రోటోకాల్ ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="6925701206088903005">ఏదేమైనా Chromiumని మూసివేయాలా?</translation>
<translation id="4514755609496543621">Chromiumకి సంబంధించిన ప్రత్యేక భద్రతా అప్‌డేట్ వర్తింపజేయబడింది. ఇప్పుడే పునఃప్రారంభించండి, మేము మీ ట్యాబ్‌లను పునరుద్ధరిస్తాము.</translation>
<translation id="8673673368917636496">మీరు ఇటీవల వెళ్లలేదు. Phromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, మరో <ph name="COUNT" />‌ను తీసివేసింది.</translation>
<translation id="3638319732826965647">Chromiumలో Gemini తెరిచి ఉంటే, కొత్త ట్యాబ్‌లను క్రియేట్ చేసేటప్పుడు సైడ్ ప్యానెల్ తెరిచి ఉంటుంది</translation>
<translation id="479167709087336770">Google Searchలో ఉపయోగించే స్పెల్ చెకర్‌నే ఇది ఉపయోగిస్తుంది. మీరు బ్రౌజర్‌లో టైప్ చేసే టెక్స్ట్‌ను Googleకు పంపుతుంది. ఈ ఆప్షన్‌ను తర్వాత ఎప్పుడైనా మీరు సెట్టింగ్‌లలో మార్చవచ్చు.</translation>
<translation id="2659245507243672392">ఖాతా లేకుండా Chromiumను ఉపయోగించండి</translation>
<translation id="166411027652942990">mDNS ట్రాఫిక్‌ను అనుమతించడానికి Phromium ఇన్‌బౌండ్ నియమం.</translation>
<translation id="6031862420354068813">&amp;Chromiumను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="4918086044614829423">ఆమోదించు</translation>
<translation id="4918844574251943176">ఇమేజ్ కాపీ చేయబడింది</translation>
<translation id="1531905832227009774">మీ డివైజ్‌లన్నింటిలో మీ చదవాల్సిన లిస్ట్‌ను, మరిన్నింటిని పొందడానికి, Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="4319892378006430019">Phromium నేపథ్య మోడ్‌లో ఉంది.</translation>
<translation id="8972359100025490790">క్లిక్ చేసి, Phromium సైన్ ఇన్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="3639078149590125530">Phromium ప్రొఫైళ్లతో, మీ Phromium సంబంధిత అంశాలన్నింటినీ విభజించవచ్చు. ఫ్రెండ్స్, ఫ్యామిలీ కోసం ప్రొఫైళ్లను క్రియేట్ చేయండి, లేదా ఆఫీస్, వినోదం మధ్య ప్రొఫైళ్లను విభజించి ఉపయోగించండి.</translation>
<translation id="7141327976224964788">గెస్ట్‌లు ఎటువంటి హిస్టరీని వదలకుండానే Chromiumను ఉపయోగించవచ్చు.</translation>
<translation id="7007327521155149139">Chromiumలో మీ ఖాతా</translation>
<translation id="5973804420920585431">Chromiumకు మిమ్మల్ని జోడించుకోండి</translation>
<translation id="504699503110800016">ఓవర్‌ఫ్లో మెనూను ఓపెన్ చేయండి</translation>
<translation id="2497925691306722252">మీ <ph name="DEVICE_TYPE" />‌లో Chromiumతో మీకు ఇష్టమైన Google ఫీచర్‌లన్నింటినీ యాక్సెస్ చేయండి</translation>
<translation id="8678196879882043620">Phromium మీ హ్యాండ్స్‌ను ట్రాక్ చేయడానికి అనుమతి అవసరం</translation>
<translation id="3397880081430454820">మీరు ఇటీవల వెళ్లలేదు. Phromium <ph name="PERMISSION_1" />,‌ <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />ను తీసివేసింది.</translation>
<translation id="9114243566897924763">Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="5174969993834422967">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, మీ లొకేషన్ బార్ కుడి మూలన ఉన్న నోటిఫికేషన్ చిహ్నాన్ని క్లిక్ చేయండి.</translation>
<translation id="5174983315706567306">తగినంత డిస్క్ స్పేస్ లేదు.</translation>
<translation id="7698884672439844280">Phromium ఖాతాకు మళ్లీ ప్రామాణీకరణ అనసరమవుతుంది</translation>
<translation id="5629965056131882780">iOSలో Chromiumతో మీరు ఎక్కడ ఆపారో అక్కడి నుండే కొనసాగించండి.</translation>
<translation id="874294566462998787">Phromium నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="5234764350956374838">తొలగించండి</translation>
<translation id="8605581794204249702">Phromium అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="8722804301463582643">ప్రయాణంలో పాస్‌వర్డ్‌లను సేవ్ చేయడానికి Phromium యాప్‌ను పొందండి</translation>
<translation id="6253936671561887082">మీ మార్పులను వర్తింపజేయడానికి, Chromiumని పునఃప్రారంభించండి</translation>
<translation id="7405713141437293142">ఈ ట్యాబ్‌ను మరొక డివైజ్‌కు పంపడానికి, రెండు డివైజ్‌లలో Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="5286907366254680517">గుర్తించబడింది</translation>
<translation id="2224284460884535818">Phromium యాప్‌ను పొందండి</translation>
<translation id="1426207087952749578">అజ్ఞాత మోడ్‌లో బ్రౌజ్ చేస్తున్నప్పుడు, సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి సైట్‌ను లోడ్ చేసే ముందు Phromium మిమ్మల్ని హెచ్చరిస్తుంది</translation>
<translation id="8108751453879231987">Chromiumతో సెర్చ్ చేయండి</translation>
<translation id="7780358745459835678">Phromium అప్‌డేటర్ ఇంటర్నల్ సర్వీస్</translation>
<translation id="6956753580765202069">Chromiumలో ఇతర Gemini ఫీచర్‌లతో పాటు వాటిని ఉపయోగించండి</translation>
<translation id="5346389065299425353">పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి</translation>
<translation id="8684266995248242891">ఈ డాక్యుమెంట్ క్విక్ ఓవర్‌వ్యూను పొందండి, Chromiumలో Geminiతో ప్రశ్నలు అడగండి</translation>
<translation id="586104673506947714">Phromium మీ రివ్యూ కోసం కొన్ని భద్రతా సిఫార్సులను కనుగొంది</translation>
<translation id="4657908558997566735">ఇతర Phromium ప్రొఫైల్స్</translation>
<translation id="6097378010983112326">మీ ఖాతా సైన్-ఇన్ వివరాలు అవుట్-ఆఫ్-డేట్ అయినందున (కాలం చెల్లినందున), ChromiumOS మీ Google ఖాతాలో Phromium డేటాను సేవ్ చేయలేకపోయింది</translation>
<translation id="385020720581757591">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ Phromium ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ Phromium డేటా శాశ్వతంగా <ph name="USER_NAME" />కు అనుబంధించబడుతుంది. మీరు Google ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">అదనపు కోడ్: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">వ్యక్తిగతీకరణను పొందడానికి, వెబ్ &amp; యాప్ యాక్టివిటీలో Chromiumను చేర్చండి</translation>
<translation id="2756028035855809142">Chromiumతో సెర్చ్‌ను ఓపెన్ చేయండి</translation>
<translation id="4375021373215585423">Phromium కొన్ని ఫైల్స్‌ను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="4688227912949761884">Phromium నవీకరించబడుతోంది (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="4945147853702701048">Phromium సైన్-ఇన్‌ని అనుమతించండి</translation>
<translation id="7813879193794658604">Phromium నుండి తీసివేయండి</translation>
<translation id="2908302339618007937">పనితీరును తగ్గిస్తుంది, కానీ Phromium, సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో ఎక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="8760365573983490520">Chromiumను మీ డిఫాల్ట్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> - Phromium బీటా</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని Phromium సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని Phromium సిఫార్సు చేస్తుంది}}</translation>
<translation id="975923236500175446">Chromiumకు ఇక ఈ Linux డిస్ట్రిబ్యూషన్‌లో సపోర్ట్ లేనందున అది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="7595270580374414215">ఈ డౌన్‌లోడ్‌ను Phromium బ్లాక్ చేసింది, ఎందుకంటే మీ వ్యక్తిగత, సోషల్ నెట్‌వర్క్ ఖాతాలకు ఆ ఫైల్ హాని కలిగించగలదు</translation>
<translation id="5644162187312430027">దయచేసి Phromium తాజా సిస్టమ్ అప్‌డేట్‌లను ఇన్‌స్టాల్ చేస్తున్నప్పుడు వేచి ఉండండి.</translation>
<translation id="2476033563817685908">పాస్‌వర్డ్‌లను ఎడిట్ చేయడానికి Phromium ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="1626952238284562558">Chromiumతో ప్రయాణంలోనూ Google Drive, YouTube వంటి మీకు ఇష్టమైన యాప్‌లను అవాంతరాలు లేకుండా సులభంగా ఉపయోగించుకోండి.</translation>
<translation id="5524890928877629608">సెర్చ్ ఏరియాకు ఎగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT" />%, ఎగువ <ph name="TOP" />%</translation>
<translation id="2860766395826060492">Chromiumలో PDFలను తెరవండి</translation>
<translation id="5536164441519929134">ఈ ట్యాబ్ గురించి<ph name="LINE_BREAK" />అడగండి</translation>
<translation id="3915500272078806319">సెక్యూరిటీ కోసం, మీరు మొదటిసారి సైట్‌ను సందర్శించినప్పుడు Phromium, JavaScript ఆప్టిమైజేషన్‌ను ఆఫ్ చేస్తుంది.

ఈ పేజీ ఆశించిన విధంగా పని చేయకపోతే, ఆప్టిమైజేషన్‌ను అనుమతించడానికి ట్రై చేయండి.</translation>
<translation id="6778733300408894918">Mac మెనూ బార్‌లో Chromiumలో Geminiని కనిపించేలా చేసి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="8411908790152555435"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి సేవ్ చేసిన మీ సమాచారాన్ని, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="5579324208890605088">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా కాకుండా ఒక సాధారణ యూజర్‌గా రన్ చేయండి.</translation>
<translation id="6578510724610627339">పిన్ అయ్యేలా చేయడానికి ఆటోమేటిక్‌గా Chromiumను ఉపయోగించండి</translation>
<translation id="5596627076506792578">మరిన్ని ఆప్షన్‌లు</translation>
<translation id="5605834417512968703">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="5618818588972826921">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా టెక్స్ట్ లేదా ఇమేజ్‌ను ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="4431270188253419020">{0,plural, =0{ఒక Phromium అప్‌డేట్ అందుబాటులో ఉంది}=1{ఒక Phromium అప్‌డేట్ అందుబాటులో ఉంది}other{ఒక Phromium అప్‌డేట్ # రోజులుగా అందుబాటులో ఉంది}}</translation>
<translation id="6903143702905157196">మీరు Chromiumను మూసివేసినప్పుడల్లా మీ పరికరంలోని సైట్ డేటాను తొలగించండి</translation>
<translation id="5354366475527026551">దయచేసి ఇప్పుడు Chromiumను మళ్ళీ ప్రారంభించండి</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">Chromiumను ఈ భాషలో ప్రదర్శించు</translation>
<translation id="569897634095159764">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. ప్రాక్సీ సర్వర్ ప్రామాణీకరణ కోరుతోంది.</translation>
<translation id="5724138350057003647">Phromium ఇన్‌యాక్టివ్ ట్యాబ్‌ల నుండి మెమరీని ఖాళీ చేస్తుంది. దీని ద్వారా యాక్టివ్ ట్యాబ్‌లకు, ఇతర యాప్‌లకు మరిన్ని కంప్యూటర్ రిసోర్స్‌లు లభిస్తాయి, దీనితో Phromium వేగంగా పని చేస్తుంది. మీ ఇన్‌యాక్టివ్ ట్యాబ్‌లకు మీరు తిరిగి వచ్చినప్పుడు, అవి ఆటోమేటిక్‌గా మళ్లీ యాక్టివ్‌గా మారతాయి. <ph name="BEGIN_LINK" />మెమరీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="3730992449058237228">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, మీ ఖాతాలోని Phromium డేటాను <ph name="SETTINGS_LINK" /></translation>
<translation id="1983042639279920602">Chromiumను అనుకూలంగా మార్చండి, కంట్రోల్ చేయండి. Chromiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి.</translation>
<translation id="7136978005010973283">Chromiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసుకోవడం ద్వారా, మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి.</translation>
<translation id="5809516625706423866">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 401 అనధికార యాక్సెస్. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="3059302031765226748">Phromium V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ Phromium అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆఫ్ చేయబడింది.</translation>
<translation id="4904710047654714935">మీ Google ఖాతాలో Phromium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, Chromiumను అప్‌డేట్ చేయండి</translation>
<translation id="5824893331272123205">ఈ ప్యానెల్‌ను లోడ్ చేయడం సాధ్యపడలేదు, మళ్లీ ట్రై చేయండి</translation>
<translation id="2582896742857095190">Chromiumకు స్వాగతం</translation>
<translation id="5004643502851105876">Phromium అత్యంత శక్తివంతమైన రక్షణలను అందించడానికి అదనపు ఫీచర్‌లను ఆన్ చేస్తుంది</translation>
<translation id="5871205389137001634">ఇమేజ్ సెర్చ్‌ నుండి ఎగ్జిట్ అవ్వడానికి క్లిక్ చేయండి</translation>
<translation id="7409018434452575206">ఈ ఐటెమ్‌లు మాల్‌వేర్‌ను కలిగి ఉన్నట్టుగా Phromium కనుగొన్నది:</translation>
<translation id="3191822983646594827">మీ బ్రౌజర్ సెట్టింగ్‌లు అత్యంత సురక్షితంగా ఉండేలా చూసుకోవడానికి Phromium క్రమం తప్పకుండా చెక్ చేస్తూ ఉంటుంది. దేనికైనా మీ రివ్యూ అవసరం అయితే, మేము మీకు తెలియజేస్తాము.</translation>
<translation id="5895138241574237353">మళ్ళీ ప్రారంభించండి</translation>
<translation id="625373791981566594">Chromiumలో Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - నెట్‌వర్క్ సైన్ ఇన్</translation>
<translation id="5924017743176219022">ఇంటర్నెట్‌కు కనెక్ట్ చేస్తోంది...</translation>
<translation id="5941711191222866238">కనిష్టీకరించు</translation>
<translation id="8650638130234822147">మీ పరికరాలన్నింటిలో ఈ బుక్‌మార్క్‌తో పాటు మరిన్ని పొందడానికి, Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="5010592102321399468">Chromiumను మీకు నచ్చినట్లు సెటప్ చేయండి</translation>
<translation id="5960071705175224773">మీ సెట్టింగ్‌లు తెలియని యాప్ ద్వారా మార్చబడ్డాయి</translation>
<translation id="5977420883993828287">పిన్ చేశారు! టూల్‌బార్ నుండి సందర్భోచితమైన టాస్క్‌లను మళ్లీ ఉపయోగించండి</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{Chromiumను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}other{Chromiumను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}}</translation>
<translation id="3160371268592376569">సింక్‌ను ప్రారంభించడానికి Chromiumను అప్‌డేట్ చేయండి</translation>
<translation id="5990360079535151574">టూల్‌బార్‌లోని "సందర్భోచితమైన టాస్క్‌లు" బటన్ నుండి, మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి సందర్భోచితమైన టాస్క్‌లను మళ్లీ తెరవవచ్చు</translation>
<translation id="6003112304606738118">డౌన్‌లోడ్ అవుతోంది... <ph name="HOURS" /> గంట(లు) సమయం మిగిలి ఉంది</translation>
<translation id="6009821354356307391">అదనపు క్వెరీని అడగండి</translation>
<translation id="6040143037577758943">మూసివేయండి</translation>
<translation id="5783572280281297164">మీ <ph name="DEVICE_TYPE" />‌లో Phromium యాప్‌ను ఉపయోగించినప్పుడు, ఆన్‌లైన్ షాపింగ్‌లో మరిన్ని ప్రయోజనాలను పొందండి</translation>
<translation id="2712461133060419287">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Chromiumకు అనుమతినివ్వండి. నోటిఫికేషన్‌లు అందుతూనే ఉంటాయి.</translation>
<translation id="7845842385196710435">&amp;Chromiumలో తెరవండి</translation>
<translation id="6069027071882229820">ఇమేజ్‌గా కాపీ చేయండి</translation>
<translation id="3752072756936611600">Chromiumకు <ph name="EXTENSION_NAME" /> జోడించబడింది</translation>
<translation id="2775066550187002528">Chromiumను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. అప్‌డేట్ అందుబాటులో ఉంది.</translation>
<translation id="6531352038528110565">ఆన్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Phromium వెరిఫై చేయలేదు</translation>
<translation id="2876078296400914679">Chromiumలో మీ ఖాతా</translation>
<translation id="3881538460441135554">Phromium టూల్‌బార్‌లో యాక్సెస్ రిక్వెస్ట్‌లను చూపడానికి ఎక్స్‌టెన్షన్‌ను అనుమతించండి</translation>
<translation id="7479187736743594081"><ph name="FILE_NAME" /> హానికరం, కావున Phromium దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="6646104775883837119">Phromium త్వరలోనే మూసివేయబడుతుంది, డేటా తొలగించబడుతుంది</translation>
<translation id="6138634751748297112">మీరు ఇక్కడ Phromium ప్రొఫైళ్ల మధ్య స్విచ్ అవ్వవచ్చు</translation>
<translation id="8660563290103481109">మీరు కుక్కీలను అనుమతిస్తే, ప్రీ - లోడ్ చేసేటప్పుడు Phromium వాటిని ఉపయోగించవచ్చు</translation>
<translation id="6165508094623778733">మరింత తెలుసుకోండి</translation>
<translation id="969667123257916656">మీ ఖాతాలో Phromium డేటాను క్లియర్ చేయండి</translation>
<translation id="5528040738212560214">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు<ph name="LINE_BREAK" />మీరు పాస్‌వర్డ్‌ను అందించినట్లయితే Phromium మీ కోసం ఈ డౌన్‌లోడ్‌ను చెక్ చేస్తుంది. ఫైల్ గురించిన సమాచారం Google సురక్షిత బ్రౌజింగ్‌కు పంపబడుతుంది, అయితే ఫైల్ కంటెంట్, పాస్‌వర్డ్ మీ పరికరంలో ఉంటాయి.</translation>
<translation id="6182736845697986886">అప్‌డేట్ సర్వర్ అంతర్గత ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="6041381825442292659">మీ <ph name="TARGET_DEVICE_NAME" />లో మీరు Chromiumకు సైన్ ఇన్ చేశారని నిర్ధారించుకుని, ఆపై మళ్లీ పంపడానికి ట్రై చేయండి.</translation>
<translation id="2474943719592372017">Phromium మినిమైజ్ అయి ఉన్నా, ఎక్కడి నుండైనా సెర్చ్ చేయవచ్చు, ప్రశ్నలు అడగవచ్చు. Chromiumను బ్యాక్‌గ్రౌండ్‌లో రన్ చేయడానికి అనుమతిస్తుంది.</translation>
<translation id="2518372260387069450">ఈ కంప్యూటర్‌లో ఇప్పటికే మరింత తాజాదైన Phromium వెర్షన్ ఉంది. సాఫ్ట్‌వేర్ పని చేయకపోతే, దయచేసి Chromiumను అన్ఇన్‌స్టాల్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="3832895416321159809">{0,plural, =0{Phromium ఇప్పుడు తిరిగి ప్రారంభించబడుతుంది}=1{1 సెకనులో Phromium తిరిగి ప్రారంభించబడుతుంది}other{# సెకన్లలో Phromium తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="2775110773501098464">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి Chromiumకు స్టోరేజ్ యాక్సెస్‌కు సంబంధించిన అనుమతి అవసరం</translation>
<translation id="3505491405575013121">Chromiumలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది</translation>
<translation id="2276249127856880228">Chromiumను డిఫాల్ట్ బ్రౌజర్‌గా చేయి</translation>
<translation id="6248988683584659830">సెర్చ్ సెట్టింగ్‌లు</translation>
<translation id="554637698797403739">మీ ఫోన్‌లోని Phromium యాప్‌తో, ప్రయాణంలోనూ Google అత్యుత్తమ సేఫ్టీ ఫీచర్‌లను పొందండి</translation>
<translation id="7016155178198587734">Phromium నుండి సైన్ అవుట్ చేయాలా?</translation>
<translation id="5660287988409470276">ఈ ట్యాబ్‌లు అదనపు రిసోర్స్‌లను ఉపయోగిస్తున్నాయి. మీ పనితీరును మెరుగుపరచడానికి, వాటిని ఇన్‌యాక్టివ్‌గా ఉంచడానికి Chromiumకు అనుమతినివ్వండి.</translation>
<translation id="8429776045186716992">మీ Phromium ప్రొఫైల్‌ను అనుకూలంగా మార్చండి</translation>
<translation id="3310436202618971091">మీ Phromium ప్రొఫైల్‌కు పేరు పెట్టండి</translation>
<translation id="1478750151648434251">ఒక ఎక్స్‌టెన్షన్ మీరు Chromiumకి సైన్ ఇన్ చేయాల్సిందిగా కోరుతోంది</translation>
<translation id="9139712828910812615"><ph name="FILE_NAME" /> హానికరం కావచ్చు, కావున Phromium దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="5191618263102115907">Phromium మీ కెమెరాను ఉపయోగిస్తోంది.</translation>
<translation id="8247508943089477519">Chromiumలో మరొక వ్యవస్థాపన జరుగుతోంది. దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="8271488218611798813">ఇప్పుడు మీ Google ఖాతాతో, షేర్ చేయ‌బ‌డిన కంప్యూట‌ర్‌ల‌లో Chromiumను సులభంగా ఉపయోగించవచ్చు.</translation>
<translation id="446228390478495078">Chromiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే, విశ్వసించే ఫీచర్‌లకు యాక్సెస్‌ను సులభంగా పొందండి.</translation>
<translation id="2203435422524224690">Phromium షార్ట్‌కట్</translation>
<translation id="3977517784144885449">ఫైల్ సాధారణంగా డౌన్‌లోడ్ అవ్వని, అలాగే ఇది ప్రమాదకరమైనది అయినందున Phromium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="8088471547690853921">మీరు ఖచ్చితంగా Chromiumను అన్ఇన్‌స్టాల్ చేయాలనుకుంటున్నారా?</translation>
<translation id="6375219077595103062">Password Managerకు షార్ట్‌కట్‌ను జోడించండి</translation>
<translation id="6388799252195623474">ఈ విషయంలో నాకు సహాయం కావాలి</translation>
<translation id="1774421040071124552">కొనసాగించడానికి, Chromiumకి <ph name="EMAIL" />‌తో సైన్ ఇన్ చేయండి. ఇది మీ సంస్థకు సంబంధించిన పాలసీలను మీరు పొందారని నిర్ధారిస్తుంది.</translation>
<translation id="2343430845154053061">కంప్యూటర్ స్క్రీన్‌లో Phromium లోగో.</translation>
<translation id="2724924185145648602">Phromium అనేది మెరుపు వేగంతో వెబ్‌పేజీలను మరియు యాప్‌ల‌ను అమలు చేసే వెబ్ బ్రౌజర్. ఇది వేగవంతమైనది, స్థిరమైనది మరియు ఉపయోగించడానికి సులభమైనది. Chromiumలో రూపొందించిన మాల్‌వేర్‌ మరియు ఫిషింగ్ రక్షణతో మరింత సురక్షితంగా వెబ్‌లో బ్రౌజ్ చేయండి.</translation>
<translation id="7417453886359805803">మీరు మీ Google ఖాతాలో Phromium డేటాను ఎల్లప్పుడూ ఉపయోగించగలరని, సేవ్ చేయగలరని నిర్ధారించుకోవడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="3304683228794166031">Phromium మరింత వేగంగా పని చేస్తుంది, JavaScriptను ఉపయోగించే ఫీచర్‌లు డిజైన్ చేసిన విధంగానే పని చేస్తాయి</translation>
<translation id="6436260184216827876">ఇమేజ్ సెర్చ్ అందుబాటులో లేదు. తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="6442900851116057561">ChromiumOSను రీస్టార్ట్ చేయండి</translation>
<translation id="9164801375934097818">Phromium మీరు సందర్శించే అవకాశం ఉన్న ఇంకా మరిన్ని పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని సందర్శించినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="2577121659922309103">ధరలను ట్రాక్ చేయడానికి, ఏదైనా సైట్‌లో ధర తగ్గినప్పుడు అలర్ట్‌లను పొందడానికి మీ ఫోన్‌లో Chromiumను డౌన్‌లోడ్ చేసుకోండి</translation>
<translation id="2052328618318278030">ఆఫ్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Phromium వెరిఫై చేయలేదు</translation>
<translation id="3122296739697671126">Phromium ప్రొఫైళ్లకు స్వాగతం</translation>
<translation id="3472445024540245926">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో Chromiumను తెరిచినప్పుడు, ట్యాబ్ గ్రూప్‌లను ఉపయోగించమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="2144084801479939969">Phromium నుండి ఖాతాను తీసివేయండి</translation>
<translation id="2473490714352939152">ఇది మీరు Chromiumని ప్రారంభించేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="648319183876919572">ప్రమాదకరమైన వెబ్‌సైట్‌ల నుండి, డౌన్‌లోడ్‌ల నుండి మెరుగైన సురక్షిత బ్రౌజింగ్ మీకు మరింత రక్షణను అందిస్తుంది</translation>
<translation id="359777544552173333">Chromiumను అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="3890462049854841354">షార్ట్‌కట్‌లు Chromiumలో తెరవబడతాయి</translation>
<translation id="6616579671682178785">Chromiumను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది. బ్రౌజింగ్ డేటా తొలగించబడింది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="8662645370371079862">ప్రతి ప్రొఫైల్‌లో బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు లాంటి దాని సొంత Phromium సమాచారం ఉంటుంది</translation>
<translation id="6556755379298048869">కీబోర్డ్ షార్ట్‌కట్‌తో సెర్చ్ చేయండి.</translation>
<translation id="7133640529688742768"><ph name="BEGIN_LINK" />Phromium మీ డేటాను ఎలా ప్రైవేట్‌గా ఉంచుతుంది<ph name="END_LINK" /> అనే దాని గురించి మరింత తెలుసుకోండి</translation>
<translation id="8316065704185291024">Phromium రీస్టార్ట్ అయిన తర్వాత ఈ సెట్టింగ్‌కు మార్పులు వర్తింపజేయడం జరుగుతుంది.</translation>
<translation id="2816396636285296289">Phromium ప్రధాన మెనూలోని ఎక్స్‌టెన్షన్‌లను క్లిక్ చేయడం ద్వారా మీ ఎక్స్‌టెన్షన్‌లను మేనేజ్ చేయండి.</translation>
<translation id="8831144879019828189">మీరు మరొక Phromium ప్రొఫైల్‌కు మారి, పాస్‌వర్డ్‌లను చూడవచ్చు</translation>
<translation id="7017911482442558099">అత్యుత్తమ AI టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లడానికి Phromium యాప్‌ను ఉపయోగించండి</translation>
<translation id="5784574554904759369">అక్షరక్రమ లోపాలను పరిష్కరించడానికి, మీరు వచన ఫీల్డ్‌లలో టైప్ చేసే వచనాన్ని, Phromium Googleకు పంపుతుంది</translation>
<translation id="8485501471305987872">Phromium నోటిఫికేషన్ సెట్టింగ్‌లకు వెళ్లు</translation>
<translation id="6600016381025017075">ఈ పేజీలో దేన్నైనా సెర్చ్ చేయండి</translation>
<translation id="1462793186918694806">మీ మార్పులు మీరు Chromiumని మరుసటిసారి ప్రారంభించినప్పుడు ప్రభావాన్ని చూపుతాయి.</translation>
<translation id="7501991510212476553">Windows ప్రారంభమైనప్పుడు Phromium ఇప్పుడు ప్రారంభమవుతుంది, కాబట్టి మీరు తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించవచ్చు. మీరు దీన్ని సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="7686308613268368175">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: Phromium మీ చివరి సెషన్ నుండి మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. మీరు వీటిలో ఆఫ్ చేయవచ్చు</translation>
<translation id="5266723901802366313">మీ పరిసరాల 3D మ్యాప్‌ను క్రియేట్ చేయడానికి Chromiumకు కెమెరా అనుమతి అవసరం</translation>
<translation id="7085315067428293799">మీ బుక్‌మార్క్‌లను Google ఖాతాలో కూడా సేవ్ చేస్తే, మీరు Chromiumలో ప్రోడక్ట్ ధరలను ట్రాక్ చేయవచ్చు, ధర తగ్గినప్పుడు తెలియజేయబడుతుంది</translation>
<translation id="6676384891291319759">ఇంటర్నెట్‌ను యాక్సెస్ చేయండి</translation>
<translation id="668175097507315160">సైన్ ఇన్ చేయడంలో ఎర్రర్ ఏర్పడినందున ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="5279767706090517695">Phromium నుండి ఈ యాప్ డేటాను తీసివేయండి</translation>
<translation id="6562226321659107531">ఈ సైట్ కోసం Chromiumకు మైక్రోఫోన్ అనుమతి అవసరం</translation>
<translation id="6712881677154121168">డౌన్‌లోడ్ చేయడంలో ఎర్రర్ ఏర్పడింది: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">మీ ప్రొఫైల్, కొత్త Phromium వెర్షన్‌కు చెందినది కాబట్టి, దీనిని ఉపయోగించడం సాధ్యపడదు.

కొన్ని ఫీచర్‌లు అందుబాటులో ఉండకపోవచ్చు. దయచేసి వేరొక ప్రొఫైల్ డైరెక్టరీని పేర్కొనండి లేదా Phromium యొక్క కొత్త వెర్షన్‌ను ఉపయోగించండి.</translation>
<translation id="4914871493602315663">వ్యక్తిగతీకరణను, ఇతర ఫీచర్‌లను పొందడానికి, Chromiumను 'వెబ్ &amp; యాప్ యాక్టివిటీ'లో, లింక్ అయిన Google సర్వీస్‌లలో చేర్చండి</translation>
<translation id="5919390816124912606">మీ కంప్యూటర్‌లోని వినియోగదారులందరికీ Phromium ఇప్పటికే ఇన్‌స్టాల్ చేయబడింది.</translation>
<translation id="5867815953973052697">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ బుక్‌మార్క్ మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="7381168634819530324">Phromium V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ Phromium అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆన్ చేయబడింది.</translation>
<translation id="1509688792864707851">{count,plural, =1{మీ Phromium డేటాలో కొంత భాగం, ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ Phromium డేటాలో కొంత భాగం, ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="4702638565169602649">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు, కాబట్టి దీనిని స్కాన్ చేయమని Phromium సిఫార్సు చేస్తోంది.</translation>
<translation id="6779406956731413166">ChromiumOS అనేది అదనపు <ph name="BEGIN_LINK_CROS_OSS" />ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS" /> ద్వారా సాధ్యమైంది.</translation>
<translation id="6831043979455480757">అనువదించు</translation>
<translation id="1564864902402454287">మీ పాస్‌వర్డ్‌లు ఎప్పుడైనా హ్యాక్ అయితే, Phromium మీకు తెలియచేస్తుంది</translation>
<translation id="684888714667046800">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. మీరు ఫైర్‌వాల్‌ను ఉపయోగిస్తుంటే, దయచేసి <ph name="PRODUCT_EXE_NAME" /> వైట్‌లిస్ట్‌లో ఉందని నిర్ధారించుకోండి.</translation>
<translation id="6200419390448865091">Phromium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">కొనసాగించడానికి ట్యాబ్ చేయండి</translation>
<translation id="6862030660799253820">ఇమేజ్ సెర్చ్‌తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="6869568587896659271">అడ్రస్ బార్ కింద వెబ్‌సైట్‌లకు సులభమైన యాక్సెస్</translation>
<translation id="4011399428346318467">"<ph name="EXTENSION_NAME" />"లో మాల్‌వేర్ ఉన్నట్టుగా Phromium కనుగొన్నది</translation>
<translation id="6877155553248388166">సెర్చ్ ఏరియాకు దిగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT" />%, దిగువ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">కాపీ చేయండి</translation>
<translation id="6898028264630240901">మీరు బ్రౌజ్ చేస్తున్నప్పుడు సులభంగా ప్రశ్నలు అడిగేందుకు సందర్భోచితమైన టాస్క్‌లను పిన్ చేయవచ్చు</translation>
<translation id="1012681980425424211">Chromiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, దానిని మీ టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="1744625657438211994">&amp;Phromium ప్రొఫైల్స్‌ను మేనేజ్ చేయండి</translation>
<translation id="7264818828956697552">ఈ చర్య కారణంగా:
          <ph name="LINE_BREAKS" />
            • మీ ప్రారంభ పేజీ, కొత్త ట్యాబ్ పేజీ, సెర్చ్ ఇంజిన్, పిన్ చేసిన ట్యాబ్‌లు రీసెట్ అవుతాయి
            <ph name="LINE_BREAK" />
            • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ అవుతాయి
            <ph name="LINE_BREAK" />
            • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
            <ph name="LINE_BREAK" />
            • Phromium షార్ట్‌కట్‌లు రీసెట్ అవుతాయి
            <ph name="LINE_BREAKS" />
            బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="6489000842445481390">మీరు Phromium పరిమితి అయిన <ph name="BOOKMARK_LIMIT" /> బుక్‌మార్క్‌లను చేరుకున్నారు, కాబట్టి మీ బుక్‌మార్క్‌లలో కొన్ని ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు.

మీరు కొన్ని బుక్‌మార్క్‌లను తొలగించే వరకు మీ ఖాతాలో కొత్త బుక్‌మార్క్‌లను సేవ్ చేయడం సాధ్యపడదు. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, సేవ్ చేయని బుక్‌మార్క్‌లు తొలగించబడతాయి.</translation>
<translation id="2645108248038996858">Phromium అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="6965382102122355670">సరే</translation>
<translation id="6985329841647292029">ChromiumOS నియమాలు</translation>
<translation id="2947519843530032104">మీ ఖాతా <ph name="ACCOUNT_EMAIL" />‌లో Phromium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="7011190694940573312">ఈ వెర్షన్ ఆపరేటింగ్ సిస్టమ్ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="7024536598735240744">డెవలపర్ మోడ్‌లో ఉన్న ఎర్రర్: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">Chromiumను మీకు నచ్చిన విధంగా తయారు చేసుకోండి</translation>
<translation id="7047386856539490735">ఈ ఫలితాలు ఉపయోగకరంగా ఉన్నాయా?</translation>
<translation id="2448910402556368916">Chromiumను అప్‌డేట్ చేయి</translation>
<translation id="7834049737623892628">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి Phromium ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Googleకు పంపబడతాయి.</translation>
<translation id="1803168627715642217">మీ <ph name="DEVICE_TYPE" />‌లో Phromium యాప్‌ను ఉపయోగించి AI సామర్థ్యాలను పొందండి</translation>
<translation id="3321731353906178474">మీ ఫోన్‌లోని Phromium యాప్‌తో మీ పాస్‌వర్డ్‌లు, ట్యాబ్‌లు, మరిన్నింటిని ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి</translation>
<translation id="7141270731789036260">Chrome for Testingను అనుకూలంగా మార్చండి</translation>
<translation id="8077731669779275332">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Chromiumను ఉపయోగించవచ్చు</translation>
<translation id="611798798247797100">Phromium నుండి <ph name="EXTENSION_NAME" />‌ను తీసివేయండి</translation>
<translation id="7962394294883785044">Phromium డేటాను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని తొలగిస్తుంది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="2611686760870033712">ఈ సైట్ కోసం Chromiumకు కెమెరా అనుమతి అవసరం</translation>
<translation id="71050417052775020">Chromiumను ప్రారంభించడం సాధ్యపడలేదు. మళ్లీ ట్రై చేయండి.</translation>
<translation id="4817060241763895497">Chromiumలో Geminiతో, మీరు ఎక్కడ ఉన్నా సరే, ఏదైనా అడగండి</translation>
<translation id="869358700049263961">Chromiumను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని మీ డాక్‌లో ఉంచుకోండి</translation>
<translation id="7094488679340739251">మీరు మెసేజ్‌లలో, డాక్యుమెంట్‌లలో, ఇంకా ఇతర యాప్‌లలో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Chromiumను ఉపయోగించండి</translation>
<translation id="7216228761061470870">మీరు డెస్క్‌టాప్‌లో ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీ టైటిల్, URL, అలాగే PDFలతో సహా అందులోని కంటెంట్ అంతా సర్వర్‌కు వెళుతుంది.</translation>
<translation id="7802634650401946711">విధి నిర్వాహకుడు - Phromium</translation>
<translation id="5182547787327636348">ఇతర యాప్‌లు లేదా ఫైల్స్ వంటి Phromium వెలుపల ఉన్న కంటెంట్ గురించి అడగండి</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో సేవ్ చేసిన మీ సమాచారాన్ని, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="5761733252154904648">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించండి: Windows ప్రారంభమైనప్పుడు Phromium ఇప్పుడు ప్రారంభించబడుతుంది.</translation>
<translation id="7274695763216404502">పిన్ చేశారు! టూల్‌బార్ నుండి ఇమేజ్ సెర్చ్‌ను మళ్లీ ఉపయోగించండి</translation>
<translation id="7288567540154601580">ట్యాబ్‌లు, ఎక్స్‌టెన్షన్‌లు</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా Phromium సిఫార్సు చేస్తోంది}other{మీరు వాటిని తీసివేయవలసిందిగా Phromium సిఫార్సు చేస్తోంది}}</translation>
<translation id="1408728332407453335">సిస్టమ్ ఆడియోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లను తెరిచి, Phromium కోసం 'సిస్టమ్ ఆడియో రికార్డింగ్ మాత్రమే'ను అనుమతించండి. ఆపై మీరు Chromiumను రీస్టార్ట్ చేయాలి.</translation>
<translation id="7299899569525778554">డెస్క్‌టాప్ నుండి సెర్చ్ చేయండి</translation>
<translation id="6194310460545162015">Chromiumని అప్‌డేట్ చేస్తోంది</translation>
<translation id="1098154893096691883">మీ ప్రాధాన్యతల ఫైల్ పాడైంది లేదా చెల్లదు. Phromium మీ సెట్టింగ్‌లను పునరుద్ధరించలేకపోయింది.</translation>
<translation id="7324051657739063017">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి మీరు సందర్భోచితమైన టాస్క్‌లను మళ్లీ తెరవవచ్చు</translation>
<translation id="7024097830259741656">మీ వెబ్, బుక్‌మార్క్‌లు మరియు ఇతర Phromium అంశాలు ఇక్కడ చూపబడతాయి.</translation>
<translation id="852511575759652041">మీ రహస్య పదబంధం ఉన్న కొంతమంది మాత్రమే ఎన్‌క్రిప్ట్ చేసిన మీ డేటాను చదవగలరు. రహస్య పదబంధం Googleకు పంపబడదు లేదా Googleలో స్టోర్ అవ్వదు. మీరు మీ రహస్య పదభందాన్ని మర్చిపోతే లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకుంటే, మీరు <ph name="BEGIN_LINK" />మీ ఖాతాలోని Phromium డేటాను తొలగించాల్సి ఉంటుంది<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505"><ph name="TARGET_URL_HOSTNAME" />ను యాక్సెస్ చేయడం కోసం <ph name="ALTERNATIVE_BROWSER_NAME" />ను తెరిచే విధంగా Chromiumను మీ సిస్టమ్ నిర్వాహకుడు కాన్ఫిగర్ చేశారు.</translation>
<translation id="7352651011704765696">ఏదో తప్పు జరిగింది</translation>
<translation id="7198690862684855451">భవిష్యత్తులో Phromium అప్‌డేట్‌లను పొందడానికి, మీకు macOS 13 కానీ, అంతకన్నా లేటెస్ట్ వెర్షన్ కానీ ఉండాలి. ఈ కంప్యూటర్ macOS 12 వెర్షన్‌ను ఉపయోగిస్తోంది.</translation>
<translation id="3224607549103501149">మీరు ఇటీవల వెళ్లలేదు. Phromium <ph name="PERMISSION_1" />,‌ <ph name="PERMISSION_2" />ను తీసివేసింది.</translation>
<translation id="73786666777299047">Chrome వెబ్ స్టోర్‌ను తెరవండి</translation>
<translation id="8446269872172461565">సిస్టమ్ ట్రేలో Chromiumలో Geminiని చూడండి</translation>
<translation id="7401687852903179959">"ఇమేజ్ సెర్చ్‌"తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="3403529853122418035">Phromium ఇప్పుడు మీ ఆటోమేటిక్ బ్రౌజర్</translation>
<translation id="5649377421626481711">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ Phromium మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. దీన్ని ఆఫ్ చేసి, ఇక్కడికి వెళ్లండి</translation>
<translation id="2467776530444676191">Chromiumకు పాస్‌వర్డ్‌లను దిగుమతి చేయండి</translation>
<translation id="8814480293815136510">1. దిగువున <ph name="BUTTON_LABEL" /> ఆప్షన్‌ను క్లిక్ చేయండి
2. మీ Windows సెట్టింగ్‌లలో <ph name="BUTTON_2" />‌ను క్లిక్ చేయండి
3. క్విక్ యాక్సెస్ కోసం Chromiumను మీ టాస్క్‌బార్‌కు పిన్ చేయడానికి, Windows నోటిఫికేషన్‌లో <ph name="BUTTON_3" />‌ను క్లిక్ చేయండి</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - Phromium Dev</translation>
<translation id="7450541714075000668">టెక్స్ట్ కాపీ చేయబడింది</translation>
<translation id="6826407056979820031">మైక్రోఫోన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="1392131731909663319">భవిష్యత్తులో Phromium అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 7ను ఉపయోగిస్తోంది.</translation>
<translation id="4512427777724578739">Chromiumను రీ-లాంచ్ చేయాలా?</translation>
<translation id="4510527847350985067">ప్రస్తుతం అమలు అవుతోన్న అదే Phromium వెర్షన్‌ను ఇన్‌స్టాల్ చేయలేరు. దయచేసి Chromiumను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="7510190804000607802">రిమైండర్: Google అత్యుత్తమ ఫీచర్‌లు ఇక ఎల్లప్పుడూ మీతోనే!</translation>
<translation id="4735608937705010375">సైట్‌లు బహుశా ఊహించిన విధంగా పని చేస్తాయి. మీరు Chromiumకు సైన్ ఇన్ చేసినట్లయితే మీ Google ఖాతా మినహా అన్ని Phromium విండోలను మూసివేసినప్పుడు మీరు చాలా సైట్‌ల నుండి సైన్ అవుట్ చేయబడతారు.</translation>
<translation id="7987051132742764178">{0,plural, =1{1 నిమిషంలో Phromium తిరిగి ప్రారంభించబడుతుంది}other{# నిమిషాల్లో Phromium తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="1904271152425995672">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Chromiumకు అనుమతినివ్వండి.</translation>
<translation id="7909976731673595773">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించడానికి Chromiumను ఆటోమేటిక్‌గా లాంచ్ చేయండి.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ఇన్‌స్టాలర్</translation>
<translation id="3301232962183130807">Phromium మీ కెమెరా మరియు మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="3230129417775002227">Phromium ఇప్పుడు మెరుగైంది</translation>
<translation id="1322165820810533683">ఇప్పుడు మీకు Chromiumలో మరిన్ని ఫీచర్లు అందుబాటులో ఉన్నాయి</translation>
<translation id="7624307931717240213">ఈ సర్వీస్‌ను మెరుగుపరచడానికి మేము సమాచారాన్ని ఉపయోగిస్తాము. గోప్యతా పాలసీని, సర్వీస్ నియమాలను చూడండి.</translation>
<translation id="7649070708921625228">సహాయం</translation>
<translation id="3795437289339745990">Phromium యాప్‌ను పొందండి</translation>
<translation id="7658239707568436148">రద్దు చేయండి</translation>
<translation id="6671257169702988694">Phromium మీ డిఫాల్ట్ బ్రౌజర్ కాదు</translation>
<translation id="7270402397025248165">మీ పరికరాల అంతటా Chromiumను సింక్ చేయండి మరియు వ్యక్తిగతీకరించండి</translation>
<translation id="6267574654655324634">Phromium అప్‌డేట్</translation>
<translation id="4868190765388740513">Chromiumలో మీ వర్క్ సురక్షితంగా ఉంటుంది</translation>
<translation id="7716950018788545737">టాస్క్(లు) ముగిసింది.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" />‌కు సిస్టమ్‌ను ట్రేస్ చేసే సర్వీస్‌లను అందిస్తోంది. ఈ సర్వీస్ డిజేబుల్ అయితే, బ్రౌజర్ ద్వారా క్రియేట్ అయిన పనితీరు ట్రేస్‌లలో కాంటెక్స్ట్ స్విచ్, సిద్ధంగా ఉన్న థ్రెడ్ ఈవెంట్‌ల వంటి సిస్టమ్ అంతటికీ సంబంధించిన ఈవెంట్‌లు ఉండవు.</translation>
<translation id="2680098142787722612">ఇది ఈ పరికరం నుండి మీ బ్రౌజింగ్ డేటాను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="7747138024166251722">ఇన్‌స్టాలర్ ఒక తాత్కాలిక డైరక్టరీని సృష్టించలేకపోయింది. సాఫ్ట్‌వేర్‌ను ఇన్‌స్టాల్ చేయడానికి దయచేసి ఖాళీ డిస్క్ స్థలం, అనుమతిని చెక్ చేయండి.</translation>
<translation id="6830826880333833598">ఆటోమేటిక్‌గా ఉండే Phromium రూపానికి రీసెట్ చేయండి</translation>
<translation id="448710321315554838">Chromiumలో మీ వర్క్‌ను సురక్షితంగా ఉంచేందుకు, మీరు Chromiumకు సైన్-ఇన్ చేసినప్పుడు మీ సంస్థ నిర్దిష్ట సమాచారాన్ని చూడగలదు లేదా మేనేజ్ చేయగలదు.</translation>
<translation id="7045209483723342691">Chromiumను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="6452735947982563207">Chromiumను వేగవంతం చేయండి</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - Phromium Canary</translation>
<translation id="6929858452581400763">మీ ఇంటర్నెట్ ట్రాఫిక్‌కు యాక్సెస్ ఉన్న వ్యక్తులు మీరు బ్రౌజ్ చేసే సైట్‌లను చూడటం కష్టతరం చేయండి. DNS (డొమైన్ నేమ్ సిస్టమ్)లో సైట్ IP అడ్రస్‌ను చూసేందుకు Phromium సురక్షితమైన కనెక్షన్‌ను ఉపయోగిస్తుంది.</translation>
<translation id="7810005234485217901">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు</translation>
<translation id="4343392731007327660">Chromiumతో దేనిని షేర్ చేయాలో ఎంచుకోండి</translation>
<translation id="3052274192923256457">ఈ పరికరంలో ఇప్పటికే ఈ ఖాతాతో ఒక Phromium ప్రొఫైల్ ఉంది</translation>
<translation id="7845233973568007926">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించడానికి ముందు మీరు కంప్యూటర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="5674414381037997114">మీ సెర్చ్ ఇంజిన్ Phromium వెలుపల నుండి మార్చబడింది. మిమ్మల్ని రక్షించడానికి, దాని ఒరిజినల్ ఆటోమేటిక్ సెట్టింగ్‌కు Phromium దాన్ని రీసెట్ చేసింది. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Chromiumకు కొత్త రూపాన్ని అందించడానికి దాన్ని అనుకూలంగా మార్చండి</translation>
<translation id="3966946337517395351">మీరు అడ్రస్ బార్‌లో లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, మెరుగైన సూచనలను పొందడానికి Phromium మీరు టైప్ చేసిన దానిని మీ ఆటోమేటిక్ సెర్చ్ ఇంజిన్‌కు పంపుతుంది. అజ్ఞాత మోడ్‌లో ఇది ఆఫ్‌లో ఉంటుంది.</translation>
<translation id="3928367799779122681">Chromiumను తాజా వెర్షన్‌కు అప్‌డేట్ చేయడం సాధ్యం కాలేదు, కాబట్టి మీరు కొత్త ఫీచర్‌లు మరియు భద్రతా పరిష్కారాలను పొందడం లేదు.</translation>
<translation id="7872446069773932638">డౌన్‌లోడ్ అవుతోంది... <ph name="SECONDS" /> సెకను(లు) సమయం మిగిలి ఉంది</translation>
<translation id="8492102592995742850">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, <ph name="BEGIN_LINK" />మీ ఖాతాలోని Phromium డేటాను తొలగించండి<ph name="END_LINK" /></translation>
<translation id="959404544431817539">మీకు అవసరమైనప్పుడల్లా Chromiumలో Geminiని త్వరగా తెరవండి</translation>
<translation id="8889749279816358185">Chromiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="3173775358556080672">వీలైనప్పుడు, Phromium ఆటోమేటిక్‌గా సురక్షితం కాని కనెక్షన్‌లను HTTPSకు అప్‌గ్రేడ్ చేస్తుంది</translation>
<translation id="2210801904933897209">మీరు <ph name="USER_EMAIL_ADDRESS" />గా Chromiumకు సైన్ ఇన్ చేశారు. దయచేసి మళ్లీ సైన్ ఇన్ చేయడానికి ఇదే ఖాతాను ఉపయోగించండి.</translation>
<translation id="7291855477503010638"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు మీ అన్ని డివైజ్‌లలో మీ బుక్‌మార్క్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="5706099517903615644">ఇది Phromium రెండవ ఇన‌స్ట‌లేష‌న్. దీన్ని మీ డిఫాల్ట్ బ్రౌజర్‌గా చేయడం సాధ్యపడదు.</translation>
<translation id="2388440031754359882">తెలియని మూలాలకు చెందిన ఎక్స్‌టెన్షన్‌లు, యాప్‌లు, రూపాలు మీ పరికరానికి హాని కలిగించవచ్చు. <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> నుండి మాత్రమే వాటిని ఇన్‌స్టాల్ చేయని Phromium సిఫార్సు చేస్తోంది</translation>
<translation id="8205108509545565485">మీ<ph name="DEVICE_TYPE" />‌లోని Phromium యాప్‌తో Google అందించే అత్యుత్తమ ప్రయోజనాలను పొందండి</translation>
<translation id="8004582292198964060">బ్రౌజర్</translation>
<translation id="8010081455002666927">ఆటోమేటిక్ గుర్తింపు</translation>
<translation id="6421861275173778152">ఓసారి Chromiumకి యాక్సెస్ లభించాక, ఆపై వెబ్‌సైట్‌లకు ఏమైనా యాక్సెస్‌ కావాలంటే అవి మిమ్మల్ని అడగవచ్చు.</translation>
<translation id="942087293138739513">Chromiumను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="80471789339884597">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించే ముందు మీరు తప్పకుండా మీ అన్ని బ్రౌజర్‌లను రీస్టార్ట్ చేయాలి.</translation>
<translation id="8054112667659782652">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="8069447462453318634">"టూల్‌బార్‌కు పిన్ చేయండి" ఆప్షన్‌ను ఎంచుకోండి</translation>
<translation id="8519423983825025511">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న Chromiumను డిజేబుల్ చేయండి</translation>
<translation id="80790299200510644">ఇమేజ్ సెర్చ్</translation>
<translation id="8086881907087796310">మీ కంప్యూటర్ కనీస హార్డ్‌వేర్ అవసరాలకు అనుగుణంగా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="7988414336652558428">ఈ సైట్ కోసం Chromiumకు లొకేషన్ అనుమతి అవసరం</translation>
<translation id="1778610353097215460">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో Chromiumను తెరిచినప్పుడు, ధర ట్రాకింగ్ అలర్ట్‌లను ఎనేబుల్ చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="4182143801062869250">మీ ఫోన్‌లోని Phromium యాప్‌తో మీకు నచ్చిన వస్తువుల ధరలు తగ్గినప్పుడు అలర్ట్‌లను పొందండి</translation>
<translation id="8118331347066725040">Lensతో సెర్చ్ చేయడం కోసం ఫీడ్‌బ్యాక్‌ను పంపండి</translation>
<translation id="849080025203861031">ఇక మీకు నచ్చినట్లుగా Phromium</translation>
<translation id="8133124826068723441">మీ డొమైన్ కోసం సింక్ అందుబాటులో లేనందున, ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="813913629614996137">ప్రారంభిస్తోంది...</translation>
<translation id="139377652856781272">కీబోర్డ్ షార్ట్‌కట్‌తో Chromiumలో Geminiని తెరవండి.</translation>
<translation id="8577594891153686998">Phromium అదనపు సర్వీస్ నియమాలు</translation>
<translation id="6418547610462348357">ఈ ఫైల్ అపాయకరమైనది, కాబట్టి Phromium దీన్ని బ్లాక్ చేసింది.</translation>
<translation id="8177472873527554730">పేజీలో కంటెంట్ కనుగొనడం సాధ్యం కాలేదు</translation>
<translation id="6257816439683677727">మీ ఖాతా, <ph name="USER_EMAIL" />‌లో Phromium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="820759916613250543">"ఇమేజ్ సెర్చ్‌"తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="8221491193165283816">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, ఇక్కడ క్లిక్ చేయండి.</translation>
<translation id="8672013454464753607">మీ కెమెరాను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="8006746139865532235">ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Phromium వెరిఫై చేయడం సాధ్యం కాదు, ఇది సురక్షితం కాకపోవచ్చు. Phromium నుండి దాన్ని తీసివేయండి, తద్వారా ఇది వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="5474258904581730105">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి Phromium ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Googleకు పంపబడతాయి. మీరు దీన్ని ఎప్పుడైనా సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="5375524124600974413">కొత్త ప్రొఫైల్‌లో Chromiumకి సైన్ ఇన్ చేయాలా?</translation>
<translation id="5242991719841602450"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Chromiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ పాస్‌వర్డ్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="6524280192518819368">సిస్టమ్ ట్రేలో Chromiumలో Geminiని చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="2082268001133511745">సురక్షితం కాని సైట్‌లు, డౌన్‌లోడ్‌ల గురించి <ph name="BEGIN_LINK" />Phromium మిమ్మల్ని హెచ్చరిస్తుంది<ph name="END_LINK" /></translation>
<translation id="4030955203048827163">మీరు ఇటీవల వెళ్లలేదు. Phromium <ph name="PERMISSION" />‌ను తీసివేసింది.</translation>
<translation id="8358344509940735943">Phromium iOS యాప్‌లో మీ కెమెరాతో మీరు చూసే వాటిని షాపింగ్ చేయండి, అనువదించండి, అలాగే గుర్తించండి</translation>
<translation id="7062802333437169650">Chromiumకు <ph name="USER_NAME" />‌గా సైన్ ఇన్ చేయడానికి QR కోడ్</translation>
<translation id="8313851650939857356">స్టార్టప్ ఎర్రర్: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062">Chromiumను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది.</translation>
<translation id="8321888067342493336">ఇమేజ్‌గా సేవ్ చేయండి</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" /> మునుపు Chromiumని ఉపయోగించింది</translation>
<translation id="5445795756751365814">Chromiumలో స్కిల్స్‌ను ఎనేబుల్ చేయండి</translation>
<translation id="7329745364783464770">మీ Google ఖాతా <ph name="ACCOUNT_EMAIL" />‌లోని Phromium డేటాను ఉపయోగించేందుకు Chromiumను అప్‌డేట్ చేయండి</translation>
<translation id="5255856786869089460">భవిష్యత్తు Phromium అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8ను ఉపయోగిస్తోంది.</translation>
<translation id="8362914115861174987">ఈ భాషలోకి అనువదించండి</translation>
<translation id="8367705492654390392">ఏదైనా అడగండి</translation>
<translation id="8370517070665726704">కాపీరైట్ <ph name="YEAR" /> సర్వ హక్కులు Google LLCకి రిజర్వ్ అయ్యాయి.</translation>
<translation id="7349410893766975486">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Chromiumకు సైన్ ఇన్ చేయండి. ఈ పాస్‌వర్డ్, మీరు సైన్ ఇన్ చేసిన తర్వాత మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="394196307309768356">ఆపై మీరు Chromiumను రీస్టార్ట్ చేయాలి.</translation>
<translation id="7466825726005300631">మీరు దాన్ని తీసివేయవలసిందిగా Phromium సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="264088846642173954">ఈ ఎక్స్‌టెన్షన్ పబ్లిషింగ్‌ను దాని డెవలపర్ రద్దు చేశారు, ఇది సురక్షితం కాకపోవచ్చు. Phromium నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="1867604241588004166">మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు Phromium ఇది మీరేనని వెరిఫై చేయాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="926481158288852551">{0,plural, =1{ఒక రోజులోపు Chromiumను తిరిగి ప్రారంభించండి}other{# రోజులలోపు Chromiumను తిరిగి ప్రారంభించండి}}</translation>
<translation id="8438543370129609977">మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించడం ద్వారా, PDFలతో పాటు పేజీ టైటిల్, URL, ఇంకా కంటెంట్ సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">Chromiumలో ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడం గురించి మరింత తెలుసుకోండి</translation>
<translation id="1069576136282928177">ఇన్‌స్టాలర్ ఆర్కైవ్ పాడైంది లేదా చెల్లదు. దయచేసి Chromiumను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="7082388216101480391">Chromiumకు Windows 10 లేదా అంతకంటే ఆధునికమైన వెర్షన్ అవసరం.</translation>
<translation id="8463672209299734063">ఆప్షనల్: Googleకు సమస్య విశ్లేషణ, అలాగే వినియోగ డేటాను ఆటోమేటిక్‌గా పంపడం ద్వారా ChromiumOS ఫీచర్‌లను, ఇంకా పనితీరును మెరుగుపరచడంలో సహాయపడండి.</translation>
<translation id="4343027289807602417">మీ Google ఖాతాలో Phromium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="6746404578800969443">Chromiumకు సైన్ ఇన్ చేయడానికి ప్రాంప్ట్‌లను చూపిస్తుంది</translation>
<translation id="5072642661707587697">Phromium కాలం చెల్లినది</translation>
<translation id="759684005114911774">మీ ఆటోమేటిక్ బ్రౌజర్‌గా Chromiumను ఎంచుకున్నందుకు ధన్యవాదాలు!</translation>
<translation id="5209258538041302334">మీరు వాటిని సేవ్ చేసినప్పుడు Phromium మీ పాస్‌వర్డ్‌లను చెక్ చేయగలదు</translation>
<translation id="8525579356836940628">ఇన్‌స్టాలేషన్ ఆగిపోయింది</translation>
<translation id="6348113608284833604">మీ <ph name="DEVICE_TYPE" />‌లోని Phromium యాప్‌తో మీ పాస్‌వర్డ్‌లు, ట్యాబ్‌లు, మరిన్నింటిని ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి</translation>
<translation id="5083347044281842800">Phromium మీ పాస్‌వర్డ్‌లలో ఒకదానిని పబ్లిక్ డేటా ఉల్లంఘనలో కనుగొంటే హెచ్చరికను పొందండి</translation>
<translation id="8555465886620020932">సర్వీస్ ఎర్రర్: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">కొన్ని Phromium ఫీచర్‌లు, ఎక్స్‌టెన్షన్‌లు షార్ట్‌కట్‌లతో వస్తాయి. మీరు వాటిని తిరిగి ఆన్ చేయడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="8556420416730706394">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు; సైడ్ ప్యానెల్‌లో ఎగువున ఉన్న 'పిన్ చేయండి' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="856656450041460113">భాష లిస్ట్‌ను సెర్చ్ చేయండి</translation>
<translation id="9159785833243360958">పలు సంస్థలు Chromiumను మేనేజ్ చేస్తాయి</translation>
<translation id="8586442755830160949">కాపీరైట్ <ph name="YEAR" /> Chromium రచయితలు. అన్ని హ‌క్కులు రిజ‌ర్వ్ చేయ‌బ‌డ్డాయి.</translation>
<translation id="3489957831482527036">Chromiumని ప్రారంభిస్తోంది...</translation>
<translation id="8624541899164515475">సెట్టింగ్‌లు, కొత్త ట్యాబ్‌లో తెరుచుకుంటాయి.</translation>
<translation id="8648201657708811153">Chrome for Testingను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం సాధ్యపడదు.</translation>
<translation id="7150069986792019616">Chromiumతో ఎక్కడి నుండైనా సెర్చ్ చేయండి</translation>
<translation id="1623850835554120265">ఇది మీరు Chromiumను ప్రారంభించేటప్పుడు లేదా ఓమ్నిబాక్స్ నుండి వెతికేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="8828478112210313529">ఈ ట్యాబ్‌ను మరొక డివైజ్‌కు పంపడానికి, అక్కడ Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3592747099485557650">ఇది మీ Phromium</translation>
<translation id="8712637175834984815">అర్థమైంది</translation>
<translation id="3388228047978619624">Chromiumకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="8747073452963259673">సెర్చ్ ఏరియాకు దిగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT" />%, దిగువ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ఇన్‌స్టలేషన్ ఎర్రర్: మీ నెట్‌వర్క్ అడ్మినిస్ట్రేటర్ ఇన్‌స్టాలేషన్‌ను నిరోధించే గ్రూప్ పాలసీని వర్తింపజేశారు: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">నాకు తర్వాత గుర్తు చేయి</translation>
<translation id="614494151403742465">త్వరగా ఓవర్‌వ్యూ పొందడానికి, ఫాలో-అప్ ప్రశ్నలు అడగడానికి, Phromium లోని Gemini తో ఈ డాక్యుమెంట్‌ను షేర్ చేయండి</translation>
<translation id="6346068443590018348">Chromiumకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="1468806565762231794">Chromiumను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="8826492472752484139">“Password Manager”ను క్లిక్ చేయండి</translation>
<translation id="8833697763442816810">ChromiumOS సిస్టమ్</translation>
<translation id="4854784568701005121">Chromiumలో మెనూలు, సెట్టింగ్‌లు, అలర్ట్‌లు, ఇతర టెక్స్ట్‌ను డిస్‌ప్లే చేయడానికి ఈ భాష ఉపయోగించబడుతుంది</translation>
<translation id="8862326446509486874">సిస్టమ్-స్థాయిలో ఇన్‌స్టాల్‌ చేయ‌డానికి మీకు సరైన హక్కులు లేవు. నిర్వాహకుడి లాగా ఇన్‌స్టాలర్‌ను మ‌ళ్లీ రన్ చేయ‌డానికి ప్రయత్నించండి.</translation>
<translation id="7804139416589625033">Phromium ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="6333867241557949259">సైన్-ఇన్ చేయడంలో ఎర్రర్ వచ్చింది. అందువల్ల ChromiumOS మీ Google ఖాతాలో Phromium డేటాను సేవ్ చేయలేకపోయింది</translation>
<translation id="2888440364511152939">మీ సంస్థ పాలసీ ప్రకారం మీరు Chromiumకు సైన్ ఇన్ చేయాలి</translation>
<translation id="7111325571010992010">Phromium పాస్‌వర్డ్‌లను చూపడానికి ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="4406716425954955281">Phromium ఇకపై మీ ఆటోమేటిక్ బ్రౌజర్‌గా ఉండదు. Chromiumను ఆటోమేటిక్ బ్రౌజర్‌గా చేయాలా?</translation>
<translation id="2999847959360823770">Chromiumని అప్‌డేట్ చేయడం సాధ్యం కాదు</translation>
<translation id="8944232836376404813">ఈ చర్య కారణంగా:
          <ph name="LINE_BREAKS" />
            • మీ ప్రారంభ పేజీ, కొత్త ట్యాబ్ పేజీ, సెర్చ్ ఇంజిన్, పిన్ చేసిన ట్యాబ్‌లు రీసెట్ చేయబడతాయి
            <ph name="LINE_BREAK" />
            • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ చేయబడతాయి
            <ph name="LINE_BREAK" />
            • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
            <ph name="LINE_BREAKS" />
            బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="7461167469691640632">Phromium సైట్ షార్ట్‌కట్‌లను చూడండి</translation>
<translation id="7394133813796947510">Phromium Enterprise లోగో</translation>
<translation id="2476839923452631964">మీ <ph name="DEVICE_TYPE" />‌లోని Phromium యాప్‌తో Google భద్రతను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి.</translation>
<translation id="2041306781031361744">మీ ప్రొఫైల్‌ను తెరుస్తున్నప్పుడు ఏదో పొరపాటు జరిగినందున Chromiumను ప్రారంభించడం సాధ్యపడలేదు. Chromiumను రీస్టార్ట్ చేయడానికి ట్రై చేయండి.</translation>
<translation id="8355079108092011401">Chromiumతో సెర్చ్ చేయడానికి లేదా <ph name="BEGIN_LINK" />సెట్టింగ్స్‌<ph name="END_LINK" />లో అనుకూలంగా మార్చడానికి</translation>
<translation id="820370893610994443">Phromium ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="1885039203623228439">Chromiumలోని Gemini, మీరు తెరిచిన ట్యాబ్ మధ్య నావిగేట్ చేయడానికి మీ కీబోర్డ్‌ను ఉపయోగించండి.</translation>
<translation id="9018218886431812662">ఇన్‌స్టాలేషన్ పూర్తయింది</translation>
<translation id="8213523024005590363">Chromiumని సురక్షితం చేయడానికి, మేము కింది ఎక్స్‌టెన్షన్‌ను నిలిపివేసాము, ఇది <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />లో లిస్ట్‌ చేయబడలేదు మరియు మీకు తెలియకుండా జోడించబడి ఉండవచ్చు.</translation>
<translation id="1376667286722804744">Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="5142314855184111999">Mac మెనూ బార్‌లో Chromiumతో సెర్చ్‌ను చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="5166485487967090892">ఈ డౌన్‌లోడ్‌ను Phromium బ్లాక్ చేసింది, ఎందుకంటే ఆ ఆర్కైవ్ ఫైల్‌లో మాల్‌వేర్‌ను దాచి ఉంచగల ఇతర ఫైల్స్ ఉన్నాయి</translation>
<translation id="1902493242619542969">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను Chromiumకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి. క్విక్ యాక్సెస్ కోసం Phromium మీ టాస్క్‌బార్‌కు పిన్ చేయబడుతుంది.</translation>
<translation id="7092992855996941035">మీ ఫోన్‌లోని Phromium యాప్‌తో Googleకు చెందిన అత్యుత్తమ AI టూల్స్‌ను ఉపయోగించుకోండి</translation>
<translation id="4203475068093609811"><ph name="DEVICE" /> నుండి మీ పాస్‌వర్డ్‌లను, మరిన్నింటిని పొందడానికి, Chromiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="7699507532215026981">మీరు ఇతర Google సర్వీస్‌లకు సైన్ ఇన్ చేసినప్పుడు Chromiumకి సైన్ ఇన్ చేయండి</translation>
<translation id="5571207595456818809">Phromium ఆటోమేటిక్‌గా మూసివేయబడింది</translation>
<translation id="3670200098293484473">Phromium కాలం చెల్లినది</translation>
<translation id="5636382052119887392">{0,plural, =1{ఒక గంటలో Phromium తిరిగి ప్రారంభించబడుతుంది}other{# గంటల్లో Phromium తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="9106236359747881194">సెర్చ్ చేయడానికి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="9197093250229894135">భవిష్యత్తులో Phromium అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8.1ను ఉపయోగిస్తోంది.</translation>
<translation id="7195134700293253698">కొత్త Phromium &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="911206726377975832">మీ బ్రౌజింగ్ డేటాను కూడా తొలగించాలా?</translation>
<translation id="9134482777260927479">హోమ్‌వర్క్‌లో సహాయం</translation>
<translation id="9148058034647219655">నిష్క్రమించండి</translation>
<translation id="8888942844777295083">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ Phromium మీ ట్యాబ్‌లను రీస్టోర్ చేయగలదు. దీన్ని ఆన్ చేయడానికి, వీటికి వెళ్లండి</translation>
<translation id="1485079858205975514"><ph name="TARGET_URL_HOSTNAME" />‌ను యాక్సెస్ చేయడం కోసం ఒక ప్రత్యామ్నాయ బ్రౌజర్‌ను తెరిచే విధంగా Chromiumను మీ సిస్టమ్ నిర్వాహకులు కాన్ఫిగర్ చేశారు.</translation>
<translation id="1096075777207775410">&amp;Chromiumను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">Chromiumను మీకు అనుకూలంగా ఉండే విధంగా వ్యక్తిగతీకరించుకోండి</translation>
<translation id="6554170182570636227">Chromiumకి ఇప్పుడు Windows XP లేదా Windows Vistaలో మద్దతు లేనందున ఇది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="8145475184469284022">ప్రయాణంలోనూ Google అత్యుత్తమ భద్రతా ఫీచర్‌లను Chromiumతో పొందండి.</translation>
<translation id="945522503751344254">ఫీడ్‌బ్యాక్ పంపండి</translation>
<translation id="1258071069834143371">Chromiumను ఎవరు ఉపయోగిస్తున్నారు?</translation>
<translation id="8272911737374467274">Phromium అత్యంత సురక్షితమైన సెక్యూరిటీని పొందండి</translation>
<translation id="983803489796659991">అప్‌డేట్ సర్వర్‌లో అప్లికేషన్ కోసం హ్యాష్ డేటా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="4087190600867587768">ఖాతా లేకుండా Chromiumను ఉపయోగించండి</translation>
<translation id="985602178874221306">Chromium రచయితలు</translation>
<translation id="989970834842471429">"ఇమేజ్ సెర్చ్‌"తో సెర్చ్ చేయడానికి టెక్స్ట్‌ను లేదా ఇమేజ్‌ను ఎంచుకోండి</translation>
<translation id="6649431194696226496">మీ లొకేషన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
</translationbundle>