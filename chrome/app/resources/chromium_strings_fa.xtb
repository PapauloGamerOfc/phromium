<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="1029669172902658969">‏راه‌اندازی مجدد برای به‌روزرسانی ChromiumOS</translation>
<translation id="7962340570690354348">‏Phromium توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="2702007788032964762">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، Phromium از سرورهای Google استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما Google متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="1051793555070215510">با تکمیل این نظرسنجی ۱ دقیقه‌ای به ما کمک کنید «حالت ناشناس» را بهبود ببخشیم.</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="4964836565882496625">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای Phromium خاموش کرده است</translation>
<translation id="8409497136174302488">‏‫Phromium برای کاوش و استفاده از دستگاه‌های اطراف به دست‌یابی به شبکه محلی نیاز دارد</translation>
<translation id="4388904545107211948">‏برای جستجو کردن افزونه یا ویژگی خاص Phromium، میان‌بر آن را در نوار نشانی تایپ کنید و به‌دنبال آن کلید صفحه‌کلید انتخابی‌تان را فشار دهید</translation>
<translation id="7188624550427159072">‏نشان دادن جستجو با Phromium در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="3689248207461565136">‏Phromium می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="112640046208448578">چیزها یا مکان‌ها را شناسایی کنید و نوشتار را کپی یا ترجمه کنید. وقتی از «جستجوی تصویر» استفاده می‌کنید، نماگرفتی از صفحه به سرور ارسال می‌شود. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">‏Phromium مرورگر پیش‌فرضتان است</translation>
<translation id="5414044255592121327">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK" />به سیستم Phromium وارد شوید<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">‏روی منو Phromium کلیک کنید</translation>
<translation id="1157985233335035034">زبان‌های اخیر</translation>
<translation id="1184145431117212167">‏نصب انجام نشد چون از نسخه Windows شما پشتیبانی نمی‌شود.</translation>
<translation id="7861581212703831457">‏درباره Phromium</translation>
<translation id="8752630985505435738">‏با Phromium در تلفنتان، هشدارهای پیگیری قیمت را دریافت کنید</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="4933432676089063712">‏‫<ph name="IMPORTANT_UPDATE" /> معلق است. برای ایمن ماندن مرور، Phromium در نوبت بعدی که به‌مدت <ph name="IDLE_DURATION" /> غیرفعال باشید، به‌روز خواهد شد.</translation>
<translation id="1232234696885483911">‏وقتی‌که «جستجوی تصویر» را باز می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به‌طور خودکار به سرور ارسال می‌شوند. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و سایر داده‌های «حساب Google» خود در Phromium استفاده کنید. برای تغییر دادن این تنظیم، به «حساب شما در Phromium» بروید.</translation>
<translation id="7402478829083317456">‏نمایش «Gemini در Phromium» در نوار منو Mac</translation>
<translation id="4902531791098430822">‏برای انتخاب بخشی از صفحه در «Gemini در Phromium»، از میان‌بر صفحه‌کلید استفاده کنید.</translation>
<translation id="9002284132405311162">‏وقتی این زبانه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت Phromium حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="5561666811965903444">‏‫Phromium این بارگیری را مسدود کرد زیرا این فایل خطرناک است</translation>
<translation id="1340271056805240721">‏وقتی با <ph name="USER_EMAIL" /> به سیستم سرویس‌های Google مثل Gmail یا YouTube وارد می‌شوید، می‌توانید به‌طور خودکار با همان حساب به سیستم Phromium وارد شوید</translation>
<translation id="5048805453292757697">‏دریافت کردن Phromium در تلفن</translation>
<translation id="1290883685122687410">خطای راه‌اندازی: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">‏راه‌اندازی نمایه Phromium جدید</translation>
<translation id="7871721155662336863">‏با «Gemini در Phromium» امتحان کنید</translation>
<translation id="6569288432960798043">‏‫Phromium برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">‏ورود به سیستم Phromium در تلفن</translation>
<translation id="1330562121671411446">تشخیص دادن زبان</translation>
<translation id="1619655755195586133">‏داده‌ها از Phromium هم حذف شود (<ph name="URL" />)</translation>
<translation id="1345251407431278948">سنجاق شد! دفعه بعد می‌توانید «جستجوی تصویر» را ازطریق این دکمه جدید در نوارابزار باز کنید</translation>
<translation id="1383876407941801731">جستجو</translation>
<translation id="2947996037737257951">‏برای ادامه مرور در حرکت، از برنامه Phromium استفاده کنید</translation>
<translation id="141901961143729572">افکارتان را هم‌رسانی</translation>
<translation id="8355386219605656974">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Phromium مجاز کنید.</translation>
<translation id="1478370723027452770">‏دریافت راهنمایی درباره Chrome for Testing</translation>
<translation id="8398257182826094665">‏برای دریافت اطلاعات ذخیره‌شده و سایر موارد از <ph name="DEVICE" />، به سیستم Phromium وارد شوید</translation>
<translation id="1497802159252041924">خطای نصب: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">این صفحه محافظت شده است</translation>
<translation id="3484755999946650557">‏هم‌رسانی برگه Phromium</translation>
<translation id="3309377459597801353">‏ورود به سیستم Phromium</translation>
<translation id="1547469039832541117">تکلیف برجسته‌شده را به‌پایان می‌رساند.</translation>
<translation id="2354363290397602683">‏سنجاق کردن Phromium</translation>
<translation id="2244728813494358888">‏ابزارهای ایمنی Phromium</translation>
<translation id="707582364915018531">‏‫Phromium می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="5032531544901236587">‏با برنامه Phromium در تلفنتان، بیشترین بهره را از Google ببرید</translation>
<translation id="7311082384439462587">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Phromium</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="1665602916345474427">با <ph name="USER_NAME" />، <ph name="USER_EMAIL" />، عضویت به سیستم وارد شده‌اید. باز کردن منو حساب</translation>
<translation id="4535436467771816034">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Phromium باز کنید. این برنامه به نوار وظیفه هم سنجاق خواهد شد.</translation>
<translation id="1709772298389099340">امتیازهای عالی برای <ph name="BROWSER_NAME" /> ارائه می‌دهد.</translation>
<translation id="1722488837206509557">این کار به شما امکان می‌دهد از بین دستگاه‌های دردسترس انتخاب کنید و محتوا را در آن‌ها نمایش دهید.</translation>
<translation id="3550860956769006392">‏Phromium به‌زودی داده‌های مرور را حذف می‌کند</translation>
<translation id="2053384509423635834">‏Phromium سعی می‌کند پیمایش‌ها را به HTTPS ارتقا دهد</translation>
<translation id="2516115567501600458">‏داده‌های Phromium پاک شد</translation>
<translation id="8571959122390670188">‏Phromium تا <ph name="REMAINING_TIME" /> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="6284080675125981628">‏وقتی HTTPS دردسترس نباشد، Phromium بدون دادن هشدار به شما از اتصال ناامن استفاده می‌کند</translation>
<translation id="5872244334553252095">‏اجازه به Phromium برای اجرا در پس‌زمینه</translation>
<translation id="2213761221916953829">‏برای ایمن‌تر کردن Phromium، برخی از افزونه‌هایی را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست شده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="8807881428325438878">‏روی <ph name="BEGIN_BOLD" />بله<ph name="END_BOLD" /> در اعلان Windows کلیک کنید تا Phromium را برای دسترسی سریع به نوار وظیفه سنجاق کنید.</translation>
<translation id="6861833596843600606">‏نصب مجدد Phromium</translation>
<translation id="3950056404221550225">‏Phromium در تلاش است <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="2018401790887358950">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Phromium وارد شوید. همچنین افزونه‌ها و سایر موارد را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="6114726049187747242">‏دفعه بعد که Phromium را در <ph name="DEVICE_TYPE" /> باز می‌کنید، پیام‌واره‌ای برای استفاده از «مدیر گذرواژه Google» خواهید دید.</translation>
<translation id="1838374766361614909">پاک کردن جستجو</translation>
<translation id="2724678689951174927">‏برای حذف کردن داده‌های مرور فقط از این دستگاه و نگهداری آن در «حساب Google»، <ph name="BEGIN_LINK" />از سیستم Phromium خارج شوید<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">‏با بارگیری Phromium در تلفنتان، درحال حرکت گروه‌های زبانه جدید باز کنید یا بسازید.</translation>
<translation id="3191814926523151519">‏می‌توانید «حساب‌های Google» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های Google» شما در مرورگر Phromium، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE" /> خود اضافه کنید. <ph name="LINK_BEGIN" />بیشتر بدانید<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">جستجو کردن با «جستجوی تصویر»</translation>
<translation id="5453573140402957471">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Phromium وارد شوید. همچنین نشانک‌ها و موارد دیگر را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="1880677175115548835">انتخاب نوشتار</translation>
<translation id="1236934630660512644">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Phromium خود را می‌دهید. داده‌های Phromium شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Google حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های Phromium موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">‏‫Phromium با محدود کردن فعالیت پس‌زمینه و جلوه‌های دیداری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند. <ph name="BEGIN_LINK" />درباره «بهینه‌سازی انرژی» بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">‏سرویس به‌روزرسان Phromium</translation>
<translation id="5797624919204275541">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Phromium به سیستم سایت‌های Google مانند Gmail وارد شوید</translation>
<translation id="6850971726764387814">‏Phromium پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="8289779763124483945">‏سازمانتان (<ph name="MANAGER" />) شما را ملزم می‌کند به سیستم Phromium وارد شوید</translation>
<translation id="193439633299369377">‏برای اعمال به‌روزرسانی، ChromiumOS باید بازراه‌اندازی شود.</translation>
<translation id="3215238748514810076">‏‫Phromium این بارگیری را مسدود کرد زیرا این نوع فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE" /> دقیقه باقی مانده است</translation>
<translation id="8529252122707161160">‏Phromium نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="197326043290947695">با «جستجوی تصویر» هوشمندانه‌تر مرور کنید</translation>
<translation id="7769772561254542263">‏ببینید چرا Phromium برخی‌از فایل‌ها را مسدود می‌کند، در زبانه جدید باز می‌شود</translation>
<translation id="3713013456746186442">‏نرم‌افزار Phromium را به‌روز نگه می‌دارد. اگر این سرویس غیرفعال یا متوقف شود، نرم‌افزار Phromium به‌روز نخواهد ماند، به این معنی که آسیب‌پذیری‌های امنیتی احتمالی برطرف نمی‌شود و ممکن است ویژگی‌ها کار نکنند. این سرویس زمانی‌که هیچ نرم‌افزار Phromium از آن استفاده نکند، خود را حذف نصب می‌کند.</translation>
<translation id="5690439379999550641">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Phromium وارد شوید.</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="2039417478970545937">تنظیمات.</translation>
<translation id="4765042254400173473">‏انتخاب کنید که آیا سابقه Phromium برای تجربه‌های شخصی‌شده‌تر در سرویس‌های Google لحاظ شود یا نه</translation>
<translation id="1448229429009113044">‏این ویژگی در Phromium تعبیه شده است تا به شما در ساختن، ذخیره، و تکمیل خودکار گذرواژه‌های قوی کمک کند. برای دسترسی آسان، میان‌بر را اضافه کنید</translation>
<translation id="2145664943269651168">‏روی دکمه «سفارشی‌سازی Phromium» در «صفحه زبانه جدید» کلیک کنید و ظاهری جدید به Phromium ببخشید</translation>
<translation id="6052463185672312901">‏‫Phromium این بارگیری را مسدود کرد زیرا این فایل فریب‌دهنده است و ممکن است تغییرات غیرمنتظره‌ای در دستگاهتان ایجاد کند</translation>
<translation id="3825064703718009924">‏دفعه بعد که Phromium iOS را باز می‌کنید، پیام‌واره‌ای برای امتحان کردن «<ph name="FEATURE_NAME" />» خواهید دید.</translation>
<translation id="886729435477608858">‏گذرواژه‌ها و دیگر داده‌های Phromium که در «حساب Google» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Phromium، دوباره به سیستم وارد شوید.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Phromium استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}one{‏اگر به‌مدت # دقیقه از Phromium استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}other{‏اگر به‌مدت # دقیقه از Phromium استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}}</translation>
<translation id="2125838419757773031">بخشی از صفحه‌نمایش را برای جستجو انتخاب کنید</translation>
<translation id="2126108037660393668">فایل بارگیری‌شده تأیید نشد.</translation>
<translation id="2135919691573380097">گزارش کردن این سایت</translation>
<translation id="2137162749895930932">بستن صفحه ترجمه</translation>
<translation id="2147218225094845757">پنهان کردن پانل کناری</translation>
<translation id="1628700182434635922">‏‫Phromium این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="2170098639895543546">هر چیزی در صفحه را انتخاب کنید</translation>
<translation id="1807571394075492085">‏سفارشی کردن Phromium</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
<translation id="8332848361915479268">‏Phromium - ورود به سیستم شبکه - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">خطای بررسی به‌روزرسانی: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">‏برداشتن حساب از Phromium</translation>
<translation id="6063124961634921864">‏برای داشتن بهترین ابزارهای خرید درحرکت، از برنامه Phromium استفاده کنید</translation>
<translation id="8646569091716523420">‏با «مرور ایمن پیشرفته» در Phromium برای iOS، درحرکت ایمن‌تر مرور کنید</translation>
<translation id="3084983792533696835">‏سایت خطرناک. ‫Phromium اعلان‌ها را برداشت.</translation>
<translation id="2236949375853147973">فعالیت‌هایم</translation>
<translation id="6387327671844988108">‏برای دریافت نشانی‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Phromium وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانی در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="722050260205928409">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و Phromium را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="703211526866942526">‏مهارت‌ها در Phromium</translation>
<translation id="2283803047247799269">این زبانه با «جستجوی تصویر» جستجو شود</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{‏‫Phromium توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Phromium توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Phromium توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="2307973900865360088">‏نگه داشتن در Dock</translation>
<translation id="6083276764640161328">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Phromium ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Phromium ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
<translation id="2356070529366658676">سؤال شود</translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="741972887620936671">‏افزونه «<ph name="EXTENSION_NAME" />» از شما می‌خواهد به سیستم Phromium وارد شوید</translation>
<translation id="4709464915929597251">‏غیرفعال کردن اجرای Phromium در پس‌زمینه برای برنامه‌ها</translation>
<translation id="6804933363437420201">‏برای استفاده از این افزونه با حساب <ph name="USER_EMAIL_ADDRESS" />، به سیستم Phromium وارد شوید.</translation>
<translation id="2384373936468275798">‏ChromiumOS نتوانست داده‌های شما را همگام‌سازی کند زیرا جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Phromium به یک «دستگاه میانای انسانی» (HID) دسترسی داشتند}=1{‏یک یا چند افزونه Phromium به یک «دستگاه میانای انسانی» (HID) دسترسی دارند}one{‏یک یا چند افزونه Phromium به # «دستگاه میانای انسانی» (HID) دسترسی دارند}other{‏یک یا چند افزونه Phromium به # «دستگاه میانای انسانی» (HID) دسترسی دارند}}</translation>
<translation id="1394893265611797679">‏Phromium برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="2403703063067034158">خطای راه‌اندازی: فعلاً راه‌اندازی دیگری درحال اجرا است، لطفاً کمی بعد دوباره امتحان کنید.</translation>
<translation id="8457868297375575309">‏پیوندها را از هر برنامه‌ای در Phromium باز کنید و مرورگر را در نوار وظیفه دردسترس نگه دارید</translation>
<translation id="5354209517289935579">‏برای هم‌رسانی این سند با Gemini در Phromium و دریافت مرور کوتاه و پرسیدن سؤالات تعقیبی، روی دکمه «خلاصه کردن» کلیک کنید</translation>
<translation id="6628402244681586711">‏با <ph name="BEGIN_LINK" />ابزارهای Phromium<ph name="END_LINK" />، می‌توانید به‌طور ایمن مرور کنید و کنترل را دردست بگیرید</translation>
<translation id="6454834963905669297">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Phromium وارد شوید. همچنین گذرواژه‌هایتان و اطلاعات دیگر را در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="2451727308784734061">از میان‌بر برای دسترسی سریع به «مدیر گذرواژه» استفاده کنید. می‌توانید میان‌برتان را به صفحه اصلی رایانه یا راه‌انداز برنامه منتقل کنید.</translation>
<translation id="1593547119543498467">‏Phromium به‌زودی بسته می‌شود</translation>
