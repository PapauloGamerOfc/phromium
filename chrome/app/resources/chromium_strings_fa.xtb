<translation id="8232968781653330429">‏داده‌هایتان بااستفاده از گذرعبارت شما رمزگذاری شده است. برای استفاده از داده‌های Phromium و ذخیره کردن این داده‌ها در «حساب Google»، این گذرعبارت را وارد کنید.</translation>
<translation id="2945997411976714835">خطای نصب: فرایند نصب‌کننده شروع نشد.</translation>
<translation id="5624652745932625503">‏با گذرواژه‌های ذخیره‌شده برای Phromium در iOS، در سایت‌ها سریع‌تر به سیستم وارد شوید</translation>
<translation id="8821179372057577828">‏سازمان شما Phromium را مدیریت می‌کند</translation>
<translation id="741172935898285572">‏Phromium به‌روز است</translation>
<translation id="8798708493876822519">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Phromium ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند</translation>
<translation id="6896740867011823632">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به سیستم Phromium وارد شوید</translation>
<translation id="3003694935412297923">همه تکلیف‌ها</translation>
<translation id="3580865868015023718">{count,plural, =1{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Google» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Phromium باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Google» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Phromium باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Google» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Phromium باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="1211179250505223767">‏‫<ph name="URL" /> در زبانه جدیدی در Phromium باز می‌شود.</translation>
<translation id="4742400838355945730">‏نوآوری‌های هوشواره، مانند «مهارت‌ها»، در «حساب Google» شما ذخیره می‌شود و جدا از همگام‌سازی Phromium مدیریت می‌شوند</translation>
<translation id="8070050512429584052">‏برای دریافت افزونه‌ها و سایر موارد در همه دستگاه‌هایتان، به سیستم Phromium وارد شوید</translation>
