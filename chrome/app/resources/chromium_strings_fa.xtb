<translation id="1069576136282928177">‏بایگانی نصب‌کننده خراب یا نامعتبر است. لطفاً Phromium را دوباره را بارگیری کنید.</translation>
<translation id="7082388216101480391">‏Phromium به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="8463672209299734063">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به Google، به بهبود ویژگی‌ها و عملکرد ChromiumOS کمک کنید.</translation>
<translation id="4343027289807602417">‏برای ذخیره کردن داده‌های Phromium در «حساب Google» خود و استفاده کردن از آن‌ها، هویتتان را درستی‌سنجی کنید</translation>
<translation id="6746404578800969443">‏پیام‌واره‌های ورود به سیستم Phromium را نشان می‌دهد</translation>
<translation id="5072642661707587697">‏نسخه Phromium قدیمی است</translation>
<translation id="759684005114911774">‏از اینکه Phromium را به‌عنوان مرورگر پیش‌فرض خود انتخاب کردید سپاس‌گزاریم!</translation>
<translation id="5209258538041302334">‏‫Phromium زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید</translation>
<translation id="8525579356836940628">نصب متوقف شد</translation>
<translation id="6348113608284833604">‏با برنامه Phromium در<ph name="DEVICE_TYPE" />، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحرکت همراه خود داشته باشید</translation>
<translation id="5083347044281842800">‏اگر Phromium یکی از گذرواژه‌هایتان را در سرقت اطلاعات شبکه عمومی پیدا کند، هشدار دریافت می‌کنید</translation>
<translation id="8555465886620020932">خطای سرویس: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">‏برخی‌از ویژگی‌ها و افزونه‌های Phromium دارای میان‌بر هستند. می‌توانید انتخاب کنید که آن‌ها را دوباره روشن کنید.</translation>
<translation id="8556420416730706394">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید؛ روی دکمه «سنجاق کردن» در بالای پانل کناری کلیک کنید</translation>
<translation id="856656450041460113">جستجوی فهرست زبان‌ها</translation>
<translation id="9159785833243360958">‏چندین سازمان Phromium را مدیریت می‌کنند</translation>
<translation id="8586442755830160949">‏حق نشر <ph name="YEAR" /> نویسندگان Chromium. کلیه حقوق محفوظ است.</translation>
<translation id="3489957831482527036">‏درحال راه‌اندازی Phromium…</translation>
<translation id="8624541899164515475">«تنظیمات»، در زبانه جدیدی باز می‌شود.</translation>
<translation id="8648201657708811153">‏نمی‌توان Google Chrome for Testing را به‌عنوان مرورگر پیش‌فرض تنظیم کرد.</translation>
<translation id="7150069986792019616">‏جستجو کردن با Phromium از هرجا</translation>
<translation id="1623850835554120265">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Phromium یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="8828478112210313529">‏برای ارسال این زبانه به دستگاهی دیگر، در آن جا به سیستم Phromium وارد شوید</translation>
<translation id="3592747099485557650">‏این Phromium شماست</translation>
<translation id="8712637175834984815">متوجه شدم</translation>
<translation id="3388228047978619624">‏به سیستم Phromium وارد می‌شوید؟</translation>
<translation id="8747073452963259673">‏گوشه پایین سمت راست ناحیه جستجو: ‎٪<ph name="LEFT" /> سمت راست، ‎٪<ph name="BOTTOM" /> پایین</translation>
<translation id="878572486461146056">خطای نصب: سرپرست شبکه شما «خط‌مشی گروهی» اعمال کرده است که از نصب جلوگیری می‌کند: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">بعداً به من یادآوری شود</translation>
<translation id="614494151403742465">‏این سند را با «Gemini در Phromium» هم‌رسانی کنید تا مرور کوتاهی از آن داشته باشید و سؤالات تعقیبی بپرسید</translation>
<translation id="6346068443590018348">‏به سیستم Phromium وارد می‌شوید؟</translation>
<translation id="1468806565762231794">‏تنظیم کردن Phromium به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن به نوار وظیفه</translation>
<translation id="8826492472752484139">روی «مدیر گذرواژه» کلیک کنید</translation>
<translation id="8833697763442816810">‏سیستم ChromiumOS</translation>
<translation id="4854784568701005121">‏این زبان برای نمایش منوها، تنظیمات، هشدارها، و نوشتارهای دیگر در Phromium استفاده می‌شود</translation>
<translation id="8862326446509486874">شما حقوق لازم برای نصب در سطح سیستم را ندارید. دوباره به‌عنوان سرپرست نصب‌کننده را اجرا کنید.</translation>
<translation id="7804139416589625033">‏افزودن نمایه Phromium</translation>
<translation id="6333867241557949259">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromiumOS نتوانست داده‌های Phromium را در «حساب Google» شما ذخیره کند</translation>
<translation id="2888440364511152939">‏سازمانتان شما را ملزم می‌کند به سیستم Phromium وارد شوید</translation>
<translation id="7111325571010992010">‏Phromium در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="4406716425954955281">‏‫Phromium دیگر مرورگر پیش‌فرض شما نیست. Phromium  مرورگر پیش‌فرض شود</translation>
<translation id="2999847959360823770">‏به‌روزرسانی Phromium امکان‌پذیر نیست</translation>
<translation id="8944232836376404813">این کنش:
          <ph name="LINE_BREAKS" />
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK" />
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK" />
            • کوکی‌ها و سایر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAKS" />
            نشانک‌ها، سابقه و گذرواژه‌های ذخیره‌شده شما تحت تأثیر قرار نخواهند گرفت.</translation>
<translation id="7461167469691640632">‏نشان دادن میان‌برهای سایت Phromium</translation>
<translation id="7394133813796947510">‏نشان‌واره Phromium Enterprise</translation>
<translation id="2476839923452631964">‏با برنامه Phromium در <ph name="DEVICE_TYPE" />، ایمنی Google را درحرکت داشته باشید</translation>
<translation id="2041306781031361744">‏‫Phromium شروع نشد، زیرا هنگام باز کردن نمایه‌تان مشکلی پیش آمد. ‫Phromium را بازراه‌اندازی کنید.</translation>
<translation id="8355079108092011401">‏تا با Phromium جستجو کنید یا در <ph name="BEGIN_LINK" />تنظیمات<ph name="END_LINK" /> سفارشی‌سازی کنید</translation>
<translation id="820370893610994443">‏مدیریت نمایه‌های Phromium</translation>
<translation id="1885039203623228439">‏از صفحه‌کلید برای پیمایش بین «Gemini در Phromium» و زبانه باز استفاده کنید.</translation>
<translation id="9018218886431812662">نصب کامل شد</translation>
<translation id="8213523024005590363">‏برای ایمن‌تر کردن Phromium، افزونه زیر را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست نشده است و ممکن است بدون اطلاع شما اضافه شده باشد، غیرفعال کردیم.</translation>
<translation id="1376667286722804744">‏ورود به سیستم Phromium</translation>
<translation id="5142314855184111999">‏نشان دادن جستجو با Phromium در نوار منو Mac و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="5166485487967090892">‏‫Phromium این بارگیری را مسدود کرد زیرا فایل بایگانی حاوی فایل‌های دیگری است که ممکن است بدافزار باشد</translation>
<translation id="1902493242619542969">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Phromium، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید. ‫Phromium برای دسترسی سریع به نوار وظیفه سنجاق خواهد شد.</translation>
<translation id="7092992855996941035">‏با برنامه Phromium در تلفنتان از بهترین ابزارهای هوشواره‌ای Google استفاده کنید</translation>
<translation id="4203475068093609811">‏برای دریافت گذرواژه‌ها و سایر موارد از <ph name="DEVICE" />، به سیستم Phromium وارد شوید</translation>
<translation id="7699507532215026981">‏ورود به سیستم Phromium هنگام وارد شدن به سیستم دیگر سرویس‌های Google</translation>
<translation id="5571207595456818809">‏Phromium به‌طور خودکار بسته شد</translation>
<translation id="3670200098293484473">‏نسخه Phromium قدیمی است</translation>
<translation id="5636382052119887392">{0,plural, =1{‏Phromium یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏Phromium # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏Phromium # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="9106236359747881194">نوشتاری را برای جستجو انتخاب کنید</translation>
<translation id="9197093250229894135">‏برای دریافت به‌روزرسانی‌های آتی Phromium، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8.1 استفاده می‌کند.</translation>
<translation id="7195134700293253698">‏باز کردن پیوند در &amp;برگه جدید Phromium</translation>
<translation id="911206726377975832">داده‌های مرور شما نیز حذف شود؟</translation>
<translation id="9134482777260927479">کمک در تکالیف</translation>
<translation id="9148058034647219655">خارج شدن</translation>
<translation id="8888942844777295083">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Phromium می‌تواند هربار که آن را بازراه‌اندازی می‌کنید، زبانه‌هایتان را بازگرداند. برای روشن کردن این ویژگی، به اینجا بروید:</translation>
<translation id="1485079858205975514">‏سرپرست سیستم شما برای باز شدن مرورگر جایگزین برای دسترسی به <ph name="TARGET_URL_HOSTNAME" />، Phromium را پیکربندی کرده است.</translation>
<translation id="1096075777207775410">‏راه‌اندازی مجدد برای به‌روزرسانی Phromium</translation>
<translation id="5762505165968040132">‏Phromium‏ (mDNS ورودی)</translation>
<translation id="6687502817616773473">‏شخصی‌سازی کردن Phromium</translation>
<translation id="6554170182570636227">‏Phromium ممکن است درست کار نکند زیرا دیگر در Windows XP یا Windows Vista پشتیبانی نمی‌شود</translation>
<translation id="8145475184469284022">‏با Phromium، بهترین ویژگی‌های ایمنی Google را در حرکت دریافت کنید.</translation>
<translation id="945522503751344254">ارسال بازخورد</translation>
