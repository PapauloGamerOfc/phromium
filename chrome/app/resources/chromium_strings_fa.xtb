<translation id="919456815618829047">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Phromium وارد شوید. همچنین فهرست خواندن و سایر موارد را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="6141754610526066487">‏دیگر نمایه‌های Phromium</translation>
<translation id="2380720899384114679">‏افزونه‌ها برافزاهایی هستند که به شما امکان می‌دهند Phromium را سفارشی‌سازی کنید. از مرتب ماندن گرفته تا ساده‌سازی تکالیف روزمره، افزونه‌ها به شما کمک می‌کنند Phromium را مختص خودتان کنید.</translation>
<translation id="2507281899032275020">‏با ارسال گزارش‌های خرابی و <ph name="UMA_LINK" /> به Google، به بهبود Google کمک کنید</translation>
<translation id="1514966729948178660">‏برای داشتن ایمنی Google در حرکت، از برنامه Phromium استفاده کنید</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Phromium به یک دستگاه USB دسترسی داشتند}=1{‏یک یا چند افزونه Phromium به یک دستگاه USB دسترسی دارند}one{‏یک یا چند افزونه Phromium به # دستگاه USB دسترسی دارند}other{‏یک یا چند افزونه Phromium به # دستگاه USB دسترسی دارند}}</translation>
<translation id="78720743239019396">‏برای دریافت فهرست خواندن و سایر موارد از <ph name="DEVICE" />، به سیستم Phromium وارد شوید</translation>
<translation id="7000206277447032115">‏سابقه Phromium</translation>
<translation id="4555002192651219296">‏نصب‌کننده در خارج کردن بایگانی از حالت فشرده ناموفق بود. لطفاً دوباره Phromium را بارگیری کنید.</translation>
<translation id="310459126943037700">تکلیف(ها) پایان نیافت.</translation>
<translation id="3104828284009500087">جستجو کردن هر چیزی در صفحه</translation>
<translation id="4867557516756736957">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Phromium، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید.</translation>
<translation id="8632308594821621017">‏Phromium درحال استفاده از میکروفون شما است.</translation>
<translation id="3130333203120345554">جستجوی جدید</translation>
<translation id="3137969841538672700">برای جستجو، بخش موردنظر را بکشید</translation>
<translation id="9173792796158381383">‏این زبانه از منابع اضافی استفاده می‌کند. برای بهبود عملکرد، اجازه دهید Phromium آن را غیرفعال کند.</translation>
<translation id="8874679893080632357">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Phromium مجاز کنید</translation>
<translation id="101045618220347251">‏اجرای مجدد Phromium</translation>
<translation id="3161522574479303604">همه زبان‌ها</translation>
<translation id="5940989267583033306">‏باز کردن پیوند در پنجره &amp;ناشناس Phromium</translation>
<translation id="2045477525210426976">‏سفارشی کردن نمایه جدید Phromium</translation>
<translation id="3540518135502114323">‏می‌توانید بدون عوض کردن زبانه، به گپ زدن با «حالت هوشواره‌ای» ادامه دهید. برای شروع، به سیستم Phromium وارد شوید. گذرواژه‌هایتان و اطلاعات دیگر را نیز در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="1496180326063744749">‏برای برداشتن «حساب Google» خود از Phromium، در صفحه «تنظیمات» از سیستم Phromium خارج شوید</translation>
<translation id="7792783034323745412">‏بعداً Phromium می‌تواند از شما بپرسد که آیا می‌خواهید از اطلاعات ذخیره‌شده برای تکمیل خودکار فرم‌ها استفاده کنید</translation>
<translation id="5240091371721695404">‏Phromium نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد:
<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">‏با Phromium در iOS، ابزارهای هوشواره Google دلخواهتان را درحرکت همراه داشته باشید.</translation>
<translation id="4848363951707149242">‏برای دریافت افزونه‌ها و سایر موارد از <ph name="DEVICE" />، به سیستم Phromium وارد شوید</translation>
<translation id="3286538390144397061">راه‌اندازی مجدد اکنون</translation>
<translation id="8613877111531019527">‏کلیدهای Google API وجود ندارند. برخی از عملکردهای Phromium از کار خواهند افتاد.</translation>
<translation id="2784090498377460662">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه Phromium بسته می‌شود</translation>
<translation id="3905054486991167751">‏‫Chrome وقتی که از دستگاه استفاده نمی‌کنید به‌روز خواهد شد</translation>
<translation id="4502950976754616266">‏Phromium قبل‌از اینکه هر سایتی را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="6107453188231652861">‏وقتی همه پنجره‌های Phromium را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Phromium وارد شده باشید از «حساب Google» خارج نخواهید شد. برای اینکه سایت‌ها شما را به‌خاطر بسپارند، <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">‏گوشه بالا سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT" /> سمت چپ، ‎٪<ph name="TOP" /> بالا</translation>
<translation id="5896635343289575401">‏داده‌های Phromium در حساب شما</translation>
<translation id="5662253013097242821">‏از گذرواژه‌هایتان با Phromium در تلفنتان استفاده کنید</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">‏به نمایه Phromium موجود می‌روید؟</translation>
<translation id="3412460710772753638">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="657700335789940813">‏‫Phromium می‌خواهد به‌روز شود</translation>
<translation id="3487742274367151379">‏برای دریافت نشانک‌ها و سایر موارد از <ph name="DEVICE" />، به سیستم Phromium وارد شوید</translation>
<translation id="3438772217992559640">جستجوی این زبانه با «جستجوی تصویر»</translation>
<translation id="8062355070850891600">‏«مرور ایمن پیشرفته» را با Phromium در تلفنتان گسترش دهید</translation>
<translation id="5419337472918920970">‏درحال شخصی‌سازی Phromium…</translation>
<translation id="6573105037542661278">‏این کار <ph name="ITEMS_COUNT" /> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Phromium وارد شوید.</translation>
<translation id="4600986251755456192">‏با <ph name="SHORTCUT" /> می‌توانید بین نمایه‌های Phromium جابه‌جا شوید</translation>
<translation id="8118189978246431067">‏لطفاً همه پنجره‌های Phromium را ببندید و دوباره سعی کنید.</translation>
<translation id="7430418346833889620">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Phromium مجاز کنید</translation>
<translation id="2943929290955142701">‏‫<ph name="EXISTING_USER" /> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Phromium وارد شوید.</translation>
<translation id="5896697187441340113">‏رمزینه پاسخ‌سریع برای بارگیری مرورگر Phromium در دستگاه‌های همراه</translation>
<translation id="354621070532799440">‏یادآور: بهترین ویژگی‌های ایمنی Google در جیب شما</translation>
<translation id="6718500626359284607">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Phromium مجاز کنید.</translation>
<translation id="6511372913460632136">‏محافظت بهبودیافته، بهینه‌سازی جاوا اسکریپت را برای سایت‌هایی که Phromium آن‌ها را نمی‌شناسد، خاموش می‌کند</translation>
<translation id="3597003331831379823">راه‌اندازی با امتیازهای عالی اجرا نشد. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">‏ورود به سیستم Phromium</translation>
<translation id="8702816719621016911">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL" /> به سیستم Phromium وارد شوید.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای Phromium در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای Phromium در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای Phromium در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای Phromium در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="3667616615096815454">نصب نشد، برنامه برای سرور ناشناس است.</translation>
<translation id="678730369472836428">‏استفاده از <ph name="BEGIN_LINK" />گذرعبارت خودتان<ph name="END_LINK" /> برای رمزگذاری همه داده‌های Phromium موجود در «حساب Google» شما. روش‌های پرداخت و نشانی‌های موجود در Google Pay رمزگذاری نخواهند شد. سابقه مرور Phromium همگام‌سازی نخواهد شد.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="2203303261468330007">‏باز کردن پیوند در &amp;برگه جدید Phromium</translation>
<translation id="686463893976008238">‏برای شخصی‌سازی و اهداف بیشتر، Phromium و دیگر سرویس‌های Google را به‌هم پیوند دهید</translation>
<translation id="3729187154190517324">بااستفاده از دکمه «افزودن زبانه و موارد دیگر»، چند زبانه، فایل، و ابزار اضافه کنید و جستجویتان را عمیق‌تر کنید.</translation>
<translation id="5596264049590907430">‏مدیریت نمایه‌های Phromium</translation>
<translation id="5594723037153142396">‏ببینید چرا Phromium برخی‌از بارگیری‌ها را مسدود می‌کند</translation>
<translation id="3425307214497790458">‏اگر موردی نیاز به بررسی داشته باشد، Phromium به شما اطلاع می‌دهد</translation>
<translation id="4247980944121268675">‏‫Phromium صفحه‌هایی را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="3810973564298564668">مدیریت</translation>
<translation id="1058395779823101457">‏برای استفاده کردن از گذرواژه‌های ذخیره‌شده، رمزینه پاسخ‌سریع را دنبال کنید، Phromium ویژه iOS را بارگیری کنید، و به سیستم «حساب Google» وارد شوید</translation>
<translation id="3846683726093018685">**خلاصه کردن:** در یک جمله کمتر از ۳۰ کلمه، موضوع اصلی و هدف محتوای نماگرفت را شرح بده.

          **پیشنهاد سؤال:** فهرستی گلوله‌ای با ۳ تا ۵ سؤال تأمل‌برانگیز تولید کن که کاربر بتواند برای درک بهتر نماگرفت بپرسد. حداقل یک مورد از این سؤالات باید به‌طور خاص درباره یک شیء بصری، طراحی، یا جای آن باشد.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - Phromium</translation>
<translation id="430953676539987275">‏برای دریافت نشانک‌ها و سایر موارد در همه دستگاه‌هایتان، به سیستم Phromium وارد شوید</translation>
<translation id="3885770153807205175">انتخاب‌گر زبان</translation>
<translation id="5947409614720749543">‏Phromium را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="2176348074240183776">‏برای باز کردن Phromium و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="3892148308691398805">کپی کردن نوشتار</translation>
<translation id="3679766722656346339">‏<ph name="EXISTING_USER" /> قبلاً به سیستم این نمایه Phromium وارد شده است. برای جدا نگه داشتن مرور، Phromium می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="6085953975934135790">‏این افزونه خط‌مشی «نت‌بازار Chrome» را نقض می‌کند و ممکن است ناامن باشد. آن را از Phromium حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="3941890832296813527">خطای نصب: نام فایل نصب‌کننده نامعتبر است یا از آن پشتیبانی نمی‌شود.</translation>
<translation id="608187946760434925">‏Phromium می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="3054592240125889472">‏برای دریافت اطلاعات ذخیره‌شده و سایر موارد در همه دستگاه‌هایتان، به سیستم Phromium وارد شوید</translation>
<translation id="3140795250676341027">‏گذرواژه‌ها، روش‌های پرداخت، و نشانی‌هایی که در «حساب Google» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Phromium، دوباره به سیستم وارد شوید.</translation>
<translation id="395904275706073188">صفحه‌های محافظت‌شده خوانده نمی‌شوند. صفحه دیگری را امتحان کنید.</translation>
<translation id="4227910144250222665">‏ببینید Phromium چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="3967822245660637423">بارگیری کامل شد</translation>
<translation id="4150430234581811723">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Phromium چیزی را که تایپ می‌کنید برای دریافت پیشنهاد به ابزارهای عامل، جستجو، و هوش مصنوعی سازمانتان ارسال می‌کند.</translation>
<translation id="3975724895399328945">‏درباره Google Chrome for Testing</translation>
<translation id="3997429360543082038">‏درباره ChromiumOS</translation>
<translation id="4847805566397342820">‏وقتی‌که از سایتی بازدید می‌کنید، Phromium بخش مبهم‌سازی‌شده‌ای از نشانی وب را ازطریق سرور حافظ حریم خصوصی‌ای که نشانی IP شما را پنهان می‌کند به <ph name="BEGIN_LINK" />مرور ایمن Google<ph name="END_LINK" /> ارسال می‌کند. اگر سایتی کار مشکوکی انجام دهد، نشانی‌های وب کامل و بخش‌هایی از محتوای صفحه نیز ارسال می‌شوند.</translation>
<translation id="4016217212818346953">با «مدیر گذرواژه» ایمن بمانید</translation>
<translation id="4019629340646866719">‏ارائه ChromiumOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS" />محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS" /> ممکن شده است.</translation>
<translation id="4022972681110646219">ترجمه کردن صفحه‌نمایش</translation>
<translation id="4023601594785368013">زبان اصلی: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">‏پیوندها را از هر برنامه‌ای در Phromium باز کنید. همچنین برای دسترسی آسان، Phromium به نوار وظیفه شما سنجاق می‌شود.</translation>
<translation id="6916567874038032700">‏با گزارش <ph name="BEGIN_LINK" />تنظیمات کنونی<ph name="END_LINK" />، به بهتر شدن Phromium کمک کنید</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4055805654398742145">مدیر گذرواژه</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Phromium استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از Phromium استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از Phromium استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
