<translation id="4447409407328223819">‏درباره Chrome for Testing</translation>
<translation id="972523218852576493">‏برای ذخیره کردن داده‌های Phromium در «حساب Google» خود و استفاده از آن‌ها، گذرعبارتتان را وارد کنید</translation>
<translation id="4493028449971051158">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش سرپرست اجرا کنید.</translation>
<translation id="4501471624619070934">نصب انجام نشد زیرا دسترسی در این کشور محدود است.</translation>
<translation id="8839763675940122379">‏این افزونه روش‌های اعمال حریم خصوصی، مثل نحوه جمع‌آوری و استفاده از داده‌ها را منتشر نکرده است. ‫Phromium توصیه می‌کند آن را حذف کنید.</translation>
<translation id="2339640488105852505">‏به Phromium خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="8536959233160434213">‏‫Phromium برای نقشه‌برداری از محیط اطراف و ردیابی دستان شما به اجازه نیاز دارد</translation>
<translation id="1077734277628859167">‏قبلاً با <ph name="USER_EMAIL_ADDRESS" /> در نمایه Phromium دیگری به سیستم وارد شده‌اید</translation>
<translation id="5512897665247593318">‏‫Phromium صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو کردن سریع‌تر شود. <ph name="BEGIN_LINK" />درباره پیش‌بارگیری صفحه‌ها بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">وقتی سایتی را که فکر می‌کنید مضر است گزارش می‌کنید، به بهبود ایمنی آنلاین برای همه کمک می‌کنید.</translation>
<translation id="6624033199018630177">‏‫Phromium این بارگیری را مسدود کرد زیرا «مرور ایمن» خاموش است و نمی‌توان فایل را تأیید کرد</translation>
<translation id="3039804643080655517">‏«لنز Google» را با Phromium در تلفنتان امتحان کنید</translation>
<translation id="4594305310729380060">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="8064263528617889755">‏برنامه‌های Phromium</translation>
<translation id="4598116752460667024">فرایندی را ازطریق فهرست جستجو کنید.</translation>
<translation id="4613863813562375431">‏نسخه ChromiumOS</translation>
<translation id="7245201002247176127">‏تقریباً به‌روز شده است! برای تمام کردن به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید.</translation>
<translation id="8846891938874485868">‏سرعت سایت‌ها را با موتورV8 مرورگر Phromium بالاتر می‌برد اما مقاومت Phromium را دربرابر حمله‌ها کمی کمتر می‌کند</translation>
<translation id="7525500996671436081">‏باز کردن جستجو با Phromium</translation>
<translation id="1224842000407297331">‏نمایه Phromium</translation>
<translation id="4956303519269880412">‏هشدار: Phromium نمی‌تواند مانع از ثبت سابقه مرورتان توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت ناشناس»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="2708255035805733225">‏اگر گزارش‌های استفاده از Phromium را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="4673710618874938871">با <ph name="USER_NAME" />، عضویت به سیستم وارد شدید. باز کردن منو حساب</translation>
<translation id="1883292567514549610">‏ظاهراً نمایه توسط فرایند Phromium دیگری (<ph name="PROCESS_ID" />) در رایانه‌ای دیگر (<ph name="HOST_NAME" />) در حال استفاده است. Phromium نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرایندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و Phromium را مجدداً راه‌اندازی کنید.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="1889305042180577023">‏برخی‌از داده‌های Phromium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="8079525505870459051">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و موارد دیگر «حساب Google» خود در Phromium استفاده کنید. ‫<ph name="SHORTCUT" /> می‌تواند تنظیمات سرویس‌های Google را تغییر دهد.</translation>
<translation id="2171507067211697961">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST" /> به سیستم Phromium در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر Chrome جدیدی ایجاد کنید.</translation>
<translation id="4724676981607797757">نصب به‌دلیل خطای پروتکل پشتیبانی‌نشده انجام نشد.</translation>
<translation id="6925701206088903005">‏درهرصورت از Phromium خارج می‌شوید؟</translation>
<translation id="4514755609496543621">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای Phromium اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="8673673368917636496">‏اخیراً بازدیدی نداشته‌اید. ‫Phromium ‏<ph name="PERMISSION_1" />،‏ <ph name="PERMISSION_2" />،‏ و <ph name="COUNT" /> مورد دیگر را برداشت.</translation>
<translation id="3638319732826965647">‏اگر «Gemini در Phromium» باز باشد، پانل کناری هنگام ایجاد زبانه‌های جدید باز می‌ماند</translation>
<translation id="479167709087336770">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی Google استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Google ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
