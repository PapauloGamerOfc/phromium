<translation id="4918086044614829423">می‌پذیرم</translation>
<translation id="4918844574251943176">تصویر کپی شد</translation>
<translation id="1531905832227009774">‏برای دریافت فهرست خواندن و سایر موارد در همه دستگاه‌هایتان، به سیستم Phromium وارد شوید</translation>
<translation id="4319892378006430019">‏Phromium در حالت پس‌زمینه است.</translation>
<translation id="8972359100025490790">‏برای بستن کادر گفتگوی ورود به سیستم Phromium، کلیک کنید</translation>
<translation id="3639078149590125530">‏با نمایه‌های Phromium می‌توانید همه چیزهای مربوط به Phromium را از هم جدا کنید. برای دوستان و اعضای خانواده نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="7141327976224964788">‏مهمان‌ها می توانند از Phromium استفاده کنند بدون این‌که اثری از خود به جا بگذارند.</translation>
