<translation id="259935314519650377">نصب‌کننده بارگیری‌شده در حافظه نهان ذخیره نشد. خطا: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">سیستم</translation>
<translation id="7634640424937626608">‏سازمانتان می‌تواند داده‌های مرور، مثل نشانک‌ها، سابقه، و گذرواژه‌هایتان را ببیند و مدیریت کند. سازمانتان نمی‌تواند داده‌های مرور دیگر نمایه‌های Phromium را ببیند</translation>
<translation id="2669565213445601962">‏برای استفاده از داده‌های Phromium و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL" />)، هویت خود را درستی‌سنجی کنید</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید}=1{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. پنجره «ناشناس» دوباره باز نمی‌شود.}one{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. ‫# پنجره «ناشناس» دوباره باز نمی‌شود.}other{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Phromium را راه‌اندازی مجدد کنید. ‫# پنجره «ناشناس» دوباره باز نمی‌شود.}}</translation>
<translation id="4393202019354077587">‏شروع Phromium</translation>
<translation id="3192212313802409327">‏یک خطای سیستم‌عامل در طول نصب روی داد. لطفاً Phromium را دوباره نصب کنید.</translation>
<translation id="6648732950668475680">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و Phromium را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="3501804488281766385">‏دسترسی آسان به «Gemini در Phromium» در سراسر دستگاه، حتی اگر Phromium کوچک شده باشد.</translation>
<translation id="5655763731487334489">‏برگه Phromium</translation>
<translation id="582020748041490207">‏برای امنیت بیشتر، Phromium داده‌های شما را رمزگذاری می‌کند.</translation>
<translation id="2693283019505702310">‏برای برداشتن «حساب Google» خود از Phromium، از سیستم خارج شوید</translation>
<translation id="2989508583692830513">‏برای دریافت گذرواژه‌ها، نشانک‌ها، و موارد دیگر در همه دستگاه‌هایتان، به سیستم Phromium وارد شوید</translation>
<translation id="2738871930057338499">‏اتصال به اینترنت برقرار نشد. HTTP ۴۰۳ ممنوع است. لطفاً پیکربندی پروکسی‌تان را بررسی کنید.</translation>
