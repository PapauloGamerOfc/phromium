<translation id="969667123257916656">‏داده‌های Phromium ذخیره‌شده در حسابتان را پاک کنید</translation>
<translation id="5528040738212560214">‏این فایل ممکن است خطرناک باشد<ph name="LINE_BREAK" />اگر گذرواژه را ارائه دهید، Phromium می‌تواند این بارگیری را برایتان بررسی کند. اطلاعات فایل به «مرور ایمن Google» ارسال می‌شود، اما محتوای فایل و گذرواژه در دستگاهتان باقی می‌ماند.</translation>
<translation id="6182736845697986886">نصب به‌دلیل وجود خطای داخلی در سرور به‌روزرسانی انجام نشد.</translation>
<translation id="6041381825442292659">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME" /> به سیستم Phromium وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="2474943719592372017">‏از هرجا که هستید جستجو کنید و سؤال بپرسید، حتی اگر Phromium کوچک شده باشد. به Phromium اجازه می‌دهد در پس‌زمینه اجرا شود.</translation>
<translation id="2518372260387069450">‏این رایانه در حال حاضر دارای یک نسخه جدیدتر از Phromium است. درصورتی‌که نرم‌افزار کار نمی‌کند، لطفاً Phromium را حذف نصب کنید و دوباره سعی کنید.</translation>
<translation id="3832895416321159809">{0,plural, =0{‏Phromium هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏Phromium ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏Phromium ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏Phromium ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="2775110773501098464">‏Phromium برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="3505491405575013121">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Phromium ذخیره شده است مقایسه می‌کند</translation>
<translation id="2276249127856880228">‏Phromium  مرورگر پیش‌فرض شود</translation>
<translation id="6248988683584659830">تنظیمات جستجو</translation>
<translation id="554637698797403739">‏با برنامه Phromium در تلفنتان، بهترین ویژگی‌های ایمنی Google را درحال حرکت دریافت کنید</translation>
<translation id="7016155178198587734">‏از Phromium خارج می‌شوید؟</translation>
<translation id="5660287988409470276">‏این زبانه‌ها از منابع بیشتری استفاده می‌کنند. برای بهبود عملکرد، اجازه دهید Phromium آن‌ها را غیرفعال کند.</translation>
<translation id="8429776045186716992">‏سفارشی کردن نمایه Phromium</translation>
<translation id="3310436202618971091">‏نام‌گذاری نمایه Phromium</translation>
<translation id="1478750151648434251">‏یکی از افزونه‌ها از شما می‌خواهد به سیستم Phromium وارد شوید</translation>
<translation id="9139712828910812615">‏<ph name="FILE_NAME" /> ممکن است خطرناک باشد، بنابراین Phromium آن را مسدود کرده است.</translation>
<translation id="5191618263102115907">‏Phromium درحال استفاده از دوربین شما است.</translation>
<translation id="8247508943089477519">‏عملیات دیگری در Phromium درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="8271488218611798813">‏اکنون استفاده از Phromium با حساب Google شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="446228390478495078">‏با تنظیم کردن Phromium به‌عنوان مرورگر پیش‌فرض، به‌راحتی به ویژگی‌هایی که می‌شناسید، دوست دارید، و به آن‌ها اعتماد دارید دسترسی پیدا کنید.</translation>
<translation id="2203435422524224690">‏میان‌بر Phromium</translation>
<translation id="3977517784144885449">‏‫Phromium این بارگیری را مسدود کرد زیرا این فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="8088471547690853921">‏آیا مطمئن هستید که می‌خواهید Phromium را حذف نصب کنید؟</translation>
<translation id="6375219077595103062">میان‌بری به «مدیر گذرواژه» اضافه کنید</translation>
<translation id="6388799252195623474">در این مورد به من کمک کنید</translation>
<translation id="1774421040071124552">‏برای ادامه دادن، با حساب <ph name="EMAIL" /> به سیستم Phromium وارد شوید. با این کار مطمئن می‌شوید که خط‌مشی‌های سازمانتان اعمال شده‌اند.</translation>
<translation id="2343430845154053061">‏نشان‌واره Phromium درون صفحه‌نمایش رایانه.</translation>
<translation id="2724924185145648602">‏‫Phromium یک مرورگر وب است که صفحات وب و برنامه‌ها را با سرعت بسیار زیاد اجرا می‌کند. این مرورگر خیلی سریع و پایدار است کار کردن با آن آسان است. با محافظت دربرابر بدافزار و رمزگیری تعبیه‌شده در Phromium، با امنیت بیشتری وب را مرور کنید.</translation>
<translation id="7417453886359805803">‏برای اینکه مطمئن شوید همیشه می‌توانید از داده‌های Phromium در «حساب Google» خود استفاده کنید و آن‌ها را ذخیره کنید، هویتتان را درستی‌سنجی کنید</translation>
<translation id="3304683228794166031">‏‫Phromium سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند</translation>
<translation id="6436260184216827876">«جستجوی تصویر» دردسترس نیست. بعداً دوباره امتحان کنید.</translation>
<translation id="6442900851116057561">‏بازراه‌اندازی ChromiumOS</translation>
<translation id="9164801375934097818">‏‫Phromium صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="2577121659922309103">‏با بارگیری Phromium در تلفنتان، قیمت‌ها را پیگیری کنید و برای کاهش قیمت در هر سایتی هشدار دریافت کنید</translation>
<translation id="2052328618318278030">‏خاموش • Phromium نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="3122296739697671126">‏به نمایه‌های Phromium خوش‌آمدید</translation>
<translation id="3472445024540245926">‏دفعه بعد که Phromium را در <ph name="DEVICE_TYPE" /> باز می‌کنید، پیام‌واره‌ای برای استفاده از گروه‌های زبانه خواهید دید.</translation>
<translation id="2144084801479939969">‏برداشتن حساب از Phromium</translation>
<translation id="2473490714352939152">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Phromium نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="648319183876919572">«مرور ایمن پیشرفته» کارهای بیشتری برای محافظت از شما درمقابل وب‌سایت‌ها و بارگیری‌های خطرناک انجام می‌دهد</translation>
<translation id="359777544552173333">‏حذف نصب Phromium </translation>
<translation id="3890462049854841354">‏میان‌برها در Phromium باز می‌شود</translation>
<translation id="6616579671682178785">‏اگر <ph name="TIMEOUT_DURATION" /> از Phromium استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="8662645370371079862">‏هرکدام از نمایه‌ها دارای اطلاعات Phromium مختص خودش است (مثلاً نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="6556755379298048869">با میان‌بر صفحه‌کلید جستجو کنید.</translation>
<translation id="7133640529688742768">‏درباره اینکه <ph name="BEGIN_LINK" />Phromium چگونه داده‌های شما را خصوصی نگه می‌دارد<ph name="END_LINK" /> بیشتر بدانید</translation>
<translation id="8316065704185291024">‏پس‌از بازراه‌اندازی Phromium، تغییرات این تنظیم اعمال خواهد شد.</translation>
<translation id="2816396636285296289">‏افزونه‌هایتان را با کلیک کردن روی «افزونه‌ها» در منوِ اصلی Phromium مدیریت کنید.</translation>
<translation id="8831144879019828189">‏برای دیدن گذرواژه‌های نمایه Phromium دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="7017911482442558099">‏برای داشتن بهترین ابزارهای هوشواره‌ای درحرکت، از برنامه Phromium استفاده کنید</translation>
<translation id="5784574554904759369">‏برای رفع خطاهای املائی، Phromium نوشتاری را که در فیلد نوشتار تایپ می‌کنید، برای Google ارسال می‌کند</translation>
<translation id="8485501471305987872">‏رفتن به تنظیمات اعلان Phromium</translation>
<translation id="6600016381025017075">هرچیزی در این صفحه را جستجو کنید</translation>
<translation id="1462793186918694806">‏دفعه بعدی که Phromium را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="7501991510212476553">‏اکنون Phromium با شروع Windows راه‌اندازی می‌شود تا بتوانید بلافاصله مرور را شروع کنید. می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="7686308613268368175">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Phromium زبانه‌های جلسه قبلی‌تان را بازگرداند. می‌توانید این ویژگی را در اینجا خاموش کنید:</translation>
<translation id="5266723901802366313">‏Phromium برای ایجاد نقشه سه‌بعدی از محیط اطراف شما به اجازه دوربین نیاز دارد</translation>
<translation id="7085315067428293799">‏اگر نشانک‌ها را در «حساب Google» هم ذخیره کنید، می‌توانید قیمت محصولات را در Phromium پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="6676384891291319759">دسترسی به اینترنت</translation>
<translation id="668175097507315160">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromiumOS نتوانست داده‌های شما را همگام‌سازی کند.</translation>
<translation id="5279767706090517695">‏برداشتن داده‌های این برنامه از Phromium</translation>
<translation id="6562226321659107531">‏Phromium برای این سایت به اجازه میکروفون نیاز دارد</translation>
<translation id="6712881677154121168">خطای بارگیری: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">‏از نمایهٔ شما نمی‌توان استفاده کرد زیرا دارای نسخه جدیدتری از Phromium است.

برخی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک فهرست راهنمای نمایه دیگری را مشخص کنید یا از نسخه جدیدتری از Phromium استفاده کنید.</translation>
<translation id="4914871493602315663">‏برای گرفتن شخصی‌سازی‌ها و ویژگی‌های دیگر، Phromium را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده Google اضافه کنید</translation>
<translation id="5919390816124912606">‏Phromium از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="5867815953973052697">‏برای دریافت نشانک‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Phromium وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانک در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="7381168634819530324">‏با این کار سرعت سایت‌ها با موتور Phromium نسخه ۸ بالاتر می‌رود اما مقاومت Phromium دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم روشن است.</translation>
<translation id="1509688792864707851">{count,plural, =1{‏برخی‌از داده‌های Phromium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏برخی‌از داده‌های Phromium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏برخی‌از داده‌های Phromium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="4702638565169602649">‏Phromium توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="6779406956731413166">‏ارائه ChromiumOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی ممکن شده است.</translation>
<translation id="6831043979455480757">ترجمه</translation>
<translation id="1564864902402454287">‏Phromium می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="684888714667046800">نمی‌توان به اینترنت متصل شد. اگر از دیوار آتش استفاده می‌کنید، لطفاً مطمئن شوید <ph name="PRODUCT_EXE_NAME" /> در فهرست مجازها باشد.</translation>
<translation id="6200419390448865091">Phromium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">برای ادامه دادن، کلید «جهش» را فشار دهید</translation>
<translation id="6862030660799253820">جستجوی این تصویر با «جستجوی تصویر»</translation>
<translation id="6869568587896659271">دسترسی آسان به وب‌سایت‌های زیر نوار نشانی</translation>
<translation id="4011399428346318467">‏Phromium متوجه شده است که «<ph name="EXTENSION_NAME" />» حاوی بدافزار است</translation>
<translation id="6877155553248388166">‏گوشه پایین سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT" /> سمت چپ، ‎٪<ph name="BOTTOM" /> پایین</translation>
<translation id="6896758677409633944">کپی کردن</translation>
<translation id="6898028264630240901">می‌توانید «تکالیف بافتاری» را سنجاق کنید تا هنگام مرور کردن به‌راحتی سؤالات خود را بپرسید</translation>
<translation id="1012681980425424211">‏‫Phromium را به‌عنوان مرورگر پیش‌فرض خود تنظیم کنید و آن را به نوار وظیفه‌تان سنجاق کنید</translation>
<translation id="1744625657438211994">‏مدیریت نمایه‌های Phromium</translation>
<translation id="7264818828956697552">‏این کنش:
          <ph name="LINE_BREAKS" />
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK" />
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK" />
            • کوکی‌ها و دیگر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAK" />
            • میان‌برهای Phromium را بازنشانی می‌کند
            <ph name="LINE_BREAKS" />
            نشانک‌ها، سابقه، و گذرواژه‌های ذخیره‌شده تحت‌تأثیر قرار نخواهند گرفت.</translation>
<translation id="6489000842445481390">‏به حداکثر تعداد نشانک‌های Phromium (<ph name="BOOKMARK_LIMIT" />) رسیده‌اید، بنابراین برخی‌از نشانک‌هایتان هنوز در «حساب Google» شما ذخیره نشده است.

تا زمانی‌که تعدادی از نشانک‌ها را حذف نکنید، نمی‌توانید نشانک‌های جدید را در حسابتان ذخیره کنید. اگر اکنون از سیستم خارج شوید، نشانک‌های ذخیره‌نشده حذف خواهد شد.</translation>
<translation id="2645108248038996858">‏باز کردن پیوند در پنجره &amp;ناشناس Phromium</translation>
<translation id="6965382102122355670">تأیید</translation>
<translation id="6985329841647292029">‏شرایط ChromiumOS</translation>
<translation id="2947519843530032104">‏برای استفاده از داده‌های Phromium و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL" />)، گذرعبارت خود را وارد کنید</translation>
<translation id="7011190694940573312">نصب انجام نشد زیرا این نسخه از سیستم‌عامل پشتیبانی نمی‌شود.</translation>
<translation id="7024536598735240744">خطای لغو فشرده‌سازی: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">‏Phromium را برای خود اختصاصی کنید</translation>
<translation id="7047386856539490735">این نتایج مفیدند؟</translation>
<translation id="2448910402556368916">‏به‌روزرسانی Phromium</translation>
<translation id="7834049737623892628">‏اگر تصویری توضیح مفیدی نداشته باشد، Phromium توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Google ارسال می‌شود.</translation>
<translation id="1803168627715642217">‏هنگام استفاده از برنامه Phromium در <ph name="DEVICE_TYPE" />، قدرت هوشواره را تجربه کنید</translation>
<translation id="3321731353906178474">‏با برنامه Phromium در تلفنتان، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحال حرکت همراه خود داشته باشید</translation>
<translation id="7141270731789036260">‏سفارشی‌سازی Chrome for Testing</translation>
<translation id="8077731669779275332">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Phromium باز کنید</translation>
<translation id="611798798247797100">‏حذف <ph name="EXTENSION_NAME" /> از Phromium</translation>
<translation id="7962394294883785044">‏اگر <ph name="TIMEOUT_DURATION" /> از Phromium استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="2611686760870033712">‏Phromium برای این سایت به اجازه دوربین نیاز دارد</translation>
<translation id="71050417052775020">‏Phromium راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="4817060241763895497">‏در همان جایی که هستید، درباره هر چیزی از «Gemini در Phromium» بپرسید</translation>
<translation id="869358700049263961">‏‫Phromium را در Dock نگه دارید تا هرزمان خواستید سریع به آن دسترسی داشته باشید</translation>
<translation id="7094488679340739251">‏از Phromium برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="7216228761061470870">‏وقتی در رایانه از «جستجوی تصویر» استفاده می‌کنید، عنوان صفحه، نشانی وب، و محتوا ازجمله فایل‌های PDF به سرور ارسال می‌شود.</translation>
<translation id="7802634650401946711">‏مدیر وظایف - Phromium</translation>
<translation id="5182547787327636348">‏درباره محتواهای خارج از Phromium، مثل برنامه‌ها یا سایر فایل‌ها سؤال کنید</translation>
<translation id="1673408954678067905">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Phromium وارد شوید. همچنین به اطلاعات ذخیره‌شده و اطلاعات دیگر در همه دستگاه‌هایتان دسترسی خواهید داشت.</translation>
<translation id="5761733252154904648">‏مرور را فوراً شروع کنید: اکنون Phromium می‌تواند هنگام شروع Windows راه‌اندازی شود.</translation>
<translation id="7274695763216404502">سنجاق شد! دفعه بعد «جستجوی تصویر» را از نوارابزار باز کنید</translation>
<translation id="7288567540154601580">زبانه‌ها و افزونه‌ها</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{‏Phromium توصیه می‌کند آن را بردارید}one{‏Phromium توصیه می‌کند آن را بردارید}other{‏Phromium توصیه می‌کند آن‌ها را بردارید}}</translation>
<translation id="1408728332407453335">‏برای هم‌رسانی کردن صدای سیستم، «تنظیمات سیستم» را باز کنید و «فقط ضبط صدای سیستم» را برای Phromium مجاز کنید. سپس باید Phromium را بازراه‌اندازی کنید.</translation>
<translation id="7299899569525778554">جستجو کردن از رایانه</translation>
<translation id="6194310460545162015">‏در حال به‌روزرسانی Phromium</translation>
<translation id="1098154893096691883">‏فایل اولویت‌های شما خراب یا نامعتبر است.
Phromium قادر به بازیابی تنظیمات شما نیست.</translation>
<translation id="7324051657739063017">می‌توانید «تکالیف بافتاری» را دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="7024097830259741656">‏وب، نشانک‌ها و موارد دیگر Phromium شما در اینجا هستند.</translation>
<translation id="852511575759652041">‏فقط شخصی که گذرعبارت شما را دراختیار داشته باشد می‌تواند داده‌های رمزگذاری‌شده‌تان را بخواند. گذرعبارت به Google ارسال نمی‌شود یا توسط آن ذخیره نمی‌شود. اگر گذرعبارت را فراموش کنید یا بخواهید این تنظیم را تغییر دهید، باید <ph name="BEGIN_LINK" />داده‌های Phromium ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME" /> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME" />، Phromium را پیکربندی کرده است.</translation>
<translation id="7352651011704765696">مشکلی پیش آمد</translation>
<translation id="7198690862684855451">‏برای دریافت به‌روزرسانی‌های بعدی Phromium، باید macOS نسخه ۱۳ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۲ استفاده می‌کند.</translation>
<translation id="3224607549103501149">‏اخیراً بازدیدی نداشته‌اید. ‫Phromium ‏<ph name="PERMISSION_1" /> و <ph name="PERMISSION_2" /> را برداشت.</translation>
<translation id="73786666777299047">‏باز کردن نت‌بازار Chrome</translation>
<translation id="8446269872172461565">‏نمایش «Gemini در Phromium» در سینی سیستم</translation>
<translation id="7401687852903179959">جستجوی این ویدیو با «جستجوی تصویر»</translation>
<translation id="3403529853122418035">‏‫Phromium اکنون مرورگر پیش‌فرض شما است</translation>
<translation id="5649377421626481711">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Phromium هربار که آن را بازراه‌اندازی کنید، زبانه‌هایتان را بازمی‌گرداند. برای خاموش کردن این ویژگی، به اینجا بروید:</translation>
<translation id="2467776530444676191">‏وارد کردن گذرواژه‌ها به Phromium</translation>
<translation id="8814480293815136510">‏۱. روی <ph name="BUTTON_LABEL" /> در زیر کلیک کنید
۲. روی <ph name="BUTTON_2" /> در تنظیمات Windows کلیک کنید
