<translation id="7698884672439844280">‏حساب Phromium به اصالت‌سنجی مجدد نیاز دارد</translation>
<translation id="5629965056131882780">‏ادامه کار را دقیقاً از همان جایی که در Phromium روی iOS متوقف کرده بودید، از سر بگیرید.</translation>
<translation id="874294566462998787">‏خروج از سیستم Phromium</translation>
<translation id="5234764350956374838">بستن</translation>
<translation id="8605581794204249702">‏باز کردن پیوند در پنجره حالت «&amp;ناشناس» Phromium</translation>
<translation id="8722804301463582643">‏برای ذخیره کردن گذرواژه‌ها درحرکت، برنامه Phromium را دریافت کنید</translation>
<translation id="6253936671561887082">‏برای اعمال تغییراتتان، Phromium را راه‌اندازی مجدد کنید</translation>
<translation id="7405713141437293142">‏برای ارسال کردن این زبانه به دستگاهی دیگر، در هردو دستگاه به سیستم Phromium وارد شوید</translation>
<translation id="5286907366254680517">تشخیص داده شد</translation>
<translation id="2224284460884535818">‏دریافت برنامه Phromium</translation>
<translation id="1426207087952749578">‏هنگام مرور «درحالت ناشناس»، Phromium قبل‌از اینکه سایت را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="8108751453879231987">‏جستجو کردن با Phromium</translation>
<translation id="7780358745459835678">‏سرویس داخلی به‌روزرسان Phromium</translation>
<translation id="6956753580765202069">‏از آن‌ها در کنار دیگر ویژگی‌های Gemini در Phromium استفاده کنید</translation>
<translation id="5346389065299425353">جستجویتان را با افزودن چند زبانه، فایل، و ابزار عمیق‌تر کنید</translation>
<translation id="8684266995248242891">‏با «Gemini در Phromium»، مروری کوتاه از این سند دریافت کنید و سؤال بپرسید</translation>
<translation id="586104673506947714">‏Phromium چند توصیه ایمنی برای بررسی پیدا کرد</translation>
<translation id="4657908558997566735">‏دیگر نمایه‌های Phromium</translation>
<translation id="6097378010983112326">‏‫ChromiumOS نتوانست داده‌های Phromium را در «حساب Google» شما ذخیره کند زیرا جزئیات ورود به سیستم حسابتان به‌روز نیست</translation>
<translation id="385020720581757591">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Phromium خود را می‌دهید. داده‌های Phromium شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Google حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">کد اضافی: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">‏برای گرفتن شخصی‌سازی‌ها، Phromium را به «فعالیت‌ها در وب و برنامه» اضافه کنید</translation>
<translation id="2756028035855809142">‏باز کردن جستجو با Phromium</translation>
<translation id="4375021373215585423">‏ببینید چرا Phromium برخی‌از فایل‌ها را مسدود می‌کند</translation>
<translation id="4688227912949761884">‏درحال به‌روزرسانی Phromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Phromium وارد شوید. همچنین افزونه‌ها و سایر موارد را در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="4945147853702701048">‏مجاز کردن ورود به سیستم Phromium</translation>
