<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hi">
<translation id="1026101648481255140">इंस्टॉल करने की प्रोसेस को दोबारा चालू करें</translation>
<translation id="1029669172902658969">&amp;ChromiumOS को अपडेट करने के लिए, उसे फिर से लॉन्च करें</translation>
<translation id="7962340570690354348">Phromium आपको इस एक्सटेंशन की जांच करने का सुझाव देता है</translation>
<translation id="2702007788032964762">जब कोई साइट अपने पेज पर, लिंक को निजी तौर पर पहले से लोड करने के लिए कहती है, तो Phromium, Google के सर्वर का इस्तेमाल करता है. इस वजह से, पहले से लोड की गई साइट से आपकी पहचान छिपी रहती है. हालांकि, Google को पता चल जाता है कि कौन-कौनसी साइटें पहले से लोड हुई हैं.</translation>
<translation id="1051793555070215510">एक मिनट के इस सर्वे में शामिल हों और गुप्त मोड को बेहतर बनाने में हमारी मदद करें.</translation>
<translation id="1065672644894730302">आपकी प्राथमिकताओं को पढ़ा नहीं जा सकता| \\n\\nकुछ विशेषताएं अनुपलब्ध हो सकती हैं और प्राथमिकताओं में किए गए परिवर्तनों को सहेजा नहीं जाएगा.</translation>
<translation id="4964836565882496625">आपके माता-पिता ने Phromium के लिए, "साइट, ऐप्लिकेशन, और एक्सटेंशन के लिए अनुमतियां" को बंद कर दिया है</translation>
<translation id="8409497136174302488">आस-पास मौजूद डिवाइसों को खोजने और उनका इस्तेमाल करने के लिए, Phromium को आपके लोकल नेटवर्क का ऐक्सेस चाहिए</translation>
<translation id="4388904545107211948">Phromium की किसी सुविधा या एक्सटेंशन को खोजने के लिए, पता बार में उसका शॉर्टकट टाइप करें. इसके बाद, अपने हिसाब से कीबोर्ड शॉर्टकट दबाएं</translation>
<translation id="7188624550427159072">'Phromium की मदद से खोजें' सुविधा को सिस्टम ट्रे में दिखाएं और कीबोर्ड शॉर्टकट चालू करें</translation>
<translation id="3689248207461565136">क्रोमियम आपके पासवर्ड निर्यात करना चाहता है. इसकी मंज़ूरी देने के लिए अपना Windows पासवर्ड लिखें.</translation>
<translation id="112640046208448578">चीज़ों या जगहों की पहचान करें और टेक्स्ट को कॉपी करें या उसका अनुवाद करें. इमेज सर्च का इस्तेमाल करने पर, सर्वर को उस पेज का एक स्क्रीनशॉट भेजा जाता है. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">क्रोमियम आपका डिफ़ॉल्ट ब्राउज़र है</translation>
<translation id="5414044255592121327">डेटा के गलत इस्तेमाल और सुरक्षा की अन्य समस्याओं से आपके पासवर्ड सुरक्षित हैं या नहीं, इसकी जांच करने के लिए, <ph name="BEGIN_LINK" />क्रोमियम में साइन इन करें<ph name="END_LINK" />.</translation>
<translation id="1753507755668601921">'Phromium मेन्यू' पर क्लिक करें</translation>
<translation id="1157985233335035034">हाल ही की भाषाएं</translation>
<translation id="1184145431117212167">इंस्टॉल नहीं किया जा सका, क्योंकि Windows के आपके वर्शन पर यह काम नहीं करता.</translation>
<translation id="7861581212703831457">क्रोमियम के बारे में</translation>
<translation id="8752630985505435738">अपने फ़ोन पर Phromium से, प्रॉडक्ट की कीमत ट्रैक करने की सुविधा से जुड़ी सूचनाएं पाएं</translation>
<translation id="1203500561924088507">इंस्टॉल करने के लिए धन्यवाद. <ph name="BUNDLE_NAME" /> का इस्तेमाल करने से पहले, ब्राउज़र को रीस्टार्ट करना ज़रूरी है.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> बाकी है. आपकी ब्राउज़िंग को सुरक्षित रखने के लिए, Phromium अगली बार तब अपडेट होगा, जब <ph name="IDLE_DURATION" /> तक कोई गतिविधि नहीं की जाएगी.</translation>
<translation id="1232234696885483911">इमेज सर्च खोलने पर, पेज का टाइटल, यूआरएल, और कॉन्टेंट अपने-आप सर्वर पर भेज दिया जाएगा. इसमें PDF भी शामिल हैं. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">साइन इन रहने के दौरान, आपके पास Phromium में अपने Google खाते से पासवर्ड और अन्य चीज़ों का इस्तेमाल करने का विकल्प होता है. इसे बदलने के लिए, “Phromium में आपका खाता” पर जाएं.</translation>
<translation id="7402478829083317456">Gemini को Phromium में, Mac के मेन्यू बार में दिखाएं</translation>
<translation id="4902531791098430822">'Phromium में Gemini' से स्क्रीन पर दिख रहे कॉन्टेंट का कोई हिस्सा चुनने के लिए, कीबोर्ड शॉर्टकट का इस्तेमाल करें.</translation>
<translation id="9002284132405311162">टैब के इनऐक्टिव होने पर मेमोरी खाली की गई थी, ताकि Phromium को तेज़ी से ऐक्सेस किया जा सके. इस साइट को हमेशा ऐक्टिव रखने का विकल्प चुना जा सकता है.</translation>
<translation id="5561666811965903444">Phromium ने इस डाउनलोड को ब्लॉक कर दिया है, क्योंकि यह फ़ाइल खतरनाक है</translation>
<translation id="1340271056805240721">Gmail या YouTube जैसी Google की सेवाओं में <ph name="USER_EMAIL" /> से साइन इन करने पर, Phromium में इसी खाते से अपने-आप साइन इन किया जा सकता है</translation>
<translation id="5048805453292757697">अपने फ़ोन पर Phromium डाउनलोड करें</translation>
<translation id="1290883685122687410">सेटअप करने में गड़बड़ी हुई: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7030239572971981565">क्रोमियम पर अपनी नई प्रोफ़ाइल सेट अप करें</translation>
<translation id="7871721155662336863">Phromium में Gemini को आज़माएं</translation>
<translation id="6569288432960798043">Phromium को ब्लूटूथ का ऐक्सेस चाहिए, ताकि वह ब्लूटूथ डिवाइस ढूंढ पाए. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="3232647214432653255">अपने फ़ोन पर Phromium में साइन इन करें</translation>
<translation id="1330562121671411446">भाषा का पता लगाएं</translation>
<translation id="1619655755195586133">Phromium (<ph name="URL" />) से भी डेटा मिटाएं</translation>
<translation id="1345251407431278948">पिन किया गया! टूलबार में मौजूद नए बटन की मदद से, 'इमेज सर्च' सुविधा को फिर से ऐक्सेस किया जा सकता है</translation>
<translation id="1383876407941801731">खोजें</translation>
<translation id="2947996037737257951">Phromium ऐप्लिकेशन का इस्तेमाल करें और कभी भी, कहीं भी ब्राउज़ करना जारी रखें</translation>
<translation id="141901961143729572">अपने विचार शेयर करें</translation>
<translation id="8355386219605656974">विंडो शेयर करने के लिए, 'सिस्टम सेटिंग' में जाकर Phromium के लिए स्क्रीन रिकॉर्ड करने की अनुमति दें.</translation>
<translation id="1478370723027452770">Chrome for Testing से जुड़ी सहायता पाएं</translation>
<translation id="8398257182826094665"><ph name="DEVICE" /> में सेव की गई जानकारी वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="1497802159252041924">इंस्टॉल करने में गड़बड़ी: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">इस पेज को सुरक्षित किया गया है</translation>
<translation id="3484755999946650557">क्रोमियम का टैब शेयर करें</translation>
<translation id="3309377459597801353">Phromium में साइन इन करें</translation>
<translation id="1547469039832541117">इससे, हाइलाइट किया गया टास्क बंद हो जाता है.</translation>
<translation id="2354363290397602683">Phromium को पिन करें</translation>
<translation id="2244728813494358888">Phromium के सुरक्षा टूल</translation>
<translation id="707582364915018531">Phromium, आपके Password Manager के डेटा को मिटाना चाहता है. इसकी अनुमति देने के लिए, Windows का पासवर्ड डालें.</translation>
<translation id="8937776717832679904">{COUNT,plural, =0{आपका एडमिन चाहता है कि आप अपडेट लागू करने के लिए क्रोमियम को फिर से लॉन्च करें}=1{आपका एडमिन चाहता है कि आप अपडेट लागू करने के लिए क्रोमियम को फिर से लॉन्च करें. आपकी गुप्त विंडो फिर से नहीं खुलेगी.}one{आपका एडमिन चाहता है कि आप अपडेट लागू करने के लिए क्रोमियम को फिर से लॉन्च करें. आपकी # गुप्त विंडो फिर से नहीं खुलेंगी.}other{आपका एडमिन चाहता है कि आप अपडेट लागू करने के लिए क्रोमियम को फिर से लॉन्च करें. आपकी # गुप्त विंडो फिर से नहीं खुलेंगी.}}</translation>
<translation id="5032531544901236587">अपने फ़ोन पर Phromium ऐप्लिकेशन डाउनलोड करके, Google की बेहतरीन सुविधाओं का इस्तेमाल करें</translation>
<translation id="7311082384439462587">Phromium के निजता और सुरक्षा से जुड़े मुख्य कंट्रोल देखें</translation>
<translation id="1640672724030957280">डाउनलोड हो रहा है...</translation>
<translation id="1665602916345474427">आपने सदस्यता वाले <ph name="USER_NAME" />, <ph name="USER_EMAIL" /> के खाते से साइन इन किया है. खाते का मेन्यू खोलें</translation>
<translation id="4535436467771816034">मैसेज, दस्तावेज़ों, और अन्य ऐप्लिकेशन में मौजूद लिंक पर क्लिक करके कभी भी Phromium इस्तेमाल करें. इसे आपके टास्कबार पर भी पिन कर दिया जाएगा.</translation>
<translation id="1709772298389099340">यह <ph name="BROWSER_NAME" /> के लिए खास सुविधाओं का ऐक्सेस देती है.</translation>
<translation id="1722488837206509557">इससे, आपको इन डिवाइसों में से किसी एक को चुनने और उस पर कॉन्टेंट दिखाने का विकल्प मिलेगा.</translation>
<translation id="3550860956769006392">Phromium जल्द ही ब्राउज़िंग डेटा को मिटा देगा</translation>
<translation id="2053384509423635834">Phromium, नेविगेशन को एचटीटीपीएस पर अपग्रेड करने की कोशिश करेगा</translation>
<translation id="2516115567501600458">क्रोमियम का डेटा साफ़ हो गया</translation>
<translation id="8571959122390670188">Phromium <ph name="REMAINING_TIME" /> में रीस्टार्ट होगा</translation>
<translation id="6284080675125981628">एचटीटीपीएस उपलब्ध न होने पर, Phromium आपको चेतावनी दिए बिना असुरक्षित कनेक्शन का इस्तेमाल करेगा</translation>
<translation id="5872244334553252095">क्रोमियम को पृष्ठभूमि में चलने दें</translation>
<translation id="2213761221916953829">Phromium को ज़्यादा सुरक्षित बनाने के लिए, हमने ऐसे कुछ एक्सटेंशन अक्षम कर दिए हैं जो <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> में सूचीबद्ध नहीं हैं और आपकी जानकारी के बिना जोड़े गए हो सकते हैं.</translation>
<translation id="8807881428325438878">Phromium को अपने टास्कबार पर पिन करने के लिए, Windows की सूचना में <ph name="BEGIN_BOLD" />हां<ph name="END_BOLD" /> पर क्लिक करें. इससे यह तुरंत ऐक्सेस किया जा सकेगा.</translation>
<translation id="6861833596843600606">क्रोमियम को फिर से इंस्टॉल करें</translation>
<translation id="3950056404221550225">Phromium, <ph name="AUTHENTICATION_PURPOSE" /> की कोशिश कर रहा है</translation>
<translation id="2018401790887358950"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको <ph name="DEVICE" /> पर एक्सटेंशन वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="6114726049187747242">अगली बार अपने <ph name="DEVICE_TYPE" /> पर Phromium खोलने पर, आपको Google Password Manager इस्तेमाल करने का प्रॉम्प्ट दिखेगा.</translation>
<translation id="1838374766361614909">खोज साफ़ करें</translation>
<translation id="2724678689951174927">ब्राउज़िंग डेटा को सिर्फ़ इस डिवाइस से मिटाने और अपने Google खाते में सेव रखने के लिए, <ph name="BEGIN_LINK" />Phromium से साइन आउट करें<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">अपने फ़ोन पर Phromium डाउनलोड करें, ताकि आप कभी भी, कहीं भी टैब ग्रुप खोल सकें या नए टैब ग्रुप बना सकें.</translation>
<translation id="3191814926523151519">आप अपने साइन-इन किए गए Google खाते मैनेज कर सकते हैं. आपके Google खाते, Phromium ब्राउज़र, Play Store, Gmail वगैरह के लिए इस्तेमाल किए जाते हैं. अगर आप किसी अन्य व्यक्ति के लिए कोई खाता जोड़ना चाहते हैं, तो अपने <ph name="DEVICE_TYPE" /> में एक नया व्यक्ति जोड़ें. <ph name="LINK_BEGIN" />ज़्यादा जानें<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">'इमेज सर्च' सुविधा की मदद से खोजें</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको <ph name="DEVICE" /> पर बुकमार्क वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="1880677175115548835">लेख चुनें</translation>
<translation id="1236934630660512644">आप प्रबंधित खाते से साइन इन कर रहे हैं और उसके एडमिन को अपनी क्रोमियम प्रोफ़ाइल पर नियंत्रण दे रहे हैं. आपका क्रोमियम डेटा, जैसे आपके ऐप्लिकेशन, बुकमार्क, इतिहास, पासवर्ड, और दूसरे सेटिंग स्थायी रूप से <ph name="USER_NAME" /> से जुड़ जाएंगे. आप Google खाता डैशबोर्ड के ज़रिए इस डेटा को मिटा सकेंगे, लेकिन दूसरे किसी खाते से इस डेटा को जोड़ नहीं सकेंगे. आप अपने मौजूदा क्रोमियम डेटा को अलग रखने के लिए वैकल्पिक रूप से एक नई प्रोफ़ाइल बना सकते हैं. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">इस सेटिंग के चालू होने पर Phromium, बैकग्राउंड में चलने वाली गतिविधि और विज़ुअल इफ़ेक्ट, जैसे कि स्मूद स्क्रोलिंग और वीडियो के फ़्रेम रेट को सीमित करके बैटरी की खपत को कम करता है. <ph name="BEGIN_LINK" />एनर्जी सेवर के बारे में ज़्यादा जानें<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium अपडेटर सर्विस</translation>
<translation id="5797624919204275541">इसे बंद करके, आप क्रोमियम में साइन इन किए बिना Gmail जैसी Google साइटों में साइन इन कर सकते हैं</translation>
<translation id="6850971726764387814">क्रोमियम अनुत्तरदायी है. अभी रीलॉन्‍च करें?</translation>
<translation id="8289779763124483945">आपके संगठन <ph name="MANAGER" /> के मुताबिक, यह ज़रूरी है कि आप Phromium में साइन इन करें</translation>
<translation id="193439633299369377">अपडेट को लागू करने के लिए, ChromiumOS को रीस्टार्ट करने की ज़रूरत होती है.</translation>
<translation id="3215238748514810076">Phromium ने इस डाउनलोड को ब्लॉक किया है, क्योंकि इस तरह की फ़ाइल आम तौर पर डाउनलोड नहीं की जाती और यह खतरनाक हो सकती है</translation>
<translation id="1953553007165777902">डाउनलोड हो रहा है... <ph name="MINUTE" /> मिनट बचे हैं</translation>
<translation id="8529252122707161160">क्रोमियम, डिफ़ॉल्ट ब्राउज़र को तय या सेट नहीं कर सकता</translation>
<translation id="197326043290947695">इमेज सर्च से बेहतर तरीके से ब्राउज़ करें</translation>
<translation id="7769772561254542263">जानें कि Phromium कुछ फ़ाइलों को ब्लॉक क्यों करता है, यह जानकारी नए टैब में खुलती है</translation>
<translation id="3713013456746186442">इससे आपका Phromium सॉफ़्टवेयर अप-टू-डेट रहता है. अगर इस सेवा को हमेशा या कुछ समय के लिए बंद किया जाता है, तो आपका Phromium सॉफ़्टवेयर अप-टू-डेट नहीं होगा. इसका मतलब है कि सुरक्षा से जुड़े जोखिम हो सकते हैं. साथ ही. उन्हें ठीक नहीं किया जा सकता और ऐसा भी हो सकता है कि ये सुविधाएं काम न करें. अगर कोई Phromium सॉफ़्टवेयर इसका इस्तेमाल नहीं करता है, तो यह सेवा अपने-आप अनइंस्टॉल हो जाती है.</translation>
<translation id="5690439379999550641">ऐसा करने से इस डिवाइस से 1 आइटम मिट जाएगा. बाद में अपना डेटा पाने के लिए, Phromium में <ph name="USER_EMAIL" /> के रूप में साइन इन करें.</translation>
<translation id="2018879682492276940">इंस्टॉल नहीं हो सका. कृपया फिर से कोशिश करें.</translation>
<translation id="2039417478970545937">सेटिंग.</translation>
<translation id="4765042254400173473">चुनें कि Google की सेवाओं में अपने हिसाब से और बेहतर अनुभव पाने के लिए, Phromium पर सेव किए गए आपके ब्राउज़िंग इतिहास को शामिल करना है या नहीं</translation>
<translation id="1448229429009113044">यह सुविधा Phromium में पहले से मौजूद है. इससे आपको मज़बूत पासवर्ड बनाने, सेव करने, और उसे ऑटोमैटिक तरीके से भरने में मदद मिलती है. इसे आसानी से ऐक्सेस करने के लिए शॉर्टकट जोड़ें.</translation>
<translation id="2145664943269651168">Phromium को नया लुक देने के लिए, 'नया टैब' पेज पर मौजूद 'Phromium को पसंद के मुताबिक बनाएं' बटन पर क्लिक करें</translation>
<translation id="6052463185672312901">Phromium ने इस डाउनलोड को ब्लॉक कर दिया है, क्योंकि यह धोखाधड़ी वाली फ़ाइल है और यह आपके डिवाइस में अनचाहे बदलाव कर सकती है</translation>
<translation id="3825064703718009924">अगली बार Phromium iOS खोलने पर, आपको <ph name="FEATURE_NAME" /> आज़माने का प्रॉम्प्ट दिखेगा.</translation>
<translation id="886729435477608858">आपने अपने Google खाते में जो अलग-अलग पासवर्ड और Phromium से जुड़ा अन्य डेटा सेव किया है उसे इस डिवाइस से हटा दिया जाएगा. Phromium में इस डेटा का फिर से इस्तेमाल करने के लिए, दोबारा साइन इन करें.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{Phromium का 1 मिनट तक इस्तेमाल न करने पर, आपका संगठन ब्राउज़िंग डेटा को अपने-आप मिटा देता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं. आपके टैब खुले रहेंगे.}one{Phromium का # मिनट तक इस्तेमाल न करने पर, आपका संगठन ब्राउज़िंग डेटा को अपने-आप मिटा देता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं. आपके टैब खुले रहेंगे.}other{Phromium का # मिनट तक इस्तेमाल न करने पर, आपका संगठन ब्राउज़िंग डेटा को अपने-आप मिटा देता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं. आपके टैब खुले रहेंगे.}}</translation>
<translation id="2125838419757773031">खोजने के लिए स्क्रीन का कोई हिस्सा चुनें</translation>
<translation id="2126108037660393668">डाउनलोड की गई फ़ाइल की पुष्टि नहीं हो पाई.</translation>
<translation id="2135919691573380097">इस साइट की शिकायत करें</translation>
<translation id="2137162749895930932">'स्क्रीन का अनुवाद करें' मोड बंद करें</translation>
<translation id="2147218225094845757">साइड पैनल छिपाएं</translation>
<translation id="1628700182434635922">Phromium ने इस डाउनलोड को ब्लॉक कर दिया है, क्योंकि यह साइट सुरक्षित कनेक्शन का इस्तेमाल नहीं कर रही है और हो सकता है कि फ़ाइल के साथ छेड़छाड़ की गई हो</translation>
<translation id="2170098639895543546">पेज पर मौजूद कोई भी आइटम चुनें</translation>
<translation id="1807571394075492085">Phromium को पसंद के मुताबिक बनाएं</translation>
<translation id="2174917724755363426">इंस्टॉल करने की प्रोसेस पूरी नहीं हुई. क्या आपको वाकई इसे रद्द करना है?</translation>
<translation id="8332848361915479268">क्रोमियम - नेटवर्क में साइन इन करें - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">अपडेट जांच में यह गड़बड़ी है: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="5023314501391717571">Phromium से खाता हटाएं</translation>
<translation id="6063124961634921864">Phromium ऐप्लिकेशन की मदद से, खरीदारी करने के लिए बेहतरीन टूल कभी भी, कहीं भी इस्तेमाल करें</translation>
<translation id="8646569091716523420">iOS के लिए Phromium पर बेहतर सुरक्षित ब्राउज़िंग की सुविधा चालू करें और कभी भी, कहीं भी सुरक्षित रहें</translation>
<translation id="3084983792533696835">खतरनाक साइट. Phromium ने सूचनाएं पाने की अनुमति हटा दी है.</translation>
<translation id="2236949375853147973">मेरी गतिविधि</translation>
<translation id="6387327671844988108">अपने सभी डिवाइसों से ईमेल पते वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें. इसके बाद, यह ईमेल पता आपके Google खाते में सेव हो जाएगा.</translation>
<translation id="722050260205928409">अगर आप किसी कंप्यूटर को शेयर करते हैं, तो दोस्त और परिवार अलग-अलग ब्राउज़ कर सकते हैं और क्रोमियम को जैसा चाहें सेट कर सकते हैं.</translation>
<translation id="703211526866942526">Phromium में मौजूद स्किल</translation>
<translation id="2283803047247799269">इमेज सर्च की मदद से इस टैब को खोजें</translation>
<translation id="2729162423501020677">{NUM_TABS,plural, =1{Phromium का सुझाव है कि आप उस टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहा है}one{Phromium का सुझाव है कि आप उस टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहा है}other{Phromium का सुझाव है कि आप उन टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहे हैं}}</translation>
<translation id="2307973900865360088">डॉक में रखें</translation>
<translation id="6083276764640161328">Phromium में पहले से सेव असुरक्षित साइटों की सूची का इस्तेमाल करके, यूआरएल की जांच करता है. अगर कोई साइट आपका पासवर्ड चुराने की कोशिश करती है या नुकसान पहुंचाने वाली कोई फ़ाइल डाउनलोड होने पर Phromium, सुरक्षित ब्राउज़िंग की सेवा को उनका यूआरएल भेजता है. यूआरएल के साथ-साथ पेज का कुछ कॉन्टेंट भी भेजा जाता है.</translation>
<translation id="2356070529366658676">पूछें</translation>
<translation id="2359808026110333948">जारी रखें</translation>
<translation id="741972887620936671">"<ph name="EXTENSION_NAME" />" एक्सटेंशन का इस्तेमाल करने के लिए, आपको Phromium में साइन इन करना होगा</translation>
<translation id="4709464915929597251">ऐप्लिकेशन चलने के दौरान, Phromium को बैकग्राउंड में चलने से रोकें</translation>
<translation id="6804933363437420201">इस एक्सटेंशन को <ph name="USER_EMAIL_ADDRESS" /> के तौर पर इस्तेमाल करने के लिए, Phromium में साइन इन करें.</translation>
<translation id="2384373936468275798">ChromiumOS आपका डेटा सिंक नहीं कर सका, क्योंकि आपके खाते में साइन इन करने से जुड़ी जानकारी पुरानी हो चुकी है.</translation>
<translation id="7885274480693496462">{NUM_DEVICES,plural, =0{एक या उससे ज़्यादा Phromium एक्सटेंशन, 1 एचआईडी डिवाइस को ऐक्सेस कर रहे थे}=1{एक या उससे ज़्यादा Phromium एक्सटेंशन, 1 एचआईडी डिवाइस को ऐक्सेस कर रहे हैं}one{एक या उससे ज़्यादा Phromium एक्सटेंशन, # एचआईडी डिवाइस को ऐक्सेस कर रहे हैं}other{एक या उससे ज़्यादा Phromium एक्सटेंशन, # एचआईडी डिवाइसों को ऐक्सेस कर रहे हैं}}</translation>
<translation id="1394893265611797679">Phromium को इस साइट के लिए, माइक्रोफ़ोन और कैमरा ऐक्सेस करने की अनुमति चाहिए</translation>
<translation id="2403703063067034158">स्टार्टअप में गड़बड़ी: फ़िलहाल, कोई दूसरी चीज़ सेटअप हो रही है. कृपया बाद में कोशिश करें.</translation>
<translation id="8457868297375575309">किसी भी ऐप्लिकेशन से Phromium में लिंक खोलें और ब्राउज़र को अपने टास्कबार पर ऐक्सेस करें</translation>
<translation id="5354209517289935579">इस दस्तावेज़ को Phromium में Gemini के साथ शेयर करने के लिए 'खास जानकारी पाएं' बटन पर क्लिक करें. इससे आपको दस्तावेज़ की खास जानकारी तुरंत मिलेगी और फ़ॉलो-अप वाले सवाल पूछे जा सकेंगे</translation>
<translation id="6628402244681586711"><ph name="BEGIN_LINK" />Phromium के टूल<ph name="END_LINK" /> की मदद से, सुरक्षित तरीके से ब्राउज़िंग की जा सकती है. साथ ही, अपना डेटा भी कंट्रोल किया जा सकता है</translation>
<translation id="6454834963905669297"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको अपने सभी डिवाइसों पर पासवर्ड वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="2451727308784734061">Password Manager को फटाफट ऐक्सेस करने के लिए, शॉर्टकट का इस्तेमाल करें. आपके पास, अपने शॉर्टकट को कंप्यूटर की होम स्क्रीन पर या ऐप्लिकेशन लॉन्चर पर ले जाने का विकल्प है.</translation>
<translation id="1593547119543498467">Phromium जल्द ही बंद हो जाएगा</translation>
<translation id="6814323389195469782">क्रोमियम में</translation>
<translation id="2485422356828889247">विस्थापित करें</translation>
<translation id="2513154137948333830">सिस्टम फिर से चालू करना होगा: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">'इमेज सर्च' सुविधा की मदद से टेक्स्ट चुनें</translation>
<translation id="2643581100433412871">Phromium मौजूदा पासवर्ड बदलने की कोशिश कर रहा है. इसकी अनुमति देने के लिए, Windows का पासवर्ड डालें.</translation>
<translation id="4103676945224728292">फ़ाइलें डाउनलोड करने के लिए क्रोमियम को मेमोरी एक्‍सेस की ज़रूरत होगी</translation>
<translation id="8743720024689622265">क्रोमियम सहायक</translation>
<translation id="2575822587468774919">'इमेज सर्च' सुविधा की मदद से जानकारी खोजने के लिए, कोई भी एलिमेंट चुनें</translation>
<translation id="8692134707551176334">अपने सभी डिवाइसों से पासवर्ड वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="6035715610127790081">Phromium डाउनलोड करने और अपने Google खाते में साइन इन करने के लिए, अपने फ़ोन से क्यूआर कोड को स्कैन करें.</translation>
<translation id="1579158377846894470">Phromium की मदद से खोजने के लिए.</translation>
<translation id="3626651250874375470">Phromium को इस्तेमाल करना जारी रखें</translation>
<translation id="259935314519650377">डाउनलोड किए गए इंस्टॉलर को कैश मेमोरी में सेव नहीं किया जा सका. गड़बड़ी: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">सिस्टम</translation>
<translation id="7634640424937626608">आपका संगठन, आपकी प्रोफ़ाइल में मौजूद ब्राउज़िंग डेटा देख सकता है और उसे मैनेज कर सकता है. जैसे, आपके बुकमार्क, ब्राउज़िंग इतिहास, और पासवर्ड. हालांकि, वह Phromium पर बनाई गईं अन्य प्रोफ़ाइलों से जुड़ा ब्राउज़िंग डेटा नहीं देख सकता</translation>
<translation id="2669565213445601962">अपनी पहचान की पुष्टि करें, ताकि आप अपने खाते <ph name="ACCOUNT_EMAIL" /> में Phromium का डेटा इस्तेमाल और सेव कर पाएं</translation>
<translation id="3048500373778933960">{COUNT,plural, =0{ऐडवांस सुरक्षा के तहत, अपडेट लागू करने के लिए आपको Phromium को फिर से लॉन्च करना होगा}=1{ऐडवांस सुरक्षा के तहत, अपडेट लागू करने के लिए आपको Phromium को फिर से लॉन्च करना होगा. आपकी गुप्त विंडो दोबारा नहीं खुलेगी.}one{ऐडवांस सुरक्षा के तहत, अपडेट लागू करने के लिए आपको Phromium को फिर से लॉन्च करना होगा. आपकी # गुप्त विंडो दोबारा नहीं खुलेगी.}other{ऐडवांस सुरक्षा के तहत, अपडेट लागू करने के लिए आपको Phromium को फिर से लॉन्च करना होगा. आपकी # गुप्त विंडो दोबारा नहीं खुलेंगी.}}</translation>
<translation id="4393202019354077587">क्रोमियम प्रारंभ करें</translation>
<translation id="3192212313802409327">इंस्‍टॉलेशन के दौरान ऑपरेटिंग सिस्‍टम गड़बड़ी हुई. कृपया क्रोमियम फिर से डाउनलोड करें.</translation>
<translation id="6648732950668475680">अगर आप कोई डिवाइस शेयर करते हैं, तो आपके दोस्त और परिवार के लोग अलग-अलग ब्राउज़ कर सकते हैं. साथ ही, Phromium को अपने हिसाब से सेट कर सकते हैं</translation>
<translation id="3501804488281766385">Phromium को छोटा करने के बाद भी, 'Phromium में Gemini' को अपने डिवाइस पर आसानी से इस्तेमाल करें.</translation>
<translation id="5655763731487334489">क्रोमियम टैब</translation>
<translation id="582020748041490207">ज़्यादा सुरक्षा के लिए, क्रोमियम आपके डेटा को सुरक्षित करेगा.</translation>
<translation id="2693283019505702310">Phromium से अपना Google खाता हटाने के लिए, साइन आउट करें</translation>
<translation id="2989508583692830513">अपने सभी डिवाइसों से पासवर्ड, बुकमार्क वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="2738871930057338499">इंटरनेट से कनेक्ट नहीं किया जा सका. एचटीटीपी 403 फॉरबिडन रिस्पॉन्स दिख रहा है. कृपया अपने प्रॉक्सी कॉन्फ़िगरेशन की जांच करें.</translation>
<translation id="2753623023919742414">खोजने के लिए क्लिक करें</translation>
<translation id="3391021955306442819">Phromium को अपने डिफ़ॉल्ट PDF व्यूअर के तौर पर सेट करें</translation>
<translation id="293156805028931571">इस एक्सटेंशन में मैलवेयर है और यह खतरनाक है. इसे Phromium से हटाएं, ताकि यह उन साइटों का डेटा न देख सके और न उसमें बदलाव कर सके जिन पर विज़िट किया जाता है. इस डेटा में आपकी निजी जानकारी भी शामिल है.</translation>
<translation id="2799223571221894425">फिर से लॉन्‍च करें</translation>
<translation id="4742633141454352374">आपका Phromium</translation>
<translation id="2816462166102338036">इमेज सर्च की मदद से इस वीडियो को खोजें</translation>
<translation id="2191308357458164968">iOS पर Phromium का इस्तेमाल करके, अपने कैमरे से प्रॉडक्ट खोजने, कीमतों में गिरावट ट्रैक करने जैसे कई दूसरे काम कभी भी, कहीं भी करें.</translation>
<translation id="2841525013647267359">इस भाषा का अनुवाद पाएं</translation>
<translation id="2846251086934905009">इंस्टॉल करने में गड़बड़ी हुई: इंस्टॉल करने की प्रोसेस पूरी नहीं हो सकी. इंस्टॉल करने की प्रोसेस रद्द की गई.</translation>
<translation id="4498037716339180906">क्रोमियम से निकालें...</translation>
<translation id="4049188396834160957">अगर आप साइन इन हैं, तो यह सुविधा Phromium पर आपको सुरक्षित रखती है. साथ ही, इसका इस्तेमाल करके Google के अन्य ऐप्लिकेशन में सुरक्षा को बेहतर बनाया जा सकता है</translation>
<translation id="2885378588091291677">काम का मैनेजर</translation>
<translation id="4119302609687132178">&amp;क्रोमियम के बारे में</translation>
<translation id="2915996080311180594">बाद में रीस्टार्ट करें</translation>
<translation id="8232968781653330429">आपका डेटा, लंबे पासवर्ड से एन्क्रिप्ट यानी सुरक्षित किया गया है. अपने Google खाते में, Phromium का डेटा सेव करने और उसका इस्तेमाल करने के लिए यह लंबा पासवर्ड डालें.</translation>
<translation id="2945997411976714835">इंस्टॉल करने में गड़बड़ी हुई: इंस्टॉल करने की प्रोसेस शुरू नहीं हो सकी.</translation>
<translation id="5624652745932625503">iOS पर Phromium में सेव किए गए पासवर्ड इस्तेमाल करके, साइटों पर तेज़ी से साइन इन करें</translation>
<translation id="8821179372057577828">आपका संगठन Phromium मैनेज करता है</translation>
<translation id="741172935898285572">क्रोमियम अप टू डेट है</translation>
<translation id="8798708493876822519">अगर कोई साइट आपका पासवर्ड चुराने की कोशिश करती है या नुकसान पहुंचाने वाली कोई फ़ाइल डाउनलोड होने पर Phromium, सुरक्षित ब्राउज़िंग की सेवा को उनके यूआरएल भेज सकता है. यूआरएल के साथ-साथ पेज का कुछ कॉन्टेंट भी भेजा जाता है</translation>
<translation id="6896740867011823632">अपने माता-पिता के चुने गए विकल्पों के साथ, ऑनलाइन सुरक्षित रहने के लिए, Phromium में साइन इन करें</translation>
<translation id="3003694935412297923">सभी टास्क</translation>
<translation id="3580865868015023718">{count,plural, =1{आपके Google खाते में डेटा सेव करने और सभी डिवाइसों पर उसका इस्तेमाल करने से पहले, Phromium को आपकी पहचान की पुष्टि करनी होगी. अभी साइन आउट करने पर यह डेटा (1 आइटम) मिट जाएगा.}one{आपके Google खाते में डेटा सेव करने और सभी डिवाइसों पर उसका इस्तेमाल करने से पहले, Phromium को आपकी पहचान की पुष्टि करनी होगी. अभी साइन आउट करने पर यह डेटा ({count} आइटम) मिट जाएगा.}other{आपके Google खाते में डेटा सेव करने और सभी डिवाइसों पर उसका इस्तेमाल करने से पहले, Phromium को आपकी पहचान की पुष्टि करनी होगी. अभी साइन आउट करने पर यह डेटा ({count} आइटम) मिट जाएगा.}}</translation>
<translation id="1211179250505223767"><ph name="URL" /> को Phromium के नए टैब में खोलें.</translation>
<translation id="4742400838355945730">स्किल जैसी एआई की सुविधाएं आपके Google खाते में सेव की जाती हैं और इन्हें Phromium सिंक से अलग मैनेज किया जाता है</translation>
<translation id="8070050512429584052">अपने सभी डिवाइसों पर एक्सटेंशन वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="666691655897541311">क्रोमियम में जोड़ रहा है...</translation>
<translation id="3038232873781883849">इंस्टॉल करने की प्रोसेस, कुछ देर में शुरू होगी...</translation>
<translation id="3045032126857188731">वह भाषा जिसमें अनुवाद किया गया: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">सुझाव देने वाला डायलॉग बॉक्स बंद करें</translation>
<translation id="919456815618829047"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको <ph name="DEVICE" /> पर रीडिंग लिस्ट वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="6141754610526066487">Phromium की अन्य प्रोफ़ाइलें</translation>
<translation id="2380720899384114679">एक्सटेंशन, ऐड-ऑन होते हैं. इनकी मदद से, Phromium को अपनी पसंद के मुताबिक बनाया जा सकता है. इससे आपको व्यवस्थित रहने और रोज़मर्रा के कामों को आसान बनाने में मदद मिलती है.</translation>
<translation id="2507281899032275020">Google को क्रैश रिपोर्ट और <ph name="UMA_LINK" /> भेजकर क्रोमियम को बेहतर बनाने में मदद करें</translation>
<translation id="1514966729948178660">Phromium ऐप्लिकेशन के साथ, Google की सुरक्षा सुविधाओं का फ़ायदा कभी भी, कहीं भी पाएं</translation>
<translation id="4158795507995981959">{NUM_DEVICES,plural, =0{एक या उससे ज़्यादा Phromium एक्सटेंशन, 1 यूएसबी डिवाइस को ऐक्सेस कर रहे थे}=1{एक या उससे ज़्यादा Phromium एक्सटेंशन, 1 यूएसबी डिवाइस को ऐक्सेस कर रहे हैं}one{एक या उससे ज़्यादा Phromium एक्सटेंशन, # यूएसबी डिवाइस को ऐक्सेस कर रहे हैं}other{एक या उससे ज़्यादा Phromium एक्सटेंशन, # यूएसबी डिवाइसों को ऐक्सेस कर रहे हैं}}</translation>
<translation id="78720743239019396"><ph name="DEVICE" /> पर मौजूद अपनी रीडिंग लिस्ट वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="7000206277447032115">Phromium का इतिहास</translation>
<translation id="4555002192651219296">इंस्‍टॉलर संगह को असंकुचित करने में विफल हुआ. कृपया क्रोमियम फिर से डाउनलोड करें.</translation>
<translation id="310459126943037700">टास्क खत्म नहीं किए जा सके.</translation>
<translation id="3104828284009500087">पेज पर कोई भी जानकारी खोजें</translation>
<translation id="4867557516756736957">अपने पासवर्ड, बुकमार्क, और इतिहास को सभी डिवाइसों पर सिंक रखें. अपने डिफ़ॉल्ट ब्राउज़र को Phromium पर अपडेट करके, अपनी पसंदीदा सुविधाओं को आसानी से ऐक्सेस करें.</translation>
<translation id="8632308594821621017">Phromium आपके माइक्रोफ़ोन का उपयोग कर रहा है.</translation>
<translation id="3130333203120345554">नई खोज</translation>
<translation id="3137969841538672700">खोजने के लिए खींचें और छोड़ें</translation>
<translation id="9173792796158381383">यह टैब अतिरिक्त संसाधनों का इस्तेमाल कर रहा है. परफ़ॉर्मेंस को बेहतर बनाने के लिए, Phromium को इसे बंद करने की अनुमति दें.</translation>
<translation id="8874679893080632357">स्क्रीन शेयर करने के लिए, 'सिस्टम सेटिंग' में जाकर Phromium के लिए स्क्रीन रिकॉर्ड करने की अनुमति दें</translation>
<translation id="101045618220347251">क्रोमियम फिर से लॉन्च करें</translation>
<translation id="3161522574479303604">सभी भाषाएं</translation>
<translation id="5940989267583033306">क्रोमियम गु&amp;प्त विंडो में लिंक खोलें</translation>
<translation id="2045477525210426976">अपनी नई Phromium प्रोफ़ाइल को पसंद के मुताबिक बनाएं</translation>
<translation id="3540518135502114323">टैब स्विच किए बिना भी एआई मोड के साथ चैट जारी रखी जा सकती है. इस सुविधा का इस्तेमाल करने के लिए, Phromium में साइन इन करें. आपको अपने सभी डिवाइसों पर अपने पासवर्ड वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="1496180326063744749">Phromium से अपना Google खाता हटाने के लिए, सेटिंग पेज पर जाकर Phromium से साइन आउट करें</translation>
<translation id="7792783034323745412">इसके बाद, Phromium आपसे पूछ सकता है कि क्या आपको सेव की गई जानकारी का इस्तेमाल, फ़ॉर्म को ऑटोमैटिक भरने के लिए करना है</translation>
<translation id="5240091371721695404">क्रोमियम इसकी डेटा निर्देशिका में पढ़ या लिख नहीं सकता:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="2746489948338052955">iOS पर Phromium की मदद से, Google के अपने पसंदीदा एआई टूल कभी भी, कहीं भी इस्तेमाल करें.</translation>
<translation id="4848363951707149242"><ph name="DEVICE" /> में मौजूद अपने एक्सटेंशन वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="3286538390144397061">अभी फिर से प्रारंभ करें</translation>
<translation id="8613877111531019527">Google API (एपीआई) कुंजियां मौजूद नहीं हैं. क्रोमियम के कुछ फ़ंक्शन बंद कर दिए जाएंगे.</translation>
<translation id="2784090498377460662">जब क्रोमियम बंद हो तब पृष्ठभूमि ऐप्‍लिकेशन चलाना जारी रखें</translation>
<translation id="3905054486991167751">Phromium तब अपडेट होगा, जब डिवाइस इस्तेमाल नहीं किया जा रहा होगा</translation>
<translation id="4502950976754616266">असुरक्षित कनेक्शन का इस्तेमाल करके किसी भी साइट को लोड करने से पहले, Phromium आपको चेतावनी देगा</translation>
<translation id="6107453188231652861">Phromium की सभी विंडो बंद करने पर, आपको ज़्यादातर साइटों से साइन आउट कर दिया जाएगा. हालांकि, अगर आपने Phromium में साइन इन किया हुआ है, तो आपको Google खाते से साइन आउट नहीं किया जाएगा. <ph name="SETTINGS_LINK" />, ताकि साइटें आपके ब्राउज़िंग सेशन की जानकारी याद रखें.</translation>
<translation id="3352986031709923790">खोज वाली जगह में सबसे ऊपर का दायां कोना: दाईं ओर से <ph name="RIGHT" />%, सबसे ऊपर से <ph name="TOP" />%</translation>
<translation id="5896635343289575401">आपके खाते में मौजूद Phromium का डेटा</translation>
<translation id="5662253013097242821">अपने फ़ोन पर Phromium के साथ पासवर्ड इस्तेमाल करें</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="5326080492429181135">क्या आप मौजूदा Phromium प्रोफ़ाइल में स्विच करना चाहते हैं?</translation>
<translation id="3412460710772753638">इस डिवाइस पर, Password Manager में अपडेट करें</translation>
<translation id="657700335789940813">Phromium, अपडेट के लिए तैयार है</translation>
<translation id="3487742274367151379"><ph name="DEVICE" /> में मौजूद अपने बुकमार्क वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="3438772217992559640">इमेज सर्च की मदद से इस टैब को खोजें</translation>
<translation id="8062355070850891600">अपने फ़ोन पर, Phromium के साथ और बेहतर सुरक्षित ब्राउज़िंग की सुविधा पाएं</translation>
<translation id="5419337472918920970">Phromium को अपने हिसाब से सेट करना...</translation>
<translation id="6573105037542661278">ऐसा करने से इस डिवाइस से <ph name="ITEMS_COUNT" /> आइटम मिट जाएंगे. बाद में अपना डेटा पाने के लिए, Phromium में <ph name="USER_EMAIL" /> के रूप में साइन इन करें.</translation>
<translation id="4600986251755456192"><ph name="SHORTCUT" /> दबाकर Phromium प्रोफ़ाइलों के बीच स्विच किया जा सकता है</translation>
<translation id="8118189978246431067">कृपया सभी क्रोमियम विंडो बंद करें और फिर से प्रयास करें.</translation>
<translation id="7430418346833889620">विंडो शेयर करने के लिए, 'सिस्टम सेटिंग' में जाकर Phromium के लिए स्क्रीन रिकॉर्ड करने की अनुमति दें</translation>
<translation id="2943929290955142701"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अलग ब्राउज़र का इस्तेमाल करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें.</translation>
<translation id="5896697187441340113">फ़ोन या टैबलेट पर Phromium ब्राउज़र डाउनलोड करने के लिए क्यूआर कोड</translation>
<translation id="354621070532799440">रिमाइंडर: Google की बेहतरीन सुरक्षा सुविधाएं अब आपके फ़ोन में</translation>
<translation id="6718500626359284607">स्क्रीन शेयर करने के लिए, 'सिस्टम सेटिंग' में जाकर Phromium के लिए स्क्रीन रिकॉर्ड करने की अनुमति दें.</translation>
<translation id="6511372913460632136">बेहतर सुरक्षा मोड चालू होने पर, उन साइटों के लिए JavaScript ऑप्टिमाइज़ेशन की सुविधा बंद हो जाती है जिनकी पहचान Phromium नहीं कर पाता</translation>
<translation id="3597003331831379823">खास सुविधाओं का ऐक्सेस होने के बाद भी, सेटअप नहीं किया जा सका. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="6755400919568846467">Phromium में साइन इन करें</translation>
<translation id="8702816719621016911">इस व्यक्ति का ब्राउज़िंग डेटा इस डिवाइस से मिटा दिया जाएगा. डेटा वापस पाने के लिए, क्रोमियम में <ph name="USER_EMAIL" /> के रूप में साइन इन करें.</translation>
<translation id="64780623876080332">{COUNT,plural, =0{क्रोमियम के लिए एक नया अपडेट उपलब्ध है और जैसे ही आप फिर से लॉन्च करेंगे, अपडेट लागू कर दिया जाएगा.}=1{क्रोमियम के लिए एक नया अपडेट उपलब्ध है और जैसे ही आप फिर से लॉन्च करेंगे, अपडेट लागू कर दिया जाएगा. आपकी गुप्त विंडो फिर से नहीं खुलेगी.}one{क्रोमियम के लिए एक नया अपडेट उपलब्ध है और जैसे ही आप फिर से लॉन्च करेंगे, अपडेट लागू कर दिया जाएगा. आपकी # गुप्त विंडो फिर से नहीं खुलेंगी.}other{क्रोमियम के लिए एक नया अपडेट उपलब्ध है और जैसे ही आप फिर से लॉन्च करेंगे, अपडेट लागू कर दिया जाएगा. आपकी # गुप्त विंडो फिर से नहीं खुलेंगी.}}</translation>
<translation id="3667616615096815454">इंस्टॉल नहीं किया जा सका, सर्वर के पास ऐप्लिकेशन की जानकारी उपलब्ध नहीं है.</translation>
<translation id="678730369472836428">अपने Google खाते में मौजूद, Phromium का पूरा डेटा एन्क्रिप्ट (सुरक्षित) करने के लिए, <ph name="BEGIN_LINK" />अपना लंबा पासवर्ड<ph name="END_LINK" /> इस्तेमाल करें. Google Pay पर जोड़े गए पेमेंट के तरीके और पते एन्क्रिप्ट (सुरक्षित) नहीं किए जाएंगे. Phromium का ब्राउज़िंग इतिहास सिंक नहीं किया जाएगा.</translation>
<translation id="2393631353645378988">{COUNT,plural, =0{आपके एडमिन का कहना है कि आप यह अपडेट लागू करने के लिए क्रोमियम को फिर से लॉन्च करें}=1{आपके एडमिन का कहना है कि आप यह अपडेट लागू करने के लिए क्रोमियम को फिर से लॉन्च करें. आपकी गुप्त विंडो फिर से नहीं खुलेगी.}one{आपके एडमिन का कहना है कि आप यह अपडेट लागू करने के लिए क्रोमियम को फिर से लॉन्च करें. आपकी # गुप्त विंडो फिर से नहीं खुलेंगी.}other{आपके एडमिन का कहना है कि आप यह अपडेट लागू करने के लिए क्रोमियम को फिर से लॉन्च करें. आपकी # गुप्त विंडो फिर से नहीं खुलेंगी.}}</translation>
<translation id="2203303261468330007">नए क्रोमियम &amp;टैब में लिंक खोलें</translation>
<translation id="686463893976008238">मनमुताबिक अनुभव और अन्य सुविधाएं पाने के लिए, Phromium को Google की अन्य सेवाओं के साथ लिंक करें</translation>
<translation id="3729187154190517324">"टैब वगैरह जोड़ें" बटन का इस्तेमाल करके, एक से ज़्यादा टैब, फ़ाइलें, और टूल जोड़ें. इससे आपको अपनी खोज को बेहतर बनाने में मदद मिलेगी.</translation>
<translation id="5596264049590907430">Phromium की प्रोफ़ाइलें मैनेज करें</translation>
<translation id="5594723037153142396">जानें कि Phromium कुछ फ़ाइलों को डाउनलोड होने से क्यों रोकता है</translation>
<translation id="3425307214497790458">कोई कार्रवाई ज़रूरी होने पर Phromium आपको इसकी सूचना देगा</translation>
<translation id="4247980944121268675">Phromium उन पेजों को पहले से लोड कर देता है जिन पर आपके जाने की संभावना हो. ऐसा इसलिए है, ताकि जब आप उन पर जाएं, तो वे ज़्यादा तेज़ी से लोड हों</translation>
<translation id="3810973564298564668">मैनेज करें</translation>
<translation id="1058395779823101457">सेव किए गए पासवर्ड इस्तेमाल करने के लिए, क्यूआर कोड को स्कैन करें. इसके बाद, iOS के लिए Phromium डाउनलोड करें और अपने Google खाते में साइन इन करें</translation>
<translation id="3846683726093018685">**खास जानकारी:** 30 शब्दों से कम के एक वाक्य में, स्क्रीनशॉट में मौजूद कॉन्टेंट के मुख्य विषय और मकसद के बारे में बताओ.

          **सुझाव वाले सवाल:** ऐसे तीन से पांच सवालों की बुलेट वाली सूची जनरेट करो जो स्क्रीनशॉट को बेहतर तरीके से समझने के लिए, उपयोगकर्ता पूछ सकता है. इन सवालों में कम से कम एक सवाल ऐसा होना चाहिए जो किसी विज़ुअल ऑब्जेक्ट, उसके डिज़ाइन या उसकी जगह के बारे में हो.</translation>
<translation id="1339028735921640597"><ph name="PAGE_TITLE" /> - क्रोमियम</translation>
<translation id="430953676539987275">अपने सभी डिवाइसों पर बुकमार्क वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="3885770153807205175">भाषा चुनने की सुविधा</translation>
<translation id="5947409614720749543">क्रोमियम को पसंद के मुताबिक बनाएं और नियंत्रित करें. कुछ है जिस पर आपको ध्यान देने की ज़रूरत है - विवरण के लिए क्लिक करें.</translation>
<translation id="2176348074240183776">क्रोमियम को खोलना और ब्राउज़ करना शुरू करने के लिए अपना नाम क्लिक करें.</translation>
<translation id="3892148308691398805">टेक्स्ट कॉपी करें</translation>
<translation id="3679766722656346339"><ph name="EXISTING_USER" /> इस Phromium प्रोफ़ाइल में पहले से साइन इन है. आपकी निजी ब्राउज़िंग के लिए, Phromium आपकी खुद की प्रोफ़ाइल बना सकता है.</translation>
<translation id="6085953975934135790">यह एक्सटेंशन, Chrome Web Store की नीति का उल्लंघन करता है और यह खतरनाक हो सकता है. इसे Phromium से हटाएं, ताकि यह उन साइटों का डेटा न देख सके और न उसमें बदलाव कर सके जिन पर विज़िट किया जाता है. इस डेटा में आपकी निजी जानकारी भी शामिल है.</translation>
<translation id="3941890832296813527">इंस्टॉल करने में गड़बड़ी हुई: इंस्टॉलर की फ़ाइल का नाम अमान्य है या इस नाम का इस्तेमाल नहीं किया जा सकता.</translation>
<translation id="608187946760434925">क्रोमियम, पासवर्ड कॉपी करने की कोशिश कर रहा है. इसकी अनुमति देने के लिए Windows का पासवर्ड डालें.</translation>
<translation id="3054592240125889472">अपने सभी डिवाइसों पर सेव की गई जानकारी वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="3140795250676341027">आपके Google खाते में सेव किए गए पासवर्ड, पेमेंट के तरीके, और पते इस डिवाइस से हटा दिए जाएंगे. अगर आपको Phromium में इनका फिर से इस्तेमाल करना है, तो दोबारा साइन इन करें.</translation>
<translation id="395904275706073188">सुरक्षित किए गए पेज का कॉन्टेंट पढ़ा नहीं जा सकता. कोई दूसरा पेज पढ़ें.</translation>
<translation id="4227910144250222665">जानें कि Phromium आपको इंटरनेट पर कैसे सुरक्षित रखता है</translation>
<translation id="3967822245660637423">डाउनलोड पूरा हुआ</translation>
<translation id="4150430234581811723">पता बार या खोज बॉक्स में टाइप किए गए आपके टेक्स्ट को Phromium, आपके संगठन के एआई, सर्च, और एजेंट टूल को भेजता है. इससे आपको खोज से जुड़े सुझाव मिलते हैं.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing के बारे में जानकारी</translation>
<translation id="3997429360543082038">ChromiumOS के बारे में जानकारी</translation>
<translation id="4847805566397342820">जब उपयोगकर्ता किसी साइट पर जाता है, तो Phromium निजी सर्वर के ज़रिए <ph name="BEGIN_LINK" />Google सुरक्षित ब्राउज़िंग<ph name="END_LINK" /> को उस साइट के यूआरएल का एक अस्पष्ट हिस्सा भेजता है. यह सर्वर, आपके आईपी पते को छिपा देता है. अगर साइट पर कुछ संदिग्ध गतिविधि मिलती है, तो साइट का पूरा यूआरएल और पेज का कुछ कॉन्टेंट भी भेजा जाता है.</translation>
<translation id="4016217212818346953">Password Manager से, अपना पासवर्ड सुरक्षित रखें</translation>
<translation id="4019629340646866719"><ph name="BEGIN_LINK_LINUX_OSS" />Linux डेवलपमेंट एनवायरमेंट<ph name="END_LINK_LINUX_OSS" /> की तरह, ChromiumOS को भी अतिरिक्त <ph name="BEGIN_LINK_CROS_OSS" />ओपन सोर्स सॉफ़्टवेयर<ph name="END_LINK_CROS_OSS" /> की मदद से बनाया गया है.</translation>
<translation id="4022972681110646219">स्क्रीन का अनुवाद करें</translation>
<translation id="4023601594785368013">सोर्स की भाषा: <ph name="LANGUAGE" /></translation>
<translation id="7037690020492895588">किसी भी ऐप्लिकेशन से Phromium में लिंक खोलें. साथ ही, आसानी से ऐक्सेस करने के लिए, इसे टास्कबार में पिन करें.</translation>
<translation id="6916567874038032700"><ph name="BEGIN_LINK" />अभी वाली सेटिंग<ph name="END_LINK" /> की रिपोर्ट करके क्रोमियम को बेहतर बनाने में सहायता करें</translation>
<translation id="4050175100176540509">महत्‍वपूर्ण सुरक्षा सुधार और नई सुविधाएं नवीनतम वर्शन में उपलब्‍ध हैं.</translation>
<translation id="4055805654398742145">Password Manager</translation>
<translation id="4327384240042572707">{COUNT,plural, =1{Phromium का 1 मिनट तक इस्तेमाल न करने पर, आपका संगठन इसे अपने-आप बंद कर देता है. ब्राउज़िंग डेटा मिटा दिया जाता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं.}one{Phromium का # मिनट तक इस्तेमाल न करने पर, आपका संगठन इसे अपने-आप बंद कर देता है. ब्राउज़िंग डेटा मिटा दिया जाता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं.}other{Phromium का # मिनट तक इस्तेमाल न करने पर, आपका संगठन इसे अपने-आप बंद कर देता है. ब्राउज़िंग डेटा मिटा दिया जाता है. इसमें, ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं.}}</translation>
<translation id="2498876341137940584">Phromium का गुप्त मोड</translation>
<translation id="1371775705240141332">'Phromium के बारे में जानकारी' पेज पर जाएं</translation>
<translation id="1983555117242858621">अपने ब्राउज़र को एक नया लुक देने के लिए, Phromium को कस्टमाइज़ करें</translation>
<translation id="3730928612696305544">Phromium को अपनी पसंद के मुताबिक बनाएं</translation>
<translation id="4148957013307229264">इंस्‍टॉल हो रहा है...</translation>
<translation id="5030279289462254554"><ph name="PAGE_TITLE" /> - नेटवर्क में साइन इन करें - क्रोमियम</translation>
<translation id="8940475598678719246"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको अपने सभी डिवाइसों पर रीडिंग लिस्ट वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="3361801572720154185">क्रोमियम के लिए शानदार ऐप्‍स, गेम, एक्‍सटेंशन और थीम खोजें.</translation>
<translation id="5104340040322658377">अपने सभी कंप्यूटर पर यह एक्सटेंशन और इसी तरह का अन्य टूल पाने के लिए, Phromium में साइन इन करें</translation>
<translation id="6533832886058295845">अपने माता-पिता के चुने गए विकल्पों के साथ ऑनलाइन सुरक्षित रहने के लिए, अपनी Phromium प्रोफ़ाइल पर स्विच करें, जहां आपने पहले से <ph name="USER_EMAIL_ADDRESS" /> के तौर पर साइन इन किया है</translation>
<translation id="4222932583846282852">रद्द किया जा रहा है...</translation>
<translation id="4224210481850767180">इंस्टॉल करने की प्रोसेस रद्द कर दी गई है.</translation>
<translation id="6904238369362879351">आपके क्रोमियम डेटा को इस खाते से लिंक करें?</translation>
<translation id="357744319784654404">यह सुविधा स्टैंडर्ड सुरक्षा मोड की तुलना में ज़्यादा डेटा का विश्लेषण करके, आपको ऐसी खतरनाक साइटों के बारे में चेतावनी देती है जिनके बारे में Google को पहले से नहीं पता था. Phromium की चेतावनियों को अनदेखा किया जा सकता है.</translation>
<translation id="7228779501660520489">Phromium से साइन आउट करें</translation>
<translation id="2782053121162821">क्रोमियम के लिए सहायता पाएं</translation>
<translation id="4281844954008187215">सेवा की शर्तें</translation>
<translation id="5084022108026911204">अनिर्दिष्ट कारण से इंस्‍टॉलेशन विफल हुआ. अगर Google Chrome अभी खुला हुआ है, तो कृपया उसे बंद करें और फिर से प्रयास करें.</translation>
<translation id="5139026954638666406">Phromium से पासवर्ड एक्सपोर्ट करें</translation>
<translation id="4304713468139749426">Password Manager</translation>
<translation id="4334241893986177674">इस स्क्रीनशॉट को खोजें</translation>
<translation id="8324735155671556570">Windows के चालू होते ही Phromium को लॉन्च करें</translation>
<translation id="4400772909124543403">कोई अपडेट उपलब्ध नहीं है</translation>
<translation id="2185735215611818026">फिर भी क्रोमियम से बाहर निकलें?</translation>
<translation id="4413205837991854510">हमेशा 'इमेज सर्च' सुविधा का शॉर्टकट दिखाएं</translation>
<translation id="1338297030721125711">क्रोमियम को बैकग्राउंड में चलने दें</translation>
<translation id="3764462296589283740">{NUM_EXTENSIONS,plural, =1{Phromium का सुझाव है कि आप यह एक्सटेंशन हटा दें. <ph name="BEGIN_LINK" />Phromium पर इस्तेमाल किए जा सकने वाले एक्सटेंशन के बारे में ज़्यादा जानें<ph name="END_LINK" />}one{Phromium का सुझाव है कि आप यह एक्सटेंशन हटा दें. <ph name="BEGIN_LINK" />Phromium पर इस्तेमाल किए जा सकने वाले एक्सटेंशन के बारे में ज़्यादा जानें<ph name="END_LINK" />}other{Phromium का सुझाव है कि आप ये एक्सटेंशन हटा दें. <ph name="BEGIN_LINK" />Phromium पर इस्तेमाल किए जा सकने वाले एक्सटेंशन के बारे में ज़्यादा जानें<ph name="END_LINK" />}}</translation>
<translation id="1011403527148313450">क्रोमियम को पसंद के मुताबिक बनाएं और नियंत्रित करें</translation>
<translation id="4427306783828095590">बेहतर सुरक्षा की मदद से फ़िशिंग और मैलवेयर को बेहतर तरीके से ब्लॉक किया जाता है</translation>
<translation id="4434353761996769206">इंस्टॉलर से जुड़ी गड़बड़ी: <ph name="INSTALLER_ERROR" /></translation>
<translation id="5736318769022575415"><ph name="MANAGER" />, Phromium को मैनेज करता है</translation>
<translation id="2477616462388290618">Phromium पर प्रोफ़ाइल जोड़ें</translation>
<translation id="4447409407328223819">Chrome for Testing के बारे में जानकारी</translation>
<translation id="972523218852576493">अपने Google खाते में Phromium का डेटा इस्तेमाल करने और सेव करने के लिए, अपना लंबा पासवर्ड डालें</translation>
<translation id="4493028449971051158">स्टार्टअप में गड़बड़ी हुई: कृपया इंस्टॉलर को एडमिन के तौर पर चलाएं.</translation>
<translation id="4501471624619070934">इंस्टॉल नहीं हो पाया, क्योंकि इस देश में ऐक्सेस करने की अनुमति नहीं है.</translation>
<translation id="8839763675940122379">इस एक्सटेंशन ने निजता लागू करने की प्रक्रियाओं को पब्लिश नहीं किया है. जैसे, डेटा को इकट्ठा और उसे इस्तेमाल करने का तरीका. Phromium का सुझाव है कि आप इसे हटा दें.</translation>
<translation id="2339640488105852505">Phromium में आपका स्वागत है; नई ब्राउज़र विंडो खोली गई</translation>
<translation id="8536959233160434213">Phromium को आपके आस-पास की जगहों को मैप करने और आपके हाथों को ट्रैक करने की अनुमति चाहिए</translation>
<translation id="1077734277628859167">आपने पहले से ही Phromium की किसी दूसरी प्रोफ़ाइल में, <ph name="USER_EMAIL_ADDRESS" /> के तौर पर साइन इन किया हुआ है</translation>
<translation id="5512897665247593318">इस सेटिंग के चालू होने पर Phromium, पेजों को पहले से लोड कर देता है. इससे, पेजों को ज़्यादा तेज़ी से खोजा और ब्राउज़ किया जा सकता है. <ph name="BEGIN_LINK" />पेजों को पहले से लोड करने की सुविधा के बारे में ज़्यादा जानें<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">अगर आपको लगता है कि कोई साइट नुकसान पहुंचा सकती है, तो उसकी शिकायत करें. इससे सभी लोगों के लिए ऑनलाइन सुरक्षा को बेहतर बनाने में मदद मिलेगी.</translation>
<translation id="6624033199018630177">Phromium ने इस डाउनलोड को ब्लॉक कर दिया है, क्योंकि आपने सुरक्षित ब्राउज़िंग की सुविधा बंद कर दी है और इस फ़ाइल की पुष्टि नहीं की जा सकती</translation>
<translation id="3039804643080655517">अपने फ़ोन पर Phromium के साथ Google Lens आज़माएं</translation>
<translation id="4594305310729380060">इस डिवाइस पर, Password Manager में सेव करें</translation>
<translation id="8064263528617889755">क्रोमियम ऐप्स</translation>
<translation id="4598116752460667024">सूची में से कोई भी प्रोसेस खोजें.</translation>
<translation id="4613863813562375431">ChromiumOS वर्शन</translation>
<translation id="7245201002247176127">करीब अप टू डेट हो गया है! अपडेट करना पूरा करने के लिए क्रोमियम फिर से लॉन्च करें.</translation>
<translation id="8846891938874485868">इससे Phromium के V8 इंजन के ज़रिए साइटों के काम करने की स्पीड तेज़ करने में मदद मिलती है. हालांकि, इससे सुरक्षा से जुड़े खतरों की संभावना बढ़ जाती है</translation>
<translation id="7525500996671436081">'Phromium की मदद से खोजें' सुविधा खोलें</translation>
<translation id="1224842000407297331">Phromium प्रोफ़ाइल</translation>
<translation id="4956303519269880412">चेतावनी: Phromium, एक्सटेंशन को आपका ब्राउज़िंग इतिहास रिकॉर्ड करने से नहीं रोक सकता. गुप्त मोड में इस एक्सटेंशन को बंद करने के लिए, इस विकल्प से चुने हुए का निशान हटाएं.</translation>
<translation id="2708255035805733225">अगर Phromium के इस्तेमाल से जुड़ी जानकारी देने वाली रिपोर्ट शेयर की जाती हैं, तो आपके देखे गए पेजों के यूआरएल उनमें शामिल होते हैं</translation>
<translation id="4673710618874938871">आपने सदस्यता वाले <ph name="USER_NAME" /> के खाते से साइन इन किया है. खाते का मेन्यू खोलें</translation>
<translation id="1883292567514549610">ऐसा लगता है कि प्रोफ़ाइल का उपयोग अन्य क्रोमियम प्रोसेस (<ph name="PROCESS_ID" />) द्वारा किसी अन्य कंप्यूटर (<ph name="HOST_NAME" />) पर किया जा रहा है. क्रोमियम ने प्रोफ़ाइल को लॉक कर दिया है ताकि वह दूषित न हो. अगर आप पक्का हैं कि कोई अन्य प्रोसेस इस प्रोफ़ाइल का उपयोग नहीं कर रही हैं, तो आप प्रोफ़ाइल को अनलॉक कर सकते हैं और क्रोमियम को फिर से लॉन्च कर सकते हैं.</translation>
<translation id="4680828127924988555">इंस्टॉल करना रद्द करें</translation>
<translation id="1889305042180577023">आपके Phromium का कुछ डेटा, अब तक आपके Google खाते में सेव नहीं किया गया है. साइन आउट करने से पहले कुछ मिनट इंतज़ार करें. अभी साइन आउट करने पर यह डेटा मिट जाएगा.</translation>
<translation id="8079525505870459051">आपके साइन इन रहने के दौरान, आपके पास Phromium में अपने Google खाते से पासवर्ड और अन्य चीज़ों का इस्तेमाल करने का विकल्प होता है. <ph name="SHORTCUT" />, Google सेवाओं की सेटिंग बदल सकता है.</translation>
<translation id="2171507067211697961">इस कंप्यूटर पर पहले किसी अन्य व्यक्ति ने <ph name="ACCOUNT_EMAIL_LAST" /> के रूप में Phromium में साइन इन किया. अपनी जानकारी अलग रखने के लिए कृपया नया Phromium उपयोगकर्ता बनाएं.</translation>
<translation id="4724676981607797757">काम नहीं करने वाले प्रोटोकॉल की गड़बड़ी की वजह से इंस्टॉल नहीं हो सका.</translation>
<translation id="6925701206088903005">फिर भी क्रोमियम छोड़ें?</translation>
<translation id="4514755609496543621">क्रोमियम के लिए एक खास सुरक्षा अपडेट अभी लागू किया गया था. अभी रीस्टार्ट करें और हम आपके टैब बहाल कर देंगे.</translation>
<translation id="8673673368917636496">आपने हाल ही में इस वेबसाइट का इस्तेमाल नहीं किया है. Phromium ने <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, और <ph name="COUNT" /> अन्य अनुमतियां हटा दी हैं.</translation>
<translation id="3638319732826965647">अगर 'Phromium में Gemini' खुला है, तो नए टैब खोलने पर साइड पैनल खुला रहेगा</translation>
<translation id="479167709087336770">इसमें स्पेलिंग जाँचने वाली उसी सुविधा का इस्तेमाल होता है जिसका इस्तेमाल 'Google सर्च' में किया जाता है. आप ब्राउज़र में जो भी लेख लिखते हैं उसे Google को भेजा जाता है. आप 'सेटिंग' में जाकर इसे कभी भी बदल सकते हैं.</translation>
<translation id="2659245507243672392">बिना किसी खाते के, Phromium का इस्तेमाल करें</translation>
<translation id="166411027652942990">mDNS ट्रैफ़िक की अनुमति देने के लिए क्रोमियम के लिए इनबाउंड नियम.</translation>
<translation id="6031862420354068813">&amp;Phromium को अपडेट करने के लिए फिर से लॉन्च करें</translation>
<translation id="4918086044614829423">स्वीकार करें</translation>
<translation id="4918844574251943176">इमेज को कॉपी किया गया</translation>
<translation id="1531905832227009774">अपने सभी डिवाइसों पर रीडिंग लिस्ट वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें</translation>
<translation id="4319892378006430019">क्रोमियम पृष्ठभूमि मोड में है.</translation>
<translation id="8972359100025490790">Phromium का साइन इन डायलॉग बॉक्स बंद करने के लिए क्लिक करें</translation>
<translation id="3639078149590125530">Phromium प्रोफ़ाइलों का इस्तेमाल करके, Phromium से जुड़ी अपनी सभी चीज़ों को अलग-अलग रखा जा सकता है. अपने दोस्तों और परिवार या काम और मनोरंजन की चीज़ों को अलग-अलग रखने के लिए, प्रोफ़ाइलें बनाएं.</translation>
<translation id="7141327976224964788">अतिथि कुछ भी छोड़े बिना क्रोमियम का उपयोग कर सकते हैं.</translation>
<translation id="7007327521155149139">Phromium में आपका खाता</translation>
<translation id="5973804420920585431">स्वयं को क्रोमियम में जोड़ें</translation>
<translation id="504699503110800016">ओवरफ़्लो मेन्यू खोलें</translation>
<translation id="2497925691306722252">अपने <ph name="DEVICE_TYPE" /> पर Phromium का इस्तेमाल करके, Google की अपनी सभी पसंदीदा चीज़ें ऐक्सेस करें</translation>
<translation id="8678196879882043620">Phromium को आपके हाथों को ट्रैक करने की अनुमति चाहिए</translation>
<translation id="3397880081430454820">आपने हाल ही में इस वेबसाइट का इस्तेमाल नहीं किया है. Phromium ने <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, और <ph name="PERMISSION_3" /> की अनुमति हटा दी है.</translation>
<translation id="9114243566897924763">Phromium में साइन इन करें</translation>
<translation id="5174969993834422967">आपने ज़्यादातर मामलों में, सूचनाओंं को ब्लॉक किया है. इस साइट से सूचनाएं पाने के लिए, आपको अपने लोकेशन बार के दाएं कोने में मौजूद सूचना के आइकॉन पर क्लिक करना होगा.</translation>
<translation id="5174983315706567306">डिस्क में ज़रूरत के मुताबिक स्टोरेज नहीं बचा है.</translation>
<translation id="7698884672439844280">Phromium खाते की फिर से पुष्टि करनी होगी</translation>
<translation id="5629965056131882780">iOS पर Phromium का इस्तेमाल करें और वहीं से काम फिर शुरू करें जहां आपने छोड़ा था.</translation>
<translation id="874294566462998787">क्रोमियम से प्रस्थान करें</translation>
<translation id="5234764350956374838">खारिज करें</translation>
<translation id="8605581794204249702">Phromium की गुप्त विंडो में लिंक खोलें</translation>
<translation id="8722804301463582643">कभी भी, कहीं भी पासवर्ड सेव करने के लिए, Phromium ऐप्लिकेशन डाउनलोड करें</translation>
<translation id="6253936671561887082">अपने बदलाव लागू करने के लिए, क्रोमियम को फिर से लॉन्च करें</translation>
<translation id="7405713141437293142">इस टैब को किसी अन्य डिवाइस पर भेजने के लिए, दोनों डिवाइसों पर Phromium में साइन इन करें</translation>
<translation id="5286907366254680517">भाषा का पता चला</translation>
<translation id="2224284460884535818">Phromium ऐप्लिकेशन डाउनलोड करें</translation>
<translation id="1426207087952749578">गुप्त मोड में ब्राउज़ करते समय, असुरक्षित कनेक्शन का इस्तेमाल करके किसी साइट को लोड करने से पहले, Phromium आपको चेतावनी देगा</translation>
<translation id="8108751453879231987">Phromium की मदद से खोजें</translation>
<translation id="7780358745459835678">Phromium अपडेटर इंटरनल सर्विस</translation>
<translation id="6956753580765202069">Phromium में, Gemini की अन्य सुविधाओं के साथ इनका इस्तेमाल करें</translation>
<translation id="5346389065299425353">एक से ज़्यादा टैब, फ़ाइलें, और टूल जोड़कर अपनी खोज को बेहतर बनाएं</translation>
<translation id="8684266995248242891">Phromium में Gemini का इस्तेमाल करके, इस दस्तावेज़ की खास जानकारी तुरंत पाएं और सवाल पूछें</translation>
<translation id="586104673506947714">Phromium का सुझाव है कि आपको बेहतर सुरक्षा पाने के लिए कुछ कार्रवाई करनी चाहिए</translation>
<translation id="4657908558997566735">Phromium की अन्य प्रोफ़ाइलें</translation>
<translation id="6097378010983112326">ChromiumOS आपके Google खाते में Phromium का डेटा सेव नहीं कर सका, क्योंकि आपके खाते में साइन-इन करने से जुड़ी जानकारी पुरानी हो चुकी है</translation>
<translation id="385020720581757591">आप प्रबंधित खाते से साइन इन कर रहे हैं और उसके एडमिन को अपनी क्रोमियम प्रोफ़ाइल पर नियंत्रण दे रहे हैं. आपका क्रोमियम डेटा, जैसे आपके ऐप्लिकेशन, बुकमार्क, इतिहास, पासवर्ड, और दूसरे सेटिंग स्थायी रूप से <ph name="USER_NAME" /> से जुड़ जाएंगे. आप Google खाता डैशबोर्ड के ज़रिए इस डेटा को मिटा सकेंगे, लेकिन आप किसी अन्य खाते से इस डेटा को जोड़ नहीं सकेंगे. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">अतिरिक्त कोड: <ph name="EXTRA_CODE" />.</translation>
<translation id="3729704134418183937">मनमुताबिक अनुभव पाने के लिए, Phromium को 'वेब और ऐप्लिकेशन गतिविधि' सेटिंग में शामिल करें</translation>
<translation id="2756028035855809142">'Phromium की मदद से खोजें' सुविधा खोलें</translation>
<translation id="4375021373215585423">जानें कि Phromium कुछ फ़ाइलों को क्यों ब्लॉक करता है</translation>
<translation id="4688227912949761884">क्रोमियम अपडेट हो रहा है (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="1581580071694756035"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको अपने सभी डिवाइसों पर एक्सटेंशन वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="4945147853702701048">क्रोमियम में साइन-इन करने दें</translation>
<translation id="7813879193794658604">क्रोमियम से निकालें</translation>
<translation id="2908302339618007937">इससे परफ़ॉर्मेंस कम होती है, लेकिन Phromium की सायबर हमलों से बचने की क्षमता बढ़ जाती है</translation>
<translation id="8760365573983490520">क्रोमियम को अपने डिफ़ॉल्ट ब्राउज़र के रूप में सेट करें</translation>
<translation id="6395910175148753946"><ph name="PAGE_TITLE" /> - क्रोमियम बीटा</translation>
<translation id="3685567744344529931">{NUM_TABS,plural, =1{Phromium का सुझाव है कि आप उस टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहा है}one{Phromium का सुझाव है कि आप उस टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहा है}other{Phromium का सुझाव है कि आप उन टैब को रोक दें जो आपके ब्राउज़र की स्पीड को धीमा कर रहे हैं}}</translation>
<translation id="975923236500175446">हो सकता है कि Phromium सही तरीके से काम न करे, क्योंकि अब वह Linux के इस वर्शन पर काम नहीं करता है</translation>
<translation id="7595270580374414215">Phromium ने इस डाउनलोड को ब्लॉक किया है, क्योंकि यह फ़ाइल आपके निजी और सोशल नेटवर्क खातों को नुकसान पहुंचा सकती है</translation>
<translation id="5644162187312430027">कृपया क्रोमियम द्वारा नवीनतम सिस्टम अपडेट इंस्टॉल करने के दौरान इंतज़ार करें.</translation>
<translation id="2476033563817685908">क्रोमियम, पासवर्ड कॉपी करने की कोशिश कर रहा है. इसकी अनुमति देने के लिए Windows का पासवर्ड डालें.</translation>
<translation id="1626952238284562558">Phromium की मदद से, Google Drive और YouTube जैसे अपने पसंदीदा ऐप्लिकेशन का बेहद आसानी से कभी भी, कहीं भी इस्तेमाल करें.</translation>
<translation id="5524890928877629608">खोज वाली जगह में सबसे ऊपर का बायां कोना: बाईं ओर से <ph name="LEFT" />%, सबसे ऊपर से <ph name="TOP" />%</translation>
<translation id="2860766395826060492">Phromium में पीडीएफ़ खोलें</translation>
<translation id="5536164441519929134">इस टैब पर<ph name="LINE_BREAK" />मौजूद कॉन्टेंट के बारे में सवाल पूछें</translation>
<translation id="3915500272078806319">सुरक्षा को ध्यान में रखते हुए, जब कोई साइट पहली बार विज़िट की जाती है, तब Phromium, JavaScript ऑप्टिमाइज़ेशन की सुविधा बंद कर देता है.

अगर यह पेज ठीक से काम नहीं कर रहा है, तो ऑप्टिमाइज़ेशन की सुविधा चालू करके देखें.</translation>
<translation id="6778733300408894918">'Phromium में Gemini' को Mac के मेन्यू बार में दिखाएं और कीबोर्ड शॉर्टकट चालू करें</translation>
<translation id="8411908790152555435"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको <ph name="DEVICE" /> पर सेव की गई जानकारी वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="5579324208890605088">स्टार्टअप में गड़बड़ी हुई: कृपया इंस्टॉलर को एडमिन के तौर पर नहीं, बल्कि किसी उपयोगकर्ता के तौर पर चलाएं.</translation>
<translation id="6578510724610627339">Phromium को डिफ़ॉल्ट ब्राउज़र के तौर पर इस्तेमाल करें और इसे टास्कबार में पिन करें</translation>
<translation id="5596627076506792578">ज़्यादा विकल्प</translation>
<translation id="5605834417512968703">'इमेज सर्च' सुविधा की मदद से जानकारी खोजने के लिए, कोई भी एलिमेंट चुनें. 'इमेज सर्च' सुविधा को बंद करने के लिए Escape दबाएं</translation>
<translation id="5618818588972826921">'इमेज सर्च' सुविधा की मदद से जानकारी खोजने के लिए, कोई टेक्स्ट या इमेज चुनें. 'इमेज सर्च' सुविधा को बंद करने के लिए Escape दबाएं</translation>
<translation id="4431270188253419020">{0,plural, =0{क्रोमियम का एक अपडेट उपलब्ध है}=1{क्रोमियम का एक अपडेट उपलब्ध है}one{क्रोमियम का एक अपडेट # दिनों से उपलब्ध है}other{क्रोमियम का एक अपडेट # दिनों से उपलब्ध है}}</translation>
<translation id="6903143702905157196">Phromium बंद करने के बाद, अपने डिवाइस से साइट डेटा मिटाना कभी न भूलें</translation>
<translation id="5354366475527026551">कृपया 'क्रोमियम' को अभी रीस्टार्ट करें</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="7813917140072793410">क्रोमियम को इस भाषा में दिखाएं</translation>
<translation id="569897634095159764">इंटरनेट से कनेक्ट नहीं किया जा सका. प्रॉक्सी सर्वर की पुष्टि करना ज़रूरी है.</translation>
<translation id="5724138350057003647">इस सेटिंग के चालू होने पर, Phromium ऐसे टैब से मेमोरी खाली करता है जो इस्तेमाल नहीं किए जा रहे. इससे, इस्तेमाल किए जा रहे टैब और अन्य ऐप्लिकेशन को ज़्यादा कंप्यूटर रिसॉर्स मिलते हैं और Phromium तेज़ी से काम करता है. इस्तेमाल नहीं किए जा रहे टैब पर वापस जाने से, वे अपने-आप दोबारा ऐक्टिव हो जाते हैं. <ph name="BEGIN_LINK" />मेमोरी सेवर के बारे में ज़्यादा जानें<ph name="END_LINK" /></translation>
<translation id="3730992449058237228">अगर आपको अपना लंबा पासवर्ड याद नहीं है या आपको यह सेटिंग बदलनी है, तो अपने खाते से Phromium का डेटा <ph name="SETTINGS_LINK" /></translation>
<translation id="1983042639279920602">Phromium को कंट्रोल करें और अपनी पसंद के मुताबिक बनाएं. Phromium को अपने डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें.</translation>
<translation id="7136978005010973283">अपने पासवर्ड, बुकमार्क, और इतिहास को सभी डिवाइसों पर पूरी तरह सिंक रखने के लिए, Phromium को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें.</translation>
<translation id="5809516625706423866">इंटरनेट से कनेक्ट नहीं किया जा सका. एचटीटीपी 401 अनऑथराइज़्ड कोड दिख रहा है. कृपया अपने प्रॉक्सी कॉन्फ़िगरेशन की जांच करें.</translation>
<translation id="3059302031765226748">Phromium के V8 इंजन की मदद से, साइटों के काम करने की स्पीड तेज़ करें. हालांकि, इससे सुरक्षा से जुड़े खतरों की संभावना बढ़ जाती है. यह सेटिंग बंद है.</translation>
<translation id="4904710047654714935">अपने Google खाते में Phromium का डेटा इस्तेमाल करने और सेव करने के लिए, Phromium को अपडेट करें</translation>
<translation id="5824893331272123205">यह पैनल लोड नहीं हो सका. फिर से कोशिश करें</translation>
<translation id="2582896742857095190">क्रोमियम में आपका स्वागत है</translation>
<translation id="5004643502851105876">Phromium की बेहतरीन सुरक्षा उपलब्ध कराने के लिए, अतिरिक्त सुविधाएं चालू की जाती हैं</translation>
<translation id="5871205389137001634">'इमेज सर्च' सुविधा के पेज को बंद करने के लिए क्लिक करें</translation>
<translation id="7409018434452575206">Phromium को पता चला है कि इन आइटम में मैलवेयर है:</translation>
<translation id="3191822983646594827">Phromium, समय-समय पर जांच करके यह पक्का करता है कि आपके ब्राउज़र की सेटिंग सबसे सुरक्षित हैं. अगर किसी चीज़ की समीक्षा ज़रूरी होगी, तो हम आपको इसकी सूचना देंगे.</translation>
<translation id="5895138241574237353">फिर से प्रारंभ करें</translation>
<translation id="625373791981566594">Phromium में Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - नेटवर्क में साइन इन करें</translation>
<translation id="5924017743176219022">इंटरनेट से कनेक्ट हो रहा है…</translation>
<translation id="5941711191222866238">छोटा करें</translation>
<translation id="8650638130234822147">अपने सभी डिवाइसों पर यह बुकमार्क और अन्य चीज़ों का ऐक्सेस पाने के लिए, Phromium में साइन इन करें</translation>
<translation id="5010592102321399468">Phromium को अपनी पसंद के मुताबिक बनाएं</translation>
<translation id="5960071705175224773">आपकी सेटिंग में किसी अनजान ऐप्लिकेशन ने बदलाव किए हैं</translation>
<translation id="5977420883993828287">पिन किया गया! टूलबार से, कॉन्टेक्स्ट के हिसाब से सवाल पूछने की सुविधा का फिर से इस्तेमाल करें</translation>
<translation id="3936815319391045961">{COUNT,plural, =1{Phromium का 1 मिनट तक इस्तेमाल न करने पर, आपका संगठन इसे अपने-आप बंद कर देता है.}one{Phromium का # मिनट तक इस्तेमाल न करने पर, आपका संगठन इसे अपने-आप बंद कर देता है.}other{Phromium का # मिनट तक इस्तेमाल न करने पर, आपका संगठन इसे अपने-आप बंद कर देता है.}}</translation>
<translation id="3160371268592376569">सिंक शुरू करने के लिए क्रोमियम अपडेट करें</translation>
<translation id="5990360079535151574">ब्राउज़ करते समय सवाल पूछने के लिए, टूलबार पर मौजूद "कॉन्टेक्स्ट के हिसाब से टास्क" बटन पर क्लिक करके इस पैनल को फिर से खोला जा सकता है</translation>
<translation id="6003112304606738118">डाउनलोड हो रहा है... <ph name="HOURS" /> घंटे बचे हैं</translation>
<translation id="6009821354356307391">फ़ॉलो अप करें</translation>
<translation id="6040143037577758943">बंद करें</translation>
<translation id="5783572280281297164">अपने <ph name="DEVICE_TYPE" /> पर Phromium ऐप्लिकेशन का इस्तेमाल करें और ऑनलाइन खरीदारी करने का बेहतर अनुभव पाएं</translation>
<translation id="2712461133060419287">आपके डेटा की सुरक्षा के लिए, Phromium को उन साइटों को मिली हुई अनुमतियां हटाने दें जिन पर आपने हाल ही में विज़िट नहीं किया है. इससे सूचनाएं पाने की सुविधा बंद नहीं होती.</translation>
<translation id="7845842385196710435">&amp;क्रोमियम में खोलें</translation>
<translation id="6069027071882229820">इमेज के तौर पर कॉपी करें</translation>
<translation id="3752072756936611600"><ph name="EXTENSION_NAME" /> को क्रोमियम में जोड़ा गया</translation>
<translation id="2775066550187002528">क्रोमियम को पसंद के मुताबिक बनाएं और नियंत्रित करें. अपडेट उपलब्ध है.</translation>
<translation id="6531352038528110565">चालू है • Phromium इस एक्सटेंशन के सोर्स की पुष्टि नहीं कर सकता</translation>
<translation id="2876078296400914679">Phromium में आपका खाता</translation>
<translation id="3881538460441135554">Phromium टूलबार में ऐक्सेस के अनुरोध दिखाने के लिए, एक्सटेंशन को अनुमति दें</translation>
<translation id="7479187736743594081"><ph name="FILE_NAME" /> खतरनाक है, इसलिए क्रोमियम ने उसे अवरोधित कर दिया है.</translation>
<translation id="6646104775883837119">Phromium जल्द ही बंद हो जाएगा और डेटा को मिटा देगा</translation>
<translation id="6138634751748297112">आप यहां Phromium प्रोफ़ाइलों के बीच स्विच कर सकते हैं</translation>
<translation id="8660563290103481109">कुकी को अनुमति देने पर, Phromium उनका इस्तेमाल पेजों को पहले से लोड करते समय कर सकता है</translation>
<translation id="6165508094623778733">ज़्यादा जानें</translation>
<translation id="969667123257916656">अपने खाते में मौजूद Phromium का डेटा मिटाएं</translation>
<translation id="5528040738212560214">यह फ़ाइल खतरनाक हो सकती है<ph name="LINE_BREAK" />पासवर्ड देने पर, Phromium आपके लिए इस डाउनलोड की जांच कर सकता है. फ़ाइल की जानकारी, Google सुरक्षित ब्राउज़िंग को भेजी जाती है. हालांकि, फ़ाइल का कॉन्टेंट और पासवर्ड आपके डिवाइस पर ही रहता है.</translation>
<translation id="6182736845697986886">अपडेट सर्वर में कोई गड़बड़ी होने की वजह से इंस्टॉल नहीं हो सका.</translation>
<translation id="6041381825442292659">पक्का करें कि आपने <ph name="TARGET_DEVICE_NAME" /> पर क्रोमियम में साइन इन किया है. इसके बाद, फिर से भेजने की कोशिश करें.</translation>
<translation id="2474943719592372017">Phromium को छोटा करने के बाद भी, कहीं से भी जानकारी खोजें और सवाल पूछें. इससे Phromium को बैकग्राउंड में चलने की अनुमति मिलती है.</translation>
<translation id="2518372260387069450">इस कंप्‍यूटर में पहले से क्रोमियम का ज़्यादा नया वर्शन है. अगर सॉफ़्टवेयर काम नहीं कर रहा है, तो कृपया क्रोमियम अनइंस्‍टॉल करें और फिर से प्रयास करें.</translation>
<translation id="3832895416321159809">{0,plural, =0{क्रोमियम अभी फिर से लॉन्च होगा}=1{क्रोमियम 1 सेकंड में फिर से लॉन्च होगा}one{क्रोमियम # सेकंड में फिर से लॉन्च होगा}other{क्रोमियम # सेकंड में फिर से लॉन्च होगा}}</translation>
<translation id="2775110773501098464">फ़ाइलें डाउनलोड करने के लिए, Phromium को डिवाइस का स्टोरेज ऐक्सेस करने की अनुमति चाहिए</translation>
<translation id="3505491405575013121">Phromium में पहले से सेव की गई असुरक्षित साइटों की सूची का इस्तेमाल करके, यूआरएल की जांच की जाती है</translation>
<translation id="2276249127856880228">क्रोमियम को डिफ़ॉल्ट ब्राउज़र बनाएं</translation>
<translation id="6248988683584659830">सेटिंग में खोजें</translation>
<translation id="554637698797403739">अपने फ़ोन पर Phromium ऐप्लिकेशन डाउनलोड करके, Google की बेहतरीन सुरक्षा सुविधाएं पाएं</translation>
<translation id="7016155178198587734">क्रोमियम से प्रस्थान करें?</translation>
<translation id="5660287988409470276">ये टैब ज़्यादा संसाधनों का इस्तेमाल कर रहे हैं. परफ़ॉर्मेंस को बेहतर बनाने के लिए, Phromium को इन्हें बंद करने की अनुमति दें.</translation>
<translation id="8429776045186716992">अपनी Phromium प्रोफ़ाइल को पसंद के मुताबिक बनाएं</translation>
<translation id="3310436202618971091">अपने Phromium प्रोफ़ाइल को नाम दें</translation>
<translation id="1478750151648434251">एक्सटेंशन का इस्तेमाल करने के लिए, आपको Phromium में साइन इन करना होगा</translation>
<translation id="9139712828910812615"><ph name="FILE_NAME" /> खतरनाक हो सकता है, इसलिए क्रोमियम ने उसे अवरोधित कर दिया है.</translation>
<translation id="5191618263102115907">Phromium आपके कैमरे का उपयोग कर रहा है.</translation>
<translation id="8247508943089477519">क्रोमियम पर एक अन्य क्रिया चल रही है. कृपया बाद में फिर से कोशिश करें.</translation>
<translation id="8271488218611798813">अब अपने Google खाते के साथ और शेयर किए गए कंप्यूटर पर क्रोमियम का उपयोग करना आसान हो गया है.</translation>
<translation id="446228390478495078">Phromium को अपना डिफ़ॉल्ट ब्राउज़र सेट करके, अपनी पसंदीदा और भरोसेमंद सुविधाओं को आसानी से ऐक्सेस करें.</translation>
<translation id="2203435422524224690">Phromium का शॉर्टकट</translation>
<translation id="3977517784144885449">Phromium ने इस डाउनलोड को ब्लॉक कर दिया है, क्योंकि यह फ़ाइल आम तौर पर डाउनलोड नहीं की जाती और यह खतरनाक हो सकती है</translation>
<translation id="8088471547690853921">क्या आप वाकई क्रोमियम को अनइंस्टाल करना चाहते हैं?</translation>
<translation id="6375219077595103062">Password Manager का शॉर्टकट जोड़ें</translation>
<translation id="6388799252195623474">इसमें मेरी मदद करो</translation>
<translation id="1774421040071124552">जारी रखने के लिए, <ph name="EMAIL" /> से Phromium में साइन इन करें. इससे यह पक्का किया जाता है कि आपने अपने संगठन की नीतियों को पढ़ा है.</translation>
<translation id="2343430845154053061">कंप्यूटर की स्क्रीन में Phromium का लोगो.</translation>
<translation id="2724924185145648602">क्रोमियम वेब ब्राउज़र है जो बहुत तेज़ी से वेबपेज और ऐप्‍लिकेशन चलाता है. यह तेज़, स्‍थिर, और उपयोग में आसान है. क्रोमियम में अंतर्निहित मैलवेयर और फ़ीशिंग सुरक्षा के साथ ज़्यादा आसानी से वेब ब्राउज़ करें.</translation>
<translation id="7417453886359805803">यह पक्का करने के लिए कि आप अपने Google खाते में Phromium के डेटा को हमेशा इस्तेमाल और उसे सेव कर सकें, अपनी पहचान की पुष्टि करें</translation>
<translation id="3304683228794166031">यह सेटिंग चालू होने पर, Phromium तेज़ी से काम करता है और JavaScript का इस्तेमाल करने वाली सुविधाएं सही तरीके से काम करती हैं</translation>
<translation id="6436260184216827876">'इमेज सर्च' सुविधा उपलब्ध नहीं है. कुछ देर बाद कोशिश करें.</translation>
<translation id="6442900851116057561">ChromiumOS को रीस्टार्ट करें</translation>
<translation id="9164801375934097818">Phromium ऐसे कई और पेजों को पहले से लोड करके रखता है जिन पर आपके जाने की संभावना होती है, ताकि जब आप उन पेजों पर जाएं, तो वे ज़्यादा तेज़ी से खुल जाएं</translation>
<translation id="2577121659922309103">अपने फ़ोन पर Phromium डाउनलोड करें. इससे आपको प्रॉडक्ट की कीमतें ट्रैक करने और किसी भी साइट पर कीमत में गिरावट आने पर सूचनाएं पाने में मदद मिलेगी</translation>
<translation id="2052328618318278030">बंद है • Phromium इस एक्सटेंशन के सोर्स की पुष्टि नहीं कर सकता</translation>
<translation id="3122296739697671126">Phromium प्रोफ़ाइलों में आपका स्वागत है</translation>
<translation id="3472445024540245926">अगली बार अपने <ph name="DEVICE_TYPE" /> पर Phromium खोलने पर, आपको टैब ग्रुप इस्तेमाल करने का प्रॉम्प्ट दिखेगा.</translation>
<translation id="2144084801479939969">Phromium से खाता हटाएं</translation>
<translation id="2473490714352939152">इससे यह भी नियंत्रित होता है कि जब आप क्रोमियम प्रारंभ करते हैं तब कौन सा पृष्‍ठ दिखाया जाए.</translation>
<translation id="648319183876919572">बेहतर सुरक्षित ब्राउज़िंग की सुविधा, आपको नुकसान पहुंचाने वाली वेबसाइटों और डाउनलोड से बचाती है</translation>
<translation id="359777544552173333">क्रोमियम को अनइंस्टाल करें</translation>
<translation id="3890462049854841354">शॉर्टकट, Phromium में खुलते हैं</translation>
<translation id="6616579671682178785"><ph name="TIMEOUT_DURATION" /> तक Phromium का इस्तेमाल न करने पर, आपका संगठन इसे बंद कर देता है. ब्राउज़िंग डेटा मिटाया गया. इसमें ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं.</translation>
<translation id="8662645370371079862">हर प्रोफ़ाइल के पास उसके अपने Phromium की जानकारी होती है, जैसे कि बुकमार्क, इतिहास, पासवर्ड, और अन्य जानकारी</translation>
<translation id="6556755379298048869">कीबोर्ड शॉर्टकट का इस्तेमाल करके खोजें.</translation>
<translation id="7133640529688742768"><ph name="BEGIN_LINK" />Phromium आपके डेटा को निजी कैसे रखता है<ph name="END_LINK" />, इसके बारे में ज़्यादा जानें</translation>
<translation id="8316065704185291024">Phromium के रीस्टार्ट होने पर, इस सेटिंग में किए गए बदलाव लागू हो जाएंगे.</translation>
<translation id="2816396636285296289">Phromium के मुख्य मेन्यू में, 'एक्सटेंशन' पर क्लिक करके अपने एक्सटेंशन मैनेज करें.</translation>
<translation id="8831144879019828189">पासवर्ड देखने के लिए, Phromium की किसी दूसरी प्रोफ़ाइल पर स्विच करें</translation>
<translation id="7017911482442558099">Phromium ऐप्लिकेशन की मदद से कभी भी, कहीं भी बेहतरीन एआई टूल इस्तेमाल करें</translation>
<translation id="5784574554904759369">स्पेलिंग की गड़बड़ियां ठीक करने के लिए, क्रोमियम लेख फ़ील्ड में आपके लिखे गए लेख को Google को भेजती है</translation>
<translation id="8485501471305987872">क्रोमियम की सूचना सेटिंग पर जाएं</translation>
<translation id="6600016381025017075">इस पेज पर कोई भी जानकारी खोजें</translation>
<translation id="1462793186918694806">अगली बार जब आप क्रोमियम फिर से लॉन्‍च करेंगे तो आपके बदलाव लागू होंगे .</translation>
<translation id="7501991510212476553">Windows के चालू होते ही Phromium लॉन्च हो जाता है, ताकि आप तुरंत ब्राउज़िंग शुरू कर सकें. सेटिंग में जाकर इसे बंद किया जा सकता है.</translation>
<translation id="7686308613268368175">वहीं से काम जारी रखें जहां आपने छोड़ा था: Phromium ने आपके पिछले सेशन के खुले हुए टैब वापस ला दिए हैं. इस सेटिंग को यहां जाकर बंद किया जा सकता है</translation>
<translation id="5266723901802366313">आपके आस-पास की जगहों का 3D मैप बनाने के लिए, Phromium को कैमरा ऐक्सेस करने की अनुमति चाहिए</translation>
<translation id="7085315067428293799">अगर आपने बुकमार्क Google खाते में भी सेव किए हैं, तो आपको Phromium में प्रॉडक्ट की कीमतें ट्रैक करने का विकल्प मिलेगा. साथ ही, प्रॉडक्ट की कीमत में गिरावट आने पर आपको सूचना दी जाएगी</translation>
<translation id="6676384891291319759">इंटरनेट एक्सेस करें</translation>
<translation id="668175097507315160">साइन इन करने से जुड़ी गड़बड़ी की वजह से, ChromiumOS आपका डेटा सिंक नहीं कर सका.</translation>
<translation id="5279767706090517695">Phromium से इस ऐप्लिकेशन का डेटा हटाएं</translation>
<translation id="6562226321659107531">Phromium को इस साइट के लिए, माइक्रोफ़ोन ऐक्सेस करने की अनुमति चाहिए</translation>
<translation id="6712881677154121168">डाउनलोड करने में गड़बड़ी: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="259800793807512787">आपकी प्रोफ़ाइल का उपयोग नहीं किया जा सकता क्‍योंकि यह क्रोमियम के नए वर्शन से है.

हो सकता है कुछ सुविधाएं अनुपलब्ध हों. कृपया अलग प्रोफाइल निर्देशिका दर्ज करें या क्रोमियम के नए वर्शन का उपयोग करें.</translation>
<translation id="4914871493602315663">मनमुताबिक अनुभव और अन्य सुविधाएं पाने के लिए, Phromium को 'वेब और ऐप्लिकेशन गतिविधि' सेटिंग और लिंक की गई Google की सेवाओं में शामिल करें</translation>
<translation id="5919390816124912606">आपके कंप्यूटर पर मौजूद सभी उपयोगकर्ताओं के लिए क्रोमियम पहले से इंस्टॉल है.</translation>
<translation id="5867815953973052697">अपने सभी डिवाइसों पर बुकमार्क वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें. साइन इन करने के बाद, यह बुकमार्क आपके Google खाते में सेव हो जाएगा.</translation>
<translation id="7381168634819530324">Phromium के V8 इंजन की मदद से, साइटों के काम करने की स्पीड तेज़ करें. हालांकि, इससे सुरक्षा से जुड़े खतरों की संभावना बढ़ जाती है. यह सेटिंग चालू है.</translation>
<translation id="1509688792864707851">{count,plural, =1{आपके Phromium का कुछ डेटा, अब तक आपके Google खाते में सेव नहीं किया गया. साइन आउट करने से पहले, कुछ मिनट इंतज़ार करें. अभी साइन आउट करने पर यह डेटा (1 आइटम) मिट जाएगा.}one{आपके Phromium का कुछ डेटा, अब तक आपके Google खाते में सेव नहीं किया गया. साइन आउट करने से पहले, कुछ मिनट इंतज़ार करें. अभी साइन आउट करने पर यह डेटा ({count} आइटम) मिट जाएगा.}other{आपके Phromium का कुछ डेटा, अब तक आपके Google खाते में सेव नहीं किया गया. साइन आउट करने से पहले, कुछ मिनट इंतज़ार करें. अभी साइन आउट करने पर यह डेटा ({count} आइटम) मिट जाएगा.}}</translation>
<translation id="4702638565169602649">Phromium इस फ़ाइल को स्कैन करने का सुझाव देता है, क्योंकि यह खतरनाक हो सकती है.</translation>
<translation id="6779406956731413166">ChromiumOS को अतिरिक्त <ph name="BEGIN_LINK_CROS_OSS" />ओपन सोर्स सॉफ़्टवेयर<ph name="END_LINK_CROS_OSS" /> की मदद से बनाया गया है.</translation>
<translation id="6831043979455480757">अनुवाद करें</translation>
<translation id="1564864902402454287">'क्रोमियम' यह बताता है कि कहीं आपके पासवर्ड का गलत इस्तेमाल तो नहीं किया गया है</translation>
<translation id="684888714667046800">इंटरनेट से कनेक्ट नहीं किया जा सका. अगर आपने फ़ायरवॉल का इस्तेमाल किया है, तो कृपया पक्का करें कि <ph name="PRODUCT_EXE_NAME" /> को अनुमति वाली सूची में शामिल किया गया हो.</translation>
<translation id="6200419390448865091">क्रोमियम - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">जारी रखने के लिए Tab दबाएं</translation>
<translation id="6862030660799253820">इमेज सर्च की मदद से इस इमेज को खोजें</translation>
<translation id="6869568587896659271">पता बार के नीचे मौजूद वेबसाइटों को आसानी से ऐक्सेस करें</translation>
<translation id="4011399428346318467">Phromium को पता चला है कि "<ph name="EXTENSION_NAME" />" में मैलवेयर है</translation>
<translation id="6877155553248388166">खोज वाली जगह में सबसे नीचे का दायां कोना: दाईं ओर से <ph name="RIGHT" />%, सबसे नीचे से <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">कॉपी बनाएं</translation>
<translation id="6898028264630240901">ब्राउज़ करते समय सवाल पूछने के लिए, कॉन्टेक्स्ट के हिसाब से टास्क पिन किए जा सकते हैं</translation>
<translation id="1012681980425424211">Phromium को अपने डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें और इसे अपने टास्कबार पर पिन करें</translation>
<translation id="1744625657438211994">Phromium की प्रोफ़ाइलें मैनेज करें</translation>
<translation id="7264818828956697552">इस कार्रवाई से:
          <ph name="LINE_BREAKS" />
            • आपका शुरुआती पेज, 'नया टैब' पेज, सर्च इंजन, और पिन किए गए टैब रीसेट हो जाएंगे
            <ph name="LINE_BREAK" />
            • एक्सटेंशन बंद हो जाएंगे
            <ph name="LINE_BREAK" />
            • कुकी और कुछ समय के लिए सेव किया गया अन्य साइट डेटा मिट जाएगा
            <ph name="LINE_BREAK" />
            • Phromium के शॉर्टकट रीसेट हो जाएंगे
            <ph name="LINE_BREAKS" />
            बुकमार्क, इतिहास, और सेव किए गए पासवर्ड पर कोई असर नहीं पड़ेगा.</translation>
<translation id="6489000842445481390">आपने Phromium में <ph name="BOOKMARK_LIMIT" /> बुकमार्क सेव करने की सीमा पूरी कर ली है. इसलिए, आपके कुछ बुकमार्क अब तक आपके Google खाते में सेव नहीं किए गए हैं.

जब तक कुछ बुकमार्क नहीं मिटाए जाते, तब तक आपके खाते में नए बुकमार्क सेव नहीं किए जा सकते. अभी साइन आउट करने पर, सेव नहीं किए गए बुकमार्क मिट जाएंगे.</translation>
<translation id="2645108248038996858">क्रोमियम गु&amp;प्त विंडो में लिंक खोलें</translation>
<translation id="6965382102122355670">ठीक है</translation>
<translation id="6985329841647292029">ChromiumOS की शर्तें</translation>
<translation id="2947519843530032104">अपने खाते <ph name="ACCOUNT_EMAIL" /> में Phromium का डेटा सेव करने और इस्तेमाल करने के लिए, अपना लंबा पासवर्ड डालें</translation>
<translation id="7011190694940573312">ऑपरेटिंग सिस्टम का यह वर्शन काम नहीं करता, इसलिए ऐप्लिकेशन इंस्टॉल नहीं किया जा सका.</translation>
<translation id="7024536598735240744">डेवलपर मोड एक्सटेंशन में गड़बड़ी: <ph name="UNPACK_ERROR" />.</translation>
<translation id="2267652056049724321">Phromium को पसंद के मुताबिक बनाएं</translation>
<translation id="7047386856539490735">क्या ये नतीजे काम के हैं?</translation>
<translation id="2448910402556368916">क्रोमियम अपडेट करें</translation>
<translation id="7834049737623892628">अगर किसी इमेज के बारे में मददगार जानकारी मौजूद नहीं है, तो 'क्रोमियम' उसके बारे में जानकारी देने की कोशिश करेगा. जानकारी तैयार करने के लिए, इमेज Google को भेजी जाती हैं.</translation>
<translation id="1803168627715642217">अपने <ph name="DEVICE_TYPE" /> पर Phromium ऐप्लिकेशन का इस्तेमाल करें और एआई की सुविधाओं का फ़ायदा पाएं</translation>
<translation id="3321731353906178474">अपने फ़ोन पर Phromium ऐप्लिकेशन डाउनलोड करके, पासवर्ड, टैब वगैरह कहीं भी, कभी भी ऐक्सेस करें</translation>
<translation id="7141270731789036260">Chrome for Testing को पसंद के मुताबिक बनाएं</translation>
<translation id="8077731669779275332">मैसेज, दस्तावेज़ों, और अन्य ऐप्लिकेशन में मौजूद लिंक पर क्लिक करके कभी भी Phromium इस्तेमाल करें</translation>
<translation id="611798798247797100">Phromium से <ph name="EXTENSION_NAME" /> हटाएं</translation>
<translation id="7962394294883785044"><ph name="TIMEOUT_DURATION" /> तक Phromium का इस्तेमाल न करने पर, आपका संगठन इसका डेटा मिटा देता है. इसमें ब्राउज़िंग का इतिहास, ऑटोमैटिक भरी जाने वाली जानकारी, और डाउनलोड की गई फ़ाइलें शामिल हो सकती हैं.</translation>
<translation id="2611686760870033712">Phromium को इस साइट के लिए, कैमरा ऐक्सेस करने की अनुमति चाहिए</translation>
<translation id="71050417052775020">Phromium लॉन्च नहीं किया जा सका. फिर से कोशिश करें.</translation>
<translation id="4817060241763895497">Phromium में Gemini से कहीं भी, कभी भी अपने सवाल पूछें</translation>
<translation id="869358700049263961">Phromium को अपने डॉक में रखें, ताकि आप इसे कभी भी जल्द से जल्द ऐक्सेस कर सकें</translation>
<translation id="7094488679340739251">मैसेज, दस्तावेज़ों, और अन्य ऐप्लिकेशन में मिले लिंक पर टैप करके, कभी भी Phromium का इस्तेमाल करें</translation>
<translation id="7216228761061470870">डेस्कटॉप पर इमेज सर्च का इस्तेमाल करने पर, सर्वर पर पेज का टाइटल, यूआरएल, और कॉन्टेंट भेजा जाता है. इसमें PDF भी शामिल हैं</translation>
<translation id="7802634650401946711">काम का मैनेजर - क्रोमियम</translation>
<translation id="5182547787327636348">Phromium से बाहर मौजूद, किसी कॉन्टेंट के बारे में पूछें. जैसे, अन्य ऐप्लिकेशन या फ़ाइलें</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको अपने सभी डिवाइसों पर सेव की गई जानकारी वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="5761733252154904648">तुरंत ब्राउज़ करना शुरू करें: अब Windows के चालू होते ही Phromium को लॉन्च किया जा सकता है.</translation>
<translation id="7274695763216404502">पिन किया गया! टूलबार से, 'इमेज सर्च' सुविधा का फिर से इस्तेमाल करें</translation>
<translation id="7288567540154601580">टैब और एक्सटेंशन</translation>
<translation id="5616812573273137616">{NUM_EXTENSIONS,plural, =1{Phromium का सुझाव है कि आप इसे हटा दें}one{Phromium का सुझाव है कि आप इसे हटा दें}other{Phromium का सुझाव है कि आप इन्हें हटा दें}}</translation>
<translation id="1408728332407453335">Phromium में सिस्टम ऑडियो शेयर करने के लिए, सिस्टम सेटिंग खोलें और 'सिर्फ़ सिस्टम ऑडियो रिकॉर्ड करने की अनुमति' को चालू करें. इसके बाद, आपको Phromium रीस्टार्ट करना होगा.</translation>
<translation id="7299899569525778554">डेस्कटॉप से खोजें</translation>
<translation id="6194310460545162015">क्रोमियम अपडेट हो रहा है</translation>
<translation id="1098154893096691883">आपकी पसंदीदा फ़ाइल खराब या अमान्‍य है.

क्रोमियम आपकी सेटिंग बहाल नहीं कर सकता.</translation>
<translation id="7324051657739063017">ब्राउज़ करते समय सवाल पूछने के लिए, 'कॉन्टेक्स्ट के हिसाब से टास्क' पैनल को फिर से खोला जा सकता है</translation>
<translation id="7024097830259741656">आपके वेब, बुकमार्क, और अन्य क्रोमियम सामग्री यहां मौजूद रहती है.</translation>
<translation id="852511575759652041">एन्क्रिप्ट (सुरक्षित) किए गए आपके डेटा को सिर्फ़ वह व्यक्ति देख सकता है जिसके पास आपका लंबा पासवर्ड मौजूद है. Google को लंबा पासवर्ड नहीं भेजा जाता और न ही वह इसे सेव करता है. अगर आपको अपना लंबा पासवर्ड याद नहीं है या आपको यह सेटिंग बदलनी है, तो आपको <ph name="BEGIN_LINK" />अपने खाते में मौजूद Phromium का डेटा मिटाना होगा<ph name="END_LINK" />.</translation>
<translation id="2846900085504364505">आपके सिस्टम एडमिन ने <ph name="ALTERNATIVE_BROWSER_NAME" /> खाेलने के लिए, क्रोमियम को कॉन्फ़िगर किया है ताकि <ph name="TARGET_URL_HOSTNAME" /> काे ऐक्सेस किया जा सके.</translation>
<translation id="7352651011704765696">कुछ गलत हुआ</translation>
<translation id="7198690862684855451">Phromium के अपडेट पाने के लिए, आपके कंप्यूटर में macOS 13 या इसके बाद का वर्शन इंस्टॉल होना चाहिए. फ़िलहाल, इस कंप्यूटर में macOS 12 का इस्तेमाल हो रहा है.</translation>
<translation id="3224607549103501149">आपने हाल ही में इस वेबसाइट का इस्तेमाल नहीं किया है. Phromium ने <ph name="PERMISSION_1" /> और <ph name="PERMISSION_2" /> की अनुमति हटा दी है.</translation>
<translation id="73786666777299047">Chrome Web Store खोलें</translation>
<translation id="8446269872172461565">Gemini को Phromium की सिस्टम ट्रे में दिखाएं</translation>
<translation id="7401687852903179959">इमेज सर्च की मदद से इस वीडियो को खोजें</translation>
<translation id="3403529853122418035">Phromium अब आपका डिफ़ॉल्ट ब्राउज़र है</translation>
<translation id="5649377421626481711">वहीं से काम जारी रखें जहां आपने छोड़ा था: हर बार रीस्टार्ट करने पर Phromium आपके टैब वापस ला सकता है. इसे बंद करने के लिए, यहां जाएं</translation>
<translation id="2467776530444676191">Phromium में पासवर्ड इंपोर्ट करें</translation>
<translation id="8814480293815136510">1. नीचे <ph name="BUTTON_LABEL" /> पर क्लिक करें
2. Windows की सेटिंग में जाकर, <ph name="BUTTON_2" /> पर क्लिक करें
3. Phromium को अपने टास्कबार पर पिन करने के लिए, Windows की सूचना में <ph name="BUTTON_3" /> पर क्लिक करें, ताकि आप इसे तुरंत ऐक्सेस कर सकें</translation>
<translation id="4458219452141227397"><ph name="PAGE_TITLE" /> - क्रोमियम डेवपलर</translation>
<translation id="7450541714075000668">टेक्स्ट कॉपी किया गया</translation>
<translation id="6826407056979820031">माइक्रोफ़ोन इस्तेमाल करने के लिए, <ph name="BEGIN_LINK" />सिस्टम सेटिंग<ph name="END_LINK" /> में जाकर Phromium को इसे ऐक्सेस करने की अनुमति दें</translation>
<translation id="1392131731909663319">आगे भी Phromium के अपडेट पाते रहने के लिए, आपके कंप्यूटर में Windows 10 या उसके बाद वाला वर्शन होना चाहिए. इस कंप्यूटर में Windows 7 का इस्तेमाल किया जा रहा है.</translation>
<translation id="4512427777724578739">Phromium को फिर से लॉन्च करें?</translation>
<translation id="4510527847350985067">वर्तमान में चल रहे समान क्रोमियम वर्शन को इंस्‍टॉल नहीं कर सकते. कृपया क्रोमियम बंद करें और फिर से प्रयास करें.</translation>
<translation id="7510190804000607802">रिमाइंडर: Google की बेहतरीन सुविधाएं अब आपके फ़ोन में</translation>
<translation id="4735608937705010375">ऐसा हो सकता है कि साइटें उम्मीद के मुताबिक काम करें. Phromium की सभी विंडो बंद करने पर, आपको ज़्यादातर साइटों से साइन आउट कर दिया जाएगा. हालांकि, अगर आपने Phromium में साइन इन किया हुआ है, तो आपको Google खाते से साइन आउट नहीं किया जाएगा.</translation>
<translation id="7987051132742764178">{0,plural, =1{क्रोमियम 1 मिनट में फिर से लॉन्च होगा}one{क्रोमियम # मिनट में फिर से लॉन्च होगा}other{क्रोमियम # मिनट में फिर से लॉन्च होगा}}</translation>
<translation id="1904271152425995672">अपने डेटा को सुरक्षित रखने के लिए, Phromium को उन साइटों को दी गई अनुमतियां हटाने दें जिन्हें आपने हाल ही में इस्तेमाल नहीं किया है.</translation>
<translation id="7909976731673595773">तुरंत ब्राउज़िंग शुरू करने के लिए, Phromium के अपने-आप लॉन्च होने की सुविधा चालू करें.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> इंस्टॉलर</translation>
<translation id="3301232962183130807">Phromium आपके कैमरे और माइक्रोफ़ोन का उपयोग कर रहा है.</translation>
<translation id="3230129417775002227">क्रोमियम पहले से बेहतर हो गया है</translation>
<translation id="1322165820810533683">अब आपके लिए Phromium में ज़्यादा सुविधाएं उपलब्ध हैं</translation>
<translation id="7624307931717240213">हम जानकारी का इस्तेमाल, इस सेवा को बेहतर बनाने के लिए करते हैं. निजता नीति और सेवा की शर्तें देखें.</translation>
<translation id="7649070708921625228">सहायता</translation>
<translation id="3795437289339745990">Phromium ऐप्लिकेशन को डाउनलोड करें</translation>
<translation id="7658239707568436148">अभी नहीं</translation>
<translation id="6671257169702988694">क्रोमियम आपका डिफ़ॉल्ट ब्राउज़र नहीं है</translation>
<translation id="7270402397025248165">क्रोमियम को अपने सभी डिवाइस पर सिंक करें और मनमुताबिक बनाएं</translation>
<translation id="6267574654655324634">Phromium का अपडेट</translation>
<translation id="4868190765388740513">Phromium पर आपका काम सुरक्षित रहता है</translation>
<translation id="7716950018788545737">टास्क खत्म कर दिए गए हैं.</translation>
<translation id="77283119132245232">इससे <ph name="BROWSER_NAME" /> के लिए सिस्टम ट्रेस करने की सेवाएं उपलब्ध कराई जाती हैं. अगर यह सेवा बंद है, तो ब्राउज़र से बने परफ़ॉर्मेंस ट्रेस में, पूरे सिस्टम इवेंट शामिल नहीं होंगे. जैसे, कॉन्टेक्स्ट स्विच और रेडी थ्रेड इवेंट.</translation>
<translation id="2680098142787722612">ऐसा करने से इस डिवाइस से आपका ब्राउज़िंग डेटा मिट जाएगा. बाद में अपना डेटा पाने के लिए, Phromium में <ph name="USER_EMAIL" /> के रूप में साइन इन करें.</translation>
<translation id="7747138024166251722">इंस्टॉलर अस्थायी डायरेक्टरी नहीं बना सका. कृपया डिस्क में खाली जगह और सॉफ़्टवेयर इंस्टॉल करने की अनुमति जांचें.</translation>
<translation id="6830826880333833598">Phromium को डिफ़ॉल्ट सेटिंग पर रीसेट करें</translation>
<translation id="448710321315554838">Phromium पर आपके काम को सुरक्षित रखने के लिए, Phromium में आपके साइन इन करने पर आपका संगठन कुछ खास जानकारी देख पाएगा या उसे मैनेज कर सकेगा.</translation>
<translation id="7045209483723342691">Phromium को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें और इसे टास्कबार पर पिन करें</translation>
<translation id="6452735947982563207">Phromium को ज़्यादा तेज़ बनाएं</translation>
<translation id="2826377606185230093"><ph name="PAGE_TITLE" /> - क्रोमियम कैनरी</translation>
<translation id="6929858452581400763">आपके इंटरनेट ट्रैफ़िक का ऐक्सेस रखने वाले लोगों के लिए, यह देखना मुश्किल बनाएं कि आपने किन साइटों पर विज़िट किया है. Phromium, डीएनएस (डोमेन नेम सिस्टम) में किसी साइट का आईपी पता खोजने के लिए, सुरक्षित कनेक्शन का इस्तेमाल करता है.</translation>
<translation id="7810005234485217901">आसानी से ऐक्सेस करने के लिए, 'इमेज सर्च' सुविधा को पिन किया जा सकता है</translation>
<translation id="4343392731007327660">चुनें कि Phromium के साथ क्या शेयर किया जाए</translation>
<translation id="3052274192923256457">इस खाते से बनाई गई एक Phromium प्रोफ़ाइल इस डिवाइस पर पहले से मौजूद है</translation>
<translation id="7845233973568007926">इंस्टॉल करने के लिए धन्यवाद. <ph name="BUNDLE_NAME" /> का इस्तेमाल करने से पहले, कंप्यूटर को रीस्टार्ट करना ज़रूरी है.</translation>
<translation id="5674414381037997114">आपके सर्च इंजन को Phromium के बाहर से बदला गया था. आपकी सुरक्षा के लिए, Phromium ने इसे वापस डिफ़ॉल्ट पर सेट कर दिया है. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="2382629958428086738">Phromium को अपनी पसंद के मुताबिक बनाकर इसे नया लुक दें</translation>
<translation id="3966946337517395351">पता बार या खोज बॉक्स में आपके टाइप किए गए टेक्स्ट को Phromium आपके डिफ़ॉल्ट सर्च इंजन को भेजता है, ताकि बेहतर सुझाव पाए जा सकें. यह सुविधा गुप्त मोड में काम नहीं करती.</translation>
<translation id="3928367799779122681">क्रोमियम सबसे नए वर्शन में अपडेट नहीं कर सका, इसलिए आपको नई सुविधाएं और सुरक्षा सुधार नहीं मिल रहे हैं.</translation>
<translation id="7872446069773932638">डाउनलोड हो रहा है... <ph name="SECONDS" /> सेकंड बचे हैं</translation>
<translation id="8492102592995742850">अगर आपको अपना लंबा पासवर्ड याद नहीं है या आपको यह सेटिंग बदलनी है, तो <ph name="BEGIN_LINK" />अपने खाते में मौजूद Phromium का डेटा मिटाएं<ph name="END_LINK" /></translation>
<translation id="959404544431817539">जब भी ज़रूरत हो, 'Phromium में Gemini' को तुरंत खोलें</translation>
<translation id="8889749279816358185">Phromium को अपने डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें</translation>
<translation id="3173775358556080672">जब भी मुमकिन होता है, तब Phromium, असुरक्षित कनेक्शन को एचटीटीपीएस पर अपने-आप अपग्रेड कर देता है</translation>
<translation id="2210801904933897209">आपने क्रोमियम में <ph name="USER_EMAIL_ADDRESS" /> के रूप में साइन इन किया था. फिर से साइन इन करने के लिए कृपया उसी खाते का इस्तेमाल करें.</translation>
<translation id="7291855477503010638"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको अपने सभी डिवाइसों पर बुकमार्क वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="5706099517903615644">यह क्रोमियम का द्वितीयक इंस्टॉलेशन है और इसे आपका डिफ़ॉल्ट ब्राउज़र नहीं बनाया जा सकता.</translation>
<translation id="2388440031754359882">नामालूम स्रोत से डाउनलोड किए गए एक्सटेंशन, ऐप्लिकेशन, और थीम से आपके डिवाइस को नुकसान पहुंच सकता है. हमारा सुझाव है कि आप इन्हें सिर्फ़ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> से इंस्टॉल करें</translation>
<translation id="8205108509545565485">अपने <ph name="DEVICE_TYPE" /> पर Phromium ऐप्लिकेशन का इस्तेमाल करें और Google की बेहतरीन सुविधाओं का फ़ायदा पाएं</translation>
<translation id="8004582292198964060">ब्राउज़र</translation>
<translation id="8010081455002666927">भाषा को अपने-आप पहचानने की सुविधा</translation>
<translation id="6421861275173778152">क्रोमियम को ऐक्सेस मिलने के बाद, वेबसाइटें आपसे ऐक्सेस मांग सकेंगी.</translation>
<translation id="942087293138739513">Phromium को अपने टास्कबार पर पिन करें, ताकि आप इसे कभी भी तेज़ी से ऐक्सेस कर सकें</translation>
<translation id="80471789339884597">इंस्टॉल करने के लिए धन्यवाद. <ph name="BUNDLE_NAME" /> का इस्तेमाल करने से पहले, आपको सभी ब्राउज़र रीस्टार्ट करने होंगे.</translation>
<translation id="8054112667659782652">हमेशा 'इमेज सर्च' सुविधा का शॉर्टकट दिखाएं</translation>
<translation id="8069447462453318634">"टूलबार में पिन करें" को चुनें</translation>
<translation id="8519423983825025511">ऐप्लिकेशन चलने के दौरान, Phromium को बैकग्राउंड में चलने से रोकें</translation>
<translation id="80790299200510644">इमेज सर्च</translation>
<translation id="8086881907087796310">ऐप्लिकेशन इंस्टॉल नहीं किया जा सका, क्योंकि आपका कंप्यूटर हार्डवेयर की ज़रूरी शर्तों को पूरा नहीं करता.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="7988414336652558428">Phromium को इस साइट के लिए, जगह की जानकारी ऐक्सेस करने की अनुमति चाहिए</translation>
<translation id="1778610353097215460">अगली बार अपने <ph name="DEVICE_TYPE" /> पर Phromium खोलने पर, आपको प्रॉडक्ट की कीमत में होने वाले बदलावों की सूचनाएं पाने की सुविधा चालू करने का प्रॉम्प्ट दिखेगा.</translation>
<translation id="4182143801062869250">अपने फ़ोन पर Phromium ऐप्लिकेशन की मदद से, उन प्रॉडक्ट की कीमत में गिरावट आने पर सूचनाएं पाएं जिनमें आपकी दिलचस्पी है</translation>
<translation id="8118331347066725040">'Lens की मदद से खोजें' सुविधा के लिए, सुझाव/राय भेजें या शिकायत करें</translation>
<translation id="849080025203861031">Phromium को मनमुताबिक बनाएं</translation>
<translation id="8133124826068723441">ChromiumOS आपका डेटा सिंक नहीं कर सका, क्योंकि आपके डोमेन के लिए सिंक करने की सुविधा उपलब्ध नहीं है.</translation>
<translation id="813913629614996137">शुरू हो रहा है...</translation>
<translation id="139377652856781272">कीबोर्ड शॉर्टकट की मदद से 'Phromium में Gemini' खोलें.</translation>
<translation id="8577594891153686998">Phromium की सेवा की अतिरिक्त शर्तें</translation>
<translation id="6418547610462348357">यह फ़ाइल खतरनाक है, इसलिए क्रोमियम ने इसे रोक दिया है.</translation>
<translation id="8177472873527554730">पेज पर कॉन्टेंट नहीं मिला</translation>
<translation id="6257816439683677727">अपने खाते <ph name="USER_EMAIL" /> में Phromium का डेटा सेव करने और इस्तेमाल करने के लिए, अपना लंबा पासवर्ड डालें</translation>
<translation id="820759916613250543">इमेज सर्च की मदद से इस इमेज को खोजें</translation>
<translation id="8221491193165283816">आम तौर पर, आप सूचनाओंं पर रोक लगाते हैं. यह साइट आपको सूचना दिखा सके, इसके लिए यहां क्लिक करें.</translation>
<translation id="8672013454464753607">कैमरा इस्तेमाल करने के लिए, <ph name="BEGIN_LINK" />सिस्टम सेटिंग<ph name="END_LINK" /> में जाकर Phromium को इसे ऐक्सेस करने की अनुमति दें</translation>
<translation id="8006746139865532235">Phromium, इस एक्सटेंशन के सोर्स की पुष्टि नहीं कर सका. यह खतरनाक भी हो सकता है. इसे Phromium से हटाएं, ताकि यह उन साइटों का डेटा न देख सके और न उसमें कोई बदलाव कर सके जिन पर विज़िट किया जाता है. इस डेटा में निजी जानकारी भी शामिल है.</translation>
<translation id="5474258904581730105">अगर किसी इमेज के बारे में मददगार जानकारी मौजूद नहीं है, तो 'क्रोमियम' उसके बारे में जानकारी देने की कोशिश करेगा. जानकारी तैयार करने के लिए, इमेज Google को भेजी जाती हैं. आप किसी भी समय सेटिंग में जाकर इसे बंद कर सकते हैं.</translation>
<translation id="5375524124600974413">क्या Phromium में नई प्रोफ़ाइल बनाकर साइन इन करना है?</translation>
<translation id="5242991719841602450"><ph name="EXISTING_USER" /> ने पहले से साइन इन किया हुआ है. अपने ब्राउज़िंग डेटा को अलग से मैनेज करने के लिए, Phromium में अपनी प्रोफ़ाइल में <ph name="USER_EMAIL_ADDRESS" /> से साइन इन करें. इससे आपको <ph name="DEVICE" /> पर पासवर्ड वगैरह का ऐक्सेस भी मिलेगा.</translation>
<translation id="6524280192518819368">'Phromium में Gemini' को सिस्टम ट्रे में दिखाएं और कीबोर्ड शॉर्टकट चालू करें</translation>
<translation id="2082268001133511745">असुरक्षित साइटों और डाउनलोड की गई फ़ाइलों के बारे में, <ph name="BEGIN_LINK" />Phromium आपको चेतावनी देता है<ph name="END_LINK" /></translation>
<translation id="4030955203048827163">आपने हाल ही में इस वेबसाइट का इस्तेमाल नहीं किया है. Phromium ने <ph name="PERMISSION" /> की अनुमति हटा दी है.</translation>
<translation id="8358344509940735943">iOS पर Phromium में, कैमरे से दिख रही चीज़ों को पहचानें, खरीदें, और अपने सामने दिख रहे कॉन्टेंट का अनुवाद भी पाएं</translation>
<translation id="7062802333437169650">Phromium में <ph name="USER_NAME" /> के तौर पर साइन इन करने के लिए क्यूआर कोड</translation>
<translation id="8313851650939857356">स्टार्टअप में गड़बड़ी हुई: <ph name="STARTUP_ERROR" />.</translation>
<translation id="751774429778958062"><ph name="TIMEOUT_DURATION" /> तक Phromium का इस्तेमाल न करने पर, आपका संगठन इसे बंद कर देता है.</translation>
<translation id="8321888067342493336">इमेज के तौर पर सेव करें</translation>
<translation id="6013358021678212671"><ph name="USER_EMAIL_ADDRESS" /> पहले क्रोमियम का उपयोग कर रहा था</translation>
<translation id="5445795756751365814">Phromium में स्किल को चालू करें</translation>
<translation id="7329745364783464770">Phromium को अपडेट करें, ताकि आप अपने खाते <ph name="ACCOUNT_EMAIL" /> में Phromium के डेटा का इस्तेमाल जारी रख पाएं</translation>
<translation id="5255856786869089460">आगे भी Phromium के अपडेट पाते रहने के लिए, आपके कंप्यूटर में Windows 10 या उसके बाद वाला वर्शन होना चाहिए. इस कंप्यूटर में Windows 8 का इस्तेमाल किया जा रहा है.</translation>
<translation id="8362914115861174987">इस भाषा में अनुवाद पाएं</translation>
<translation id="8367705492654390392">किसी भी विषय के बारे में पूछें</translation>
<translation id="8370517070665726704">कॉपीराइट <ph name="YEAR" /> Google LLC. सर्वाधिकार सुरक्षित.</translation>
<translation id="7349410893766975486">अपने सभी डिवाइसों से पासवर्ड वगैरह ऐक्सेस करने के लिए, Phromium में साइन इन करें. इसके बाद, यह पासवर्ड आपके Google खाते में सेव हो जाएगा.</translation>
<translation id="394196307309768356">इसके बाद, आपको Phromium को रीस्टार्ट करना होगा.</translation>
<translation id="7466825726005300631">Phromium का सुझाव है कि आप यह एक्सटेंशन हटा दें. <ph name="BEGIN_LINK" />Phromium पर इस्तेमाल किए जा सकने वाले एक्सटेंशन के बारे में ज़्यादा जानें<ph name="END_LINK" /></translation>
<translation id="264088846642173954">इस एक्सटेंशन को इसके डेवलपर ने अनपब्लिश कर दिया था और यह खतरनाक हो सकता है. इसे Phromium से हटाएं, ताकि यह उन साइटों का डेटा न देख सके और न उसमें बदलाव कर सके जिन पर विज़िट किया जाता है. इस डेटा में आपकी निजी जानकारी भी शामिल है.</translation>
<translation id="1867604241588004166">आपके Google खाते में डेटा सेव करने और सभी डिवाइसों पर उसका इस्तेमाल करने से पहले, Phromium को आपकी पहचान की पुष्टि करनी होगी. अभी साइन आउट करने पर यह डेटा मिट जाएगा.</translation>
<translation id="926481158288852551">{0,plural, =1{एक दिन के अंदर क्रोमियम को फिर से लॉन्च करें}one{# दिनों के अंदर क्रोमियम को फिर से लॉन्च करें}other{# दिनों के अंदर क्रोमियम को फिर से लॉन्च करें}}</translation>
<translation id="8438543370129609977">इमेज सर्च का इस्तेमाल करने पर, सर्वर पर पेज का टाइटल, यूआरएल, और कॉन्टेंट भेजा जाता है. इसमें PDF भी शामिल हैं. <ph name="LEARN_MORE" /></translation>
<translation id="366193510678119303">Phromium में इमेज सर्च की मदद से खोजने के बारे में ज़्यादा जानें</translation>
<translation id="1069576136282928177">इंस्‍टॉलर संग्रह खराब या अमान्‍य है. कृपया क्रोमियम फिर से डाउनलोड करें.</translation>
<translation id="7082388216101480391">Phromium के लिए, आपके डिवाइस में Windows 10 या उसके बाद का वर्शन होना चाहिए.</translation>
<translation id="8463672209299734063">आप चाहें, तो ChromiumOS को यह अनुमति दें कि वह गड़बड़ी की जानकारी और इस्तेमाल से जुड़ा डेटा Google को अपने-आप भेज सके. आपके ऐसा करने से, ChromiumOS की सुविधाओं और परफ़ॉर्मेंस को बेहतर बनाने में मदद मिलेगी.</translation>
<translation id="4343027289807602417">अपने Google खाते में Phromium का डेटा इस्तेमाल करने और सेव करने के लिए, अपनी पहचान की पुष्टि करें</translation>
<translation id="6746404578800969443">इससे Phromium में साइन इन करने के लिए प्रॉम्प्ट दिखता है</translation>
<translation id="5072642661707587697">क्रोमियम पुराना हो गया है</translation>
<translation id="759684005114911774">Phromium को डिफ़ॉल्ट ब्राउज़र के तौर पर चुनने के लिए धन्यवाद!</translation>
<translation id="5209258538041302334">पासवर्ड सेव करने पर ही, Phromium आपके पासवर्ड की जांच कर सकता है</translation>
<translation id="8525579356836940628">इंस्टॉल करने की प्रोसेस रोकी गई</translation>
<translation id="6348113608284833604">अपने <ph name="DEVICE_TYPE" /> पर Phromium ऐप्लिकेशन का इस्तेमाल करें और कभी भी, कहीं भी अपने पासवर्ड, टैब वगैरह आसानी से ऐक्सेस करें</translation>
<translation id="5083347044281842800">अगर Phromium को सार्वजनिक तौर पर लीक हुए डेटा में आपका कोई पासवर्ड मिलता है, तो आपको इसकी चेतावनी मिलेगी</translation>
<translation id="8555465886620020932">सेवा में गड़बड़ी: <ph name="SERVICE_ERROR" />.</translation>
<translation id="6712621562501854928">Phromium की कुछ सुविधाओं और एक्सटेंशन के लिए शॉर्टकट उपलब्ध हैं. आपके पास, इन्हें फिर से चालू करने का विकल्प है.</translation>
<translation id="8556420416730706394">आसानी से ऐक्सेस करने के लिए, 'इमेज सर्च' सुविधा को पिन किया जा सकता है. ऐसा करने के लिए, साइड पैनल के सबसे ऊपर मौजूद 'पिन करें' बटन पर क्लिक करें</translation>
<translation id="856656450041460113">भाषाओं की सूची में खोजें</translation>
<translation id="9159785833243360958">Phromium को कई संगठन मैनेज करते हैं</translation>
<translation id="8586442755830160949">कॉपीराइट <ph name="YEAR" /> The Chromium Authors. सर्वाधिकार सुरक्षित.</translation>
