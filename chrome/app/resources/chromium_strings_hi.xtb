<translation id="8145475184469284022">Phromium का इस्तेमाल करें और कभी भी, कहीं भी Google की बेहतरीन सुरक्षा सुविधाएं पाएं.</translation>
<translation id="945522503751344254">फ़ीडबैक भेजें</translation>
<translation id="1258071069834143371">क्रोमियम को कौन इस्तेमाल कर रहा है?</translation>
<translation id="8272911737374467274">Phromium की सबसे मज़बूत सुरक्षा पाएं</translation>
<translation id="983803489796659991">अपडेट सर्वर में ऐप्लिकेशन के लिए हैश डेटा मौजूद नहीं होने की वजह से इंस्टॉल नहीं हो सका.</translation>
<translation id="4087190600867587768">बिना किसी खाते के, Phromium का इस्तेमाल करें</translation>
<translation id="985602178874221306">क्रोमियम लेखक</translation>
<translation id="989970834842471429">'इमेज सर्च' सुविधा की मदद से जानकारी खोजने के लिए, कोई टेक्स्ट या इमेज चुनें</translation>
<translation id="6649431194696226496">जगह की जानकारी इस्तेमाल करने के लिए, <ph name="BEGIN_LINK" />सिस्टम सेटिंग<ph name="END_LINK" /> में जाकर Phromium को इसे ऐक्सेस करने की अनुमति दें</translation>
</translationbundle>