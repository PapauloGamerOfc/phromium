<translation id="7834049737623892628">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Phromium შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Google-ში.</translation>
<translation id="1803168627715642217">მიიღეთ ხელოვნური ინტელექტის შესაძლებლობები, როცა Phromium აპს იყენებთ თქვენს <ph name="DEVICE_TYPE" />-ზე</translation>
<translation id="3321731353906178474">თქვენი პაროლები, ჩანართები და სხვა მონაცემები მუდამ თქვენთანაა Phromium აპით თქვენს ტელეფონში</translation>
<translation id="7141270731789036260">Chrome for Testing-ის მორგება</translation>
<translation id="8077731669779275332">შეგიძლიათ გამოიყენოთ Phromium, როცა შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე აწკაპუნებთ.</translation>
<translation id="611798798247797100">ამოშალეთ <ph name="EXTENSION_NAME" /> Phromium-იდან</translation>
<translation id="7962394294883785044">თქვენი ორგანიზაცია შლის Phromium-ის მონაცემებს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="2611686760870033712">Phromium საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="71050417052775020">Phromium-ის გაშვება ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="4817060241763895497">იკითხეთ ნებისმიერი რამ პირდაპირ იქ, სადაც ხართ, Gemini-ს მეშვეობით Phromium-ში</translation>
<translation id="869358700049263961">დატოვეთ Phromium თქვენს სამაგრში, რომ მისი გახსნა ნებისმიერ დროს სწრაფად შეძლოთ</translation>
<translation id="7094488679340739251">გამოიყენეთ Phromium შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე ყოველი დაწკაპუნებისას.</translation>
<translation id="7216228761061470870">როცა სურათების ძიებას იყენებთ დესკტოპზე, გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, იგზავნება სერვერზე</translation>
<translation id="7802634650401946711">დავალებათა მენეჯერი - Phromium</translation>
<translation id="5182547787327636348">დასვით შეკითხვა Phromium-ის მიღმა არსებული კონტენტის, მაგალითად, სხვა აპების ან ფაილების შესახებ</translation>
<translation id="1673408954678067905"><ph name="EXISTING_USER" /> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით Phromium-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს ყველა მოწყობილობაში მიიღებთ შენახულ ინფორმაციასა და სხვა მონაცემებს.</translation>
<translation id="5761733252154904648">მომენტალურად დაიწყეთ დათვალიერება: Phromium-ის გაშვება ახლა Windows-ის ჩართვისთანავე არის შესაძლებელი.</translation>
