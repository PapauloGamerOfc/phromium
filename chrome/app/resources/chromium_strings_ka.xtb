<translation id="3977517784144885449">Phromium-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="8088471547690853921">ნამდვილად გსურთ მოახდინოთ Phromium-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="6388799252195623474">დახმარება მჭირდება</translation>
<translation id="1774421040071124552">გასაგრძელებლად შედით Phromium-ში ანგარიშით <ph name="EMAIL" />. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="2343430845154053061">Phromium-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="2724924185145648602">Phromium არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ Phromium-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="7417453886359805803">დაადასტურეთ ვინაობა, რომ თქვენს Google ანგარიშში გამოიყენოთ და შეინახოთ Phromium-ის მონაცემები</translation>
<translation id="3304683228794166031">Phromium უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="6442900851116057561">გადატვირთეთ ChromiumOS</translation>
<translation id="9164801375934097818">Phromium წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="2577121659922309103">ჩამოტვირთეთ Phromium თქვენს ტელეფონში, რომ თვალი ადევნოთ ფასებს და მიიღოთ გაფრთხილებები, როცა რომელიმე საიტზე ფასი დაიკლებს</translation>
<translation id="2052328618318278030">გამორთული • Phromium ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="3122296739697671126">მოგესალმებათ Phromium პროფილები</translation>
<translation id="3472445024540245926">შემდეგ ჯერზე, როცა გახსნით Phromium-ს თქვენს <ph name="DEVICE_TYPE" />-ში, დაინახავთ მოთხოვნას ჩანართების ჯგუფების გამოყენების შესახებ.</translation>
<translation id="2144084801479939969">ანგარიშის ამოშლა Phromium-იდან</translation>
<translation id="2473490714352939152">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Phromium-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="359777544552173333">Phromium-ის დეინსტალაცია</translation>
<translation id="3890462049854841354">მალსახმობები იხსნება Phromium-ში</translation>
<translation id="6616579671682178785">თქვენი ორგანიზაცია ხურავს Phromium-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="8662645370371079862">თითოეულ პროფილში ინახება საკუთარი Phromium ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6556755379298048869">მოიძიეთ კლავიატურის მალსახმობით.</translation>
<translation id="7133640529688742768">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK" />როგორ ინარჩუნებს Phromium თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK" /></translation>
<translation id="8316065704185291024">ამ პარამეტრის ცვლილება ამოქმედდება Phromium-ის გადატვირთვისთანავე.</translation>
<translation id="2816396636285296289">მართეთ თქვენი გაფართოებები Phromium-ის მთავარ მენიუში „გაფართოებებზე“ დაწკაპუნებით.</translation>
<translation id="8831144879019828189">ახლა შეგიძლიათ გადართვა, პაროლები სხვა Phromium პროფილიდან რომ ნახოთ</translation>
<translation id="7017911482442558099">გამოიყენეთ Phromium აპი, რომ საუკეთესო AI ხელსაწყოები თან იქონიოთ</translation>
<translation id="5784574554904759369">მართლწერის შეცდომების გასასწორებლად, Phromium თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს Google-ს უგზავნის</translation>
<translation id="8485501471305987872">Phromium-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="1462793186918694806">თქვენი ცვლილებები გააქტიურდება Phromium-ის შემდეგი გაშვებისას.</translation>
<translation id="7501991510212476553">Phromium ახლა Windows-ის ჩართვისას გაეშვება, რათა დათვალიერება მომენტალურად დაიწყოთ. ამის გამორთვა პარამეტრებიდან შეგიძლიათ.</translation>
<translation id="7686308613268368175">გააგრძელეთ იქიდან, სადაც გაჩერდით: Phromium-მა აღადგინა ჩანართები თქვენი ბოლო სესიიდან. ამის გამორთვა შეგიძლიათ აქ:</translation>
<translation id="5266723901802366313">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად Phromium საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="7085315067428293799">თუ თქვენს სანიშნეებს Google ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Phromium-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="668175097507315160">ChromiumOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="5279767706090517695">ამ აპის მონაცემების Phromium-იდან ამოშლა</translation>
<translation id="6562226321659107531">Phromium საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR" /></translation>
<translation id="259800793807512787">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის Phromium-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ Phromium-ის ახალი ვერსია.</translation>
<translation id="4914871493602315663">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Phromium როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Google სერვისებს</translation>
<translation id="5919390816124912606">Phromium უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="5867815953973052697">შედით Phromium-ში, რომ მიიღოთ სანიშნეები და სხვა მონაცემები თქვენს ყველა მოწყობილობაზე. შესვლის შემდეგ ეს სანიშნე შეინახება თქვენს Google ანგარიშში.</translation>
<translation id="7381168634819530324">აჩქარებს Phromium-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Phromium ოდნავ ნაკლებად უძლებს შეტევებს. ეს პარამეტრი ჩართულია.</translation>
<translation id="1509688792864707851">{count,plural, =1{თქვენი Phromium-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები (1 ერთეული) წაიშლება.}other{თქვენი Phromium-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები ({count} ერთეული) წაიშლება.}}</translation>
<translation id="4702638565169602649">Phromium გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="6779406956731413166">ChromiumOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS" />ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">თარგმნა</translation>
<translation id="1564864902402454287">Phromium გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="684888714667046800">ინტერნეტთან დაკავშირება ვერ ხერხდება. თუ ქსელის დაცვას იყენებთ, დარწმუნდით, რომ <ph name="PRODUCT_EXE_NAME" /> დაშვებულთა სიაშია.</translation>
