<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1026101648481255140">ინსტალაციის გაგრძელება</translation>
<translation id="1029669172902658969">ხელახლა გაშვება &amp;ChromiumOS-ის გასაახლებლად</translation>
<translation id="7962340570690354348">Phromium გირჩევთ, შეამოწმოთ ეს გაფართოება</translation>
<translation id="2702007788032964762">როცა საიტი გთხოვთ, უფლება მისცეთ, კონფიდენციალურად ჩატვირთოს თავის გვერდზე არსებული ბმულები, Phromium გამოიყენებს Google-ის სერვერებს. აღნიშნული დამალავს თქვენს ვინაობას წინასწარ ჩატვირთული საიტისგან, თუმცა Google-ს ეცოდინება, რომელი საიტები იტვირთება წინასწარ.</translation>
<translation id="1051793555070215510">დაგვეხმარეთ ინკოგნიტო რეჟიმის გაუმჯობესებაში ამ 1-წუთიანი გამოკითხვით.</translation>
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="4964836565882496625">თქვენმა მშობელმა გამორთო „ნებართვები საიტებისთვის, აპებისა და გაფართოებებისთვის“ Phromium-ისთვის</translation>
<translation id="8409497136174302488">Phromium-ს სჭირდება წვდომა თქვენს ადგილობრივ ქსელზე, რათა აღმოაჩინოს და გამოიყენოს ახლომახლო მოწყობილობები</translation>
<translation id="4388904545107211948">Phromium-ის კონკრეტული ფუნქციის ან გაფართოების მოსაძებნად აკრიფეთ მისი მალსახმობი მისამართთა ზოლში, რასაც მოჰყვება თქვენ მიერ არჩეული კლავიატურის კლავიში</translation>
<translation id="7188624550427159072">Phromium-ით ძიების სისტემურ არეში ჩვენება და კლავიატურის მალსახმობის ჩართვა</translation>
<translation id="3689248207461565136">Phromium ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="112640046208448578">მოახდინეთ საგნების თუ ადგილების იდენტიფიცირება, დააკოპირეთ ან თარგმნეთ ტექსტი. სურათების ძიების გამოყენებისას გვერდის ეკრანის ანაბეჭდი იგზავნება სერვერზე. <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">Phromium თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="5414044255592121327"><ph name="BEGIN_LINK" />შედით Phromium-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="1753507755668601921">დაწკაპუნებით აირჩიეთ Phromium-ის მენიუ</translation>
<translation id="1157985233335035034">ბოლოდროინდელი ენები</translation>
<translation id="1184145431117212167">ინსტალაცია ვერ მოხერხდა, რადგან Windows-ის თქვენი ვერსია არ არის მხარდაჭერილი.</translation>
<translation id="7861581212703831457">Phromium-ის შესახებ</translation>
<translation id="8752630985505435738">მიიღეთ თქვენს ტელეფონში ფასების მეთვალყურის გაფრთხილებები Phromium-ის მეშვეობით</translation>
<translation id="1203500561924088507">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="4933432676089063712"><ph name="IMPORTANT_UPDATE" /> მოლოდინის რეჟიმშია. დათვალიერების უსაფრთხოების დასაცავად Phromium განახლდება, როდესაც <ph name="IDLE_DURATION" /> განმავლობაში უმოქმედო იქნებით.</translation>
<translation id="1232234696885483911">სურათების ძიების გახსნისას გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, ავტომატურად გაიგზავნება სერვერზე. <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">როცა შესული ხართ, Phromium-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Google ანგარიშიდან. ამ პარამეტრის შესაცვლელად გახსენით „თქვენი ანგარიში Phromium-ში“.</translation>
<translation id="7402478829083317456">Gemini-ს ჩვენება Phromium-ში Mac-ის მენიუს ზოლში</translation>
<translation id="4902531791098430822">Phromium-ში Gemini-ში ეკრანის ნაწილის ასარჩევად გამოიყენეთ კლავიატურის მალსახმობი.</translation>
<translation id="9002284132405311162">სანამ ეს ჩანართი უმოქმედო იყო, Phromium-ის სისწრაფის შესანარჩუნებლად მეხსიერება გათავისუფლდა. სურვილისამებრ, შეგიძლიათ აირჩიოთ, რომ ეს საიტი ყოველთვის გამოირიცხოს უმოქმედოთა რიგებიდან.</translation>
