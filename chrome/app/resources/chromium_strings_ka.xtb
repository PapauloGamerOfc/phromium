<translation id="2724678689951174927">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Google ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK" />გამოდით Phromium-იდან<ph name="END_LINK" />.</translation>
<translation id="402854649782215414">ჩამოტვირთეთ Phromium თქვენს ტელეფონში, რომ გახსნათ ან შექმნათ ჩანართების ახალი ჯგუფები გზიდან.</translation>
<translation id="3191814926523151519">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Google ანგარიშები. თქვენი Google ანგარიშები გამოიყენება Phromium ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE" />-ს. <ph name="LINK_BEGIN" />შეიტყვეთ მეტი<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">სურათების ძიებით მოძიება</translation>
<translation id="5453573140402957471"><ph name="EXISTING_USER" /> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით Phromium-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს სანიშნეებსა და სხვა მონაცემებს ასევე მიიღებთ <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">ტექსტის არჩევა</translation>
<translation id="1236934630660512644">თქვენ შედიხართ სისტემაში მართული ანგარიშით და ამით აძლევთ ადმინისტრატორს კონტროლს თქვენს Phromium-ის პროფილზე. თქვენი Phromium-ის მონაცემები, როგორიცაა პროგრამები, სანიშნეები, ისტორია, პაროლები და სხვა პარამეტრები სამუდამოდ მიემაგრება <ph name="USER_NAME" />-ს. თქვენ შეძლებთ ამ მონაცემების წაშლას Google ანგარიშების საინფორმაციო დაფის მეშვეობით, თუმცა ამ მონაცემების დაკავშირებას სხვა ანგარიშთან ვერ შეძლებთ. სურვილისამებრ, შეგიძლიათ შექმნათ ახალი პროფილი, არსებული Phromium-ის მონაცემების ცალკე შესანახად. <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">Phromium დაზოგავს ბატარეის მუხტს ვიზუალური ეფექტებისა (მაგალითად, ლივლივა გადაადგილებისა და ვიდეოკადრების სიხშირის) და ფონური აქტივობის შეზღუდვის გზით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი ენერგიის დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">Phromium-ის განმაახლებელი სერვისი</translation>
<translation id="5797624919204275541">ამ პარამეტრის გამორთვის შემთხვევაში, Google-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Phromium-ში შესვლის გარეშე</translation>
<translation id="6850971726764387814">Phromium არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="8289779763124483945">თქვენი ორგანიზაცია, <ph name="MANAGER" />, მოითხოვს, რომ Phromium-ში შეხვიდეთ</translation>
<translation id="193439633299369377">განახლების მისასადაგებლად ChromiumOS უნდა გადაიტვირთოს.</translation>
<translation id="3215238748514810076">Phromium-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ტიპის ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE" /> წუთი</translation>
<translation id="8529252122707161160">Phromium ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="197326043290947695">დაათვალიერეთ უფრო ჭკვიანურად სურათების ძიების მეშვეობით</translation>
<translation id="7769772561254542263">შეიტყვეთ, რატომ ბლოკავს Phromium ზოგიერთ ფაილს, გაიხსნება ახალ ჩანართში</translation>
<translation id="3713013456746186442">იზრუნებს, რომ თქვენი Phromium-ის პროგრამული უზრუნველყოფა განახლებული იყოს. თუ ეს სერვისი გაითიშება ან შეჩერდება, Phromium-ის პროგრამული უზრუნველყოფა აღარ განახლდება, რაც იმას ნიშნავს, რომ უსაფრთხოებასთან დაკავშირებული პოტენციური საფრთხეების აღმოფხვრა აღარ მოხდება და ფუნქციებმა შეიძლება არ იმუშაოს. ეს სერვისი დეინსტალირდება, როცა მისით მოსარგებლე Phromium-ის პროგრამული უზრუნველყოფა არ არსებობს.</translation>
<translation id="5690439379999550641">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Phromium-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="2039417478970545937">პარამეტრები.</translation>
<translation id="4765042254400173473">აირჩიეთ, დაერთოს თუ არა Phromium ისტორია, Google სერვისებში უფრო პერსონალიზებული ფუნქციებით რომ ისარგებლოთ</translation>
<translation id="1448229429009113044">ჩაშენებულია Phromium-ში, რათა დაგეხმაროთ ძლიერი პაროლების შექმნაში, შენახვასა და ავტომატურად შევსებაში. დაამატეთ მალსახმობი მარტივი წვდომისთვის.</translation>
<translation id="2145664943269651168">დააწკაპუნეთ ღილაკზე „Phromium-ის მორგება“ ახალი ჩანართის გვერდზე, რათა Phromium-ს ახალი იერი შესძინოთ</translation>
<translation id="6052463185672312901">Phromium-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი შეცდომაში შემყვანია და მას შეუძლია მოულოდნელი ცვლილებების განხორციელება თქვენს მოწყობილობაზე</translation>
<translation id="3825064703718009924">Phromium iOS-ის მომდევნო ჯერზე გახსნისას ნახავთ მოთხოვნას <ph name="FEATURE_NAME" />-ის ცდის შესახებ.</translation>
<translation id="886729435477608858">თქვენი პაროლები და Phromium-ის სხვა მონაცემები, რომლებიც შენახულია თქვენს Google ანგარიშში, ამოიშლება ამ მოწყობილობიდან. Phromium-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="8016082769719253694">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Phromium არ გამოიყენება 1 წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}other{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Phromium არ გამოიყენება # წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}}</translation>
