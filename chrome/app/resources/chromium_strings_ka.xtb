<translation id="8846891938874485868">აჩქარებს Phromium-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Phromium ოდნავ ნაკლებად უძლებს შეტევებს</translation>
<translation id="7525500996671436081">Phromium-ით ძიების გახსნა</translation>
<translation id="1224842000407297331">Phromium პროფილი</translation>
<translation id="4956303519269880412">გაფრთხილება: Phromium ვერ შეუშლის ხელს გაფართოებებს დათვალიერების ისტორიის შენახვაში. ინკოგნიტო რეჟიმში ამ გაფართოების გასათიშად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="2708255035805733225">თუ Phromium-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="4673710618874938871">შესული ხართ, როგორც <ph name="USER_NAME" />, წევრობა. ანგარიშის მენიუს გახსნა</translation>
<translation id="1883292567514549610">როგორც ჩანს, პროფილი გამოიყენება სხვა Phromium პროცესის მიერ (<ph name="PROCESS_ID" />) სხვა კომპიუტერში (<ph name="HOST_NAME" />). Phromium-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ Phromium.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="1889305042180577023">თქვენი Phromium-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="8079525505870459051">როცა შესული ხართ, Phromium-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Google ანგარიშიდან. <ph name="SHORTCUT" /> შეცვლის თქვენი Google სერვისების პარამეტრებს.</translation>
<translation id="2171507067211697961">Phromium-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ Phromium-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="6925701206088903005">მაინც გსურთ Phromium-იდან გასვლა?</translation>
<translation id="4514755609496543621">Phromium-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="8673673368917636496">ბოლო დროს არ ყოფილხართ. Phromium-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და კიდევ <ph name="COUNT" />.</translation>
<translation id="3638319732826965647">თუ Gemini Phromium-ში გახსნილია, გვერდითი პანელი ღია რჩება ახალი ჩანართების შექმნისას</translation>
<translation id="479167709087336770">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Google Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Google-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="2659245507243672392">Phromium-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="166411027652942990">Phromium-ის შემავალი წესი დაუშვას mDNS მოძრაობა.</translation>
<translation id="6031862420354068813">ხელახლა გაშვება &amp;Phromium-ის გასაახლებლად</translation>
<translation id="4918086044614829423">მიღება</translation>
<translation id="4918844574251943176">სურათი დაკოპირდა</translation>
<translation id="1531905832227009774">საკითხავი სიისა და სხვა კონტენტის თქვენს ყველა მოწყობილობაზე მისაღებად გაიარეთ ავტორიზაცია Phromium-ში</translation>
<translation id="4319892378006430019">Phromium ფონურ რეჟიმშია.</translation>
<translation id="8972359100025490790">დააწკაპუნეთ Phromium-ის შესვლის დიალოგის დასახურად</translation>
<translation id="3639078149590125530">Phromium პროფილები Phromium-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. შექმენით პროფილები ოჯახის წევრებისა და მეგობრებისთვის, ან განაცალკევეთ სამსახურებრივი და პირადი მონაცემები.</translation>
<translation id="7141327976224964788">სტუმრებს შეუძლიათ Phromium-ის გამოყენება და მისი ყველა ფუნქციით სარგებლობა.</translation>
<translation id="7007327521155149139">თქვენი ანგარიში Phromium-ში</translation>
<translation id="5973804420920585431">საკუთარი თავის დამატება Phromium-ში</translation>
<translation id="504699503110800016">გადავსების მენიუს გახსნა</translation>
<translation id="2497925691306722252">მიიღეთ წვდომა Google-ის ყველა რჩეულზე Phromium-ის მეშვეობით თქვენს <ph name="DEVICE_TYPE" />-ზე</translation>
<translation id="8678196879882043620">Phromium-ს სჭირდება ნებართვა თქვენი ხელების მოძრაობაზე თვალის მისადევნებლად</translation>
<translation id="3397880081430454820">ბოლო დროს არ ყოფილხართ. Phromium-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და <ph name="PERMISSION_3" />.</translation>
