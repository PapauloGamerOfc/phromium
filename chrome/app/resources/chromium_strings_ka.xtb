<translation id="3489957831482527036">მიმდინარეობს Phromium-ის გაშვება…</translation>
<translation id="8624541899164515475">პარამეტრები, გაიხსნება ახალ ჩანართში.</translation>
<translation id="8648201657708811153">Google Chrome for Testing ვერ გახდება თქვენი ნაგულისხმევი ბრაუზერი.</translation>
<translation id="7150069986792019616">მოიძიეთ Phromium-ით ნებისმიერი ადგილიდან</translation>
<translation id="1623850835554120265">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Phromium-ის გაშვებისას ან Omnibox-ში ძიების დროს.</translation>
<translation id="8828478112210313529">ეს ჩანართი სხვა მოწყობილობაზე რომ გაგზავნოთ, შედით იქიდან Phromium-ში</translation>
<translation id="3592747099485557650">ეს არის თქვენი Phromium</translation>
<translation id="8712637175834984815">კარგი</translation>
<translation id="3388228047978619624">გსურთ, შეხვიდეთ Phromium-ში?</translation>
<translation id="8747073452963259673">ძიების არეალის ქვედა მარცხენა კუთხე: მარცხნივ <ph name="LEFT" />%, ქვემოთ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">შეცდომა ინსტალაციისას: თქვენმა ქსელის ადმინისტრატორმა აამოქმედა ჯგუფური წესები, რომლებიც ზღუდავს ინსტალაციას: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">მოგვიანებით შეხსენება</translation>
<translation id="614494151403742465">გაუზიარეთ ეს დოკუმენტი Gemini-ს Phromium-ში, რომ მიიღოთ სწრაფი მიმოხილვა და დასვათ დამატებითი შეკითხვები</translation>
<translation id="6346068443590018348">გსურთ, შეხვიდეთ Phromium-ში?</translation>
<translation id="1468806565762231794">დააყენეთ Phromium ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის ამოცანათა ზოლში</translation>
<translation id="8826492472752484139">დაწკაპუნებით აირჩიეთ „პაროლების მმართველი“</translation>
<translation id="8833697763442816810">ChromiumOS სისტემა</translation>
<translation id="4854784568701005121">ეს ენა გამოიყენება მენიუს, პარამეტრების, გაფრთხილებებისა და სხვა ტექსტური კონტენტის Phromium-ში საჩვენებლად</translation>
<translation id="8862326446509486874">თქვენ არ გაქვთ შესაბამისი უფლებები სისტემის დონეზე ინსტალაციისთვის. სცადეთ ინსტალაციის პროგრამის ხელახლა გაშვება ადმინისტრატორის სტატუსით.</translation>
<translation id="7804139416589625033">Phromium პროფილის დამატება</translation>
<translation id="6333867241557949259">ChromiumOS-მა ვერ შეინახა Phromium-ის მონაცემები თქვენს Google ანგარიშში ავტორიზაციის შეცდომის გამო</translation>
<translation id="2888440364511152939">თქვენი ორგანიზაცია მოითხოვს, რომ Phromium-ში შეხვიდეთ</translation>
<translation id="7111325571010992010">Phromium ცდილობს პაროლების ჩვენებას. ჩაწერეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="4406716425954955281">Phromium აღარ არის თქვენი ნაგულისხმევი ბრაუზერი. გახდეს Phromium ნაგულისხმევი ბრაუზერი?</translation>
<translation id="2999847959360823770">Phromium-ის განახლება ვერ მოხერხდა</translation>
<translation id="8944232836376404813">ეს მოქმედება:
          <ph name="LINE_BREAKS" />
            • გადააყენებს თქვენს გაშვების გვერდს, ახალი ჩანართის გვერდს, საძიებო სისტემას და ჩამაგრებულ ჩანართებს
            <ph name="LINE_BREAK" />
            • გათიშავს გაფართოებებს
            <ph name="LINE_BREAK" />
            • წაშლის ქუქი-ჩანაწერებს და საიტების სხვა დროებით მონაცემებს
            <ph name="LINE_BREAKS" />
            სანიშნეები, ისტორია და შენახული პაროლები ხელუხლებელი დარჩება.</translation>
<translation id="7461167469691640632">საიტებისთვის Phromium-ის მალსახმობების ჩვენება</translation>
<translation id="7394133813796947510">Phromium Enterprise-ის ლოგო</translation>
<translation id="2476839923452631964">თან იქონიეთ Google-ის უსაფრთხოება Phromium აპის მეშვეობით თქვენს <ph name="DEVICE_TYPE" />-ზე</translation>
<translation id="2041306781031361744">Phromium-ის გაშვება შეუძლებელია, რადგან თქვენი პროფილის გახსნისას მოხდა შეცდომა. ცადეთ Phromium-ის გადატვირთვა.</translation>
<translation id="8355079108092011401">Phromium-ით ძიებისთვის ან მორგებისთვის <ph name="BEGIN_LINK" />პარამეტრებში<ph name="END_LINK" /></translation>
<translation id="820370893610994443">Phromium-ის პროფილების მართვა</translation>
<translation id="1885039203623228439">Gemini Phromium-სა და გახსნილ ჩანართს შორის გადაადგილდით კლავიატურის მეშვეობით.</translation>
<translation id="9018218886431812662">ინსტალაცია დასრულდა</translation>
<translation id="8213523024005590363">Phromium-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="1376667286722804744">შედით Phromium-ში</translation>
<translation id="5142314855184111999">Phromium-ით ძიების ჩვენება Mac-ის მენიუს ზოლში და კლავიატურის მალსახმობის ჩართვა</translation>
<translation id="5166485487967090892">Phromium-მა დაბლოკა ეს ჩამოტვირთვა, რადგან არქივის ფაილი შეიცავს სხვა ფაილებს, რომლებშიც, შესაძლოა, მავნე პროგრამა იმალებოდეს</translation>
<translation id="1902493242619542969">დაასინქრონეთ თქვენი პაროლები, სანიშნეები და ისტორია თქვენს მოწყობილობებში. ნაგულისხმევ ბრაუზერად Phromium-ის დაყენებით მარტივად მიიღეთ წვდომა თქვენთვის ნაცნობ და საყვარელ ფუნქციებზე. Phromium ჩამაგრდება თქვენს ამოცანათა ზოლში სწრაფი წვდომისთვის.</translation>
<translation id="7092992855996941035">გამოიყენეთ Google-ის საუკეთესო AI ხელსაწყოები Phromium აპით თქვენს ტელეფონში</translation>
<translation id="4203475068093609811"><ph name="DEVICE" />-დან თქვენი პაროლებისა და სხვა კონტენტის მისაღებად გაიარეთ ავტორიზაცია Phromium-ში</translation>
<translation id="7699507532215026981">შედით Phromium-ში, როცა Google-ის სხვა სერვისებში შედიხართ</translation>
<translation id="5571207595456818809">Phromium ავტომატურად დაიხურა</translation>
<translation id="3670200098293484473">Phromium მოძველდა</translation>
<translation id="5636382052119887392">{0,plural, =1{Phromium ხელახლა გაეშვება 1 საათში}other{Phromium ხელახლა გაეშვება # საათში}}</translation>
<translation id="9106236359747881194">მონიშნეთ ტექსტი მოსაძებნად</translation>
<translation id="9197093250229894135">Phromium-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 8.1-ს.</translation>
<translation id="7195134700293253698">ბმულის გახსნა Phromium-ის ახალ ჩა&amp;ნართში</translation>
<translation id="911206726377975832">ასევე წაშალოთ თქვენი დათვალიერების მონაცემები?</translation>
<translation id="9134482777260927479">დახმარება საშინაო დავალებაში</translation>
<translation id="9148058034647219655">გასვლა</translation>
<translation id="8888942844777295083">გააგრძელეთ იქიდან, სადაც გაჩერდით: Phromium-ს შეუძლია თქვენი ჩანართების აღდგენა ყოველი გადატვირთვის შემდეგ. ამის ჩასართავად გადადით აქ:</translation>
<translation id="1485079858205975514">თქვენი სისტემის ადმინისტრატორმა მოახდინა Phromium-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა ალტერნატიული ბრაუზერის გახსნა.</translation>
<translation id="1096075777207775410">ხელახლა გაშვება &amp;Phromium-ის გასაახლებლად</translation>
<translation id="5762505165968040132">Phromium (mDNS-In)</translation>
<translation id="6687502817616773473">მოირგეთ Phromium</translation>
<translation id="6554170182570636227">Phromium-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი Windows XP-სა და Windows Vista-ზე</translation>
<translation id="8145475184469284022">მიიღეთ Google-ის უსაფრთხოების საუკეთესო ფუნქციები გზაში Phromium-ის მეშვეობით.</translation>
<translation id="945522503751344254">შეფასების გაგზავნა</translation>
<translation id="1258071069834143371">ვინ იყენებს Phromium-ს?</translation>
<translation id="8272911737374467274">ისარგებლეთ Phromium-ის უსაფრთხოების ყველაზე ძლიერი ფუნქციებით</translation>
<translation id="983803489796659991">ინსტალაცია ვერ მოხერხდა, რადგან განახლების სერვერს არ აქვს ამ აპლიკაციის ჰეშ-მონაცემები.</translation>
<translation id="4087190600867587768">Phromium-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="985602178874221306">Chromium-ის ავტორები</translation>
<translation id="989970834842471429">მონიშნეთ ნებისმიერი ტექსტი თუ სურათი, რისი მოძებნაც გსურთ სურათების ძიებით</translation>
<translation id="6649431194696226496">თქვენი მდებარეობა რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Phromium-ს წვდომა</translation>
</translationbundle>