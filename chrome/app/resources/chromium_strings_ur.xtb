<translation id="1029669172902658969">‏ChromiumOS&amp; کو اپ ڈیٹ کرنے کیلئے بند کر کے دوبارہ چلائیں</translation>
<translation id="7962340570690354348">‏Phromium تجویز کرتا ہے کہ آپ اس ایکسٹینشن کا جائزہ لیں</translation>
<translation id="2702007788032964762">‏جب کوئی سائٹ اپنے صفحے پر لنکس کو نجی طور پر پیشگی لوڈ کرنے کا مطالبہ کرتی ہے تو Phromium براؤزر ‏Google سرورز کا استعمال کرتا ہے۔ اس سے پیشگی لوڈ کردہ سائٹ سے آپ کی شناخت پوشیدہ ہو جاتی ہے، لیکن Google جانتا ہے کہ کونسی سائٹس پیشگی لوڈ ہوتی ہیں۔</translation>
<translation id="1051793555070215510">اس 1 منٹ کے سروے میں حصہ لے کر پوشیدگی کو بہتر بنانے میں ہماری مدد کریں۔</translation>
<translation id="1065672644894730302">آپ کی ترجیحات کو نہیں پڑھا جا سکتا ہے۔

کچھ خصوصیات غیر دستیاب ہو سکتی ہیں اور ترجیحات میں تبدیلیاں محفوظ نہیں ہونگی۔</translation>
<translation id="4964836565882496625">‏آپ کے والدین نے "Phromium کی خاطر سائٹس، ایپس اور ایکسٹینشنز کے لیے اجازتوں" کو آف کر دیا ہے</translation>
<translation id="8409497136174302488">‏‫Phromium کو قریبی آلات دریافت کرنے اور استعمال کرنے کے لیے آپ کے مقامی نیٹ ورک تک رسائی درکار ہے</translation>
<translation id="4388904545107211948">‏کسی مخصوص Phromium خصوصیت یا ایکسٹینشن کو تلاش کرنے کے لیے، ایڈریس بار میں اس کا شارٹ کٹ ٹائپ کریں، پھر اپنی منتخب کردہ کی بورڈ کلید دبائیں</translation>
<translation id="7188624550427159072">‏سسٹم ٹرے میں Phromium کے ساتھ تلاش دکھائیں اور کی بورڈ شارٹ کٹ آن کریں</translation>
<translation id="3689248207461565136">‏Phromium آپ کے پاس ورڈز برآمد کرنا چاہتا ہے۔ اس کی اجازت دینے کیلئے، اپنا Windows پاس ورڈ ٹائپ کریں۔</translation>
<translation id="112640046208448578">چیزوں یا مقامات کی شناخت کریں اور ٹیکسٹ کو کاپی یا اس کا ترجمہ کریں۔ جب آپ تصاویر کا استعمال کر کے تلاش استعمال کرتے ہیں تو صفحہ کا اسکرین شاٹ سرور کو بھیجا جاتا ہے۔ <ph name="LEARN_MORE" /></translation>
<translation id="6114173190076818326">‏Phromium آپ کا ڈیفالٹ براؤزر ہے</translation>
<translation id="5414044255592121327">‏یہ دیکھنے کے لئے کہ آیا آپ کے پاس ورڈز ڈیٹا کی خلاف ورزیوں اور دیگر سیکیورٹی مسائل سے محفوظ ہیں، <ph name="BEGIN_LINK" />Phromium میں سائن ان کریں<ph name="END_LINK" />۔</translation>
<translation id="1753507755668601921">‏Phromium مینو پر کلک کریں</translation>
<translation id="1157985233335035034">حالیہ زبانیں</translation>
<translation id="1184145431117212167">‏انسٹالیشن ناکام ہوگئی کیونکہ Windows کا آپ کا ورژن تعاون یافتہ نہیں ہے۔</translation>
<translation id="7861581212703831457">‏Phromium کے بارے میں</translation>
<translation id="8752630985505435738">‏اپنے فون پر Phromium کے ساتھ قیمت کی ٹریکنگ کے الرٹس حاصل کریں</translation>
<translation id="1203500561924088507">انسٹال کرنے کا شکریہ۔ آپ کو <ph name="BUNDLE_NAME" /> استعمال کرنے سے پہلے اپنا براؤزر لازمی طور سے ری اسٹارٹ کرنا چاہیے۔</translation>
<translation id="4933432676089063712">‏ایک <ph name="IMPORTANT_UPDATE" /> زیر التواء ہے۔ اپنی براؤزنگ کو محفوظ رکھنے کے لیے، Phromium اگلی بار اپ ڈیٹ کرے گا جب آپ <ph name="IDLE_DURATION" /> کے لیے غیر فعال ہوں گے۔</translation>
<translation id="1232234696885483911">‏جب آپ تصاویر کا استعمال کر کے تلاش کھولتے ہیں تو صفحہ کا عنوان، URL اور مواد بشمول PDFs خودکار طور پر سرور کو بھیجے جائیں گے۔ <ph name="LEARN_MORE" /></translation>
<translation id="4874488215922903989">‏جب آپ سائن ان ہوتے ہیں، آپ Phromium میں اپنے Google اکاؤنٹ سے اپنے پاس ورڈز وغیرہ استعمال کر سکتے ہیں۔ اسے تبدیل کرنے کے لیے، "Phromium میں آپ کا اکاؤنٹ" پر جائیں۔</translation>
<translation id="7402478829083317456">‏‫Mac مینیو بار میں Phromium میں Gemini دکھائیں</translation>
<translation id="4902531791098430822">‏‫Phromium میں Gemini میں اسکرین کے حصے کو منتخب کرنے کے لیے، کی بورڈ شارٹ کٹ استعمال کریں۔</translation>
<translation id="9002284132405311162">‏جب یہ ٹیب غیر فعال تھا تو Phromium کو تیز رکھنے کے لیے میموری خالی کر دی گئی تھی۔ آپ اس سائٹ کو ہمیشہ غیر فعال ہونے سے خارج کرنے کا انتخاب کر سکتے ہیں۔</translation>
