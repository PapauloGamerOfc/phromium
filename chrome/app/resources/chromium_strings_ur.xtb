<translation id="1640672724030957280">ڈاؤن لوڈ ہو رہی ہے…</translation>
<translation id="1665602916345474427">بطور <ph name="USER_NAME" />، <ph name="USER_EMAIL" />، رکنیت سائن ان ہے۔ اکاؤنٹ مینیو کھولیں</translation>
<translation id="4535436467771816034">‏آپ ہر بار پیغامات، دستاویزات اور دیگر ایپس میں موجود لنکس پر کلک کرتے وقت Phromium کا استعمال کر سکتے ہیں۔ اسے آپ کے ٹاسک بار میں بھی پن کر دیا جائے گا۔</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> کے لیے زیادہ مراعات فراہم کرتا ہے۔</translation>
<translation id="1722488837206509557">یہ آپ کو دستیاب آلات میں سے انتخاب کرنے اور ان پر مواد ڈسپلے کرنے کی اجازت دے گا۔</translation>
<translation id="3550860956769006392">‏Phromium جلد ہی براؤزنگ ڈیٹا کو حذف کر دے گا</translation>
<translation id="2053384509423635834">‏Phromium نیویگیشنز کو HTTPS میں اپ گریڈ کرنے کی کوشش کرے گا</translation>
<translation id="2516115567501600458">‏Phromium ڈیٹا کو صاف کر دیا گیا</translation>
<translation id="8571959122390670188">‏Phromium <ph name="REMAINING_TIME" /> میں ری سٹارٹ ہو جائے گا</translation>
<translation id="6284080675125981628">‏HTTPS دستیاب نہ ہونے پر، Phromium آپ کو وارننگ دیے بغیر ایک غیر محفوظ کنکشن استعمال کرے گا</translation>
<translation id="5872244334553252095">‏Phromium کو پس منظر میں چلنے دیں</translation>
<translation id="2213761221916953829">‏Phromium کو محفوظ تر بنانے کیلئے، ہم نے کچھ ایکسٹینشنز کو غیر فعال کر دیا ہے جو <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> میں مندرج نہیں ہیں اور ہو سکتا ہے ان کو آپ کے علم کے بغیر شامل کیا گیا ہو۔</translation>
<translation id="8807881428325438878">‏فوری رسائی کے لیے Phromium کو اپنے ٹاسک بار میں پن کرنے کی خاطر ونڈو اطلاع میں <ph name="BEGIN_BOLD" />ہاں<ph name="END_BOLD" /> پر کلک کریں۔</translation>
<translation id="6861833596843600606">‏Phromium کو دوبارہ انسٹال کریں</translation>
<translation id="3950056404221550225">‏Phromium <ph name="AUTHENTICATION_PURPOSE" /> کی کوشش کر رہا ہے</translation>
<translation id="2018401790887358950">‏‫<ph name="EXISTING_USER" /> پہلے سے ہی سائن ان ہے۔ اپنی براؤزنگ کو الگ رکھنے کے لیے، اپنی پروفائل میں Phromium میں بطور <ph name="USER_EMAIL_ADDRESS" /> سائن ان کریں۔ آپ کو <ph name="DEVICE" /> سے اپنی ایکسٹینشنز اور مزید چیزیں بھی مل جائیں گی۔</translation>
<translation id="6114726049187747242">‏اگلی بار جب آپ اپنے <ph name="DEVICE_TYPE" /> پر Phromium کھولیں گے تو آپ کو Google پاس ورڈ مینیجر استعمال کرنے کے لیے ایک پرامپٹ نظر آئے گا۔</translation>
<translation id="1838374766361614909">تلاش صاف کریں</translation>
<translation id="2724678689951174927">‏براؤزنگ ڈیٹا کو اپنے Google اکاؤنٹ میں برقرار رکھتے ہوئے، صرف اس آلہ سے اسے حذف کرنے کیلئے، <ph name="BEGIN_LINK" />Phromium سے سائن آؤٹ کریں<ph name="END_LINK" />۔</translation>
<translation id="402854649782215414">‏چلتے پھرتے نئے ٹیب گروپس کھولنے یا تخلیق کرنے کے لیے اپنے فون پر Phromium ڈاؤن لوڈ کریں۔</translation>
<translation id="3191814926523151519">‏آپ اپنے سائن ان کردہ Google اکاؤنٹس کا نظم کر سکتے ہیں۔ آپ کے Google اکاؤنٹس Phromium براؤزر، Play اسٹور، Gmail اور مزید کے لیے استعمال ہوتے ہیں۔ اگر آپ کسی اور کے لیے کوئی اکاؤنٹ شامل کرنا چاہتے ہیں جیسے آپ کی فیملی کا کوئی ممبر تو اس کی بجائے اپنے <ph name="DEVICE_TYPE" /> میں ایک نیا شخص شامل کریں۔ <ph name="LINK_BEGIN" />مزید جانیں<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">تصاویر کا استعمال کر کے تلاش کے ساتھ تلاش کریں</translation>
<translation id="5453573140402957471">‏‫<ph name="EXISTING_USER" /> پہلے سے ہی سائن ان ہے۔ اپنی براؤزنگ کو الگ رکھنے کے لیے، اپنی پروفائل میں Phromium میں بطور <ph name="USER_EMAIL_ADDRESS" /> سائن ان کریں۔ آپ کو <ph name="DEVICE" /> سے اپنے بُک مارکس اور مزید چیزیں بھی مل جائیں گی۔</translation>
<translation id="1880677175115548835">متن منتخب کریں</translation>
<translation id="1236934630660512644">‏آپ ایک منظم اکاؤنٹ کے ساتھ سائن ان کر رہے ہیں اور اپنے Phromium پروفائل پر اس کا انتظامی کنٹرول دے رہے ہیں۔ آپ کا Phromium ڈیٹا جیسے آپ کی ایپس، بُک مارکس، سرگزشت، پاس ورڈز اور دیگر ترتیبات <ph name="USER_NAME" /> سے مستقل طور پر جڑ جائیں گی۔ آپ اس ڈیٹا کو Google اکاؤنٹس ڈیش بورڈ کے ذریعے حذف کر سکیں گے لیکن آپ اس ڈیٹا کو دوسرے اکاؤنٹ کے ساتھ وابستہ نہیں کر سکیں گے۔ آپ اپنا موجودہ Phromium ڈیٹا الگ رکھنے کیلئے اختیاری طور پر ایک نیا پروفائل بنا سکتے ہیں۔ <ph name="LEARN_MORE" /></translation>
<translation id="4642320984725757603">‏‫Phromium ہموار اسکرولنگ اور ویڈیو فریم ریٹس جیسی پس منظر کی سرگرمی اور ویژوئل ایفیکٹس کو محدود کر کے بیٹری پاور کی بچت کرتا ہے۔ <ph name="BEGIN_LINK" />اپنے انرجی سیور کے بارے میں مزید جانیں<ph name="END_LINK" /></translation>
<translation id="1758647131572761585">‏‫Phromium اپ ڈیٹر سروس</translation>
<translation id="5797624919204275541">‏اسے آف کر کے، آپ Phromium میں سائن ان کیے بغیر Gmail جیسی Google سائٹس میں سائن ان کر سکتے ہیں</translation>
<translation id="6850971726764387814">‏Phromium جواب نہیں دے رہا ہے۔ ابھی دوبارہ شروع کریں؟</translation>
